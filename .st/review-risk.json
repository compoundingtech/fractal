{
  "version": 1,
  "rule": "The deterministic risk floor of a review (docs/review.md): the highest level of any rule that fires on git diff BASE...HEAD. A review's final risk is the higher of this floor and the reviewing model's own score; the model may raise the risk above the floor and never lower it. `classes` gives the level of each class in .st/risky-classes.json (a class may lower the level of some paths with `paths`); `rules` are checks of their own; `large` is the size at which a change is at least medium. Globs match changed paths (** crosses directories); a content pattern matches an added (`added`), removed (`removed`) or either diff line of a file under its globs and not under `exclude`.",
  "classes": {
    "schema": "high",
    "authorization": {"level": "high", "paths": [{"globs": [".st/**"], "level": "medium"}]},
    "claim-folding-and-replay": "high",
    "protocol": "medium",
    "generated-contracts": "medium",
    "config-and-build": "medium",
    "routing-and-delivery": "medium",
    "release-notes": "low"
  },
  "rules": [
    {
      "name": "data-deletion",
      "level": "high",
      "content": [
        {"globs": ["crates/**"], "exclude": ["**/tests/**", "**/tests.rs", "**/*_tests.rs", "**/*_test.rs"], "only": "added", "pattern": "(?i)\\b(DELETE\\s+FROM|DROP\\s+(TABLE|INDEX|TRIGGER|VIEW)|TRUNCATE\\s+TABLE)\\b|\\bremove_dir_all\\b"}
      ]
    },
    {
      "name": "breaking-public-contract",
      "level": "high",
      "content": [
        {"globs": ["crates/fractal-wire/**", "crates/fractal-resource-protocol/**", "crates/fractal-client/**", "crates/fractal-api-core/src/api.rs", "crates/fractal-api-core/src/api/**", "crates/fractal-api-client-v0/src/api/**", "crates/fractal-api-mailbox/src/api/**", "wit/**"], "exclude": ["**/tests/**", "**/tests.rs", "**/*_tests.rs"], "only": "removed", "pattern": "^\\s*pub(\\([a-z]+\\))?\\s+(fn|struct|enum|const|type|trait)\\b"}
      ]
    },
    {
      "name": "private-key-material",
      "level": "high",
      "content": [
        {"globs": ["**"], "exclude": ["**/tests/**", "**/*-test", "**/*_test.*", "docs/**"], "only": "added", "pattern": "-----BEGIN [A-Z ]*PRIVATE KEY-----"}
      ]
    },
    {
      "name": "trust-files",
      "level": "high",
      "globs": [".st/evidence-keys", ".st/evidence-keys/**", ".st/evidence-log-key", ".st/evidence-authors.json", ".st/evidence-skip-policy.json", ".st/evidence-policy.json", ".st/required-lanes.json", ".st/review-risk.json", ".st/risky-classes.json", ".st/review-verdict.schema.json", ".st/review-harness.json", "scripts/review-risk", "scripts/review-validate", "scripts/classify-risk", "scripts/review"]
    },
    {
      "name": "skip-and-signing-machinery",
      "level": "medium",
      "globs": ["scripts/st-test", "scripts/fractal-test", "scripts/evidence-*", "scripts/ci-evidence-*", "scripts/ci-local", "scripts/ci-linux", "scripts/review", "scripts/review-*", ".st/**"]
    },
    {
      "name": "workflows",
      "level": "medium",
      "globs": [".github/**"]
    }
  ],
  "large": {"changed_lines": 1500, "level": "medium"}
}
