{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "review-verdict.schema.json",
  "title": "A review verdict (docs/review.md)",
  "description": "The one JSON artifact a review produces and signs. It must parse and validate against this schema (scripts/review-validate also checks the rules a schema cannot say: final risk is the higher of the two scores, a GO has no blocking finding, a CHANGES has one); if it does not, the review fails locally and nothing is signed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "head", "base", "round", "verdict", "risk", "findings", "flags", "read", "patch_ids", "reviewer", "standard", "text"],
  "definitions": {
    "level": {"enum": ["low", "medium", "high"]},
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "flag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "why"],
      "properties": {"value": {"enum": ["yes", "no"]}, "why": {"type": "string", "minLength": 1}}
    },
    "paths": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "properties": {
    "version": {"enum": [1]},
    "head": {"$ref": "#/definitions/sha"},
    "base": {"$ref": "#/definitions/sha"},
    "round": {"type": "integer", "minimum": 1, "maximum": 3},
    "verdict": {"enum": ["GO", "CHANGES"]},
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deterministic", "llm", "final"],
      "properties": {
        "deterministic": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "reasons"],
          "properties": {
            "level": {"$ref": "#/definitions/level"},
            "reasons": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["rule", "level", "paths", "lines"],
                "properties": {
                  "rule": {"type": "string", "minLength": 1},
                  "level": {"$ref": "#/definitions/level"},
                  "paths": {"$ref": "#/definitions/paths"},
                  "lines": {"type": "array", "items": {"type": "string"}}
                }
              }
            },
            "factory_read": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["area", "paths", "lines"],
                "properties": {
                  "area": {"type": "string", "minLength": 1},
                  "paths": {"$ref": "#/definitions/paths"},
                  "lines": {"type": "array", "items": {"type": "string"}}
                }
              }
            }
          }
        },
        "llm": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "reasons"],
          "properties": {
            "level": {"$ref": "#/definitions/level"},
            "reasons": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        "final": {"$ref": "#/definitions/level"},
        "needs_factory_read": {"type": "boolean"}
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "file", "line", "reason", "fix"],
        "properties": {
          "severity": {"enum": ["blocking", "advisory"]},
          "file": {"type": "string", "minLength": 1},
          "line": {"type": "integer", "minimum": 0},
          "reason": {"type": "string", "minLength": 1},
          "fix": {"type": "string"}
        }
      }
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["finding", "change"],
        "properties": {"finding": {"type": "string", "minLength": 1}, "change": {"$ref": "#/definitions/sha"}}
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": false,
      "required": ["public_contract", "stored_format", "trust_or_permission", "global_view"],
      "properties": {
        "public_contract": {"$ref": "#/definitions/flag"},
        "stored_format": {"$ref": "#/definitions/flag"},
        "trust_or_permission": {"$ref": "#/definitions/flag"},
        "global_view": {"$ref": "#/definitions/flag"}
      }
    },
    "read": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full", "structure", "record"],
      "properties": {"full": {"$ref": "#/definitions/paths"}, "structure": {"$ref": "#/definitions/paths"}, "record": {"$ref": "#/definitions/paths"}}
    },
    "patch_ids": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{40}$"}},
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "family", "harness"],
      "properties": {"model": {"type": "string", "minLength": 1}, "family": {"type": "string", "minLength": 1}, "harness": {"type": "string", "minLength": 1}}
    },
    "standard": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "text": {"type": "string", "minLength": 1}
  }
}
