{
  "version": 1,
  "default": "claude",
  "timeout_seconds": 1800,
  "structure_only": [
    "**/Cargo.lock",
    "flake.lock",
    "**/package-lock.json",
    "**/bun.lock",
    "**/*.snap",
    "**/fixtures/**",
    "**/testdata/**"
  ],
  "harnesses": {
    "claude": {
      "family": "anthropic",
      "model": null,
      "command": [
        "claude",
        "-p",
        "--output-format",
        "json",
        "--no-session-persistence",
        "--permission-mode",
        "dontAsk",
        "--strict-mcp-config",
        "--allowedTools",
        "Read(/{cwd}/**) Grep(/{cwd}/**) Glob(/{cwd}/**)"
      ],
      "model_args": [
        "--model",
        "{model}"
      ],
      "parse": "claude-json"
    },
    "codex": {
      "family": "openai",
      "reads": "shell",
      "model": null,
      "command": [
        "codex",
        "exec",
        "-c",
        "default_permissions=\"review\"",
        "-c",
        "permissions.review.filesystem={\":minimal\"=\"read\",\"{cwd}\"=\"read\",\"{harness_root}\"=\"read\"}",
        "--skip-git-repo-check",
        "--ephemeral",
        "-C",
        "{cwd}",
        "--output-last-message",
        "{out}",
        "-"
      ],
      "model_args": [
        "-m",
        "{model}"
      ],
      "parse": "file"
    }
  }
}
