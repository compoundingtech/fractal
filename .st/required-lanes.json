{
  "version": 1,
  "lanes": {
    "genie-freshness": {
      "argv": [
        "nix",
        "develop",
        ".#genie",
        "-c",
        "bash",
        "scripts/ci-genie-freshness"
      ],
      "definition_paths": [
        ".st",
        "flake.lock",
        "flake.nix",
        "scripts"
      ],
      "tree_inputs": [
        "."
      ]
    },
    "typescript-client": {
      "argv": [
        "nix",
        "develop",
        ".#web",
        "-c",
        "bash",
        "-c",
        "pnpm install --frozen-lockfile && bash scripts/ci-typescript-client"
      ],
      "definition_paths": [
        "flake.lock",
        "flake.nix",
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "scripts/ci-typescript-client"
      ],
      "tree_inputs": [
        "apps/fractal-web/package.json",
        "packages/fractal-sdk/package.json",
        "apps/fractal-web/src/folders/core.mts",
        "apps/ios",
        "clients/typescript",
        "crates/fractal-tui/tests/fixtures/quality-hour.json",
        "docs/st3/client-v0/fixtures",
        "fixtures/clients",
        "flake.lock",
        "flake.nix",
        "package.json",
        "packages/fractal-ui/package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "scripts/ci-typescript-client"
      ],
      "absent_paths": [
        ".npmrc",
        ".pnp.cjs",
        ".pnpmfile.cjs",
        ".pnpmfile.mjs",
        "apps/fractal-web/binding.gyp",
        "apps/fractal-web/package.json5",
        "apps/fractal-web/package.yaml",
        "packages/fractal-sdk/binding.gyp",
        "packages/fractal-sdk/package.json5",
        "packages/fractal-sdk/package.yaml",
        "packages/fractal-sdk/pnpm-workspace.yaml",
        "apps/fractal-web/pnpm-workspace.yaml",
        "apps/node_modules",
        "binding.gyp",
        "clients/node_modules",
        "clients/pnpm-workspace.yaml",
        "fixtures/node_modules",
        "fixtures/package.json",
        "package.json5",
        "package.yaml",
        "packages/fractal-ui/binding.gyp",
        "packages/fractal-ui/package.json5",
        "packages/fractal-ui/package.yaml",
        "packages/fractal-ui/pnpm-workspace.yaml"
      ]
    }
  }
}
