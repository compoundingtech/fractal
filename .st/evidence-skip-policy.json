              "command": [
                "nix",
                "develop",
                "-c",
                "bash",
                "scripts/ci-local",
                "tests",
                "clippy",
                "fleet-compat"
              ],
              "required_inputs": [
                "flake_lock_sha256",
                "toolchain_sha256",
                "wrapper_sha256",
                "system",
                "attempt",
                "clippy_base_sha"
              ],
              "bind_inputs": {
                "flake_lock_sha256": "flake.lock"
              },
              "events": [
                "pull_request"
              ],
              "lane": true
            },
            "queue": {
              "command": [
                "nix",
                "develop",
                "-c",
                "bash",
                "scripts/ci-local",
                "tests",
                "clippy",
                "fleet-compat"
