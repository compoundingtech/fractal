{
  "version": 1,
  "checks": {
    "linux-gate": {
      "trust_levels": [
        "fleet"
      ],
      "kinds": {
        "observed": {
          "command": [
            "github-actions",
            "{repository}",
            ".github/workflows/fleet.yml",
            "{check}"
          ],
          "runner_prefix": "github:{repository}/"
        },
        "wrapper": {
          "command": [
            "linux-gate",
            "aggregate",
            "linux-clippy",
            "linux-fleet-compat",
            "linux-gate",
            "linux-test-build",
            "linux-tests",
            "linux-tests-shard-2",
            "linux-tests-shard-3",
            "linux-tests-shard-4",
            "mail-redelivery-canaries",
            "upgrade-impact"
          ],
          "required_inputs": [
            "flake_lock_sha256",
            "toolchain_sha256",
            "wrapper_sha256",
            "system",
            "attempt"
          ],
          "bind_inputs": {
            "flake_lock_sha256": "flake.lock"
          }
        }
      }
    },
    "typescript-client": {
      "trust_levels": [
        "fleet"
      ],
      "kinds": {
        "observed": {
          "command": [
            "github-actions",
            "{repository}",
            ".github/workflows/fleet.yml",
            "{check}"
          ],
          "runner_prefix": "github:{repository}/"
        }
      }
    },
    "isolation-vm": {
      "trust_levels": [
        "fleet"
      ],
      "kinds": {
        "observed": {
          "command": [
            "github-actions",
            "{repository}",
            ".github/workflows/fleet.yml",
            "{check}"
          ],
          "runner_prefix": "github:{repository}/"
        }
      }
    },
    "genie-freshness": {
      "trust_levels": [
        "fleet"
      ],
      "kinds": {
        "observed": {
          "command": [
            "github-actions",
            "{repository}",
            ".github/workflows/fleet.yml",
            "{check}"
          ],
          "runner_prefix": "github:{repository}/"
        }
      }
    },
    "mail-redelivery-canaries": {
      "trust_levels": [
        "fleet"
      ],
      "kinds": {
        "observed": {
          "command": [
            "github-actions",
            "{repository}",
            ".github/workflows/fleet.yml",
            "{check}"
          ],
          "runner_prefix": "github:{repository}/"
        },
        "wrapper": {
          "command": [
            "bash",
            "scripts/ci-linux",
            "mail-redelivery-canaries"
          ],
          "required_inputs": [
            "flake_lock_sha256",
            "toolchain_sha256",
            "wrapper_sha256",
            "system",
            "attempt",
            "stage",
            "job"
          ],
          "bind_inputs": {
            "flake_lock_sha256": "flake.lock"
          }
        }
      }
    }
  }
}
