{
  "version": 1,
  "checks": {
    "linux-gate": {
      "trust_levels": [
        "fleet"
      ],
      "enforce": false,
      "sample_one_in": 5,
      "inputs": [
        ".cargo",
        ".config/nextest.toml",
        ".github",
        "Cargo.lock",
        "Cargo.toml",
        "apps/fractal-web/src/terminal/assets/JetBrainsMonoNerdFontMono-Regular.ttf",
        "claude-channel",
        "clients",
        "components",
        "crates",
        "docs/st2",
        "docs/st3",
        "docs/vrs",
        "evals",
        "examples",
        "fixtures",
        "flake.lock",
        "flake.nix",
        "nix",
        "plugins",
        "scripts",
        "slo",
        "src",
        "templates",
        "tests",
        "vendor",
        "wit"
      ],
      "kinds": {
        "observed": {
          "command": [
            "github-actions",
            "{repository}",
            ".github/workflows/fleet.yml",
            "{check}"
          ],
          "runner_prefix": "github:{repository}/"
        },
        "wrapper": {
          "command": [
            "linux-gate",
            "aggregate",
            "genie-freshness",
            "isolation-vm",
            "linux-clippy",
            "linux-fleet-compat",
            "linux-gate",
            "linux-test-build",
            "linux-tests",
            "linux-tests-shard-2",
            "linux-tests-shard-3",
            "linux-tests-shard-4",
            "mail-redelivery-canaries",
            "typescript-client",
            "upgrade-impact"
          ],
          "required_inputs": [
            "flake_lock_sha256",
            "toolchain_sha256",
            "wrapper_sha256",
            "system",
            "attempt"
          ],
          "bind_inputs": {
            "flake_lock_sha256": "flake.lock"
          }
        }
      }
    },
    "typescript-client": {
      "trust_levels": [
        "fleet"
      ],
      "enforce": true,
      "events": [
        "pull_request"
      ],
      "sample_one_in": 5,
      "inputs": [
        "apps/fractal-web/package.json",
        "apps/fractal-web/packages/fractal-sdk/package.json",
        "apps/fractal-web/src/folders/core.mts",
        "apps/ios",
        "clients/typescript",
        "crates/fractal-tui/tests/fixtures/quality-hour.json",
        "docs/st3/client-v0/fixtures",
        "fixtures/clients",
        "flake.lock",
        "flake.nix",
        "package.json",
        "packages/fractal-ui/package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "scripts/ci-typescript-client"
      ],
      "kinds": {
        "observed": {
          "command": [
            "github-actions",
            "{repository}",
            ".github/workflows/fleet.yml",
            "{check}"
          ],
          "runner_prefix": "github:{repository}/"
        },
        "wrapper": {
          "command": [
            "bash",
            "scripts/ci-typescript-client"
          ],
          "required_inputs": [
            "flake_lock_sha256",
            "toolchain_sha256",
            "wrapper_sha256",
            "system",
            "attempt",
            "job",
            "steps",
            "step_outcomes"
          ],
          "bind_inputs": {
            "flake_lock_sha256": "flake.lock"
          },
          "trust_levels": [
            "fleet",
            "host",
            "agent"
          ],
          "by_level": {
            "host": {
              "command": [
                "nix",
                "develop",
                ".#web",
                "-c",
                "bash",
                "-c",
                "pnpm install --frozen-lockfile && bash scripts/ci-typescript-client"
              ],
              "required_inputs": [
                "flake_lock_sha256",
                "toolchain_sha256",
                "wrapper_sha256",
                "system",
                "attempt"
              ],
              "bind_inputs": {
                "flake_lock_sha256": "flake.lock"
              },
              "events": [
                "pull_request"
              ]
            },
            "agent": {
              "command": [
                "nix",
                "develop",
                ".#web",
                "-c",
                "bash",
                "-c",
                "pnpm install --frozen-lockfile && bash scripts/ci-typescript-client"
              ],
              "required_inputs": [
                "flake_lock_sha256",
                "toolchain_sha256",
                "wrapper_sha256",
                "system",
                "attempt"
              ],
              "bind_inputs": {
                "flake_lock_sha256": "flake.lock"
              },
              "events": [
                "pull_request"
              ],
              "lane": true
            }
          }
        }
      },
      "require": "shadow"
    },
    "isolation-vm": {
      "trust_levels": [
        "fleet"
      ],
      "enforce": false,
      "kinds": {
        "observed": {
