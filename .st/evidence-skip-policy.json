{
  "version": 1,
  "checks": {
    "linux-gate": {
      "trust_levels": [
        "fleet"
      ],
      "kinds": {
        "observed": {
          "command": [
            "github-actions",
            "{repository}",
            ".github/workflows/fleet.yml",
            "{check}"
          ],
          "runner_prefix": "github:{repository}/"
        }
      }
    },
