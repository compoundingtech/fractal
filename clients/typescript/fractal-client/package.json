{
  "name": "@fractal/client",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test contract.test.cjs schema.test.cjs fabric.test.cjs",
    "test:contract": "node --test contract.test.cjs",
    "test:schema": "node --test schema.test.cjs",
    "typecheck": "pnpm run typecheck:client && pnpm run typecheck:schema",
    "typecheck:client": "tsc -p tsconfig.json",
    "typecheck:schema": "tsc -p tsconfig.schema.json"
  },
  "exports": {
    ".": "./index.ts",
    "./schema": "./Schema.generated.ts",
    "./fabric": "./fabric.mjs"
  },
  "peerDependencies": {
    "effect": "4.0.0"
  },
  "peerDependenciesMeta": {
    "effect": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "effect": "4.0.0",
    "typescript": "6.0.3"
  }
}
