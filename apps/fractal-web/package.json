{
  "name": "fractal-web",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:embed": "node scripts/embed-proof.mjs",
    "changelog:registry": "node scripts/changelog-registry.mjs",
    "changelog:registry:check": "node scripts/changelog-registry.mjs --check",
    "typecheck": "node scripts/changelog-registry.mjs && tsc --noEmit",
    "check:st-coverage": "bun scripts/check-st-coverage.ts",
    "dev": "vite --config vite.config.ts --configLoader runner",
    "build": "vite build --config vite.config.ts --configLoader runner",
    "build:embed": "vite build --config vite.embed.config.ts --configLoader runner",
    "start": "node server/main.mts"
  },
  "dependencies": {
    "@effect/opentelemetry": "4.0.3",
    "@effect/platform-node": "4.0.3",
    "@effect/platform-node-shared": "4.0.3",
    "@overeng/devbar": "workspace:^",
    "@overeng/meters": "workspace:^",
    "@overeng/utils": "workspace:^",
    "@fractal/client": "file:../../clients/typescript/fractal-client",
    "effect": "4.0.3",
    "fractional-indexing": "3.2.0",
    "@fractal/ui": "workspace:*",
    "@fractal/sdk": "workspace:*",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-aria": "3.52.1",
    "react-aria-components": "1.21.1",
    "react-stately": "3.50.0",
    "@stylexjs/stylex": "0.19.0",
    "@effect/atom-react": "4.0.3"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.3",
    "@fractal/scenarios": "workspace:*",
    "@types/node": "24.10.0",
    "typescript": "6.0.3",
    "vitest": "4.1.9",
    "fast-check": "4.3.0",
    "fake-indexeddb": "6.2.4",
    "vite": "8.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@stylexjs/unplugin": "0.19.0",
    "jsdom": "26.1.0"
  },
  "version": "0.1.0"
}
