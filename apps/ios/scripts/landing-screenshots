#!/usr/bin/env bash
# Capture the real Debug app using demoGateway's invented, unauthenticated data.
set -Eeuo pipefail

usage() {
  cat <<'HELP'
Usage: apps/ios/scripts/landing-screenshots --gateway-host LAN_IPV4 [--output DIR]

Run on macOS from a disposable checkout with Node 24, Corepack, CocoaPods,
Maestro (https://maestro.mobile.dev/), full Xcode, and an iOS simulator runtime.
Prepare the checkout using docs/development.md's source-input setup first:
  mr apply --worktree-mode auto
Then invoke this script inside the documented web shell:
  nix develop .#web -c apps/ios/scripts/landing-screenshots --gateway-host LAN_IPV4
The gateway host must be this Mac's LAN or Tailscale IPv4, reachable by the
simulator; localhost is intentionally rejected by the app's gateway policy.

Installs the locked JS dependencies, prebuilds the ignored native project,
builds Debug, starts demoGateway and Metro, and uses the actual pairing UI.
No account, daemon, device, Apple login, or real pairing credential is used.
Creates exactly one private iPhone simulator; shuts it down and deletes it on
success, error, or interruption. Never touches existing simulators.

Outputs now-light.png, now-dark.png, conversation-light.png,
conversation-dark.png, and command/service logs under DIR (default:
<repo>/tmp/landing-screenshots/<timestamp>). Existing PNGs are not overwritten.
Light and dark PNGs must differ for each view; byte-identical pairs are fatal.
Uses ports 8791 (demoGateway) and 8081 (Metro); these must be free.
Build or gateway failures are fatal: no retries, patches, or fallback builds.
The generated native project is disposable; do not run in a checkout whose
ignored ios/ directory contains changes you want to keep.
HELP
}

host=''
out=''
while (($#)); do
  case "$1" in
    --help|-h) usage; exit 0 ;;
    --gateway-host) host="${2:?Missing IPv4}"; shift 2 ;;
    --output) out="${2:?Missing output directory}"; shift 2 ;;
    *) printf 'Unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
done
[[ -n "$host" ]] || { usage >&2; exit 2; }
[[ "$host" =~ ^(10\.|192\.168\.|172\.(1[6-9]|2[0-9]|3[01])\.|100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.)[0-9.]+$ ]] || {
  printf 'Expected this Mac\x27s private LAN or Tailscale IPv4.\n' >&2; exit 2;
}
root="$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"
out="${out:-$root/tmp/landing-screenshots/$(date +%Y%m%d-%H%M%S)}"
mkdir -p "$out"
out="$(cd "$out" && pwd)"
for name in now-light now-dark conversation-light conversation-dark; do
  [[ ! -e "$out/$name.png" ]] || { printf 'Already exists: %s\n' "$out/$name.png" >&2; exit 2; }
done
exec > >(tee "$out/commands.log") 2>&1
# Native generation and builds must not inherit the devshell's CC=clang,
# NIX_CFLAGS_*/NIX_LDFLAGS, or macOS-only SDK. xcodebuild otherwise resolves
# clang to Nix's cc-wrapper even when xcodebuild itself is Apple's executable.
# Keep only the host/session and explicit screenshot inputs; put Apple's tools
# first while retaining Node and the ephemeral CocoaPods CLI on the tail of PATH.
# Clear DEVELOPER_DIR during discovery too: xcode-select otherwise echoes it.
apple_developer_dir="$(env -u DEVELOPER_DIR /usr/bin/xcode-select -p)"
native() {
  local -a launch=()
  if [[ "${native_replace_process:-0}" = 1 ]]; then launch=(exec); fi
  "${launch[@]}" env -i \
    HOME="$HOME" USER="${USER:-}" LOGNAME="${LOGNAME:-}" TMPDIR="${TMPDIR:-/tmp}" \
    PATH="$apple_developer_dir/Toolchains/XcodeDefault.xctoolchain/usr/bin:$apple_developer_dir/usr/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH" \
    DEVELOPER_DIR="$apple_developer_dir" NODE_BINARY="$(command -v node)" \
    LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8 APP_VARIANT=dev EXPO_NO_DOTENV=1 \
    EXPO_PUBLIC_FRACTAL_FABRIC_DEFAULT='' \
    EXPO_PUBLIC_FRACTAL_LANDING_CAPTURE=1 \
    EXPO_PUBLIC_FRACTAL_TEST_PAIR_LINK="${EXPO_PUBLIC_FRACTAL_TEST_PAIR_LINK:-}" \
    EXPO_PUBLIC_FRACTAL_TEST_TAB=Now EXPO_PUBLIC_FRACTAL_TEST_LINKS='' \
    "$@"
}
xcrun() { native /usr/bin/xcrun "$@"; }
xcodebuild() { native /usr/bin/xcodebuild "$@"; }
sim=''
gateway_pid=''
metro_pid=''
pairing_log_pid=''
stop_pairing_log() {
  if [[ -n "$pairing_log_pid" ]]; then
    kill "$pairing_log_pid"
    wait "$pairing_log_pid" || :
    # A successful wait reaps the exec-replaced logger, not a wrapper shell.
    if kill -0 "$pairing_log_pid" 2>/dev/null; then
      printf 'Pairing logger did not stop\n' >&2
      return 1
    fi
    pairing_log_pid=''
    printf 'Pairing logger stopped and reaped\n'
    # The simulator's log executable can outlive simctl. Its predicate includes
    # this disposable simulator's UUID, so never match another capture's stream.
    local remaining pid attempt
    printf '$ /usr/bin/pgrep -fl "log stream.*%s"\n' "$sim"
    if remaining=$(/usr/bin/pgrep -f "log stream.*$sim"); then
      printf 'Stopping remaining simulator log process(es): %s\n' "$remaining"
      for pid in $remaining; do kill "$pid"; done
      for ((attempt=0; attempt<30; attempt++)); do
        if ! /usr/bin/pgrep -f "log stream.*$sim" >/dev/null; then break; fi
        sleep 0.1
      done
    fi
    if /usr/bin/pgrep -fl "log stream.*$sim"; then
      printf 'Simulator log stream still running\n' >&2
      return 1
    fi
    printf 'PASS: no log stream remains for simulator %s\n' "$sim"
  fi
}
cleanup() {
  local status=$?
  trap - EXIT INT TERM ERR
  set +e
  stop_pairing_log
  for pid in "$metro_pid" "$gateway_pid"; do
    if [[ -n "$pid" ]]; then kill "$pid"; wait "$pid"; fi
  done
  if [[ -n "$sim" ]]; then
    xcrun simctl shutdown "$sim"
    xcrun simctl delete "$sim"
  fi
  exit "$status"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
run() { printf '\n$'; printf ' %q' "$@"; printf '\n'; "$@"; }
trap 'status=$?; printf "\nFAILED (exit %s): %s\n" "$status" "$BASH_COMMAND" >&2' ERR
cd "$root"
run corepack pnpm install --frozen-lockfile
cd apps/ios
export APP_VARIANT=dev
export EXPO_NO_DOTENV=1
export EXPO_PUBLIC_FRACTAL_LANDING_CAPTURE=1
export EXPO_PUBLIC_FRACTAL_FABRIC_DEFAULT=''
export EXPO_PUBLIC_FRACTAL_FABRIC_PROOF_LINK=''
export EXPO_PUBLIC_ST3_FABRIC_PROOF_LINK=''
export EXPO_PUBLIC_FRACTAL_TEST_PAIR_LINK="com.compoundingtech.fractal.starter://pair?gateway=http%3A%2F%2F${host}%3A8791&id=demo&code=demo"
export EXPO_PUBLIC_FRACTAL_TEST_TAB=Now
export EXPO_PUBLIC_FRACTAL_TEST_LINKS=''
run native corepack pnpm exec expo prebuild --platform ios --clean --no-install
run native corepack pnpm run pods
# iPhone 16 Pro is supported by the macos-15 hosted runner's Xcode as well as newer Xcode.
sim="$(xcrun simctl create "Fractal landing screenshots $$" 'iPhone 16 Pro')"
printf 'Created simulator: %s\n' "$sim"
run xcrun simctl boot "$sim"
run xcrun simctl bootstatus "$sim" -b
run xcrun simctl status_bar "$sim" override --time '9:41' --dataNetwork wifi --wifiMode active --wifiBars 3 --batteryState charged --batteryLevel 100
run xcodebuild -workspace ios/fractal.xcworkspace -scheme fractal -configuration Debug -destination "id=$sim" -derivedDataPath "$out/DerivedData" build

start_service() {
  local logfile="$1"; shift
  printf '\n$'; printf ' %q' "$@"; printf ' > %q 2>&1 &\n' "$logfile"
  "$@" > "$logfile" 2>&1 &
  service_pid=$!
}
# Health waiting is only startup synchronization, not a service restart/retry.
wait_service() {
  local pid="$1" url="$2" logfile="$3"
  local n
  for ((n=0; n<60; n++)); do
    if ! kill -0 "$pid" 2>/dev/null; then
      cat "$logfile"
      wait "$pid"
      return 1
    fi
    if curl --silent --fail "$url" >/dev/null; then return; fi
    sleep 1
  done
  cat "$logfile"
  printf 'Timed out waiting for %s\n' "$url" >&2
  return 1
}
run node --input-type=module -e '
  import { createRequire } from "node:module";
  import { WebSocketServer } from "ws";
  const require = createRequire(import.meta.url);
  const { name, version } = require("ws/package.json");
  console.log(JSON.stringify({ name, version, path: import.meta.resolve("ws"), server: typeof WebSocketServer }));
'
start_service "$out/demoGateway.log" node --experimental-transform-types demoGateway.mjs 8791
gateway_pid="$service_pid"
wait_service "$gateway_pid" 'http://127.0.0.1:8791/v1/client/capabilities' "$out/demoGateway.log"
start_service "$out/metro.log" corepack pnpm exec expo start --localhost --port 8081 --clear
metro_pid="$service_pid"
wait_service "$metro_pid" 'http://localhost:8081/status' "$out/metro.log"
run xcrun simctl install "$sim" "$out/DerivedData/Build/Products/Debug-iphonesimulator/fractal.app"
# Stream before launch so pairing-stage native alert/presentation diagnostics survive
# a failed Maestro flow. The existing *.log artifact retains this on every outcome.
# Replace the background shell with xcrun, so $! owns the actual logger.
(
  native_replace_process=1
  native /usr/bin/xcrun simctl spawn "$sim" log stream --style compact --level debug \
    --predicate "(process == \"fractal\" OR subsystem BEGINSWITH \"com.apple.UIKit\") AND \"$sim\" == \"$sim\"" \
    > "$out/pairing-simulator.log" 2>&1
) &
pairing_log_pid=$!
run xcrun simctl launch "$sim" com.compoundingtech.fractal.starter -RCT_jsLocation localhost:8081

cat > "$out/pair.yaml" <<'FLOW'
appId: com.compoundingtech.fractal.starter
---
- extendedWaitUntil:
    visible:
      text: 'pair without a trusted fingerprint…'
      enabled: true
    timeout: 120000
# Capture-only LogBox policy prevents notification overlays; fail if one appears.
- assertNotVisible: '.*Open debugger to view warnings.*'
# Only the pre-confirmation press is repeatable, never the pairing submission.
# Stop when the alert appears or the enabled pre-confirmation control disappears.
- repeat:
    times: 3
    while:
      visible:
        text: 'pair without a trusted fingerprint…'
        enabled: true
      notVisible: 'Pair without identity verification\?|Use unpinned pairing'
    commands:
      - tapOn:
          text: 'pair without a trusted fingerprint…'
          enabled: true
      - waitForAnimationToEnd
- extendedWaitUntil:
    visible: 'Pair without identity verification\?'
    timeout: 10000
- assertVisible: 'Use unpinned pairing'
- tapOn: 'Use unpinned pairing'
- assertVisible: 'require fingerprint again'
# Maestro matches text case-insensitively by default; do not tap the navigation title.
- tapOn: '(?-i:^pair this device$)'
- extendedWaitUntil:
    visible: '.*Review the loadUser rename.*'
    timeout: 30000
- assertNotVisible: '.*Open debugger to view warnings.*'
FLOW
run maestro --device "$sim" test "$out/pair.yaml"
stop_pairing_log
for view in now conversation; do
  if [[ "$view" = now ]]; then
    link='com.compoundingtech.fractal.starter://tab/Now'
    expected='Review the loadUser rename'
  else
    link='com.compoundingtech.fractal.starter://agent?id=agent/example/atlas/builder'
    expected='Atlas Builder'
  fi
  cat > "$out/navigate.yaml" <<FLOW
appId: com.compoundingtech.fractal.starter
---
- openLink:
    link: '$link'
# autoVerify is Android-only; a fresh iOS simulator asks before opening the app.
- runFlow:
    when:
      visible: 'Open in.*Fractal Dev.*'
    commands:
      - tapOn: 'Open'
- extendedWaitUntil:
    visible: '.*$expected.*'
    timeout: 30000
FLOW
  run maestro --device "$sim" test "$out/navigate.yaml"
  for appearance in light dark; do
    run xcrun simctl ui "$sim" appearance "$appearance"
    sleep 2
    run xcrun simctl io "$sim" screenshot --type=png "$out/$view-$appearance.png"
  done
  if cmp -s "$out/$view-light.png" "$out/$view-dark.png"; then
    printf 'FAILED: %s light/dark screenshots are byte-identical: %s and %s\n' \
      "$view" "$out/$view-light.png" "$out/$view-dark.png" >&2
    exit 1
  fi
done
printf '\nScreenshots saved to %s\n' "$out"
