    {"name":"missing fingerprint","schema":"PairingExchangeRequest","valid":false,"value":{"v":1,"request_id":"wait-1","op":"approval-wait","body":{"pairing_id":"pairing/example"}}},
    {"name":"missing pairing ID","schema":"PairingExchangeRequest","valid":false,"value":{"v":1,"request_id":"wait-1","op":"approval-wait","body":{"key_fingerprint":"sha256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"}}},
    {"name":"malformed fingerprint","schema":"PairingExchangeRequest","valid":false,"value":{"v":1,"request_id":"wait-1","op":"approval-wait","body":{"pairing_id":"pairing/example","key_fingerprint":"sha256:short"}}},
    {"name":"authority field not permitted","schema":"PairingExchangeRequest","valid":false,"value":{"v":1,"request_id":"wait-1","op":"approval-wait","body":{"pairing_id":"pairing/example","key_fingerprint":"sha256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","approve":true}}},
    {"name":"missing request ID","schema":"PairingExchangeRequest","valid":false,"value":{"v":1,"op":"approval-wait","body":{"pairing_id":"pairing/example","key_fingerprint":"sha256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"}}},
    {"name":"valid durable approved reply","schema":"PairingApprovalWaitReply","valid":true,"value":{"v":1,"request_id":"wait-1","ok":true,"body":{"status":"approved","key_fingerprint":"sha256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","approved_at":"2026-01-01T00:01:00Z"}}},
    {"name":"approved missing timestamp","schema":"PairingApprovalWaitReply","valid":false,"value":{"v":1,"request_id":"wait-1","ok":true,"body":{"status":"approved","key_fingerprint":"sha256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"}}},
    {"name":"approved must not contain credential","schema":"PairingApprovalWaitReply","valid":false,"value":{"v":1,"request_id":"wait-1","ok":true,"body":{"status":"approved","key_fingerprint":"sha256:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA","approved_at":"2026-01-01T00:01:00Z","credential":"never-before-S3"}}},
    {"name":"rejected refusal","schema":"PairingApprovalWaitReply","valid":true,"value":{"v":1,"request_id":"wait-1","ok":false,"refusal":{"code":"pairing-rejected"}}},
    {"name":"expired refusal","schema":"PairingApprovalWaitReply","valid":true,"value":{"v":1,"request_id":"wait-1","ok":false,"refusal":{"code":"pairing-expired"}}},
    {"name":"mismatched key refusal","schema":"PairingApprovalWaitReply","valid":true,"value":{"v":1,"request_id":"wait-1","ok":false,"refusal":{"code":"pairing-key-mismatch"}}},
    {"name":"concurrent wait refusal","schema":"PairingApprovalWaitReply","valid":true,"value":{"v":1,"request_id":"wait-2","ok":false,"refusal":{"code":"pairing-wait-busy"}}},
    {"name":"unrecognized wait refusal","schema":"PairingApprovalWaitReply","valid":false,"value":{"v":1,"request_id":"wait-1","ok":false,"refusal":{"code":"not-a-wait-refusal"}}},
    {"name":"contradictory approved refusal","schema":"PairingApprovalWaitReply","valid":false,"value":{"v":1,"request_id":"wait-1","ok":true,"refusal":{"code":"pairing-rejected"}}},
    {"name":"changed digest conflict envelope","schema":"PairingExchangeReply","valid":true,"value":{"v":1,"request_id":"wait-1","ok":false,"refusal":{"code":"pairing-request-conflict","message":"Request ID reused with a different body digest"}}}
