  "replay_scenarios": [
    {"name":"identical wait while held","same_attempt":true,"same_op":true,"same_request_id":true,"same_body_digest":true,"expected":"rejoin-in-flight-wait","new_reply_count":1},
    {"name":"identical wait after reply","same_attempt":true,"same_op":true,"same_request_id":true,"same_body_digest":true,"expected":"retained-reply","new_authority":false},
    {"name":"identical wait after daemon restart","same_attempt":true,"same_op":true,"same_request_id":true,"same_body_digest":true,"expected":"reply-from-durable-approval-state","in_memory_wait_authoritative":false},
    {"name":"same request ID different digest","same_attempt":true,"same_op":true,"same_request_id":true,"same_body_digest":false,"expected_code":"pairing-request-conflict"},
    {"name":"new concurrent approval wait","same_attempt":true,"same_op":true,"same_request_id":false,"wait_in_flight":true,"expected_code":"pairing-wait-busy"},
    {"name":"new complete after successful complete","op":"complete","same_request_id":false,"previous_complete_succeeded":true,"expected_code":"pairing-claim-invalid","extra_grants":0}
