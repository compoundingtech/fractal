    {
      "name": "inline drops block syntax",
      "kind": "inline",
      "markdown": "# Ship `v2` **now**",
      "code": [
        "v2"
      ],
      "text": [
        "Ship",
        "now"
      ],
      "absent": [
        "#",
        "**"
      ]
    }
  ]
}
