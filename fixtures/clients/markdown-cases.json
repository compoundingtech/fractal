      "h1": [],
      "h2": [],
      "h3": [],
      "h4": [],
      "h5": [],
      "h6": [],
      "hr": [],
      "i": [],
      "img": [
        "src",
        "alt",
        "title",
        "width",
        "height"
      ],
      "ins": [],
      "kbd": [],
      "li": [],
      "mark": [],
      "ol": [
        "start"
      ],
      "p": [],
      "pre": [],
      "q": [],
      "s": [],
      "samp": [],
      "small": [],
      "span": [],
      "strike": [],
      "strong": [],
      "sub": [],
      "summary": [],
      "sup": [],
      "table": [],
      "tbody": [],
      "td": [
        "align",
        "colspan",
        "rowspan"
      ],
      "tfoot": [],
      "th": [
        "align",
        "colspan",
        "rowspan"
      ],
      "thead": [],
      "tr": [],
      "tt": [],
      "u": [],
      "ul": [],
      "var": []
    },
    "dropWithContent": [
      "applet",
      "audio",
      "button",
      "canvas",
      "embed",
      "form",
      "frame",
      "frameset",
      "head",
      "iframe",
      "input",
      "math",
      "noembed",
      "noframes",
      "noscript",
      "object",
      "option",
      "plaintext",
      "script",
      "select",
      "style",
      "svg",
      "template",
      "textarea",
      "title",
      "video",
      "xmp"
    ],
    "linkProtocols": [
      "http:",
      "https:"
    ],
    "referenceLink": "^doc/(?!(?:.*/)?\\.\\.(?:/|@|$))[A-Za-z0-9._~-]+(?:/[A-Za-z0-9._~-]+)*(?:@[0-9a-f]{6,64})?$",
    "maxDepth": 32
  },
  "cases": [
    {
      "name": "daemon command as code",
      "kind": "block",
      "markdown": "A mission step is ready: step-run/demo-1/work. Run `st work claim step-run/demo-1/work --as agent/demo/one` to read and claim it.",
      "code": [
        "st work claim step-run/demo-1/work --as agent/demo/one"
      ],
      "absent": [
        "`"
      ]
    },
    {
      "name": "typed lines stay lines",
      "kind": "prompt",
      "markdown": "first line\nsecond line",
      "text": [
        "first line",
        "second line"
      ],
      "lineBreaks": 1
    },
    {
      "name": "tag-like words stay",
      "kind": "block",
      "markdown": "Use Array<string> or <T> here",
      "text": [
        "Array<string>",
        "<T>"
      ]
    },
    {
      "name": "escaped markup stays text",
      "kind": "block",
      "markdown": "Escaped &lt;script&gt; text",
      "text": [
        "<script>"
      ],
      "absent": [
        "script>alert"
      ]
    },
    {
      "name": "script dropped with content",
      "kind": "block",
      "markdown": "<script>alert(1)</script>\n\nAfter",
      "text": [
        "After"
      ],
      "absent": [
        "alert(1)"
      ]
    },
    {
      "name": "unsafe link becomes text",
      "kind": "block",
      "markdown": "[open](javascript:alert(1)) and [mail](mailto:a@example.test)",
      "text": [
        "open",
        "mail"
      ],
      "links": []
    },
    {
      "name": "http link stays a link",
      "kind": "block",
      "markdown": "[docs](https://example.test/docs)",
      "links": [
        "https://example.test/docs"
      ]
    },
    {
      "name": "document reference stays a link",
      "kind": "block",
      "markdown": "See [the plan](doc/garden-plan).",
      "links": [
        "doc/garden-plan"
      ]
    },
    {
      "name": "comment hidden",
      "kind": "block",
      "markdown": "Shown <!-- hidden note --> text",
      "text": [
        "Shown",
        "text"
      ],
      "absent": [
        "hidden note"
      ]
    },
    {
      "name": "details body is Markdown",
      "kind": "block",
      "markdown": "<details><summary>More</summary>\n\nHidden *body*.\n\n</details>",
      "text": [
        "More",
        "Hidden",
        "body"
      ],
      "disclosure": "More"
    },
    {
      "name": "remote image waits for consent",
      "kind": "block",
      "markdown": "![chart](https://example.test/chart.png)",
      "text": [
        "chart"
      ],
      "remoteImages": 0
    },
    {
      "name": "deep quotes stay bounded",
      "kind": "block",
      "markdown": ">>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>>