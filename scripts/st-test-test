    def test_a_check_that_builds_runs_in_a_builds_slice_scope_without_holding_a_stage_slot(self):
        self.commit('b.txt', 'two')
        tmp = Path(self.tmp.name)
        calls = tmp / 'calls'
        bin_dir, runtime = tmp / 'bin', tmp / 'runtime'
        bin_dir.mkdir()
        runtime.mkdir()
        (runtime / 'bus').touch()
        (self.home / '.local/bin').mkdir(parents=True)
        # A shim that supports --stage-slot and a systemd-run: each records its arguments and runs what follows its `--`.
        recorder = '#!/bin/sh\n# --stage-slot\nprintf "%s\\n" "$(basename "$0") $*" >> {calls}\nwhile [ "$1" != -- ]; do shift; done; shift; exec "$@"\n'
        for path in (self.home / '.local/bin/cargo', bin_dir / 'systemd-run'):
            path.write_text(recorder.format(calls=calls))
            path.chmod(0o755)
        env = {'PATH': f'{bin_dir}:{os.environ["PATH"]}', 'XDG_RUNTIME_DIR': str(runtime)}
        with mock.patch.object(st_test, 'BUILDS', frozenset({'demo'})):
            code, out, err = self.run_st_test('--check', 'demo', extra_env=env)
            self.assertEqual(code, 0, err)
            # The scope alone: no stage ticket, whose holder the test guardian's cargo commands would queue behind (they detach).
            only, = calls.read_text().splitlines()
            self.assertTrue(only.startswith('systemd-run --user --scope --quiet --collect --slice=builds.slice -- '), only)
            self.assertIn('evidence-wrap --check demo', only)
            statement, = self.statements()
            self.assertEqual(statement['predicate']['observed']['checks']['demo']['command'], ['sh', '-c', 'echo ran'])  # what is signed is unchanged
            calls.unlink()
            self.commit('c.txt', 'three')
            self.assertEqual(self.run_st_test('--check', 'demo', extra_env=dict(env, ST_EVIDENCE_GOVERN='off'))[0], 0)
            self.assertFalse(calls.exists())
            self.commit('d.txt', 'four')
            (tmp / 'no-bus').mkdir()
            code, out, err = self.run_st_test('--check', 'demo', extra_env={'XDG_RUNTIME_DIR': str(tmp / 'no-bus')})  # no user bus: runs anyway, and says so
            self.assertEqual(code, 0, err)
            self.assertIn('st-test: demo runs without the host build cap (no user systemd bus for a builds.slice scope)', err)
            self.assertFalse(calls.exists())  # neither a scope nor a ticket
        self.commit('e.txt', 'five')
        self.assertEqual(self.run_st_test('--check', 'demo', extra_env=env)[0], 0)
        self.assertFalse(calls.exists())  # a check that builds nothing is not wrapped

    def test_fractal_web_is_not_relevant_when_no_web_input_changed_by_the_base_s_own_rules(self):
        (self.work / 'scripts').mkdir(exist_ok=True)
        shutil.copy(ROOT / 'scripts/ci-fractal-web-changes', self.work / 'scripts/ci-fractal-web-changes')
        git(self.work, 'checkout', '-q', 'main')
        git(self.work, 'add', '.')
        git(self.work, 'commit', '-q', '-m', 'the base decides web relevance')
        git(self.work, 'push', '-q', 'origin', 'main')
        git(self.work, 'checkout', '-q', 'feature')
        git(self.work, 'merge', '-q', 'main')
        self.commit('crates.txt', 'a change no web lane reads')
        st_test.LOCAL['fractal-web'] = ['sh', '-c', 'echo web']
        code, out, err = self.run_st_test('--check', 'fractal-web', '--status')
        self.assertEqual(code, 0, out + err)
        self.assertRegex(out, r'fractal-web +not relevant +no web input changed since [0-9a-f]{12}: CI does not run the lane')
        code, out, err = self.run_st_test('--check', 'fractal-web')
        self.assertEqual(code, 0, out + err)  # nothing to run or sign: not a failure
        self.assertRegex(out, r'fractal-web +not relevant +0s ')
        self.assertEqual(self.statements(), [])
        (self.work / 'apps/fractal-web').mkdir(parents=True)
        self.commit('apps/fractal-web/page.ts', 'export const page = 1\n')
        code, out, err = self.run_st_test('--check', 'fractal-web', '--status')
        self.assertEqual(code, 3, out + err)  # a web change: the lane runs, and nothing covers it yet
        self.assertRegex(out, r'fractal-web +not covered ')

    def test_the_web_inputs_a_local_run_records_pass_the_committed_policy_s_value_rules(self):
        loader = importlib.machinery.SourceFileLoader('evidence_verify_for_web', str(ROOT / 'scripts/evidence-verify'))
        verify = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
        loader.exec_module(verify)
        rules = verify.policy_rules((ROOT / '.st/evidence-skip-policy.json').read_text(), 'fractal-web', 'org/repo')
        wrapper = rules['kinds']['wrapper']
        for detected in ('true', 'false'):  # covers a run whatever its own change detection said about the kit
            verify.value_checks(wrapper, st_test.WEB_INPUTS, {'kit_inputs': detected}, None)
        host = wrapper['by_level']['host']
        self.assertEqual(list(host['command']), LOCAL['fractal-web'])
        standard = {'flake_lock_sha256', 'toolchain_sha256', 'wrapper_sha256', 'system', 'attempt'}  # evidence-wrap's own
        self.assertEqual(set(host['required_inputs']), standard | set(st_test.WEB_INPUTS))

    def test_every_check_of_the_per_pr_suite_runs_by_default_and_all_means_the_same(self):
        # No subset for signing: with no flag st-test runs the whole per-PR suite; --all is an accepted alias; --check selects.
        # The VM tests and the mail redelivery canaries run daily, not here.
        suite = ['typescript-client', 'genie-freshness', 'linux-gate', 'fractal-web']
        for args, names in (([], suite), (['--all'], suite), (['--check', 'linux-gate'], ['linux-gate'])):
            done = subprocess.run([sys.executable, str(ROOT / 'scripts/st-test'), '--list', *args], capture_output=True, text=True)
            self.assertEqual(done.returncode, 0, done.stderr)
            self.assertEqual([line.split(':')[0] for line in done.stdout.splitlines()], names, args)



FAKE_RUN = """import os, sys
from xml.sax.saxutils import quoteattr
open(os.environ['FAKE_CALLS'], 'a').write(os.environ['CI_TEST_PACKAGES'] + '\\n')
code = int(os.environ.get('FAKE_EXIT', '0'))
if os.environ.get('FAKE_NO_REPORT') != '1':
    out = ['<testsuites name="nextest-run">']
    for package in os.environ['CI_TEST_PACKAGES'].split(','):
        if package == os.environ.get('FAKE_EMPTY'):
            continue  # the selection matched no test of this crate
        out.append('<testsuite name=%s>' % quoteattr(package))
        out.append('<testcase name="unit_one" classname=%s></testcase>' % quoteattr(package))
        failing = package == os.environ.get('FAKE_FAIL')
        out.append('<testcase name="unit_two" classname=%s>%s</testcase>' % (quoteattr(package), '<failure message="x"/>' if failing else ''))
        out.append('</testsuite>')
        if failing:
            code = 100
    out.append('</testsuites>')
    open(os.environ['CI_TEST_JUNIT'], 'w').write('\\n'.join(out))
sys.exit(code)
"""


class PerCrate(StTest):
    """scripts/st-test --check rust-tests: one signature per crate, and only the crates without a passing note for their key run."""

    def setUp(self):
        super().setUp()
        self.calls = Path(self.tmp.name) / 'fake-calls'
        fake = Path(self.tmp.name) / 'fake-run.py'
        fake.write_text(FAKE_RUN)
        st_test.LOCAL['rust-tests'] = ['python3', 'scripts/ci-rust-test-result']  # StTest's patcher restores the table
        patcher = mock.patch.object(st_test, 'RUN_TESTS', [sys.executable, str(fake)])
        patcher.start()
        self.addCleanup(patcher.stop)
        git(self.work, 'checkout', '-q', 'main')
        (self.work / 'Cargo.toml').write_text('[workspace]\nmembers = ["crates/base", "crates/top"]\n')
        (self.work / 'Cargo.lock').write_text('lock\n')
        for name, deps in (('base', ''), ('top', '[dependencies]\nbase = { path = "../base" }\n')):
            (self.work / f'crates/{name}/src').mkdir(parents=True)
            (self.work / f'crates/{name}/Cargo.toml').write_text(f'[package]\nname = "{name}"\nversion = "0.1.0"\n{deps}')
            (self.work / f'crates/{name}/src/lib.rs').write_text(f'// {name}\n')
        (self.work / '.st/rust-test-inputs.json').write_text(json.dumps({'global': ['Cargo.toml', 'Cargo.lock'],
                                                                         'crates': {'base': {'extra': []}, 'top': {'extra': []}}}))
        for script in ('rust-test-keys', 'ci-rust-test-result'):
            shutil.copy(ROOT / 'scripts' / script, self.work / 'scripts' / script)
        # The real rust-tests policy entry and a lane for it: the verifier then judges every note by the repository's rules.
        policy = json.loads(json.dumps(POLICY))
        policy['checks']['rust-tests'] = json.loads((ROOT / '.st/evidence-skip-policy.json').read_text())['checks']['rust-tests']
        (self.work / '.st/evidence-skip-policy.json').write_text(json.dumps(policy))
        (self.work / '.st/required-lanes.json').write_text(json.dumps({'version': 1, 'lanes': {'rust-tests': {
            'argv': ['python3', 'scripts/ci-rust-test-result'], 'definition_paths': ['.st', 'scripts'], 'tree_inputs': ['.']}}}))
        git(self.work, 'add', '.')
        git(self.work, 'commit', '-q', '-m', 'workspace')
        git(self.work, 'push', '-q', 'origin', 'main')
        git(self.work, 'checkout', '-q', 'feature')
        git(self.work, 'merge', '-q', '--ff-only', 'main')

    def run_crates(self, *args, **env):
        extra = dict({'FAKE_CALLS': str(self.calls), 'ST_EVIDENCE_GOVERN': 'off', 'ST_EVIDENCE_TARGET': 'off'}, **env)
        return self.run_st_test('--check', 'rust-tests', *args, extra_env=extra)

    def ran(self):
        return self.calls.read_text().split() if self.calls.exists() else []

    def crate_records(self):
        return sorted((s['predicate']['observed']['inputs']['crate'], s['predicate']['observed']['checks']['rust-tests']['exit_code'])
                      for s in self.statements() if 'rust-tests' in s['predicate']['observed']['checks'])

    def test_the_first_run_tests_every_crate_once_and_signs_each_separately(self):
        code, out, err = self.run_crates()
        self.assertEqual(code, 0, out + err)
        self.assertEqual(self.ran(), ['base,top'], 'one nextest run for both crates')
        self.assertEqual(self.crate_records(), [('base', 0), ('top', 0)])
        record = next(s for s in self.statements() if s['predicate']['observed']['inputs'].get('crate') == 'top')['predicate']['observed']['inputs']
        self.assertEqual(record['tests_run'], '2')
        self.assertEqual(record['tests_ignored'], '0')
        self.assertEqual(record['filterset'], 'package(=base) or package(=top)')
        self.assertRegex(record['source_inputs'], r'^[0-9a-f]{40}$')
        self.assertRegex(record['test_list_sha256'], r'^[0-9a-f]{64}$')
        self.assertRegex(record['ignored_list_sha256'], r'^[0-9a-f]{64}$')
        self.assertIn('2 of 2 crates run and signed', out)

    def test_an_unchanged_tree_runs_nothing_and_a_change_runs_the_crate_and_its_dependents_only(self):
        self.run_crates()
        code, out, err = self.run_crates()
        self.assertEqual(code, 0, out + err)
        self.assertEqual(self.ran(), ['base,top'], 'nothing ran the second time')
        self.assertIn('all 2 crates already have a passing note', out)
        self.commit('crates/top/src/lib.rs', '// changed\n')
        code, out, err = self.run_crates()
        self.assertEqual(code, 0, out + err)
        self.assertEqual(self.ran(), ['base,top', 'top'], 'base is below top: its key did not move')
        self.commit('crates/base/src/lib.rs', '// changed\n')
        self.run_crates()
        self.assertEqual(self.ran()[-1], 'base,top')

    def test_a_change_outside_every_crate_runs_nothing(self):
        self.run_crates()
        self.commit('notes.md', 'x')
        code, out, err = self.run_crates()
        self.assertEqual(code, 0, out + err)
        self.assertEqual(self.ran(), ['base,top'])

    def test_a_note_signed_on_another_tree_with_the_same_key_covers_this_one(self):
        self.run_crates()
        self.commit('notes.md', 'x')
        code, out, err = self.run_st_test('--status', '--check', 'rust-tests')
        self.assertEqual(code, 0, out + err)
        self.assertIn('2 of 2 crates covered', out)

    def test_a_failing_crate_is_recorded_as_a_failure_and_does_not_cover_itself_while_the_other_is_signed(self):
        code, out, err = self.run_crates(FAKE_FAIL='top')
        self.assertEqual(code, 1, out + err)
        self.assertEqual(self.crate_records(), [('base', 0), ('top', 1)])
        code, out, err = self.run_st_test('--status', '--check', 'rust-tests')
        self.assertEqual(code, 3, out + err)
        self.assertIn('to run: top', out)

    def test_a_run_that_did_not_complete_signs_nothing(self):
        code, out, err = self.run_crates(FAKE_EXIT='101', FAKE_NO_REPORT='1')
        self.assertEqual(code, 1, out + err)
        self.assertEqual(self.crate_records(), [])
        self.assertIn('no crate was signed', out)

    def test_crate_narrows_the_run_to_the_named_crates_and_refuses_a_name_that_is_not_one(self):
        code, out, err = self.run_crates('--crate', 'base')
        self.assertEqual(code, 0, out + err)
        self.assertEqual(self.ran(), ['base'])
        self.assertEqual(self.crate_records(), [('base', 0)])
        code, out, err = self.run_crates('--crate', 'nope')
        self.assertEqual(code, 1, out + err)
        self.assertIn('not a workspace crate of this tree: nope', out)

    def test_the_filterset_input_stays_within_what_the_signer_takes_and_still_pins_the_crate_list(self):
        small = st_test.filterset_input(['base', 'top'])
        self.assertEqual(small, 'package(=base) or package(=top)')
        crates = [f'fractal-crate-number-{n}' for n in range(52)]
        big = st_test.filterset_input(crates)
        self.assertLessEqual(len(big), 500)
        self.assertRegex(big, r'^52 packages sha256:[0-9a-f]{64}$')
        self.assertNotEqual(big, st_test.filterset_input(crates[:-1] + ['other']))
        self.assertEqual(big, st_test.filterset_input(list(crates)))

    def test_signing_jobs_come_from_the_environment_and_a_bad_value_is_the_default(self):
        for value, expected in (('3', 3), ('0', 1), ('-2', 1), ('x', 8), ('', 8)):
            with mock.patch.dict(st_test.POOL_SETTINGS, {'ST_TEST_SIGN_JOBS': value}):
                self.assertEqual(st_test.sign_jobs(), expected, value)
        with mock.patch.dict(st_test.POOL_SETTINGS, clear=True):
            self.assertEqual(st_test.sign_jobs(), 8)

    def test_the_shared_toolchain_digest_is_none_when_it_cannot_be_named_so_each_wrap_reports_for_itself(self):
        self.assertIsNone(st_test.shared_toolchain('/nonexistent/evidence-wrap'))

    def test_every_crate_is_signed_when_the_signatures_run_side_by_side(self):
        for jobs in ('1', '8'):
            git(self.work, 'checkout', '-q', '-B', f'jobs{jobs}', 'main')
            code, out, err = self.run_crates(ST_TEST_SIGN_JOBS=jobs)
            self.assertEqual(code, 0, out + err)
            self.assertEqual(self.crate_records(), [('base', 0), ('top', 0)], jobs)
            git(self.work, 'checkout', '-q', 'feature')
            for ref in git(self.work, 'for-each-ref', '--format=%(refname)', 'refs/notes/evidence', 'refs/tags/evidence', 'refs/notes/evidence-input').split():
                git(self.work, 'update-ref', '-d', ref)

    def test_the_records_of_a_run_are_pushed_together_with_their_input_index_refs(self):
        origin = Path(self.tmp.name) / 'origin.git'
        def remote_refs():
            return subprocess.run(['git', '-C', str(origin), 'for-each-ref', '--format=%(refname)', 'refs/tags/evidence/', 'refs/notes/evidence', 'refs/notes/evidence-input/'],
                                  capture_output=True, text=True, check=True).stdout.split()
        before = len(remote_refs())
        code, out, err = self.run_crates('--push', 'origin')
        self.assertEqual(code, 0, out + err)
        refs = remote_refs()[:]
        self.assertEqual(len(refs) - before, 8, 'four refs for each of the two records: tag, note and both input index refs')
        self.assertEqual(sum('evidence/input/rust-tests/' in ref for ref in refs), 2)
        self.assertEqual(sum('evidence-input/rust-tests/' in ref for ref in refs), 2)

    def test_a_push_that_fails_is_a_failed_row_not_a_silent_success(self):
        git(self.work, 'remote', 'set-url', '--push', 'origin', '/nonexistent/origin.git')
        code, out, err = self.run_crates('--push', 'origin')
        self.assertEqual(code, 1, out + err)
        self.assertIn('rust-tests:push', out)
        self.assertIn('push of 8 refs failed', out)

    def members(self, *extra):
        verifier = ROOT / 'scripts/evidence-verify'
        # The gate copies the accepted base's verifier and scripts/rust-test-keys side by side; so does this.
        side = Path(self.tmp.name) / 'side'
        side.mkdir(exist_ok=True)
        for name in ('evidence-verify', 'rust-test-keys'):
            shutil.copy(ROOT / 'scripts' / name, side / name)
        keys = Path(self.tmp.name) / 'keys'
        keys.write_text(git(self.work, 'show', 'origin/main:.st/evidence-keys') + '\n')
        done = subprocess.run([sys.executable, str(side / 'evidence-verify'), '--repo', str(self.work), '--revision', 'HEAD', '--check', 'rust-tests',
                               '--members', '--policy-from', 'origin/main', '--repository', 'org/repo', '--keys', str(keys), *extra],
                              capture_output=True, text=True, env=GIT_ENV)
        return done.returncode, json.loads(done.stdout)

    def gate(self, event='merge_group'):
        """scripts/ci-evidence-gate for rust-tests as a CI job runs it: a depth-1 clone of the feature head, the base's own verifier
        and scripts/rust-test-keys, the notes on the remote."""
        tmp = Path(self.tmp.name)
        git(self.work, 'push', '-q', '--force', 'origin', 'feature')
        clone = tmp / 'gate-clone'
        shutil.rmtree(clone, ignore_errors=True)
        subprocess.run(['git', 'clone', '-q', '--depth=1', '--branch', 'feature', f'file://{tmp / "origin.git"}', str(clone)],
                       check=True, capture_output=True, env=GIT_ENV)
        (tmp / 'gate-output').write_text('')
        (tmp / 'gate-summary').write_text('')
        env = dict(GIT_ENV, CHECK='rust-tests', REPOSITORY='org/repo', HEAD_REPOSITORY='org/repo', EVENT_NAME=event, PR_NUMBER='',
                   BASE_SHA=git(self.work, 'rev-parse', 'origin/main').strip(), HEAD_SHA=git(self.work, 'rev-parse', 'feature').strip(),
                   RUN_ID='42', RUN_ATTEMPT='1', GITHUB_OUTPUT=str(tmp / 'gate-output'), GITHUB_STEP_SUMMARY=str(tmp / 'gate-summary'))
        done = subprocess.run([sys.executable, str(ROOT / 'scripts/ci-evidence-gate')], cwd=clone, env=env, capture_output=True, text=True)
        lines = [line for line in done.stdout.splitlines() if line.startswith('evidence-decision v1 ')]
        self.assertEqual(len(lines), 1, done.stdout + done.stderr)
        return dict(part.split('=', 1) for part in lines[0].split(' ')[2:])

    def test_the_gate_asks_whether_every_member_has_a_note_for_its_own_key(self):
        fields = self.gate()
        self.assertEqual((fields['outcome'], fields['reason'], fields['members'], fields['missing']), ('rejected', 'crate_uncovered', '2', '2'), fields)
        self.assertEqual(self.run_crates('--push', 'origin')[0], 0)
        fields = self.gate()
        # Satisfied, in shadow: the committed rust-tests entry does not enforce, so the decision is still run.
        self.assertEqual((fields['outcome'], fields['members'], fields['missing'], fields['decision']), ('satisfied', '2', '-', 'run'), fields)
        self.assertIn(fields['members_fetch'], ('ok', 'none'))
        self.commit('crates/top/src/lib.rs', '// changed\n')
        fields = self.gate()
        self.assertEqual((fields['outcome'], fields['reason'], fields['missing']), ('rejected', 'crate_uncovered', '1'), fields)

    def test_the_verifier_is_satisfied_only_when_every_member_has_a_note_for_its_own_key(self):
        code, result = self.members()
        self.assertEqual((code, result['reason']), (1, 'crate_uncovered'), result)
        self.assertEqual(sorted(result['missing']), ['base', 'top'])
        self.run_crates()
        code, result = self.members()
        self.assertEqual(code, 0, result)
        self.assertEqual((result['satisfied'], result['members'], sorted(result['crates'])), (True, 2, ['base', 'top']))
        self.assertEqual(result['trust_level'], 'host')
        self.assertTrue(result['enforce'] is False and result['policy'] is True)
        self.commit('crates/top/src/lib.rs', '// changed\n')
        code, result = self.members()
        self.assertEqual((code, sorted(result['missing'])), (1, ['top']), 'base is below top and keeps its note')
        self.run_crates()
        self.assertEqual(self.members()[0], 0)

    def on_main(self, message, change):
        git(self.work, 'checkout', '-q', 'main')
        change()
        git(self.work, 'commit', '-qam', message)
        git(self.work, 'push', '-q', 'origin', 'main')
        git(self.work, 'checkout', '-q', 'feature')

    def test_the_ran_no_test_note_names_only_the_crates_the_base_does_not_list(self):
        inputs = json.loads((self.work / '.st/rust-test-inputs.json').read_text())
        self.on_main('list base as having no test', lambda: (self.work / '.st/rust-test-inputs.json').write_text(json.dumps(dict(inputs, no_tests=['base']))))
        git(self.work, 'fetch', '-q', 'origin')
        git(self.work, 'merge', '-q', '--ff-only', 'origin/main')
        code, out, err = self.run_crates(FAKE_EMPTY='base')
        self.assertEqual(code, 0, out + err)
        self.assertNotIn('ran no test', out, 'base is listed: nothing to review')
        with contextlib.chdir(self.work):
            self.assertEqual(st_test.listed_no_tests('origin/main'), ['base'])
            self.assertEqual(st_test.listed_no_tests('origin/nope'), [])

    def test_a_note_that_ran_no_test_covers_a_crate_only_when_the_base_lists_it_as_having_none(self):
        code, out, err = self.run_crates(FAKE_EMPTY='base')
        self.assertEqual(code, 0, out + err)
        self.assertIn('1 ran no test (list under no_tests if they have none): base', out)
        code, result = self.members()
        self.assertEqual((code, sorted(result['missing'])), (1, ['base']), 'top ran tests; base ran none')
        # The same judgement on the local skip decision: base is still to run, top is covered.
        code, out, err = self.run_st_test('--status', '--check', 'rust-tests')
        self.assertEqual(code, 3, out + err)
        self.assertIn('to run: base', out)
        # A tree cannot list its own crate: only the accepted base's list counts.
        inputs = json.loads((self.work / '.st/rust-test-inputs.json').read_text())
        self.commit('.st/rust-test-inputs.json', json.dumps(dict(inputs, no_tests=['base'])))
        self.assertEqual(self.members()[0], 1)
        git(self.work, 'reset', '-q', '--hard', 'HEAD~1')
        branch_point = git(self.work, 'rev-parse', 'origin/main').strip()
        self.on_main('list base as having no test', lambda: (self.work / '.st/rust-test-inputs.json').write_text(json.dumps(dict(inputs, no_tests=['base']))))
        git(self.work, 'fetch', '-q', 'origin')
        # The notes were signed at the branch point; the list is a change of the lane's definition on main, so they are judged there.
        code, result = self.members('--lane-base', branch_point)
        self.assertEqual((code, result['satisfied']), (0, True), result)

    def test_a_malformed_no_tests_list_is_an_error_never_an_empty_allowance(self):
        self.run_crates()
        branch_point = git(self.work, 'rev-parse', 'origin/main').strip()
        inputs = json.loads((self.work / '.st/rust-test-inputs.json').read_text())
        self.on_main('break the list', lambda: (self.work / '.st/rust-test-inputs.json').write_text(json.dumps(dict(inputs, no_tests='base'))))
        git(self.work, 'fetch', '-q', 'origin')
        code, result = self.members('--lane-base', branch_point)
        self.assertEqual((code, result['reason']), (1, 'error'), result)

    def test_a_base_that_judges_rust_tests_without_the_key_tool_is_an_error_never_a_fallback_to_the_trees_own(self):
        self.on_main('drop the tool', lambda: git(self.work, 'rm', '-q', 'scripts/rust-test-keys'))
        git(self.work, 'fetch', '-q', 'origin')
        code, out, err = self.run_crates()
        self.assertEqual(code, 1, out + err)
        self.assertIn('only the base\'s tool and inputs may key a note', out)
        self.assertEqual(self.crate_records(), [])
        self.assertEqual(self.ran(), [], 'nothing was tested or signed')

    def test_a_failed_crate_note_keeps_the_members_check_unsatisfied(self):
        self.run_crates(FAKE_FAIL='top')
        code, result = self.members()
        self.assertEqual((code, result['missing']), (1, {'top': 'check_failed'}))

    def test_members_project_prints_every_crates_key_for_the_gate_to_fetch(self):
        code, result = self.members('--project')
        self.assertEqual(code, 0)
        self.assertEqual((sorted(result['crates']), result['members']), (['base', 'top'], 2))
        for crate in result['crates'].values():
            self.assertEqual(len(crate['key']), 40)
            self.assertEqual(crate['refspecs'][1], f"+refs/notes/evidence-input/rust-tests/{crate['key']}/*:refs/notes/evidence-input/rust-tests/{crate['key']}/*")

    def test_a_tree_without_a_manifest_the_verifier_can_read_is_an_error_never_a_pass(self):
        git(self.work, 'rm', '-q', 'crates/top/Cargo.toml')
        git(self.work, 'commit', '-q', '-m', 'break')
        code, result = self.members()
        self.assertEqual((code, result['reason']), (1, 'error'), result)
        git(self.work, 'rm', '-q', '-r', 'crates', 'Cargo.toml')
        git(self.work, 'commit', '-q', '-m', 'no workspace')
        code, result = self.members()
        self.assertEqual((code, result['reason']), (1, 'error'), result)

    def test_status_names_the_crates_to_run(self):
        code, out, err = self.run_st_test('--status', '--check', 'rust-tests')
        self.assertEqual(code, 3, out + err)
        self.assertIn('2 crates to run', out)
        self.assertIn('to run: base, top', out)

    def test_rust_tests_is_named_with_check_and_is_not_part_of_all_yet(self):
        self.assertIn('rust-tests', st_test.OPT_IN)
        self.assertIn('rust-tests', st_test.BUILDS)
        code, out, err = self.run_st_test('--list', '--all')
        self.assertNotIn('rust-tests', out)
        code, out, err = self.run_st_test('--list', '--check', 'rust-tests')
        self.assertIn('rust-tests: python3 scripts/ci-rust-test-result', out)


# PerCrate reuses StTest's repository, signer and helpers, not its tests.
for _name in [name for name in dir(StTest) if name.startswith('test_') and name not in PerCrate.__dict__]:
    setattr(PerCrate, _name, None)

if __name__ == '__main__':
    unittest.main()
