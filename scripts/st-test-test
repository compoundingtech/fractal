#!/usr/bin/env python3
"""scripts/st-test against real repositories: the tree it signs (the head), the lag, failures, refusals."""
import contextlib
import hashlib
import importlib.machinery
import importlib.util
import io
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import unittest
from unittest import mock

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
from evidence_test_support import tool_path  # noqa: E402

ROOT = Path(__file__).resolve().parent.parent
loader = importlib.machinery.SourceFileLoader('st_test', str(ROOT / 'scripts/st-test'))
spec = importlib.util.spec_from_loader(loader.name, loader)
st_test = importlib.util.module_from_spec(spec)
loader.exec_module(st_test)

DATE = '2026-10-14T12:00:00Z'
GIT_ENV = dict({k: v for k, v in os.environ.items() if k not in ('GITHUB_ACTIONS', 'CI')}, GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_SYSTEM='/dev/null', LC_ALL='C',
               GIT_AUTHOR_NAME='t', GIT_AUTHOR_EMAIL='t@example.invalid', GIT_COMMITTER_NAME='t',
               GIT_COMMITTER_EMAIL='t@example.invalid', GIT_AUTHOR_DATE=DATE, GIT_COMMITTER_DATE=DATE)
POLICY = {'version': 1, 'checks': {'demo': {'trust_levels': ['host'], 'kinds': {'wrapper': {
    'command': ['sh', '-c', 'echo ran'],
    'required_inputs': ['flake_lock_sha256', 'toolchain_sha256', 'wrapper_sha256', 'system', 'attempt'],
    'bind_inputs': {'flake_lock_sha256': 'flake.lock'}}}}}}


def git(repo, *args, stdin=None):
    done = subprocess.run(['git', '-C', str(repo), *args], input=stdin, capture_output=True, env=GIT_ENV)
    assert done.returncode == 0, (args, done.stderr.decode())
    return done.stdout.decode().strip()


class StTest(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        tmp = Path(self.tmp.name)
        key = tmp / 'key'
        subprocess.run(['ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-C', 'host/box-1', '-f', str(key)], check=True)
        pub = key.with_suffix('.pub').read_text().split()
        self.home = tmp / 'home'
        (self.home / '.config/st').mkdir(parents=True)
        (self.home / '.config/st/evidence-sign.json').write_text(json.dumps(
            {'signer': 'host/box-1', 'ssh_key': str(key), 'scratch_repo': str(tmp / 'scratch.git'),
             'test_clock': True, 'path': tool_path()}))
        git(tmp, 'init', '-q', '--bare', '-b', 'main', str(tmp / 'origin.git'))
        self.work = tmp / 'work'
        git(tmp, 'clone', '-q', str(tmp / 'origin.git'), str(self.work))
        git(self.work, 'checkout', '-q', '-b', 'main')
        (self.work / 'scripts').mkdir()
        for name in st_test.BASE_SCRIPTS:
            shutil.copy(ROOT / 'scripts' / name, self.work / 'scripts' / name)
        (self.work / '.st').mkdir()
        (self.work / '.st/evidence-keys').write_text(f'host/box-1 namespaces="git" {pub[0]} {pub[1]}\n')
        (self.work / '.st/evidence-skip-policy.json').write_text(json.dumps(POLICY))
        (self.work / 'flake.lock').write_text('{"nodes":{}}\n')
        (self.work / 'a.txt').write_text('one\n')
        git(self.work, 'add', '.')
        git(self.work, 'commit', '-q', '-m', 'base')
        git(self.work, 'push', '-q', 'origin', 'main')
        git(self.work, 'checkout', '-q', '-b', 'feature')
        patcher = mock.patch.dict(st_test.LOCAL, {'demo': ['sh', '-c', 'echo ran']}, clear=True)
        patcher.start()
        self.addCleanup(patcher.stop)

    def commit(self, name, content, branch=None):
        if branch:
            git(self.work, 'checkout', '-q', branch)
        (self.work / name).write_text(content)
        git(self.work, 'add', '.')
        git(self.work, 'commit', '-q', '-m', f'{name} {content}')

    def run_st_test(self, *args, command=None, extra_env=None):
        if command is not None:
            st_test.LOCAL['demo'] = command
        out, err = io.StringIO(), io.StringIO()
        env = dict(GIT_ENV, HOME=str(self.home), EVIDENCE_SIGN_NOW=DATE, **(extra_env or {}))
        cwd = os.getcwd()
        os.chdir(self.work)
        try:
            with mock.patch.dict(os.environ, env, clear=True), contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
                try:
                    code = st_test.main(['--base', 'origin/main', '--repository', 'org/repo', '--toolchain-sha256', hashlib.sha256(b'drv').hexdigest(), *args])
                except st_test.Failure as error:
                    code = f'failure: {error}'
        finally:
            os.chdir(cwd)
        return code, out.getvalue(), err.getvalue()

    def statements(self):
        found = []
        for ref in git(self.work, 'for-each-ref', '--format=%(refname)', 'refs/notes/evidence/').splitlines():
            blob = git(self.work, 'ls-tree', '-r', ref).split()[2]
            found.append(json.loads(git(self.work, 'cat-file', 'blob', blob)))
        return found

    def nudge_recorder(self, exit_code=0):
        calls = Path(self.tmp.name) / f'nudge-calls-{exit_code}'
        argv = [sys.executable, '-c', f'import sys; open({str(calls)!r}, "a").write(" ".join(sys.argv[1:]) + "\\n"); sys.exit({exit_code})', 'pull-now']
        return calls, json.dumps(argv)

    def test_a_push_asks_this_host_s_evidence_log_to_pull_once_and_a_run_without_push_does_not(self):
        self.commit('b.txt', 'two')
        calls, argv = self.nudge_recorder()
        code, out, err = self.run_st_test('--check', 'demo', extra_env={'ST_EVIDENCE_LOG_NUDGE': argv})
        self.assertEqual(code, 0, err)
        self.assertFalse(calls.exists(), 'nothing was pushed, so the log has nothing new')
        code, out, err = self.run_st_test('--check', 'demo', '--push', 'origin', extra_env={'ST_EVIDENCE_LOG_NUDGE': argv})
        self.assertEqual(code, 0, err)
        self.assertEqual(calls.read_text(), 'pull-now\n')
        self.assertIn("asked this host's log to pull now", out)
        pushed = subprocess.run(['git', '-C', str(Path(self.tmp.name) / 'origin.git'), 'for-each-ref', '--format=%(refname)', 'refs/tags/evidence/'],
                                capture_output=True, text=True).stdout.split()
        self.assertEqual(len(pushed), 1, 'the record reached the remote before the log was asked')

    def test_a_failing_or_malformed_nudge_never_changes_the_result(self):
        self.commit('b.txt', 'two')
        calls, argv = self.nudge_recorder(exit_code=5)
        code, out, err = self.run_st_test('--check', 'demo', '--push', 'origin', extra_env={'ST_EVIDENCE_LOG_NUDGE': argv})
        self.assertEqual(code, 0, err)
        self.assertIn('its timer will', out)
        self.commit('c.txt', 'three')
        code, out, err = self.run_st_test('--check', 'demo', '--push', 'origin', extra_env={'ST_EVIDENCE_LOG_NUDGE': '"systemctl"'})
        self.assertEqual(code, 0, err)
        self.assertIn('not asked', out)

    def test_without_a_configured_command_the_log_is_asked_only_where_its_unit_is_installed(self):
        with mock.patch.dict(os.environ, {'HOME': str(self.home)}, clear=True), mock.patch.object(st_test.shutil, 'which', return_value='/bin/systemctl'):
            self.assertIsNone(st_test.log_nudge_argv())
            unit = self.home / '.config/systemd/user/evidence-log.service'
            unit.parent.mkdir(parents=True)
            unit.write_text('[Service]\n')
            self.assertEqual(st_test.log_nudge_argv(), ['systemctl', '--user', 'start', '--no-block', 'evidence-log.service'])

    def test_a_branch_that_holds_the_base_tip_is_signed_in_place_and_reported_covered(self):
        self.commit('b.txt', 'two')
        code, out, err = self.run_st_test('--check', 'demo')
        self.assertEqual(code, 0, err)
        statement, = self.statements()
        self.assertEqual(statement['subject'][0]['digest']['gitTree'], git(self.work, 'rev-parse', 'HEAD^{tree}'))
        check = statement['predicate']['observed']['checks']['demo']
        self.assertEqual((check['command'], check['exit_code']), (['sh', '-c', 'echo ran'], 0))
        self.assertEqual(statement['predicate']['signer'], 'host/box-1')
        self.assertIn('demo', out)
        self.assertIn('covered by wrapper', out)
        self.assertIn('(HEAD)', out)
        self.assertNotIn('behind', out)  # the branch holds the base's tip: nothing to report
        self.assertIn('clean worktree', out)

    def test_a_host_that_preloads_a_library_into_every_process_still_signs(self):
        """hetz2 sets LD_PRELOAD (jemalloc) for every process; the signer refuses it, so the launcher must not pass it on."""
        self.commit('b.txt', 'two')
        empty = Path(self.tmp.name) / 'empty'
        empty.mkdir()
        hostile = {'LD_PRELOAD': '/nonexistent/libpreload.so', 'LD_AUDIT': '/nonexistent/libaudit.so', 'LD_LIBRARY_PATH': str(empty),
                   'GLIBC_TUNABLES': 'glibc.malloc.check=3', 'PYTHONPATH': str(empty), 'PYTHONSTARTUP': '/nonexistent/startup.py'}
        code, out, err = self.run_st_test('--check', 'demo', extra_env=hostile)
        self.assertEqual(code, 0, err + out)
        statement, = self.statements()
        self.assertEqual((statement['predicate']['signer'], statement['predicate']['tier']), ('host/box-1', 'full'))
        self.assertIn('covered by wrapper', out)

    def lane_file(self, definition=('scripts/lane.sh',)):
        lanes = {'version': 1, 'lanes': {'demo': {'argv': ['sh', '-c', 'echo ran'], 'definition_paths': list(definition)}}}
        (self.work / 'scripts/lane.sh').write_text('lane\n')
        (self.work / '.st/required-lanes.json').write_text(json.dumps(lanes))
        git(self.work, 'add', '.')
        git(self.work, 'commit', '-q', '-m', 'lane file')
        git(self.work, 'push', '-q', 'origin', 'HEAD:main')
        git(self.work, 'fetch', '-q', 'origin')

    def test_a_lane_defined_at_the_base_puts_its_definition_digest_in_the_note(self):
        self.lane_file()
        self.commit('b.txt', 'two')  # the change touches no definition path
        code, out, err = self.run_st_test('--check', 'demo')
        self.assertEqual(code, 0, err)
        statement, = self.statements()
        digest = statement['predicate']['observed']['inputs']['lane_definition_sha256']
        verifier = importlib.machinery.SourceFileLoader('ev', str(ROOT / 'scripts/evidence-verify')).load_module()
        rules = verifier.lane_rules(git(self.work, 'show', 'origin/main:.st/required-lanes.json'), 'demo')
        base_tree = git(self.work, 'rev-parse', 'origin/main^{tree}')
        self.assertEqual(digest, verifier.lane_definition(str(self.work), base_tree, git(self.work, 'rev-parse', 'HEAD^{tree}'), rules)['sha256'])

    def test_a_tree_that_edits_its_own_lane_is_not_signed(self):
        self.lane_file()
        self.commit('scripts/lane.sh', 'lane, but fewer tests\n')
        code, out, err = self.run_st_test('--check', 'demo')
        # Not a failure: nothing failed, the check is not signed and CI runs it (exit 4).
        self.assertEqual(code, 4, err)
        self.assertEqual(self.statements(), [])
        self.assertRegex(out, r'demo +not signed +0s +this tree edits its lane \(scripts/lane\.sh\); CI runs it')
        self.assertNotIn('FAILED', out)

    def test_without_a_lane_file_at_the_base_the_note_carries_no_digest_as_before(self):
        self.commit('b.txt', 'two')
        code, out, err = self.run_st_test('--check', 'demo')
        self.assertEqual(code, 0, err)
        statement, = self.statements()
        self.assertNotIn('lane_definition_sha256', statement['predicate']['observed']['inputs'])

    def test_untracked_and_ignored_files_in_the_checkout_cannot_change_the_result(self):
        self.commit('b.txt', 'two')
        (self.work / 'stray.txt').write_text('untracked')
        (self.work / '.gitignore').write_text('ignored.txt\n')
        git(self.work, 'add', '.gitignore')
        git(self.work, 'commit', '-q', '-m', 'ignore')
        (self.work / 'ignored.txt').write_text('ignored')
        code, out, err = self.run_st_test('--check', 'demo', command=['sh', '-c', 'test ! -e stray.txt && test ! -e ignored.txt'])
        self.assertEqual(code, 0, err + out)
        self.assertEqual(len(self.statements()), 1)

    def test_after_the_base_moved_the_heads_own_tree_is_what_is_signed_and_the_lag_is_reported(self):
        self.commit('b.txt', 'feature work')
        self.commit('c.txt', 'main moved', branch='main')
        git(self.work, 'push', '-q', 'origin', 'main')
        git(self.work, 'checkout', '-q', 'feature')
        code, out, err = self.run_st_test('--check', 'demo')
        self.assertEqual(code, 0, err)
        statement, = self.statements()
        self.assertEqual(statement['subject'][0]['digest']['gitTree'], git(self.work, 'rev-parse', 'HEAD^{tree}'))
        self.assertEqual(statement['subject'][0]['name'], git(self.work, 'rev-parse', 'HEAD'))
        self.assertIn('1 commit(s) behind origin/main', out)
        self.assertIn('covered by wrapper', out)
        self.assertNotIn('st-test-', git(self.work, 'worktree', 'list'))  # the throwaway worktree is gone
        self.assertEqual(git(self.work, 'rev-parse', 'HEAD^{tree}'), git(self.work, 'rev-parse', 'feature^{tree}'))

    def test_a_failing_run_is_recorded_and_the_exit_code_says_so(self):
        self.commit('b.txt', 'two')
        code, out, err = self.run_st_test('--check', 'demo', command=['sh', '-c', 'echo broken; exit 3'])
        self.assertEqual(code, 1)
        statement, = self.statements()
        self.assertEqual(statement['predicate']['observed']['checks']['demo']['exit_code'], 3)
        self.assertIn('FAILED (3)', out)
        self.assertNotIn('covered by', out)

    def test_a_tree_with_a_megarepo_lock_gets_its_members_before_its_checks_run(self):
        self.commit('.gitignore', '/repos/\n')
        self.commit('megarepo.lock', '{"version":1,"members":{}}\n')
        fill = ['sh', '-c', 'mkdir -p repos/effect-utils && touch repos/effect-utils/external.ts']
        with mock.patch.object(st_test, 'members_command', lambda directory: fill):
            code, out, err = self.run_st_test('--check', 'demo', command=['sh', '-c', 'test -e repos/effect-utils/external.ts'])
        self.assertEqual(code, 0, out + err)
        statement, = self.statements()
        self.assertEqual(statement['predicate']['observed']['checks']['demo']['exit_code'], 0)
        self.assertFalse((self.work / 'repos').exists())  # into the throwaway worktree, not this checkout

    def test_members_that_cannot_be_materialized_run_no_check_and_sign_nothing(self):
        self.commit('megarepo.lock', '{"version":1,"members":{}}\n')
        with mock.patch.object(st_test, 'members_command', lambda directory: ['sh', '-c', 'echo no network >&2; exit 7']):
            code, out, err = self.run_st_test('--check', 'demo')
        self.assertEqual(code, 1)
        self.assertEqual(self.statements(), [])
        self.assertIn('NOT RUN', out)
        self.assertIn('materializing the megarepo members failed (7)', out)
        self.assertIn('no network', err)

    def test_a_tree_without_a_megarepo_lock_materializes_nothing(self):
        self.commit('b.txt', 'two')
        with mock.patch.object(st_test, 'members_command', side_effect=AssertionError('called')):
            code, out, err = self.run_st_test('--check', 'demo')
        self.assertEqual(code, 0, out + err)

    def test_the_members_command_is_the_one_ci_runs_before_the_lanes(self):
        directory = Path(self.tmp.name) / 'pin'
        directory.mkdir()
        rev = 'a' * 40
        (directory / 'flake.lock').write_text(json.dumps({'nodes': {'effect-utils': {'locked': {'rev': rev}}}}))
        command = st_test.members_command(directory)
        step = (ROOT / '.github/workflows/workspace-ci.ts').read_text().split('export const megarepoApplyStep', 1)[1].split('} as const', 1)[0]
        ci = step.replace('$(jq -r \'.nodes["effect-utils"].locked.rev\' flake.lock)', rev)
        self.assertIn(f'nix run "{command[2]}" {" ".join(command[3:])}', ci)
        (directory / 'flake.lock').write_text(json.dumps({'nodes': {'effect-utils': {'locked': {'rev': 'main; rm -rf /'}}}}))
        with self.assertRaises(ValueError):
            st_test.members_command(directory)

    def test_a_time_limit_is_a_failure_not_a_hang(self):
        self.commit('b.txt', 'two')
        code, out, err = self.run_st_test('--check', 'demo', '--time-limit', '1', command=['sleep', '30'])
        self.assertEqual(code, 1)
        self.assertIn('timed out', out)

    def test_behind_counts_the_bases_commits_the_branch_lacks_and_is_none_when_it_cannot_tell(self):
        self.commit('b.txt', 'feature work')
        cwd = os.getcwd()
        os.chdir(self.work)
        try:
            self.assertEqual(st_test.behind('origin/main'), 0)
            self.commit('c.txt', 'main moved', branch='main')
            git(self.work, 'push', '-q', 'origin', 'main')
            git(self.work, 'checkout', '-q', 'feature')
            self.assertEqual(st_test.behind('origin/main'), 1)
            self.assertIsNone(st_test.behind('no-such-ref'))
        finally:
            os.chdir(cwd)

    def test_nothing_about_lag_is_printed_when_it_cannot_be_counted(self):
        self.commit('b.txt', 'two')
        with mock.patch.object(st_test, 'behind', return_value=None):
            code, out, err = self.run_st_test('--check', 'demo')
        self.assertEqual(code, 0, err)
        self.assertNotIn('behind', out)
        self.assertIn('(HEAD)', out)

    def test_a_branch_that_conflicts_with_the_base_is_signed_as_it_is(self):
        self.commit('a.txt', 'feature edit\n')
        self.commit('a.txt', 'main edit\n', branch='main')
        git(self.work, 'push', '-q', 'origin', 'main')
        git(self.work, 'checkout', '-q', 'feature')
        code, out, err = self.run_st_test('--check', 'demo')
        self.assertEqual(code, 0, err)
        self.assertEqual(len(self.statements()), 1)
        self.assertIn('behind origin/main', out)

    def test_status_runs_nothing_and_says_whether_the_head_tree_is_covered(self):
        self.commit('b.txt', 'two')
        code, out, err = self.run_st_test('--check', 'demo', '--status')
        self.assertEqual((code, self.statements()), (3, []))
        self.assertIn('not covered', out)
        self.assertEqual(self.run_st_test('--check', 'demo')[0], 0)
        code, out, err = self.run_st_test('--check', 'demo', '--status')
        self.assertEqual(code, 0, out + err)
        self.assertIn('covered by wrapper', out)
        # The base moving does not change the head's own tree, so the note still covers it; a new commit does not.
        self.commit('c.txt', 'main moved', branch='main')
        git(self.work, 'push', '-q', 'origin', 'main')
        git(self.work, 'checkout', '-q', 'feature')
        self.assertEqual(self.run_st_test('--check', 'demo', '--status')[0], 0)
        self.commit('d.txt', 'another change')
        self.assertEqual(self.run_st_test('--check', 'demo', '--status')[0], 3)

    def test_a_worktree_left_by_a_killed_run_is_removed_by_the_next_run(self):
        self.commit('b.txt', 'two')
        stale = Path(tempfile.mkdtemp(prefix='st-test-'))
        (stale / 'pid').write_text('999999999')
        git(self.work, 'worktree', 'add', '--detach', '-q', str(stale / 'tree'), 'HEAD')
        self.assertEqual(self.run_st_test('--check', 'demo')[0], 0)
        self.assertFalse(stale.exists())
        self.assertNotIn('st-test-', git(self.work, 'worktree', 'list'))

    def test_a_worktree_whose_pid_belongs_to_another_user_is_treated_as_alive(self):
        self.commit('b.txt', 'two')
        other = Path(tempfile.mkdtemp(prefix='st-test-'))
        self.addCleanup(shutil.rmtree, other, ignore_errors=True)
        (other / 'pid').write_text('4242')
        git(self.work, 'worktree', 'add', '--detach', '-q', str(other / 'tree'), 'HEAD')
        real_kill = os.kill

        def kill(pid, sig):
            if pid == 4242:
                raise PermissionError
            return real_kill(pid, sig)
        with mock.patch('os.kill', side_effect=kill):
            self.assertEqual(self.run_st_test('--check', 'demo')[0], 0)
        self.assertTrue((other / 'tree').exists())

    def test_a_worktree_of_a_live_run_is_left_alone(self):
        self.commit('b.txt', 'two')
        live = Path(tempfile.mkdtemp(prefix='st-test-'))
        self.addCleanup(shutil.rmtree, live, ignore_errors=True)
        (live / 'pid').write_text(str(os.getpid()))
        git(self.work, 'worktree', 'add', '--detach', '-q', str(live / 'tree'), 'HEAD')
        self.assertEqual(self.run_st_test('--check', 'demo')[0], 0)
        self.assertTrue((live / 'tree').exists())

    def test_the_command_line_maps_a_refusal_to_exit_2_and_a_failed_check_to_exit_1(self):
        self.commit('b.txt', 'two')
        env = dict(GIT_ENV, HOME=str(self.home))
        done = subprocess.run([sys.executable, str(ROOT / 'scripts/st-test'), '--base', '--bad'], capture_output=True, text=True, cwd=self.work, env=env)
        self.assertEqual(done.returncode, 2)
        done = subprocess.run([sys.executable, str(ROOT / 'scripts/st-test'), '--check', 'genie-freshness', '--base', 'origin/main'],
                              capture_output=True, text=True, cwd=self.work, env=dict(env, PATH='/nonexistent'))
        self.assertEqual(done.returncode, 1, done.stderr)  # the check could not run its command: a failed check, not a refusal

    def test_a_check_cannot_reach_the_callers_repository_through_a_leaked_git_environment(self):
        """st2#3014: git exports GIT_DIR to a hook run from a linked worktree; a check that makes its own repository and uses
        `git -C` would otherwise act on the caller's."""
        self.commit('b.txt', 'two')
        linked = Path(self.tmp.name) / 'linked'
        git(self.work, 'worktree', 'add', '-q', str(linked), '-b', 'linked', 'feature')
        victim_config = (self.work / '.git/config').read_text()
        def own_refs():  # what the run may add is its own record, refs/tags/evidence/<tree>/<record>; nothing else
            return [line for line in git(self.work, 'for-each-ref', '--format=%(refname) %(objectname)', 'refs/heads', 'refs/tags').splitlines()
                    if not line.startswith('refs/tags/evidence/')]
        victim_refs = own_refs()
        script = ('d=$(mktemp -d) && git -C "$d" init -q && git -C "$d" config user.name Evil && git -C "$d" config user.email e@e.invalid '
                  '&& git -C "$d" commit -q --allow-empty -m initial && git -C "$d" checkout -q -b accepted-main && git -C "$d" commit -q --allow-empty -m author')
        leaked = {'GIT_DIR': str(self.work / '.git/worktrees/linked'), 'GIT_WORK_TREE': str(linked), 'GIT_INDEX_FILE': str(self.work / '.git/worktrees/linked/index')}
        code, out, err = self.run_st_test('--check', 'demo', command=['sh', '-c', script], extra_env=leaked)
        self.assertEqual(code, 0, err + out)
        self.assertEqual((self.work / '.git/config').read_text(), victim_config)
        self.assertEqual(own_refs(), victim_refs)
        self.assertNotIn('Evil', (self.work / '.git/config').read_text())
        self.assertEqual(git(self.work, 'branch', '--list', 'accepted-main'), '')

    def test_scrub_git_environment_drops_the_selecting_variables_and_keeps_the_transport_ones(self):
        with mock.patch.dict(os.environ, {'GIT_DIR': '/x', 'GIT_AUTHOR_NAME': 'a', 'GIT_WORK_TREE': '/y', 'GIT_PUSH_OPTION_COUNT': '1',
                                          'GIT_SSH_COMMAND': 'ssh', 'GIT_ASKPASS': 'z', 'GIT_CONFIG_COUNT': '1', 'KEPT': 'yes'}):
            st_test.scrub_git_environment()
            self.assertEqual({k: os.environ[k] for k in ('GIT_SSH_COMMAND', 'GIT_ASKPASS', 'GIT_CONFIG_COUNT', 'KEPT')},
                             {'GIT_SSH_COMMAND': 'ssh', 'GIT_ASKPASS': 'z', 'GIT_CONFIG_COUNT': '1', 'KEPT': 'yes'})
            for name in ('GIT_DIR', 'GIT_AUTHOR_NAME', 'GIT_WORK_TREE', 'GIT_PUSH_OPTION_COUNT'):
                self.assertNotIn(name, os.environ)

    def test_the_checks_do_not_see_the_agent_seats_variables_but_the_hosts_ranking_name_and_the_switches_stay(self):
        self.commit('b.txt', 'two')
        seat = {'ST_MISSION': 'm', 'ST3_ENDPOINT': 'e', 'CLAUDECODE': '1', 'CLAUDE_CONFIG_DIR': '/c', 'ANTHROPIC_API_KEY': 'k',
                'ST_AGENT': 'agent/x', 'ST_AGENT_FOO': 'x', 'ST_SKIP_EVIDENCE': '0', 'ST_EVIDENCE_TIME_LIMIT': '9'}
        out = Path(self.tmp.name) / 'seen'
        code, _, err = self.run_st_test('--check', 'demo', extra_env=seat, command=['sh', '-c', f'env > {out}'])
        self.assertEqual(code, 0, err)
        seen = dict(line.split('=', 1) for line in out.read_text().splitlines() if '=' in line)
        for name in ('ST_MISSION', 'ST3_ENDPOINT', 'CLAUDECODE', 'CLAUDE_CONFIG_DIR', 'ANTHROPIC_API_KEY', 'ST_AGENT_FOO'):
            self.assertNotIn(name, seen)
        for name in ('ST_AGENT', 'ST_SKIP_EVIDENCE', 'ST_EVIDENCE_TIME_LIMIT'):
            self.assertIn(name, seen)

    def test_a_base_that_looks_like_a_git_option_is_refused(self):
        self.commit('b.txt', 'two')
        for bad in ('--upload-pack=x', '-x', 'a b', ''):
            with self.assertRaises(st_test.Failure):
                st_test.main([f'--base={bad}', '--check', 'demo'])
        self.assertEqual(self.statements(), [])

    def test_uncommitted_tracked_changes_and_unknown_checks_are_refused(self):
        self.commit('b.txt', 'two')
        (self.work / 'b.txt').write_text('edited, not committed')
        code, _, _ = self.run_st_test('--check', 'demo')
        self.assertIn('uncommitted changes', str(code))
        git(self.work, 'checkout', '--', 'b.txt')
        code, _, _ = self.run_st_test('--check', 'nope')
        self.assertIn('no local command for nope', str(code))
        self.assertEqual(self.statements(), [])

    def test_the_scripts_that_run_come_from_the_base_not_from_the_branch(self):
        (self.work / 'scripts/evidence-sign').write_text('#!/bin/sh\necho tampered >&2\nexit 9\n')
        git(self.work, 'add', '.')
        git(self.work, 'commit', '-q', '-m', 'tamper with the signer on the branch')
        code, out, err = self.run_st_test('--check', 'demo')
        self.assertEqual(code, 0, err)
        self.assertEqual(len(self.statements()), 1)

    def test_the_real_table_lists_only_checks_with_a_command_and_prints_them(self):
        done = subprocess.run([sys.executable, str(ROOT / 'scripts/st-test'), '--list'], capture_output=True, text=True)
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual([line.split(':')[0] for line in done.stdout.splitlines()], ['typescript-client', 'genie-freshness'])

    def test_a_heavy_check_runs_only_when_named_or_with_all(self):
        # The pre-push hook runs st-test with no --check: a check that builds the whole workspace must not start on every push.
        for args, names in (([], ['typescript-client', 'genie-freshness']),
                            (['--all'], ['typescript-client', 'genie-freshness', 'mail-redelivery-canaries', 'linux-gate']),
                            (['--check', 'mail-redelivery-canaries'], ['mail-redelivery-canaries'])):
            done = subprocess.run([sys.executable, str(ROOT / 'scripts/st-test'), '--list', *args], capture_output=True, text=True)
            self.assertEqual(done.returncode, 0, done.stderr)
            self.assertEqual([line.split(':')[0] for line in done.stdout.splitlines()], names, args)


if __name__ == '__main__':
    unittest.main()
