#!/usr/bin/env python3
"""The always-emitted fractal-web check: pass only for a deliberate skip or a successful run.

Detection must have succeeded. A relevant change requires successful execution, except when
an explicit trusted evidence decision covers a pull request. Queue and manual runs always
require execution. Failure, timeout, cancellation and an unexpected skip fail the gate.
A signed-only pull request (ours) with web changes and no valid signature is refused, not run:
the gate fails with the refusal, which says how to sign it.
"""

import os
import sys


def verdict(changes, relevant, execution, evidence_skip="", event="", refusal=""):
    if changes != "success":
        return f"change detection ended with {changes or 'no result'}"
    if relevant == "true" and refusal and event == "pull_request":
        return refusal
    if relevant == "true":
        if execution == "skipped" and evidence_skip == "true" and event == "pull_request":
            return None
        return None if execution == "success" else f"web inputs changed but execution ended with {execution or 'no result'}"
    if relevant == "false":
        return None if execution == "skipped" else f"no web inputs changed but execution ended with {execution or 'no result'}"
    return f"change detection reported no decision ({relevant!r})"


def main():
    changes, relevant, execution = (os.environ.get(name, "") for name in ("CHANGES_RESULT", "RELEVANT", "EXECUTION_RESULT"))
    print(f"detection: {changes}, relevant: {relevant}, execution: {execution}")
    failure = verdict(changes, relevant, execution, os.environ.get("EVIDENCE_SKIP", ""), os.environ.get("EVENT_NAME", ""),
                      os.environ.get("EVIDENCE_REFUSAL", ""))
    if failure:
        print(f"::error::fractal-web gate failed: {failure}")
        return 1
    print("fractal-web gate passed")
    return 0


if __name__ == "__main__":
    sys.exit(main())
