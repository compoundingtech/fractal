#!/usr/bin/env python3
"""Verify main's exact queue checks and identify evidence-skipped entries needing hosted proof."""

import json
import os
import subprocess
import sys

REQUIRED = {"linux-gate", "genie-freshness", "typescript-client", "fractal-web"}
GATES = {f"evidence-gate-{name}" for name in REQUIRED | {
    "linux-clippy", "linux-fleet-compat", "ci-script-tests", "rust-tests"}}


def api(path):
    return json.loads(subprocess.check_output(
        ["gh", "api", "--paginate", "--slurp", path], text=True, timeout=60
    ))


def evidence_skipped(repo, run, sha):
    """Request proof for an exact-attempt evidence skip or metadata that cannot prove hosted execution."""
    path = f"repos/{repo}/actions/runs/{run['id']}/attempts/{run['run_attempt']}/jobs?per_page=100"
    jobs = [job for page in api(path) for job in page["jobs"]]
    gates = [job for job in jobs if job["name"].startswith("evidence-gate-")]
    if len(gates) != len(GATES) or {job["name"] for job in gates} != GATES or any(job["head_sha"] != sha for job in gates):
        return True  # Incomplete metadata cannot prove hosted execution; request proof.
    markers = [[step for step in job.get("steps", []) if step.get("name") == "evidence skip taken"] for job in gates]
    if any(len(steps) != 1 or steps[0].get("conclusion") is None for steps in markers):
        return True  # Missing or ambiguous markers must never silently suppress proof.
    return any(steps[0]["conclusion"] == "success" for steps in markers)


def main():
    repo, sha = os.environ["GITHUB_REPOSITORY"], os.environ["GITHUB_SHA"]
    pages = api(f"repos/{repo}/actions/workflows/fleet.yml/runs?event=merge_group&head_sha={sha}&per_page=100")
    for run in (r for page in pages for r in page["workflow_runs"]):
        if not (run["head_sha"] == sha and run["event"] == "merge_group"
                and run["path"] == ".github/workflows/fleet.yml"
                and run["head_branch"].startswith("gh-readonly-queue/main/")):
            continue
        # The queue merges when required checks pass; optional jobs may still be running
        # or fail independently. Their aggregate run conclusion is not a required check.
        checks = [check for page in api(f"repos/{repo}/check-suites/{run['check_suite_id']}/check-runs?per_page=100")
                  for check in page["check_runs"]]
        if all(any(c["name"] == name and c["conclusion"] == "success" for c in checks) for name in REQUIRED):
            skipped = evidence_skipped(repo, run, sha)
            output = os.environ.get("GITHUB_OUTPUT")
            if output:
                with open(output, "a") as handle:
                    handle.write(f"evidence-skipped={str(skipped).lower()}\n")
            message = f"Main `{sha}` retains all {len(REQUIRED)} successful merge-queue checks: {run['html_url']}"
            message += ("; post-merge hosted proof required (evidence skip or incomplete queue metadata)" if skipped
                        else "; hosted queue proof retained: no duplicate workspace run")
            print(message)
            with open(os.environ["GITHUB_STEP_SUMMARY"], "a") as summary:
                summary.write(message + "\n")
            return 0
    print(f"::error::main {sha} has no successful Workspace CI merge-group run with all required checks")
    return 1


if __name__ == "__main__":
    sys.exit(main())
