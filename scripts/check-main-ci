#!/usr/bin/env python3
"""Wait for main's exact Workspace CI push attempt to pass the required hosted fast lane."""

import json
import os
import subprocess
import sys
import time

REQUIRED = {"linux-test-build", "linux-clippy", "linux-fleet-compat"}
WAIT_ATTEMPTS = 240
POLL_SECONDS = 30


def api(path):
    return json.loads(subprocess.check_output(
        ["gh", "api", "--paginate", "--slurp", path], text=True, timeout=60
    ))


def main():
    repo, sha = os.environ["GITHUB_REPOSITORY"], os.environ["GITHUB_SHA"]
    for attempt in range(WAIT_ATTEMPTS):
        pages = api(f"repos/{repo}/actions/workflows/fleet.yml/runs?event=push&head_sha={sha}&per_page=100")
        runs = [run for page in pages for run in page["workflow_runs"]
                if run["head_sha"] == sha and run["event"] == "push"
                and run["path"] == ".github/workflows/fleet.yml" and run["head_branch"] == "main"]
        # Reruns supersede earlier attempts; never borrow successful jobs from another attempt.
        run = max(runs, key=lambda item: (item["run_number"], item["run_attempt"]), default=None)
        if run:
            path = f"repos/{repo}/actions/runs/{run['id']}/attempts/{run['run_attempt']}/jobs?per_page=100"
            jobs = [job for page in api(path) for job in page["jobs"]]
            required = [job for job in jobs if job["name"] in REQUIRED]
            valid = (len(required) == len(REQUIRED)
                     and {job["name"] for job in required} == REQUIRED
                     and all(job["head_sha"] == sha for job in required))
            if valid and all(job["conclusion"] == "success" for job in required):
                message = (f"Main `{sha}` passed all {len(REQUIRED)} required hosted push checks: {run['html_url']} "
                           f"(attempt {run['run_attempt']}). Advisory Workspace CI outcomes remain visible in that run.")
                print(message)
                with open(os.environ["GITHUB_STEP_SUMMARY"], "a") as summary:
                    summary.write(message + "\n")
                return 0
            failed = [job["name"] for job in required
                      if job["conclusion"] not in (None, "success")]
            if failed or run["status"] == "completed":
                print(f"::error::main {sha} required hosted push proof failed or is incomplete: "
                      f"{', '.join(failed) or 'missing, duplicate, or wrong-SHA required jobs'}; {run['html_url']}")
                return 1
        if attempt + 1 < WAIT_ATTEMPTS:
            print(f"Waiting for exact main push proof for {sha}", flush=True)
            time.sleep(POLL_SECONDS)
    print(f"::error::timed out waiting for required Workspace CI push checks for main {sha}")
    return 1


if __name__ == "__main__":
    sys.exit(main())
