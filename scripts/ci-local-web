#!/usr/bin/env bash
# The fractal-web lane on this machine, for a note signed here (scripts/st-test, a lane in .st/required-lanes.json). Run inside the
# web dev shell: `nix develop .#web -c bash scripts/ci-local-web`.
#
# It runs what CI's fractal-web-execution job runs (scripts/ci-web-shell-test, then scripts/ci-fractal-web), as ONE shard that covers
# everything: every kit play (KIT_INPUTS=true, KIT_SHARD_COUNT=1, KIT_PLAY_SET=all, a11y on, no per-play time cap) and every app test
# (APP_TEST_SET=all). That is more than a pull request's run (the commit's plays, related tests) and needs no base to compare with;
# the note records exactly these inputs, so the verifier's shard-count and input-order rules apply to it.
#
# As scripts/ci-local does for the Linux gate stages, it runs with a home of its own: HOME and the XDG directories are a scratch
# directory on the account's disk (never /tmp), removed afterwards, with a CI runner's umask (022), no preloaded allocator and no
# st, GitHub or SSH agent variable, so nothing it starts can reach this account's st state or credentials. The pnpm store is kept
# (pnpm_config_store_dir, default ~/.cache/ci-local-pnpm-store), as CI keeps it between runs.
set -euo pipefail
umask 022
scratch_root=${CI_LOCAL_SCRATCH_ROOT:-$HOME/.cache/ci-local}
mkdir -p "$scratch_root"
chmod go-w "$scratch_root"
scratch=$(mktemp -d "$scratch_root/web.XXXXXX")
cleanup() {
  command -v buck2 >/dev/null 2>&1 && buck2 kill >/dev/null 2>&1 || true  # a Buck daemon outlives the run otherwise
  rm -rf "$scratch"
}
trap cleanup EXIT
pnpm_store=${pnpm_config_store_dir:-$HOME/.cache/ci-local-pnpm-store}
mkdir -p "$pnpm_store"
while IFS='=' read -r -d '' name value; do
  case "$name" in
    ST_*|ST2_*|ST3_*|FRACTAL_*|GH_*|GITHUB_*|SSH_AUTH_SOCK|SSH_AGENT_PID|EVIDENCE_*|SEKRETS_*|LD_PRELOAD|KIT_*|APP_TEST_SET) unset "$name" ;;
  esac
done < <(env -0)
st_state=${XDG_STATE_HOME:-$HOME/.local/state}/st3
kept=()
IFS=':' read -r -a entries <<< "$PATH"
for entry in "${entries[@]}"; do
  case "$entry" in "$st_state"|"$st_state"/*) ;; *) kept+=("$entry") ;; esac
done
PATH=$(IFS=':'; printf '%s' "${kept[*]}")
export HOME="$scratch/home" TMPDIR="$scratch/tmp" pnpm_config_store_dir="$pnpm_store"
export XDG_STATE_HOME="$HOME/.local/state" XDG_CONFIG_HOME="$HOME/.config" XDG_DATA_HOME="$HOME/.local/share" XDG_CACHE_HOME="$HOME/.cache"
export RUNNER_TEMP="$scratch/runner" GITHUB_STEP_SUMMARY="$scratch/summary.md"
mkdir -p "$XDG_STATE_HOME" "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" "$RUNNER_TEMP" "$TMPDIR"
touch "$GITHUB_STEP_SUMMARY"
head=$(git rev-parse HEAD)
export KIT_INPUTS=true KIT_SHARD_INDEX=0 KIT_SHARD_COUNT=1 KIT_PLAY_SET=all KIT_PLAY_A11Y=on APP_TEST_SET=all
export KIT_RECEIPT_DIRECTORY="$scratch/kit-play-receipts" BASE_SHA="$head" HEAD_SHA="$head"
python3 scripts/ci-web-shell-test
bash scripts/ci-fractal-web
