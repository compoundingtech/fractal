#!/usr/bin/env python3
"""Test frozen lock coverage, manifest normalization and verified optional archives."""

import base64
import hashlib
import io
import json
from pathlib import Path
import runpy
import tarfile
import tempfile
import unittest
from unittest.mock import patch

api = runpy.run_path(str(Path(__file__).with_name("ci-fractal-web-licenses")))
lock_packages = api["lock_packages"]
manifest_license = api["manifest_license"]
check_package_set = api["check_package_set"]
installed_manifests = api["installed_manifests"]
archive_manifest = api["archive_manifest"]
INTEGRITY = "sha512-" + base64.b64encode(bytes(64)).decode()
LOCK = f"""lockfileVersion: '9.0'
importers:
  .: {{}}
  apps/ios: {{}}
packages:
  '@fixture/font@1.0.0':
    resolution: {{integrity: {INTEGRITY}}}
  binary@2.0.0:
    resolution: {{integrity: {INTEGRITY}}}
    cpu: [arm64]
    os: [darwin]
snapshots:
  binary@2.0.0: {{}}
"""


class LicenseTests(unittest.TestCase):
    def test_complete_lock_package_set_not_snapshots_or_importers(self):
        self.assertEqual(lock_packages(LOCK), {("@fixture/font", "1.0.0"): INTEGRITY, ("binary", "2.0.0"): INTEGRITY})

    def test_staged_sources_are_not_registry_packages(self):
        directory = ".devenv/pnpm-source-inputs/current/repos/effect-utils/packages/@overeng/devbar"
        source = f"  '@overeng/devbar@file:{directory}':\n    resolution: {{directory: {directory}, type: directory}}\n    peerDependencies:\n      react: ^19.2.3\n"
        text = LOCK.replace("snapshots:", source + "snapshots:")
        self.assertEqual(lock_packages(text), lock_packages(LOCK))
        for invalid in (
            source.replace("file:" + directory, "file:../outside"),
            source.replace("directory: " + directory, "directory: ../outside"),
            source.replace(f"    resolution: {{directory: {directory}, type: directory}}\n", ""),
            source + source,
        ):
            with self.subTest(source=invalid), self.assertRaises(ValueError):
                lock_packages(LOCK.replace("snapshots:", invalid + "snapshots:"))

    def test_fail_closed_lock_formats(self):
        for text in (
            LOCK.replace("'9.0'", "'8.0'"),
            LOCK.replace(f"{{integrity: {INTEGRITY}}}", "{tarball: https://example.invalid/archive.tgz}"),
            LOCK.replace("binary@2.0.0", "binary@https://example.invalid/binary"),
            LOCK.replace("  binary@2.0.0:", "  '@fixture/font@1.0.0':"),
            LOCK.replace(f"    resolution: {{integrity: {INTEGRITY}}}\n", ""),
        ):
            with self.subTest(text=text), self.assertRaises(ValueError):
                lock_packages(text)

    def test_license_strings_and_legacy_fields(self):
        self.assertEqual(manifest_license({"license": "MIT AND OFL-1.1"}), "MIT AND OFL-1.1")
        self.assertEqual(manifest_license({"license": "MIT", "licenses": [{"type": "BSD-2-Clause"}]}), "MIT")
        self.assertEqual(manifest_license({"license": {"type": "MIT", "url": "https://example.invalid"}}), "MIT")
        self.assertEqual(manifest_license({"licenses": [{"type": "MIT"}, {"type": "BSD-2-Clause"}]}), "(MIT OR BSD-2-Clause)")
        self.assertEqual(manifest_license({"licenses": [{"type": "MIT"}]}), "MIT")
        for manifest in ({}, {"license": "UNKNOWN"}, {"licenses": []}, {"license": {"url": "missing-type"}}):
            with self.subTest(manifest=manifest), self.assertRaises(ValueError):
                manifest_license(manifest)

    def test_missing_metadata_uses_only_recognized_license_files(self):
        license_file = b"Recognized license fixture"
        fingerprint = hashlib.sha256(license_file).hexdigest()
        invalid_metadata = [{field: value} for field in ("license", "licenses") for value in (False, "", None, 0, [])]
        with patch.dict(api["LICENSE_FILE_HASHES"], {fingerprint: "Apache-2.0"}):
            self.assertEqual(manifest_license({}, license_file), "Apache-2.0")
            self.assertEqual(manifest_license({"license": "MIT"}, license_file), "MIT")
            for metadata in invalid_metadata:
                with self.subTest(metadata=metadata), self.assertRaises(ValueError):
                    manifest_license(metadata, license_file)
            with self.assertRaises(ValueError):
                manifest_license({}, license_file + b"changed")
            with tempfile.TemporaryDirectory() as directory:
                root = Path(directory)
                package = root / "fixture"
                package.mkdir()
                (package / "package.json").write_text(json.dumps({"name": "fixture", "version": "1.0.0"}))
                (package / "LICENSE").write_bytes(license_file)
                self.assertEqual(installed_manifests(root, {("fixture", "1.0.0")}), {("fixture", "1.0.0"): "Apache-2.0"})
                for metadata in invalid_metadata:
                    (package / "package.json").write_text(json.dumps({"name": "fixture", "version": "1.0.0", **metadata}))
                    with self.subTest(metadata=metadata), self.assertRaises(ValueError):
                        installed_manifests(root, {("fixture", "1.0.0")})
                (package / "package.json").write_text(json.dumps({"name": "fixture", "version": "1.0.0"}))
                (package / "LICENSE").write_bytes(license_file + b"changed")
                with self.assertRaises(ValueError):
                    installed_manifests(root, {("fixture", "1.0.0")})
            for body, metadata in [(license_file, {}), (license_file + b"changed", {})] + [(license_file, metadata) for metadata in invalid_metadata]:
                data = io.BytesIO()
                with tarfile.open(fileobj=data, mode="w:gz") as archive:
                    for name, content in (("package.json", json.dumps({"name": "fixture", "version": "1.0.0", **metadata}).encode()), ("LICENSE", body)):
                        member = tarfile.TarInfo(f"package/{name}")
                        member.size = len(content)
                        archive.addfile(member, io.BytesIO(content))
                data = data.getvalue()
                integrity = "sha512-" + base64.b64encode(hashlib.sha512(data).digest()).decode()
                if body == license_file and not metadata:
                    self.assertEqual(archive_manifest(data, integrity, ("fixture", "1.0.0"))["license"], "Apache-2.0")
                    with self.assertRaisesRegex(ValueError, "integrity mismatch"):
                        archive_manifest(data, INTEGRITY, ("fixture", "1.0.0"))
                else:
                    with self.assertRaises(ValueError):
                        manifest_license(archive_manifest(data, integrity, ("fixture", "1.0.0")))

    def test_inventory_drift_and_duplicates(self):
        packages = lock_packages(LOCK)
        entries = [{"name": name, "version": version, "license": "MIT"} for name, version in sorted(packages)]
        check_package_set({"packages": entries}, packages)
        for bad in (entries[:1], entries + [entries[0]], list(reversed(entries)), entries + [{"name": "extra", "version": "1.0.0", "license": "MIT"}]):
            with self.subTest(entries=bad), self.assertRaises(ValueError):
                check_package_set({"packages": bad}, packages)

    def test_hoisted_nested_versions_and_conflicting_manifests(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            paths = [("@fixture/font", "1.0.0", "MIT AND OFL-1.1"), ("other/node_modules/@fixture/font", "2.0.0", "MIT")]
            for path, version, license in paths:
                target = root / path / "package.json"
                target.parent.mkdir(parents=True)
                target.write_text(json.dumps({"name": "@fixture/font", "version": version, "license": license}))
            keys = {("@fixture/font", "1.0.0"), ("@fixture/font", "2.0.0"), ("binary", "2.0.0")}
            self.assertEqual(installed_manifests(root, keys), {("@fixture/font", "1.0.0"): "MIT AND OFL-1.1", ("@fixture/font", "2.0.0"): "MIT"})
            target.write_text(json.dumps({"name": "@fixture/font", "version": "1.0.0", "license": "MIT"}))
            with self.assertRaises(ValueError):
                installed_manifests(root, keys)
        with self.assertRaises(ValueError):
            installed_manifests(Path(directory), keys)

    def test_archive_integrity_and_identity(self):
        manifest = {"name": "binary", "version": "2.0.0", "license": "MPL-2.0"}
        body = json.dumps(manifest).encode()
        data = io.BytesIO()
        with tarfile.open(fileobj=data, mode="w:gz") as archive:
            member = tarfile.TarInfo("package/package.json")
            member.size = len(body)
            archive.addfile(member, io.BytesIO(body))
        data = data.getvalue()
        integrity = "sha512-" + base64.b64encode(hashlib.sha512(data).digest()).decode()
        self.assertEqual(archive_manifest(data, integrity, ("binary", "2.0.0")), manifest)
        with self.assertRaises(ValueError):
            archive_manifest(data, INTEGRITY, ("binary", "2.0.0"))
        with self.assertRaises(ValueError):
            archive_manifest(data, integrity, ("binary", "1.0.0"))

    def test_archive_non_package_root_and_multiple_roots(self):
        manifest = {"name": "@types/ws", "version": "8.18.2", "license": "MIT"}
        body = json.dumps(manifest).encode()
        for extra in (None, "other/README", "other/package.json"):
            with self.subTest(extra=extra):
                data = io.BytesIO()
                with tarfile.open(fileobj=data, mode="w:gz") as archive:
                    directory = tarfile.TarInfo("ws/")
                    directory.type = tarfile.DIRTYPE
                    archive.addfile(directory)
                    for name in ("ws/package.json", "ws/index.d.ts", extra):
                        if name is not None:
                            member = tarfile.TarInfo(name)
                            member.size = len(body)
                            archive.addfile(member, io.BytesIO(body))
                data = data.getvalue()
                integrity = "sha512-" + base64.b64encode(hashlib.sha512(data).digest()).decode()
                if extra is None:
                    self.assertEqual(archive_manifest(data, integrity, ("@types/ws", "8.18.2")), manifest)
                    with self.assertRaisesRegex(ValueError, "integrity mismatch"):
                        archive_manifest(data, INTEGRITY, ("@types/ws", "8.18.2"))
                    with self.assertRaisesRegex(ValueError, "identity mismatch"):
                        archive_manifest(data, integrity, ("@types/ws", "8.18.1"))
                else:
                    with self.assertRaisesRegex(ValueError, "exactly one top-level directory"):
                        archive_manifest(data, integrity, ("@types/ws", "8.18.2"))


if __name__ == "__main__":
    unittest.main()
