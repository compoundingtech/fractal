#!/usr/bin/env python3
"""Safe host-side signal ownership tests. Orphan parent kills are VM-only."""
import importlib.machinery
import importlib.util
import errno
from contextlib import redirect_stderr
import io
import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile
import unittest
from unittest.mock import patch

from script_process import signal_private
import script_process

HERE = Path(__file__).resolve().parent


@unittest.skipUnless(sys.platform == 'linux', 'Linux pidfd/subreaper ownership contract')
class SignalOwnershipTests(unittest.TestCase):
    def test_non_dumpable_neighbor_does_not_abort_private_fixture_sweep(self):
        inaccessible = subprocess.Popen([sys.executable, '-c',
            "import ctypes,time; "
            "assert ctypes.CDLL(None).prctl(4,0,0,0,0)==0; "
            "print('non-dumpable',flush=True); time.sleep(30)"],
            stdout=subprocess.PIPE, text=True)
        self.addCleanup(self.finish, inaccessible)
        self.addCleanup(inaccessible.stdout.close)
        self.assertEqual(inaccessible.stdout.readline().strip(), 'non-dumpable')
        try:
            Path(f'/proc/{inaccessible.pid}/environ').read_bytes()
        except PermissionError:
            pass
        else:
            self.skipTest('privileged reader can inspect non-dumpable processes')
        target = self.child('reachable-after-denied')
        # Only inspect these owned fixtures; never sweep the host's processes.
        entries = [Path(f'/proc/{inaccessible.pid}'), Path(f'/proc/{target.pid}')]
        with patch.object(Path, 'glob', return_value=iter(entries)), \
             patch.object(sys, 'argv', ['script_process.py', 'all', str(signal.SIGTERM),
                                      '--env', 'SCRIPT_TEST_OWNER=reachable-after-denied']):
            self.assertEqual(script_process.main(), 0)
        self.assertEqual(target.wait(timeout=3), -signal.SIGTERM)
        self.assertIsNone(inaccessible.poll())

    def test_metadata_io_failure_closes_pidfd_without_signalling(self):
        child = self.child('metadata-denied')
        real_close = os.close
        with patch.object(script_process, 'matches_private_process', side_effect=OSError('metadata unreadable')), \
             patch('os.close', wraps=real_close) as close, \
             patch('signal.pidfd_send_signal') as send:
            self.assertFalse(signal_private(child.pid, signal.SIGTERM,
                                            environment={'SCRIPT_TEST_OWNER': 'metadata-denied'}))
            close.assert_called_once()
            send.assert_not_called()
        self.assertIsNone(child.poll())

    def test_pidfd_resource_exhaustion_and_invalid_signals_are_not_hidden(self):
        child = self.child('error-policy')
        with patch('os.pidfd_open', side_effect=OSError(errno.EMFILE, 'too many open files')):
            with self.assertRaises(OSError) as error:
                signal_private(child.pid, signal.SIGTERM, environment={'SCRIPT_TEST_OWNER': 'error-policy'})
            self.assertEqual(error.exception.errno, errno.EMFILE)
        with patch('signal.pidfd_send_signal', side_effect=OSError(errno.EINVAL, 'invalid signal')):
            with self.assertRaises(OSError) as error:
                signal_private(child.pid, signal.SIGTERM, environment={'SCRIPT_TEST_OWNER': 'error-policy'})
            self.assertEqual(error.exception.errno, errno.EINVAL)
        self.assertIsNone(child.poll())

    def test_parent_one_or_lower_cannot_select_orphans(self):
        for parent in (-1, 0, 1):
            with self.assertRaisesRegex(ValueError, 'greater than 1'):
                signal_private(999999, signal.SIGTERM, parent=parent)

    def test_unsupported_platform_refuses_named_and_all_before_reading_proc(self):
        for target in ('123', 'all'):
            error = io.StringIO()
            with patch.object(sys, 'platform', 'darwin'), \
                 patch.object(sys, 'argv', ['script_process.py', target, '15', '--root', '/private']), \
                 patch.object(Path, 'glob', side_effect=AssertionError('must not scan /proc')), \
                 redirect_stderr(error):
                self.assertEqual(script_process.main(), 2)
            self.assertIn('Linux only', error.getvalue())
            self.assertNotIn('Traceback', error.getvalue())

    def test_linux_fixture_entrypoints_refuse_before_creating_resources(self):
        with tempfile.TemporaryDirectory() as tmp:
            directory = Path(tmp)
            tools = directory / 'bin'
            tools.mkdir()
            python = tools / 'python3'
            python.write_text('#!/bin/sh\n'
                '[ "$2" = --check-platform ] || exit 97\n'
                'echo "Linux only: fixture signalling requires /proc and pidfds" >&2\nexit 2\n')
            python.chmod(0o700)
            output = directory / 'must-not-exist'
            for name in ('omp-parity-e2e/run', 'st3-instance-isolation/run',
                         'st3-work-root-trace/run', 'conversation-images-audit/run',
                         'st3-no-boot-eval/run', 'st3-graceful-messaging-eval/run',
                         'st3-seat-queue-perf/startup'):
                with self.subTest(entrypoint=name):
                    result = subprocess.run(['bash', str(HERE / name), 'unused', 'unused', str(output)],
                        env={**os.environ, 'PATH': str(tools) + os.pathsep + os.environ['PATH']},
                        capture_output=True, text=True, timeout=3)
                    self.assertEqual(result.returncode, 2, result.stderr)
                    self.assertIn('Linux only', result.stderr)
                    self.assertFalse(output.exists())

    def test_shell_suite_replaces_a_stale_supervisor_marker_and_preserves_status(self):
        with tempfile.TemporaryDirectory() as tmp:
            fixture = Path(tmp) / 'suite'
            fixture.write_text(f'set -e\n. {str(HERE / "script-test-supervisor")!r}\n'
                               f'python3 {str(HERE / "st3_test_process.py")!r} --is-supervised\n'
                               'exit 17\n')
            result = subprocess.run(['bash', str(fixture)], timeout=5,
                env={**os.environ, 'SMALLTALK_TEST_SUPERVISOR': 'stale-marker'})
            self.assertEqual(result.returncode, 17)

    def test_parent_kill_fixtures_are_confined_to_the_guest(self):
        import re
        patterns = [r'os\.kill\(\s*os\.getppid\(', r'kill\s+-\w+\s+["\x27]?\$PPID']
        for path in HERE.rglob('*'):
            if not path.is_file() or path.name == 'script-orphan-guest-test' or '__pycache__' in path.parts:
                continue
            try:
                content = path.read_text()
            except UnicodeDecodeError:
                continue
            for pattern in patterns:
                self.assertIsNone(re.search(pattern, content), str(path))

    def child(self, marker):
        child = subprocess.Popen([sys.executable, '-c', 'import time; time.sleep(30)'],
                                 env={**os.environ, 'SCRIPT_TEST_OWNER': marker})
        self.addCleanup(self.finish, child)
        return child

    @staticmethod
    def finish(child):
        if child.poll() is None:
            child.kill()
        child.wait()

    def test_private_marker_and_start_receipt_required(self):
        child = self.child('private-fixture')
        ticks = int(Path(f'/proc/{child.pid}/stat').read_text().rsplit(')', 1)[1].split()[19])
        self.assertFalse(signal_private(child.pid, signal.SIGTERM,
                                        environment={'SCRIPT_TEST_OWNER': 'different-fixture'}))
        self.assertFalse(signal_private(child.pid, signal.SIGTERM, start_ticks=ticks + 1,
                                        environment={'SCRIPT_TEST_OWNER': 'private-fixture'}))
        self.assertIsNone(child.poll())
        self.assertTrue(signal_private(child.pid, signal.SIGTERM, start_ticks=ticks,
                                       environment={'SCRIPT_TEST_OWNER': 'private-fixture'}))
        self.assertEqual(child.wait(timeout=3), -signal.SIGTERM)

    def test_parent_self_and_pid_one_refused_before_pidfd_open(self):
        with patch('os.pidfd_open', side_effect=AssertionError('must not open an ancestor')):
            for pid in (1, os.getpid(), os.getppid()):
                self.assertFalse(signal_private(pid, signal.SIGTERM, parent=os.getppid()))

    def test_endpoint_conflict_refused(self):
        child = subprocess.Popen(['sleep', '30'], env={**os.environ,
            'FRACTAL_ENDPOINT': '/private/one', 'ST3_ENDPOINT': '/private/two'})
        self.addCleanup(self.finish, child)
        self.assertFalse(signal_private(child.pid, signal.SIGTERM, endpoint='/private/one'))
        self.assertIsNone(child.poll())

    def test_exited_pidfd_never_signals_a_replacement(self):
        child = self.child('same-marker')
        original_open = os.pidfd_open
        def exit_after_pin(pid):
            fd = original_open(pid)
            signal.pidfd_send_signal(fd, signal.SIGKILL)
            child.wait()
            return fd
        with patch('os.pidfd_open', side_effect=exit_after_pin), \
             patch('os.kill', side_effect=AssertionError('numeric signal forbidden')):
            self.assertFalse(signal_private(child.pid, signal.SIGTERM,
                                            environment={'SCRIPT_TEST_OWNER': 'same-marker'}))

    def test_late_installer_request_cannot_signal_its_new_parent(self):
        # A duplicate/delayed request can only reach the pipe's original reader.
        with tempfile.TemporaryDirectory() as tmp:
            child = Path(tmp) / 'installer.py'
            child.write_text("import os, signal, time\n"
                "signal.signal(signal.SIGTERM, lambda *_: exit(43))\n"
                "os.write(int(os.environ['INSTALL_TEST_SIGNAL_FD']), b'TT')\n"
                "time.sleep(10)\n")
            result = subprocess.run([sys.executable, str(HERE / 'test-signal-target'),
                                     sys.executable, str(child)], timeout=5)
            self.assertEqual(result.returncode, 43)

    def test_reaped_evidence_group_is_never_signalled(self):
        loader = importlib.machinery.SourceFileLoader('prepush', str(HERE / 'evidence-prepush'))
        module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
        loader.exec_module(module)
        child = subprocess.Popen(['true'])
        child.wait()
        with patch('os.killpg', side_effect=AssertionError('reaped PID/group reused')):
            module.stop(child, 0)


if __name__ == '__main__':
    unittest.main()
