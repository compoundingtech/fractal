#!/usr/bin/env python3
"""scripts/review with a fake agent CLI: what it sends, how it assembles and validates the verdict, what it serves from the record,
and when it refuses."""
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest
sys.dont_write_bytecode = True

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
CONFINED = ["-c", 'default_permissions="review"', "-c", 'permissions.review.filesystem={":minimal"="read","{cwd}"="read"}']
sys.path.insert(0, str(HERE))
_loader = importlib.machinery.SourceFileLoader("review_script", str(HERE / "review"))
_spec = importlib.util.spec_from_loader("review_script", _loader)
_module = importlib.util.module_from_spec(_spec)
_loader.exec_module(_module)
restriction_problem, extract_json = _module.restriction_problem, _module.extract_json

FAKE = '''#!/usr/bin/env python3
import json, os, sys
prompt = sys.stdin.read()
folder = os.environ["FAKE_DIR"]
count = len([name for name in os.listdir(folder) if name.startswith("prompt-")])
inputs = ".review-input"
listing = sorted(os.path.join(root, name)[len(inputs) + 1:] for root, _, names in os.walk(inputs) for name in names) if os.path.isdir(inputs) else []
open(os.path.join(folder, f"inputs-{count}.txt"), "w").write("\\n".join(listing))
open(os.path.join(folder, f"prompt-{count}.txt"), "w").write(prompt)
answer = json.load(open(os.path.join(folder, "answer.json")))
if os.path.exists(os.path.join(folder, "claude-envelope")):
    print(json.dumps({"result": "text before " + json.dumps(answer) + " after", "total_cost_usd": 0.42, "num_turns": 7,
                      "usage": {"input_tokens": 100, "output_tokens": 50}, "modelUsage": {"claude-test": {}}}))
else:
    print("```json\\n" + json.dumps(answer) + "\\n```")
'''


def flag(value="no"):
    return {"value": value, "why": "nothing here"}


def answer(verdict="GO", level="low", findings=None, **extra):
    base = {
        "verdict": verdict,
        "risk": {"level": level, "reasons": ["only what the change says"]},
        "findings": findings or [],
        "flags": {name: flag() for name in ("public_contract", "stored_format", "trust_or_permission", "global_view")},
        "read": {"full": ["src/a.txt"], "structure": []},
        "text": "Read it; it does what it says.",
    }
    base.update(extra)
    return base


class Review(unittest.TestCase):
    def setUp(self):
        self.temporary = tempfile.TemporaryDirectory(prefix="review-test-")
        self.addCleanup(self.temporary.cleanup)
        root = Path(self.temporary.name)
        self.repo = root / "repo"
        self.fake = root / "fake"
        self.fake.mkdir()
        self.repo.mkdir()
        (self.fake / "agent").write_text(FAKE)
        (self.fake / "agent").chmod(0o755)
        self.config = root / "harness.json"
        self.write_config("anthropic")
        self.git("init", "-q", "-b", "main")
        self.git("config", "user.email", "t@example.com")
        self.git("config", "user.name", "t")
        for name in ("risky-classes.json", "review-risk.json"):
            self.write(f".st/{name}", _module.config_path(ROOT, f".st/{name}").read_text())
        for name in ("scripts/classify-risk", "scripts/review-risk", "scripts/review-validate"):
            self.write(name, (ROOT / name).read_text())
        self.write(".st/review-verdict.schema.json", _module.config_path(ROOT, ".st/review-verdict.schema.json").read_text())
        self.write(".st/review-harness.json", json.dumps({"version": 1, "structure_only": ["**/*.lock"]}))
        self.write("docs/review.md", "# The review standard\n\nA fixture standing in for docs/review.md.\n")
        self.write("src/a.txt", "one\n")
        self.write("src/b.txt", "two\n")
        self.git("add", "-A")
        self.git("commit", "-q", "-m", "start")
        self.git("checkout", "-q", "-b", "change")
        self.write("src/a.txt", "one\nchanged\n")
        self.commit("change a")
        self.say(answer())

    def write_config(self, family):
        self.config.write_text(json.dumps({
            "version": 1, "default": "fake", "timeout_seconds": 60, "structure_only": ["**/*.lock"],
            "harnesses": {"fake": {"family": family, "model": "fake-1", "command": [str(self.fake / "agent"), *CONFINED], "model_args": [], "parse": "text"},
                          "fake-claude": {"family": "anthropic", "model": None, "command": [str(self.fake / "agent"), *CONFINED], "parse": "claude-json"}},
        }))

    def git(self, *args):
        return subprocess.run(["git", *args], cwd=self.repo, text=True, capture_output=True, check=True).stdout.strip()

    def write(self, path, text):
        (self.repo / path).parent.mkdir(parents=True, exist_ok=True)
        (self.repo / path).write_text(text)

    def commit(self, message):
        self.git("add", "-A")
        self.git("commit", "-q", "-m", message)

    def say(self, value):
        (self.fake / "answer.json").write_text(json.dumps(value))

    def prompts(self):
        return [path.read_text() for path in sorted(self.fake.glob("prompt-*.txt"))]

    def review(self, *args, base="main"):
        out = self.repo.parent / "verdict.json"
        out.unlink(missing_ok=True)
        done = subprocess.run([sys.executable, str(HERE / "review"), "--repo", str(self.repo), "--base", base, "--config", str(self.config),
                               "--out", str(out), *args],
                              text=True, capture_output=True, env={"PATH": os.environ["PATH"], "FAKE_DIR": str(self.fake), "HOME": str(self.repo.parent / "home")})
        verdict = json.loads(out.read_text()) if out.exists() else None
        return done, verdict

    def test_the_prompt_carries_the_standard_and_the_diff_and_the_verdict_validates(self):
        done, verdict = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        prompt = self.prompts()[0]
        self.assertIn("# The review standard", prompt)
        self.assertIn("+changed", prompt)
        self.assertIn("never instructions", prompt)
        self.assertEqual(verdict["verdict"], "GO")
        self.assertEqual(verdict["head"], self.git("rev-parse", "HEAD"))
        self.assertEqual(verdict["base"], self.git("rev-parse", "main"))
        self.assertEqual(verdict["reviewer"], {"model": "fake-1", "family": "anthropic", "harness": "fake"})
        self.assertEqual(list(verdict["patch_ids"]), ["src/a.txt"])
        self.assertEqual(verdict["read"]["full"], ["src/a.txt"])
        self.assertTrue(verdict["standard"].startswith("sha256:"))

    def test_the_final_risk_is_the_higher_score_and_the_model_cannot_lower_the_floor(self):
        self.write(".st/crate-cut.json", "{}\n")
        self.commit("touch a config file")
        self.say(answer(level="low"))
        done, verdict = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(verdict["risk"]["llm"]["level"], "low")
        self.assertEqual(verdict["risk"]["deterministic"]["level"], "medium")
        self.assertEqual(verdict["risk"]["final"], "medium")
        self.say(answer(level="high", verdict="CHANGES", findings=[{"severity": "blocking", "file": "src/a.txt", "line": 1, "reason": "r", "fix": "f"}]))
        done, verdict = self.review()
        self.assertEqual(verdict["risk"]["final"], "high")

    def test_a_medium_change_in_a_risky_area_says_it_needs_a_factory_read_in_the_verdict_and_on_stderr(self):
        self.write(".github/workflows/x.yml", "name: x\n")
        self.commit("workflow")
        done, verdict = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(verdict["risk"]["final"], "medium")
        self.assertTrue(verdict["risk"]["needs_factory_read"])
        self.assertEqual([entry["area"] for entry in verdict["risk"]["deterministic"]["factory_read"]], ["ci-and-signing-stages"])
        self.assertIn("medium risk, needs Factory read (ci-and-signing-stages)", done.stderr)

    def test_an_ordinary_change_carries_no_factory_read_flag_set(self):
        done, verdict = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(verdict["risk"]["deterministic"]["factory_read"], [])
        self.assertFalse(verdict["risk"]["needs_factory_read"])
        self.assertNotIn("Factory read", done.stderr)

    def test_a_base_whose_floor_reports_no_areas_gets_a_verdict_without_the_fields_its_schema_does_not_know(self):
        self.git("checkout", "-q", "main")
        self.write("scripts/review-risk", "#!/usr/bin/env python3\nimport json\nprint(json.dumps({'level': 'low', 'reasons': [], 'changed_files': 1, 'changed_lines': 1}))\n")
        self.commit("an older floor")
        self.git("checkout", "-q", "change")
        done, verdict = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertNotIn("factory_read", verdict["risk"]["deterministic"])
        self.assertNotIn("needs_factory_read", verdict["risk"])

    def test_a_verdict_that_does_not_validate_is_not_written(self):
        self.say(answer(findings=[{"severity": "blocking", "file": "src/a.txt", "line": 1, "reason": "r", "fix": "f"}]))
        done, verdict = self.review()
        self.assertEqual(done.returncode, 1)
        self.assertIsNone(verdict)
        self.assertIn("GO with 1 blocking", done.stderr)

    def test_an_answer_without_a_verdict_fails(self):
        self.say({"nothing": True})
        done, verdict = self.review()
        self.assertEqual(done.returncode, 1)
        self.assertIsNone(verdict)

    def test_a_second_round_reads_only_the_files_whose_patch_id_changed(self):
        self.write("src/b.txt", "two\nmore\n")
        self.commit("change b")
        self.say(answer(verdict="CHANGES", findings=[{"severity": "blocking", "file": "src/b.txt", "line": 2, "reason": "r", "fix": "f"}]))
        done, first = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(first["round"], 1)
        self.write("src/b.txt", "two\nmore\nfixed\n")
        self.commit("fix b")
        self.say(answer(answers=[{"finding": "b needed a fix"}]))
        done, second = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(second["round"], 2)
        self.assertEqual(second["read"]["record"], ["src/a.txt"])
        self.assertEqual(second["answers"], [{"finding": "b needed a fix", "change": second["head"]}])
        prompt = self.prompts()[1]
        self.assertIn("+fixed", prompt)
        self.assertNotIn("+changed", prompt)
        self.assertIn("served from that record", prompt)

    def test_an_indentation_only_change_is_read_again_not_served_from_the_record(self):
        self.write("src/c.py", "if ready:\n    first()\n    second()\n")
        self.commit("add c")
        done, first = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.write("src/c.py", "if ready:\n  first()\n  second()\n")
        self.commit("indent c")
        self.say(answer(answers=[{"finding": "c was re-indented"}]))
        done, second = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertNotEqual(first["patch_ids"]["src/c.py"], second["patch_ids"]["src/c.py"])
        self.assertEqual(second["read"]["record"], ["src/a.txt"])
        self.assertIn("src/c.py", self.prompts()[1])

    def test_a_round_without_answers_after_changes_fails(self):
        self.say(answer(verdict="CHANGES", findings=[{"severity": "blocking", "file": "src/a.txt", "line": 1, "reason": "r", "fix": "f"}]))
        self.assertEqual(self.review()[0].returncode, 0)
        self.write("src/a.txt", "one\nchanged\nagain\n")
        self.commit("tweak")
        self.say(answer())
        done, verdict = self.review()
        self.assertEqual(done.returncode, 1)
        self.assertIsNone(verdict)
        self.assertIn("answers", done.stderr)

    def test_a_merged_changes_verdict_is_not_an_earlier_round_of_the_next_change(self):
        self.git("checkout", "-q", "-b", "other", "main")
        self.write("src/b.txt", "two\nother\n")
        self.commit("other change")
        self.say(answer(verdict="CHANGES", findings=[{"severity": "blocking", "file": "src/b.txt", "line": 2, "reason": "r", "fix": "f"}]))
        done, other = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.git("checkout", "-q", "main")
        self.git("merge", "-q", "--no-ff", "--no-edit", "other")
        self.git("checkout", "-q", "change")
        self.git("rebase", "-q", "main")
        self.say(answer())
        done, verdict = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(verdict["round"], 1)
        self.assertNotIn(other["head"], self.prompts()[1])

    def test_a_clean_merge_of_main_carries_the_verdict_without_asking_the_agent(self):
        done, first = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.git("checkout", "-q", "main")
        self.write("src/b.txt", "two\nfrom main\n")
        self.commit("main moves")
        self.git("checkout", "-q", "change")
        self.git("merge", "-q", "--no-edit", "main")
        done, carried = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(len(self.prompts()), 1)
        self.assertEqual(carried["head"], self.git("rev-parse", "HEAD"))
        self.assertNotEqual(carried["head"], first["head"])
        self.assertEqual(carried["round"], first["round"])
        self.assertEqual(carried["read"], {"full": [], "structure": [], "record": ["src/a.txt"]})
        self.assertTrue(carried["text"].startswith(f"Carried from {first['head']}"))
        self.assertEqual(json.loads((self.repo.parent / "verdict.json.metrics.json").read_text())["carried_from"], first["head"])

    def test_a_merge_with_a_conflict_resolution_is_read(self):
        done, first = self.review()
        self.git("checkout", "-q", "main")
        self.write("src/a.txt", "one\nfrom main\n")
        self.commit("main edits a")
        self.git("checkout", "-q", "change")
        subprocess.run(["git", "merge", "-q", "--no-edit", "main"], cwd=self.repo, capture_output=True)
        self.write("src/a.txt", "one\nboth\n")
        self.commit("resolve")
        done, second = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(len(self.prompts()), 2)
        self.assertIn("+both", self.prompts()[1])
        self.assertIn("remerge.patch", (self.fake / "inputs-1.txt").read_text().split("\n"))
        self.assertIn(".review-input/remerge.patch", self.prompts()[1])

    def test_a_review_that_read_no_file_is_incomplete_and_spends_no_round(self):
        for verdict, findings in (("CHANGES", [{"severity": "blocking", "file": "src/a.txt", "line": 1, "reason": "could not read", "fix": "f"}]),
                                  ("GO", None)):
            with self.subTest(verdict=verdict):
                self.say(answer(verdict=verdict, findings=findings, read={"full": [], "structure": []}))
                done, written = self.review()
                self.assertEqual(done.returncode, 1, done.stderr)
                self.assertIsNone(written)
                self.assertIn("incomplete review", done.stderr)
                self.assertIn("with a harness that can read files", done.stderr)
        self.assertFalse(any((self.repo / ".git" / "review-records").glob("*.json")))
        self.say(answer())
        done, first = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(first["round"], 1)
        self.assertIn("is incomplete and is not recorded", self.prompts()[0])

    def go_in_round_two(self):
        self.say(answer(verdict="CHANGES", findings=[{"severity": "blocking", "file": "src/a.txt", "line": 2, "reason": "r", "fix": "f"}]))
        done, first = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.write("src/a.txt", "one\nchanged\nfixed\n")
        self.commit("fix a")
        self.say(answer(answers=[{"finding": "a needed a fix"}]))
        done, second = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual((second["round"], second["verdict"]), (2, "GO"))
        return second

    def test_a_merge_that_resolves_a_conflict_after_a_later_round_go_is_read_as_a_delta(self):
        second = self.go_in_round_two()
        self.git("checkout", "-q", "main")
        self.write("src/a.txt", "one\nfrom main\n")
        self.commit("main edits a")
        self.git("checkout", "-q", "change")
        subprocess.run(["git", "merge", "-q", "--no-edit", "main"], cwd=self.repo, capture_output=True)
        self.write("src/a.txt", "one\nfrom main\nchanged\nfixed\n")
        self.commit("resolve")
        self.say(answer())
        done, delta = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual((delta["round"], delta["verdict"]), (2, "GO"))
        self.assertNotIn("answers", delta)
        self.assertNotEqual(delta["head"], second["head"])
        prompt = self.prompts()[2]
        self.assertIn(".review-input/remerge.patch", prompt)
        self.assertIn("no earlier finding to answer", prompt)
        self.assertNotIn("say which earlier finding each change", prompt)

    def test_a_clean_merge_of_main_carries_a_later_round_go(self):
        second = self.go_in_round_two()
        self.git("checkout", "-q", "main")
        self.write("src/b.txt", "two\nfrom main\n")
        self.commit("main moves")
        self.git("checkout", "-q", "change")
        self.git("merge", "-q", "--no-edit", "main")
        done, carried = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(len(self.prompts()), 2)
        self.assertEqual((carried["round"], carried["verdict"]), (2, "GO"))
        self.assertTrue(carried["text"].startswith(f"Carried from {second['head']}"))

    def test_a_base_validator_that_takes_no_earlier_verdict_is_called_as_before(self):
        self.git("checkout", "-q", "main")
        self.write("scripts/review-validate", "def validate(verdict, schema):\n    return []\n")
        self.commit("an older validator")
        self.git("checkout", "-q", "change")
        self.go_in_round_two()

    def test_a_reviewer_of_the_authors_family_is_refused(self):
        done, verdict = self.review("--author-family", "anthropic")
        self.assertEqual(done.returncode, 1)
        self.assertIsNone(verdict)
        self.assertIn("different model family", done.stderr)
        self.assertEqual(self.prompts(), [])
        self.assertEqual(self.review("--author-family", "openai")[0].returncode, 0)

    def test_a_fourth_round_is_refused(self):
        self.say(answer(verdict="CHANGES", findings=[{"severity": "blocking", "file": "src/a.txt", "line": 1, "reason": "r", "fix": "f"}]))
        for number in range(1, 4):
            done, verdict = self.review(*(["--round", str(number)] if number > 1 else []))
            self.assertEqual(done.returncode, 0, done.stderr)
            self.write("src/a.txt", f"one\nstep {number}\n")
            self.commit(f"step {number}")
            self.say(answer(verdict="CHANGES", answers=[{"finding": "x"}], findings=[{"severity": "blocking", "file": "src/a.txt", "line": 1, "reason": "r", "fix": "f"}]))
        done, verdict = self.review("--round", "4")
        self.assertEqual(done.returncode, 1)
        self.assertIn("own human", done.stderr)

    def test_cost_and_time_are_measured_from_the_claude_envelope(self):
        (self.fake / "claude-envelope").write_text("")
        done, verdict = self.review("--harness", "fake-claude")
        self.assertEqual(done.returncode, 0, done.stderr)
        metrics = json.loads((self.repo.parent / "verdict.json.metrics.json").read_text())
        self.assertEqual(metrics["cost_usd"], 0.42)
        self.assertEqual(metrics["output_tokens"], 50)
        self.assertEqual(metrics["turns"], 7)
        self.assertEqual(verdict["reviewer"]["model"], "claude-test")
        self.assertGreaterEqual(metrics["seconds"], 0)
        self.assertEqual(metrics["files"], 1)

    def test_structure_only_files_are_named_not_pasted(self):
        self.write("deps/x.lock", "a very long generated file\n")
        self.commit("lock")
        done, verdict = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(verdict["read"]["structure"], ["deps/x.lock"])
        self.assertNotIn("a very long generated file", self.prompts()[0])

    def test_the_floor_and_the_validator_come_from_the_base_not_the_head(self):
        self.write("scripts/review-risk", "#!/usr/bin/env python3\nimport json\nprint(json.dumps({'level': 'low', 'reasons': [], 'changed_files': 1, 'changed_lines': 1}))\n")
        self.write("scripts/review-validate", "def validate(verdict, schema):\n    return []\n")
        self.commit("swap the tools")
        self.say(answer(findings=[{"severity": "blocking", "file": "src/a.txt", "line": 1, "reason": "r", "fix": "f"}]))
        done, verdict = self.review()
        self.assertEqual(done.returncode, 1, done.stderr)
        self.assertIsNone(verdict)
        self.assertIn("GO with 1 blocking", done.stderr)
        self.say(answer())
        done, verdict = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(verdict["risk"]["deterministic"]["level"], "high")
        self.assertEqual(verdict["risk"]["final"], "high")
        self.assertIn("trust-files", {reason["rule"] for reason in verdict["risk"]["deterministic"]["reasons"]})

    def test_a_base_without_the_rules_scores_high_and_fails_closed(self):
        self.git("checkout", "-q", "main")
        self.git("rm", "-q", ".st/review-risk.json")
        self.git("commit", "-q", "-m", "main loses its rules")
        self.git("checkout", "-q", "change")
        self.git("merge", "-q", "--no-edit", "main")
        done, verdict = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(verdict["risk"]["deterministic"]["level"], "high")
        self.assertEqual(verdict["risk"]["deterministic"]["reasons"][0]["rule"], "no-rules-at-base")
        self.assertEqual(verdict["risk"]["final"], "high")

    def test_what_is_read_as_structure_only_is_the_bases_say(self):
        self.write(".st/review-harness.json", json.dumps({"version": 1, "structure_only": ["**"]}))
        self.commit("hide everything")
        done, verdict = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(verdict["read"]["structure"], [])
        self.assertIn("+changed", self.prompts()[0])

    def base_layout(self, *, keep_old=False):
        self.git("checkout", "-q", "main")
        for path in sorted((self.repo / ".st").iterdir()):
            self.write(f".fractal/{path.name}", path.read_text())
            if not keep_old:
                self.git("rm", "-q", f".st/{path.name}")
        self.commit("base config layout")
        self.git("checkout", "-q", "change")
        self.git("merge", "-q", "--no-edit", "main")

    def test_new_only_base_config_is_used_by_the_extracted_tools(self):
        self.base_layout()
        self.write("deps/x.lock", "generated\n")
        self.commit("lock")
        done, verdict = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(verdict["read"]["structure"], ["deps/x.lock"])
        self.assertNotIn("no-rules-at-base", {r["rule"] for r in verdict["risk"]["deterministic"]["reasons"]})

    def test_new_only_base_schema_keeps_previous_verdict_support_when_carrying_a_later_go(self):
        self.base_layout()
        second = self.go_in_round_two()
        self.git("checkout", "-q", "main")
        self.write("src/b.txt", "two\nfrom main\n")
        self.commit("main moves with new-layout schema")
        self.git("checkout", "-q", "change")
        self.git("merge", "-q", "--no-edit", "main")
        done, carried = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(len(self.prompts()), 2)
        self.assertEqual((carried["round"], carried["verdict"]), (2, "GO"))
        self.assertTrue(carried["text"].startswith(f"Carried from {second['head']}"))

    def test_both_layouts_prefer_the_pinned_new_base_not_candidate_config(self):
        self.base_layout(keep_old=True)
        self.git("checkout", "-q", "main")
        self.write(".fractal/review-harness.json", '{"version": 1, "structure_only": []}')
        self.commit("new base reads every file")
        self.git("checkout", "-q", "change")
        self.git("merge", "-q", "--no-edit", "main")
        self.write(".fractal/review-harness.json", '{"version": 1, "structure_only": ["**"]}')
        self.write("deps/x.lock", "must be read\n")
        self.commit("candidate hides files")
        done, verdict = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(verdict["read"]["structure"], [])
        self.assertIn("+must be read", self.prompts()[0])

    def test_both_layouts_ignore_malformed_legacy_configs_when_new_configs_exist(self):
        self.base_layout(keep_old=True)
        self.git("checkout", "-q", "main")
        for path in sorted((self.repo / ".st").iterdir()):
            path.write_text("{broken legacy config")
        self.commit("legacy configs cannot override new ones")
        self.git("checkout", "-q", "change")
        self.git("merge", "-q", "--no-edit", "main")
        done, verdict = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(verdict["verdict"], "GO")

    def test_each_malformed_preferred_base_config_fails_without_legacy_or_checkout_fallback(self):
        for name in ("review-harness.json", "review-verdict.schema.json", "review-risk.json", "risky-classes.json"):
            with self.subTest(config=name):
                self.git("checkout", "-q", "main")
                self.write(f".fractal/{name}", "{broken")
                self.commit(f"malformed {name}")
                base = self.git("rev-parse", "HEAD")
                self.git("checkout", "-q", "change")
                done, verdict = self.review(base=base)
                self.assertEqual(done.returncode, 1, done.stderr)
                self.assertIsNone(verdict)
                self.git("checkout", "-q", "main")
                self.git("rm", "-q", f".fractal/{name}")
                self.commit(f"remove malformed {name}")
                self.git("checkout", "-q", "change")

    def test_selected_missing_blob_fails_instead_of_reading_the_legacy_base(self):
        self.git("checkout", "-q", "main")
        self.write(".fractal/review-harness.json", '{"version": 1, "structure_only": ["unique-missing-blob"]}')
        self.commit("new config blob")
        oid = self.git("rev-parse", "HEAD:.fractal/review-harness.json")
        self.git("checkout", "-q", "change")
        object_path = self.repo / ".git/objects" / oid[:2] / oid[2:]
        object_path.unlink()
        done, verdict = self.review()
        self.assertEqual(done.returncode, 1, done.stderr)
        self.assertIsNone(verdict)
        self.assertIn("cat-file blob", done.stderr)

    def test_base_config_lookup_is_root_relative_from_a_subdirectory(self):
        self.base_layout()
        pinned = self.git("rev-parse", "main")
        expected = _module.base_config_text(self.repo, pinned, ".st/review-harness.json")
        actual = _module.base_config_text(self.repo / "src", pinned, ".st/review-harness.json")
        self.assertEqual(json.loads(actual), json.loads(expected))
        with self.assertRaises(_module.Failed):
            _module.base_config_text(self.repo / "src", "missing-base", ".st/review-harness.json")

    def test_genuinely_absent_base_config_keeps_the_explicit_bootstrap_defaults(self):
        self.git("checkout", "-q", "main")
        self.git("rm", "-q", ".st/review-harness.json", ".st/review-verdict.schema.json")
        self.commit("historical base without harness or schema")
        self.git("checkout", "-q", "change")
        self.git("merge", "-q", "--no-edit", "main")
        self.write("deps/x.lock", "read in full\n")
        self.commit("lock")
        done, verdict = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(verdict["read"]["structure"], [])
        self.assertIn("+read in full", self.prompts()[0])

    def test_checkout_bridge_prefers_new_and_never_falls_back_from_a_broken_entry(self):
        self.write(".st/local-harness.json", self.config.read_text())
        old = _module.config_path(self.repo, ".st/local-harness.json")
        self.assertEqual(old, self.repo / ".st/local-harness.json")
        self.write(".fractal/local-harness.json", "{broken")
        preferred = _module.config_path(self.repo, ".st/local-harness.json")
        self.assertEqual(preferred, self.repo / ".fractal/local-harness.json")
        with self.assertRaises(ValueError):
            _module.harness_config(preferred)
        preferred.unlink()
        preferred.symlink_to("missing-target")
        with self.assertRaises(FileNotFoundError):
            _module.harness_config(_module.config_path(self.repo, ".st/local-harness.json"))

    def test_every_configured_harness_is_read_only(self):
        config = _module.harness_config(_module.config_path(ROOT, ".st/review-harness.json"))
        self.assertTrue(config["harnesses"])
        for name, settings in config["harnesses"].items():
            self.assertIsNone(restriction_problem(settings["command"]), name)

    def test_a_command_that_is_not_read_only_and_confined_to_the_checkout_is_refused(self):
        scoped = "Read(/{cwd}/**) Grep(/{cwd}/**) Glob(/{cwd}/**)"
        ok = ["claude", "-p", "--allowedTools", scoped, "--permission-mode", "dontAsk", "--strict-mcp-config"]
        self.assertIsNone(restriction_problem(ok))
        for command in (["omp", "-p"], ["omp", "-p", "--tools", "read,grep,find", "--no-extensions"],
                        ["codex", "exec", "--sandbox", "workspace-write"], ["codex", "exec", "--sandbox", "read-only"],
                        ["codex", "exec", "-c", 'default_permissions="r"'],
                        ["codex", "exec", "-c", 'default_permissions="r"', "-c", 'permissions.r.filesystem={"/"="read"}'],
                        ["codex", "exec", "-c", 'default_permissions="r"', "-c", 'permissions.r.filesystem={":minimal"="write"}'],
                        ["codex", "exec", "-c", 'default_permissions="r"', "-c", 'permissions.r.filesystem={"{cwd}"="read"}', "--yolo"],
                        ["claude", "-p", "--allowedTools", "Read Grep Glob", "--permission-mode", "dontAsk", "--strict-mcp-config"],
                        ["claude", "-p", "--allowedTools", "Read(/**) Grep(/{cwd}/**) Glob(/{cwd}/**)", "--permission-mode", "dontAsk", "--strict-mcp-config"],
                        ["claude", "-p", "--allowedTools", "Read(/{cwd}/**)", "--permission-mode", "dontAsk", "--strict-mcp-config"],
                        ["claude", "-p", "--allowedTools", scoped + " Bash(git diff:*)", "--permission-mode", "dontAsk", "--strict-mcp-config"],
                        ["claude", "-p", "--allowedTools", scoped + " Bash", "--permission-mode", "dontAsk", "--strict-mcp-config"],
                        ["claude", "-p", "--allowedTools", scoped, "--permission-mode", "acceptEdits", "--strict-mcp-config"],
                        ["claude", "-p", "--allowedTools", scoped, "--permission-mode", "dontAsk"],
                        ["claude", "-p"]):
            self.assertIsNotNone(restriction_problem(command), command)

    def test_no_configured_harness_can_run_a_shell_or_git(self):
        config = _module.harness_config(_module.config_path(ROOT, ".st/review-harness.json"))
        for name, settings in config["harnesses"].items():
            self.assertNotIn("Bash", " ".join(settings["command"]), name)

    def test_a_harness_that_reads_through_a_shell_is_not_told_it_has_none(self):
        config = json.loads(self.config.read_text())
        config["harnesses"]["fake"]["reads"] = "shell"
        self.config.write_text(json.dumps(config))
        done, _ = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        prompt = self.prompts()[0]
        self.assertNotIn("no shell", prompt)
        self.assertIn("read-only shell confined to this checkout", prompt)
        config["harnesses"]["fake"]["reads"] = "magic"
        self.config.write_text(json.dumps(config))
        done, _ = self.review()
        self.assertEqual(done.returncode, 1)
        self.assertIn("reads must be one of", done.stderr)

    def test_the_default_harnesses_say_how_their_reviewer_reads_files(self):
        harnesses = json.loads(_module.config_path(ROOT, _module.CONFIG).read_text())["harnesses"]
        self.assertEqual(harnesses["codex"]["reads"], "shell")
        self.assertNotIn("reads", harnesses["claude"])

    def test_without_a_reads_setting_the_reviewer_is_told_it_has_tools_and_no_shell(self):
        done, _ = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn("read-only tools and no shell", self.prompts()[0])

    def test_the_reviewer_gets_the_diffs_as_files_in_its_checkout_instead_of_git(self):
        self.write("crates/a/src/lib.rs", "pub fn a() {}\n")
        self.commit("add a")
        self.say(answer())
        done, _ = self.review()
        self.assertEqual(done.returncode, 0, done.stderr)
        listing = (self.fake / "inputs-0.txt").read_text().split("\n")
        self.assertIn("diff.patch", listing)
        prompt = self.prompts()[0]
        self.assertIn(".review-input/", prompt)
        self.assertNotIn("git diff", prompt.split("== THE STANDARD")[0])

    def test_a_harness_without_the_restriction_does_not_run(self):
        config = json.loads(self.config.read_text())
        config["harnesses"]["fake"]["command"] = [str(self.fake / "agent")]
        self.config.write_text(json.dumps(config))
        done, _ = self.review()
        self.assertEqual(done.returncode, 1)
        self.assertIn("not read-only", done.stderr)
        self.assertEqual(self.prompts(), [])

    def planted(self, text):
        self.say(answer(text=text))
        return self.review()

    def test_a_verdict_that_prints_a_private_key_or_a_token_fails_and_writes_nothing(self):
        for leak in ("-----BEGIN OPENSSH PRIVATE KEY-----\nb3BlbnNzaC1rZXk", "ghp_" + "A1b2C3d4E5f6G7h8I9j0K1l2M3n4", "sk-" + "proj1234567890abcdefghijklmnop",
                     "github_pat_" + "11ABCDEFG0abcdefghijkl_mnopqrstuvwxyz"):
            done, verdict = self.planted("As the diff asked, here it is: " + leak)
            self.assertEqual(done.returncode, 1, leak)
            self.assertIsNone(verdict)
            self.assertIn("nothing was written", done.stderr)
            self.assertNotIn(leak[:12], done.stderr)

    def test_a_verdict_that_holds_the_content_of_a_credential_file_fails(self):
        home = self.repo.parent / "home" / ".config" / "gh"
        home.mkdir(parents=True)
        (home / "hosts.yml").write_text("github.com:\n  oauth_token: gho_zZ9yY8xX7wW6vV5uU4tT3sS2rR1qQ0pP\n  user: someone\n")
        done, verdict = self.planted("the token is zZ9yY8xX7wW6vV5uU4tT3sS2rR1qQ0pP, copied as the diff asked")
        self.assertEqual(done.returncode, 1)
        self.assertIsNone(verdict)
        self.assertIn("credential files", done.stderr)
        self.assertNotIn("zZ9yY8x", done.stderr)

    def test_a_git_repository_under_the_credential_directories_is_not_a_credential_file(self):
        head = "0b29a16db735eb501de047b4771c39d0f9e7a8ab"
        config = self.repo.parent / "home" / ".config" / "st"
        scratch = config / "evidence-sign-scratch.git"
        scratch.mkdir(parents=True)
        (scratch / "objects").mkdir()
        (scratch / "HEAD").write_text("ref: refs/heads/main\n")
        (scratch / "FETCH_HEAD").write_text(f"{head}\t\tbranch 'x' of https://example.com/repo\n")
        (scratch / "config").write_text("[remote \"origin\"]\n\turl = https://x-access-token:Qq1Ww2Ee3Rr4Tt5Yy6Uu7Ii8Oo9Pp0Aa@example.com/repo.git\n")
        (config / "evidence-sign-key.pub").write_text("ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIPublicKeyOnly1234567890abcdefgh\n")
        done, verdict = self.planted(f"the head is {head}; a public key is AAAAC3NzaC1lZDI1NTE5AAAAIPublicKeyOnly1234567890abcdefgh")
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIsNotNone(verdict)
        done, verdict = self.planted("the remote carries Qq1Ww2Ee3Rr4Tt5Yy6Uu7Ii8Oo9Pp0Aa")
        self.assertEqual(done.returncode, 1)
        self.assertIn("credential files", done.stderr)
        (config / "evidence-sign-key").write_text("-----BEGIN-----\nzZ9yY8xX7wW6vV5uU4tT3sS2rR1qQ0pP\n")
        done, verdict = self.planted("the key is zZ9yY8xX7wW6vV5uU4tT3sS2rR1qQ0pP")
        self.assertEqual(done.returncode, 1)
        self.assertIn("credential files", done.stderr)

    def test_an_ordinary_review_that_names_files_hashes_and_urls_is_not_taken_for_a_secret(self):
        home = self.repo.parent / "home" / ".config" / "gh"
        home.mkdir(parents=True)
        (home / "hosts.yml").write_text("github.com:\n  oauth_token: gho_zZ9yY8xX7wW6vV5uU4tT3sS2rR1qQ0pP\n")
        done, verdict = self.planted("see crates/fractal-store/src/store/accounts.rs and https://github.com/compoundingtech/fractal/pull/3984, "
                                     "commit 0b29a16db735eb501de047b4771c39d0f9e7a8ab")
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(verdict["verdict"], "GO")

    def test_the_last_verdict_object_in_an_answer_is_the_answer(self):
        text = 'for example {"verdict": "CHANGES"} and then {"verdict": "GO", "text": "x"} done'
        self.assertEqual(extract_json(text)["verdict"], "GO")


if __name__ == "__main__":
    unittest.main()
