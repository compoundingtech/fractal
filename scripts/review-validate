#!/usr/bin/env python3
"""Check a review verdict against .st/review-verdict.schema.json and the rules a schema cannot say.

  review-validate VERDICT.json [--schema FILE]     exit 0 when it parses and validates; otherwise print every problem, exit 1

The schema language is the subset the schema uses (type, enum, required, properties, additionalProperties, items, minItems,
minLength, pattern, minimum, maximum, $ref into #/definitions), so nothing outside the standard library is needed. Then:
risk.final is the higher of risk.deterministic.level and risk.llm.level; a GO has no blocking finding and a CHANGES has at least one;
a round after the first answers an earlier finding with a change.
"""
import argparse
import json
from pathlib import Path
import re
import sys
sys.dont_write_bytecode = True

SCHEMA = Path(__file__).resolve().parent.parent / ".st/review-verdict.schema.json"
ORDER = {"low": 0, "medium": 1, "high": 2}
TYPES = {
    "object": lambda value: isinstance(value, dict),
    "array": lambda value: isinstance(value, list),
    "string": lambda value: isinstance(value, str),
    "integer": lambda value: isinstance(value, int) and not isinstance(value, bool),
    "boolean": lambda value: isinstance(value, bool),
}


def resolve(root, reference):
    if not reference.startswith("#/"):
        raise ValueError(f"unsupported $ref {reference!r}")
    node = root
    for part in reference[2:].split("/"):
        node = node[part]
    return node


def check(root, schema, value, where, problems):
    if "$ref" in schema:
        schema = resolve(root, schema["$ref"])
    if "enum" in schema and value not in schema["enum"]:
        problems.append(f"{where}: {value!r} is not one of {schema['enum']}")
        return
    kind = schema.get("type")
    if kind and not TYPES[kind](value):
        problems.append(f"{where}: expected {kind}, got {type(value).__name__}")
        return
    if isinstance(value, str):
        if len(value) < schema.get("minLength", 0):
            problems.append(f"{where}: shorter than {schema['minLength']}")
        if "pattern" in schema and not re.search(schema["pattern"], value):
            problems.append(f"{where}: {value!r} does not match {schema['pattern']}")
    if isinstance(value, int) and not isinstance(value, bool):
        if "minimum" in schema and value < schema["minimum"]:
            problems.append(f"{where}: {value} is below {schema['minimum']}")
        if "maximum" in schema and value > schema["maximum"]:
            problems.append(f"{where}: {value} is above {schema['maximum']}")
    if isinstance(value, list):
        if len(value) < schema.get("minItems", 0):
            problems.append(f"{where}: fewer than {schema['minItems']} items")
        for index, item in enumerate(value):
            if "items" in schema:
                check(root, schema["items"], item, f"{where}[{index}]", problems)
    if isinstance(value, dict):
        for name in schema.get("required", []):
            if name not in value:
                problems.append(f"{where}: {name} is missing")
        properties = schema.get("properties", {})
        extra = schema.get("additionalProperties", True)
        for name, item in value.items():
            if name in properties:
                check(root, properties[name], item, f"{where}.{name}", problems)
            elif extra is False:
                problems.append(f"{where}: unexpected {name}")
            elif isinstance(extra, dict):
                check(root, extra, item, f"{where}.{name}", problems)


def semantic(verdict, problems):
    risk = verdict["risk"]
    floor = max(risk["deterministic"]["level"], risk["llm"]["level"], key=ORDER.get)
    if risk["final"] != floor:
        problems.append(f"risk.final: {risk['final']!r} is not the higher of the two scores ({floor!r})")
    for reason in risk["deterministic"]["reasons"]:
        if ORDER[reason["level"]] > ORDER[risk["deterministic"]["level"]]:
            problems.append(f"risk.deterministic: level {risk['deterministic']['level']!r} is lower than the reason {reason['rule']!r} ({reason['level']!r})")
    blocking = [finding for finding in verdict["findings"] if finding["severity"] == "blocking"]
    if verdict["verdict"] == "GO" and blocking:
        problems.append(f"verdict: GO with {len(blocking)} blocking finding(s)")
    if verdict["verdict"] == "CHANGES" and not blocking:
        problems.append("verdict: CHANGES without a blocking finding")
    if verdict["round"] > 1 and not verdict.get("answers"):
        problems.append("answers: a round after the first must say which change answers which finding")


def validate(verdict, schema):
    problems = []
    check(schema, schema, verdict, "verdict", problems)
    if not problems:
        semantic(verdict, problems)
    return problems


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("verdict", type=Path)
    parser.add_argument("--schema", type=Path, default=SCHEMA)
    args = parser.parse_args()
    try:
        verdict = json.loads(args.verdict.read_text())
    except (OSError, ValueError) as error:
        print(f"review-validate: {args.verdict} does not parse: {error}", file=sys.stderr)
        return 1
    problems = validate(verdict, json.loads(args.schema.read_text()))
    for problem in problems:
        print(f"review-validate: {problem}", file=sys.stderr)
    return 1 if problems else 0


if __name__ == "__main__":
    raise SystemExit(main())
