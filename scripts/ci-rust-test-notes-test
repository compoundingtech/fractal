#!/usr/bin/env python3
"""scripts/ci-rust-test-notes: CI's per-crate rust-tests notes from the test shards' JUnit reports (docs/per-crate-test-signing.md, 14).

Each rule is tested on a small workspace built here, signed with a throwaway fleet/ci key, published and judged by the real verifier
with the repository's own rust-tests policy entry; the workflow wiring is read from the generated .github/workflows/fleet.yml."""
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import unittest
from unittest import mock

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
from evidence_test_support import clean_loader_environment, tool_path  # noqa: E402

ROOT = Path(__file__).resolve().parent.parent
DATE = '2026-10-14T12:00:00Z'
GIT_ENV = dict({k: v for k, v in os.environ.items() if not k.startswith(('GIT_', 'GITHUB_', 'RUNNER_'))},
               GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_SYSTEM='/dev/null', LC_ALL='C', GIT_AUTHOR_NAME='t',
               GIT_AUTHOR_EMAIL='t@example.invalid', GIT_COMMITTER_NAME='t', GIT_COMMITTER_EMAIL='t@example.invalid',
               GIT_AUTHOR_DATE=DATE, GIT_COMMITTER_DATE=DATE)
# What the note job takes from the base commit: the scripts it runs, side by side.
BASE_SCRIPTS = ('ci-rust-test-notes', 'ci-rust-test-result', 'rust-test-keys', 'evidence-verify', 'evidence-wrap', 'evidence-sign',
                'evidence-publish')
SHARDS = ('linux-tests', 'linux-tests-shard-2', 'linux-tests-shard-3', 'linux-tests-shard-4')
TOOLCHAIN = hashlib.sha256(b'/nix/store/example-dev-shell.drv').hexdigest()
SYSTEM = ' '.join(subprocess.run(['uname', '-sm'], capture_output=True, text=True).stdout.split())
QUEUE = {'GITHUB_EVENT_NAME': 'merge_group', 'GITHUB_REF': 'refs/heads/gh-readonly-queue/main/pr-7-abc'}


def load(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(path))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


notes = load('ci_rust_test_notes', ROOT / 'scripts/ci-rust-test-notes')


def git(repo, *args):
    done = subprocess.run(['git', '-C', str(repo), *args], capture_output=True, env=GIT_ENV)
    assert done.returncode == 0, (args, done.stderr.decode())
    return done.stdout.decode().strip()


def junit(cases):
    """A nextest-shaped JUnit report: {suite: {case: status}}, status pass, FAIL, flaky, retried-fail or skip."""
    body = []
    for suite, tests in cases.items():
        body.append(f'<testsuite name="{suite}" tests="{len(tests)}">')
        for case, status in tests.items():
            inner = {'pass': '', 'skip': '<skipped/>', 'FAIL': '<failure type="test failure"/>',
                     'flaky': '<flakyFailure type="test failure"/>', 'retried-fail': '<failure/><rerunFailure/>'}[status]
            body.append(f'<testcase name="{case}" classname="{suite}">{inner}</testcase>')
        body.append('</testsuite>')
    return '<?xml version="1.0" encoding="UTF-8"?>\n<testsuites name="nextest-run">' + ''.join(body) + '</testsuites>\n'


class Fixture(unittest.TestCase):
    """A workspace on `main` (the base) with its origin, the base's scripts in a separate directory, a fleet/ci signer and shard reports."""

    CRATES = {'alpha': '', 'beta': '[dependencies]\nalpha = { path = "../alpha" }\n', 'empty': '', 'idle': ''}

    def setUp(self):
        clean_loader_environment()
        self.tmp = Path(tempfile.mkdtemp(prefix='ci-rust-test-notes-'))
        self.addCleanup(shutil.rmtree, self.tmp, True)
        key = self.tmp / 'key'
        subprocess.run(['ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-C', 'fleet/ci', '-f', str(key)], check=True)
        pub = key.with_suffix('.pub').read_text().split()
        self.home = self.tmp / 'home'
        (self.home / '.config/st').mkdir(parents=True)
        (self.home / '.config/st/evidence-sign.json').write_text(json.dumps(
            {'signer': 'fleet/ci', 'ssh_key': str(key), 'scratch_repo': str(self.tmp / 'scratch.git'), 'test_clock': True, 'path': tool_path()}))
        self.origin = self.tmp / 'origin.git'
        git(self.tmp, 'init', '-q', '--bare', '-b', 'main', str(self.origin))
        self.work = self.tmp / 'work'
        git(self.tmp, 'clone', '-q', str(self.origin), str(self.work))
        git(self.work, 'checkout', '-q', '-b', 'main')
        self.write('Cargo.toml', '[workspace]\nmembers = [' + ', '.join(f'"crates/{name}"' for name in self.CRATES) + ']\n')
        self.write('Cargo.lock', 'lock\n')
        self.write('flake.lock', '{"nodes":{}}\n')
        for name, deps in self.CRATES.items():
            self.write(f'crates/{name}/Cargo.toml', f'[package]\nname = "{name}"\nversion = "0.1.0"\n{deps}')
            self.write(f'crates/{name}/src/lib.rs', f'// {name}\n')
        self.write('.st/rust-test-inputs.json', json.dumps({'global': ['Cargo.toml', 'Cargo.lock'], 'crates': {name: {'extra': []} for name in self.CRATES},
                                                            'no_tests': ['empty']}))
        policy = json.loads((ROOT / '.st/evidence-skip-policy.json').read_text())
        self.write('.st/evidence-skip-policy.json', json.dumps({'version': 1, 'checks': {'rust-tests': policy['checks']['rust-tests']}}))
        self.write('.st/evidence-keys', f'fleet/ci namespaces="git" {pub[0]} {pub[1]}\n')
        for script in BASE_SCRIPTS:
            self.write(f'scripts/{script}', (ROOT / 'scripts' / script).read_text())
        git(self.work, 'add', '-A')
        git(self.work, 'commit', '-q', '-m', 'base')
        git(self.work, 'push', '-q', 'origin', 'main')
        self.base = git(self.work, 'rev-parse', 'HEAD')
        # The scripts the job runs come from the base commit, outside the checkout ($RUNNER_TEMP/evidence-base/scripts).
        self.scripts = self.tmp / 'evidence-base/scripts'
        self.scripts.mkdir(parents=True)
        for script in BASE_SCRIPTS:
            shutil.copy(ROOT / 'scripts' / script, self.scripts / script)
        self.reports = self.tmp / 'rust-test-junit'
        self.plan_dir = self.tmp / 'rust-test-plan'
        self.notes_dir = self.tmp / 'rust-test-notes'

    def write(self, path, text):
        full = self.work / path
        full.parent.mkdir(parents=True, exist_ok=True)
        full.write_text(text)

    def shard(self, job, partition, cases, attempt=1, outcome='success', meta=None):
        directory = self.reports / f'rust-test-junit-{job}-{attempt}'
        directory.mkdir(parents=True, exist_ok=True)
        (directory / 'junit.xml').write_text(junit(cases))
        described = {'job': job, 'partition': partition, 'run_attempt': str(attempt), 'nextest_outcome': outcome,
                     'toolchain_sha256': TOOLCHAIN, 'system': SYSTEM}
        described.update(meta or {})
        (directory / 'shard.json').write_text(json.dumps(described))
        return directory

    def queue_shards(self, *cases, attempt=1):
        """The four merge-group shards, the i-th with cases[i] (missing ones run nothing of these crates)."""
        for index, job in enumerate(SHARDS):
            self.shard(job, f'hash:{index + 1}/4', cases[index] if index < len(cases) else {}, attempt=attempt)

    @staticmethod
    def needs(results=None, skips=None, event='merge_group'):
        found = {job: 'success' for job in SHARDS}
        if event != 'merge_group':
            found.update({'linux-tests-shard-3': 'skipped', 'linux-tests-shard-4': 'skipped'})
        found.update(results or {})
        found = {job: {'result': result, 'outputs': {}} for job, result in found.items()}
        for gate in ('linux-gate', 'rust-tests'):
            found[f'evidence-gate-{gate}'] = {'result': 'success', 'outputs': {'skip': str((skips or {}).get(gate, False)).lower()}}
        return found

    def environment(self, attempt='1', **extra):
        found = dict(GIT_ENV, HOME=str(self.home), EVIDENCE_SIGN_NOW=DATE, GITHUB_RUN_ATTEMPT=attempt, GITHUB_RUN_ID='42',
                     GITHUB_REPOSITORY='org/repo', GITHUB_WORKFLOW='Workspace CI', BASE_SHA=self.base, NEEDS_JSON=json.dumps(self.needs()), **QUEUE)
        found.update(extra)
        return found

    def run_notes(self, *args, env=None):
        return subprocess.run([sys.executable, str(self.scripts / 'ci-rust-test-notes'), *args], cwd=self.work, capture_output=True, text=True,
                              env=env or self.environment())

    def plan(self, env=None):
        done = self.run_notes('plan', '--reports', str(self.reports), '--out', str(self.plan_dir), env=env)
        planned = json.loads((self.plan_dir / 'plan.json').read_text()) if done.returncode == 0 else None
        return done, planned

    def planned(self, env=None):
        done, planned = self.plan(env)
        self.assertEqual(done.returncode, 0, done.stdout + done.stderr)
        return planned

    def sign_and_publish(self, env=None):
        signed = self.run_notes('sign', '--plan', str(self.plan_dir), '--out', str(self.notes_dir), env=env)
        if not self.notes_dir.exists():
            return signed, None
        published = subprocess.run([sys.executable, str(self.scripts / 'evidence-publish'), '--notes', str(self.notes_dir), '--keys',
                                    str(self.work / '.st/evidence-keys'), '--checks', 'rust-tests', '--limit', '400', '--remote', 'origin'],
                                   cwd=self.work, capture_output=True, text=True, env=env or self.environment())
        return signed, published

    def members(self, repo=None):
        """The verifier's --members judgement of the tested tree, with the base's policy, keys and rust-test-keys, as the gate asks it."""
        done = subprocess.run([sys.executable, str(self.scripts / 'evidence-verify'), '--repo', str(repo or self.work), '--tree',
                               git(self.work, 'rev-parse', 'HEAD^{tree}'), '--check', 'rust-tests', '--keys-from', self.base, '--members',
                               '--policy-from', self.base, '--repository', 'org/repo'], capture_output=True, text=True, env=GIT_ENV)
        return json.loads(done.stdout)

    def statements(self, repo=None):
        repo = repo or self.work
        found = []
        for ref in git(repo, 'for-each-ref', '--format=%(refname)', 'refs/notes/evidence/').splitlines():
            blob = git(repo, 'ls-tree', '-r', ref).split()[2]
            found.append(json.loads(git(repo, 'cat-file', 'blob', blob)))
        return found

    # A run in which every crate passes: alpha split across two shards, beta in one, empty and idle with no test (only empty is listed).
    GREEN = ({'alpha': {'a1': 'pass', 'a2': 'pass'}, 'beta::bin/beta': {'b1': 'pass'}},
             {'alpha': {'a3': 'pass', 'ignored': 'skip'}, 'idle-tools::x': {'other': 'pass'}})


class Rule1SigningEvents(Fixture):
    def test_only_the_queue_main_pushes_and_manual_runs_on_main_may_sign(self):
        allowed = [('merge_group', 'refs/heads/gh-readonly-queue/main/pr-1-abc'), ('push', 'refs/heads/main'), ('workflow_dispatch', 'refs/heads/main')]
        refused = [('pull_request', 'refs/pull/7/merge'), ('workflow_dispatch', 'refs/heads/feature'), ('push', 'refs/heads/feature'),
                   ('merge_group', 'refs/heads/main'), ('schedule', 'refs/heads/main'), ('pull_request_target', 'refs/heads/main'), ('', '')]
        for event, ref in allowed + refused:
            done = self.run_notes('guard', env=self.environment(GITHUB_EVENT_NAME=event, GITHUB_REF=ref))
            self.assertEqual(done.returncode, 0 if (event, ref) in allowed else 1, (event, ref, done.stdout))

    def test_a_pull_request_run_plans_nothing_and_signs_nothing_even_with_perfect_reports(self):
        self.queue_shards(*self.GREEN)
        pr = self.environment(GITHUB_EVENT_NAME='pull_request', GITHUB_REF='refs/pull/7/merge')
        done, planned = self.plan(pr)
        self.assertEqual(done.returncode, 1)
        self.assertIn('never for a pull request', done.stdout)
        self.assertIsNone(planned)
        self.planned()  # the same reports in the queue do plan
        signed, published = self.sign_and_publish(pr)
        self.assertEqual(signed.returncode, 1)
        self.assertIsNone(published, 'nothing was written')
        self.assertEqual(self.statements(), [])

    def test_the_workflow_runs_the_note_job_and_uploads_reports_only_for_signing_events(self):
        blocks = workflow_blocks()
        job = blocks['evidence-note-rust-tests']
        condition = re.search(r'^    if: (.*)$', job, re.M).group(1)
        self.assertIn("!cancelled() && (github.event_name == 'merge_group' || (github.event_name == 'push' && github.ref == 'refs/heads/main') || "
                      "(github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/main'))", condition)
        # The only mention of a pull request is the generator's draft guard, which never admits one on its own.
        self.assertEqual(condition.replace("(github.event_name != 'pull_request' || github.event.pull_request.draft == false) && ", '').count('pull_request'), 0)
        for event in ('pull_request', 'merge_group', 'push', 'workflow_dispatch', 'schedule'):
            for ref in ('refs/heads/main', 'refs/pull/1/merge', 'refs/heads/gh-readonly-queue/main/x'):
                self.assertEqual(evaluate(condition, event, ref), event in ('merge_group', 'push', 'workflow_dispatch') and
                                 (event == 'merge_group' or ref == 'refs/heads/main'), (event, ref))
        # The key arrives only through the evidence-signing environment, by the same expression as every other signing job.
        self.assertIn("&& 'evidence-signing' || '' }}", re.search(r'^    environment: (.*)$', job, re.M).group(1))
        for name in SHARDS:
            # The report is written on every run (a pull request's own jobs show nextest writes it on the archive path) ...
            self.assertIn('continue-on-error: true', step_chunk(blocks[name], 'Make room for the JUnit report'), name)
            self.assertIsNone(re.search(r'^        if: ', step_chunk(blocks[name], 'Make room for the JUnit report'), re.M), name)
            junit_path = re.search(r'^          CI_TEST_JUNIT: (.*)$', step_chunk(blocks[name], 'Run nextest'), re.M).group(1)
            self.assertEqual(junit_path.strip('"\''), "${{ format('{0}/rust-test-junit/junit.xml', runner.temp) }}", name)
            # ... but it is described and uploaded only on the signing events.
            for step in ('Describe the JUnit report for the per-crate notes', 'Retain the JUnit report for the per-crate notes'):
                chunk = step_chunk(blocks[name], step)
                self.assertIn('continue-on-error: true', chunk, (name, step))
                guard = re.search(r'^        if: (.*)$', chunk, re.M).group(1)
                self.assertFalse(evaluate(guard, 'pull_request', 'refs/pull/1/merge'), (name, step))
                self.assertTrue(evaluate(guard, 'merge_group', 'refs/heads/gh-readonly-queue/main/x'), (name, step))


class Rule2PerCrateUnion(Fixture):
    def test_one_record_per_crate_from_the_union_of_all_shards(self):
        self.queue_shards(*self.GREEN)
        planned = self.planned()
        crates = {entry['crate']: entry for entry in planned['crates']}
        self.assertEqual(sorted(crates), ['alpha', 'beta', 'empty'])
        self.assertEqual(crates['alpha']['tests_run'], '3', 'a crate split across shards is counted once, from all of them')
        self.assertEqual(crates['alpha']['tests_ignored'], '1')
        self.assertEqual(crates['empty']['tests_run'], '0')
        self.assertEqual(planned['excluded'], {'idle': 'it ran no test and is not listed under no_tests'},
                         'a suite named idle-tools is not idle\'s, and idle ran nothing')
        self.assertEqual(planned['partitions'], ['hash:1/4', 'hash:2/4', 'hash:3/4', 'hash:4/4'])
        # The facts are the ones ci-rust-test-result gives over the union report, as fractal-test records them.
        union = self.plan_dir / 'junit.xml'
        summary = json.loads(subprocess.run([sys.executable, str(ROOT / 'scripts/ci-rust-test-result'), '--summary'], capture_output=True, text=True,
                                            env=dict(GIT_ENV, RUST_TEST_JUNIT=str(union), RUST_TEST_CRATE='alpha')).stdout)
        self.assertEqual({k: str(v) for k, v in summary.items()}, {k: crates['alpha'][k] for k in summary})

    def test_a_crate_that_passes_in_one_shard_and_fails_in_another_is_not_signed(self):
        self.queue_shards({'alpha': {'a1': 'pass'}, 'beta': {'b1': 'pass'}}, {}, {'alpha': {'a2': 'FAIL'}})
        planned = self.planned()
        self.assertEqual([entry['crate'] for entry in planned['crates']], ['beta', 'empty'])
        self.assertEqual(planned['excluded']['alpha'], '1 test(s) failed')

    def test_outside_a_merge_group_the_two_pull_request_shards_are_the_whole_run(self):
        env = self.environment(GITHUB_EVENT_NAME='workflow_dispatch', GITHUB_REF='refs/heads/main',
                               NEEDS_JSON=json.dumps(self.needs(event='workflow_dispatch')))
        self.shard('linux-tests', 'hash:1/2', self.GREEN[0])
        self.shard('linux-tests-shard-2', 'hash:2/2', self.GREEN[1])
        planned = self.planned(env)
        self.assertEqual([entry['crate'] for entry in planned['crates']], ['alpha', 'beta', 'empty'])
        self.assertEqual(planned['partitions'], ['hash:1/2', 'hash:2/2'])
        # A merge-only shard that did run outside a merge group is not this event's matrix: nothing.
        needs = self.needs(event='workflow_dispatch')
        needs['linux-tests-shard-3']['result'] = 'success'
        done, _ = self.plan(dict(env, NEEDS_JSON=json.dumps(needs)))
        self.assertEqual(done.returncode, 1)
        self.assertIn('merge-only shards must be skipped', done.stdout)


class Rule3NothingFromPartialData(Fixture):
    def refused(self, why, env=None):
        done, planned = self.plan(env)
        self.assertEqual(done.returncode, 1, done.stdout + done.stderr)
        self.assertIsNone(planned)
        self.assertIn(why, done.stdout)
        signed, published = self.sign_and_publish(env)
        self.assertNotEqual(signed.returncode, 0)
        self.assertIsNone(published)
        self.assertEqual(self.statements(), [])

    def test_a_gate_that_skipped_the_test_jobs_signs_nothing(self):
        self.queue_shards(*self.GREEN)
        for gate in ('linux-gate', 'rust-tests'):
            with self.subTest(gate):
                self.refused(f'evidence-gate-{gate} decided to skip', self.environment(NEEDS_JSON=json.dumps(self.needs(skips={gate: True}))))
        needs = self.needs()
        del needs['evidence-gate-rust-tests']
        self.refused('evidence-gate-rust-tests is not among the needed jobs', self.environment(NEEDS_JSON=json.dumps(needs)))

    def test_any_shard_that_did_not_succeed_signs_nothing_for_any_crate(self):
        self.queue_shards(*self.GREEN)
        for result in ('failure', 'cancelled', 'skipped'):
            with self.subTest(result):
                self.refused(f'linux-tests-shard-3={result}', self.environment(NEEDS_JSON=json.dumps(self.needs({'linux-tests-shard-3': result}))))

    def test_a_missing_or_cut_short_or_foreign_report_signs_nothing(self):
        self.queue_shards(*self.GREEN)
        shutil.rmtree(self.reports / 'rust-test-junit-linux-tests-shard-4-1')
        self.refused('no JUnit report of attempt 1 from linux-tests-shard-4')
        self.shard('linux-tests-shard-4', 'hash:4/4', {})
        (self.reports / 'rust-test-junit-linux-tests-shard-4-1/junit.xml').write_text('<?xml version="1.0"?><testsuites><testsuite name="alpha">')
        self.refused('not whole')
        cases = [({'partition': 'hash:1/4'}, "partition='hash:1/4'"), ({'nextest_outcome': 'failure'}, "nextest_outcome='failure'"),
                 ({'toolchain_sha256': 'f' * 64}, 'different dev shells'), ({'system': 'Other arch'}, 'different dev shells')]
        for meta, why in cases:
            with self.subTest(meta):
                self.shard('linux-tests-shard-4', 'hash:4/4', {}, meta=meta)
                self.refused(why)
        self.shard('linux-tests-shard-4', 'hash:4/4', {})
        (self.reports / 'rust-test-junit-linux-tests-shard-4-1/shard.json').unlink()
        self.refused('no readable shard.json')

    def test_a_rerun_signs_only_from_the_reports_of_its_own_attempt(self):
        self.queue_shards(*self.GREEN)  # attempt 1
        # Attempt 2 re-ran only the failed shard: the others' reports are attempt 1's, so nothing is signed.
        self.shard('linux-tests-shard-2', 'hash:2/4', self.GREEN[1], attempt=2)
        self.refused('no JUnit report of attempt 2 from linux-tests, linux-tests-shard-3, linux-tests-shard-4', self.environment(attempt='2'))

    def test_a_test_in_two_shards_means_the_shards_do_not_partition_the_run(self):
        self.queue_shards({'alpha': {'a1': 'pass'}}, {'alpha': {'a1': 'pass'}})
        self.refused('ran in both linux-tests and linux-tests-shard-2')


class Rule4NoPassingNoteForFailedOrFlaky(Fixture):
    def test_failed_and_flaky_crates_get_no_note_while_ci_rust_test_result_still_counts_flaky_as_passed(self):
        self.queue_shards({'alpha': {'a1': 'pass', 'a2': 'flaky'}, 'beta': {'b1': 'pass'}}, {'empty::x': {}})
        planned = self.planned()
        self.assertEqual([entry['crate'] for entry in planned['crates']], ['beta', 'empty'])
        self.assertEqual(planned['excluded']['alpha'], '1 test(s) passed only on a retry')
        # scripts/ci-rust-test-result's own semantics are unchanged: for fractal-test (and nextest) a flaky test passed.
        done = subprocess.run([sys.executable, str(ROOT / 'scripts/ci-rust-test-result')], capture_output=True, text=True,
                              env=dict(GIT_ENV, RUST_TEST_JUNIT=str(self.plan_dir / 'junit.xml'), RUST_TEST_CRATE='alpha'))
        self.assertEqual(done.returncode, 0, done.stdout)
        self.assertIn('flaky alpha a2', done.stdout)
        self.queue_shards({'alpha': {'a1': 'retried-fail'}, 'beta': {'b1': 'FAIL'}})
        planned = self.planned()
        self.assertEqual(planned['excluded']['alpha'], '1 test(s) failed')
        self.assertEqual(planned['excluded']['beta'], '1 test(s) failed')

    def test_a_crate_that_failed_in_an_earlier_attempt_of_the_run_gets_no_note(self):
        self.queue_shards({'alpha': {'a1': 'FAIL'}, 'beta': {'b1': 'pass'}}, attempt=1)
        self.queue_shards({'alpha': {'a1': 'pass'}, 'beta': {'b1': 'pass'}}, attempt=2)
        planned = self.planned(self.environment(attempt='2'))
        self.assertEqual([entry['crate'] for entry in planned['crates']], ['beta', 'empty'])
        self.assertEqual(planned['excluded']['alpha'], 'a test failed or was flaky in an earlier attempt of this run')
        self.assertEqual(planned['run_attempt'], '2')


class Rule5SameKeysAndRecordsAsStTest(Fixture):
    def test_ci_and_st_test_compute_the_same_key_for_every_crate(self):
        git(self.work, 'checkout', '-q', '-b', 'feature')
        self.write('crates/beta/src/lib.rs', '// changed\n')
        git(self.work, 'commit', '-qam', 'change beta')
        tree = git(self.work, 'rev-parse', 'HEAD^{tree}')
        ci = self.keys_both(self.work, self.base, tree)
        self.assertEqual(sorted(ci), sorted(self.CRATES))
        self.assertTrue(all(re.fullmatch(r'[0-9a-f]{40}', key) for key in ci.values()), ci)

    def keys_both(self, repo, base, tree):
        st_test = load('st_test_for_ci_rust_test_notes', ROOT / 'scripts/st-test')
        scratch = Path(tempfile.mkdtemp(prefix='keys-', dir=self.tmp))
        cwd = os.getcwd()
        os.chdir(repo)
        try:
            with mock.patch.dict(os.environ, GIT_ENV, clear=True):
                expected, error = st_test.crate_keys(base, repo, tree, scratch)
                self.assertIsNone(error)
                ci = notes.crate_keys(base, tree, scratch)
        finally:
            os.chdir(cwd)
        self.assertEqual(ci, expected)
        return ci

    def test_ci_and_st_test_agree_on_this_repository_s_own_tree(self):
        head = subprocess.run(['git', '-C', str(ROOT), 'rev-parse', 'HEAD'], capture_output=True, text=True, env=GIT_ENV).stdout.strip()
        have = subprocess.run(['git', '-C', str(ROOT), 'cat-file', '-e', f'{head}:Cargo.toml'], capture_output=True, env=GIT_ENV).returncode == 0
        if not have:
            self.skipTest('a sparse copy without the workspace manifests (ci-script-tests): the fixture test covers the rule')
        tree = subprocess.run(['git', '-C', str(ROOT), 'rev-parse', 'HEAD^{tree}'], capture_output=True, text=True, env=GIT_ENV).stdout.strip()
        keys = self.keys_both(ROOT, head, tree)
        self.assertGreater(len(keys), 10)

    def test_the_records_are_accepted_by_the_verifier_exactly_like_st_test_s_and_indexed_by_key(self):
        self.queue_shards({'alpha': {'a1': 'pass'}, 'beta': {'b1': 'pass'}}, {'alpha': {'a2': 'pass'}, 'idle': {'i1': 'pass'}})
        planned = self.planned()
        self.assertEqual([entry['crate'] for entry in planned['crates']], ['alpha', 'beta', 'empty', 'idle'])
        signed, published = self.sign_and_publish()
        self.assertEqual(signed.returncode, 0, signed.stdout + signed.stderr)
        self.assertEqual(published.returncode, 0, published.stdout + published.stderr)
        result = self.members()
        # Since rust-tests is enforced (2026-10-28) its wrapper trusts host and agent notes, not CI's: every crate's CI record is
        # well formed and found by its key, and refused only for its level. The records' shape is checked against the rule below.
        self.assertEqual((result.get('satisfied'), result.get('reason')), (False, 'crate_uncovered'), result)
        for crate in ('alpha', 'beta', 'empty', 'idle'):
            self.assertIn(f'{crate} (untrusted_level)', result['detail'])
        rule = json.loads((ROOT / '.st/evidence-skip-policy.json').read_text())['checks']['rust-tests']['kinds']['wrapper']
        self.assertNotIn('fleet', rule['trust_levels'])
        keys = {entry['crate']: entry['key'] for entry in planned['crates']}
        for statement in self.statements():
            observed = statement['predicate']['observed']
            self.assertEqual(observed['checks']['rust-tests']['command'], rule['command'])
            self.assertEqual(observed['checks']['rust-tests']['exit_code'], 0)
            self.assertTrue(set(rule['required_inputs']) <= set(observed['inputs']), set(rule['required_inputs']) - set(observed['inputs']))
            self.assertEqual(observed['inputs']['filterset'], 'workspace')
            self.assertEqual(observed['inputs']['toolchain_sha256'], TOOLCHAIN)
            self.assertEqual(observed['inputs']['source_inputs'], keys[observed['inputs']['crate']])
            self.assertEqual(statement['predicate']['signer'], 'fleet/ci')
        # Published the way the other CI notes are: the tree's tag and note, and the input-keyed index refs, on the remote.
        remote = git(self.origin, 'for-each-ref', '--format=%(refname)').splitlines()
        for crate, key in keys.items():
            self.assertEqual(len([ref for ref in remote if ref.startswith(f'refs/notes/evidence-input/rust-tests/{key}/')]), 1, crate)
            self.assertEqual(len([ref for ref in remote if ref.startswith(f'refs/tags/evidence/input/rust-tests/{key}/')]), 1, crate)
        self.assertEqual(len([ref for ref in remote if ref.startswith('refs/notes/evidence/')]), 4)
        # A later tree that changes only beta finds the other crates' notes by their keys (refused for their level, as above); beta's
        # key changed, so nothing is found for it.
        git(self.work, 'checkout', '-q', '-b', 'later')
        self.write('crates/beta/src/lib.rs', '// changed\n')
        git(self.work, 'commit', '-qam', 'change beta')
        later = self.members()
        self.assertEqual(later.get('reason'), 'crate_uncovered', later)
        for crate in ('alpha', 'empty', 'idle'):
            self.assertIn(f'{crate} (untrusted_level)', later['detail'])
        self.assertNotIn('beta (untrusted_level)', later['detail'])
        self.assertIn('beta (', later['detail'])

    def test_a_signature_that_fails_is_reported_and_the_others_are_still_published(self):
        self.queue_shards({'alpha': {'a1': 'pass'}, 'beta': {'b1': 'pass'}})
        self.planned()
        config = self.home / '.config/st/evidence-sign.json'
        broken = dict(json.loads(config.read_text()), ssh_key=str(self.tmp / 'no-such-key'))
        config.write_text(json.dumps(broken))
        signed, published = self.sign_and_publish()
        self.assertEqual(signed.returncode, 1)
        self.assertIn('not signed', signed.stdout)
        self.assertEqual(self.statements(), [])

    def test_the_checkout_must_be_the_planned_commit(self):
        self.queue_shards(*self.GREEN)
        self.planned()
        git(self.work, 'commit', '-q', '--allow-empty', '-m', 'moved')
        signed, published = self.sign_and_publish()
        self.assertEqual(signed.returncode, 1)
        self.assertIn('not the commit the plan was made for', signed.stdout)


class Rule6PublishedFailSoft(unittest.TestCase):
    def test_the_note_job_is_fail_soft_takes_its_scripts_from_the_base_and_judges_before_the_key(self):
        blocks = workflow_blocks()
        job = blocks['evidence-note-rust-tests']
        self.assertTrue({*SHARDS, 'evidence-gate-linux-gate', 'evidence-gate-rust-tests'} <= needs_of(job))
        steps = re.split(r'^      - ', job.split('    steps:\n', 1)[1], flags=re.M)[1:]
        names = [re.search(r'name: (.*)', chunk).group(1) for chunk in steps]
        for chunk, name in zip(steps, names):
            if name == 'Report job cache coverage':
                continue  # the generator's cache-audit line: a printf to the summary
            self.assertIn('continue-on-error: true', chunk, name)
            for line in re.findall(r'python3 (\S+)', chunk):
                self.assertTrue(line.startswith('"$RUNNER_TEMP/evidence-base/scripts/'), (name, line))
        order = {name: index for index, name in enumerate(names)}
        self.assertLess(order['Decide which crates may be signed'], order['May this job use the signing key?'])
        self.assertLess(order['May this job use the signing key?'], order['Write the signer configuration and key'])
        self.assertLess(order['Write the signer configuration and key'], order['Sign the per-crate rust-tests notes'])
        self.assertLess(order['Sign the per-crate rust-tests notes'], order['Publish the notes that verify'])
        self.assertIn('ci-rust-test-notes" guard', step_chunk(job, 'May this job use the signing key?'))
        self.assertIn('ci-evidence-signing" guard', step_chunk(job, 'May this job use the signing key?'))
        self.assertIn("if: ${{ steps.plan.outcome == 'success' }}", step_chunk(job, 'May this job use the signing key?'))
        self.assertIn('EVIDENCE_SIGNING_KEY', step_chunk(job, 'Write the signer configuration and key'))
        self.assertEqual(job.count('secrets.EVIDENCE_SIGNING_KEY'), 1, 'only the configure step sees the key')
        self.assertIn('once rust-tests', step_chunk(job, 'Sign the per-crate rust-tests notes'))
        self.assertIn('--checks rust-tests', step_chunk(job, 'Publish the notes that verify'))
        self.assertIn("pattern: rust-test-junit-*", step_chunk(job, "Collect the test shards' JUnit reports"))
        self.assertIn('if: always()', step_chunk(job, 'Remove the key'))
        self.assertIn('git archive "$BASE_SHA" scripts', step_chunk(job, 'Take the signer scripts from the base commit'))
        # Not a required check, and nothing waits for it: a signing outage changes nothing about the gate.
        for name, block in blocks.items():
            self.assertNotIn('evidence-note-rust-tests', needs_of(block), name)
        settings = (ROOT / '.github/repo-settings.json').read_text()
        self.assertNotIn('evidence-note-rust-tests', settings)
        # The shards' reports are never collected as notes by the linux-gate note job (its pattern is evidence-note-*).
        for name in SHARDS:
            artifact = re.search(r'name: "(rust-test-junit-[^"]*)"', step_chunk(blocks[name], 'Retain the JUnit report for the per-crate notes')).group(1)
            self.assertEqual(artifact, f'rust-test-junit-{name}-${{{{ github.run_attempt }}}}')
            self.assertTrue(notes.ARTIFACT.fullmatch(artifact.replace('${{ github.run_attempt }}', '3')), artifact)
        # The rust-tests policy entry is enforced (2026-10-28): a pull request skips rust-tests on per-crate notes.
        self.assertIs(json.loads((ROOT / '.st/evidence-skip-policy.json').read_text())['checks']['rust-tests']['enforce'], True)

    def test_the_shard_partitions_are_the_workflow_s(self):
        blocks = workflow_blocks()
        for index, name in enumerate(SHARDS, 1):
            partition = re.search(r'^      CI_TEST_PARTITION: (.*)$', blocks[name], re.M).group(1)
            self.assertIn(f'hash:{index}/4', partition, name)
            if index <= 2:
                self.assertIn(f"'hash:{index}/2'", partition, name)
        self.assertEqual(notes.expected_shards('merge_group')[0], {name: f'hash:{index}/4' for index, name in enumerate(SHARDS, 1)})
        self.assertEqual(notes.expected_shards('push')[0], {'linux-tests': 'hash:1/2', 'linux-tests-shard-2': 'hash:2/2'})
        for name in ('linux-tests-shard-3', 'linux-tests-shard-4'):
            self.assertIn("github.event_name == 'merge_group'", re.search(r'^    if: (.*)$', blocks[name], re.M).group(1))


def workflow_blocks():
    workflow = (ROOT / '.github/workflows/fleet.yml').read_text()
    return dict(re.findall(r"(?ms)^  ([\w-]+):\n(.*?)(?=^  [\w-]+:\n|\Z)", workflow.split("\njobs:\n", 1)[1]))


def needs_of(block):
    found = re.search(r'^    needs:(.*?)(?=^    \S|\Z)', block, re.M | re.S)
    return set(re.findall(r'[A-Za-z][A-Za-z0-9_-]*', found.group(1))) if found else set()


def step_chunk(block, name):
    for chunk in re.split(r'^      - ', block.split('    steps:\n', 1)[1], flags=re.M)[1:]:
        if re.search(rf'(?m)^(?:        )?name: {re.escape(name)}$', chunk):
            return chunk
    raise AssertionError(f'no step {name!r}')


def evaluate(expression, event, ref):
    """A generated condition over the event and ref only (always(), !cancelled() and the draft flag read as true)."""
    text = expression.strip()
    if text.startswith('${{'):
        text = text[3:-2].strip()
    text = text.replace('github.event.pull_request.draft == false', 'True').replace('!cancelled()', 'True').replace('always()', 'True')
    text = re.sub(r"github\.event_name (==|!=) '([a-z_]+)'", lambda m: str((event == m.group(2)) == (m.group(1) == '==')), text)
    text = re.sub(r"github\.ref == '([^']+)'", lambda m: str(ref == m.group(1)), text)
    text = text.replace('&&', ' and ').replace('||', ' or ')
    assert re.fullmatch(r'[\s()]*(?:(?:True|False|and|or)[\s()]*)*', text), text
    return eval(text)  # only True, False, and, or and parentheses are left


if __name__ == '__main__':
    unittest.main()
