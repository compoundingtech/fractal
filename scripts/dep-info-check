#!/usr/bin/env python3
"""Every file a keyed stage's compiles read must be inside its check's input key (docs/keyed-clippy.md).

  python3 scripts/dep-info-check --logs DIR [--check NAME] [--jsonl GLOB] [--policy FILE] [--root DIR]

A note for a keyed check (linux-clippy, linux-fleet-compat) covers every tree with the same key, the projection of the policy's
`inputs`. A file the compiler reads that the key leaves out (an include_str! of a doc, a proc macro's wit file) would let one tree's
note cover another whose result differs. So after the stage's cargo runs, this reads the dep-info file (`.d`) of every unit those runs
reported in their JSON messages (DIR/GLOB, default clippy-*.jsonl; a unit fresh from a cache is reported too, and its dep-info still
describes this tree's inputs), keeps the dependencies inside the repository and outside the target directory, and fails on any that no
input of --check (default linux-clippy) covers (equal, or a parent directory). The last line is always
`dep-info: check=NAME units=N files=M uncovered=K`, which the daily report counts.
"""
import argparse
import json
import os
from pathlib import Path
import posixpath
import sys

POLICY = '.st/evidence-skip-policy.json'
CHECK = 'linux-clippy'
JSONL = 'clippy-*.jsonl'


def declared(policy_text, check=CHECK):
    return [path.rstrip('/') for path in json.loads(policy_text)['checks'][check]['inputs']]


def covered(path, inputs):
    return any(path == item or path.startswith(item + '/') for item in inputs)


def dep_info_files(logs, pattern=JSONL):
    """The .d file of every unit a cargo run in this stage reported (compiler-artifact messages; an artifact lib<NAME>-<HASH>.rmeta, or
    a test binary NAME-HASH, and the unit's NAME-HASH.d sit side by side in target/<profile>/deps)."""
    found = set()
    for log in sorted(Path(logs).glob(pattern)):
        for line in log.read_text(errors='replace').splitlines():
            try:
                message = json.loads(line)
            except ValueError:
                continue
            if not isinstance(message, dict) or message.get('reason') != 'compiler-artifact':
                continue
            for name in message.get('filenames') or ():
                artifact = Path(name)
                if artifact.parent.name != 'deps':
                    continue
                library = artifact.suffix in ('.rmeta', '.rlib', '.so', '.a', '.dylib') and artifact.stem.startswith('lib')
                stem = artifact.stem[3:] if library else artifact.name   # a test binary is NAME-HASH, with no lib prefix or suffix
                dep_info = artifact.parent / f'{stem}.d'
                if dep_info.exists():
                    found.add(dep_info)
    return sorted(found)


def dependencies(dep_info, root, target):
    """The repository files one dep-info file lists, relative to the root; generated files under the target directory and anything
    outside the repository (the registry, the Nix store) are not the tree's inputs."""
    out = set()
    for line in dep_info.read_text(errors='replace').splitlines():
        head, sep, rest = line.partition(': ')
        if not sep:
            continue
        for word in rest.replace('\\ ', '\0').split():
            word = word.replace('\0', ' ')
            path = Path(word) if os.path.isabs(word) else root / word
            path = Path(posixpath.normpath(str(path)))
            if path == target or target in path.parents or root not in path.parents:
                continue
            out.add(path.relative_to(root).as_posix())
    return out


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('--logs', required=True, help="the stage's log directory (scripts/ci-linux's $logs)")
    parser.add_argument('--check', default=CHECK, help=f'the check whose input key must cover what was read (default {CHECK})')
    parser.add_argument('--jsonl', default=JSONL, help=f'the cargo JSON message logs in --logs to read (default {JSONL})')
    parser.add_argument('--policy', help=f'the skip policy (default: ROOT/{POLICY})')
    parser.add_argument('--root', default=os.getcwd())
    args = parser.parse_args(argv)
    root = Path(posixpath.normpath(os.path.abspath(args.root)))
    inputs = declared(Path(args.policy or root / POLICY).read_text(), args.check)
    metadata = Path(args.logs) / 'clippy-metadata.json'
    target = Path(json.loads(metadata.read_text())['target_directory']) if metadata.exists() else root / 'target'
    target = Path(posixpath.normpath(os.path.abspath(target)))
    units = dep_info_files(args.logs, args.jsonl)
    files = set()
    for dep_info in units:
        files |= dependencies(dep_info, root, target)
    uncovered = sorted(path for path in files if not covered(path, inputs))
    for path in uncovered:
        print(f'::error::{args.check} read {path}, which its input key does not cover: add it (or a parent) to the inputs of '
              f'{args.check} in {POLICY} and the tree_inputs of its lane in .st/required-lanes.json')
    if not units:
        print(f'::error::no dep-info found for this stage\'s units ({args.jsonl}): nothing shows what {args.check} read')
    print(f'dep-info: check={args.check} units={len(units)} files={len(files)} uncovered={len(uncovered)}')
    return 1 if uncovered or not units else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
