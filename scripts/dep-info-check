#!/usr/bin/env python3
"""Every file a keyed stage's compiles read must be inside its check's input key (docs/keyed-clippy.md).

  python3 scripts/dep-info-check --logs DIR --policy FILE [--check NAME] [--jsonl GLOB] [--root DIR] [--warn]

A note for a keyed check (linux-clippy, linux-fleet-compat) covers every tree with the same key, the projection of the policy's
`inputs`. A file the compiler reads that the key leaves out (an include_str! of a doc, a proc macro's wit file) would let one tree's
note cover another whose result differs. So after the stage's cargo runs, this reads the dep-info file (`.d`) of every unit those runs
reported in their JSON messages (DIR/GLOB, default clippy-*.jsonl; a unit fresh from a cache is reported too, and its dep-info still
describes this tree's inputs), keeps the dependencies inside the repository and outside the target directory, and fails on any that no
input of --check (default linux-clippy) covers (equal, or a parent directory). A workspace build script's reads are not in any dep-info
file, so the `rerun-if-changed` paths it printed (its `output`, beside the out_dir of each build-script-executed message) are judged the
same way, relative to its package's directory (from the stage's own cargo metadata). The last line is always
`dep-info: check=NAME units=N files=M uncovered=K`, which the daily report counts.

The skip policy is named by the caller (--policy), never by this script. CI's keyed jobs run it inside their stage (scripts/ci-linux, when
CI_KEYED_CLIPPY_POLICY or CI_KEYED_FLEET_COMPAT_POLICY names the policy), and linux-clippy's local command, scripts/ci-clippy-result, runs it
after the stage. linux-gate runs the same stages without either, so linux-gate never depends on the policy file
(lane-definition-closure --check holds it to that).

--warn reports the same files as warnings and exits 0. linux-fleet-compat is in shadow and no default local run checks it yet, so the
merge queue would be the first place a failure showed; scripts/ci-linux passes --warn for it until it is a default local check.
linux-clippy is one (scripts/st-test), so its check fails.
"""
import argparse
import json
import os
from pathlib import Path
import posixpath
import sys

CHECK = 'linux-clippy'
JSONL = 'clippy-*.jsonl'


def declared(policy_text, check=CHECK):
    return [path.rstrip('/') for path in json.loads(policy_text)['checks'][check]['inputs']]


def covered(path, inputs):
    return any(path == item or path.startswith(item + '/') for item in inputs)


def dep_info_files(logs, pattern=JSONL):
    """The .d file of every unit a cargo run in this stage reported (compiler-artifact messages; an artifact lib<NAME>-<HASH>.rmeta, or
    a test binary NAME-HASH, and the unit's NAME-HASH.d sit side by side in target/<profile>/deps)."""
    found = set()
    for log in sorted(Path(logs).glob(pattern)):
        for line in log.read_text(errors='replace').splitlines():
            try:
                message = json.loads(line)
            except ValueError:
                continue
            if not isinstance(message, dict) or message.get('reason') != 'compiler-artifact':
                continue
            for name in message.get('filenames') or ():
                artifact = Path(name)
                if artifact.parent.name != 'deps':
                    continue
                library = artifact.suffix in ('.rmeta', '.rlib', '.so', '.a', '.dylib') and artifact.stem.startswith('lib')
                stem = artifact.stem[3:] if library else artifact.name   # a test binary is NAME-HASH, with no lib prefix or suffix
                dep_info = artifact.parent / f'{stem}.d'
                if dep_info.exists():
                    found.add(dep_info)
    return sorted(found)


def build_script_reads(logs, pattern, root, target, metadata):
    """The repository files and directories the workspace's build scripts said they read (cargo:rerun-if-changed=PATH, relative to the
    package's directory), for every build-script-executed message the stage's cargo runs reported. A dependency outside the workspace is
    not in the --no-deps metadata, and its paths lie outside the repository anyway. The git metadata a build script watches
    (fractal-build-stamp's HEAD, index and ref) is not the tree: under .git in a plain checkout such as CI's, outside the repository in
    a linked worktree, and no input key can hold it."""
    git_dir = root / '.git'
    packages = {package['id']: Path(package['manifest_path']).parent for package in metadata.get('packages', ())
                if isinstance(package, dict) and 'id' in package and 'manifest_path' in package}
    out = set()
    for log in sorted(Path(logs).glob(pattern)):
        for line in log.read_text(errors='replace').splitlines():
            try:
                message = json.loads(line)
            except ValueError:
                continue
            if not isinstance(message, dict) or message.get('reason') != 'build-script-executed':
                continue
            package, out_dir = packages.get(message.get('package_id')), message.get('out_dir')
            output = Path(out_dir).parent / 'output' if package and out_dir else None
            if not (output and output.is_file()):
                continue
            for printed in output.read_text(errors='replace').splitlines():
                name, sep, value = printed.partition('rerun-if-changed=')
                if not sep or name not in ('cargo:', 'cargo::'):
                    continue
                path = Path(posixpath.normpath(str(package / value)))
                if path == target or target in path.parents or root not in path.parents or path == git_dir or git_dir in path.parents:
                    continue
                out.add(path.relative_to(root).as_posix())
    return out


def dependencies(dep_info, root, target):
    """The repository files one dep-info file lists, relative to the root; generated files under the target directory and anything
    outside the repository (the registry, the Nix store) are not the tree's inputs."""
    out = set()
    for line in dep_info.read_text(errors='replace').splitlines():
        head, sep, rest = line.partition(': ')
        if not sep:
            continue
        for word in rest.replace('\\ ', '\0').split():
            word = word.replace('\0', ' ')
            path = Path(word) if os.path.isabs(word) else root / word
            path = Path(posixpath.normpath(str(path)))
            if path == target or target in path.parents or root not in path.parents:
                continue
            out.add(path.relative_to(root).as_posix())
    return out


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('--logs', required=True, help="the stage's log directory (scripts/ci-linux's $logs)")
    parser.add_argument('--check', default=CHECK, help=f'the check whose input key must cover what was read (default {CHECK})')
    parser.add_argument('--jsonl', default=JSONL, help=f'the cargo JSON message logs in --logs to read (default {JSONL})')
    parser.add_argument('--policy', required=True, help='the skip policy whose --check inputs make the key')
    parser.add_argument('--root', default=os.getcwd())
    parser.add_argument('--warn', action='store_true', help='report uncovered files as warnings and exit 0 (shadow)')
    args = parser.parse_args(argv)
    root = Path(posixpath.normpath(os.path.abspath(args.root)))
    inputs = declared(Path(args.policy).read_text(), args.check)
    metadata_file = Path(args.logs) / 'clippy-metadata.json'
    metadata = json.loads(metadata_file.read_text()) if metadata_file.exists() else {}
    target = Path(metadata['target_directory']) if 'target_directory' in metadata else root / 'target'
    target = Path(posixpath.normpath(os.path.abspath(target)))
    units = dep_info_files(args.logs, args.jsonl)
    files = set()
    for dep_info in units:
        files |= dependencies(dep_info, root, target)
    files |= build_script_reads(args.logs, args.jsonl, root, target, metadata)
    uncovered = sorted(path for path in files if not covered(path, inputs))
    level = 'warning' if args.warn else 'error'
    for path in uncovered:
        print(f'::{level}::{args.check} read {path}, which its input key does not cover: add it (or a parent) to the inputs of '
              f'{args.check} in {args.policy} and the tree_inputs of its lane')
    if not units:
        print(f'::{level}::no dep-info found for this stage\'s units ({args.jsonl}): nothing shows what {args.check} read')
    print(f'dep-info: check={args.check} units={len(units)} files={len(files)} uncovered={len(uncovered)}')
    return 1 if (uncovered or not units) and not args.warn else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
