#!/usr/bin/env python3
"""Keep unavailable, reset, and non-cacheable observations out of cache hit rates."""
import copy
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import socket
import subprocess
import sys
import tempfile
import unittest
from unittest.mock import patch

sys.dont_write_bytecode = True
root = Path(__file__).resolve().parent
loader = importlib.machinery.SourceFileLoader('sccache_evidence', str(root / 'sccache-evidence'))
spec = importlib.util.spec_from_loader(loader.name, loader)
evidence = importlib.util.module_from_spec(spec)
loader.exec_module(evidence)


IDENTITY = dict(pid=123, start_ticks="456", port=4226, config="example", boot_id="example")


def make_sample(value):
    return evidence.snapshot(value, "runner-example", IDENTITY, "job-example", "tree-example", "shared-webdav")


def raw(hits=0, misses=0):
    stats = dict.fromkeys(evidence.COUNTERS, 0)
    stats.update(compile_requests=100, requests_not_cacheable=80,
                 cache_hits={'counts': {'Rust': hits, 'C/C++': 3}},
                 cache_misses={'counts': {'Rust': misses}},
                 cache_errors={'counts': {'Rust': 2}})
    return dict(stats=stats, version='0.16.0',
                cache_location='Webdav: https://user:secret@example.test/cache?token=hidden')


class EvidenceTests(unittest.TestCase):
    def test_lifetime_denominator_and_redaction(self):
        sample = make_sample(raw(8, 2))
        result = evidence.report(sample)
        self.assertEqual(result['scope'], 'server_lifetime')
        self.assertEqual(result['rust_hit_rate'], .8)
        self.assertEqual(result['hit_rate'], 11 / 13)
        self.assertEqual(result['counters']['requests_not_cacheable'], 80)
        self.assertEqual(result['counters']['cache_errors'], 2)
        self.assertEqual(result['backend'], 'webdav')
        for private in ('secret', 'token', 'example.test'):
            self.assertNotIn(private, json.dumps(result))

    def test_interval_does_not_reset_shared_counters(self):
        before = make_sample(raw(80, 20))
        after = make_sample(raw(88, 22))
        original = copy.deepcopy(before)
        result = evidence.report(after, before)
        self.assertEqual(result['scope'], 'interval')
        self.assertEqual(result['hit_rate'], .8)
        self.assertEqual(result['counters']['cache_errors'], 0)
        self.assertEqual(before, original)

    def test_no_activity_has_no_percentage(self):
        sample = make_sample(raw())
        result = evidence.report(sample, sample)
        self.assertEqual(result['status'], 'no_cache_lookups')
        self.assertIsNone(result['hit_rate'])
        self.assertIsNone(result['rust_hit_rate'])

    def test_reset_and_identity_change_have_no_rate(self):
        before = make_sample(raw(80, 20))
        after = make_sample(raw(8, 2))
        self.assertEqual(evidence.report(after, before)['status'], 'counter_reset')
        for key in ('runner', 'identity', 'backend', 'storage', 'version', 'schema', 'job', 'source'):
            changed = {**after, key: 'different'}
            result = evidence.report(changed, before)
            self.assertEqual(result['status'], 'incompatible_snapshots')
            self.assertIsNone(result['hit_rate'])

    def test_missing_and_malformed_counters_are_not_zero(self):
        sample = raw()
        del sample['stats']['compile_requests']
        with self.assertRaises(KeyError): evidence.snapshot(sample, "runner-example", IDENTITY, "job-example", "tree-example", "shared-webdav")
        for value in (-1, True, '8', 1.2):
            sample = raw(value)
            with self.assertRaises(ValueError): evidence.snapshot(sample, "runner-example", IDENTITY, "job-example", "tree-example", "shared-webdav")

    def test_cli_only_reads_stats_and_does_not_publish_raw_output(self):
        with tempfile.TemporaryDirectory() as directory:
            tmp = Path(directory)
            cache = tmp / 'sccache'
            cache.write_text('#!/usr/bin/env python3\nimport sys\n'
                             'if sys.argv[1:] == ["--version"]: print("sccache 0.16.0"); sys.exit()\n'
                             'assert sys.argv[1:] == ["--show-stats", "--stats-format=json"]\n'
                             f'print({json.dumps(raw(8, 2))!r})\n')
            cache.chmod(0o755)
            output = tmp / 'stats.json'
            env = {**os.environ, 'SCCACHE_SERVER_PORT': '4399'}
            argv = ['sccache-evidence', 'capture', '--runner', 'runner-example',
                    '--sccache', str(cache), '--output', str(output), '--pid', '123',
                    '--start-ticks', '456', '--port', '4399', '--config-id', 'example',
                    '--job', 'job-example', '--source', 'tree-example', '--storage', 'shared-webdav']
            with patch.object(sys, 'argv', argv), patch.dict(os.environ, env), \
                 patch.object(evidence, 'live_identity', return_value=IDENTITY) as live:
                evidence.main()
                self.assertEqual(live.call_count, 2)
            self.assertEqual(json.loads(output.read_text())['identity'], IDENTITY)
            self.assertNotIn('secret', output.read_text())

    def test_live_identity_requires_owning_process_and_start_time(self):
        executable = Path(sys.executable).resolve()
        pid = os.getpid()
        start = Path(f'/proc/{pid}/stat').read_text().rsplit(')', 1)[1].split()[19]
        with socket.socket() as listener:
            listener.bind(('127.0.0.1', 0))
            listener.listen()
            port = listener.getsockname()[1]
            identity = evidence.live_identity(pid, start, port, executable, 'example-config')
            self.assertEqual(identity['port'], port)
            with self.assertRaises(ValueError):
                evidence.live_identity(pid, '0', port, executable, 'example-config')
            with self.assertRaises(ValueError):
                evidence.live_identity(pid, start, port, Path('/different'), 'example-config')
        with self.assertRaises(ValueError):
            evidence.live_identity(pid, start, port, executable, 'example-config')
        with self.assertRaises(FileNotFoundError):
            evidence.live_identity(999999999, start, port, executable, 'example-config')

    def test_capture_aborts_before_query_on_denied_or_missing_identity(self):
        with tempfile.TemporaryDirectory() as directory:
            output = Path(directory) / 'stats.json'
            argv = ['sccache-evidence', 'capture', '--runner', 'runner-example',
                    '--sccache', sys.executable, '--output', str(output), '--pid', '123',
                    '--start-ticks', '456', '--port', '4399', '--config-id', 'example',
                    '--job', 'job-example', '--source', 'tree-example', '--storage', 'shared-webdav']
            for failure in (PermissionError('denied'), FileNotFoundError('missing')):
                with patch.object(sys, 'argv', argv), \
                     patch.object(evidence, 'live_identity', side_effect=failure), \
                     patch.object(evidence.subprocess, 'check_output') as query:
                    with self.assertRaises(type(failure)): evidence.main()
                    query.assert_not_called()
                    self.assertFalse(output.exists())

    def test_opt_in_is_off_by_default_and_read_only_when_enabled(self):
        script = root / 'sccache-read-cache-env'
        base = {'PATH': os.environ['PATH']}
        def run(extra):
            return subprocess.run(['bash', '-eu', '-c',
                'source "$1"; env', 'bash', str(script)], env={**base, **extra},
                capture_output=True, text=True)
        disabled = run({'SCCACHE_WEBDAV_ENDPOINT': 'existing', 'SCCACHE_SERVER_PORT': '4300'})
        self.assertEqual(disabled.returncode, 0)
        self.assertIn('SCCACHE_WEBDAV_ENDPOINT=existing', disabled.stdout)
        self.assertNotIn('SCCACHE_WEBDAV_RW_MODE=', disabled.stdout)
        enabled = run({'ST_SCCACHE_READ_ENDPOINT': 'https://cache.example.test/',
                       'ST_SCCACHE_READ_SERVER_PORT': '4499'})
        self.assertEqual(enabled.returncode, 0, enabled.stderr)
        self.assertIn('SCCACHE_WEBDAV_RW_MODE=READ_ONLY', enabled.stdout)
        self.assertIn('SCCACHE_SERVER_PORT=4499', enabled.stdout)
        for port in ('', '0', '4226', '04226', '65536', 'text'):
            invalid = run({'ST_SCCACHE_READ_ENDPOINT': 'https://cache.example.test/',
                           'ST_SCCACHE_READ_SERVER_PORT': port})
            self.assertNotEqual(invalid.returncode, 0, port)
            self.assertNotIn('SCCACHE_WEBDAV_RW_MODE=', invalid.stdout)
        # arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
        for port in ('', '0', '4226', '04226', '65536', 'text'):
            invalid = run({'FRACTAL_SCCACHE_READ_ENDPOINT': 'https://cache.example.test/',
                           'FRACTAL_SCCACHE_READ_SERVER_PORT': port,
                           'ST_SCCACHE_READ_SERVER_PORT': '4499'})
            self.assertNotEqual(invalid.returncode, 0, port)
            self.assertNotIn('SCCACHE_WEBDAV_RW_MODE=', invalid.stdout)
        preferred = run({'FRACTAL_SCCACHE_READ_ENDPOINT': 'https://cache.example.test/',
                         'FRACTAL_SCCACHE_READ_SERVER_PORT': '4499',
                         'ST_SCCACHE_READ_SERVER_PORT': '0'})
        self.assertEqual(preferred.returncode, 0, preferred.stderr)
        self.assertIn('SCCACHE_SERVER_PORT=4499', preferred.stdout)
        masked = run({'FRACTAL_SCCACHE_READ_ENDPOINT': '',
                      'ST_SCCACHE_READ_ENDPOINT': 'https://cache.example.test/',
                      'ST_SCCACHE_READ_SERVER_PORT': '0'})
        self.assertEqual(masked.returncode, 0, masked.stderr)
        self.assertNotIn('SCCACHE_WEBDAV_RW_MODE=', masked.stdout)
        conflict = run({'ST_SCCACHE_READ_ENDPOINT': 'https://cache.example.test/',
                        'ST_SCCACHE_READ_SERVER_PORT': '4499',
                        'SCCACHE_WEBDAV_ENDPOINT': 'existing'})
        self.assertNotEqual(conflict.returncode, 0)


if __name__ == '__main__':
    unittest.main()
