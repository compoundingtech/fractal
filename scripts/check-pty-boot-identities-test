#!/usr/bin/env python3

import json
from pathlib import Path
import subprocess
import tempfile
import unittest


SCRIPT = Path(__file__).with_name("check-pty-boot-identities.py")


class BootIdentityPreflightTest(unittest.TestCase):
    def setUp(self):
        self.directory = tempfile.TemporaryDirectory()
        self.root = Path(self.directory.name)

    def tearDown(self):
        self.directory.cleanup()

    def record(self, name, boot_id=None):
        value = {"daemonPid": 42}
        if boot_id is not None:
            value["daemonBootId"] = boot_id
        (self.root / f"{name}.json").write_text(json.dumps(value))

    def run_check(self, sessions):
        return subprocess.run(
            [str(SCRIPT), str(self.root)],
            input=json.dumps(sessions),
            text=True,
            capture_output=True,
            check=False,
        )

    def test_accepts_only_when_every_running_session_has_a_boot_identity(self):
        self.record("current", "boot-one")
        self.record("ended")
        result = self.run_check(
            [
                {"name": "current", "status": "running"},
                {"name": "ended", "status": "exited"},
            ]
        )
        self.assertEqual(result.returncode, 0, result.stderr)
        self.assertEqual(
            result.stdout,
            "pty boot identity preflight: 0/1 running sessions missing daemonBootId\n",
        )

    def test_refuses_absent_empty_and_missing_running_records(self):
        self.record("absent")
        self.record("empty", "  ")
        result = self.run_check(
            [
                {"name": "absent", "status": "running"},
                {"name": "empty", "status": "running"},
                {"name": "missing", "status": "running"},
            ]
        )
        self.assertEqual(result.returncode, 1)
        self.assertEqual(
            result.stdout,
            "pty boot identity preflight: 3/3 running sessions missing daemonBootId\n",
        )
        for name in ["absent", "empty", "missing"]:
            self.assertIn(name, result.stderr)

    def test_malformed_inventory_fails_closed(self):
        result = self.run_check({"name": "not-a-list"})
        self.assertEqual(result.returncode, 2)
        self.assertIn("did not return a list", result.stderr)


if __name__ == "__main__":
    unittest.main()
