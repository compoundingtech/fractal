#!/usr/bin/env python3
"""scripts/dep-info-check: every repository file a keyed stage's units read is inside its check's input key."""
import importlib.machinery
import importlib.util
import io
import json
from contextlib import redirect_stdout
from pathlib import Path
import tempfile
import unittest

HERE = Path(__file__).resolve().parent
loader = importlib.machinery.SourceFileLoader('dep_info_check', str(HERE / 'dep-info-check'))
spec = importlib.util.spec_from_loader(loader.name, loader)
check = importlib.util.module_from_spec(spec)
loader.exec_module(check)


POLICY = '.st/evidence-skip-policy.json'

class DepInfo(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        self.root = Path(self.tmp.name) / 'repo'
        self.logs = Path(self.tmp.name) / 'logs'
        self.deps = self.root / 'target' / 'debug' / 'deps'
        for directory in (self.deps, self.logs, self.root / '.st'):
            directory.mkdir(parents=True)
        self.policy(['crates', 'Cargo.toml', 'docs/st3/invariants.md'])
        (self.logs / 'clippy-metadata.json').write_text(json.dumps({'target_directory': str(self.root / 'target')}))
        self.messages = []

    def policy(self, inputs, other=('crates/fractal',)):
        (self.root / '.st/evidence-skip-policy.json').write_text(json.dumps({'checks': {'linux-clippy': {'inputs': inputs},
                                                                                       'linux-fleet-compat': {'inputs': list(other)}}}))

    def unit(self, name, files, log='clippy-workspace.jsonl', reported=True):
        """One compiled unit: its rmeta, its dep-info listing `files`, and (when reported) the compiler-artifact message for it."""
        rmeta = self.deps / f'lib{name}-0123abcd.rmeta'
        rmeta.write_bytes(b'')
        (self.deps / f'{name}-0123abcd.d').write_text(f'{rmeta}: {" ".join(files)}\n\n' + ''.join(f'{f}:\n' for f in files))
        if reported:
            self.messages.append((log, {'reason': 'compiler-artifact', 'filenames': [str(rmeta)]}))
        for name_, messages in {log_: [m for l, m in self.messages if l == log_] for log_, _ in self.messages}.items():
            (self.logs / name_).write_text(''.join(json.dumps(m) + '\n' for m in messages))

    def run_check(self, *extra):
        out = io.StringIO()
        with redirect_stdout(out):
            code = check.main(['--logs', str(self.logs), '--root', str(self.root), '--policy', str(self.root / POLICY), *extra])
        return code, out.getvalue()

    def test_a_unit_that_reads_only_declared_files_passes_and_the_summary_counts_them(self):
        self.unit('alpha', ['crates/alpha/src/lib.rs', 'crates/alpha/src/../../../docs/st3/invariants.md', str(self.root / 'Cargo.toml')])
        code, out = self.run_check()
        self.assertEqual(code, 0, out)
        self.assertEqual(out.splitlines()[-1], 'dep-info: check=linux-clippy units=1 files=3 uncovered=0')

    def test_an_include_from_outside_the_key_fails_loudly_and_names_the_file(self):
        self.unit('alpha', ['crates/alpha/src/lib.rs', 'crates/alpha/src/../../../docs/st3/schema.md'])
        code, out = self.run_check()
        self.assertEqual(code, 1, out)
        self.assertIn("::error::linux-clippy read docs/st3/schema.md, which its input key does not cover", out)
        self.assertEqual(out.splitlines()[-1], 'dep-info: check=linux-clippy units=1 files=2 uncovered=1')
        self.policy(['crates', 'docs/st3'])  # a parent directory covers it
        self.assertEqual(self.run_check()[0], 0)

    def test_generated_files_and_files_outside_the_repository_are_not_inputs(self):
        self.unit('alpha', ['crates/alpha/src/lib.rs', str(self.root / 'target/debug/build/alpha-1/out/generated.rs'),
                            '/nix/store/abc-rust/lib/rustlib/src/core.rs', str(Path.home() / '.cargo/registry/src/x/lib.rs')])
        code, out = self.run_check()
        self.assertEqual(code, 0, out)
        self.assertIn('files=1 ', out)

    def test_only_units_this_stage_reported_are_read_so_a_cached_stale_dep_info_cannot_fail_it(self):
        self.unit('alpha', ['crates/alpha/src/lib.rs'])
        self.unit('stale', ['old/include.txt'], reported=False)  # left in a restored target by another tree
        self.unit('model', ['crates/model/src/lib.rs'], log='clippy-model.jsonl')  # the second clippy run's log is read too
        code, out = self.run_check()
        self.assertEqual(code, 0, out)
        self.assertIn('units=2 ', out)

    def test_another_check_reads_its_own_logs_and_is_judged_by_its_own_inputs_and_a_test_binary_counts(self):
        binary = self.deps / 'integration-0123abcd'
        binary.write_bytes(b'')
        (self.deps / 'integration-0123abcd.d').write_text(f'{binary}: crates/fractal/tests/integration.rs crates/fractal/../../fixtures/a.json\n')
        (self.logs / 'fleet-compat-build.jsonl').write_text(json.dumps({'reason': 'compiler-artifact', 'filenames': [str(binary)]}) + '\n')
        self.unit('alpha', ['crates/alpha/src/lib.rs'])                          # clippy's log: not read for this check
        code, out = self.run_check('--check', 'linux-fleet-compat', '--jsonl', 'fleet-compat-*.jsonl')
        self.assertEqual(code, 1, out)
        self.assertIn('::error::linux-fleet-compat read fixtures/a.json, which its input key does not cover', out)
        self.assertEqual(out.splitlines()[-1], 'dep-info: check=linux-fleet-compat units=1 files=2 uncovered=1')
        self.policy(['crates', 'Cargo.toml'], other=('crates/fractal', 'fixtures'))
        self.assertEqual(self.run_check('--check', 'linux-fleet-compat', '--jsonl', 'fleet-compat-*.jsonl')[0], 0)

    def test_no_dep_info_at_all_fails_since_nothing_shows_what_clippy_read(self):
        code, out = self.run_check()
        self.assertEqual(code, 1, out)
        self.assertIn('no dep-info found', out)

    def test_in_shadow_the_same_files_are_warnings_and_the_stage_passes(self):
        self.unit('alpha', ['crates/alpha/src/lib.rs', 'crates/alpha/src/../../../docs/st3/schema.md'])
        code, out = self.run_check('--warn')
        self.assertEqual(code, 0, out)
        self.assertIn("::warning::linux-clippy read docs/st3/schema.md, which its input key does not cover", out)
        self.assertNotIn('::error::', out)
        self.assertEqual(out.splitlines()[-1], 'dep-info: check=linux-clippy units=1 files=2 uncovered=1')
        # ci-linux passes --warn: no default local run checks linux-clippy yet, so a failure would first show in the merge queue.
        line = next(line for line in (HERE / 'ci-linux').read_text().splitlines() if 'scripts/dep-info-check' in line)
        self.assertIn('--warn', line)

    def test_the_committed_policy_declares_the_check_and_its_lane_lists_the_same_tree_inputs(self):
        root = HERE.parent
        inputs = check.declared((root / POLICY).read_text())
        lane = json.loads((root / '.st/required-lanes.json').read_text())['lanes'][check.CHECK]
        for path in lane['definition_paths'] + lane['tree_inputs']:
            self.assertTrue(check.covered(path, inputs), f'{path} is in the lane but not in the input key')


if __name__ == '__main__':
    unittest.main()
