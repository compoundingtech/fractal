#!/usr/bin/env python3
"""The risky-class rules fire on schema DDL in a file that is not itself risky, and stay quiet on
an ordinary change to the same file."""
import json
from pathlib import Path
import re
import runpy
import subprocess
import sys
import tempfile
import unittest
sys.dont_write_bytecode = True
import importlib.machinery
import importlib.util

HERE = Path(__file__).resolve().parent
loader = importlib.machinery.SourceFileLoader("classify_risk", str(HERE / "classify-risk"))
spec = importlib.util.spec_from_loader("classify_risk", loader)
classify_risk = importlib.util.module_from_spec(spec)
loader.exec_module(classify_risk)
config_path = runpy.run_path(str(HERE / "review-risk"))["config_path"]


class Classify(unittest.TestCase):
    def setUp(self):
        self.temporary = tempfile.TemporaryDirectory(prefix="classify-")
        self.addCleanup(self.temporary.cleanup)
        self.repo = Path(self.temporary.name)
        self.git("init", "-q", "-b", "main")
        self.git("config", "user.email", "t@example.com")
        self.git("config", "user.name", "t")
        (self.repo / ".st").mkdir()
        (self.repo / ".st/risky-classes.json").write_text(classify_risk.config_path(HERE.parent).read_text())
        self.write("crates/fractal-store/src/store/mailbox_x.rs", "fn a() {}\n")
        self.write("crates/fractal-store/src/store/plain.rs", "fn a() {}\n")
        self.write("docs/readme.md", "x\n")
        self.git("add", "-A")
        self.git("commit", "-q", "-m", "start")

    def git(self, *args):
        return subprocess.run(["git", *args], cwd=self.repo, text=True, capture_output=True, check=True).stdout

    def write(self, name, text):
        path = self.repo / name
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_text(text)

    def change(self, files):
        self.git("checkout", "-q", "-B", "topic", "main")
        for name, text in files.items():
            self.write(name, text)
        self.git("add", "-A")
        self.git("commit", "-q", "-m", "change")
        out = subprocess.run([sys.executable, str(HERE / "classify-risk"), "main", "topic", "--repo", str(self.repo)],
                             text=True, capture_output=True, check=True).stdout
        return json.loads(out)

    def names(self, result):
        return sorted(c["name"] for c in result["classes"])

    def test_docs_only_is_not_risky(self):
        result = self.change({"docs/readme.md": "y\n"})
        self.assertEqual((result["full"], result["classes"]), (False, []))

    def test_an_added_index_in_an_ordinary_store_file_is_schema(self):
        result = self.change({"crates/fractal-store/src/store/plain.rs": 'fn a() {}\nconst DDL: &str = "CREATE INDEX idx ON t(c)";\n'})
        self.assertEqual(self.names(result), ["schema"])
        self.assertIn("CREATE INDEX", result["classes"][0]["lines"][0])

    def test_an_ordinary_change_to_the_same_file_is_not(self):
        self.assertEqual(self.change({"crates/fractal-store/src/store/plain.rs": "fn a() { 1; }\n"})["classes"], [])

    def test_a_content_entry_can_exclude_paths(self):
        rules = {"classes": [{"name": "c", "globs": ["x/**"], "content": [{"globs": ["src/**"], "exclude": ["**/*_tests.rs"], "pattern": "BAD"}]}]}
        diff = {"src/a.rs": ["BAD"], "src/a_tests.rs": ["BAD"]}
        hit = classify_risk.classify(rules, list(diff), diff)
        self.assertEqual([line.split(":")[0] for line in hit[0]["lines"]], ["src/a.rs"])

    def test_the_schema_content_rule_skips_test_files_like_data_deletion_does(self):
        rules = json.loads(classify_risk.config_path(HERE.parent).read_text())
        schema = next(rule for rule in rules["classes"] if rule["name"] == "schema")
        deletion = next(rule for rule in json.loads((HERE.parent / config_path(HERE.parent, ".st/review-risk.json")).read_text())["rules"] if rule["name"] == "data-deletion")
        self.assertEqual(schema["content"][0]["exclude"], deletion["content"][0]["exclude"])

    def test_removing_a_trigger_counts_too(self):
        self.write("crates/fractal-store/src/store/plain.rs", 'const T: &str = "CREATE TRIGGER t AFTER INSERT ON x BEGIN SELECT 1; END";\n')
        self.git("add", "-A")
        self.git("commit", "-q", "-m", "trigger")
        self.assertEqual(self.names(self.change({"crates/fractal-store/src/store/plain.rs": "fn a() {}\n"})), ["schema"])

    def test_path_classes(self):
        result = self.change({"Cargo.lock": "x\n", "crates/fractal-store/src/store/mailbox_x.rs": "fn b() {}\n", "release-notes/n.json": "{}\n"})
        self.assertEqual(self.names(result), ["config-and-build", "release-notes", "routing-and-delivery"])

    def test_double_star_crosses_directories_and_star_does_not(self):
        self.assertTrue(classify_risk.matches(["clients/**/generated/**"], "clients/typescript/fractal-client/generated/a.ts"))
        self.assertTrue(classify_risk.matches(["**/Cargo.toml"], "Cargo.toml"))
        self.assertTrue(classify_risk.matches(["**/Cargo.toml"], "crates/a/b/Cargo.toml"))
        self.assertFalse(classify_risk.matches(["crates/fractal/src/*.rs"], "crates/fractal-store/src/store/x.rs"))

    # Globs that matched no tracked file when the rules were written. They guard paths that do not
    # exist yet (or no longer do); every other glob must match a tracked file, so moving code without
    # moving its glob fails here instead of silently dropping the class (the crate split caught this).
    ZERO_MATCH_ALLOWED = {
        "clients/**/generated/**",
        "crates/smallclaims/src/**/replay*",
        "crates/fractal-api-core/src/api/client_web*",
        "crates/fractal-secrets/src/sekrets.rs",
    }

    def test_every_glob_matches_a_tracked_file_or_is_listed(self):
        root = HERE.parent
        listed = subprocess.run(["git", "ls-files"], cwd=root, text=True, capture_output=True)
        if listed.returncode != 0:
            self.skipTest("not a git checkout")
        files = [f for f in listed.stdout.split("\n") if f]
        if "crates/fractal-store/src/store.rs" not in files:
            self.skipTest("a sparse tree (the ci-script-tests lane) does not hold the sources the globs name; run this on a full checkout")
        rules = json.loads(classify_risk.config_path(root).read_text())
        globs = set()
        for rule in rules["classes"]:
            globs.update(rule["globs"])
            for content in rule.get("content", []):
                globs.update(content["globs"])
        unmatched = {g for g in globs if not any(classify_risk.matches([g], f) for f in files)}
        # arn:lmig:smalltalk:2026-10-27-dot-fractal-config — future layout's paired glob is intentional.
        for glob in tuple(unmatched):
            if glob.startswith((".st/", ".fractal/")):
                other = glob.replace(".st/", ".fractal/", 1) if glob.startswith(".st/") else glob.replace(".fractal/", ".st/", 1)
                if other in globs and other not in unmatched:
                    unmatched.remove(glob)
        self.assertEqual(sorted(unmatched - self.ZERO_MATCH_ALLOWED), [], "a glob matches no tracked file")
        self.assertEqual(sorted(self.ZERO_MATCH_ALLOWED - unmatched), [], "an allowed glob now matches: remove it from the list")

    def test_rule_file_is_well_formed(self):
        rules = json.loads(classify_risk.config_path(HERE.parent).read_text())
        names = [c["name"] for c in rules["classes"]]
        self.assertEqual(len(names), len(set(names)))
        for rule in rules["classes"]:
            self.assertTrue(rule["globs"] and rule["forces"], rule["name"])
            for content in rule.get("content", []):
                re.compile(content["pattern"])
                self.assertTrue(content["globs"])


if __name__ == "__main__":
    unittest.main()
