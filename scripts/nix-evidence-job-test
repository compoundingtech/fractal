#!/usr/bin/env python3
"""The Nix signing jobs stay shadow-only: merge groups, no required check depends on them, nothing publishes their notes."""
from pathlib import Path
import re
import unittest

ROOT = Path(__file__).resolve().parent.parent
TEXT = (ROOT / '.github/workflows/fleet.yml').read_text()
CHECKS = ('genie-freshness', 'typescript-client')


def job(name):
    found = re.search(rf'^  {re.escape(name)}:\n((?:    .*\n|\n)+)', TEXT, re.M)
    assert found, name
    return found.group(1)


class NixEvidenceJobs(unittest.TestCase):
    def test_each_check_has_a_job_that_runs_only_for_merge_groups_and_may_fail(self):
        for check in CHECKS:
            body = job(f'nix-evidence-{check}')
            self.assertIn("github.event_name == 'merge_group'", body)
            self.assertRegex(body, r'continue-on-error: true\n')
            self.assertIn('environment:', body)
            self.assertRegex(body, r'timeout-minutes: 20\n')  # 163 s cold, 0.4 s warm: a hang must not hold a ci1-priority runner

    def test_no_job_depends_on_them_and_no_gate_waits_for_them(self):
        for name in re.findall(r'^  ([a-z][a-z0-9-]*):\n', TEXT, re.M):
            if name.startswith('nix-evidence-'):
                continue
            needs = re.search(r'^    needs:\n((?:      - .*\n)+)|^    needs: (.*)\n', job(name), re.M)
            if needs:
                self.assertNotIn('nix-evidence-', needs.group(0), f'{name} would wait for a shadow job')

    def test_the_build_runs_before_the_key_is_written_and_the_facts_script_comes_from_the_base(self):
        for check in CHECKS:
            body = job(f'nix-evidence-{check}')
            build, configure = body.index('nix-check-facts'), body.index('EVIDENCE_SIGNING_KEY')
            self.assertLess(build, configure)
            self.assertIn('evidence-base/scripts/nix-check-facts', body)
            self.assertIn('evidence-base/scripts/evidence-sign', body)
            self.assertNotIn('python3 scripts/nix-check-facts', body)

    def test_the_record_is_signed_under_the_checks_own_name(self):
        for check in CHECKS:
            body = job(f'nix-evidence-{check}')
            self.assertIn(f'nix-check-facts" --check {check} ', body)
            self.assertIn(f'evidence-wrap" --check {check} ', body)

    def test_the_notes_are_retained_under_a_name_the_gate_does_not_collect(self):
        collected = re.compile(r'^evidence-note-')
        for check in CHECKS:
            names = re.findall(r'name: "?(nix-evidence-note-[a-z-]+)"?', job(f'nix-evidence-{check}'))
            self.assertEqual(names, [f'nix-evidence-note-{check}'])
            self.assertFalse(collected.match(names[0]))
        lists = re.findall(r'--checks "([^"]*)"', TEXT)
        self.assertTrue(lists)
        for listed in lists:
            self.assertNotIn('nix-', listed, 'a Nix record would be published before the verifier accepts the kind')


if __name__ == '__main__':
    unittest.main()
