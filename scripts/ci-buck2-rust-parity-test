#!/usr/bin/env python3
"""Pure parser/comparison regressions; no Buck, Cargo, or test binaries run."""
import copy
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import sys
import unittest

sys.dont_write_bytecode = True
loader = importlib.machinery.SourceFileLoader("parity", str(Path(__file__).with_name("ci-buck2-rust-parity")))
spec = importlib.util.spec_from_loader(loader.name, loader)
parity = importlib.util.module_from_spec(spec)
loader.exec_module(parity)

LIB = ("lib", "fractal_storage_version")
INTEGRATION = ("test", "integration")


def suite(identity, cases):
    kind, name = identity
    binary_id = name if kind == "lib" else f"{parity.PACKAGE}::{name}"
    return binary_id, {
        "package-name": parity.PACKAGE,
        "binary-id": binary_id,
        "binary-name": name,
        "kind": kind,
        "status": "listed",
        "testcases": {name: {"ignored": ignored, "filter-match": {"status": "matches"}}
                      for name, ignored in cases.items()},
    }


def inventory(library=None, integration=None):
    suites = dict([suite(LIB, {} if library is None else library),
                   suite(INTEGRATION, {"normal": False, "ignored": True} if integration is None else integration)])
    return {"test-count": sum(len(s["testcases"]) for s in suites.values()), "rust-suites": suites}


class ParityTests(unittest.TestCase):
    def test_zero_test_library_and_ignored_test_preserved(self):
        expected = {LIB: {}, INTEGRATION: {"normal": False, "ignored": True}}
        actual = parity.nextest_inventory(json.dumps(inventory()))
        self.assertEqual(actual, expected)
        parity.compare(expected, actual)
        self.assertEqual(parity.harness_inventory("normal: test\nignored: test\n", "ignored: test\n"),
                         expected[INTEGRATION])
        self.assertEqual(parity.harness_inventory("", ""), {})

    def test_same_case_in_distinct_targets_is_not_a_duplicate(self):
        parsed = parity.nextest_inventory(json.dumps(inventory({"same": False}, {"same": False})))
        self.assertEqual(parsed, {LIB: {"same": False}, INTEGRATION: {"same": False}})

    def test_filtered_and_ignored_cases_are_still_inventory(self):
        data = inventory()
        for details in data["rust-suites"][suite(INTEGRATION, {})[0]]["testcases"].values():
            details["filter-match"] = {"status": "mismatch", "reason": "ignored"}
        self.assertEqual(len(parity.nextest_inventory(json.dumps(data))[INTEGRATION]), 2)

    def test_libtest_rejects_duplicates_unknown_lines_and_benchmarks(self):
        for text in ("same: test\nsame: test\n", "running 1 test\n", "case: benchmark\n", ": test\n"):
            with self.subTest(text=text), self.assertRaises(ValueError):
                parity.libtest_cases(text)
        with self.assertRaises(ValueError):
            parity.harness_inventory("normal: test\n", "absent: test\n")
        self.assertEqual(parity.libtest_cases("module::case: test\n"), {"module::case"})

    def test_buck_discovers_only_exact_requested_targets(self):
        outputs = {"root" + label: f"/build/{identity[0]}" for label, identity in parity.TARGETS.items()}
        self.assertEqual(parity.buck_binaries(json.dumps(outputs)),
                         {LIB: Path("/build/lib"), INTEGRATION: Path("/build/test")})
        wrong = [dict(list(outputs.items())[:1]), {**outputs, "root//other:tests": "/build/other"}]
        for output in ("", "relative/binary", ["/build/lib"], None):
            wrong.append({**outputs, next(iter(outputs)): output})
        wrong.append({key: "/build/same" for key in outputs})
        wrong.append({**outputs, next(iter(parity.TARGETS)): "/build/duplicate"})
        for data in wrong:
            with self.subTest(data=data), self.assertRaises(ValueError):
                parity.buck_binaries(json.dumps(data))

    def test_nextest_fails_closed_on_unknown_duplicate_or_unlisted_target(self):
        original = inventory()
        key = suite(INTEGRATION, {})[0]
        wrong = []
        for field, value in (("kind", "bench"), ("binary-name", "new_integration"),
                             ("status", "skipped"), ("binary-id", "inconsistent")):
            data = copy.deepcopy(original)
            data["rust-suites"][key][field] = value
            wrong.append(data)
        data = copy.deepcopy(original)
        del data["rust-suites"][suite(LIB, {})[0]]
        wrong.append(data)  # An empty library suite must not disappear.
        data = copy.deepcopy(original)
        duplicate = copy.deepcopy(data["rust-suites"][key])
        duplicate["binary-id"] = "duplicate"
        data["rust-suites"]["duplicate"] = duplicate
        data["test-count"] *= 2
        wrong.append(data)
        for value in (None, "false", 0):
            data = copy.deepcopy(original)
            data["rust-suites"][key]["testcases"]["normal"]["ignored"] = value
            wrong.append(data)
        for count in (0, True, "2"):
            wrong.append({**original, "test-count": count})
        for data in wrong:
            with self.subTest(data=data), self.assertRaises(ValueError):
                parity.nextest_inventory(json.dumps(data))

    def test_workspace_inventory_selects_package_not_case_names(self):
        data = inventory()
        foreign = suite(INTEGRATION, {"other": False})[1]
        foreign["package-name"] = "another-crate"
        foreign["binary-id"] = "another-crate::integration"
        data["rust-suites"][foreign["binary-id"]] = foreign
        data["test-count"] += 1
        self.assertEqual(parity.nextest_inventory(json.dumps(data)),
                         parity.nextest_inventory(json.dumps(inventory())))

    def test_duplicate_json_keys_and_malformed_documents_fail(self):
        for text in ('{"rust-suites": {}, "rust-suites": {}}',
                     '{"suite": {"case": false, "case": true}}', "{}{}", "[]", "not JSON"):
            with self.subTest(text=text), self.assertRaises(ValueError):
                parity.document(text)

    def test_missing_extra_and_ignored_status_are_deterministic(self):
        expected = {LIB: {}, INTEGRATION: {"z_missing": False, "a_missing": False, "shared": True}}
        actual = {LIB: {}, INTEGRATION: {"z_extra": False, "a_extra": False, "shared": False}}
        with self.assertRaises(ValueError) as raised:
            parity.compare(actual, expected)
        message = str(raised.exception)
        self.assertLess(message.index("a_missing"), message.index("z_missing"))
        self.assertLess(message.index("a_extra"), message.index("z_extra"))
        self.assertIn("ignored-status mismatch: [('test', 'integration', 'shared')]", message)
        with self.assertRaises(ValueError):
            parity.compare({INTEGRATION: {}}, {LIB: {}, INTEGRATION: {}})
        for changed in ({"normal": False}, {"normal": False, "new": False}, {"normal": True}):
            with self.assertRaises(ValueError):
                parity.compare({LIB: {}, INTEGRATION: changed}, {LIB: {}, INTEGRATION: {"normal": False, "ignored": True}})


if __name__ == "__main__":
    unittest.main()
