#!/usr/bin/env bash
# Run the evidence GC once, as main has it (scripts/evidence-gc.service, daily from scripts/evidence-gc.timer). Never a checkout's
# copy: the script and the verifier it loads are read from origin/main in a bare repository this host keeps, so a branch cannot
# change what deletes. With --apply it deletes with this host's own git login: the evidence-tags ruleset refuses moving a tag,
# not deleting one. Every open pull request's head, read from the GitHub API without a login, keeps its records however old it
# is; if that list cannot be read, nothing runs. Each run's summary is kept under the state directory; applying runs also store
# it as a version of one st document. When this host runs the evidence log (evidence-log-timer installed and
# ~/.config/evidence-log/signer.json present), applying GC's lines go into it before deletion and the new head is published:
# a pull then neither reports what GC deleted as missing nor restores it, and if that step fails nothing is deleted.
#
#   evidence-gc-timer [--dry-run|--apply]   dry-run by default; --apply requires operator approval
set -euo pipefail
mode=${1:---dry-run}
if [ "$#" -gt 1 ] || { [ "$mode" != --dry-run ] && [ "$mode" != --apply ]; }; then
  echo 'usage: evidence-gc-timer [--dry-run|--apply]' >&2
  exit 2
fi
state=${EVIDENCE_GC_STATE:-$HOME/.local/state/evidence-gc}
remote=${EVIDENCE_GC_REMOTE:-https://github.com/compoundingtech/fractal.git}
repository=${EVIDENCE_GC_REPOSITORY:-compoundingtech/fractal}
api=${EVIDENCE_GC_API:-https://api.github.com}
document=${EVIDENCE_GC_DOCUMENT:-doc/fleet/factory/evidence-gc/runs}
log_timer=${EVIDENCE_GC_LOG_TIMER:-$HOME/.local/bin/evidence-log-timer}
log_config=${EVIDENCE_LOG_CONFIG:-$HOME/.config/evidence-log}
repo=$state/repo.git
mkdir -p "$state/runs"
if [ ! -d "$repo" ]; then
  git init -q --bare "$repo"
  git -C "$repo" remote add origin "$remote"
fi
git -C "$repo" -c core.hooksPath=/dev/null fetch -q --no-tags --filter=blob:none --shallow-since=40.days.ago origin \
  +refs/heads/main:refs/remotes/origin/main
tools=$(mktemp -d)
trap 'rm -rf "$tools"' EXIT
for tool in evidence-gc evidence-verify; do
  git -C "$repo" show "origin/main:scripts/$tool" > "$tools/$tool"
done
stamp=$(date -u +%Y%m%dT%H%M%SZ)
open_heads=$state/runs/$stamp.open-heads
resume_state=$state/pending-plan.json
resume_args=()
if [ "$mode" = --apply ]; then
  resume_args=(--apply --resume-state "$resume_state")
fi
# Dry runs never consume an outstanding deletion journal or publish its GC lines.
if [ "$mode" = --dry-run ] && [ -e "$resume_state" ]; then
  echo 'evidence-gc-timer: pending apply journal; preserve it and explicitly resume with --apply' >&2
  exit 1
fi
# Resume before reading a new live set; if another run finishes the plan meanwhile, refuse instead of planning without it.
if [ -e "$resume_state" ]; then
  resume_args+=(--resume-only)
else
python3 -I - "$api/repos/$repository/pulls?state=open&per_page=100" > "$open_heads" <<'PY'
import json, subprocess, sys
page = 1
while True:  # curl fails on an HTTP error, and then so does this run: without the list nothing is deleted
    reply = subprocess.run(['curl', '-fsS', '--max-time', '60', '-H', 'Accept: application/vnd.github+json', f'{sys.argv[1]}&page={page}'],
                           stdout=subprocess.PIPE, check=True)
    pulls = json.loads(reply.stdout)
    for pull in pulls:
        print(pull['head']['sha'])
    if len(pulls) < 100:
        break
    page += 1
PY
fi
before_args=()
if [ "$mode" = --apply ] && [ -f "$log_timer" ] && [ -f "$log_config/signer.json" ]; then
  before_args=(--before-delete "$(python3 -I -c 'import json, sys; print(json.dumps(sys.argv[1:]))' bash "$log_timer" gc --publish --no-wait --plan)")
fi
status=0
python3 -I "$tools/evidence-gc" --repo "$repo" --remote origin --main origin/main --fetch --open-heads-from "$open_heads" "${before_args[@]}" \
  "${resume_args[@]}" --plan-out "$state/runs/$stamp.plan.json" > "$state/runs/$stamp.json" 2> "$state/runs/$stamp.log" || status=$?
cat "$state/runs/$stamp.log" >&2
if [ "$mode" = --dry-run ]; then
  cat "$state/runs/$stamp.json"
elif [ -s "$state/runs/$stamp.json" ]; then
  st documents put "$state/runs/$stamp.json" --as "$document" >&2 || echo "evidence-gc-timer: could not store the summary in $document" >&2
fi
find "$state/runs" -type f -mtime +30 -delete
exit "$status"
