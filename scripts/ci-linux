#!/usr/bin/env bash
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
# Run one Linux gate stage inside the pinned devShell: tests, clippy, or fleet-compat.
# Each stage is its own GitHub Actions job on its own runner; `linux-gate` requires all three.
set -euo pipefail
. "$(dirname "$0")/script-test-supervisor"
stage=${1:?usage: scripts/ci-linux tests|clippy|fleet-compat|mail-redelivery-canaries|conversation-model}
# Logs stay outside the checkout: the public-content test scans untracked files.
logs="$RUNNER_TEMP/ci-logs"
mkdir -p "$logs"

fleet_compat() {
  # Fleet runtime compatibility is separate from Fractal-to-Fractal replication.
  # Exercise the deployed pty 0.13.0 record through the production mailbox bind handler,
  # even when the devShell's newer pty writer would hide missing daemonBootId.
  cargo test -p fractal-api-mailbox --locked --lib \
    api::mailbox::tests::replay_native_tests::deployed_pty_0_13_0_record_without_boot_id_binds_mailbox \
    -- --exact 2>&1 | tee "$logs/pty-mailbox-compat-result.log" || return
  grep -q "test result: ok. 1 passed" "$logs/pty-mailbox-compat-result.log" || return
  local baseline
  baseline=$(python3 scripts/compat-baseline fleet "$RUNNER_TEMP/baseline") || return
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
  export FRACTAL_COMPAT_BIN="$baseline" ST3_COMPAT_BIN="$baseline"
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
  test -x "${FRACTAL_COMPAT_BIN-${ST3_COMPAT_BIN-}}" || return
  # Every file that compile reads must be in linux-fleet-compat's input key, or its notes could cover a tree they never measured. Only
  # linux-fleet-compat's own run names the skip policy (scripts/ci-fleet-compat-keyed, CI's linux-fleet-compat job): linux-gate runs this
  # stage too and must not depend on the policy file, so without CI_KEYED_FLEET_COMPAT_POLICY the build keeps no messages and nothing is
  # checked. --warn while linux-fleet-compat is in shadow (clippy's check fails).
  if [ -n "${CI_KEYED_FLEET_COMPAT_POLICY:-}" ]; then
    cargo test -p fractal --locked --test integration --no-run --message-format=json > "$logs/fleet-compat-build.jsonl" || return
    local policy
    policy=$(keyed_policy "$CI_KEYED_FLEET_COMPAT_POLICY") || return
    python3 scripts/dep-info-check --logs "$logs" --check linux-fleet-compat --policy "$policy" --jsonl 'fleet-compat-*.jsonl' --warn || return
  fi
  cargo test -p fractal --locked --test integration -- --ignored --exact \
    fleet::previous_release_replicates_with_new_members_and_preserves_history_on_upgrade \
    fleet::previous_release_is_never_dialed_for_the_messages_shard_and_upgrades_in_place 2>&1 | tee "$logs/compat-result.log" || return
  grep -q "test result: ok. 2 passed" "$logs/compat-result.log" || return
  # The GitHub plugin store beside an older poller, and that poller upgraded in place.
  cargo test -p fractal --locked --test integration -- --ignored --exact \
    fleet::previous_release_poller_beside_a_github_plugin_member_and_its_upgrade 2>&1 | tee "$logs/compat-plugin-result.log" || return
  grep -q "test result: ok. 1 passed" "$logs/compat-plugin-result.log" || return
  # A member of the previous release that depends on a repository keeps its item snapshots.
  cargo test -p fractal --locked --test integration -- --ignored --exact \
    fleet::previous_release_dependent_keeps_item_snapshots_until_it_upgrades 2>&1 | tee "$logs/compat-compact-result.log" || return
  grep -q "test result: ok. 1 passed" "$logs/compat-compact-result.log"
}

# arn:lmig:smalltalk:2026-10-27-dot-fractal-config — checkout missing-only bridge.
# Only an auto:PATH argument selects a layout; explicit paths are never rewritten.
# The keyed caller supplies PATH: ordinary linux-gate/rust-tests must not declare a policy read.
keyed_policy() {
  local selected=$1
  if [[ "$selected" != auto:* ]]; then
    printf '%s\n' "$selected"
    return
  fi
  python3 -I - "${selected#auto:}" <<'PY'
import os
import sys
path = sys.argv[1]
preferred = os.path.join('.fractal', os.path.basename(path))
try:
    os.lstat(preferred)
except FileNotFoundError:
    pass
else:
    path = preferred
print(path)
PY
}

clippy_and_codegen() {
  python3 scripts/ci-build-snapshot-test || return
  python3 scripts/build-stamp-watch-test || return
  python3 scripts/clippy-ratchet-test || return
  python3 scripts/crate-cut-test || return
  cargo metadata --no-deps --format-version 1 --locked > "$logs/clippy-metadata.json" || return
  rustc --version > "$logs/clippy-rustc.txt" || return
  cargo clippy --version > "$logs/clippy-version.txt" || return
  cargo clippy --workspace --all-targets --locked --message-format=json \
    | tee "$logs/clippy-workspace.jsonl" | python3 scripts/clippy_ratchet.py --render || return
  # Workspace consumers enable drawing; check the standalone model separately.
  cargo clippy -p fractal-conversation-ui --no-default-features --all-targets --locked --message-format=json \
    | tee "$logs/clippy-model.jsonl" | python3 scripts/clippy_ratchet.py --render || return
  local base_args=()
  if [[ -n "${CLIPPY_BASE_SHA:-}" && "$CLIPPY_BASE_SHA" != 0000000000000000000000000000000000000000 ]]; then
    base_args=(--base-ref "$CLIPPY_BASE_SHA")
  fi
  python3 scripts/clippy_ratchet.py --logs "$logs" "${base_args[@]}" || return
  # Every file those compiles read must be in linux-clippy's input key, or its notes could cover a tree they never measured. CI's
  # linux-clippy job names the skip policy (CI_KEYED_CLIPPY_POLICY) and checks it here. linux-gate runs this stage too and must not
  # depend on the policy file (lane-definition-closure --check), so it never names it: a local run hands the stage's logs to
  # scripts/ci-clippy-result instead (CI_CLIPPY_REPORT, below), which checks the same after the stage, outside linux-gate's command.
  if [ -n "${CI_KEYED_CLIPPY_POLICY:-}" ]; then
    local policy
    policy=$(keyed_policy "$CI_KEYED_CLIPPY_POLICY") || return
    python3 scripts/dep-info-check --logs "$logs" --check linux-clippy --policy "$policy" --jsonl 'clippy-*.jsonl' || return
  fi
  cargo run --locked -p fractal-client-codegen -- --check || return
  # linux-clippy's note is signed from this stage (scripts/st-test): its cargo messages and metadata, and `passed` last, only when the
  # whole stage passed, so a report without it says the stage did not.
  if [ -n "${CI_CLIPPY_REPORT:-}" ]; then
    mkdir -p "$CI_CLIPPY_REPORT" && cp "$logs"/clippy-*.jsonl "$logs/clippy-metadata.json" "$CI_CLIPPY_REPORT/" \
      && : > "$CI_CLIPPY_REPORT/passed"
  fi
}

conversation_model() {
  # A workspace build unifies fractal-tui/fractal's ratatui feature, which would hide model dependencies.
  cargo test -p fractal-conversation-ui --no-default-features --locked || return
  local dependencies
  dependencies=$(cargo tree -p fractal-conversation-ui --no-default-features --locked -e normal --prefix none) || return
  if [[ "$dependencies" == *ratatui* ]]; then
    echo "the standalone conversation model must not depend on ratatui" >&2
    return 1
  fi
}

# Here and not a script of its own: a new file this stage runs would have to join .st/required-lanes.json, a trust file.
nextest_timeout_check() {
  # The ci profile, and any override, must kill a hung test within 600 s (slow-timeout's terminate-after)...
  local terminate scratch status=0
  terminate=$(python3 - <<'PY'
import re, sys, tomllib
profiles = tomllib.load(open('.config/nextest.toml', 'rb')).get('profile', {})
def kill_after(setting):
    period = re.fullmatch(r'(\d+)s', setting.get('period', '')) if isinstance(setting, dict) else None
    count = setting.get('terminate-after') if period else None
    return int(period.group(1)) * count if isinstance(count, int) and not isinstance(count, bool) and count > 0 else None
ci = profiles.get('ci', {}).get('slow-timeout')
settings = [ci] + [o['slow-timeout'] for p in ('default', 'ci') for o in profiles.get(p, {}).get('overrides', []) if 'slow-timeout' in o]
loose = [s for s in settings if (kill_after(s) or 601) > 600]
if loose:
    sys.exit(f'.config/nextest.toml must kill a hung test within 600 s (slow-timeout period in seconds, with terminate-after): {loose}')
print(ci['terminate-after'])
PY
  ) || return
  # ...and real nextest must kill one and fail it: a scratch crate whose test hangs, under that terminate-after with a 1 s period.
  scratch=$(mktemp -d) || return
  mkdir -p "$scratch/src" "$scratch/.config"
  printf '[package]\nname = "hang"\nversion = "0.0.0"\nedition = "2021"\n\n[workspace]\n' > "$scratch/Cargo.toml"
  printf '#[test]\nfn passes() {}\n\n#[test]\nfn hangs() {\n    loop {\n        std::thread::sleep(std::time::Duration::from_secs(1));\n    }\n}\n' > "$scratch/src/lib.rs"
  printf '[profile.ci]\nretries = 0\nslow-timeout = { period = "1s", terminate-after = %s }\n\n[profile.ci.junit]\npath = "junit.xml"\n' \
    "$terminate" > "$scratch/.config/nextest.toml"
  (cd "$scratch" && unset RUSTC_WRAPPER CARGO_TARGET_DIR CARGO_BUILD_TARGET_DIR "${!NEXTEST_@}" \
    && timeout 300 cargo nextest run --profile ci --offline --no-fail-fast) || status=$?
  if [[ "$status" != 100 ]] || ! grep -q 'type="test timeout"' "$scratch/target/nextest/ci/junit.xml" 2>/dev/null; then
    echo "nextest did not kill and fail a hung test (exit $status, want 100 and a 'test timeout' failure in its JUnit report)" >&2
    rm -rf "$scratch"
    return 1
  fi
  rm -rf "$scratch"
  echo "nextest killed a hung test after terminate-after=$terminate and failed it"
}

# Guard current products before any stage can report success.
python3 scripts/ci-cargo-tools-env-test
python3 scripts/ci-rustc-wrapper-test
python3 scripts/sccache-evidence-test
python3 scripts/check-fractal-boundary-test
python3 scripts/fractal-boot-canaries-offers-test
python3 scripts/check-fractal-boundary

# Diagnostic only, no behaviour change: how much scratch space the tests use, and how much tmpfs
# the runner has, so a later change can decide per runner class whether the tests' temporary files
# belong in /dev/shm (file-backed SQLite stores wait on fsync on a disk). `du` is of everything
# under TMPDIR, polled every five seconds, so it is an upper bound of the tests' own use.
scratch_diagnostic_start() {
  scratch="${TMPDIR:-/tmp}"
  scratch_peak_file=$(mktemp)
  echo 0 > "$scratch_peak_file"
  (
    peak=0
    while sleep 5; do
      used=$(du -sm "$scratch" 2>/dev/null | cut -f1)
      if [[ "${used:-0}" -gt "$peak" ]]; then peak=$used; echo "$peak" > "$scratch_peak_file"; fi
    done
  ) >/dev/null 2>&1 &
  scratch_poller=$!
}
scratch_diagnostic_finish() {
  # The poller holds no pipe of the stage (its output is /dev/null), so the stage never waits for it.
  python3 scripts/script_process.py "$scratch_poller" 15 --parent "$BASHPID"
  echo "Test scratch: TMPDIR=$scratch on $(stat -f -c %T "$scratch"), filesystem $(df -Pm "$scratch" | awk 'NR==2 {print $2}') MiB, peak du of TMPDIR $(cat "$scratch_peak_file") MiB; /dev/shm $(stat -f -c %T /dev/shm 2>/dev/null || echo absent), $(df -Pm /dev/shm 2>/dev/null | awk 'NR==2 {print $2}') MiB, $(df -Pm /dev/shm 2>/dev/null | awk 'NR==2 {print $3}') MiB used at the end; memory $(awk '/MemTotal/ {printf "%d", $2 / 1024}' /proc/meminfo) MiB, peak RSS of the tests not measured"
  # Several jobs share a ci box's /dev/shm: a shard that needs far more than the 0.5 GiB measured should be seen.
  if [[ "$scratch" == /dev/shm/* && "$(cat "$scratch_peak_file")" -gt 4096 ]]; then
    echo "::warning::the tests used $(cat "$scratch_peak_file") MiB of /dev/shm, more than the 4 GiB a shared runner allows for"
  fi
  rm -f "$scratch_peak_file"
}

start=$SECONDS status=0
# Both native test jobs and the standalone mail canaries use the existing runner
# tmpfs, with short socket paths and evidence retained until job cleanup.
if [[ ( "$stage" == tests || "$stage" == mail-redelivery-canaries ) && -n "${CI_LOCAL_CARGO_HOME:-}" ]]; then
  export TMPDIR="$RUNNER_TEMP/t" TMP="$RUNNER_TEMP/t" TEMP="$RUNNER_TEMP/t"
  mkdir -p "$TMPDIR"
  # On the ci boxes RUNNER_TEMP is ext3 and /dev/shm a 46 GiB tmpfs mounted exec (91 GiB of memory, six runners per box).
  # Pull-request and merge-group test shards put TMPDIR in a /dev/shm directory of their own, as GitHub runners do below,
  # and the tests about durability or disk cost keep RUNNER_TEMP/t (CI_TEST_DISK_TMPDIR). A shard's peak is about 0.5 GiB
  # (2026-10-25), so six at once fit; each job still requires 20 GiB free. The runners persist: the directory is named
  # for its runner, which runs one job at a time, and is removed on exit, failure or cancel, and by the runner's next
  # tests job when a kill left it behind.
  if [[ "$stage" == tests && "${GITHUB_ACTIONS:-}" == true && "${CI_TEST_LANE:-}" != daily && "${RUNNER_NAME:-}" =~ ^[A-Za-z0-9._-]+$ ]] \
    && [[ "$(stat -f -c %T /dev/shm 2>/dev/null)" == tmpfs ]]; then
    shm="/dev/shm/ci-tests.$RUNNER_NAME"
    rm -rf "$shm"
    if [[ "$(df -Pk /dev/shm | awk 'NR==2 {print $4}')" -ge $((20 * 1024 * 1024)) ]] \
      && ! awk '$2 == "/dev/shm" {print $4}' /proc/mounts | tr ',' '\n' | grep -qx noexec; then
      mkdir -m 700 "$shm"
      trap 'rm -rf "$shm" || true' EXIT
      trap 'exit 129' HUP; trap 'exit 130' INT; trap 'exit 143' TERM
      export CI_TEST_DISK_TMPDIR="$TMPDIR" TMPDIR="$shm" TMP="$shm" TEMP="$shm"
    fi
  fi
  echo "Test scratch filesystem: $(stat -f -c %T "$TMPDIR") at $TMPDIR; disk for durability tests: ${CI_TEST_DISK_TMPDIR:-none}"
fi
# On a CI runner the tests' TMPDIR is a disk (overlayfs), and their file-backed SQLite stores spend most of their time there waiting
# on fsync. The runner's /dev/shm is tmpfs (8 GiB, noexec, on the 8x16 runners): remount it exec and resize it as perf.yml does, so the checkpoint tests'
# free-space gate (about 17 GB, as in scripts/ci-local) passes, and put TMPDIR there. tmpfs holds only what the tests write: the
# peak was 2.4 GiB per pull-request shard (2026-10-24). The tests about durability or disk cost use CI_TEST_DISK_TMPDIR, the old
# TMPDIR (disk_tempdir in the tests' support code). The daily shards keep a disk for now.
if [[ "$stage" == tests && -z "${CI_LOCAL_CARGO_HOME:-}" && "${GITHUB_ACTIONS:-}" == true && "${CI_TEST_LANE:-}" != daily ]] \
  && [[ "$(stat -f -c %T /dev/shm 2>/dev/null)" == tmpfs ]]; then
  # The runners mount it noexec; tests run programs they write into TMPDIR (installers, fake children).
  sudo -n mount -o remount,exec,size=24G /dev/shm || echo "::warning::could not remount /dev/shm"
  if [[ "$(df -Pk /dev/shm | awk 'NR==2 {print $4}')" -ge $((20 * 1024 * 1024)) ]] \
    && ! awk '$2 == "/dev/shm" {print $4}' /proc/mounts | tr ',' '\n' | grep -qx noexec; then
    export CI_TEST_DISK_TMPDIR="${TMPDIR:-/tmp}"
    shm=$(mktemp -d /dev/shm/t.XXXXXX)
    export TMPDIR="$shm" TMP="$shm" TEMP="$shm"
  fi
  echo "Test scratch filesystem: $(stat -f -c %T "${TMPDIR:-/tmp}") at ${TMPDIR:-/tmp}; disk for durability tests: ${CI_TEST_DISK_TMPDIR:-none}"
fi
case "$stage" in
  # The nextest --no-run step already compiled the test executables.
  tests) {
    # The standalone feature check is independent of the workspace's unified test build.
    # Only shard 1 (or an unpartitioned local run) needs to perform it.
    # CI_TEST_PACKAGES (comma-separated package names; scripts/fractal-test's per-crate run, docs/per-crate-test-signing.md) narrows the run to
    # those packages' tests on the same workspace build; CI_TEST_JUNIT names the file nextest writes its JUnit report to.
    selected=()
    if [[ -n "${CI_TEST_PACKAGES:-}" ]]; then
      filter=""
      for package in ${CI_TEST_PACKAGES//,/ }; do
        [[ "$package" =~ ^[A-Za-z0-9_-]+$ ]] || { echo "invalid package name in CI_TEST_PACKAGES: $package" >&2; exit 2; }
        filter+="${filter:+ or }package(=$package)"
      done
      selected+=(-E "$filter")
    fi
    if [[ -n "${CI_TEST_JUNIT:-}" ]]; then
      [[ "$CI_TEST_JUNIT" == /* ]] || { echo "CI_TEST_JUNIT must be an absolute path" >&2; exit 2; }
      junit_config="$logs/junit-tool-config.toml"
      printf '[profile.ci.junit]\npath = "%s"\n' "$CI_TEST_JUNIT" > "$junit_config"
      selected+=(--tool-config-file "fractal-test:$junit_config")
    fi
    # The standalone feature check is a separate cargo test of one package.
    if [[ -z "${CI_TEST_EXTRACTED:-}" && "${CI_TEST_PARTITION:-}" != hash:2/2 \
          && ( -z "${CI_TEST_PACKAGES:-}" || ",$CI_TEST_PACKAGES," == *,fractal-conversation-ui,* ) ]]; then conversation_model || exit $?; fi
    # A hung test is killed and fails, not waited for: checked once per run (shard 1, or an unpartitioned local run).
    if [[ "${CI_TEST_PARTITION:-}" != hash:2/2 && -z "${CI_TEST_PACKAGES:-}" ]]; then nextest_timeout_check || exit $?; fi
    scratch_diagnostic_start
    tests_status=0
    bash scripts/ci-nextest run --test-threads "${CI_TEST_THREADS:-${CI_LOCAL_TEST_THREADS:-$(nproc)}}" --status-level pass "${selected[@]}" || tests_status=$?
    scratch_diagnostic_finish
    exit "$tests_status"
  } 2>&1 | tee "$logs/$stage.log" || status=$? ;;
  conversation-model) conversation_model 2>&1 | tee "$logs/$stage.log" || status=$? ;;
  clippy) clippy_and_codegen 2>&1 | tee "$logs/$stage.log" || status=$? ;;
  fleet-compat) fleet_compat 2>&1 | tee "$logs/$stage.log" || status=$? ;;
  mail-redelivery-canaries) python3 scripts/ci-mail-redelivery-canaries 2>&1 | tee "$logs/$stage.log" || status=$? ;;
  *) echo "unknown stage: $stage" >&2; exit 2 ;;
esac
# The tests nextest passed only on a retry: `flaky=N` for the step output, and the file Workspace CI
# uploads as `nextest-flaky-<lane>-<N>` for `st slo`'s flakes. Counting never changes the result.
if [[ "$stage" == tests ]]; then
  python3 scripts/ci-nextest-flaky "$logs/$stage.log" "${RUNNER_TEMP:-$logs}/nextest-flaky.txt" \
    || echo "::warning::could not count nextest's flaky tests"
fi
# `tee` hides the stage's exit status behind a pipeline; pipefail restores it above.
result=passed
[ "$status" -eq 0 ] || result=failed
printf '%s %s\n' "$((SECONDS - start))" "$status" > "$logs/$stage.time"
printf '| %s | %s | %ss | %s |\n' "$stage" "$result" "$((SECONDS - start))" "$status" >> "$GITHUB_STEP_SUMMARY"
exit "$status"
