#!/usr/bin/env bash
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
set -Eeuo pipefail

# The defaults define the delivery soak gate. Overrides exist for synthetic tests only.
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
STATE_DIR=${FRACTAL_SOAK_STATE_DIR-${ST3_SOAK_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/st3/message-soak}}
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
LOG=${FRACTAL_SOAK_REPORT_LOG-${ST3_SOAK_REPORT_LOG:-$STATE_DIR/events.log}}
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
NOW=${FRACTAL_SOAK_REPORT_NOW_UNIX-${ST3_SOAK_REPORT_NOW_UNIX:-$(date +%s)}}
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
MIN_DURATION=${FRACTAL_SOAK_REPORT_MIN_DURATION_SECONDS-${ST3_SOAK_REPORT_MIN_DURATION_SECONDS:-259200}}
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
MAX_GAP=${FRACTAL_SOAK_REPORT_MAX_GAP_SECONDS-${ST3_SOAK_REPORT_MAX_GAP_SECONDS:-900}}
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
MIN_EACH=${FRACTAL_SOAK_REPORT_MIN_EACH_DIRECTION-${ST3_SOAK_REPORT_MIN_EACH_DIRECTION:-400}}

for value in "$NOW" "$MIN_DURATION" "$MAX_GAP" "$MIN_EACH"; do
  [[ $value =~ ^[0-9]+$ ]] || { echo 'invalid numeric report setting' >&2; exit 2; }
done
[[ -r $LOG ]] || { echo "soak evidence log is unavailable: $LOG" >&2; exit 1; }

# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
if [[ ${FRACTAL_SOAK_REPORT_SKIP_RUNTIME_CHECKS-${ST3_SOAK_REPORT_SKIP_RUNTIME_CHECKS:-0}} != 1 ]]; then
  systemctl --user is-active --quiet st3-message-soak.service || {
    echo 'soak monitor service is not active' >&2; exit 1;
  }
  for direction in example-linux-to-example-mac example-mac-to-example-linux; do
    jq -e '(.streak == 0) and (.attention == "")' "$STATE_DIR/$direction.json" >/dev/null || {
      echo "soak monitor has unresolved failures: $direction" >&2; exit 1;
    }
  done
fi

TZ=UTC awk -v now="$NOW" -v duration="$MIN_DURATION" \
  -v max_gap="$MAX_GAP" -v min_each="$MIN_EACH" '
  BEGIN { start = now - duration; previous = -1; first = -1; last = -1 }
  {
    stamp = substr($1, 1, 19)
    if (split(stamp, date, /[-T:]/) != 6) { bad = "invalid timestamp"; next }
    epoch = mktime(date[1] " " date[2] " " date[3] " " date[4] " " date[5] " " date[6])
    if (epoch < previous || epoch > now + 60) { bad = "non-monotonic or future evidence"; next }
    previous = epoch
    if (index($0, "monitor-started evidence_format=2") && epoch <= start) format_ready = 1
    if (epoch < start) next
    if (index($0, " FAILED ") || index($0, "delivery soak will retry") || index($0, " warning:")) bad = "a probe or monitor operation failed"
    if (!index($0, " ok direction=")) next
    direction = ""
    for (i = 2; i <= NF; i++) if ($i ~ /^direction=/) { split($i, field, "="); direction = field[2] }
    if (direction == "example-linux-to-example-mac") local_count++
    else if (direction == "example-mac-to-example-linux") remote_count++
    else { bad = "unknown direction"; next }
    if (first < 0) first = epoch
    if (last >= 0 && epoch - last > max_gap) bad = "evidence gap exceeds maximum"
    last = epoch
  }
  END {
    if (!format_ready) bad = "72-hour window predates complete failure logging"
    else if (first < 0 || first - start > max_gap || now - last > max_gap) bad = "evidence does not cover the whole window"
    else if (local_count < min_each || remote_count < min_each) bad = "too few successful probes in one direction"
    if (bad != "") {
      printf "FAIL: %s; example-linux-to-example-mac=%d example-mac-to-example-linux=%d window_seconds=%d\n", bad, local_count, remote_count, duration
      exit 1
    }
    printf "PASS: continuous bidirectional exact receipts; example-linux-to-example-mac=%d example-mac-to-example-linux=%d window_seconds=%d max_gap_seconds=%d\n", local_count, remote_count, duration, max_gap
  }
' "$LOG"
