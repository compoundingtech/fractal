#!/usr/bin/env python3
"""Evidence gate for one required check: may CI skip it because a trusted note already covers it?

Asks the verifier from the accepted base whether a trusted note exists for this run's tree
and check, and prints one decision line. It fails toward running: every doubt, error,
timeout or inconsistency is `decision=run`. It never fails the job.

One exception to running: a pull request whose opener the accepted base lists in .st/evidence-signed-only.json (our own
pull requests, all pre-signed) is never run in CI. For it every `run` of an enforced check becomes `decision=refuse`, and
the check job fails with what to do instead (sign it with scripts/st-test --all --push origin). See `refusal`.

Outcomes (each has a fixed step name in the workflow so a collector can count them):
  satisfied    a trusted full-tier note from the central observer exists
  degraded     only an unsigned degraded note exists (the observer's signer was unreachable)
  no_note      nothing usable was found for this tree and check
  rejected     a note exists but was refused (bad signature, untrusted signer, failed check ...)
  unavailable  the verifier or the notes could not be obtained
`decision=skip` additionally needs every condition in `decide` to hold.

Which tree: a `pull_request` run checks out GitHub's merge of the head into the CURRENT base, which is a new tree
whenever main moved. For such a run the gate asks about the tree of the PULL REQUEST HEAD commit instead (the tree an
agent built and signed; GitHub attaches the required checks to that sha), but only when every condition in
`choose_tree` holds; otherwise it asks about the merge tree, as before. A merge_group run always uses its own tree.
"""
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import tempfile
from datetime import datetime, timezone

sys.dont_write_bytecode = True

# What may be skipped is decided by the repository's skip policy (.st/evidence-skip-policy.json,
# read from the accepted base by the verifier): kinds, commands, required inputs, trust levels and
# any maximum age. This script only adds what no policy can say: who may skip and when.
SKIP_EVENTS = ('pull_request', 'merge_group')
VERIFIER_TIMEOUT = int(os.environ.get('GATE_VERIFIER_TIMEOUT', '30'))
# A change that touches anything that decides a skip is not skipped on a note alone: those files are what a forged skip would
# have to edit. Compared between the accepted base and this run's tree. One exception (decide): a pull_request run covered by a note
# of one of OWN_LEVELS, our dev hosts, which ran the PR's own scripts. It is judged by THIS gate and verifier as the base has them
# (the workflow fetches both from BASE_SHA), never the PR's copies, and the merge queue runs every check in full before it lands.
PROTECTED = (
    'scripts/ci-evidence-gate', 'scripts/evidence-verify', '.st/evidence-skip-policy.json', '.st/evidence-keys',
    '.github/workflows/fleet.yml', '.github/workflows/fleet.yml.genie.ts', '.github/workflows/workspace-ci.ts',
    'scripts/ci-evidence-gate-test', 'scripts/evidence-verify-test',
    # What decides who may have a head tree used: the author list and the rule that reads it.
    '.st/evidence-authors.json', 'scripts/ci-evidence-signing',
    # What an agent-level note is held to (by_level "lane": true reads it from the base).
    '.st/required-lanes.json',
    # What defines a per-crate test key and the note that signs it (docs/per-crate-test-signing.md).
    # (.st/rust-test-inputs.json is not here: it is data that changes with ordinary code, and the verifier reads it only at the base.)
    'scripts/rust-test-keys', 'scripts/ci-rust-test-result',
    # The evidence log's key: which log heads the verifier reads at all.
    '.st/evidence-log-key',
    # Whose pull requests are refused instead of run when unsigned (refusal).
    '.st/evidence-signed-only.json',
)
# The protected files the gate and verifier only ever read at the accepted BASE when they judge a note: the signing keys (--keys-from),
# the author list (check_authors, from the base's ci-evidence-signing) and the evidence log's key (--log-keys-from). The copy in a head
# tree decides nothing, so main changing one after the branch point does not make a pull request fall back to the merge tree (a key
# rotation on main voided every head signature made before it, 2026-10-26). A note the change distrusts, a dropped key say, is still
# refused, by the lists as they are at the base. The branch's OWN edits to them still count as protected changes (choose_tree).
BASE_READ = ('.st/evidence-keys', '.st/evidence-authors.json', '.st/evidence-log-key', '.st/evidence-signed-only.json')

# Staleness bound for a head-tree note (the stated policy, docs/st3/gate-evidence.md "How stale a head may be"): the branch point
# may be at most this many first-parent commits of main behind the tip GitHub merged into. Further behind, the run asks about the
# merge tree, as before head trees existed. 24 is about 8 hours of main at 3 merges an hour and covered 99% of pull request runs
# (2026-10-17 to 2026-10-19: median 2, 99th percentile 22).
HEAD_TREE_MAX_BEHIND = 24
# The signer levels whose notes cover a pull request that edits protected files (see PROTECTED).
OWN_LEVELS = ('host',)

NOTES = 'refs/notes/evidence'  # records live under refs/notes/evidence/<tree>/: one prefix per tree
TAGS = 'refs/tags/evidence'  # and, protected by a ruleset, under refs/tags/evidence/<tree>/ (docs/st3/gate-evidence.md, "Records as tags")


def record_refspecs(tree):
    """One tree's records in both namespaces: two refspecs, one fetch."""
    return [f'+{TAGS}/{tree}/*:{TAGS}/{tree}/*', f'+{NOTES}/{tree}/*:{NOTES}/{tree}/*']


def input_refspecs(check, key):
    """The records indexed under this check and input key, in both namespaces."""
    return [f'+{TAGS}/input/{check}/{key}/*:{TAGS}/input/{check}/{key}/*',
            f'+refs/notes/evidence-input/{check}/{key}/*:refs/notes/evidence-input/{check}/{key}/*']
CHECK_NAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9._-]{0,99}')
VERIFIER = 'scripts/evidence-verify'
# Checks a note covers one crate at a time (docs/per-crate-test-signing.md): the gate asks whether EVERY workspace member of the tree
# has a satisfying note for its own key (evidence-verify --members), with the accepted base's scripts/rust-test-keys beside the
# verifier, which imports it.
MEMBER_CHECKS = frozenset({'rust-tests'})
MEMBER_KEYS = 'scripts/rust-test-keys'
MEMBER_INPUTS = '.st/rust-test-inputs.json'
KEYS = '.st/evidence-keys'
LOG_KEY = '.st/evidence-log-key'
LOG_REF = 'refs/evidence-log/main'
POLICY = '.st/evidence-skip-policy.json'
SIGNED_ONLY = '.st/evidence-signed-only.json'
SIGN = 'scripts/st-test --all --push origin'
MISSING = ('no_record', 'stale_tree', 'wrong_check', 'crate_uncovered')  # crate_uncovered: some crate has no note for its key
UNAVAILABLE = ('error', 'no_policy')
OID = re.compile(r'^(?:[0-9a-f]{40}|[0-9a-f]{64})$')
TOKEN = re.compile(r'^[A-Za-z0-9._:/@+=-]+$')


def classify(code, result):
    """Outcome name for a verifier exit code and JSON document."""
    if not isinstance(result, dict):
        return 'unavailable'
    if code == 0 and result.get('satisfied') is True:
        return 'satisfied' if result.get('tier') == 'full' else 'rejected'
    reason = result.get('reason')
    if reason == 'degraded':
        return 'degraded'
    if reason in MISSING:
        return 'no_note'
    if reason in UNAVAILABLE or reason is None:
        return 'unavailable'
    return 'rejected'


def run(*command, stdin=None, timeout=120, env=None):
    return subprocess.run(command, input=stdin, capture_output=True, timeout=timeout, check=False,
                          env=dict(os.environ, **env) if env else None)


def decide(context, outcome, result, tree):
    """(decision, why). Skip only if every single condition holds."""
    if outcome != 'satisfied' or not isinstance(result, dict):
        return 'run', 'no trusted note'
    if context['fork'] != 'false':
        return 'run', 'fork or unknown head repository'
    if context['event'] not in SKIP_EVENTS:
        return 'run', 'event does not allow skipping'
    if context.get('tree_of') == 'head' and context['event'] != 'pull_request':
        return 'run', 'a head-tree note covers pull request runs only'
    protected = context.get('protected_changed')
    if protected != [] and not (own_pull_request(context, result) and isinstance(protected, list)
                                and all(isinstance(p, str) and p and not p.startswith('<') for p in protected)):
        return 'run', 'a file that decides skipping changed, or could not be compared'
    checks = [
        (not sampled(context, result, tree), 'sampled: the real job runs anyway, to compare it with the note'),
        (result.get('enforce') is True, 'shadow: the note would cover this check, but the skip policy has not turned skipping on for it'),
        (result.get('events') is None or context['event'] in result['events'],
         'the policy does not let this note cover this event (the check\'s events, or a signer level that covers pull requests only)'),
        (result.get('satisfied') is True, 'verifier did not report satisfied'),
        (result.get('policy') is True, 'the skip policy was not applied'),
        (result.get('tier') == 'full', 'tier is not full'),
        (isinstance(result.get('kind'), str) and TOKEN.match(result['kind']) is not None, 'no kind'),
        (isinstance(result.get('trust_level'), str) and TOKEN.match(result['trust_level']) is not None,
         'no trust level'),
        (result.get('tree') == tree and OID.match(tree or '') is not None, 'tree differs from this run'),
        (result.get('check') == context['check'], 'check differs from this job'),
        (isinstance(result.get('record'), str) and OID.match(result['record']) is not None, 'no record id'),
        (isinstance(result.get('signer'), str) and TOKEN.match(result['signer']) is not None, 'no signer'),
        (age_of(result) is not None and age_of(result) >= -120, 'time out of order'),
    ]
    for ok, why in checks:
        if not ok:
            return 'run', why
    return 'skip', 'covered by a trusted full-tier note'


def own_pull_request(context, result):
    """A pull_request run whose note is one of our hosts' (OWN_LEVELS): it covers the run even when the change edits protected files."""
    return context['event'] == 'pull_request' and result.get('trust_level') in OWN_LEVELS


def signed_only(context):
    """True for a same-repository, non-draft pull_request run whose opener the accepted BASE lists in .st/evidence-signed-only.json
    ('openers'). Read at the base, so a pull request cannot take itself off the list. No list, an unreadable one or any doubt about
    the run: False, and the run is decided as before."""
    if context['event'] != 'pull_request' or context['fork'] != 'false' or context['draft'] != 'false':
        return False
    base, opener = context['base'], context['pr_user']
    if not OID.match(base or '') or not opener:
        return False
    shown = run('git', 'show', f'{base}:{SIGNED_ONLY}')
    if shown.returncode != 0:
        return False
    try:
        openers = json.loads(shown.stdout).get('openers')
    except (ValueError, AttributeError):
        return False
    return isinstance(openers, list) and opener in [name for name in openers if isinstance(name, str) and name]


def enforced(context):
    """True when the base's skip policy turns skipping on for this check: only then can a signature cover it, so only then is an
    unsigned run refused (a shadow check, rust-tests today, keeps running as its aggregate's part)."""
    shown = run('git', 'show', f"{context['base']}:{POLICY}")
    if shown.returncode != 0:
        return False
    try:
        entry = json.loads(shown.stdout)['checks'][context['check']]
    except (ValueError, KeyError, TypeError):
        return False
    return isinstance(entry, dict) and entry.get('enforce') is True


def refusal(context, outcome, detail, why, tree):
    """What to tell the author of a signed-only pull request whose check would otherwise run, or None to run it. Our pull requests
    never run the heavy jobs in CI: they are signed before the push, and a check with no valid signature for its tree fails here."""
    if not (signed_only(context) and enforced(context)):
        return None
    where = f"tree {tree[:12]}" if OID.match(tree or '') else 'this head'
    if outcome == 'no_note':
        problem = f'no signature for {where}'
    elif outcome == 'satisfied':
        # Typically a change to a file that decides skipping, covered only by a note another signer made for the same inputs: the run
        # needs this tree signed on our own host, which st-test does not redo for a check it finds covered unless told to.
        return (f"{context['check']}: signed, but not usable here: {why}. Our pull requests do not run CI: sign it on our own host "
                f"with {SIGN.replace(' --all ', ' --all --rerun ')}")
    elif outcome == 'unavailable':
        problem = f'the signature could not be checked ({detail}); re-run all jobs, and if it stays, sign again'
    else:
        problem = f'the signature for {where} was not accepted ({outcome}: {detail})'
    return f"{context['check']}: {problem}. Our pull requests do not run CI: sign it with {SIGN}"


def sampled(context, result, tree):
    """True when this run is one the policy keeps running for real although a note matches (one in `sample_one_in`).
    Deterministic in (check, input key, head), so a retry of the same run behaves the same.
    The head is in the seed, so on a pull request an author can re-push to change whether a run is sampled
    (about five tries at one in five); in a merge group the head is fixed. It is a comparison sample, not a security control."""
    every = result.get('sample_one_in')
    if isinstance(every, bool) or not isinstance(every, int) or every < 1:
        return True  # a missing or unreadable sampling rule samples: the verifier always reports it, so its absence is a fault
    if every == 1:
        return False
    seed = f"{context['check']}:{result.get('source_inputs') or tree}:{context.get('head', '')}"
    return int(hashlib.sha256(seed.encode()).hexdigest()[:8], 16) % every == 0


def age_of(result):
    try:
        moment = datetime.fromisoformat(str(result['observed_at']).replace('Z', '+00:00'))
        if moment.tzinfo is None:
            return None
        return int((datetime.now(timezone.utc) - moment).total_seconds())
    except (KeyError, ValueError):
        return None


def protected_changes(base):
    """Protected paths that differ between the accepted base and this run's tree; fails closed."""
    if not base:
        return ['<no base>']
    # --no-renames: with rename detection a moved file is reported only by its new name, which would
    # hide moving a protected file away.
    done = run('git', 'diff', '--no-renames', '--name-only', '-z', base, 'HEAD')
    if done.returncode != 0:
        return ['<comparison failed>']
    paths = [p for p in done.stdout.decode(errors='replace').split('\0') if p]
    return [p for p in paths if p in PROTECTED]


def fetch_state(done):
    """ok, none or failed for a quiet fetch of glob refspecs. git exits 1 and prints nothing when no remote ref matches any of
    them (the tree has no record of its own); a fetch that could not reach or read the remote prints a fatal line."""
    if done.returncode == 0:
        return 'ok'
    return 'none' if done.returncode == 1 and not done.stderr.strip() else 'failed'


def observe(context, revision='HEAD', protected=None):
    """(outcome, result dict or None, detail, verifier sha256) without ever raising. `protected` is the branch's own protected edits
    when choose_tree compared them (head-tree mode)."""
    base, check, repository = context['base'], context['check'], context['repository']
    if not base:
        return 'unavailable', None, 'no accepted base commit for this event', None
    # A head tree's history is already here (choose_tree deepened it and has the base): a depth-1 fetch of the base would cut it
    # there, and the verifier checks that the branch point is an ancestor of the base.
    present = context.get('tree_of') == 'head' and run('git', 'cat-file', '-e', f'{base}^{{commit}}').returncode == 0
    if not present and run('git', 'fetch', '--no-tags', '--depth=1', '-q', 'origin', base).returncode != 0:
        return 'unavailable', None, 'could not fetch the accepted base', None
    # --no-filter: choose_tree may have made this a partial clone (history without blobs); the notes' blobs must arrive in this one fetch,
    # not one lazy round trip each when the verifier reads them (that took more than the verifier's 30 seconds on a runner).
    # Only the records of the tree being asked about (a prefix of one tree), never the whole namespace.
    tree = run('git', 'rev-parse', '--verify', '--quiet', f'{revision}^{{tree}}')
    tree_id = tree.stdout.decode().strip() if tree.returncode == 0 else ''
    if OID.match(tree_id):
        context['notes_fetch'] = fetch_state(run('git', 'fetch', '--no-tags', '--depth=1', '--no-filter', '-q', 'origin', *record_refspecs(tree_id)))
    else:
        context['notes_fetch'] = 'failed'
    for name, path in (('policy_sha256', POLICY), ('keys_sha256', KEYS)):
        shown = run('git', 'show', f'{base}:{path}')
        context[name] = hashlib.sha256(shown.stdout).hexdigest()[:16] if shown.returncode == 0 else 'none'
    script = run('git', 'show', f'{base}:{VERIFIER}')
    if script.returncode != 0:
        return 'unavailable', None, 'the accepted base has no verifier yet', None
    digest = hashlib.sha256(script.stdout).hexdigest()
    with tempfile.TemporaryDirectory() as scratch:
        path = os.path.join(scratch, 'evidence-verify')
        with open(path, 'wb') as handle:
            handle.write(script.stdout)
        if run('git', 'cat-file', '-e', f'{base}:{KEYS}').returncode == 0:
            keys = ['--keys-from', base]
        else:
            # No trusted keys yet: nothing signed can be trusted, but a degraded note can still be counted.
            empty = os.path.join(scratch, 'empty-keys')
            open(empty, 'w').close()
            keys = ['--keys', empty]
        # The evidence log's shadow view (docs/st3/gate-evidence.md, "The evidence log"), once the base pins the log key and its
        # verifier reads it: one ref, one commit deep. It is reported on the decision line and changes no decision.
        log = []
        if b'--log-keys-from' in script.stdout and run('git', 'cat-file', '-e', f'{base}:{LOG_KEY}').returncode == 0:
            fetched = run('git', 'fetch', '--no-tags', '--depth=1', '--no-filter', '-q', 'origin', f'+{LOG_REF}:{LOG_REF}')
            context['log_fetch'] = 'ok' if fetched.returncode == 0 else 'failed'
            log = ['--log-keys-from', base]
        # The run's own input values, for a policy that compares a note's with them (input_order), once the base's verifier takes them.
        values = [f'--run-input={key}={value}' for key, value in sorted(context.get('run_inputs', {}).items())] \
            if b'--run-input' in script.stdout else []
        # A head tree is held to the lane definition at its branch point, once the base's verifier takes one.
        lane_base = ['--lane-base', context['lane_base']] if context.get('tree_of') == 'head' and context.get('lane_base') \
            and b'--lane-base' in script.stdout else []
        members = []
        if check in MEMBER_CHECKS:
            # Per crate: the base's verifier must take --members, and its scripts/rust-test-keys goes beside it; else the check runs.
            if b'--members' not in script.stdout:
                return 'unavailable', None, 'the accepted base has no per-crate verifier yet', digest
            member_keys = run('git', 'show', f'{base}:{MEMBER_KEYS}')
            if member_keys.returncode != 0:
                return 'unavailable', None, f'the accepted base has no {MEMBER_KEYS}', digest
            with open(os.path.join(scratch, 'rust-test-keys'), 'wb') as handle:
                handle.write(member_keys.stdout)
            context['manifests_fetch'] = prefetch_manifests(revision, base)
            context['members_fetch'] = fetch_member_notes(path, base, check, repository, revision)
            members = ['--members']
        else:
            fetch_input_notes(path, base, check, repository, revision)
        # Our pull request that edits a protected file can skip only on our own hosts' note (own_pull_request): ask the base's verifier,
        # once it takes it, for the newest passing note from those levels, so a pass CI signed later for the same inputs (any other pull
        # request's typescript-client run) does not hide it. A newer failure still decides.
        prefer = ['--prefer-levels', ','.join(OWN_LEVELS)] if isinstance(protected, list) and protected and not members \
            and context.get('event') == 'pull_request' and b'--prefer-levels' in script.stdout else []
        done = run(sys.executable, path, '--repo', '.', '--revision', revision, '--check', check, *members,
                   '--policy-from', base, '--repository', repository, *keys, *log, *values, *lane_base, *prefer, timeout=VERIFIER_TIMEOUT)
    try:
        result = json.loads(done.stdout)
    except ValueError:  # includes output that is not valid UTF-8
        return 'unavailable', None, f'verifier exit {done.returncode} without a JSON result', digest
    return classify(done.returncode, result), result, result.get('reason') or 'satisfied', digest


def prefetch_manifests(revision, base):
    """Every Cargo.toml blob of the tree and the base's .st/rust-test-inputs.json that this clone lacks, in ONE fetch: the verifier reads
    them without fetching (a lazy read is one round trip each), and a head tree's clone has its trees but no blobs. 'ok', 'none' (all
    present) or 'failed'; a failure only means the verifier refuses and the check runs."""
    listing = run('git', 'ls-tree', '-r', '-z', '--full-tree', revision)
    if listing.returncode != 0:
        return 'failed'
    wanted = []
    for entry in listing.stdout.split(b'\0'):
        meta, _, name = entry.partition(b'\t')
        if name == b'Cargo.toml' or name.endswith(b'/Cargo.toml'):
            wanted.append(meta.split()[2].decode())
    inputs = run('git', 'rev-parse', '--verify', '-q', f'{base}:{MEMBER_INPUTS}')
    if inputs.returncode == 0:
        wanted.append(inputs.stdout.decode().strip())
    missing = [oid for oid in wanted if OID.match(oid) and run('git', 'cat-file', '-e', oid, env={'GIT_NO_LAZY_FETCH': '1'}).returncode != 0]
    if not missing:
        return 'none'
    # No negotiation: the clone has main's commits but not their blobs, and a server with bitmaps would leave out every manifest that
    # an advertised commit reaches, which is each one main changed since the branch point. The lazy fetch of a partial clone asks the
    # same way.
    return 'ok' if run('git', '-c', 'fetch.negotiationAlgorithm=noop', 'fetch', '--no-tags', '-q', 'origin', *missing).returncode == 0 \
        else 'failed'


def fetch_member_notes(verifier, base, check, repository, revision='HEAD'):
    """The records indexed under every member's own key, in ONE fetch built from the verifier's own answer (--members --project prints
    each crate's key and refspecs), never the whole namespace. 'ok', 'none' (no member has a key) or 'failed' (best effort: a failure
    means no note is seen, and the check runs)."""
    try:
        done = run(sys.executable, verifier, '--repo', '.', '--revision', revision, '--check', check, '--members', '--project',
                   '--policy-from', base, '--repository', repository, timeout=VERIFIER_TIMEOUT)
        crates = json.loads(done.stdout).get('crates') if done.returncode == 0 else None
    except (ValueError, AttributeError, subprocess.TimeoutExpired, OSError):
        return 'failed'
    if not isinstance(crates, dict):
        return 'failed'
    refspecs = sorted({spec for crate in crates.values() if isinstance(crate, dict) for spec in crate.get('refspecs') or []
                       if isinstance(spec, str) and spec.startswith('+refs/') and ':refs/' in spec})
    if not refspecs:
        return 'none'
    return fetch_state(run('git', 'fetch', '--no-tags', '--depth=1', '--no-filter', '-q', 'origin', *refspecs))


def fetch_input_notes(verifier, base, check, repository, revision='HEAD'):
    """For a check that declares inputs: fetch only the records indexed under this tree's input key.
    Best effort: a failure here just means no input-keyed record is seen, and the check runs."""
    if not CHECK_NAME.fullmatch(check):
        return
    try:
        done = run(sys.executable, verifier, '--repo', '.', '--revision', revision, '--check', check, '--project',
                   '--policy-from', base, '--repository', repository, timeout=VERIFIER_TIMEOUT)
        key = json.loads(done.stdout).get('source_inputs') if done.returncode == 0 else None
    except (ValueError, AttributeError, subprocess.TimeoutExpired, OSError):
        return
    if isinstance(key, str) and OID.match(key):
        run('git', 'fetch', '--no-tags', '--depth=1', '--no-filter', '-q', 'origin', *input_refspecs(check, key))


def field(value):
    """One token for the decision line: no spaces, '-' for none."""
    text = '-' if value is None or value == '' else str(value)
    return text if TOKEN.match(text) else re.sub(r'[^A-Za-z0-9._:/@+=-]', '_', text)


def line(context, decision, outcome, result, detail, tree, verifier_sha, gate_sha):
    result = result if isinstance(result, dict) else {}
    age = age_of(result) if result.get('satisfied') is True else None
    fields = [
        ('check', context['check']), ('decision', decision), ('outcome', outcome), ('reason', detail),
        ('record', result.get('record')), ('signer', result.get('signer')),
        ('trust_level', result.get('trust_level')), ('kind', result.get('kind')), ('tier', result.get('tier')),
        ('observed_at', result.get('observed_at')), ('age_s', age), ('max_age_s', result.get('max_age_s')),
        ('attempts', result.get('attempts')), ('enforce', result.get('enforce')), ('match', result.get('match')),
        ('source_inputs', result.get('source_inputs')), ('tree', tree), ('tree_of', context.get('tree_of')),
        ('pr_head', context.get('pr_head')), ('merge_tree', context.get('merge_tree')), ('head_tree', context.get('head_tree')),
        ('behind', context.get('behind')), ('ci_inputs', context.get('ci_inputs')),
        ('notes_fetch', context.get('notes_fetch')), ('policy_sha256', context.get('policy_sha256')), ('keys_sha256', context.get('keys_sha256')),
        ('log', result.get('log')), ('log_head', result.get('log_head')), ('log_age_s', result.get('log_age_s')),
        ('log_missing', result.get('log_missing')), ('log_fetch', context.get('log_fetch')),
        # A per-crate check's unlogged pass: how many members, the first few as crate=record, and the oldest of their observed_at.
        ('log_unlogged', result.get('log_unlogged')), ('log_unlogged_crates', result.get('log_unlogged_crates')),
        ('log_unlogged_observed_at', result.get('log_unlogged_observed_at')),
        # A per-crate check: how many workspace members, and how many of them no satisfying note covers.
        ('members', result.get('members')), ('missing', len(result['missing']) if isinstance(result.get('missing'), (dict, list)) else None),
        ('manifests_fetch', context.get('manifests_fetch')), ('members_fetch', context.get('members_fetch')),
        ('head', context['head']),
        ('base', context['base']), ('event', context['event']), ('pr', context['pr']),
        ('repo', context['repository']), ('run', context['run']), ('attempt', context['attempt']),
        ('fork', context['fork']), ('verifier_sha256', verifier_sha), ('gate_sha256', gate_sha),
    ]
    return 'evidence-decision v1 ' + ' '.join(f'{key}={field(value)}' for key, value in fields)


def context_from(environ):
    repository = environ.get('REPOSITORY', '')
    head_repository = environ.get('HEAD_REPOSITORY', '')
    # Anything but a positively identical head repository is treated as a fork.
    fork = 'false' if repository and head_repository == repository else 'true'
    return {
        'check': environ.get('CHECK', ''), 'repository': repository, 'base': environ.get('BASE_SHA', ''),
        'head': environ.get('HEAD_SHA', ''), 'event': environ.get('EVENT_NAME', ''),
        'pr': environ.get('PR_NUMBER', ''), 'run': environ.get('RUN_ID', ''),
        'attempt': environ.get('RUN_ATTEMPT', ''), 'fork': fork,
        'pr_head': environ.get('PR_HEAD_SHA', ''), 'pr_user': environ.get('PR_USER', ''), 'actor': environ.get('ACTOR', ''),
        'triggering_actor': environ.get('TRIGGERING_ACTOR', ''), 'draft': environ.get('PR_DRAFT', ''),
        'tree_of': 'merge', 'merge_tree': None, 'head_tree': '-', 'notes_fetch': '-', 'policy_sha256': '-', 'keys_sha256': '-',
        'run_inputs': run_inputs_from(environ.get('RUN_INPUTS', '')),
    }


RUN_INPUT_KEY = re.compile(r'[a-z][a-z0-9_]{0,63}')
RUN_INPUT_VALUE = re.compile(r'[A-Za-z0-9._-]{1,64}')


def run_inputs_from(text):
    """This run's own values of inputs the policy's input_order compares a note's with (RUN_INPUTS, a JSON object of strings set by
    the workflow, e.g. fractal-web's kit_inputs from its change detection). Anything malformed is dropped: the verifier then finds
    no value for the run, and no note covers it."""
    try:
        values = json.loads(text) if text else {}
    except ValueError:
        return {}
    if not isinstance(values, dict):
        return {}
    return {key: value for key, value in values.items()
            if isinstance(key, str) and RUN_INPUT_KEY.fullmatch(key) and isinstance(value, str) and RUN_INPUT_VALUE.fullmatch(value)}


class Fallback(Exception):
    """A condition for using the pull request head's tree failed: ask about the merge tree instead."""


def git_out(*args, check=True):
    done = run('git', *args)
    if check and done.returncode != 0:
        raise Fallback(f'git {args[0]} failed')
    return done.stdout.decode(errors='replace').strip()


def base_signing_module(base):
    """scripts/ci-evidence-signing as it is at the accepted base: its check_authors is the rule that decides who
    may have a pull request run signed, and the pull request cannot change it."""
    shown = run('git', 'show', f'{base}:scripts/ci-evidence-signing')
    if shown.returncode != 0:
        raise Fallback('the accepted base has no ci-evidence-signing')
    with tempfile.TemporaryDirectory() as scratch:
        path = os.path.join(scratch, 'ci_evidence_signing')
        with open(path, 'wb') as handle:
            handle.write(shown.stdout)
        loader = importlib.machinery.SourceFileLoader('base_ci_evidence_signing', path)
        spec = importlib.util.spec_from_loader(loader.name, loader)
        module = importlib.util.module_from_spec(spec)
        loader.exec_module(module)
    return module


def base_module(base, path, name):
    """The script at `path` as it is at the accepted base, loaded as module `name`; a Fallback when the base has none."""
    shown = run('git', 'show', f'{base}:{path}')
    if shown.returncode != 0:
        raise Fallback(f'the accepted base has no {path}')
    with tempfile.TemporaryDirectory() as scratch:
        file = os.path.join(scratch, name)
        with open(file, 'wb') as handle:
            handle.write(shown.stdout)
        loader = importlib.machinery.SourceFileLoader(name, file)
        spec = importlib.util.spec_from_loader(loader.name, loader)
        module = importlib.util.module_from_spec(spec)
        loader.exec_module(module)
    return module


def ci_inputs_kept(check, branch_point, base, current):
    """True when `check` declares its CI inputs at the base (its lane's ci_inputs) and they are the same at the branch point, the base
    and `current`: main moved protected files, but none this check uses, so its own tree may still be asked about. False when the base
    declares none for it, or cannot say (an older base, a lane file it cannot read): the rule before per-check CI inputs."""
    if not check:
        return False
    try:
        verify = base_module(base, 'scripts/evidence-verify', 'base_evidence_verify')
        lanes = run('git', 'show', f'{base}:.st/required-lanes.json')
        if lanes.returncode != 0 or not hasattr(verify, 'ci_inputs_unchanged'):
            return False
        ci = verify.lane_rules(lanes.stdout.decode(), check).get('ci_inputs')
        return bool(ci) and verify.ci_inputs_unchanged('.', ci, (branch_point, base, current))
    except Fallback:
        return False
    except Exception:  # the base's verifier refused the lane file or the trees: not kept
        return False


def branch_point_verdict(branch_point, head, base, current, context=None, check=None):
    """How far the branch is behind main, when the pull request head's own tree may be asked about; else a Fallback naming why not.

    The history half of the head-tree rule, with no CI context in it so that scripts/fractal-test asks the very same question before a push: the
    branch is not more than HEAD_TREE_MAX_BEHIND commits behind (first-parent count from the branch point to `current`, the base tip the
    merge commit was made on), and no protected file differs between the branch point and the base or `current` (main moved one since
    the branch), other than those only ever read at the base (BASE_READ). With `check`, protected files main moved count only when they
    are that check's own CI inputs, as the base declares them (ci_inputs_kept): a change to the gate or the verifier on main, say, does
    not take the pull request's tree away from a check that does not read them. The branch's OWN protected edits do not make it fall
    back: they are the run's `protected_changed` (choose_tree), which decide weighs against the note's signer. Runs git in the current
    directory."""
    behind = git_out('rev-list', '--count', '--first-parent', f'{branch_point}..{current}')
    if not behind.isdigit():
        raise Fallback('could not count how far the branch is behind')
    if context is not None:
        context['behind'] = int(behind)  # reported even when it is the reason for the fallback
    if int(behind) > HEAD_TREE_MAX_BEHIND:
        raise Fallback(f'the branch is {behind} commits behind main, more than {HEAD_TREE_MAX_BEHIND}')
    changed = []
    for first, second in ((branch_point, base), (branch_point, current)):
        diff = run('git', 'diff', '--no-renames', '--name-only', '-z', first, second)
        if diff.returncode != 0:
            raise Fallback('could not compare protected files')
        changed += [p for p in diff.stdout.decode(errors='replace').split('\0') if p in PROTECTED and p not in BASE_READ]
    if changed:
        if not ci_inputs_kept(check, branch_point, base, current):
            if context is not None:
                context['ci_inputs'] = 'changed' if check else None
            raise Fallback('protected files differ from the branch point')
        if context is not None:
            context['ci_inputs'] = 'kept'  # main moved protected files outside this check's CI inputs
    return int(behind)


def choose_tree(context):
    """The revision whose tree this run asks about, and why not the pull request head when it is the merge.

    Uses the pull request head only for a same-repository pull_request run, and only when all of these hold:
    the payload head is a full object id that is present or fetchable; the checked-out commit is the merge whose
    second parent IS that head (or the head itself); the PR author, the actor and the triggering actor are on the
    author list at the BASE and every non-merge commit in the branch has a listed author and committer (the signing
    guard's own check, taken from the base); and no protected file differs between the branch point and the base (main's protected
    files moved since the branch). Any failure is a Fallback. The protected files the branch itself changes (branch point to head) are
    returned as the run's protected changes."""
    merge_tree = git_out('rev-parse', '--verify', 'HEAD^{tree}', check=False) or None
    context['merge_tree'] = merge_tree
    if context['event'] != 'pull_request':
        context['head_tree'] = 'not-a-pull-request'
        return 'HEAD', None
    try:
        if context['fork'] != 'false':
            raise Fallback('not from this repository')
        if context['draft'] != 'false':
            raise Fallback('not positively a non-draft pull request')
        head, base = context['pr_head'], context['base']
        if not OID.match(head or '') or not OID.match(base or ''):
            raise Fallback('no full head or base object id')
        if not (context['pr_user'] and context['actor'] and context['triggering_actor']):
            raise Fallback('the opener, actor or triggering actor is not known')
        # History work first, and all of it before the depth-1 fetch of the base in observe() would cut it.
        if git_out('rev-parse', '--is-shallow-repository') == 'true' and \
                run('git', 'fetch', '--no-tags', '-q', '--filter=blob:none', '--unshallow', 'origin').returncode != 0:
            raise Fallback('could not deepen the history')
        if run('git', 'cat-file', '-e', f'{head}^{{commit}}').returncode != 0 and \
                run('git', 'fetch', '--no-tags', '-q', 'origin', head).returncode != 0:
            raise Fallback('the head commit is not available')
        checked_out = git_out('rev-parse', 'HEAD')
        second_parent = git_out('rev-parse', '--verify', '-q', 'HEAD^2', check=False)
        if checked_out != head and second_parent != head:
            raise Fallback('the checked-out commit is not the merge of this head')
        if run('git', 'cat-file', '-e', f'{base}^{{commit}}').returncode != 0 and \
                run('git', 'fetch', '--no-tags', '-q', '--filter=blob:none', 'origin', base).returncode != 0:
            raise Fallback('the accepted base is not available')
        try:
            base_signing_module(base).check_authors(base, head, context['pr_user'], context['actor'], context['triggering_actor'])
        except Fallback:
            raise
        except BaseException as error:  # Refused, or anything the base's script raises
            raise Fallback(f'authors: {str(error)[:120]}')
        branch_point = git_out('merge-base', base, head)
        current = git_out('rev-parse', '--verify', '-q', 'HEAD^1', check=False) if checked_out != head else base
        branch_point_verdict(branch_point, head, base, current or base, context, context.get('check'))
        own = run('git', 'diff', '--no-renames', '--name-only', '-z', branch_point, head)
        if own.returncode != 0:
            raise Fallback('could not compare protected files')
        edits = [p for p in own.stdout.decode(errors='replace').split('\0') if p in PROTECTED]
        context['tree_of'], context['head_tree'] = 'head', 'used'
        # The head's lane definition is judged from the branch point, not main's tip: a branch that only lags main changed no lane
        # file itself (docs/st3/gate-evidence.md, "Which lane definition a pull request is held to").
        context['lane_base'] = branch_point
        return head, edits
    except Fallback as reason:
        context['head_tree'] = 'fallback:' + str(reason).replace(' ', '_')
    except Exception as error:
        context['head_tree'] = f'fallback:{type(error).__name__}'
    context['tree_of'] = 'merge'
    return 'HEAD', None


def main():
    context = context_from(os.environ)
    outcome, result, detail, verifier_sha, tree = 'unavailable', None, 'not run', None, None
    revision, protected = 'HEAD', None
    try:
        context['merge_tree'] = git_out('rev-parse', '--verify', 'HEAD^{tree}', check=False) or None
    except Exception:
        pass
    try:
        revision, protected = choose_tree(context)
    except Exception as error:  # never raise out of the gate
        context['head_tree'] = f'fallback:{type(error).__name__}'
        context['tree_of'] = 'merge'
    try:
        if not context['check']:
            detail = 'no check named'
        else:
            done = run('git', 'rev-parse', '--verify', f'{revision}^{{tree}}')
            tree = done.stdout.decode().strip() if done.returncode == 0 else None
            if tree is None:
                detail = 'could not read this run\'s tree'
            else:
                outcome, result, detail, verifier_sha = observe(context, revision, protected)
    except Exception as error:  # the gate must never fail the job
        outcome, result, detail = 'unavailable', None, f'{type(error).__name__}: {error}'
    try:
        # In head-tree mode the branch point decides (choose_tree compared it); otherwise the base against this run's tree.
        context['protected_changed'] = protected if protected is not None else protected_changes(context['base'])
    except Exception:
        context['protected_changed'] = ['<comparison failed>']
    try:
        decision, why = decide(context, outcome, result, tree)
    except Exception:
        decision, why = 'run', 'decision error'
    if decision == 'run' and outcome == 'satisfied' and why != 'no trusted note':
        detail = f'satisfied but not skipped: {why}'
    refused = None
    if decision == 'run':
        try:
            refused = refusal(context, outcome, detail, why, tree)
        except Exception:
            refused = None  # a doubt about the list runs the check, as before
        if refused:
            decision = 'refuse'
    with open(__file__, 'rb') as handle:
        gate_sha = hashlib.sha256(handle.read()).hexdigest()
    text = line(context, decision, outcome, result, detail, tree, verifier_sha, gate_sha)
    print(text)
    record = (result or {}).get('record') if decision == 'skip' else None
    # `line` is information only (evidence-presign-notice reads it). It goes first and without control characters, so
    # nothing in it can stand in for the outputs below, the ones a skip is decided by.
    single = re.sub(r'[\x00-\x1f\x7f]', '_', text)
    message = re.sub(r'[\x00-\x1f\x7f]', '_', refused) if refused else ''
    for variable, body in (('GITHUB_OUTPUT', f'line={single}\noutcome={outcome}\nskip={"true" if decision == "skip" else "false"}\n'
                                             f'record={field(record)}\nrefuse={"true" if refused else "false"}\nrefusal={message}\n'),
                           ('GITHUB_STEP_SUMMARY', text + '\n')):
        target = os.environ.get(variable)
        if target:
            with open(target, 'a') as handle:
                handle.write(body)
    return 0


if __name__ == '__main__':
    sys.exit(main())
