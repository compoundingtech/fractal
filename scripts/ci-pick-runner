#!/usr/bin/env python3
"""Choose roles from the shared owned pool; execute inline on a hosted picker."""
import json
import os
import subprocess


def main():
    env = os.environ
    event = env.get("EVENT", "")
    priority = event == "merge_group" or env.get("MODE") == "priority"
    try:
        priority = priority or (event == "pull_request" and "ci-priority" in json.loads(env.get("PR_LABELS", "[]")))
    except (ValueError, TypeError):
        pass
    output = open(env["GITHUB_OUTPUT"], "a")
    summary = open(env["GITHUB_STEP_SUMMARY"], "a")
    def emit(key, label):
        print(f'{key}={json.dumps([label], separators=(",", ":"))}', file=output)
        print(f'{key}: **{label.split("-")[0]}** ({label})', file=summary)
    def unavailable(reason):
        print(reason)
        if priority:
            emit("ci1", "ci1-priority")
        else:
            print(f'Unpicked runners: **Namespace** ({reason})', file=summary)
    if event == "pull_request" and env.get("HEAD_REPOSITORY") != env.get("REPOSITORY"):
        print('Unpicked runners: **Namespace** (fork pull request)', file=summary)
        return
    if not env.get("GH_TOKEN"):
        unavailable("no runner status token")
        return
    need = env.get("NEED", "1")
    if not need.isascii() or not need.isdigit() or int(need) < 1:
        unavailable("invalid minimum idle runner count")
        return
    try:
        result = subprocess.run(["gh", "api", "--paginate", "--slurp",
            f'orgs/{env["OWNER"]}/actions/runner-groups/3/runners?per_page=100'],
            check=True, capture_output=True, text=True, timeout=20)
        pages = json.loads(result.stdout)
        if not isinstance(pages, list):
            raise ValueError("runner pages")
        by_id = {}
        for page in pages:
            if not isinstance(page, dict) or not isinstance(page.get("runners"), list):
                raise ValueError("runner page")
            for runner in page["runners"]:
                if not isinstance(runner, dict) or type(runner.get("id")) is not int:
                    raise ValueError("runner identity")
                if not isinstance(runner.get("labels"), list):
                    raise ValueError("runner labels")
                labels = {label["name"] for label in runner["labels"]}
                if not all(isinstance(label, str) for label in labels):
                    raise ValueError("runner label")
                record = (runner.get("status"), runner.get("busy"), labels)
                if runner["id"] in by_id and by_id[runner["id"]] != record:
                    raise ValueError("conflicting duplicate runner")
                by_id[runner["id"]] = record
        idle = {key: labels for key, (status, busy, labels) in by_id.items()
                if status == "online" and busy is False}
    except (subprocess.SubprocessError, ValueError, TypeError, KeyError):
        unavailable("runner list unavailable or invalid")
        return
    if (event == "merge_group" and env.get("MERGE_OVERFLOW") == "on"
            and any(key < 1 or status not in ("online", "offline") or type(busy) is not bool
                    for key, (status, busy, labels) in by_id.items())):
        unavailable("unqualified merge capacity status")
        return
    # Group 3 is the common pool. These compatibility role names are shared on both hosts.
    online = sum(status == "online" for status, busy, labels in by_id.values())
    def candidates(label):
        return [key for key, labels in idle.items() if label in labels]
    census = (f'common pool group3: {online} online, {len(idle)} idle; '
              f'{len(candidates("ci1"))} general idle, {len(candidates("ci1-priority"))} priority idle')
    print(census)
    print(census, file=summary)
    if event == "merge_group" and env.get("MERGE_OVERFLOW") == "on":
        merge_need = env.get("MERGE_NEED", "3")
        run_id = env.get("RUN_ID", "")
        if (merge_need.isascii() and merge_need.isdigit() and int(merge_need) > 0
                and run_id.isascii() and run_id.isdigit() and int(run_id) > 0):
            if len(candidates("ci1-priority")) < int(merge_need):
                # The existing Linux profile supplies the same tools and KVM.
                # Every required merge job follows this single, run-bound choice.
                emit("ci1", f"namespace-profile-linux-x86-64;job.priority=1;github.run-id={run_id}")
                print('Merge overflow: **Namespace** (qualified pool census below admission minimum)', file=summary)
                return
        else:
            print('Merge overflow refused: invalid admission minimum or run identity', file=summary)
    if priority:
        emit("ci1", "ci1-priority")
        # A dual-labelled runner can take the priority primary; do not also offer it.
        available = candidates("ci1-priority")
        if available:
            idle.pop(available[0])
        if event == "merge_group" or env.get("MODE") == "priority":
            return
    elif len(candidates("ci1")) >= int(need):
        emit("ci1", "ci1")
        idle.pop(candidates("ci1")[0])
    else:
        print('Primary runner: **Namespace** (minimum idle count unmet)', file=summary)
    for key in ("ci1_secondary", "ci1_mail"):
        available = candidates("ci1")
        if available:
            emit(key, "ci1")
            idle.pop(available[0])
        else:
            print(f'{key}: **Namespace** (no distinct idle general worker)', file=summary)


if __name__ == "__main__":
    main()
