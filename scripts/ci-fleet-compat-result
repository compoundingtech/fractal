#!/usr/bin/env python3
"""linux-fleet-compat's result out of a fleet-compat stage's report (docs/keyed-clippy.md, section 3).

  FLEET_COMPAT_REPORT=DIR scripts/ci-fleet-compat-result

The local command a linux-fleet-compat note records, as scripts/ci-clippy-result is linux-clippy's. scripts/st-test runs the fleet-compat
stage once, inside linux-gate's run when that runs (so it never runs twice) or else alone (scripts/ci-local fleet-compat), with
CI_FLEET_COMPAT_REPORT=DIR. The stage leaves the cargo messages of its integration-test build in DIR, and `passed` only when the whole
stage passed (the pty mailbox record and every previous-release test). This exits 0 only when `passed` is there and every repository file
that build read is in linux-fleet-compat's input key (scripts/dep-info-check against the tree's skip policy). linux-gate's command never
reads the policy; this does, after the stage. The report comes from the environment so the recorded argv stays the one the skip policy
pins, and the note says which run made it (run_command_sha256).
"""
import os
from pathlib import Path
import subprocess
import sys

sys.dont_write_bytecode = True

POLICY = '.st/evidence-skip-policy.json'


# arn:lmig:smalltalk:2026-10-27-dot-fractal-config — checkout missing-only bridge, as scripts/ci-linux's keyed_policy resolves it for CI's
# linux-fleet-compat job: the .fractal/ copy when the checkout has one, else the .st/ path.
def policy_path(path=POLICY):
    preferred = os.path.join('.fractal', os.path.basename(path))
    try:
        os.lstat(preferred)
    except FileNotFoundError:
        return path
    return preferred


def main(argv):
    report = os.environ.get('FLEET_COMPAT_REPORT')
    if argv or not report:
        print('usage: FLEET_COMPAT_REPORT=DIR scripts/ci-fleet-compat-result', file=sys.stderr)
        return 2
    if not (Path(report) / 'passed').is_file():
        print(f'ci-fleet-compat-result: the fleet-compat stage did not pass ({report} has no `passed`)')
        return 1
    check = [sys.executable, str(Path(__file__).resolve().parent / 'dep-info-check'), '--logs', report, '--check', 'linux-fleet-compat',
             '--policy', policy_path(), '--jsonl', 'fleet-compat-*.jsonl']
    return subprocess.run(check).returncode


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
