#!/usr/bin/env python3
"""scripts/ci-signed-tree against real repositories: it judges a pull request head as DATA, from the base's scripts, and never fails."""
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import unittest

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
SCRIPT = ROOT / 'scripts/ci-signed-tree'
loader = importlib.machinery.SourceFileLoader('evidence_verify_test', str(ROOT / 'scripts/evidence-verify-test'))
support = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(support)
Fixture, OBSERVED, two_check_policy = support.Fixture, support.OBSERVED, support.two_check_policy
COMMAND = ('github-actions', 'org/repo', '.github/workflows/fleet.yml', 'unit')
LANES = {'version': 1, 'lanes': {'unit': {'argv': ['github-actions', 'org/repo', '.github/workflows/fleet.yml', 'unit'],
                                          'definition_paths': ['scripts/lane.sh']}}}


class SignedTree(unittest.TestCase):
    def setUp(self):
        self.f = Fixture()
        self.addCleanup(self.f.tmp.cleanup)
        self.ci = self.f.key('ci', 'machine/ci1')
        (self.f.repo / 'scripts').mkdir()
        for name in ('ci-signed-tree', 'evidence-verify'):
            shutil.copy(ROOT / 'scripts' / name, self.f.repo / 'scripts' / name)
        (self.f.repo / 'scripts/lane.sh').write_text('lane\n')
        (self.f.repo / '.st').mkdir()
        (self.f.repo / '.st/evidence-keys').write_text(self.f.keys.read_text())
        self.set_policy(two_check_policy('shadow'))
        (self.f.repo / '.st/required-lanes.json').write_text(json.dumps(LANES))
        self.f.git('add', '-A')
        self.f.git('commit', '-q', '-m', 'base')
        self.f.git('branch', '-M', 'main')

    def set_policy(self, text):
        (self.f.repo / '.st/evidence-skip-policy.json').write_text(text)

    def pull_request(self, changes, number=1):
        """A head commit for pull request `number` (stored as refs/pull/N/head, never checked out in the base checkout)."""
        self.f.git('checkout', '-q', '-b', f'pr{number}', 'main')
        for name, content in changes.items():
            (self.f.repo / name).write_text(content)
        self.f.git('add', '-A')
        self.f.git('commit', '-q', '-m', f'pr {number}')
        head, tree = self.f.git('rev-parse', 'HEAD'), self.f.git('rev-parse', 'HEAD^{tree}')
        self.f.git('update-ref', f'refs/pull/{number}/head', head)
        self.f.git('checkout', '-q', 'main')
        return head, tree

    def note(self, head, tree, **kwargs):
        defaults = dict(runner=OBSERVED, command=COMMAND, check='unit')
        defaults.update(kwargs)
        return self.f.note(head, tree, self.ci, 'machine/ci1', **defaults)

    def run_job(self, head, number=1, base_changes=None, **env):
        """Run the script in a fresh clone of the repository at main, the way the workflow's checkout of the base branch is."""
        checkout = self.f.root / f'base-checkout-{len(list(self.f.root.glob("base-checkout-*")))}'
        subprocess.run(['git', 'clone', '-q', str(self.f.repo), str(checkout)], check=True, capture_output=True)
        self.last_checkout = checkout
        summary, output = self.f.root / 'summary', self.f.root / 'output'
        summary.write_text('')
        output.write_text('')
        environment = dict(os.environ, REPOSITORY='org/repo', PR_NUMBER=str(number), PR_HEAD_SHA=head, PR_HEAD_REPOSITORY='org/repo',
                           PR_DRAFT='false', GITHUB_STEP_SUMMARY=str(summary), GITHUB_OUTPUT=str(output),
                           GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_SYSTEM='/dev/null')
        environment.update(env)
        before = subprocess.run(['git', '-C', str(checkout), 'rev-parse', 'HEAD'], capture_output=True).stdout
        done = subprocess.run([sys.executable, str(checkout / 'scripts/ci-signed-tree')], cwd=checkout, env=environment, capture_output=True)
        self.assertEqual(done.returncode, 0, done.stderr)  # a shadow job never fails
        status = subprocess.run(['git', '-C', str(checkout), 'status', '--porcelain'], capture_output=True).stdout
        self.assertEqual(status, b'', 'the pull request must never be checked out into the base checkout')
        self.assertEqual(subprocess.run(['git', '-C', str(checkout), 'rev-parse', 'HEAD'], capture_output=True).stdout, before)
        line = done.stdout.decode().strip()
        self.assertEqual(line, summary.read_text().strip())
        fields = dict(part.split('=', 1) for part in line.split()[2:])
        self.assertTrue(line.startswith('signed-tree v1 '), line)
        self.assertEqual(output.read_text().strip(), f'decision={fields["decision"]}')
        return fields

    def test_a_pull_request_without_a_note_would_be_rejected_and_the_job_still_passes(self):
        head, tree = self.pull_request({'src.txt': 'one\n'})
        fields = self.run_job(head)
        self.assertEqual((fields['decision'], fields['tree'], fields['lanes']), ('would-reject', tree, 'unit:no_record'))

    def test_a_trusted_note_for_the_head_tree_satisfies_the_requirement(self):
        head, tree = self.pull_request({'src.txt': 'two\n'})
        rules = support.evidence_verify.lane_rules((self.f.repo / '.st/required-lanes.json').read_text(), 'unit')
        digest = support.evidence_verify.lane_definition(str(self.f.repo), self.f.git('rev-parse', 'main^{tree}'), tree, rules)['sha256']
        self.note(head, tree, seconds=0)  # a note without the lane digest does not count once the base defines the lane
        self.assertEqual(self.run_job(head)['lanes'], 'unit:wrong_definition')
        self.note(head, tree, inputs={'lane_definition_sha256': digest}, seconds=5)  # dated later: two passes with equal dates are ordered by ref iteration
        fields = self.run_job(head)
        self.assertEqual((fields['decision'], fields['reason'], fields['lanes']), ('ok', 'satisfied', 'unit:ok'))

    def test_only_the_head_trees_own_notes_are_fetched(self):
        other_head, other_tree = self.pull_request({'src.txt': 'elsewhere\n'}, number=2)
        self.note(other_head, other_tree)
        head, tree = self.pull_request({'src.txt': 'mine\n'}, number=1)
        mine = self.note(head, tree)
        self.assertEqual(self.run_job(head)['lanes'], 'unit:wrong_definition')  # found (a note without the lane digest), not no_record
        fetched = subprocess.run(['git', '-C', str(self.last_checkout), 'for-each-ref', '--format=%(refname)', 'refs/notes/'], capture_output=True, text=True).stdout.split()
        self.assertEqual(fetched, [f'refs/notes/evidence/{tree}/{mine}'])

    def test_a_record_reachable_only_through_the_input_index_is_found(self):
        """The job projects the PULL REQUEST HEAD (not whatever FETCH_HEAD is after the notes fetch) to fetch the input-keyed refs."""
        doc = json.loads(two_check_policy('shadow'))
        doc['checks']['unit']['inputs'] = ['src.txt']
        self.set_policy(json.dumps(doc))
        self.f.git('add', '-A')
        self.f.git('commit', '-q', '-m', 'unit declares inputs')
        old_head, old_tree = self.pull_request({'src.txt': 'same\n', 'other.txt': 'one\n'}, number=1)
        key = support.evidence_verify.project(str(self.f.repo), old_tree, ['src.txt'])
        record = self.note(old_head, old_tree, inputs={'source_inputs': key})
        self.f.git('update-ref', f'refs/notes/evidence-input/unit/{key}/{record}', record)
        head, tree = self.pull_request({'src.txt': 'same\n', 'other.txt': 'two\n'}, number=2)  # another tree, the same declared inputs
        self.assertNotEqual(tree, old_tree)
        # No record under the head's own tree: it is found only through refs/notes/evidence-input/unit/<key>/, which the job must fetch.
        fields = self.run_job(head, number=2)
        self.assertEqual(fields['lanes'], 'unit:wrong_definition')  # found (the note lacks the lane digest), not no_record
        fetched = subprocess.run(['git', '-C', str(self.last_checkout), 'for-each-ref', '--format=%(refname)', 'refs/notes/'], capture_output=True, text=True).stdout.split()
        self.assertEqual(fetched, [f'refs/notes/evidence-input/unit/{key}/{record}'])

    def test_a_bad_note_is_reported_with_its_reason_and_a_reject_mode_is_still_only_reported(self):
        head, tree = self.pull_request({'src.txt': 'three\n'})
        self.note(head, tree, exit_code=1)
        self.assertEqual(self.run_job(head)['lanes'], 'unit:check_failed')
        self.set_policy(two_check_policy('reject'))
        self.f.git('add', '-A')
        self.f.git('commit', '-q', '-m', 'reject')
        fields = self.run_job(head)  # exit code 0 is asserted in run_job: the job never fails
        self.assertEqual((fields['decision'], fields['lanes']), ('reject', 'unit:check_failed'))

    def test_nothing_is_fetched_when_no_check_requires_a_note(self):
        self.set_policy(two_check_policy())
        self.f.git('add', '-A')
        self.f.git('commit', '-q', '-m', 'require off')
        head, tree = self.pull_request({'src.txt': 'four\n'})
        # make any fetch of the head fail: the no-op must not need it
        self.f.git('update-ref', '-d', 'refs/pull/1/head')
        fields = self.run_job(head)
        self.assertEqual((fields['decision'], fields['reason']), ('ok', 'nothing-requires-a-signed-note'))

    def test_forks_and_drafts_are_not_judged(self):
        head, _ = self.pull_request({'src.txt': 'five\n'})
        self.assertEqual(self.run_job(head, PR_HEAD_REPOSITORY='someone/fork')['decision'], 'skipped')
        self.assertEqual(self.run_job(head, PR_DRAFT='true')['reason'], 'draft')

    def test_a_pull_request_that_rewrites_the_job_and_the_verifier_changes_nothing(self):
        marker = self.f.root / 'ran-pr-code'
        evil = f"#!/usr/bin/env python3\nopen({str(marker)!r}, 'w').write('x')\nprint('{{\"satisfied\": true, \"decision\": \"ok\", \"lanes\": {{}}}}')\n"
        head, tree = self.pull_request({'scripts/evidence-verify': evil, 'scripts/ci-signed-tree': evil, '.st/evidence-skip-policy.json': two_check_policy(),
                                        '.st/required-lanes.json': '{}'})
        fields = self.run_job(head)
        self.assertFalse(marker.exists(), 'code from the pull request ran')
        self.assertEqual((fields['decision'], fields['lanes']), ('would-reject', 'unit:no_record'))  # judged by the BASE policy and verifier

    def test_the_lane_file_at_the_base_holds_the_head_to_its_lane(self):
        head, tree = self.pull_request({'scripts/lane.sh': 'lane, but fewer tests\n'})
        self.note(head, tree, inputs={'lane_definition_sha256': 'f' * 64})
        fields = self.run_job(head)
        self.assertEqual((fields['decision'], fields['lanes']), ('would-reject', 'unit:definition_changed'))

    def test_errors_are_reported_and_never_fail_the_job(self):
        head, _ = self.pull_request({'src.txt': 'six\n'})
        self.assertEqual(self.run_job(head, PR_NUMBER='x')['reason'], 'bad-context')
        self.assertEqual(self.run_job('nothex')['decision'], 'error')
        self.assertEqual(self.run_job('a' * 40)['reason'], 'fetched-head-differs-from-the-event')
        self.assertEqual(self.run_job(head, number=2)['reason'], 'could-not-fetch-the-head')  # no such pull request
        self.set_policy('not json')
        self.f.git('add', '-A')
        self.f.git('commit', '-q', '-m', 'broken policy')
        self.assertEqual(self.run_job(head)['reason'], 'no-readable-policy-at-base')
        self.set_policy(json.dumps({'version': 1, 'checks': {'unit': {'require': 'sometimes'}}}))
        self.f.git('add', '-A')
        self.f.git('commit', '-q', '-m', 'invalid require')
        fields = self.run_job(head)
        self.assertEqual((fields['decision'], fields['reason']), ('error', 'verifier:error'))  # a malformed require is refused, not ignored


if __name__ == '__main__':
    unittest.main()
