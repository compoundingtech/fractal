#!/usr/bin/env python3
"""The perf slot: one performance load run at a time on a host, others wait in line.

Run `scripts/ci-perf-slot --help` for what it is and how to use it. `scripts/ci-perf load` takes
the slot by itself on hetz2 outside CI, so a builder does not have to remember to.
"""
import argparse
import contextlib
import errno
import fcntl
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import time

MAX_TIMEOUT = 2 * 3600
GRACE = float(os.environ.get('PERF_SLOT_GRACE', '10'))
POLL = float(os.environ.get('PERF_SLOT_POLL', '0.5'))
REPORT_EVERY = 60

HELP = """\
The perf slot keeps `perf-load` runs on this host from overlapping. A run takes the slot, runs
your command in its own process group, and gives the slot back when the command ends. Anyone
else who asks while it is held waits in line, oldest first, and sees who holds it, since when,
and for which branch.

  scripts/ci-perf-slot [--timeout 90m] [--for TEXT] -- COMMAND...   take the slot, run COMMAND
  scripts/ci-perf-slot --status                                     who holds it, who waits

On hetz2, `scripts/ci-perf load` does this itself (outside CI), so measure a change with:

  nix develop .#perf -c bash scripts/ci-perf load

How the slot is held
  The kernel's flock on %(dir)s/slot.lock is held by a watchdog that lives exactly as long as
  the run. If the run or this wrapper is killed, even with SIGKILL, the watchdog kills the run's
  whole process group and the slot frees at once. A run past its timeout (default and maximum 2h,
  ask for less with --timeout; waiting in line does not count) is stopped with SIGTERM, then
  SIGKILL after %(grace)gs, and the slot frees; the exit status is 124.

Measuring a change (docs/ci.md, "Performance gate")
  Run the load test above on your branch alone: the slot makes sure nothing else of ours is
  measuring at the same time. Its report is a table of each request's p50/p99/max against its
  budget, and the daemon's CPU in cores. The budgets that apply are the absolute p99 budget of
  every request and the 2-core CPU ceiling (slo/targets.toml); locally there is no baseline, so
  those are the whole gate. CI adds the relative gate, twice the worst of main's last five
  reports, when your PR runs Performance. A run that misses a budget fails; do not retry it into
  passing, find the cause.

Evidence for the PR
  Paste the report table the run printed (or the summary file named at its end), the branch and
  commit it ran on, and one line saying it ran alone in the slot. Say which budgets it came near.
  For a change that should make a path faster or cheaper, also run main's commit the same way
  and put both tables side by side. Intake reviews that evidence; no agent is a gate.

Environment
  PERF_SLOT_DIR   where the lock, holder record and line live (default %(dir)s)
""" % {'dir': '/var/tmp/perf-slot', 'grace': GRACE}


def duration(text):
    units = {'s': 1, 'm': 60, 'h': 3600}
    try:
        seconds = float(text[:-1]) * units[text[-1]] if text[-1] in units else float(text)
    except (ValueError, IndexError):
        raise argparse.ArgumentTypeError('not a duration: %r (try 90m, 2h or 600)' % text)
    if not 0 < seconds <= MAX_TIMEOUT:
        raise argparse.ArgumentTypeError('timeout must be over 0 and at most 2h')
    return seconds


def slot_dir():
    path = Path(os.environ.get('PERF_SLOT_DIR', '/var/tmp/perf-slot'))
    for directory in (path, path / 'line'):
        directory.mkdir(parents=True, exist_ok=True)
        with contextlib.suppress(PermissionError):
            directory.chmod(0o1777)
    return path


def lock(fd, nonblocking=True):
    try:
        fcntl.flock(fd, fcntl.LOCK_EX | (fcntl.LOCK_NB if nonblocking else 0))
        return True
    except OSError as error:
        if error.errno in (errno.EWOULDBLOCK, errno.EAGAIN):
            return False
        raise


def open_shared(path):
    fd = os.open(path, os.O_RDWR | os.O_CREAT, 0o666)
    with contextlib.suppress(PermissionError):
        os.fchmod(fd, 0o666)
    return fd


def read_holder(directory):
    try:
        return json.loads((directory / 'holder.json').read_text())
    except (OSError, ValueError):
        return None


def clock(seconds):
    return time.strftime('%H:%M:%S', time.localtime(seconds))


def age(seconds):
    seconds = int(max(0, seconds))
    return '%dh%02dm' % (seconds // 3600, seconds % 3600 // 60) if seconds >= 3600 else \
        '%dm%02ds' % (seconds // 60, seconds % 60)


def describe(holder):
    if not holder:
        return 'someone (no record)'
    return '%s (pid %s) for %s, since %s (%s ago), stops by %s' % (
        holder.get('user', '?'), holder.get('pid', '?'), holder.get('for', '?'),
        clock(holder['since']), age(time.time() - holder['since']), clock(holder['deadline']))


def line(directory):
    """Live tickets, oldest first; a ticket whose waiter died is removed."""
    live = []
    for ticket in sorted((directory / 'line').iterdir()):
        try:
            fd = os.open(ticket, os.O_RDWR)
        except OSError:
            continue
        try:
            if lock(fd):  # nobody holds it: its waiter is gone
                with contextlib.suppress(OSError):
                    ticket.unlink()
            else:
                live.append(ticket)
        finally:
            os.close(fd)
    return live


def status(directory):
    holder_fd = open_shared(directory / 'slot.lock')
    held = not lock(holder_fd)
    os.close(holder_fd)
    if not held:
        print('perf slot free')
    else:
        print('perf slot held by ' + describe(read_holder(directory)))
    waiting = line(directory)
    for number, ticket in enumerate(waiting, 1):
        info = ticket.name.split('-', 2)
        print('  %d. %s waiting since %s' % (number, info[2] if len(info) > 2 else '?',
                                              clock(int(info[0]) / 1e9)))


def branch_of(cwd):
    def git(*args):
        try:
            return subprocess.check_output(['git', '-C', cwd, *args], text=True,
                                           stderr=subprocess.DEVNULL).strip()
        except (OSError, subprocess.CalledProcessError):
            return ''
    branch = git('rev-parse', '--abbrev-ref', 'HEAD')
    sha = git('rev-parse', '--short', 'HEAD')
    return '%s@%s' % (branch, sha) if branch else 'unknown branch'


def acquire(directory, who):
    """Wait in line, oldest first, then hold the slot's flock. Returns the held fd."""
    ticket = directory / 'line' / ('%020d-%d-%s' % (time.time_ns(), os.getpid(), who))
    ticket_fd = open_shared(ticket)
    lock(ticket_fd)
    slot_fd = open_shared(directory / 'slot.lock')
    last, announced = None, 0.0
    try:
        while True:
            waiting = line(directory)
            first = waiting and waiting[0] == ticket
            if first and lock(slot_fd):
                return slot_fd
            place = waiting.index(ticket) + 1 if ticket in waiting else 1
            holder = read_holder(directory)
            state = (place, holder and holder.get('pid'))
            if state != last or time.time() - announced > REPORT_EVERY:
                print('perf slot busy: held by %s. You are number %d in line; waiting.' % (
                    describe(holder) if holder else 'a run that is starting', place), file=sys.stderr, flush=True)
                last, announced = state, time.time()
            time.sleep(POLL)
    except BaseException:
        os.close(slot_fd)
        raise
    finally:
        with contextlib.suppress(OSError):
            ticket.unlink()
        os.close(ticket_fd)


def forget(directory, pid):
    """Drop the holder record if it is still ours; called while the flock is held."""
    holder = read_holder(directory)
    if holder and holder.get('pid') == pid:
        with contextlib.suppress(OSError):
            (directory / 'holder.json').unlink()


def watchdog(directory, gate, group, owner):
    """Hold the slot for the run's whole life. If the wrapper dies without saying it is done,
    kill the run's process group, wait for it to be gone, then let the slot go."""
    os.setsid()
    for number in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(number, signal.SIG_IGN)
    if os.read(gate, 1) != b'x':
        deadline = time.time() + 30
        while time.time() < deadline:
            try:
                os.killpg(group, signal.SIGKILL)
            except ProcessLookupError:
                break
            time.sleep(0.05)
        forget(directory, owner)
    os._exit(0)


def run(args):
    directory = slot_dir()
    cwd = os.getcwd()
    purpose = args.purpose or branch_of(cwd)
    slot_fd = acquire(directory, purpose.replace('/', '_').replace('-', '_')[:60])
    since = time.time()
    holder = {'pid': os.getpid(), 'user': os.environ.get('USER') or str(os.getuid()), 'for': purpose,
              'cwd': cwd, 'command': ' '.join(args.command), 'since': since,
              'deadline': since + args.timeout}
    scratch = directory / ('holder.%d.tmp' % os.getpid())
    scratch.write_text(json.dumps(holder))
    scratch.chmod(0o666)
    scratch.replace(directory / 'holder.json')
    print('perf slot taken for %s; stops by %s (%s)' % (purpose, clock(holder['deadline']), age(args.timeout)),
          file=sys.stderr, flush=True)

    stopping = []
    for number in (signal.SIGINT, signal.SIGTERM, signal.SIGHUP):
        signal.signal(number, lambda received, _frame: stopping.append(received))
    owner = os.getpid()
    child = subprocess.Popen(args.command, start_new_session=True,
                             env={**os.environ, 'ST_PERF_SLOT_HELD': str(os.getpid())})
    gate_read, gate_write = os.pipe()
    guard = os.fork()
    if guard == 0:
        os.close(gate_write)
        watchdog(directory, gate_read, child.pid, owner)
    os.close(gate_read)

    outcome = None
    deadline = since + args.timeout
    while child.poll() is None:
        if stopping:
            outcome = 128 + stopping[0]
            print('perf slot: signal %d, stopping the run' % stopping[0], file=sys.stderr, flush=True)
        elif time.time() >= deadline:
            outcome = 124
            print('perf slot: the run passed its %s timeout; stopping it' % age(args.timeout),
                  file=sys.stderr, flush=True)
        if outcome is not None:
            with contextlib.suppress(ProcessLookupError):
                os.killpg(child.pid, signal.SIGTERM)
            try:
                child.wait(GRACE)
            except subprocess.TimeoutExpired:
                with contextlib.suppress(ProcessLookupError):
                    os.killpg(child.pid, signal.SIGKILL)
                child.wait()
            break
        time.sleep(0.1)
    if outcome is None:
        outcome = child.returncode if child.returncode >= 0 else 128 - child.returncode
    # Say the run is over, wait for the watchdog (which holds the flock) to leave, then free the slot.
    forget(directory, os.getpid())
    os.write(gate_write, b'x')
    os.close(gate_write)
    os.waitpid(guard, 0)
    os.close(slot_fd)
    return outcome


def main():
    parser = argparse.ArgumentParser(prog='scripts/ci-perf-slot', add_help=False)
    parser.add_argument('-h', '--help', action='store_true')
    parser.add_argument('--status', action='store_true')
    parser.add_argument('--timeout', type=duration, default=MAX_TIMEOUT)
    parser.add_argument('--for', dest='purpose')
    parser.add_argument('command', nargs=argparse.REMAINDER)
    args = parser.parse_args()
    if args.help:
        sys.stdout.write(HELP.replace('/var/tmp/perf-slot', os.environ.get('PERF_SLOT_DIR', '/var/tmp/perf-slot')))
        return 0
    if args.status:
        status(slot_dir())
        return 0
    if args.command[:1] == ['--']:
        args.command = args.command[1:]
    if not args.command:
        parser.error('give a command after --, or use --help')
    try:
        return run(args)
    except KeyboardInterrupt:
        return 130


if __name__ == '__main__':
    sys.exit(main())
