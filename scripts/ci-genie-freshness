#!/usr/bin/env bash
# The whole `genie-freshness` required check, from a checkout or a Nix sandbox.
# CI runs it in the genie shell; `checks.genie-freshness` runs it in a derivation. One list, so
# the two cannot drift. It needs git, python3, tar, jq, zstd, ssh-keygen and `genie`, and no network.
#
# Its evidence key is the whole tree, so it holds what reads the whole tree: the generated files, the licenses, the lints and the few
# self-tests that read crates/ or apps/. The other self-tests read only the CI scripts and what they declare, and are the separate
# `ci-script-tests` check (scripts/ci-script-tests), whose key a pull request that touches none of that leaves alone.
set -euo pipefail
. "$(dirname "$0")/script-test-supervisor"
# Run from a git hook or alias this would see the caller's GIT_DIR, and every fixture test below would act on the caller's repository.
. "$(dirname "$0")/git-env-clean"
# Fixture repositories must not inherit a developer's hooks, identity or signing settings.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
cd "$(dirname "$0")/.."
. scripts/ci-parallel-tests

python3 scripts/ci-fractal-web-licenses --check-lockfile
parallel_tests \
  ci-fractal-web-licenses-test check-sqlite-large-values-test check-public-repo-test check-native-names-test \
  evidence-verify-test check-ci-test-paths ci-fractal-web-test rust-test-keys-test
python3 scripts/check-sqlite-large-values
# Whole-tree lints live here, not in the Linux gate: this check's evidence key is the whole tree, while the Linux gate
# may skip on a note for another tree with the same declared inputs, which a page under apps/ does not change.
python3 scripts/check-public-repo
python3 scripts/check-native-names
# Every lane's definition_paths cover what its commands execute or read (the whole tree; ci-script-tests' copy sees only its inputs).
python3 scripts/lane-definition-closure --check
genie --check
