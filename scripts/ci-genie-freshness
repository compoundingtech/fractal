#!/usr/bin/env bash
# The whole `genie-freshness` required check, from a checkout or a Nix sandbox.
# CI runs it in the genie shell; `checks.genie-freshness` runs it in a derivation. One list, so
# the two cannot drift. It needs git, python3, tar, jq, zstd, ssh-keygen and `genie`, and no network.
set -euo pipefail
. "$(dirname "$0")/script-test-supervisor"
# Run from a git hook or alias this would see the caller's GIT_DIR, and every fixture test below would act on the caller's repository.
. "$(dirname "$0")/git-env-clean"
cd "$(dirname "$0")/.."

python3 scripts/script-process-test
python3 scripts/ci-fractal-web-licenses-test
python3 scripts/ci-fractal-web-licenses --check-lockfile
for test in \
  ci-ready-pr-test ci-draft-admission-test ci-workflow-concurrency-test check-ci-runner-test \
  ci-namespace-usage-test ci-mail-redelivery-canaries-test ci-test-partitions-test \
  ci-test-archive-test ci-build-memory-test ci-evidence-source-test check-ci-test-paths ci-queue-watch-test \
  check-main-ci-test ci-perf-cache-test ci-perf-slot-test ci-perf-scope-test \
  ci-cache-audit-test ci-genie-cache-cleanup-test ci-fractal-web-test web-skip-proof-test ci-evidence-observe-test evidence-verify-test evidence-lane-trace-test evidence-gc-test evidence-log-test ci-signed-tree-test ci-evidence-slo-test evidence-keygen-test st-test-test ci-local-test evidence-prepush-test evidence-wrap-test ci-evidence-signing-test evidence-publish-test ci-evidence-shadow-test nix-check-facts-test \
  check-pty-boot-identities-test \
  ci-evidence-gate-test evidence-flip-ready-test evidence-sign-hardening-test ci-daily-long-report-test ci-nextest-flaky-test nix-typescript-client-test nix-evidence-job-test ci-nextest-test; do
  python3 "scripts/$test"
done
python3 scripts/check-sqlite-large-values-test
python3 scripts/check-sqlite-large-values
# Whole-tree lints live here, not in the Linux gate: this check's evidence key is the whole tree, while the Linux gate
# may skip on a note for another tree with the same declared inputs, which a page under apps/ does not change.
python3 scripts/check-public-repo-test
python3 scripts/check-public-repo
python3 scripts/check-native-names-test
python3 scripts/check-native-names
genie --check
