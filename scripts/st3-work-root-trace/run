#!/usr/bin/env bash
# Prove that onboarding stays out of the folders macOS guards, and that uninstall keeps the work
# root. A throwaway HOME holds Documents, Desktop and Downloads with a canary file each. setup, a
# daemon, a few reads and `st uninstall` run under strace, which records every file the programs
# open, stat or list. The trace must not name any guarded folder, and no program may list HOME
# itself. The work root is created by setup, keeps a file the person made, and survives uninstall.
#
# Usage: run ST3_BINARY PTY_BINARY [OUT_DIR]
#
# The daemon refuses a process that descends from another seat, so run this outside a seat's
# process tree, for example with `systemd-run --user --wait --pipe --collect`.
#
# Writes trace.txt, the transcript and result.txt to OUT_DIR (default: a kept temporary directory).
# Exits 0 only when every assertion holds.
set -Eeuo pipefail
signal_helper="$(cd "$(dirname "$0")/.." && pwd)/script_process.py"
python3 "$signal_helper" --check-platform

st3="$(readlink -f "$1")"
pty="$(readlink -f "$2")"
out="${3:-$(mktemp -d)}"
mkdir -p "$out"
out="$(cd "$out" && pwd)"
home="$(mktemp -d "${TMPDIR:-/var/tmp}/st-work-root.XXXXXX")"
tools="$(dirname "$home")/$(basename "$home").tools"
mkdir -p "$tools"
cp --reflink=auto "$pty" "$tools/pty"
cp --reflink=auto "$st3" "$tools/st3"
st3="$tools/st3"
for profile in .bash_profile .zprofile; do
  printf 'export PATH="%s:$PATH"\n' "$tools" >"$home/$profile"
done
trap 'python3 "$signal_helper" all 15 --env "HOME=$home" 2>/dev/null || true; rm -rf "$home" "$tools"' EXIT

# The folders a first listing of makes macOS ask the person for access.
guarded=(Documents Desktop Downloads Pictures Movies Music Library)
for folder in "${guarded[@]}"; do
  mkdir -p "$home/$folder"
  echo canary >"$home/$folder/canary.txt"
done

system="$(dirname "$(command -v ls)")"
path="$tools:$system:/usr/bin:/bin"
trace="$out/trace.txt"
: >"$trace"
# Follow every child and record the calls that name a path or list a directory.
traced=(strace -f -qq -A -s 512 -o "$trace"
  -e trace=openat,open,stat,lstat,newfstatat,statx,access,faccessat,faccessat2,readlink,readlinkat,getdents64,chdir,execve)
st=(env -i HOME="$home" PATH="$path" USER="$(id -un)" LANG=C.UTF-8 SHELL=/bin/sh
  HOSTNAME=proofhost "$st3")

{
  echo "== setup, daemon and reads, traced"
  "${traced[@]}" "${st[@]}" setup --person avery --yes --service false --start false --harness none \
    >"$out/setup.txt" 2>&1 || { echo "FAIL: setup"; cat "$out/setup.txt"; exit 1; }
  cat "$out/setup.txt"
  grep -q "^Work folder: $home/st\." "$out/setup.txt" \
    || { echo "FAIL: setup did not print the work folder once"; exit 1; }
  [ "$(grep -c '^Work folder:' "$out/setup.txt")" = 1 ] \
    || { echo "FAIL: setup printed the work folder more than once"; exit 1; }
  test -d "$home/st" || { echo "FAIL: setup did not create the work folder"; exit 1; }
  # A daemon under the same trace, until it answers and does its first reads.
  "${traced[@]}" "${st[@]}" up >"$out/daemon.log" 2>&1 &
  for _ in $(seq 1 60); do
    "${st[@]}" --daemon-wait 0 agents ls >/dev/null 2>&1 && break
    sleep 0.5
  done
  "${st[@]}" --daemon-wait 0 agents ls >/dev/null || { echo "FAIL: the daemon did not start"; tail -20 "$out/daemon.log"; exit 1; }
  # Something a person made in the work folder, with a nested folder as an agent leaves.
  mkdir -p "$home/st/agents/site"
  echo "my notes" >"$home/st/agents/site/notes.txt"
  python3 "$signal_helper" all 15 --env "HOME=$home" 2>/dev/null || true
  sleep 2

  echo "== uninstall, traced"
  "${traced[@]}" "${st[@]}" uninstall --yes --erase-local-graph >"$out/uninstall.txt" 2>&1 \
    || { echo "FAIL: uninstall"; cat "$out/uninstall.txt"; exit 1; }
  cat "$out/uninstall.txt"
  grep -q "^kept.*$home/st" "$out/uninstall.txt" \
    || { echo "FAIL: uninstall did not say it kept the work folder"; exit 1; }
  test "$(cat "$home/st/agents/site/notes.txt")" = "my notes" \
    || { echo "FAIL: uninstall changed the work folder"; exit 1; }
  echo "PASS: uninstall kept the work folder and said so"

  echo "== an instance keeps its work folder too"
  inst=("${st[@]}" --instance kept)
  "${inst[@]}" setup --person avery --yes --service false --start false --harness none \
    >"$out/instance-setup.txt" 2>&1 || { echo "FAIL: instance setup"; cat "$out/instance-setup.txt"; exit 1; }
  grep -q "^Work folder: $home/.st-instance/kept/work\." "$out/instance-setup.txt" \
    || { echo "FAIL: the instance work folder is not below the instance"; cat "$out/instance-setup.txt"; exit 1; }
  echo "my instance notes" >"$home/.st-instance/kept/work/notes.txt"
  "${inst[@]}" uninstall --yes --erase-local-graph >"$out/instance-uninstall.txt" 2>&1 \
    || { echo "FAIL: instance uninstall"; cat "$out/instance-uninstall.txt"; exit 1; }
  grep -q "^kept.*kept/work" "$out/instance-uninstall.txt" \
    || { echo "FAIL: instance uninstall did not say it kept the work folder"; exit 1; }
  rest="$(cd "$home/.st-instance/kept" && find . -mindepth 1 -not -path ./work -not -path './work/*')"
  [ -z "$rest" ] || { echo "FAIL: the instance left more than its work folder:"; echo "$rest"; exit 1; }
  test "$(cat "$home/.st-instance/kept/work/notes.txt")" = "my instance notes" \
    || { echo "FAIL: instance uninstall changed the work folder"; exit 1; }
  echo "PASS: the instance uninstall removed everything but its work folder"

  echo "== the trace"
  echo "trace lines: $(wc -l <"$trace")"
  status=0
  for folder in "${guarded[@]}"; do
    if grep -F "\"$home/$folder" "$trace" >"$out/guarded-$folder.txt"; then
      echo "FAIL: the trace names $home/$folder:"
      head -5 "$out/guarded-$folder.txt"
      status=1
    fi
  done
  # Listing HOME itself: open it as a directory.
  if grep -E "(openat|open)\(.*\"$home\", [^)]*O_DIRECTORY" "$trace" >"$out/home-listing.txt"; then
    echo "FAIL: a program opened HOME as a directory:"
    head -5 "$out/home-listing.txt"
    status=1
  fi
  [ "$status" = 0 ] || exit 1
  echo "PASS: no guarded folder is named in the trace and HOME is never listed"
  test -f "$home/Documents/canary.txt" || { echo "FAIL: a canary file is gone"; exit 1; }
} 2>&1 | tee "$out/transcript.txt"
status=${PIPESTATUS[0]}
echo "$status" >"$out/result.txt"
exit "$status"
