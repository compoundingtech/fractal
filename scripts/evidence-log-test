#!/usr/bin/env python3
"""scripts/evidence-log against real repositories and signed records: a bare remote plays GitHub, a second bare repository is the
host's copy. What is accepted and refused, the signed heartbeat, publishing, a deleted record reported and restored, GC lines
before GC deletes, a head that is not ours, a second publisher's older chain refused, and a signer that fails."""
import contextlib
import importlib.machinery
import importlib.util
import io
import json
import os
import signal
from pathlib import Path
import subprocess
import sys
import unittest
from unittest import mock

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
LOG = ROOT / 'scripts/evidence-log'
TIMER = ROOT / 'scripts/evidence-log-timer'
loader = importlib.machinery.SourceFileLoader('evidence_verify_test_for_log', str(ROOT / 'scripts/evidence-verify-test'))
support = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(support)
loader = importlib.machinery.SourceFileLoader('evidence_log_test_module', str(LOG))
log = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(log)
NOW = 1_800_000_000


def bare(path):
    subprocess.run(['git', 'init', '-q', '--bare', str(path)], check=True)
    subprocess.run(['git', '-C', str(path), 'config', 'gc.auto', '0'], check=True)
    return path


class EvidenceLog(unittest.TestCase):
    def setUp(self):
        self.f = support.Fixture(layout='tag')
        self.addCleanup(self.f.tmp.cleanup)
        self.ci = self.f.key('ci', 'machine/ci1')
        self.rogue = self.f.key('rogue')  # signs, but main does not trust it
        (self.f.repo / '.st').mkdir()
        (self.f.repo / '.st/evidence-keys').write_text(self.f.keys.read_text())
        self.f.git('checkout', '-q', '-b', 'main')
        self.commit, self.tree = self.f.commit('main\n')
        self.remote = bare(self.f.root / 'github.git')
        self.f.git('remote', 'add', 'origin', str(self.remote))
        self.f.git('push', '-q', 'origin', 'main:main')
        self.log_key = self.f.key('log-key')
        self.log_keys = self.f.root / 'log-keys'
        self.log_keys.write_text(f'log/evidence namespaces="git" {self.log_key.with_suffix(".pub").read_text()}')
        self.signer = ['ssh-keygen', '-q', '-Y', 'sign', '-n', 'git', '-f', str(self.log_key)]
        self.host = bare(self.f.root / 'host.git')
        subprocess.run(['git', '-C', str(self.host), 'remote', 'add', 'origin', str(self.remote)], check=True)
        self.now = NOW

    def record(self, key=None, signer='machine/ci1', exit_code=0, tier='full', layout='tag', tree=None, commit=None, **options):
        self.f.layout = layout
        record = self.f.note(commit or self.commit, tree or self.tree, key or self.ci, signer, exit_code=exit_code, tier=tier, **options)
        self.f.git('push', '-q', 'origin', f'{self.f.ref_of[record]}:{self.f.ref_of[record]}')
        return record

    def pull(self, *extra, mode='pull', signer=None):
        self.now += 120
        done = subprocess.run([sys.executable, str(LOG), mode, '--repo', str(self.host), '--signer', json.dumps(signer or self.signer),
                               '--log-keys', str(self.log_keys), '--now', str(self.now), *extra], capture_output=True, text=True)
        return done.returncode, (json.loads(done.stdout) if done.stdout.strip() else None), done.stderr

    def host_git(self, *args, check=True):
        done = subprocess.run(['git', '-C', str(self.host), *args], capture_output=True, text=True)
        if check and done.returncode != 0:
            raise AssertionError(done.stderr)
        return done.stdout.strip()

    def lines(self, path, at='refs/evidence-log/main'):
        return self.host_git('show', f'{at}:{path}').splitlines()

    def remote_refs(self, prefix='refs'):
        return set(subprocess.run(['git', '-C', str(self.remote), 'for-each-ref', '--format=%(refname)', prefix], capture_output=True, text=True).stdout.split())

    def test_a_trusted_record_is_copied_and_logged_once_and_the_rest_are_refused(self):
        passed = self.record()
        self.f.git('push', '-q', 'origin', f'{passed}:refs/notes/evidence/{self.tree}/{passed}')  # its second name, as producers write it
        failed = self.record(exit_code=1, seconds=10)
        self.record(key=self.rogue, signer='machine/ci1', seconds=20)   # signed by a key main does not trust for that signer
        self.record(tier='degraded', sign=False, signer=None, seconds=30)  # unsigned by design: never evidence
        code, result, error = self.pull()
        self.assertEqual(code, 0, error)
        self.assertEqual((result['added'], result['rejected']), (3, {'untrusted': 1, 'not_full': 1}), result)
        path = f'trees/{self.tree[:2]}/{self.tree}'
        lines = self.lines(path)
        self.assertEqual([line.split()[:4] for line in lines], [['record', passed, 'unit', '0'], ['record', failed, 'unit', '1']], lines)
        self.assertTrue(all(line.split()[4] == 'machine/ci1' for line in lines))
        copies = self.host_git('for-each-ref', '--format=%(refname)', 'refs/evidence-copy').split()
        self.assertEqual(len(copies), 3, 'the record under both names, and the failure')
        head = result['head']
        shown = self.host_git('-c', f'gpg.ssh.allowedSignersFile={self.log_keys}', 'show', '-s', '--format=%G? %GS %s', head)
        self.assertTrue(shown.startswith('G log/evidence evidence-log v1 as_of=2027-01-15T08:'), shown)
        self.assertIn('added=3', shown)

    def test_every_pull_commits_a_signed_heartbeat_on_the_last_head(self):
        self.record()
        first = self.pull()[1]['head']
        code, result, _ = self.pull()
        self.assertEqual((code, result['added']), (0, 0))
        self.assertEqual(self.host_git('rev-parse', f'{result["head"]}^'), first)
        self.assertEqual(self.host_git('rev-parse', f'{result["head"]}^{{tree}}'), self.host_git('rev-parse', f'{first}^{{tree}}'))
        self.assertIn(f'as_of={result["as_of"]}', self.host_git('show', '-s', '--format=%s', result['head']))
        self.assertNotEqual(result['as_of'], self.pull()[1]['as_of'], 'each heartbeat carries its own time')

    def remote_head(self):
        return subprocess.run(['git', '-C', str(self.remote), 'rev-parse', 'refs/evidence-log/main'], capture_output=True, text=True).stdout.strip()

    def test_a_deadline_during_verification_keeps_a_published_chunk_and_the_next_pull_finishes(self):
        records = {self.record(seconds=seconds) for seconds in (0, 10, 20)}
        # Stop while the second verification is in flight, after one real signed, published checkpoint.
        driver = self.f.root / 'interrupted.py'
        driver.write_text(f'''import importlib.machinery, importlib.util, signal, sys, time
loader = importlib.machinery.SourceFileLoader('log', {str(LOG)!r})
log = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(log)
log.CHUNK_REFS = 1
accept = log.accept
calls = 0
def interrupted(*args):
    global calls
    calls += 1
    if calls == 2:
        signal.setitimer(signal.ITIMER_REAL, 0.05)
        time.sleep(10)
    return accept(*args)
log.accept = interrupted
sys.exit(log.main(sys.argv[1:]))
''')
        done = subprocess.run([sys.executable, str(driver), 'pull', '--repo', str(self.host), '--publish',
                               '--signer', json.dumps(self.signer), '--log-keys', str(self.log_keys)], capture_output=True, text=True)
        self.assertLess(done.returncode, 0, done.stderr)
        partial = self.remote_head()
        self.assertEqual(self.host_git('rev-parse', log.LOG), partial)
        self.assertEqual(len(self.host_git('for-each-ref', '--format=%(refname)', log.COPY).split()), 1)
        path = f'trees/{self.tree[:2]}/{self.tree}'
        self.assertEqual(len(self.lines(path)), 1)
        code, result, error = self.pull('--publish')
        self.assertEqual((code, result['added']), (0, 2), error)
        self.assertEqual(self.host_git('rev-parse', f'{result["head"]}^'), partial)
        self.assertEqual({line.split()[1] for line in self.lines(path)}, records)
        self.assertEqual(len(self.lines(path)), 3)

    def test_checkpoints_sample_the_clock_when_committing_and_also_bound_rejected_work(self):
        self.record(seconds=0)
        self.record(seconds=10)
        self.record(key=self.rogue, seconds=20)
        argv = ['pull', '--repo', str(self.host), '--publish', '--signer', json.dumps(self.signer), '--log-keys', str(self.log_keys)]
        with mock.patch.object(log, 'CHUNK_REFS', 1), mock.patch.object(log.time, 'time', side_effect=[NOW, NOW + 600, NOW + 1200, NOW + 1800]):
            self.assertEqual(log.main(argv), 0)
        stamps = self.host_git('log', '--format=%ct', log.LOG).splitlines()
        self.assertEqual(stamps, [str(NOW + 1800), str(NOW + 1200), str(NOW + 600)])
        self.assertIn(log.iso(NOW + 1800), self.host_git('show', '-s', '--format=%s', log.LOG))

    def test_copy_markers_never_advance_when_the_checkpoint_signer_fails(self):
        self.record()
        before = self.pull()[1]['head']
        new = self.record(seconds=10)
        code, _, error = self.pull(signer=[sys.executable, '-c', 'import sys; sys.exit(1)'])
        self.assertEqual(code, 1, error)
        self.assertEqual(self.host_git('rev-parse', log.LOG), before)
        self.assertNotIn(new, self.host_git('for-each-ref', '--format=%(objectname)', log.COPY))
        self.assertEqual(self.pull()[1]['added'], 1)

    def test_each_checkpoint_refuses_a_remote_that_moved_after_the_previous_push(self):
        self.record(seconds=0)
        self.record(seconds=10)
        publish = log.publish
        pushes = []

        def moved(repo, remote, summary, published):
            result = publish(repo, remote, summary, published)
            pushes.append((published, summary['head'], result))
            if len(pushes) == 1:
                subprocess.run(['git', '-C', str(self.remote), 'update-ref', log.LOG, self.commit], check=True)
            return result

        with mock.patch.object(log, 'CHUNK_REFS', 1), mock.patch.object(log, 'publish', side_effect=moved):
            self.assertEqual(log.main(['pull', '--repo', str(self.host), '--publish', '--signer', json.dumps(self.signer),
                                       '--log-keys', str(self.log_keys), '--now', str(NOW)]), 1)
        self.assertEqual([push[2] for push in pushes], [True, False])
        self.assertEqual(pushes[1][0], pushes[0][1], 'the second checkpoint leases the first published head')
        self.assertEqual(self.remote_head(), self.commit, 'the concurrent remote change was not overwritten')

    def test_elapsed_verification_time_also_triggers_a_checkpoint(self):
        self.record(seconds=0)
        self.record(seconds=10)
        with mock.patch.object(log.time, 'monotonic', side_effect=[0, 121, 121, 242, 242]):
            self.assertEqual(log.main(['pull', '--repo', str(self.host), '--signer', json.dumps(self.signer),
                                       '--log-keys', str(self.log_keys), '--now', str(NOW)]), 0)
        self.assertEqual(len(self.host_git('log', '--format=%H', log.LOG).splitlines()), 2)
        self.assertEqual(len(self.lines(f'trees/{self.tree[:2]}/{self.tree}')), 2)

    def test_interruption_after_log_commit_before_copy_markers_does_not_duplicate_lines(self):
        self.record()
        update = log.git

        def interrupted(repo, *args, **kwargs):
            if args[:2] == ('update-ref', '--stdin') and b'update refs/evidence-copy/' in kwargs.get('stdin', b''):
                raise log.Refused('interrupted after committing the log')
            return update(repo, *args, **kwargs)

        with mock.patch.object(log, 'git', side_effect=interrupted):
            self.assertEqual(log.main(['pull', '--repo', str(self.host), '--signer', json.dumps(self.signer),
                                       '--log-keys', str(self.log_keys), '--now', str(NOW)]), 1)
        self.assertEqual(self.host_git('for-each-ref', '--format=%(refname)', log.COPY), '')
        self.assertEqual(self.pull()[1]['added'], 1)
        self.assertEqual(len(self.lines(f'trees/{self.tree[:2]}/{self.tree}')), 1)

    def truncate(self, oid):
        path = self.host / 'objects' / oid[:2] / oid[2:]
        self.assertTrue(path.is_file(), path)
        path.chmod(0o644)
        path.write_bytes(b'')

    def test_a_damaged_local_head_is_restored_from_a_trusted_published_continuation(self):
        self.record()
        first = self.pull('--publish')[1]['head']
        self.truncate(first)
        code, result, error = self.pull('--publish')
        self.assertEqual(code, 0, error)
        self.assertEqual(self.host_git('rev-parse', f'{result["head"]}^'), first)
        self.assertTrue(list((self.host / 'evidence-log.broken-objects').iterdir()))
        # Damage in a tree or blob reachable from an otherwise readable head is repaired too.
        blob = self.host_git('rev-parse', f'{result["head"]}:trees/{self.tree[:2]}/{self.tree}')
        self.truncate(blob)
        code, _, error = self.pull('--publish')
        self.assertEqual(code, 0, error)
        self.assertEqual(len(self.lines(f'trees/{self.tree[:2]}/{self.tree}')), 1)

    def test_repair_refuses_an_untrusted_or_missing_published_head_without_restarting_the_chain(self):
        self.record()
        first = self.pull('--publish')[1]['head']
        other = self.f.key('other-publisher')
        foreign = self.pull('--publish', signer=['ssh-keygen', '-q', '-Y', 'sign', '-n', 'git', '-f', str(other)])[1]['head']
        self.truncate(foreign)
        code, _, error = self.pull('--publish')
        self.assertEqual(code, 1, error)
        self.assertIn('not signed by a key in --log-keys', error)
        self.assertEqual(self.host_git('rev-parse', log.LOG), foreign)
        self.assertEqual(self.remote_head(), foreign)
        # No origin head is also an alarm, rather than permission to start from scratch.
        self.host_git('update-ref', log.LOG, first)
        subprocess.run(['git', '-C', str(self.remote), 'update-ref', '-d', log.LOG], check=True)
        self.truncate(first)
        self.assertEqual(self.pull('--publish')[0], 1)
        self.assertEqual(self.host_git('rev-parse', log.LOG), first)

    def test_repair_keeps_relative_file_remotes_relative_to_the_publisher(self):
        self.record()
        self.host_git('remote', 'set-url', 'origin', '../github.git')
        first = self.pull('--publish')[1]['head']
        self.truncate(first)
        code, result, error = self.pull('--publish')
        self.assertEqual(code, 0, error)
        self.assertEqual(self.host_git('rev-parse', f'{result["head"]}^'), first)

    def test_repair_uses_the_same_relative_log_key_file_as_normal_extension(self):
        self.record()
        (self.host / 'relative-log-keys').write_text(self.log_keys.read_text())
        self.assertEqual(self.pull('--publish', '--log-keys', 'relative-log-keys')[0], 0)
        code, result, error = self.pull('--publish', '--log-keys', 'relative-log-keys')
        self.assertEqual(code, 0, error)
        first = result['head']
        self.truncate(first)
        code, result, error = self.pull('--publish', '--log-keys', 'relative-log-keys')
        self.assertEqual(code, 0, error)
        self.assertEqual(self.host_git('rev-parse', f'{result["head"]}^'), first)

    def test_repair_honors_the_publishers_revocations_before_moving_any_objects(self):
        self.record()
        first = self.pull('--publish')[1]['head']
        (self.host / 'revoked-log-key').write_text(self.log_key.with_suffix('.pub').read_text())
        self.host_git('config', 'gpg.ssh.revocationFile', 'revoked-log-key')
        self.assertEqual(self.pull('--publish')[0], 1, 'normal extension refuses the revoked key')
        self.truncate(first)
        code, _, error = self.pull('--publish')
        self.assertEqual(code, 1, error)
        self.assertIn('not signed by a key in --log-keys', error)
        self.assertFalse((self.host / 'evidence-log.broken-objects').exists(), 'the isolated verifier must honor the same revocation')

    def test_repair_restores_a_truncated_blob_whose_header_still_reads(self):
        self.record()
        first = self.pull('--publish')[1]['head']
        path = f'trees/{self.tree[:2]}/{self.tree}'
        expected = self.lines(path)
        blob = self.host_git('rev-parse', f'{first}:{path}')
        loose = self.host / 'objects' / blob[:2] / blob[2:]
        compressed = loose.read_bytes()
        self.assertGreater(len(compressed), 64)
        loose.chmod(0o644)
        loose.write_bytes(compressed[:64])
        header = subprocess.run(['git', '-C', str(self.host), 'cat-file', '--batch-check'], input=f'{blob}\n',
                                capture_output=True, text=True, check=True).stdout
        self.assertIn(' blob ', header, 'a header-only probe misses this corruption')
        code, result, error = self.pull('--publish')
        self.assertEqual(code, 0, error)
        self.assertEqual(self.host_git('rev-parse', f'{result["head"]}^'), first)
        self.assertEqual(self.lines(path), expected)

    def test_repair_refuses_a_trusted_published_head_from_an_unrelated_chain(self):
        self.record()
        first = self.pull('--publish')[1]['head']
        tree = self.host_git('rev-parse', f'{first}^{{tree}}')
        unrelated = log.commit(str(self.host), tree, None, 'unrelated signed head', self.signer, NOW + 600)
        self.host_git('push', '-q', '--force', 'origin', f'{unrelated}:{log.LOG}')
        self.truncate(first)
        code, _, error = self.pull('--publish')
        self.assertEqual(code, 1, error)
        self.assertIn('does not continue the damaged local head', error)
        self.assertEqual(self.host_git('rev-parse', log.LOG), first)
        self.assertEqual(self.remote_head(), unrelated)
        self.assertFalse((self.host / 'evidence-log.broken-objects').exists(), 'trust is checked before changing local storage')

    def test_empty_copies_still_require_explicit_seeding_from_the_published_chain(self):
        self.record()
        published = self.pull('--publish')[1]['head']
        self.host = bare(self.f.root / 'empty-copy.git')
        self.host_git('remote', 'add', 'origin', str(self.remote))
        code, result, error = self.pull('--publish')
        self.assertEqual(code, 1, error)
        self.assertIn('is not an ancestor', result['publish_refused'])
        self.assertEqual(self.remote_head(), published)

    def test_publish_puts_the_head_on_the_remote_and_a_moved_remote_head_is_reported_and_replaced_only_by_a_head_that_continues_it(self):
        self.record()
        code, result, _ = self.pull('--publish')
        self.assertEqual((code, result['published']), (0, True), result)
        first = result['head']
        self.assertEqual(self.remote_head(), first)
        self.assertEqual(self.pull('--publish')[1]['published'], True)
        subprocess.run(['git', '-C', str(self.remote), 'update-ref', 'refs/evidence-log/main', first], check=True)  # rewound to an older head
        code, result, _ = self.pull('--publish')
        self.assertEqual((code, result['published'], result['published_head_differs']), (0, True, first), result)
        self.assertEqual(self.remote_head(), result['head'])
        subprocess.run(['git', '-C', str(self.remote), 'update-ref', 'refs/evidence-log/main', self.commit], check=True)  # not the log at all
        code, result, error = self.pull('--publish')
        self.assertEqual((code, result['published'], result['published_head_differs']), (1, False, self.commit), result)
        self.assertIn('refusing to publish', error)
        self.assertEqual(self.remote_head(), self.commit, 'a head this copy does not continue is never overwritten')

    def test_a_logged_record_deleted_on_the_remote_is_an_alarm_and_restore_puts_it_back(self):
        passed = self.record()
        failed = self.record(exit_code=1, seconds=10)
        self.assertEqual(self.pull()[0], 0)
        ref = f'refs/tags/evidence/{self.tree}/{failed}'
        subprocess.run(['git', '-C', str(self.remote), 'update-ref', '-d', ref], check=True)  # the newer failure, deleted
        code, result, _ = self.pull()
        self.assertEqual((code, result['missing']), (4, [ref]), result)
        self.assertNotIn(ref, self.remote_refs())
        code, result, _ = self.pull('--restore')
        self.assertEqual((code, result['restored']), (4, True), result)
        self.assertIn(ref, self.remote_refs())
        code, result, _ = self.pull()
        self.assertEqual((code, result['missing']), (0, []))
        self.assertEqual(len(self.lines(f'trees/{self.tree[:2]}/{self.tree}')), 2, 'restoring logs nothing twice')
        self.assertTrue(passed)

    def test_a_refused_checkpoint_still_packs_refs_and_restores_missing_records(self):
        old = self.record()
        first = self.pull('--publish')[1]['head']
        published = self.pull('--publish')[1]['head']
        self.host_git('update-ref', log.LOG, first)  # this copy no longer continues the published head
        self.record(seconds=10)
        self.record(seconds=20)
        ref = self.f.ref_of[old]
        for count in (1, 500):  # failure during verification, then at the final checkpoint
            with self.subTest(chunk_refs=count):
                subprocess.run(['git', '-C', str(self.remote), 'update-ref', '-d', ref], check=True)
                output = io.StringIO()
                with mock.patch.object(log, 'CHUNK_REFS', count), contextlib.redirect_stdout(output):
                    code = log.main(['pull', '--repo', str(self.host), '--publish', '--restore',
                                     '--signer', json.dumps(self.signer), '--log-keys', str(self.log_keys), '--now', str(NOW)])
                result = json.loads(output.getvalue())
                self.assertEqual(code, 4, result)
                self.assertEqual((result['added'], result['published'], result['restored']), (1, False, True), result)
                self.assertEqual(result['missing'], [ref])
                self.assertIn(ref, self.remote_refs())
                self.assertIn(f'{result["head"]} {log.LOG}', (self.host / 'packed-refs').read_text())
                self.assertEqual(self.remote_head(), published, 'a refused publication still never overwrites the remote')

    def test_gc_lines_go_first_so_what_gc_deletes_is_not_missing_and_new_records_count_after_them(self):
        old = self.record()
        index = f'refs/tags/evidence/input/unit/{"e" * 40}/{old}'
        self.assertEqual(self.pull()[0], 0)
        plan = self.f.root / 'plan.json'
        plan.write_text(json.dumps({'trees': [self.tree], 'keys': [['unit', 'e' * 40]], 'plan_sha256': 'f' * 64,
                                    'delete': [f'refs/tags/evidence/{self.tree}/{old}']}))
        code, result, error = self.pull('--plan', str(plan), mode='gc')
        self.assertEqual((code, result['gc_paths'], result['copies_dropped']), (0, 2, 1), (result, error))
        subprocess.run(['git', '-C', str(self.remote), 'update-ref', '-d', f'refs/tags/evidence/{self.tree}/{old}'], check=True)  # GC deletes
        code, result, _ = self.pull()
        self.assertEqual((code, result['missing']), (0, []), result)
        lines = self.lines(f'trees/{self.tree[:2]}/{self.tree}')
        self.assertEqual([line.split()[0] for line in lines], ['record', 'gc'])
        self.assertTrue(lines[1].endswith(' ' + 'f' * 64))
        again = self.record(seconds=60)
        self.assertEqual(self.pull()[0], 0)
        lines = self.lines(f'trees/{self.tree[:2]}/{self.tree}')
        self.assertEqual([line.split()[:2] for line in lines], [['record', old], ['gc', lines[1].split()[1]], ['record', again]])
        self.assertTrue(index)

    def gc_plan(self, records):
        plan = self.f.root / 'plan.json'
        plan.write_text(json.dumps({'trees': [self.tree], 'keys': [], 'plan_sha256': 'f' * 64,
                                    'delete': [f'refs/tags/evidence/{self.tree}/{r}' for r in records]}))
        return plan

    def test_a_pull_between_gc_s_lines_and_its_deletions_does_not_log_the_doomed_records_again(self):
        passed = self.record()
        failed = self.record(exit_code=1, seconds=10)
        self.assertEqual(self.pull()[0], 0)
        self.assertEqual(self.pull('--plan', str(self.gc_plan([passed, failed])), mode='gc')[0], 0)
        # Before GC deletes anything a pull runs (the timer every 2 minutes): the doomed records are still on the remote, and their
        # copies were dropped. Logging them again after the gc line would make their deletion an alarm, and --restore undo it.
        code, result, _ = self.pull('--restore')
        self.assertEqual((code, result['added'], result['gc_pending']), (0, 0, 2), result)
        path = f'trees/{self.tree[:2]}/{self.tree}'
        self.assertEqual([line.split()[0] for line in self.lines(path)], ['record', 'record', 'gc'])
        for record in (passed, failed):
            subprocess.run(['git', '-C', str(self.remote), 'update-ref', '-d', f'refs/tags/evidence/{self.tree}/{record}'], check=True)
        code, result, _ = self.pull('--restore')
        self.assertEqual((code, result['missing'], result['gc_pending'], 'restored' in result), (0, [], 0, False), result)
        self.assertFalse(self.remote_refs('refs/tags/evidence'), 'nothing GC deleted came back')
        self.assertEqual(json.loads((self.host / 'evidence-log.gc-pending.json').read_text()), {})

    def test_a_pending_deletion_gc_never_made_is_logged_again_after_a_day(self):
        passed = self.record()
        self.assertEqual(self.pull()[0], 0)
        self.assertEqual(self.pull('--plan', str(self.gc_plan([passed])), mode='gc')[0], 0)
        path = f'trees/{self.tree[:2]}/{self.tree}'
        self.now += 23 * 3600
        self.assertEqual(self.pull()[1]['gc_pending'], 1)
        self.now += 3600
        code, result, _ = self.pull()
        self.assertEqual((code, result['added'], result['gc_pending']), (0, 1, 0), result)
        self.assertEqual([line.split()[:2] for line in self.lines(path)][-1], ['record', passed], 'it counts again, after the gc line')

    def test_gc_publishes_its_lines_at_once_and_a_plan_without_its_deletions_is_refused(self):
        passed = self.record()
        self.assertEqual(self.pull()[0], 0)
        code, result, error = self.pull('--publish', '--plan', str(self.gc_plan([passed])), mode='gc')
        self.assertEqual((code, result['published']), (0, True), error)
        published = subprocess.run(['git', '-C', str(self.remote), 'rev-parse', 'refs/evidence-log/main'], capture_output=True, text=True).stdout.strip()
        self.assertEqual(published, result['head'])
        plan = self.f.root / 'old-plan.json'
        plan.write_text(json.dumps({'trees': [self.tree], 'keys': [], 'plan_sha256': 'f' * 64}))
        code, _, error = self.pull('--plan', str(plan), mode='gc')
        self.assertEqual(code, 2, error)
        self.assertIn('delete', error)

    def test_a_remote_gc_killed_twice_finishes_its_published_plan_without_replanning(self):
        records, trees = [], []
        for n in (1, 2, 3):
            commit, tree = self.f.commit(f'obsolete {n}\n')
            records.append(self.record(tree=tree, commit=commit, seconds=n))
            trees.append(tree)
        self.commit, self.tree = self.f.commit('current main\n')
        self.f.git('push', '-q', 'origin', 'main:main')
        code, result, error = self.pull('--publish')
        self.assertEqual((code, result['added']), (0, 3), error)
        state, plan = self.f.root / 'pending-plan.json', self.f.root / 'plan.json'
        retention = self.f.root / 'retention.json'
        retention.write_text(json.dumps({'version': 1, 'main_days': 3, 'branch_days': 60, 'grace_hours': 0,
                                         'soft_records': 3000, 'cap_records': 5000}))
        pid_file, count = self.f.root / 'gc.pid', self.f.root / 'deletions'
        count.write_text('0')
        hook = self.remote / 'hooks/post-receive'
        hook.write_text(f'''#!{sys.executable}
import os, signal, sys
from pathlib import Path
for line in sys.stdin:
    old, new, ref = line.split()
    if ref.startswith('refs/tags/evidence/') and new == '0' * 40:
        count = Path({str(count)!r})
        n = int(count.read_text()) + 1
        count.write_text(str(n))
        if n <= 2:
            os.kill(int(Path({str(pid_file)!r}).read_text()), signal.SIGKILL)
''')
        hook.chmod(0o755)
        subprocess.run(['git', '-C', str(self.remote), 'config', 'core.hooksPath', str(hook.parent)], check=True)
        driver = self.f.root / 'gc-driver.py'
        driver.write_text(f'''import importlib.machinery, importlib.util, os, sys
from pathlib import Path
loader = importlib.machinery.SourceFileLoader('gc', {str(ROOT / 'scripts/evidence-gc')!r})
gc = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(gc)
gc.BATCH = 1
Path({str(pid_file)!r}).write_text(str(os.getpid()))
if Path({str(state)!r}).exists():
    def no_new_plan(*args, **kwargs):
        raise AssertionError('resume restarted planning or record verification')
    gc.read_refs = gc.protected_keys = gc.crate_keys = no_new_plan
sys.exit(gc.main(sys.argv[1:]))
''')
        before = [sys.executable, str(LOG), 'gc', '--repo', str(self.host), '--signer', json.dumps(self.signer),
                  '--log-keys', str(self.log_keys), '--publish', '--no-wait', '--plan']
        argv = [sys.executable, str(driver), '--repo', str(self.f.repo), '--remote', 'origin', '--main', 'main',
                '--head', self.commit, '--as-of', str(NOW + 2 * 86400), '--retention', str(retention), '--apply',
                '--resume-state', str(state), '--plan-out', str(plan), '--before-delete', json.dumps(before)]
        for deleted in (1, 2):
            done = subprocess.run(argv, capture_output=True, text=True, timeout=30)
            self.assertEqual(done.returncode, -signal.SIGKILL, done.stderr)
            self.assertTrue(state.exists(), 'the frozen plan survives the deadline')
            self.assertEqual(len(self.remote_refs('refs/tags/evidence')), 3 - deleted)
            pending = json.loads((self.host / log.PENDING).read_text())
            for record, tree in zip(records, trees):
                ref = f'refs/tags/evidence/{tree}/{record}'
                self.assertTrue(ref not in self.remote_refs() or ref in pending)
                lines = self.lines(f'trees/{tree[:2]}/{tree}', at='refs/evidence-log/main')
                self.assertEqual(sum(entry.startswith('gc ') for entry in lines), 1)
            # A resumed run must not need a new live set or retention policy.
            if deleted == 1:
                retention.unlink()
                published = self.remote_head()
                pending_before = (self.host / log.PENDING).read_bytes()
                remote_before = self.remote_refs()
                fork = log.commit(str(self.host), self.host_git('rev-parse', f'{published}^{{tree}}'), None,
                                  'unpublished branch', self.signer, self.now)
                self.host_git('update-ref', log.LOG, fork)
                refused = subprocess.run(argv, capture_output=True, text=True, timeout=30)
                self.assertEqual(refused.returncode, 1, refused.stderr)
                self.assertIn('before-delete', json.loads(refused.stdout)['refused'])
                self.assertEqual(self.remote_refs(), remote_before, 'a refused re-publication permits no deletion')
                self.assertEqual((self.host / log.PENDING).read_bytes(), pending_before)
                self.host_git('update-ref', log.LOG, published)
        done = subprocess.run(argv, capture_output=True, text=True, timeout=30)
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertTrue(json.loads(done.stdout)['resumed'])
        self.assertFalse(state.exists())
        self.assertFalse(self.remote_refs('refs/tags/evidence'))
        self.assertEqual(self.pull('--publish', '--restore')[0], 0)
        self.assertEqual(json.loads((self.host / log.PENDING).read_text()), {})

    def test_a_resumed_gc_keeps_newer_records_and_publishes_without_duplicate_gc_lines(self):
        old = self.record()
        self.assertEqual(self.pull('--publish')[0], 0)
        plan = self.gc_plan([old])
        self.assertEqual(self.pull('--publish', '--plan', str(plan), mode='gc')[0], 0)
        newer = self.record(seconds=50)
        self.assertEqual(self.pull('--publish')[0], 0)
        path = f'trees/{self.tree[:2]}/{self.tree}'
        previous = self.lines(path)
        contents = json.loads(plan.read_text())
        plan.write_text(json.dumps({**contents, 'resumed': True}))
        code, result, error = self.pull('--publish', '--plan', str(plan), mode='gc')
        self.assertEqual(code, 0, error)
        self.assertEqual(self.lines(path), previous)
        self.assertEqual(result['gc_lines_added'], 0)
        self.assertIn(newer, self.host_git('for-each-ref', '--format=%(objectname)', log.COPY))
        self.assertEqual(self.remote_head(), result['head'])

    def test_a_new_gc_of_identical_refs_resumes_after_a_kill_before_its_first_hook(self):
        old_commit, old_tree = self.f.commit('obsolete record\n')
        record = self.record(tree=old_tree, commit=old_commit)
        self.commit, self.tree = self.f.commit('current main\n')
        self.f.git('push', '-q', 'origin', 'main:main')
        code, result, error = self.pull('--publish')
        self.assertEqual((code, result['added']), (0, 1), error)
        state, plan = self.f.root / 'resume.json', self.f.root / 'plan.json'
        retention = self.f.root / 'retention.json'
        retention.write_text(json.dumps({'version': 1, 'main_days': 3, 'branch_days': 60, 'grace_hours': 0,
                                         'soft_records': 3000, 'cap_records': 5000}))
        before = [sys.executable, str(LOG), 'gc', '--repo', str(self.host), '--signer', json.dumps(self.signer),
                  '--log-keys', str(self.log_keys), '--publish', '--no-wait', '--plan']
        args = ['--repo', str(self.f.repo), '--remote', 'origin', '--main', 'main', '--head', self.commit,
                '--as-of', str(NOW + 2 * 86400), '--retention', str(retention), '--apply', '--resume-state', str(state),
                '--plan-out', str(plan), '--before-delete', json.dumps(before)]
        done = subprocess.run([sys.executable, str(ROOT / 'scripts/evidence-gc'), *args], capture_output=True, text=True, timeout=30)
        self.assertEqual(done.returncode, 0, done.stderr)
        first_plan = json.loads(plan.read_text())
        self.assertEqual(self.pull('--publish')[0], 0)  # absence acknowledges the first operation
        ref = f'refs/tags/evidence/{old_tree}/{record}'
        self.f.git('update-ref', ref, record)
        self.f.git('push', '-q', 'origin', f'{ref}:{ref}')  # the same record is later published again
        code, result, error = self.pull('--publish')
        self.assertEqual((code, result['added']), (0, 1), error)
        driver = self.f.root / 'before-hook.py'
        driver.write_text(f'''import importlib.machinery, importlib.util, os, signal, sys
loader = importlib.machinery.SourceFileLoader('gc', {str(ROOT / 'scripts/evidence-gc')!r})
gc = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(gc)
original = gc.write_journal
def stop_before_hook(*args, **kwargs):
    original(*args, **kwargs)
    os.kill(os.getpid(), signal.SIGKILL)
gc.write_journal = stop_before_hook
sys.exit(gc.main(sys.argv[1:]))
''')
        stopped = subprocess.run([sys.executable, str(driver), *args], capture_output=True, text=True, timeout=30)
        self.assertEqual(stopped.returncode, -signal.SIGKILL, stopped.stderr)
        done = subprocess.run([sys.executable, str(ROOT / 'scripts/evidence-gc'), *args], capture_output=True, text=True, timeout=30)
        self.assertEqual(done.returncode, 0, done.stderr)
        second_plan = json.loads(plan.read_text())
        self.assertEqual(first_plan['inputs_sha256'], second_plan['inputs_sha256'])
        self.assertNotEqual(first_plan['plan_sha256'], second_plan['plan_sha256'])
        self.assertFalse(state.exists())
        self.assertFalse(self.remote_refs('refs/tags/evidence'))
        self.assertEqual(sum(line.startswith('gc ') for line in self.lines(f'trees/{old_tree[:2]}/{old_tree}')), 2)

    def test_a_resumed_gc_refuses_records_logged_again_and_failed_publication_preserves_pending(self):
        old = self.record()
        self.assertEqual(self.pull('--publish')[0], 0)
        plan = self.gc_plan([old])
        self.assertEqual(self.pull('--publish', '--plan', str(plan), mode='gc')[0], 0)
        previous = (self.host / log.PENDING).read_bytes()
        contents = json.loads(plan.read_text())
        plan.write_text(json.dumps({**contents, 'resumed': True}))
        # An unrelated published chain refuses the hook. Its original pending set remains byte-for-byte intact.
        published = self.remote_head()
        self.host_git('update-ref', log.LOG, self.host_git('rev-parse', f'{published}^'))
        code, result, error = self.pull('--publish', '--plan', str(plan), mode='gc')
        self.assertEqual(code, 1, error)
        self.assertIn('publish_refused', result)
        self.assertEqual((self.host / log.PENDING).read_bytes(), previous)
        self.assertEqual(self.remote_head(), published)
        # Expiration is handled separately: until then a resume refuses a target logged after its GC line.
        self.host_git('update-ref', log.LOG, published)
        self.now += 25 * 3600
        self.assertEqual(self.pull('--publish')[0], 0)
        previous = (self.host / log.PENDING).read_bytes()
        published = self.remote_head()
        code, _, error = self.pull('--publish', '--plan', str(plan), mode='gc')
        self.assertEqual(code, 1)
        self.assertIn('logged again', error)
        self.assertEqual((self.host / log.PENDING).read_bytes(), previous)
        self.assertEqual(self.remote_head(), published)

    def test_resume_checks_records_after_its_own_gc_even_when_another_gc_followed(self):
        old = self.record()
        self.assertEqual(self.pull('--publish')[0], 0)
        plan = self.gc_plan([old])
        first = json.loads(plan.read_text())
        self.assertEqual(self.pull('--publish', '--plan', str(plan), mode='gc')[0], 0)
        self.now += 25 * 3600
        self.assertEqual(self.pull('--publish')[0], 0)
        plan.write_text(json.dumps({**first, 'plan_sha256': 'a' * 64}))
        self.assertEqual(self.pull('--publish', '--plan', str(plan), mode='gc')[0], 0)
        lines = self.lines(f'trees/{self.tree[:2]}/{self.tree}')
        self.assertEqual([line.split()[0] for line in lines], ['record', 'gc', 'record', 'gc'])
        previous = (self.host / log.PENDING).read_bytes()
        published = self.remote_head()
        plan.write_text(json.dumps({**first, 'resumed': True}))
        code, _, error = self.pull('--publish', '--plan', str(plan), mode='gc')
        self.assertEqual(code, 1, error)
        self.assertIn('logged again', error)
        self.assertEqual((self.host / log.PENDING).read_bytes(), previous)
        self.assertEqual(self.remote_head(), published)

    def test_gc_can_refuse_a_busy_pull_without_waiting_or_changing_pending(self):
        record = self.record()
        self.assertEqual(self.pull('--publish')[0], 0)
        plan = self.gc_plan([record])
        with log.locked(str(self.host)):
            done = subprocess.run([sys.executable, str(LOG), 'gc', '--repo', str(self.host), '--signer', json.dumps(self.signer),
                                   '--log-keys', str(self.log_keys), '--publish', '--no-wait', '--plan', str(plan)],
                                  capture_output=True, text=True, timeout=5)
        self.assertEqual(done.returncode, 1)
        self.assertIn('busy', done.stderr)
        self.assertFalse((self.host / log.PENDING).exists())

    def test_a_failed_gc_publication_keeps_copies_so_an_intervening_pull_does_not_reverify(self):
        record = self.record()
        self.assertEqual(self.pull('--publish')[0], 0)
        plan = self.gc_plan([record])
        published = self.remote_head()
        copies = self.host_git('for-each-ref', '--format=%(objectname) %(refname)', log.COPY)
        previous = log.pending(str(self.host))
        fork = log.commit(str(self.host), self.host_git('rev-parse', f'{published}^{{tree}}'), None,
                          'another published branch', self.signer, self.now)
        self.host_git('push', '--force', 'origin', f'{fork}:{log.LOG}')  # fixture divergence, never an allowed publisher action
        code, result, error = self.pull('--publish', '--plan', str(plan), mode='gc')
        self.assertEqual(code, 1, error)
        self.assertIn('publish_refused', result)
        self.assertEqual(log.pending(str(self.host)), previous)
        self.assertEqual(self.host_git('for-each-ref', '--format=%(objectname) %(refname)', log.COPY), copies)
        self.host_git('push', '--force', 'origin', f'{published}:{log.LOG}')
        code, result, error = self.pull('--publish')
        self.assertEqual((code, result['added']), (0, 0), error)
        plan.write_text(json.dumps({**json.loads(plan.read_text()), 'resumed': True}))
        code, result, error = self.pull('--publish', '--plan', str(plan), mode='gc')
        self.assertEqual((code, result['gc_lines_added'], result['copies_dropped']), (0, 0, 1), error)

    def test_an_input_index_ref_is_logged_under_its_key_only_when_the_record_carries_that_key(self):
        key = 'e' * 40
        record = self.record(inputs={'source_inputs': key})
        self.f.git('push', '-q', 'origin', f'{record}:refs/tags/evidence/input/unit/{key}/{record}', f'{record}:refs/tags/evidence/input/unit/{"d" * 40}/{record}')
        code, result, _ = self.pull()
        self.assertEqual((code, result['rejected']), (0, {'malformed': 1}), result)
        self.assertEqual([line.split()[:3] for line in self.lines(f'keys/unit/{key[:2]}/{key}')], [['record', record, 'unit']])
        self.assertNotEqual(self.host_git('cat-file', '-t', f'refs/evidence-log/main:keys/unit/dd/{"d" * 40}', check=False), 'blob')

    def test_a_head_that_is_not_ours_is_never_extended(self):
        self.record()
        self.assertEqual(self.pull()[0], 0)
        other = self.f.key('other')
        self.assertEqual(self.pull(signer=['ssh-keygen', '-q', '-Y', 'sign', '-n', 'git', '-f', str(other)])[0], 0, 'signing with another key works once')
        code, _, error = self.pull()
        self.assertEqual(code, 1)
        self.assertIn('not signed by a key in --log-keys', error)

    def test_of_two_publishers_the_one_whose_chain_is_older_is_refused_and_the_published_chain_keeps_going(self):
        # Host A publishes, goes away; host B takes over from the published head; host A boots with its timer on and pulls again.
        self.record()
        standby_key = self.f.key('standby')
        with open(self.log_keys, 'a') as keys:
            keys.write(f'log/standby namespaces="git" {standby_key.with_suffix(".pub").read_text()}')
        last = self.pull('--publish')[1]['head']
        standby = bare(self.f.root / 'standby.git')
        subprocess.run(['git', '-C', str(standby), 'remote', 'add', 'origin', str(self.remote)], check=True)
        subprocess.run(['git', '-C', str(standby), 'fetch', '-q', 'origin', '+refs/evidence-log/main:refs/evidence-log/main'], check=True)
        signer = ['ssh-keygen', '-q', '-Y', 'sign', '-n', 'git', '-f', str(standby_key)]

        def standby_pull():
            self.now += 120
            done = subprocess.run([sys.executable, str(LOG), 'pull', '--repo', str(standby), '--signer', json.dumps(signer),
                                   '--log-keys', str(self.log_keys), '--now', str(self.now), '--publish'], capture_output=True, text=True)
            self.assertEqual(done.returncode, 0, done.stderr)
            return json.loads(done.stdout)['head']

        taken_over = standby_pull()
        self.assertEqual(self.remote_head(), taken_over)
        code, result, error = self.pull('--publish')  # the old publisher: its new head's parent is `last`, not the standby's head
        self.assertEqual((code, result['published']), (1, False), result)
        self.assertIn(f'the published log head {taken_over} is not an ancestor', error)
        self.assertEqual(self.host_git('rev-parse', f'{result["head"]}^'), last)
        self.assertEqual(self.remote_head(), taken_over, 'the older chain overwrote nothing')
        self.assertEqual(self.pull('--publish')[0], 1, 'and it keeps refusing')
        self.assertEqual(self.remote_head(), taken_over)
        again = standby_pull()
        self.assertEqual(self.remote_head(), again)
        parent = subprocess.run(['git', '-C', str(self.remote), 'rev-parse', f'{again}^'], capture_output=True, text=True).stdout.strip()
        self.assertEqual(parent, taken_over, 'the published chain keeps going')
        # Seeded from the remote again, the old publisher continues the published chain.
        self.host_git('fetch', '-q', 'origin', '+refs/evidence-log/main:refs/evidence-log/main')
        code, result, error = self.pull('--publish')
        self.assertEqual((code, result['published']), (0, True), error)

    def test_a_signer_that_fails_leaves_the_log_as_it_was(self):
        self.record()
        before = self.pull()[1]['head']
        code, _, error = self.pull(signer=[sys.executable, '-c', 'import sys; sys.exit("no key")'])
        self.assertEqual(code, 1)
        self.assertIn('the log signer failed', error)
        self.assertEqual(self.host_git('rev-parse', 'refs/evidence-log/main'), before)
        code, _, error = self.pull(signer=['/nonexistent/signer'])
        self.assertEqual(code, 1)
        self.assertIn('did not run', error)
        done = subprocess.run([sys.executable, str(LOG), 'pull', '--repo', str(self.host), '--signer', 'not json', '--log-keys', str(self.log_keys)],
                              capture_output=True, text=True)
        self.assertEqual(done.returncode, 2)

    def test_the_signer_never_sees_the_callers_loader_variables(self):
        self.record()
        seen = self.f.root / 'signer-env'
        signer = [sys.executable, '-c', f'import os, subprocess, sys; open({str(seen)!r}, "w").write(" ".join(sorted(os.environ))); '
                  f'sys.stdout.write(subprocess.run({self.signer!r}, input=sys.stdin.buffer.read(), capture_output=True).stdout.decode())']
        done = subprocess.run([sys.executable, str(LOG), 'pull', '--repo', str(self.host), '--signer', json.dumps(signer), '--log-keys', str(self.log_keys)],
                              capture_output=True, text=True, env=dict(os.environ, LD_PRELOAD='/nonexistent.so', LD_AUDIT='x', GLIBC_TUNABLES='x'))
        self.assertEqual(done.returncode, 0, done.stderr)
        names = seen.read_text().split()
        self.assertFalse({'LD_PRELOAD', 'LD_AUDIT', 'GLIBC_TUNABLES'} & set(names), names)


    def test_the_timer_runs_main_s_log_with_this_host_s_signer_and_publishes(self):
        record = self.record()
        (self.f.repo / 'scripts').mkdir()
        for tool in ('evidence-log', 'evidence-verify'):
            (self.f.repo / 'scripts' / tool).write_bytes((ROOT / 'scripts' / tool).read_bytes())
        self.f.git('add', '-A')
        self.f.git('commit', '-q', '-m', 'tools')
        self.f.git('push', '-q', 'origin', 'main:main')
        config = self.f.root / 'config'
        config.mkdir()
        (config / 'signer.json').write_text(json.dumps(self.signer))
        (config / 'log-keys').write_text(self.log_keys.read_text())
        env = dict({k: v for k, v in os.environ.items() if not k.startswith('GIT_')}, EVIDENCE_LOG_STATE=str(self.f.root / 'state'),
                   EVIDENCE_LOG_REMOTE='../../github.git', EVIDENCE_LOG_CONFIG=str(config), EVIDENCE_LOG_FLAGS='--publish')
        done = subprocess.run(['bash', str(TIMER)], capture_output=True, text=True, env=env)
        self.assertEqual(done.returncode, 0, done.stderr)
        result = json.loads(done.stdout)
        self.assertEqual((result['added'], result['published']), (1, True), result)
        timer_repo = self.f.root / 'state/repo.git'
        self.assertEqual(subprocess.check_output(['git', '-C', str(timer_repo), 'config', 'core.fsync'], text=True).strip(), 'objects,reference')
        # The timer must reach repair even when its bootstrap fetch sees a corrupt local log ref.
        head = result['head']
        damaged = timer_repo / 'objects' / head[:2] / head[2:]
        damaged.chmod(0o644)
        damaged.write_bytes(b'')
        done = subprocess.run(['bash', str(TIMER)], capture_output=True, text=True, env=env)
        self.assertEqual(done.returncode, 0, done.stderr)
        published = subprocess.run(['git', '-C', str(self.remote), 'show', f'refs/evidence-log/main:trees/{self.tree[:2]}/{self.tree}'],
                                   capture_output=True, text=True).stdout
        self.assertIn(f'record {record} unit 0 ', published)
        # Once main pins the log key, a host key list that disagrees with it is not used.
        (self.f.repo / '.st/evidence-log-key').write_text('log/evidence namespaces="git" ' + self.f.key('pinned').with_suffix('.pub').read_text())
        self.f.git('add', '-A')
        self.f.git('commit', '-q', '-m', 'pin another log key')
        self.f.git('push', '-q', 'origin', 'main:main')
        done = subprocess.run(['bash', str(TIMER)], capture_output=True, text=True, env=env)
        self.assertEqual(done.returncode, 1, done.stdout)
        self.assertIn('not signed by a key in --log-keys', done.stderr)
        # The extracted timer and log reader prefer the new layout even while old files remain.
        (self.f.repo / '.fractal').mkdir()
        (self.f.repo / '.fractal/evidence-log-key').write_text(self.log_keys.read_text())
        (self.f.repo / '.fractal/evidence-keys').write_text(self.f.keys.read_text())
        self.f.git('add', '-A')
        self.f.git('commit', '-q', '-m', 'new layout wins over old pinned key')
        self.f.git('push', '-q', 'origin', 'main:main')
        done = subprocess.run(['bash', str(TIMER)], capture_output=True, text=True, env=env)
        self.assertEqual(done.returncode, 0, done.stderr)
        # A selected new key that cannot authorize the signer must not restore local or old keys.
        (self.f.repo / '.st/evidence-log-key').write_text(self.log_keys.read_text())
        (self.f.repo / '.fractal/evidence-log-key').write_text('malformed key\n')
        self.f.git('add', '-A')
        self.f.git('commit', '-q', '-m', 'malformed new log key with valid fallbacks')
        self.f.git('push', '-q', 'origin', 'main:main')
        done = subprocess.run(['bash', str(TIMER)], capture_output=True, text=True, env=env)
        self.assertNotEqual(done.returncode, 0, done.stdout)

if __name__ == '__main__':
    unittest.main()
