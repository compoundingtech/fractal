#!/usr/bin/env python3
"""scripts/evidence-log against real repositories and signed records: a bare remote plays GitHub, a second bare repository is the
host's copy. What is accepted and refused, the signed heartbeat, publishing, a deleted record reported and restored, GC lines
before GC deletes, a head that is not ours, and a signer that fails."""
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import sys
import unittest

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
LOG = ROOT / 'scripts/evidence-log'
TIMER = ROOT / 'scripts/evidence-log-timer'
loader = importlib.machinery.SourceFileLoader('evidence_verify_test_for_log', str(ROOT / 'scripts/evidence-verify-test'))
support = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(support)
NOW = 1_800_000_000


def bare(path):
    subprocess.run(['git', 'init', '-q', '--bare', str(path)], check=True)
    subprocess.run(['git', '-C', str(path), 'config', 'gc.auto', '0'], check=True)
    return path


class EvidenceLog(unittest.TestCase):
    def setUp(self):
        self.f = support.Fixture(layout='tag')
        self.addCleanup(self.f.tmp.cleanup)
        self.ci = self.f.key('ci', 'machine/ci1')
        self.rogue = self.f.key('rogue')  # signs, but main does not trust it
        (self.f.repo / '.st').mkdir()
        (self.f.repo / '.st/evidence-keys').write_text(self.f.keys.read_text())
        self.f.git('checkout', '-q', '-b', 'main')
        self.commit, self.tree = self.f.commit('main\n')
        self.remote = bare(self.f.root / 'github.git')
        self.f.git('remote', 'add', 'origin', str(self.remote))
        self.f.git('push', '-q', 'origin', 'main:main')
        self.log_key = self.f.key('log-key')
        self.log_keys = self.f.root / 'log-keys'
        self.log_keys.write_text(f'log/evidence namespaces="git" {self.log_key.with_suffix(".pub").read_text()}')
        self.signer = ['ssh-keygen', '-q', '-Y', 'sign', '-n', 'git', '-f', str(self.log_key)]
        self.host = bare(self.f.root / 'host.git')
        subprocess.run(['git', '-C', str(self.host), 'remote', 'add', 'origin', str(self.remote)], check=True)
        self.now = NOW

    def record(self, key=None, signer='machine/ci1', exit_code=0, tier='full', layout='tag', tree=None, commit=None, **options):
        self.f.layout = layout
        record = self.f.note(commit or self.commit, tree or self.tree, key or self.ci, signer, exit_code=exit_code, tier=tier, **options)
        self.f.git('push', '-q', 'origin', f'{self.f.ref_of[record]}:{self.f.ref_of[record]}')
        return record

    def pull(self, *extra, mode='pull', signer=None):
        self.now += 120
        done = subprocess.run([sys.executable, str(LOG), mode, '--repo', str(self.host), '--signer', json.dumps(signer or self.signer),
                               '--log-keys', str(self.log_keys), '--now', str(self.now), *extra], capture_output=True, text=True)
        return done.returncode, (json.loads(done.stdout) if done.stdout.strip() else None), done.stderr

    def host_git(self, *args, check=True):
        done = subprocess.run(['git', '-C', str(self.host), *args], capture_output=True, text=True)
        if check and done.returncode != 0:
            raise AssertionError(done.stderr)
        return done.stdout.strip()

    def lines(self, path, at='refs/evidence-log/main'):
        return self.host_git('show', f'{at}:{path}').splitlines()

    def remote_refs(self, prefix='refs'):
        return set(subprocess.run(['git', '-C', str(self.remote), 'for-each-ref', '--format=%(refname)', prefix], capture_output=True, text=True).stdout.split())

    def test_a_trusted_record_is_copied_and_logged_once_and_the_rest_are_refused(self):
        passed = self.record()
        self.f.git('push', '-q', 'origin', f'{passed}:refs/notes/evidence/{self.tree}/{passed}')  # its second name, as producers write it
        failed = self.record(exit_code=1, seconds=10)
        self.record(key=self.rogue, signer='machine/ci1', seconds=20)   # signed by a key main does not trust for that signer
        self.record(tier='degraded', sign=False, signer=None, seconds=30)  # unsigned by design: never evidence
        code, result, error = self.pull()
        self.assertEqual(code, 0, error)
        self.assertEqual((result['added'], result['rejected']), (3, {'untrusted': 1, 'not_full': 1}), result)
        path = f'trees/{self.tree[:2]}/{self.tree}'
        lines = self.lines(path)
        self.assertEqual([line.split()[:4] for line in lines], [['record', passed, 'unit', '0'], ['record', failed, 'unit', '1']], lines)
        self.assertTrue(all(line.split()[4] == 'machine/ci1' for line in lines))
        copies = self.host_git('for-each-ref', '--format=%(refname)', 'refs/evidence-copy').split()
        self.assertEqual(len(copies), 3, 'the record under both names, and the failure')
        head = result['head']
        shown = self.host_git('-c', f'gpg.ssh.allowedSignersFile={self.log_keys}', 'show', '-s', '--format=%G? %GS %s', head)
        self.assertTrue(shown.startswith('G log/evidence evidence-log v1 as_of=2027-01-15T08:'), shown)
        self.assertIn('added=3', shown)

    def test_every_pull_commits_a_signed_heartbeat_on_the_last_head(self):
        self.record()
        first = self.pull()[1]['head']
        code, result, _ = self.pull()
        self.assertEqual((code, result['added']), (0, 0))
        self.assertEqual(self.host_git('rev-parse', f'{result["head"]}^'), first)
        self.assertEqual(self.host_git('rev-parse', f'{result["head"]}^{{tree}}'), self.host_git('rev-parse', f'{first}^{{tree}}'))
        self.assertIn(f'as_of={result["as_of"]}', self.host_git('show', '-s', '--format=%s', result['head']))
        self.assertNotEqual(result['as_of'], self.pull()[1]['as_of'], 'each heartbeat carries its own time')

    def test_publish_puts_the_head_on_the_remote_and_a_moved_remote_head_is_reported_and_replaced(self):
        self.record()
        code, result, _ = self.pull('--publish')
        self.assertEqual((code, result['published']), (0, True), result)
        published = subprocess.run(['git', '-C', str(self.remote), 'rev-parse', 'refs/evidence-log/main'], capture_output=True, text=True).stdout.strip()
        self.assertEqual(published, result['head'])
        subprocess.run(['git', '-C', str(self.remote), 'update-ref', 'refs/evidence-log/main', self.commit], check=True)  # rewound by a writer
        code, result, _ = self.pull('--publish')
        self.assertEqual(result['published_head_differs'], self.commit)
        published = subprocess.run(['git', '-C', str(self.remote), 'rev-parse', 'refs/evidence-log/main'], capture_output=True, text=True).stdout.strip()
        self.assertEqual(published, result['head'])

    def test_a_logged_record_deleted_on_the_remote_is_an_alarm_and_restore_puts_it_back(self):
        passed = self.record()
        failed = self.record(exit_code=1, seconds=10)
        self.assertEqual(self.pull()[0], 0)
        ref = f'refs/tags/evidence/{self.tree}/{failed}'
        subprocess.run(['git', '-C', str(self.remote), 'update-ref', '-d', ref], check=True)  # the newer failure, deleted
        code, result, _ = self.pull()
        self.assertEqual((code, result['missing']), (4, [ref]), result)
        self.assertNotIn(ref, self.remote_refs())
        code, result, _ = self.pull('--restore')
        self.assertEqual((code, result['restored']), (4, True), result)
        self.assertIn(ref, self.remote_refs())
        code, result, _ = self.pull()
        self.assertEqual((code, result['missing']), (0, []))
        self.assertEqual(len(self.lines(f'trees/{self.tree[:2]}/{self.tree}')), 2, 'restoring logs nothing twice')
        self.assertTrue(passed)

    def test_gc_lines_go_first_so_what_gc_deletes_is_not_missing_and_new_records_count_after_them(self):
        old = self.record()
        index = f'refs/tags/evidence/input/unit/{"e" * 40}/{old}'
        self.assertEqual(self.pull()[0], 0)
        plan = self.f.root / 'plan.json'
        plan.write_text(json.dumps({'trees': [self.tree], 'keys': [['unit', 'e' * 40]], 'plan_sha256': 'f' * 64,
                                    'delete': [f'refs/tags/evidence/{self.tree}/{old}']}))
        code, result, error = self.pull('--plan', str(plan), mode='gc')
        self.assertEqual((code, result['gc_paths'], result['copies_dropped']), (0, 2, 1), (result, error))
        subprocess.run(['git', '-C', str(self.remote), 'update-ref', '-d', f'refs/tags/evidence/{self.tree}/{old}'], check=True)  # GC deletes
        code, result, _ = self.pull()
        self.assertEqual((code, result['missing']), (0, []), result)
        lines = self.lines(f'trees/{self.tree[:2]}/{self.tree}')
        self.assertEqual([line.split()[0] for line in lines], ['record', 'gc'])
        self.assertTrue(lines[1].endswith(' ' + 'f' * 64))
        again = self.record(seconds=60)
        self.assertEqual(self.pull()[0], 0)
        lines = self.lines(f'trees/{self.tree[:2]}/{self.tree}')
        self.assertEqual([line.split()[:2] for line in lines], [['record', old], ['gc', lines[1].split()[1]], ['record', again]])
        self.assertTrue(index)

    def gc_plan(self, records):
        plan = self.f.root / 'plan.json'
        plan.write_text(json.dumps({'trees': [self.tree], 'keys': [], 'plan_sha256': 'f' * 64,
                                    'delete': [f'refs/tags/evidence/{self.tree}/{r}' for r in records]}))
        return plan

    def test_a_pull_between_gc_s_lines_and_its_deletions_does_not_log_the_doomed_records_again(self):
        passed = self.record()
        failed = self.record(exit_code=1, seconds=10)
        self.assertEqual(self.pull()[0], 0)
        self.assertEqual(self.pull('--plan', str(self.gc_plan([passed, failed])), mode='gc')[0], 0)
        # Before GC deletes anything a pull runs (the timer every 2 minutes): the doomed records are still on the remote, and their
        # copies were dropped. Logging them again after the gc line would make their deletion an alarm, and --restore undo it.
        code, result, _ = self.pull('--restore')
        self.assertEqual((code, result['added'], result['gc_pending']), (0, 0, 2), result)
        path = f'trees/{self.tree[:2]}/{self.tree}'
        self.assertEqual([line.split()[0] for line in self.lines(path)], ['record', 'record', 'gc'])
        for record in (passed, failed):
            subprocess.run(['git', '-C', str(self.remote), 'update-ref', '-d', f'refs/tags/evidence/{self.tree}/{record}'], check=True)
        code, result, _ = self.pull('--restore')
        self.assertEqual((code, result['missing'], result['gc_pending'], 'restored' in result), (0, [], 0, False), result)
        self.assertFalse(self.remote_refs('refs/tags/evidence'), 'nothing GC deleted came back')
        self.assertEqual(json.loads((self.host / 'evidence-log.gc-pending.json').read_text()), {})

    def test_a_pending_deletion_gc_never_made_is_logged_again_after_a_day(self):
        passed = self.record()
        self.assertEqual(self.pull()[0], 0)
        self.assertEqual(self.pull('--plan', str(self.gc_plan([passed])), mode='gc')[0], 0)
        path = f'trees/{self.tree[:2]}/{self.tree}'
        self.now += 23 * 3600
        self.assertEqual(self.pull()[1]['gc_pending'], 1)
        self.now += 3600
        code, result, _ = self.pull()
        self.assertEqual((code, result['added'], result['gc_pending']), (0, 1, 0), result)
        self.assertEqual([line.split()[:2] for line in self.lines(path)][-1], ['record', passed], 'it counts again, after the gc line')

    def test_gc_publishes_its_lines_at_once_and_a_plan_without_its_deletions_is_refused(self):
        passed = self.record()
        self.assertEqual(self.pull()[0], 0)
        code, result, error = self.pull('--publish', '--plan', str(self.gc_plan([passed])), mode='gc')
        self.assertEqual((code, result['published']), (0, True), error)
        published = subprocess.run(['git', '-C', str(self.remote), 'rev-parse', 'refs/evidence-log/main'], capture_output=True, text=True).stdout.strip()
        self.assertEqual(published, result['head'])
        plan = self.f.root / 'old-plan.json'
        plan.write_text(json.dumps({'trees': [self.tree], 'keys': [], 'plan_sha256': 'f' * 64}))
        code, _, error = self.pull('--plan', str(plan), mode='gc')
        self.assertEqual(code, 2, error)
        self.assertIn('delete', error)

    def test_an_input_index_ref_is_logged_under_its_key_only_when_the_record_carries_that_key(self):
        key = 'e' * 40
        record = self.record(inputs={'source_inputs': key})
        self.f.git('push', '-q', 'origin', f'{record}:refs/tags/evidence/input/unit/{key}/{record}', f'{record}:refs/tags/evidence/input/unit/{"d" * 40}/{record}')
        code, result, _ = self.pull()
        self.assertEqual((code, result['rejected']), (0, {'malformed': 1}), result)
        self.assertEqual([line.split()[:3] for line in self.lines(f'keys/unit/{key[:2]}/{key}')], [['record', record, 'unit']])
        self.assertNotEqual(self.host_git('cat-file', '-t', f'refs/evidence-log/main:keys/unit/dd/{"d" * 40}', check=False), 'blob')

    def test_a_head_that_is_not_ours_is_never_extended(self):
        self.record()
        self.assertEqual(self.pull()[0], 0)
        other = self.f.key('other')
        self.assertEqual(self.pull(signer=['ssh-keygen', '-q', '-Y', 'sign', '-n', 'git', '-f', str(other)])[0], 0, 'signing with another key works once')
        code, _, error = self.pull()
        self.assertEqual(code, 1)
        self.assertIn('not signed by a key in --log-keys', error)

    def test_a_signer_that_fails_leaves_the_log_as_it_was(self):
        self.record()
        before = self.pull()[1]['head']
        code, _, error = self.pull(signer=[sys.executable, '-c', 'import sys; sys.exit("no key")'])
        self.assertEqual(code, 1)
        self.assertIn('the log signer failed', error)
        self.assertEqual(self.host_git('rev-parse', 'refs/evidence-log/main'), before)
        code, _, error = self.pull(signer=['/nonexistent/signer'])
        self.assertEqual(code, 1)
        self.assertIn('did not run', error)
        done = subprocess.run([sys.executable, str(LOG), 'pull', '--repo', str(self.host), '--signer', 'not json', '--log-keys', str(self.log_keys)],
                              capture_output=True, text=True)
        self.assertEqual(done.returncode, 2)

    def test_the_signer_never_sees_the_callers_loader_variables(self):
        self.record()
        seen = self.f.root / 'signer-env'
        signer = [sys.executable, '-c', f'import os, subprocess, sys; open({str(seen)!r}, "w").write(" ".join(sorted(os.environ))); '
                  f'sys.stdout.write(subprocess.run({self.signer!r}, input=sys.stdin.buffer.read(), capture_output=True).stdout.decode())']
        done = subprocess.run([sys.executable, str(LOG), 'pull', '--repo', str(self.host), '--signer', json.dumps(signer), '--log-keys', str(self.log_keys)],
                              capture_output=True, text=True, env=dict(os.environ, LD_PRELOAD='/nonexistent.so', LD_AUDIT='x', GLIBC_TUNABLES='x'))
        self.assertEqual(done.returncode, 0, done.stderr)
        names = seen.read_text().split()
        self.assertFalse({'LD_PRELOAD', 'LD_AUDIT', 'GLIBC_TUNABLES'} & set(names), names)


    def test_the_timer_runs_main_s_log_with_this_host_s_signer_and_publishes(self):
        record = self.record()
        (self.f.repo / 'scripts').mkdir()
        for tool in ('evidence-log', 'evidence-verify'):
            (self.f.repo / 'scripts' / tool).write_bytes((ROOT / 'scripts' / tool).read_bytes())
        self.f.git('add', '-A')
        self.f.git('commit', '-q', '-m', 'tools')
        self.f.git('push', '-q', 'origin', 'main:main')
        config = self.f.root / 'config'
        config.mkdir()
        (config / 'signer.json').write_text(json.dumps(self.signer))
        (config / 'log-keys').write_text(self.log_keys.read_text())
        env = dict({k: v for k, v in os.environ.items() if not k.startswith('GIT_')}, EVIDENCE_LOG_STATE=str(self.f.root / 'state'),
                   EVIDENCE_LOG_REMOTE=str(self.remote), EVIDENCE_LOG_CONFIG=str(config), EVIDENCE_LOG_FLAGS='--publish')
        done = subprocess.run(['bash', str(TIMER)], capture_output=True, text=True, env=env)
        self.assertEqual(done.returncode, 0, done.stderr)
        result = json.loads(done.stdout)
        self.assertEqual((result['added'], result['published']), (1, True), result)
        published = subprocess.run(['git', '-C', str(self.remote), 'show', f'refs/evidence-log/main:trees/{self.tree[:2]}/{self.tree}'],
                                   capture_output=True, text=True).stdout
        self.assertIn(f'record {record} unit 0 ', published)
        # Once main pins the log key, a host key list that disagrees with it is not used.
        (self.f.repo / '.st/evidence-log-key').write_text('log/evidence namespaces="git" ' + self.f.key('pinned').with_suffix('.pub').read_text())
        self.f.git('add', '-A')
        self.f.git('commit', '-q', '-m', 'pin another log key')
        self.f.git('push', '-q', 'origin', 'main:main')
        done = subprocess.run(['bash', str(TIMER)], capture_output=True, text=True, env=env)
        self.assertEqual(done.returncode, 1, done.stdout)
        self.assertIn('not signed by a key in --log-keys', done.stderr)

if __name__ == '__main__':
    unittest.main()
