#!/usr/bin/env python3
"""The files a lane's commands execute or read, found statically: the source of each lane's `definition_paths`.

  scripts/lane-definition-closure [--root DIR] [--lanes FILE] [--lane NAME]... [--why | --json]   print each lane's closure
  scripts/lane-definition-closure [--root DIR] [--lanes FILE] [--lane NAME]... --check            exit 1 if a lane's file misses one
  scripts/lane-definition-closure [--root DIR] [--lanes FILE] [--lane NAME]... --write            set definition_paths to the closure

`.st/required-lanes.json` gives each lane an `argv` and the `definition_paths` whose bytes decide what that argv does: a tree that
changes one is a lane edit, which is never signed locally (scripts/evidence-wrap refuses it; CI runs the check). A file the lane's
commands read that the list leaves out would let a tree change the check and still be signed, so the list is this closure, and
scripts/lane-definition-closure-test holds every lane's closure inside its definition_paths (a path covers a file when equal or a
parent directory). From the argv the walk reads every file the command names, and follows the ones that are code:

  shell (by extension or shebang)  every word that names a tracked file, comments dropped: `bash scripts/x`, `scripts/x`,
                                   `. scripts/x`, `"$(dirname "$0")/x"`, `$root/scripts/x`, `python3 scripts/x`, a glob that picks
                                   files (`scripts/*-test`), the NAMEs of a function in FUNCTIONS (`parallel_tests x-test`)
  Python (.py or shebang)          every string constant but docstrings (subprocess argv literals, `open(...)`, `Path` parts,
                                   `SourceFileLoader(..., 'scripts/x')`), each f-string as a glob (f'.github/{n}-baseline.json'),
                                   every `import` of a module beside it
  JavaScript/TypeScript            every string literal, comments dropped, a template literal as a glob; a relative specifier
                                   resolves with the module extensions (`./x` -> `./x.mjs`, `./x/index.ts`)
  Nix                              every word naming a file (`./x`, a path in a shellHook); in flake.nix only the dev shell the lane
                                   enters (`nix develop .#NAME`, default `default`) and the let bindings it uses
  pnpm                             `pnpm [--filter P | -C DIR] [run] X`: P's package.json (its `scripts.X` is the command) and what
                                   that script names

A word names a file when it is a tracked file joined to the root, to the referring file's directory or to a directory the file names
(`ROOT / 'scripts' / name`); a bare shell word with no `/` before or in it is relative to the working directory only (`pnpm install`
is not scripts/install). A mention counts like a call (a path in a message is in the closure too): the walk errs wide.

What ends the walk, on purpose:
  * The tree under test (SUBJECT: the Rust workspace and the pnpm workspace packages, the lanes' `tree_inputs`): a script that reads
    a crate's build.rs to lint it reads the check's subject, not its definition. HARNESS (the lanes' own runners inside a package)
    is followed like scripts/, and a package.json whose script a pnpm call runs is in the closure.
  * Files outside FOLLOWED (scripts/, nix/, HARNESS) are read as data: a workflow or doc that names scripts is not run by a lane.
  * A directory the code lists (iterdir, glob, rglob, listdir, walk, find, `dir/*.json`) is all in the closure inside FOLLOWED (the
    lanes' own fixtures); elsewhere it is the tree the code checks (a lint over crates/, every release note), reported, not added.
  * NOT_FOLLOWED, NOT_READ and NOT_DEFINITION name the few files the rules above get wrong, each with why; EXTRA adds the edges no
    reference shows; TOOL_FILES the files a tool the lane runs reads by convention (nextest's .config/nextest.toml).

--check prints, per lane, the closure paths its definition_paths do not cover (exit 1 if any). --write sets each lane's
definition_paths to its closure (run it in a full checkout, then review the diff). Exit 2 for a usage error. Needs Python and git.
"""
import argparse
import ast
import json
import os
import posixpath
import re
import subprocess
import sys

sys.dont_write_bytecode = True

LANES = '.st/required-lanes.json'

# Edges no static reference shows, each with why. Keep this small: a reference the scanner can see belongs in the code it is in.
EXTRA = {
    # The recorded argv only reads one crate's result out of a JUnit report; the report is made by the tests stage that
    # scripts/st-test runs for the crates without a note (RUN_TESTS), so that stage is part of what a rust-tests note says.
    'rust-tests': {'argv': [['nix', 'develop', '-c', 'bash', 'scripts/ci-local', 'tests']]},
}
# The tree under test: what the lanes build and test (the Rust workspace, the pnpm workspace packages), their `tree_inputs`. A script
# that reads a file here (a lint over the crates, a test that copies a build script into a fixture) reads the subject of the check,
# not its definition: a change there changes the result the way any source change does, so the walk ends there. HARNESS are the
# directories inside it that hold the lanes' own runners (scripts/ci-fractal-web runs apps/fractal-web/scripts/ci/*.mjs), which
# are followed like scripts/. A package.json whose script a lane's pnpm call runs is in the closure (its `scripts` entry is the
# command). Nothing outside SUBJECT is assumed to be the subject.
SUBJECT = ('Cargo.toml', 'Cargo.lock', 'src', 'tests', 'crates', 'components', 'examples', 'wit', 'vendor',
           'apps/fractal-web', 'apps/ios', 'clients/typescript', 'packages/fractal-sdk', 'packages/fractal-ui')
HARNESS = ('apps/fractal-web/scripts/ci', 'packages/fractal-ui/scripts')
# Where the lanes' own code lives. A file elsewhere that the code names (a workflow, a doc, a fixture, a baseline) is read as data:
# it is in the closure, and what it names is not followed (a workflow source that names every script is not run by a lane).
FOLLOWED = ('scripts', 'nix') + HARNESS
# Files the scanner finds that are not a lane's definition, each with why.
NOT_DEFINITION = {
    # flake.nix reads it only in an `assert` that the pty input pins the libghostty bindings the crate names: it can stop the dev
    # shell from evaluating, not change what the shell holds. It is the tree under test (docs/per-crate-test-signing.md keeps Cargo
    # manifests out of lane definitions).
    'crates/fractal/Cargo.toml',
}

# Paths a file names without reading them, each with why: referring file -> paths.
NOT_READ = {
    # Workflow paths as GitHub's API reports them (a run's `path`), matched against API responses; the files are never opened.
    'scripts/ci-build-snapshot': {'.github/workflows/fleet.yml', '.github/workflows/main-upkeep.yml', '.github/workflows/macos.yml',
                                  '.github/workflows/release-smalltalk.yml'},
    # The same, in a fake API response; and the .gitignore it writes into its fixture checkout.
    'scripts/ci-build-snapshot-test': {'.github/workflows/fleet.yml', '.gitignore'},
    'scripts/ci-perf-cache': {'.github/workflows/daily-long.yml', '.github/workflows/perf.yml'},  # the same
}

# Files that are part of a lane but whose references are not followed, each with why: what they name does not run in the lane.
NOT_FOLLOWED = {
    # The default dev shell's shellHook runs it outside CI; it only writes a pre-push hook stub, which at push time runs the BASE
    # branch's scripts/evidence-prepush and scripts/st-test (git archive of <remote>/main), never the tree's, and never in the lane.
    'scripts/install-git-hooks',
}

# Files a tool reads by convention, without the lane's code naming them: tool name (a word in the lane's code) -> files.
TOOL_FILES = {
    'nextest': ('.config/nextest.toml',),  # cargo-nextest's profiles (the ci profile, retries, the JUnit report)
    'cargo': ('.cargo/config.toml',),  # rustflags, [env] and any runner, for every cargo command the lane runs
    'pnpm': ('package.json', 'pnpm-lock.yaml', 'pnpm-workspace.yaml'),  # the root manifest, the lockfile, the workspace
}

# Shell functions that run a file named by their arguments: name -> the path an argument stands for.
FUNCTIONS = {'parallel_tests': 'scripts/{}'}  # scripts/ci-parallel-tests: `python3 "scripts/$1"` for each argument
FUNCTIONS_RE = re.compile(r'(?:^|[\s;&|(])(' + '|'.join(map(re.escape, FUNCTIONS)) + r')((?:[ \t]+[A-Za-z0-9_.@+-]+|[ \t]*\\\n)*)', re.M)

PY_SHEBANG = re.compile(rb'^#!.*\bpython[0-9.]*\b')
SH_SHEBANG = re.compile(rb'^#!.*\b(?:bash|sh|zsh)\b')
JS_SHEBANG = re.compile(rb'^#!.*\b(?:node|tsx|bun|deno)\b')
JS_EXTENSIONS = ('.js', '.mjs', '.cjs', '.ts', '.mts', '.cts', '.tsx', '.jsx')
# A word that can name a path: delimited by blanks, quotes, `=`, `:` (before), `/` (before: `$(dirname "$0")/x`, `$root/x`) or shell
# punctuation, so `st-test:config` or `x.y.z()` is not one.
WORD = re.compile(r'(?<![^\s\'"`=(;|&<>/{}\[\],:])([A-Za-z0-9_.@+*~#-]*[A-Za-z0-9_*][A-Za-z0-9_.@+*~#/-]*)(?![^\s\'"`);|&<>}\],])')
ENUMERATING = re.compile(r'\*+(?:\.[A-Za-z0-9]+)*\Z')
LISTING_ATTRS = {'iterdir', 'glob', 'rglob'}
LISTING_CALLS = {'listdir', 'walk', 'scandir'}
SH_LISTING = re.compile(r'(?:^|[\s;|&(])(?:find|ls)\s+(?:-\S+\s+)*["\']?([A-Za-z0-9_.@+/$}{-]+)')
PNPM = re.compile(r'(?:^|[ \t;|&(`])pnpm((?:[ \t]+[^\s;|&)`]+)*)', re.M)


class Repo:
    """The tracked files of a checkout (git ls-files; a plain walk when it is not a git checkout) and their directories."""

    def __init__(self, root):
        self.root = os.path.realpath(root)
        try:
            done = subprocess.run(['git', '-C', self.root, 'ls-files', '-z', '--cached'], capture_output=True)
        except OSError:  # no git (a Nix sandbox's copy of the flake source): the copy holds only tracked files
            done = None
        if done is not None and done.returncode == 0:
            names = [name for name in done.stdout.decode('utf-8', 'surrogateescape').split('\0') if name]
        else:
            names = []
            for top, dirs, files in os.walk(self.root):
                dirs[:] = [d for d in dirs if d not in ('.git', 'node_modules')]
                names += [os.path.relpath(os.path.join(top, f), self.root).replace(os.sep, '/') for f in files]
        self.files = {name for name in names if os.path.lexists(os.path.join(self.root, name))}
        self.dirs = set()
        self.children = {}
        for name in self.files:
            self.children.setdefault(posixpath.dirname(name), []).append(name)
            parent = posixpath.dirname(name)
            while parent and parent not in self.dirs:
                self.dirs.add(parent)
                parent = posixpath.dirname(parent)
        self._globs = {}

    def read(self, path):
        with open(os.path.join(self.root, path), 'rb') as handle:
            return handle.read()

    def glob(self, pattern):
        """The tracked files matching a pattern whose `*` and `?` do not cross a `/` (a wildcard only in the last part)."""
        if pattern not in self._globs:
            directory, _, last = pattern.rpartition('/')
            found = set()
            if '*' not in directory and '?' not in directory and last.strip('*?'):
                regex = re.compile(''.join('[^/]*' if c == '*' else '[^/]' if c == '?' else re.escape(c) for c in last) + r'\Z')
                found = {name for name in self.children.get(directory, ()) if regex.match(posixpath.basename(name))}
            self._globs[pattern] = found
        return self._globs[pattern]

    def below(self, directory):
        return sorted(name for name in self.files if name.startswith(directory + '/'))


def normal(base, word):
    """`word` joined to `base`, normalized; None when it leaves the repository."""
    path = posixpath.normpath(posixpath.join(base, word)) if base else posixpath.normpath(word)
    if path in ('.', '') or path.startswith('../') or path == '..' or path.startswith('/'):
        return None
    return path


def resolve(repo, word, bases, js=False, globs=False):
    """(files, directories, listed directories) a word names relative to any of `bases`. With `globs`, a word with a `/` and a `*`
    or `?` names the files it matches, or, when only the extension is fixed (`dir/*.json`), lists the directory."""
    files, dirs, listed = set(), set(), set()
    word = word.strip().rstrip('/')
    if not word or word.startswith('/') and not word.strip('/'):
        return files, dirs, listed
    tries = [word.lstrip('/')]
    for attempt in tries:
        if not attempt or attempt in ('.', '..'):
            continue
        for base in bases:
            path = normal(base, attempt)
            if path is None:
                continue
            if '*' in path or '?' in path:
                directory, _, last = path.rpartition('/')
                if globs and '/' in attempt and directory in repo.dirs:
                    if ENUMERATING.match(last):
                        listed.add(directory)  # dir/*.json enumerates the directory: a listing
                    else:
                        files |= repo.glob(path)  # dir/*-baseline.json selects among named files
                continue
            if path in repo.files:
                files.add(path)
            elif js and (attempt.startswith('./') or attempt.startswith('../') or word.startswith('.')):
                for suffix in JS_EXTENSIONS + tuple('/index' + e for e in JS_EXTENSIONS):
                    if path + suffix in repo.files:
                        files.add(path + suffix)
                        break
            if path in repo.dirs and attempt == tries[0]:
                dirs.add(path)
    return files, dirs, listed


def kind(repo, path):
    name = posixpath.basename(path)
    if name == 'package.json':
        return 'package'
    if path.endswith('.py'):
        return 'python'
    if path.endswith(('.sh', '.bash')):
        return 'shell'
    if path.endswith(JS_EXTENSIONS):
        return 'js'
    if path.endswith('.nix'):
        return 'nix'
    if '.' in name.lstrip('.'):
        return 'data'
    try:
        head = repo.read(path)[:200]
    except OSError:
        return 'data'
    if PY_SHEBANG.match(head):
        return 'python'
    if SH_SHEBANG.match(head):
        return 'shell'
    if JS_SHEBANG.match(head):
        return 'js'
    return 'data'


def shell_code(text):
    """Shell text without its comments: a `#` that starts a word outside quotes ends the line (quotes reset at each line)."""
    out = []
    for line in text.splitlines():
        quote, kept, prev = None, [], ' '
        for char in line:
            if quote:
                if char == quote:
                    quote = None
            elif char in '\'"':
                quote = char
            elif char == '#' and (prev.isspace() or prev in ';|&('):
                break
            kept.append(char)
            prev = char
        out.append(''.join(kept))
    return '\n'.join(out)


def shell_words(text):
    """(words, listed directory words, pnpm invocations) of shell code.

    A word right after a `/` (`$(dirname "$0")/x`, `"$here"/x`) comes back as `/x`: it is relative to some directory, the script's
    own included. The NAMEs of `parallel_tests NAME...` (scripts/ci-parallel-tests runs `python3 scripts/NAME`) come back as
    `scripts/NAME`."""
    code = shell_code(text)
    listed = [m.group(1) for m in SH_LISTING.finditer(code)]
    pnpm = [m.group(1).split() for m in PNPM.finditer(code)]
    words = [('/' if m.start() and code[m.start() - 1] == '/' else '') + m.group(1) for m in WORD.finditer(code)]
    for call in FUNCTIONS_RE.finditer(code):
        words += [FUNCTIONS[call.group(1)].format(name) for name in re.findall(r'[A-Za-z0-9_.@+-]+', call.group(2))]
    return words, listed, pnpm


def docstring_nodes(tree):
    found = set()
    for node in ast.walk(tree):
        body = getattr(node, 'body', None)
        if isinstance(body, list):
            for stmt in body:
                if isinstance(stmt, ast.Expr) and isinstance(stmt.value, ast.Constant) and isinstance(stmt.value.value, str):
                    found.add(id(stmt.value))
    return found


def constants(node):
    """The string constants of an expression in source order (`ROOT / 'a' / 'b'` -> ['a', 'b'])."""
    if isinstance(node, ast.Constant):
        return [node.value] if isinstance(node.value, str) else []
    return [value for child in ast.iter_child_nodes(node) for value in constants(child)]


def python_words(text):
    """(constants, words inside them, listed directory words, module names) of Python source, docstrings left out.

    A constant is a path itself ('scripts/x', HERE / 'x') or text with paths in it (a `bash -c` line, a message): the words inside
    are read as shell words."""
    tree = ast.parse(text)
    skip = docstring_nodes(tree)
    words, inner, listed, modules, patterns = [], [], [], [], []
    for node in ast.walk(tree):
        if isinstance(node, ast.Constant) and isinstance(node.value, str) and id(node) not in skip:
            words.append(node.value)
            inner += shell_words(node.value)[0]
        elif isinstance(node, ast.JoinedStr):
            # f'.github/{name}-compat-baseline.json' names every file that matches .github/*-compat-baseline.json.
            patterns.append(''.join(v.value if isinstance(v, ast.Constant) else '*' for v in node.values))
        elif isinstance(node, ast.Import):
            modules += [alias.name for alias in node.names]
        elif isinstance(node, ast.ImportFrom) and node.module and not node.level:
            modules.append(node.module)
        elif isinstance(node, ast.Call):
            func = node.func
            if isinstance(func, ast.Attribute) and func.attr in LISTING_ATTRS:
                parts = constants(func.value)
                if parts:
                    listed.append('/'.join(parts))
            name = func.attr if isinstance(func, ast.Attribute) else func.id if isinstance(func, ast.Name) else None
            if name in LISTING_CALLS or name == 'glob' and isinstance(func, ast.Attribute) and isinstance(func.value, ast.Name):
                for arg in node.args:
                    parts = constants(arg)
                    if parts:
                        listed.append('/'.join(part.strip('/') for part in parts))
    return words, inner, listed, modules, patterns


def js_strings(text):
    """(string literals, template patterns) of JavaScript or TypeScript source, comments dropped: a template literal's static
    parts are literals, and the template with each `${...}` as `*` is a pattern."""
    strings, patterns, i, n = [], [], 0, len(text)
    while i < n:
        c = text[i]
        if c == '/' and text[i + 1:i + 2] == '/':
            i = text.find('\n', i)
            i = n if i < 0 else i
        elif c == '/' and text[i + 1:i + 2] == '*':
            i = text.find('*/', i + 2)
            i = n if i < 0 else i + 2
        elif c in '\'"`':
            j, buf, whole = i + 1, [], []
            while j < n and text[j] != c:
                if text[j] == '\\':
                    buf.append(text[j:j + 2])
                    j += 2
                    continue
                if c == '`' and text[j:j + 2] == '${':
                    strings.append(''.join(buf))
                    whole += buf + ['*']
                    buf, depth = [], 1
                    j += 2
                    while j < n and depth:
                        depth += {'{': 1, '}': -1}.get(text[j], 0)
                        j += 1
                    continue
                if c != '`' and text[j] == '\n':
                    break
                buf.append(text[j])
                j += 1
            strings.append(''.join(buf))
            if '*' in whole:
                patterns.append(''.join(whole + buf))
            i = j + 1
        else:
            i += 1
    return strings, patterns


def nix_code(text):
    return '\n'.join(re.sub(r'(^|\s)#.*$', r'\1', line) for line in text.splitlines())


def nix_statement(text, start):
    """The text from `start` to the `;` that ends that binding (brackets, strings and '' strings respected)."""
    depth, i, n = 0, start, len(text)
    while i < n:
        if text.startswith("''", i):
            i += 2
            while i < n:
                if text.startswith("'''", i) or text.startswith("''$", i) or text.startswith("''\\", i):
                    i += 3
                elif text.startswith("''", i):
                    i += 2
                    break
                else:
                    i += 1
            continue
        c = text[i]
        if c == '"':
            i += 1
            while i < n and text[i] != '"':
                i += 2 if text[i] == '\\' else 1
        elif c in '{[(':
            depth += 1
        elif c in '}])':
            depth -= 1
        elif c == ';' and depth == 0:
            return text[start:i + 1]
        i += 1
    return text[start:]


def flake_shell(text, shell):
    """The text of flake.nix that decides `devShells.<shell>`: its binding and, transitively, the let bindings it names.

    The let bindings are the names bound at the dev shell's own indentation (the outputs' `let ... in` beside it); a name after
    a `.` (`pkgs.cargo`), inside a path (`./crates/fractal/...`) or before a `=` (an attribute of the shell) is not a use."""
    code = nix_code(text)
    found = re.search(rf'^([ \t]*)devShells\.{re.escape(shell)}\s*=', code, re.M)
    if not found:
        raise ValueError(f'flake.nix has no devShells.{shell}')
    indent = found.group(1)
    bindings = {}
    for match in re.finditer(rf"^{indent}([A-Za-z_][A-Za-z0-9_'-]*)\s*=(?!=)", code, re.M):
        bindings.setdefault(match.group(1), match.start())
    seen, todo, parts = set(), [found.start()], []
    while todo:
        start = todo.pop()
        if start in seen:
            continue
        seen.add(start)
        block = nix_statement(code, start)
        parts.append(block)
        for use in re.finditer(r"(?<![A-Za-z0-9_'./-])([A-Za-z_][A-Za-z0-9_'-]*)(?![A-Za-z0-9_'/-]|\s*=[^=])", block):
            name = use.group(1)
            if name in bindings and bindings[name] != start:
                todo.append(bindings[name])
    return '\n'.join(parts)


def under(path, prefixes):
    return any(path == p or path.startswith(p + '/') for p in prefixes)


class Closure:
    def __init__(self, repo):
        self.repo = repo
        self.files = set()
        self.dirs = set()
        self.scanned = set()
        self.why = {}
        self.listings = {}
        self.subject = {}
        self.tools = set()

    def add(self, path, because, manifest=False):
        if path in NOT_DEFINITION or path in self.files or path in NOT_READ.get(because, ()):
            return
        if under(path, SUBJECT) and not under(path, HARNESS) and not manifest:
            self.subject.setdefault(path, because)
            return
        self.files.add(path)
        self.why[path] = because
        what = kind(self.repo, path)
        if what == 'data' or path in NOT_FOLLOWED or not under(path, FOLLOWED):
            return
        if what == 'nix' and not because.endswith('.nix'):
            return  # a Nix file is evaluated when the dev shell's Nix code imports it; a script that names one reads it
        self.scan(path)

    def add_dir(self, path, because):
        if path not in self.dirs:
            self.dirs.add(path)
            self.why[path + '/'] = because
            for name in self.repo.below(path):
                self.add(name, because)

    def words(self, words, bases, origin, js=False, globs=False, narrow=()):
        """Add the files the words name. A word resolves from the referring file's directory, the root and every directory the file
        names (`ROOT / 'scripts' / name`, `cd apps/x && node scripts/y`). A `narrow` word (a shell word, or a word inside a longer
        string) with no `/` before or inside it is an argument relative to the working directory, so it does not resolve from the
        file's own directory (`pnpm install` is not scripts/install); a script that runs from elsewhere names that directory."""
        everything = sorted(set(words) | set(narrow))
        self.tools |= set(TOOL_FILES) & set(everything)
        mentioned = set()
        for word in everything:
            _, dirs, _ = resolve(self.repo, word, bases, js)
            mentioned |= dirs
        named = sorted(mentioned - set(bases))
        here = bases[0] if bases and bases[0] else None
        broad = set(words)
        for word in everything:
            look = list(bases) + named
            if word not in broad and here and '/' not in word:
                look = [base for base in look if base != here] or ['']
            files, _, listed = resolve(self.repo, word, look, js, globs)
            for path in sorted(files):
                self.add(path, origin)
            self.list_dirs(listed, origin)

    def patterns(self, patterns, bases, origin):
        """A string built at run time (an f-string, a template literal) with its parts as `*`: the files it can name."""
        for pattern in patterns:
            if '/' in pattern.strip('/'):
                files, _, listed = resolve(self.repo, pattern, bases, globs=True)
                for path in sorted(files):
                    self.add(path, origin)
                self.list_dirs(listed, origin)

    def listed(self, words, bases, origin):
        """A directory the code lists (iterdir, glob, find, ...). Inside the lanes' own code (FOLLOWED) all of it is in the closure;
        elsewhere what it finds is the tree the code checks (a lint over crates/), recorded (`listings`) but not in the closure."""
        for word in words:
            _, dirs, _ = resolve(self.repo, word, bases)
            self.list_dirs(dirs, origin)

    def list_dirs(self, dirs, origin):
        for path in sorted(dirs):
            if under(path, FOLLOWED):
                self.add_dir(path, origin)  # the lanes' own fixtures and helpers (scripts/x/schemas): all of it is read
            else:
                self.listings.setdefault(path, set()).add(origin)

    def pnpm(self, invocations, cwd, origin):
        """pnpm [--filter P | -F P | -C DIR] [run|exec] SCRIPT ...: the package.json whose script runs, and that script."""
        packages = self.packages()
        for args in invocations:
            targets, rest, i = [], [], 0
            while i < len(args):
                arg = args[i].strip('\'"')
                if arg in ('--filter', '-F') and i + 1 < len(args):
                    targets.append(args[i + 1].strip('\'"'))
                    i += 2
                    continue
                if arg.startswith('--filter='):
                    targets.append(arg.split('=', 1)[1])
                elif arg in ('-C', '--dir') and i + 1 < len(args):
                    targets.append(normal(cwd, args[i + 1].strip('\'"')) or '')
                    i += 2
                    continue
                elif not arg.startswith('-'):
                    rest.append(arg)
                i += 1
            dirs = []
            for target in targets or [cwd]:
                if target in packages:
                    dirs.append(packages[target])
                elif target in self.repo.dirs or target == '':
                    dirs.append(target)
            if not rest or rest[0] in ('install', 'i', 'add', 'exec', 'dlx', 'x'):
                command = None
            else:
                command = rest[1] if rest[0] == 'run' and len(rest) > 1 else rest[0]
            for directory in dirs:
                manifest = posixpath.join(directory, 'package.json') if directory else 'package.json'
                if manifest not in self.repo.files:
                    continue
                self.add(manifest, origin, manifest=True)
                if command:
                    self.package_script(manifest, command, origin)

    def packages(self):
        if not hasattr(self, '_packages'):
            self._packages = {}
            for name in self.repo.files:
                if posixpath.basename(name) == 'package.json' and '/node_modules/' not in '/' + name:
                    try:
                        self._packages[json.loads(self.repo.read(name)).get('name')] = posixpath.dirname(name)
                    except (OSError, ValueError, AttributeError):
                        pass
        return self._packages

    def package_script(self, manifest, command, origin):
        key = (manifest, command)
        if key in self.scanned:
            return
        self.scanned.add(key)
        try:
            scripts = json.loads(self.repo.read(manifest)).get('scripts') or {}
        except (OSError, ValueError, AttributeError):
            return
        line = scripts.get(command)
        if not isinstance(line, str):
            return
        directory = posixpath.dirname(manifest)
        words, _, pnpm = shell_words(line)
        # A package script runs from its package. What it names inside a workspace package (its tests, configs and own tools) is
        # the package under test (SUBJECT), unless it is one of the lanes' runners (HARNESS).
        for word in words:
            files, _, _ = resolve(self.repo, word, [directory, ''])
            for path in sorted(files):
                self.add(path, f'{manifest} scripts.{command}')
        self.pnpm(pnpm, directory, f'{manifest} scripts.{command}')

    def scan(self, path):
        if path in self.scanned:
            return
        self.scanned.add(path)
        what = kind(self.repo, path)
        here = posixpath.dirname(path)
        bases = [here, ''] if here else ['']
        text = self.repo.read(path).decode('utf-8', 'replace')
        if what == 'shell':
            words, listed, pnpm = shell_words(text)
            self.words([], bases, path, globs=True, narrow=words)
            self.listed(listed, bases, path)
            self.pnpm(pnpm, '', path)
        elif what == 'python':
            try:
                words, inner, listed, modules, patterns = python_words(text)
            except SyntaxError:
                words, inner, listed, modules, patterns = [], WORD.findall(text), [], [], []
            self.words(words, bases, path, narrow=inner)
            self.patterns(patterns, bases, path)
            self.listed(listed, bases, path)
            for module in modules:
                stem = module.replace('.', '/')
                for candidate in (stem + '.py', stem + '/__init__.py'):
                    for base in bases:
                        found = normal(base, candidate)
                        if found in self.repo.files:
                            self.add(found, path)
            _, _, pnpm = shell_words('\n'.join(w for w in words if 'pnpm' in w))
            self.pnpm(pnpm, '', path)
        elif what == 'js':
            strings, patterns = js_strings(text)
            inner = [word for value in strings for word in shell_words(value)[0]]
            self.words(strings, bases, path, js=True, narrow=inner)
            self.patterns(patterns, bases, path)
        elif what == 'nix':
            code = flake_shell(text, self.shell) if path == 'flake.nix' and getattr(self, 'shell', None) else nix_code(text)
            self.words(WORD.findall(code), bases, path)
        elif what == 'package':
            pass  # a manifest is followed by the script a pnpm call names (package_script), not as a whole

    def argv(self, argv, origin):
        """A lane argv: `nix develop [.#SHELL] -c CMD...` enters flake.nix's dev shell, then runs CMD from the root."""
        command = list(argv)
        if command[:2] == ['nix', 'develop']:
            rest = command[2:]
            shell = 'default'
            if rest and rest[0].startswith('.#'):
                shell = rest[0][2:]
                rest = rest[1:]
            if '-c' not in rest and '--command' not in rest:
                raise ValueError(f'{origin}: nix develop without -c')
            at = rest.index('-c') if '-c' in rest else rest.index('--command')
            command = rest[at + 1:]
            for name in ('flake.nix', 'flake.lock'):
                if name in self.repo.files:
                    self.files.add(name)
                    self.why[name] = origin
            self.shell = shell
            self.scanned.discard('flake.nix')
            self.scan('flake.nix')
            self.shell = None
        line = ' '.join(command)
        if command[:2] in (['bash', '-c'], ['sh', '-c']) and len(command) == 3:
            line = command[2]
        words, listed, pnpm = shell_words(line)
        self.words([], [''], origin, globs=True, narrow=words)
        self.listed(listed, [''], origin)
        self.pnpm(pnpm, '', origin)

    def finish(self, origin):
        """Add what the walk implies: the files of each tool the lane runs (TOOL_FILES) and, for a HARNESS directory the lane runs
        code from, the whole directory (the lane's runner and its helpers)."""
        for tool in sorted(self.tools):
            for path in TOOL_FILES[tool]:
                if path in self.repo.files:
                    self.add(path, f'{origin} runs {tool}')
        for harness in HARNESS:
            if harness in self.repo.dirs and any(under(name, (harness,)) for name in self.files):
                self.add_dir(harness, f'{origin} runs code in {harness}')

    def paths(self):
        """The closure as sorted paths: a listed directory stands for everything below it."""
        out = set(self.dirs)
        for name in self.files:
            if not any(name == d or name.startswith(d + '/') for d in self.dirs):
                out.add(name)
        return sorted(p for p in out if not any(p != d and p.startswith(d + '/') for d in self.dirs))


def lane_closure(repo, entry, lane=None):
    """The closure of one lane entry ({argv, ...}) in `repo`, as a Closure."""
    closure = Closure(repo)
    closure.argv(entry['argv'], f'{lane or "lane"} argv')
    for extra in EXTRA.get(lane, {}).get('argv', []):
        closure.argv(extra, f'{lane} EXTRA')
    closure.finish(lane or 'lane')
    return closure


def covered(path, declared):
    return any(path == d or path.startswith(d.rstrip('/') + '/') for d in declared)


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('--root', default=os.path.join(os.path.dirname(os.path.abspath(__file__)), '..'))
    parser.add_argument('--lanes', help=f'the lane file (default: ROOT/{LANES})')
    parser.add_argument('--lane', action='append', default=[], help='only this lane (repeatable)')
    parser.add_argument('--json', action='store_true', help='print {lane: [paths]}')
    parser.add_argument('--why', action='store_true', help='print, for each path, the file that names it')
    parser.add_argument('--check', action='store_true', help='exit 1 when a lane\'s closure is not covered by its definition_paths')
    parser.add_argument('--write', action='store_true', help='set each lane\'s definition_paths in the lane file to its closure')
    args = parser.parse_args(argv)
    if sum((args.json, args.why, args.check, args.write)) > 1:
        parser.error('--json, --why, --check and --write are exclusive')
    repo = Repo(args.root)
    lane_file = args.lanes or os.path.join(repo.root, LANES)
    try:
        with open(lane_file) as handle:
            document = json.load(handle)
        lanes = document['lanes']
    except (OSError, ValueError, KeyError, TypeError) as error:
        print(f'lane-definition-closure: cannot read the lane file: {error}', file=sys.stderr)
        return 2
    names = args.lane or sorted(lanes)
    unknown = [name for name in names if name not in lanes]
    if unknown:
        print(f'lane-definition-closure: no lane {", ".join(unknown)}', file=sys.stderr)
        return 2
    result, failed = {}, False
    for name in names:
        closure = lane_closure(repo, lanes[name], name)
        result[name] = closure.paths()
        if args.check:
            missing = [p for p in result[name] if not covered(p, lanes[name]['definition_paths'])]
            if missing:
                failed = True
                print(f'{name}: {len(missing)} file(s) the lane reads are not in its definition_paths:')
                for path in missing:
                    print(f'  {path}   (named by {closure.why.get(path) or closure.why.get(path + "/")})')
            else:
                print(f'{name}: closure of {len(result[name])} path(s) covered by its definition_paths')
        elif args.write:
            lanes[name]['definition_paths'] = result[name]
        elif not args.json:
            print(f'{name}:')
            for path in result[name]:
                print(f'  {path}' + (f'   <- {closure.why.get(path) or closure.why.get(path + "/")}' if args.why else ''))
            if args.why:
                for path, origins in sorted(closure.listings.items()):
                    print(f'  (lists {path}/, the tree it checks: {", ".join(sorted(origins))})')
    if args.json:
        print(json.dumps(result, indent=2, sort_keys=True))
    if args.write:
        with open(lane_file, 'w') as handle:
            handle.write(json.dumps(document, indent=2) + '\n')
        print(f'wrote the definition_paths of {", ".join(names)} to {lane_file}')
    return 1 if failed else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
