#!/usr/bin/env python3
"""SLO counters for the evidence gate: how often is a required check covered by an existing note, by whom, and how often is a note produced but not verified.

  scripts/ci-evidence-slo --repository OWNER/NAME [--hours 24 | --since 2026-10-18T00:00:00Z] [--until ...] [--max-logs 300] [--json]

Reads the finished `Workspace CI` runs created in the interval and, for each `evidence-gate-<check>` job, the one fixed step that job ended with
(the gate prints exactly one: satisfied / degraded / no_note / rejected / unavailable, plus `evidence skip taken` when it decided to skip). Only
GitHub's read API is used; nothing is written, no run is started.

Counters, per check and per event (pull_request, merge_group, push):
  decisions               gate jobs that completed: the DENOMINATOR for everything else
  satisfied               an existing trusted note covered the run; of these `skipped` (the gate took the skip: enforce true) and `shadow` (it would have)
  satisfied_by_producer   the satisfied ones by `kind/trust_level` of the note (from the gate's decision line; a job whose log is not read is `unread`)
  produced_not_verified   a note exists and is NOT usable: `rejected` (refused: bad signature, untrusted signer, failed check ...) plus `degraded`
                          (only an unsigned degraded record). TARGET ZERO; the reasons are listed.
  no_note, unavailable    nothing usable found / verifier or notes could not be obtained (the check ran as before)
Rates are over `decisions`. `--max-logs` bounds the log downloads used for the producer split and the reasons (the step outcome needs none).
"""
import argparse
import collections
import concurrent.futures
import datetime
import json
import re
import subprocess
import sys

sys.dont_write_bytecode = True

OUTCOME_STEPS = {
    'evidence satisfied by existing note': 'satisfied',
    'evidence existing note is degraded': 'degraded',
    'evidence no note': 'no_note',
    'evidence note rejected': 'rejected',
    'evidence verifier unavailable': 'unavailable',
}
SKIP_STEP = 'evidence skip taken'
GATE_JOB = re.compile(r'^evidence-gate-([A-Za-z0-9._-]+)$')
DECISION = re.compile(r'evidence-decision v1 (.*)')


class GhApi:
    """GitHub's REST API through `gh api`, read only."""

    def get(self, path, paginate_key=None):
        command = ['gh', 'api', '--allow-escape-sequences', path]
        if paginate_key:
            command += ['--paginate', '--slurp']
        done = subprocess.run(command, capture_output=True, timeout=300)
        if done.returncode != 0:
            raise RuntimeError(f'gh api {path}: {done.stderr.decode(errors="replace")[:200]}')
        if paginate_key:
            return [item for page in json.loads(done.stdout) for item in page.get(paginate_key, [])]
        return json.loads(done.stdout)

    def log(self, job_id, repository):
        done = subprocess.run(['gh', 'api', '--allow-escape-sequences', f'repos/{repository}/actions/jobs/{job_id}/logs'], capture_output=True, timeout=300)
        return re.sub(r'\x1b\[[0-9;]*m', '', done.stdout.decode(errors='replace')) if done.returncode == 0 else ''


def parse_time(text):
    return datetime.datetime.fromisoformat(text.replace('Z', '+00:00'))


def decision_fields(log):
    """The gate's real decision line. The job log also echoes the step's own shell text, which contains a literal `echo "evidence-decision v1
    check=$CHECK ..."` fallback: a candidate is real only when it has no unexpanded `$` and carries the verifier digest the gate always prints."""
    for found in DECISION.finditer(log or ''):
        fields = dict(part.split('=', 1) for part in found.group(1).split() if '=' in part)
        if '$' not in found.group(1) and 'gate_sha256' in fields:
            return fields
    return {}


def job_outcome(job):
    """(outcome, skipped) from the one fixed step the gate job ended with, or (None, False) when the job did not finish its gate."""
    outcome, skipped = None, False
    for step in job.get('steps', []):
        if step.get('conclusion') != 'success':
            continue
        if step.get('name') in OUTCOME_STEPS:
            outcome = OUTCOME_STEPS[step['name']]
        elif step.get('name') == SKIP_STEP:
            skipped = True
    return outcome, skipped


def collect(api, repository, since, until, max_logs=300):
    runs = api.get(f'repos/{repository}/actions/workflows/fleet.yml/runs?per_page=100&created={since.strftime("%Y-%m-%dT%H:%M:%SZ")}..{until.strftime("%Y-%m-%dT%H:%M:%SZ")}', 'workflow_runs')
    table = collections.defaultdict(lambda: collections.Counter())
    producers = collections.defaultdict(collections.Counter)
    reasons = collections.defaultdict(collections.Counter)
    logs_read = 0
    runs_seen = 0
    finished = [run for run in runs if run.get('status') == 'completed']  # a run still going has gate jobs that may not have finished: counted next time
    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:  # one jobs request per run; they are independent reads
        job_lists = list(pool.map(lambda run: api.get(f'repos/{repository}/actions/runs/{run["id"]}/jobs?per_page=100&filter=all', 'jobs'), finished))
    for run, jobs in zip(finished, job_lists):
        runs_seen += 1
        event = run.get('event', '?')
        for job in jobs:
            matched = GATE_JOB.match(job.get('name', ''))
            if not matched or job.get('status') != 'completed':
                continue
            check = matched.group(1)
            outcome, skipped = job_outcome(job)
            key = (check, event)
            if outcome is None:
                table[key]['gate_incomplete'] += 1  # the gate job failed or was cancelled before it printed its outcome: not a decision
                continue
            table[key]['decisions'] += 1
            table[key][outcome] += 1
            if outcome == 'satisfied':
                table[key]['skipped' if skipped else 'shadow'] += 1
            if outcome in ('satisfied', 'rejected', 'degraded') and logs_read < max_logs:
                logs_read += 1
                fields = decision_fields(api.log(job['id'], repository))
                if outcome == 'satisfied':
                    producers[key][f'{fields.get("kind", "?")}/{fields.get("trust_level", "?")}'] += 1
                else:
                    reasons[key][fields.get('reason', '?')] += 1
            elif outcome == 'satisfied':
                producers[key]['unread'] += 1
    return table, producers, reasons, {'runs': runs_seen, 'logs_read': logs_read}


def render(table, producers, reasons, meta, since, until):
    rows = []
    for (check, event), counts in sorted(table.items()):
        total = counts['decisions']
        bad = counts['rejected'] + counts['degraded']
        rows.append({
            'check': check, 'event': event, 'decisions': total,
            'satisfied': counts['satisfied'], 'skipped': counts['skipped'], 'shadow': counts['shadow'],
            'satisfied_rate': round(counts['satisfied'] / total, 4) if total else None,
            'satisfied_by_producer': dict(producers[(check, event)]),
            'produced_not_verified': bad, 'rejected': counts['rejected'], 'degraded': counts['degraded'],
            'produced_not_verified_rate': round(bad / total, 4) if total else None,
            'produced_not_verified_reasons': dict(reasons[(check, event)]),
            'no_note': counts['no_note'], 'unavailable': counts['unavailable'], 'gate_incomplete': counts['gate_incomplete']})
    totals = {'decisions': sum(r['decisions'] for r in rows), 'satisfied': sum(r['satisfied'] for r in rows),
              'produced_not_verified': sum(r['produced_not_verified'] for r in rows)}
    return {'interval': {'since': since.isoformat(), 'until': until.isoformat()}, 'runs_read': meta['runs'], 'logs_read': meta['logs_read'],
            'totals': totals, 'target': {'produced_not_verified': 0}, 'checks': rows}


def main(argv, api=None, now=None):
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('--repository', required=True)
    parser.add_argument('--hours', type=float, default=24.0)
    parser.add_argument('--since')
    parser.add_argument('--until')
    parser.add_argument('--max-logs', type=int, default=300)
    parser.add_argument('--json', action='store_true')
    try:
        args = parser.parse_args(argv)
    except SystemExit as error:
        return 2 if error.code else 0
    if not re.fullmatch(r'[A-Za-z0-9._-]+/[A-Za-z0-9._-]+', args.repository) or args.hours <= 0 or args.max_logs < 0:
        print('bad --repository, --hours or --max-logs', file=sys.stderr)
        return 2
    try:
        until = parse_time(args.until) if args.until else (now or datetime.datetime.now(datetime.timezone.utc))
        since = parse_time(args.since) if args.since else until - datetime.timedelta(hours=args.hours)
    except ValueError:
        print('bad --since or --until', file=sys.stderr)
        return 2
    if since >= until:
        print('--since must be before --until', file=sys.stderr)
        return 2
    try:
        result = render(*collect(api or GhApi(), args.repository, since, until, args.max_logs), since, until)
    except Exception as error:  # an unreadable API is an error, never zeros
        print(f'could not read the runs: {type(error).__name__}: {error}', file=sys.stderr)
        return 1
    if args.json:
        print(json.dumps(result, indent=2))
    else:
        print(f'evidence gate, {result["interval"]["since"]} .. {result["interval"]["until"]}: {result["runs_read"]} runs, {result["logs_read"]} logs read')
        print(f'totals: {result["totals"]["decisions"]} decisions, {result["totals"]["satisfied"]} satisfied by an existing note, '
              f'{result["totals"]["produced_not_verified"]} produced-but-not-verified (target 0)')
        for row in result['checks']:
            rate = '-' if row['satisfied_rate'] is None else f'{row["satisfied_rate"]:.1%}'
            print(f'  {row["check"]:<26} {row["event"]:<12} decisions={row["decisions"]:<4} satisfied={row["satisfied"]:<4} ({rate}) skipped={row["skipped"]} '
                  f'by={row["satisfied_by_producer"] or "-"} bad={row["produced_not_verified"]} {row["produced_not_verified_reasons"] or ""}')
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
