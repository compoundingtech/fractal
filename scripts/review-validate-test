#!/usr/bin/env python3
"""A review verdict that does not parse or validate fails locally: every rule of docs/review-verdict.schema.json and the rules a
schema cannot say (final risk, GO and blocking findings, rounds) are checked."""
import copy
import json
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest
sys.dont_write_bytecode = True

HERE = Path(__file__).resolve().parent
SHA = "0123456789abcdef0123456789abcdef01234567"


def good():
    return {
        "version": 1, "head": SHA, "base": "f" * 40, "round": 1, "verdict": "GO",
        "risk": {
            "deterministic": {"level": "medium", "reasons": [{"rule": "workflows", "level": "medium", "paths": [".github/x.yml"], "lines": []}]},
            "llm": {"level": "low", "reasons": ["a workflow edit that only renames a job"]},
            "final": "medium",
        },
        "findings": [{"severity": "advisory", "file": "docs/x.md", "line": 3, "reason": "a stale comment", "fix": "update it"}],
        "flags": {name: {"value": "no", "why": "nothing of the kind"} for name in ("public_contract", "stored_format", "trust_or_permission", "global_view")},
        "read": {"full": ["docs/x.md"], "structure": [], "record": []},
        "patch_ids": {"docs/x.md": "a" * 40},
        "reviewer": {"model": "m", "family": "f", "harness": "h"},
        "standard": "sha256:" + "b" * 64,
        "text": "Does what it says.",
    }


class ReviewValidate(unittest.TestCase):
    def setUp(self):
        self.temporary = tempfile.TemporaryDirectory(prefix="review-validate-")
        self.addCleanup(self.temporary.cleanup)

    def run_validate(self, verdict, previous=None):
        path = Path(self.temporary.name) / "verdict.json"
        path.write_text(verdict if isinstance(verdict, str) else json.dumps(verdict))
        extra = []
        if previous is not None:
            extra = ["--previous", str(Path(self.temporary.name) / "previous.json")]
            Path(extra[1]).write_text(json.dumps(previous))
        return subprocess.run([sys.executable, str(HERE / "review-validate"), str(path), *extra], text=True, capture_output=True)

    def refused(self, verdict, text):
        done = self.run_validate(verdict)
        self.assertEqual(done.returncode, 1, done.stderr)
        self.assertIn(text, done.stderr)

    def test_copied_checkout_reader_prefers_new_schema_and_keeps_explicit_schema(self):
        import runpy
        tool = runpy.run_path(str(HERE / "review-validate"))
        root = Path(self.temporary.name)
        scripts = root / "scripts"
        scripts.mkdir()
        copied = scripts / "review-validate"
        copied.write_text((HERE / "review-validate").read_text())
        (root / ".st").mkdir()
        old = root / ".st/review-verdict.schema.json"
        old.write_text(tool["schema_path"]().read_text())
        verdict = root / "verdict.json"
        verdict.write_text(json.dumps(good()))
        command = [sys.executable, str(copied), str(verdict)]
        self.assertEqual(subprocess.run(command, capture_output=True).returncode, 0)
        (root / ".fractal").mkdir()
        new = root / ".fractal/review-verdict.schema.json"
        new.write_text("{")
        self.assertNotEqual(subprocess.run(command, capture_output=True).returncode, 0)
        self.assertEqual(subprocess.run([*command, "--schema", str(old)], capture_output=True).returncode, 0)
        new.write_text(old.read_text())
        later = good()
        later["round"] = 2
        verdict.write_text(json.dumps(later))
        previous = root / "previous.json"
        previous.write_text(json.dumps(good()))
        after_go = [*command, "--previous", str(previous)]
        self.assertEqual(subprocess.run(after_go, capture_output=True).returncode, 0)
        self.assertNotEqual(subprocess.run(command, capture_output=True).returncode, 0)
        new.write_text("{")
        self.assertNotEqual(subprocess.run(after_go, capture_output=True).returncode, 0)
        self.assertEqual(subprocess.run([*after_go, "--schema", str(old)], capture_output=True).returncode, 0)
        new.unlink()
        new.symlink_to("missing")
        self.assertNotEqual(subprocess.run(command, capture_output=True).returncode, 0)

    def test_a_good_verdict_validates(self):
        done = self.run_validate(good())
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(done.stderr, "")

    def test_what_does_not_parse_fails(self):
        self.refused("{not json", "does not parse")
        self.refused("[]", "expected object")

    def test_a_missing_or_unexpected_field_fails(self):
        for name in ("head", "risk", "findings", "reviewer", "standard", "text", "patch_ids"):
            verdict = good()
            del verdict[name]
            self.refused(verdict, f"{name} is missing")
        verdict = good()
        verdict["extra"] = 1
        self.refused(verdict, "unexpected extra")

    def test_values_outside_the_schema_fail(self):
        for path, value, text in (
            (("head",), "abc", "does not match"),
            (("verdict",), "MAYBE", "is not one of"),
            (("round",), 4, "above 3"),
            (("risk", "final"), "severe", "is not one of"),
            (("risk", "llm", "reasons"), [], "fewer than 1"),
            (("flags", "global_view", "value"), "maybe", "is not one of"),
            (("findings", 0, "line"), -1, "below 0"),
            (("findings", 0, "severity"), "nit", "is not one of"),
            (("standard",), "b" * 64, "does not match"),
            (("text",), "", "shorter than 1"),
            (("version",), 2, "is not one of"),
        ):
            with self.subTest(path=path):
                verdict = good()
                node = verdict
                for part in path[:-1]:
                    node = node[part]
                node[path[-1]] = value
                self.refused(verdict, text)

    def test_the_final_risk_is_the_higher_of_the_two_scores_and_the_model_cannot_lower_the_floor(self):
        verdict = good()
        verdict["risk"]["final"] = "low"
        self.refused(verdict, "not the higher of the two scores")
        verdict = good()
        verdict["risk"]["llm"]["level"] = "high"
        self.refused(verdict, "not the higher of the two scores")
        verdict["risk"]["final"] = "high"
        self.assertEqual(self.run_validate(verdict).returncode, 0)

    def test_the_factory_read_flag_is_the_final_medium_with_an_area_and_nothing_else(self):
        area = [{"area": "concurrency", "paths": ["crates/a.rs"], "lines": []}]
        verdict = good()
        verdict["risk"]["deterministic"].update(level="medium", factory_read=area)
        verdict["risk"].update(final="medium", needs_factory_read=True)
        verdict["risk"]["llm"]["level"] = "low"
        self.assertEqual(self.run_validate(verdict).returncode, 0, self.run_validate(verdict).stderr)
        verdict["risk"]["needs_factory_read"] = False
        self.refused(verdict, "risk.needs_factory_read")
        verdict["risk"].update(final="high", needs_factory_read=True)
        verdict["risk"]["llm"]["level"] = "high"
        self.refused(verdict, "risk.needs_factory_read")
        plain = good()
        plain["risk"]["deterministic"]["factory_read"] = []
        plain["risk"]["needs_factory_read"] = False
        self.assertEqual(self.run_validate(plain).returncode, 0)
        malformed = good()
        malformed["risk"]["deterministic"]["factory_read"] = [{"area": "x"}]
        self.refused(malformed, "factory_read")
        self.assertEqual(self.run_validate(good()).returncode, 0)

    def test_the_deterministic_level_cannot_be_lower_than_its_own_reasons(self):
        verdict = good()
        verdict["risk"]["deterministic"]["reasons"][0]["level"] = "high"
        self.refused(verdict, "is lower than the reason")

    def test_a_go_has_no_blocking_finding_and_a_changes_has_one(self):
        verdict = good()
        verdict["findings"][0]["severity"] = "blocking"
        self.refused(verdict, "GO with 1 blocking")
        verdict["verdict"] = "CHANGES"
        self.assertEqual(self.run_validate(verdict).returncode, 0)
        verdict["findings"] = []
        self.refused(verdict, "CHANGES without a blocking finding")

    def test_a_later_round_says_which_change_answers_which_finding(self):
        verdict = good()
        verdict["round"] = 2
        self.refused(verdict, "must say which change answers")
        verdict["answers"] = [{"finding": "docs/x.md:3", "change": SHA}]
        self.assertEqual(self.run_validate(verdict).returncode, 0)

    def test_a_later_round_after_a_go_has_nothing_to_answer(self):
        verdict = good()
        verdict["round"] = 2
        earlier = good()
        earlier["round"] = 2
        self.assertEqual(self.run_validate(verdict, previous=earlier).returncode, 0)
        earlier["verdict"] = "CHANGES"
        earlier["findings"][0]["severity"] = "blocking"
        done = self.run_validate(verdict, previous=earlier)
        self.assertEqual(done.returncode, 1)
        self.assertIn("must say which change answers", done.stderr)
        self.refused(verdict, "must say which change answers")


if __name__ == "__main__":
    unittest.main()
