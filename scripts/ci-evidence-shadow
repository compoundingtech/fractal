#!/usr/bin/env python3
"""Shadow-verify the notes a CI run just published, lane by lane, and say so in the job summary.

  scripts/ci-evidence-shadow --publish-result FILE --keys FILE --checks a,b,c [--verifier PATH] [--remote origin]

Nothing here gates anything. FILE is the JSON `scripts/evidence-publish` printed. For every lane in
--checks this script asks what a later gate would see: it fetches only the lane's published record
from the remote (depth 1, into a scratch repository that has nothing else), then runs the standalone
verifier against the tested tree with the accepted key list. A lane prints `ok` when a trusted,
signed note for this tree and lane exists on the remote, and `would-reject` with the verifier's reason
otherwise (a lane this run did not sign, such as one covered by an earlier note, is `would-reject
no_note`: it is a fact about this run, not a failure). A lane named in --optional is skipped by its own
paths (fractal-web runs only when web files changed): with no record it reads `n/a not_run` and counts in
neither ok nor would-reject.

One grep-able line per lane, then one total:

  evidence-shadow v1 check=C result=ok|would-reject|n/a reason=R record=ID signer=S kind=K seconds=N
  evidence-shadow v1 total lanes=N ok=N would_reject=N not_run=N refs_added=N seconds=N

The same lines go to $GITHUB_STEP_SUMMARY as a table. The exit status is 0 whatever the lanes say;
only a usage error is 2. Take this script and the verifier from the accepted base, not from the
tree under test.

With --compare-shadow PATH, both real lane evaluators share a frozen snapshot and retain raw outputs
and normalized counts. --snapshot-tree discovers remote tree-prefixed records, including other runs.
Only raw formatting/stderr differences are explained; all semantic differences remain unexplained.
"""
import argparse
from concurrent.futures import ThreadPoolExecutor
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import time

sys.dont_write_bytecode = True

OID = re.compile(r'^(?:[0-9a-f]{40}|[0-9a-f]{64})\Z')
CHECK = re.compile(r'^[a-z0-9][a-z0-9._-]{0,63}\Z')
NOTES = 'refs/notes/evidence/'
REF = re.compile(r'^(?:refs/notes/evidence/(?:[0-9a-f]{40,64}/)?|refs/tags/evidence/[0-9a-f]{40,64}/)[0-9a-f]{40,64}\Z')
TOKEN = re.compile(r'^[A-Za-z0-9._:/@+=-]+\Z')
HERE = Path(__file__).resolve().parent


def run(*args, cwd=None, timeout=120):
    clean = {k: v for k, v in os.environ.items() if not k.startswith('GIT_')}
    clean.update(GIT_TERMINAL_PROMPT='0', LC_ALL='C')
    try:
        return subprocess.run(args, cwd=cwd, capture_output=True, timeout=timeout, env=clean)
    except (subprocess.TimeoutExpired, OSError) as error:
        return subprocess.CompletedProcess(args, 124, b'', str(error).encode())


def token(value):
    text = '-' if value is None or value == '' else str(value)
    return text if TOKEN.match(text) else re.sub(r'[^A-Za-z0-9._:/@+=-]', '_', text)


def lane_lines(lanes, published, fetched, scratch, tree, verifier, keys, optional=()):
    """One result per lane: (check, ok, reason, verifier json or {}, seconds)."""
    results = []
    for check in lanes:
        started = time.monotonic()
        record = published.get(check)
        if record is None:
            results.append((check, None if check in optional else False, 'not_run' if check in optional else 'no_note', {}, 0.0))
            continue
        if record not in fetched:
            results.append((check, False, 'not_on_remote', {}, time.monotonic() - started))
            continue
        done = run(sys.executable, verifier, '--repo', str(scratch), '--tree', tree, '--check', check, '--keys', keys, timeout=60)
        try:
            result = json.loads(done.stdout)
        except ValueError:
            result = {}
        ok = done.returncode == 0 and result.get('satisfied') is True
        reason = 'satisfied' if ok else (result.get('reason') or f'verifier_exit_{done.returncode}')
        results.append((check, ok, reason, result, time.monotonic() - started))
    return results


def compare_shadow(args, lanes, published, fetched, scratch, tree, optional):
    """Compare both unmodified lane evaluators against one frozen remote snapshot."""
    def load(name, path):
        spec = spec_from_loader(name, SourceFileLoader(name, path))
        module = module_from_spec(spec)
        spec.loader.exec_module(module)
        return module

    def evaluator(name, path):
        module, captured = load(name, path), {}
        original = module.run
        def capture(*argv, **kwargs):
            done = original(*argv, **kwargs)
            captured[argv[argv.index('--check') + 1]] = done
            return done
        module.run = capture
        return module, captured

    local, old_captures = evaluator('fractal_shadow', __file__)
    external, captures = evaluator('mergemaster_shadow', args.compare_shadow)
    with ThreadPoolExecutor(max_workers=2) as workers:
        old = workers.submit(local.lane_lines, lanes, published, fetched, scratch, tree, args.verifier, args.keys, optional)
        new = workers.submit(external.lane_lines, lanes, published, fetched, scratch, tree,
                             str(Path(args.compare_shadow).with_name('evidence-verify')), args.keys, optional)
        old_results, new_results = old.result(), new.result()
        if [row[0] for row in old_results] != lanes or [row[0] for row in new_results] != lanes:
            raise ValueError('shadow evaluators must complete every requested lane in order')
        pairs = zip(old_results, new_results)
    summaries, decisions = [], []

    def normalize(row, captured):
        check, good, reason, result, _ = row
        done = captured.get(check)
        valid = done is None or isinstance(result, dict) and bool(result)
        outcome = ('not_run' if good is None else 'error' if not valid or reason in ('error', 'not_on_remote')
                   or done is not None and done.returncode not in (0, 1)
                   else 'satisfied' if good else 'expired' if reason == 'too_old' else 'rejected')
        return {'exit_status': done.returncode if done else None, 'verdict': outcome,
                'satisfied_checks': [check] if good else [],
                'selected_record_oids': sorted(set(filter(None, [result.get('record'), *result.get('crates', {}).values()]))),
                'reject_reason_class': reason if good is False else None, 'decision_output': result}

    for old, new in pairs:
        check = old[0]
        before, after = normalize(old, old_captures), normalize(new, captures)
        raw = lambda captured: None if check not in captured else {
            'exit_status': captured[check].returncode, 'stdout': captured[check].stdout.decode(errors='replace'),
            'stderr': captured[check].stderr.decode(errors='replace')}
        old_raw, new_raw = raw(old_captures), raw(captures)
        raw_diff = int(old_raw != new_raw or old[:4] != new[:4])
        semantic_diff = int(before != after)
        row = {'lane': check, 'mode': 'live-shadow', 'planned': 1, 'completed': 1,
               'cases': int(before['verdict'] != 'not_run' or after['verdict'] != 'not_run'),
               'old': {name: int(before['verdict'] == name) for name in ('satisfied', 'rejected', 'expired', 'error')},
               'new': {name: int(after['verdict'] == name) for name in ('satisfied', 'rejected', 'expired', 'error')},
               'raw_diff_count': raw_diff, 'semantic_diff_count': semantic_diff,
               'explained': raw_diff - semantic_diff, 'unexplained_diff_count': semantic_diff}
        summaries.append(row)
        decisions.append({'lane': check, 'old': before, 'new': after, 'old_raw': old_raw, 'new_raw': new_raw})
        print('evidence-shadow-compare v1 ' + json.dumps(row, sort_keys=True))
    destination = Path(args.comparison_out)
    destination.mkdir(parents=True, exist_ok=True)
    population = {'names': lanes, 'source': 'all remote tree-prefixed records at fetch time, including other runs; not the producer same-run set' if args.snapshot_tree else 'same-run publish set',
                  'out_of_scope': 'rust-tests/member and full gate contexts: step D; not gate coverage',
                  'interpretation': 'missing comparison is missing coverage; equal errors are not parity; no_note is not record-verification proof; only raw formatting/stderr diffs explained, all semantic diffs unexplained'}
    (destination / 'lane-summary.json').write_text(json.dumps({'schema_version': 1, 'tree': tree, 'population': population, 'lanes': summaries}, indent=2) + '\n')
    (destination / 'decisions.jsonl').write_text(''.join(json.dumps(row, sort_keys=True) + '\n' for row in decisions))
    if os.environ.get('GITHUB_STEP_SUMMARY'):
        with open(os.environ['GITHUB_STEP_SUMMARY'], 'a') as stream:
            stream.write('### Mergemaster shadow (report only)\n\n| lane | cases | raw diffs | unexplained diffs |\n| --- | ---: | ---: | ---: |\n')
            for row in summaries:
                stream.write(f"| {row['lane']} | {row['cases']} | {row['raw_diff_count']} | {row['unexplained_diff_count']} |\n")
    return old_results


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    source = parser.add_mutually_exclusive_group(required=True)
    source.add_argument('--publish-result', help="the JSON evidence-publish printed")
    source.add_argument('--snapshot-tree', help='snapshot every remote tree-prefixed record for this tree')
    parser.add_argument('--keys', required=True, help='allowed-signers file from the base commit')
    parser.add_argument('--checks', required=True, help='comma-separated lanes to report')
    parser.add_argument('--verifier', default=str(HERE / 'evidence-verify'))
    parser.add_argument('--optional', default='', help='lanes that only run when their paths changed: no record reads n/a')
    parser.add_argument('--remote', default='origin')
    parser.add_argument('--repo', default='.')
    parser.add_argument('--compare-shadow', help='pinned mergemaster ci-evidence-shadow to compare, never gate')
    parser.add_argument('--comparison-out', default='evidence-shadow-comparison')
    args = parser.parse_args(argv)
    lanes = [c for c in args.checks.split(',') if c]
    if not lanes or not all(CHECK.match(c) for c in lanes):
        print('--checks must be comma-separated lane names', file=sys.stderr)
        return 2
    started = time.monotonic()
    try:
        snapshot_targets = {}
        if args.snapshot_tree:
            if not OID.match(args.snapshot_tree):
                raise ValueError('bad snapshot tree')
            listed = run('git', '-C', args.repo, 'ls-remote', '--refs', args.remote,
                         f'refs/notes/evidence/{args.snapshot_tree}/*', f'refs/tags/evidence/{args.snapshot_tree}/*')
            if listed.returncode:
                raise RuntimeError('cannot snapshot remote evidence refs')
            snapshot_targets = {ref: oid for oid, ref in (line.split() for line in listed.stdout.decode().splitlines()) if REF.match(ref) and OID.match(oid)}
            accepted = [{'record': ref.rsplit('/', 1)[1], 'ref': ref, 'check': lanes[0]} for ref in snapshot_targets]
            accepted += [dict(accepted[0], check=check) for check in lanes] if accepted else []
            data = {'tree': args.snapshot_tree, 'accepted': accepted}
        else:
            data = json.loads(Path(args.publish_result).read_text())
        tree = data['tree']
        accepted = data.get('accepted') or []
        # An entry may name its tag and its ref (the tree-prefixed layouts); without either it is refs/notes/evidence/<record>.
        # The tag is what a gate reads first, so the tag is what is fetched.
        refs = {a['record']: a.get('tag') or a.get('ref') or f'{NOTES}{a["record"]}' for a in accepted if OID.match(a.get('record', ''))}
        if not all(REF.match(ref) for ref in refs.values()):
            raise ValueError('bad ref')
        published = {a['check']: a['record'] for a in accepted if a.get('record') in refs}
        refs_added = sum(max(1, sum(1 for name in ('tag', 'ref') if a.get(name))) + sum(1 for name in ('input_tag', 'input_ref') if a.get(name))
                         for a in accepted)
    except (OSError, ValueError, KeyError, TypeError) as error:
        print(f'evidence-shadow v1 total error=unreadable_publish_result detail={token(type(error).__name__)}')
        return 0
    if not OID.match(tree):
        print('evidence-shadow v1 total error=bad_tree')
        return 0
    fetched = set()
    with tempfile.TemporaryDirectory() as directory:
        scratch = Path(directory) / 'scratch.git'
        run('git', 'init', '-q', '--bare', str(scratch))
        # A scratch repository holding only what a gate would fetch: the records, nothing local from this job.
        remote = run('git', '-C', args.repo, 'remote', 'get-url', args.remote).stdout.decode().strip() or args.remote
        for record in sorted(refs if args.snapshot_tree else set(published.values())):
            ref = refs[record]
            done = run('git', '-C', str(scratch), 'fetch', '--no-tags', '--depth=1', '--no-filter', '-q', remote,
                       f'{snapshot_targets.get(ref, ref)}:{ref}')
            if args.snapshot_tree and done.returncode:
                raise RuntimeError('incomplete remote snapshot; no comparison coverage')
            if done.returncode == 0:
                fetched.add(record)
        optional = set(filter(None, args.optional.split(',')))
        if args.compare_shadow:
            results = compare_shadow(args, lanes, published, fetched, scratch, tree, optional)
        else:
            results = lane_lines(lanes, published, fetched, scratch, tree, args.verifier, args.keys, optional)
    ok = sum(1 for r in results if r[1] is True)
    not_run = sum(1 for r in results if r[1] is None)
    rows = []
    for check, good, reason, result, seconds in results:
        print('evidence-shadow v1 ' + ' '.join(f'{k}={token(v)}' for k, v in (
            ('check', check), ('result', 'n/a' if good is None else 'ok' if good else 'would-reject'), ('reason', reason),
            ('record', result.get('record') or published.get(check)), ('signer', result.get('signer')),
            ('kind', result.get('kind')), ('seconds', f'{seconds:.1f}'))))
        rows.append(f'| `{check}` | {"n/a" if good is None else "ok" if good else "**would-reject**"} | `{reason}` | `{result.get("record") or published.get(check) or "-"}` | {result.get("signer") or "-"} |')
    elapsed = time.monotonic() - started
    lanes_run = len(results) - not_run
    print(f'evidence-shadow v1 total lanes={lanes_run} ok={ok} would_reject={lanes_run - ok} not_run={not_run} refs_added={refs_added} seconds={elapsed:.1f}')
    path = os.environ.get('GITHUB_STEP_SUMMARY')
    if path:
        with open(path, 'a') as stream:
            stream.write(f'### Shadow verify (not required, nothing skipped): {ok} of {lanes_run} lanes ok{f", {not_run} not run" if not_run else ""}, tree `{tree[:12]}`\n\n'
                         '| lane | result | reason | record | signer |\n| --- | --- | --- | --- | --- |\n' + '\n'.join(rows) + '\n\n'
                         f'{refs_added} refs added by this run; verification took {elapsed:.1f} s.\n')
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
