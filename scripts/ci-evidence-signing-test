#!/usr/bin/env python3
"""Key handling for a job that signs its own result, and the workflow rules that keep it loop-free."""
import base64
import hashlib
import json
import os
from pathlib import Path
import re
import stat
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
HELPER = ROOT / 'scripts/ci-evidence-signing'
WRAP, SIGN = ROOT / 'scripts/evidence-wrap', ROOT / 'scripts/evidence-sign'
BASE = {k: v for k, v in os.environ.items() if not k.startswith(('GITHUB_', 'PR_', 'EVIDENCE_', 'RUNNER_'))}
GENV = dict(BASE, GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_SYSTEM='/dev/null', LC_ALL='C',
            GIT_AUTHOR_NAME='t', GIT_AUTHOR_EMAIL='t@example.invalid', GIT_COMMITTER_NAME='t', GIT_COMMITTER_EMAIL='t@example.invalid')


def helper(*args, env=None, check=None):
    done = subprocess.run([sys.executable, str(HELPER), *args], capture_output=True, text=True, env=dict(BASE, **(env or {})))
    return done


def git(repo, *args):
    done = subprocess.run(['git', '-C', str(repo), *args], capture_output=True, env=GENV)
    assert done.returncode == 0, (args, done.stderr.decode())
    return done.stdout.decode().strip()


def mode(path):
    return stat.S_IMODE(os.stat(path).st_mode)


# --- guard: which events and refs may use the key
QUEUE = 'refs/heads/gh-readonly-queue/main/pr-5-0123456789abcdef'
cases = [
    ('merge group on a queue ref', dict(GITHUB_EVENT_NAME='merge_group', GITHUB_REF=QUEUE), True),
    ('merge group on some other ref', dict(GITHUB_EVENT_NAME='merge_group', GITHUB_REF='refs/heads/feature'), False),
    ('push to main', dict(GITHUB_EVENT_NAME='push', GITHUB_REF='refs/heads/main'), True),
    ('push to another branch', dict(GITHUB_EVENT_NAME='push', GITHUB_REF='refs/heads/other'), False),
    ('manual run on main', dict(GITHUB_EVENT_NAME='workflow_dispatch', GITHUB_REF='refs/heads/main'), True),
    ('manual run on a branch', dict(GITHUB_EVENT_NAME='workflow_dispatch', GITHUB_REF='refs/heads/topic'), False),
    ('same-repository pull request', dict(GITHUB_EVENT_NAME='pull_request', GITHUB_REF='refs/pull/9/merge',
                                          GITHUB_REPOSITORY='example/repo', PR_HEAD_REPOSITORY='example/repo'), True),
    ('fork pull request', dict(GITHUB_EVENT_NAME='pull_request', GITHUB_REF='refs/pull/9/merge',
                               GITHUB_REPOSITORY='example/repo', PR_HEAD_REPOSITORY='someone/repo'), False),
    ('pull request with no head repository', dict(GITHUB_EVENT_NAME='pull_request', GITHUB_REF='refs/pull/9/merge',
                                                  GITHUB_REPOSITORY='example/repo'), False),
    ('pull request_target', dict(GITHUB_EVENT_NAME='pull_request_target', GITHUB_REF='refs/heads/main'), False),
    ('scheduled run', dict(GITHUB_EVENT_NAME='schedule', GITHUB_REF='refs/heads/main'), False),
    ('workflow_run', dict(GITHUB_EVENT_NAME='workflow_run', GITHUB_REF='refs/heads/main'), False),
]
for label, env, allowed in cases:
    done = helper('guard', env=env)
    assert (done.returncode == 0) == allowed, (label, done.stdout, done.stderr)
print('passed: the key is for merge-queue refs, main, and same-repository pull requests; forks and other events are refused')

with tempfile.TemporaryDirectory() as directory:
    tmp = Path(directory)
    subprocess.run(['ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-C', 'fleet/ci', '-f', str(tmp / 'k')], check=True)
    key = (tmp / 'k').read_text()
    pub = (tmp / 'k.pub').read_text().split()

    # --- configure: mode, masking, nothing printed but mask commands
    runner = tmp / 'runner'
    runner.mkdir()
    done = helper('configure', env=dict(RUNNER_TEMP=str(runner), EVIDENCE_SIGNING_KEY=key))
    assert done.returncode == 0, done.stderr
    home = Path(done.stdout.strip().splitlines()[-1])
    assert mode(home / 'signing-key') == 0o600 and mode(home / '.config/st/evidence-sign.json') == 0o600
    assert mode(home) == 0o700 and mode(home / '.config/st') == 0o700
    assert (home / 'signing-key').read_text() == key
    masks = [line for line in done.stdout.splitlines() if line.startswith('::add-mask::')]
    assert masks == [f'::add-mask::{line}' for line in key.splitlines() if line.strip()], 'every key line is masked'
    leaked = [line for line in (done.stdout + done.stderr).splitlines() if not line.startswith('::add-mask::') and any(k in line for k in key.splitlines() if len(k) > 20)]
    assert not leaked, 'the key appears outside mask commands'
    config = json.loads((home / '.config/st/evidence-sign.json').read_text())
    assert config['signer'] == 'fleet/ci' and config['ssh_key'] == str(home / 'signing-key')
    again = helper('configure', env=dict(RUNNER_TEMP=str(runner), EVIDENCE_SIGNING_KEY=key))
    assert again.returncode == 1, 'configure never overwrites an existing key file'
    empty = helper('configure', env=dict(RUNNER_TEMP=str(tmp / 'other'), EVIDENCE_SIGNING_KEY='  \n'))
    assert empty.returncode == 1 and 'not available' in empty.stdout
    print('passed: the key file and configuration are 0600 in a 0700 directory, every key line is masked, an empty key is refused')

    # --- the configured signer really signs a note that git verifies
    repo = tmp / 'repo'
    subprocess.run(['git', 'init', '-q', str(repo)], check=True, env=GENV)
    (repo / 'flake.lock').write_text('{}\n')
    git(repo, 'add', '.')
    git(repo, 'commit', '-q', '-m', 'one')
    signers = tmp / 'allowed'
    signers.write_text(f'fleet/ci namespaces="git" {pub[0]} {pub[1]}\n')
    done = subprocess.run([sys.executable, str(WRAP), '--check', 'linux-gate', '--toolchain-sha256', '1' * 64,
                           '--signer', json.dumps([sys.executable, str(SIGN)]), '--', 'true'],
                          cwd=repo, capture_output=True, env=dict(GENV, HOME=str(home), EVIDENCE_SIGN_NOW='2026-10-14T12:00:00Z'))
    assert done.returncode == 0, done.stderr.decode()
    record = json.loads(done.stderr.decode()[done.stderr.decode().index('{'):])['record']
    verified = subprocess.run(['git', '-C', str(repo), '-c', 'gpg.format=ssh', '-c', f'gpg.ssh.allowedSignersFile={signers}',
                               'verify-commit', record], capture_output=True, env=GENV)
    assert verified.returncode == 0 and b'fleet/ci' in verified.stderr, verified.stderr
    print('passed: the configured signer produces a note that verifies against the public half of the key')

    # --- once: one signature per check per job
    assert helper('once', 'linux-gate', env=dict(RUNNER_TEMP=str(runner))).returncode == 0
    second = helper('once', 'linux-gate', env=dict(RUNNER_TEMP=str(runner)))
    assert second.returncode == 1 and 'already signed' in second.stdout
    assert helper('once', 'another-check', env=dict(RUNNER_TEMP=str(runner))).returncode == 0
    print('passed: a job cannot sign the same check twice')

    # --- aggregate: the facts come from the needs context, the verdict is the gate job's own result
    needs = {'linux-gate': {'result': 'success'}, 'linux-tests': {'result': 'success'}, 'linux-clippy': {'result': 'failure'}}
    out = tmp / 'facts.json'
    done = helper('aggregate', str(out), env=dict(NEEDS_JSON=json.dumps(needs), GITHUB_RUN_ID='7', GITHUB_RUN_ATTEMPT='2',
                                                  GITHUB_EVENT_NAME='merge_group', GITHUB_REF=QUEUE, RUN_STARTED_AT='2026-10-14T12:00:00Z',
                                                  GITHUB_WORKFLOW='Workspace CI'))
    facts = json.loads(out.read_text())
    assert done.returncode == 0 and facts['exit_code'] == 0, 'the gate job succeeded, so the verdict is success even though a sibling reports failure'
    assert facts['command'] == ['linux-gate', 'aggregate', 'linux-clippy', 'linux-gate', 'linux-tests']
    assert facts['output']['needs']['linux-clippy'] == 'failure' and facts['inputs']['stage_results'] == 'linux-clippy=failure,linux-gate=success,linux-tests=success'
    assert facts['inputs']['run_id'] == '7' and 'unset' not in json.dumps(facts)
    needs['linux-gate']['result'] = 'failure'
    helper('aggregate', str(out), env=dict(NEEDS_JSON=json.dumps(needs)))
    assert json.loads(out.read_text())['exit_code'] == 1
    needs['linux-gate']['result'] = 'success'
    skipped = {**needs, 'linux-tests': {'result': 'skipped'}}
    refused = helper('aggregate', str(out), env=dict(NEEDS_JSON=json.dumps(skipped), GITHUB_EVENT_NAME='merge_group'))
    assert refused.returncode == 1 and 'did not run' in refused.stdout, 'a skipped stage means this run did not test the tree itself'
    shards = {**needs, 'linux-tests-shard-3': {'result': 'skipped'}}
    assert helper('aggregate', str(out), env=dict(NEEDS_JSON=json.dumps(shards), GITHUB_EVENT_NAME='pull_request')).returncode == 0, 'merge-only shards may be skipped outside merge groups'
    assert helper('aggregate', str(out), env=dict(NEEDS_JSON=json.dumps(shards), GITHUB_EVENT_NAME='merge_group')).returncode == 1
    missing = helper('aggregate', str(out), env=dict(NEEDS_JSON=json.dumps({'linux-tests': {'result': 'success'}})))
    assert missing.returncode == 1 and 'no verdict' in missing.stdout
    print('passed: the aggregate note records the needed jobs and the gate job\'s own verdict, and refuses to invent one')

    # --- stage-facts: the log digest and status of a stage that already ran
    logs = tmp / 'stage-runner/ci-logs'
    logs.mkdir(parents=True)
    (logs / 'tests.log').write_bytes(b'ok test a\nok test b\n')
    (logs / 'tests.time').write_text('412 0\n')
    (logs / 'clippy.log').write_bytes(b'warning: x\n')
    (logs / 'clippy.time').write_text('55 101\n')
    (logs / 'fleet-compat.time').write_text('garbage')
    stage_env = dict(RUNNER_TEMP=str(tmp / 'stage-runner'), STAGE_JOB='linux-tests-shard-2', CI_TEST_PARTITION='hash:2/4',
                     GITHUB_RUN_ID='7', RUNNER_NAME='ci1-3', RUNNER_OS='Linux')
    helper('stage-facts', str(out), env=dict(stage_env, STAGE='tests'))
    got = json.loads(out.read_text())
    assert got['exit_code'] == 0 and got['output_sha256'] == hashlib.sha256(b'ok test a\nok test b\n').hexdigest()
    assert got['command'] == ['bash', 'scripts/ci-linux', 'tests'] and got['inputs']['partition'] == 'hash:2/4' and got['inputs']['elapsed_seconds'] == '412'
    helper('stage-facts', str(out), env=dict(stage_env, STAGE='clippy'))
    assert json.loads(out.read_text())['exit_code'] == 101, 'the stage exit status is recorded as it was'
    helper('stage-facts', str(out), env=dict(stage_env, STAGE='fleet-compat'))
    unfinished = json.loads(out.read_text())
    assert unfinished['exit_code'] == 1 and unfinished['inputs']['log_present'] == 'false', 'an unreadable timing file is a failure, never a success'
    never = helper('stage-facts', str(out), env=dict(stage_env, STAGE='canaries'))
    assert never.returncode == 1 and 'did not run' in never.stdout, 'a stage that left nothing never ran: no note, not even a failure'
    assert helper('stage-facts', str(out), env=dict(stage_env, STAGE='../x')).returncode == 1
    print('passed: a stage note carries the stage command, its real exit status and the digest of its exact log; a missing or garbled timing is a failure')

    # --- step-facts: jobs with no stage log record the outcomes of the steps that ran
    base_env = dict(STEP_CHECK='isolation-vm', STEP_COMMAND=json.dumps(['isolation-vm', 'nixos-test-driver']), GITHUB_RUN_ID='7',
                    RUNNER_OS='Linux')
    ok = helper('step-facts', str(out), env=dict(base_env, STEP_OUTCOMES=json.dumps({'driver': 'success', 'vmtest': 'success'})))
    got = json.loads(out.read_text())
    assert ok.returncode == 0 and got['exit_code'] == 0 and got['output'] == {'steps': {'driver': 'success', 'vmtest': 'success'}}
    assert got['command'] == ['isolation-vm', 'nixos-test-driver'] and got['inputs']['step_outcomes'] == 'driver=success,vmtest=success'
    helper('step-facts', str(out), env=dict(base_env, STEP_OUTCOMES=json.dumps({'driver': 'success', 'vmtest': 'failure'})))
    assert json.loads(out.read_text())['exit_code'] == 1, 'one failed step makes the note a failure, never a success'
    for outcome in ('skipped', 'cancelled', ''):
        refused = helper('step-facts', str(out), env=dict(base_env, STEP_OUTCOMES=json.dumps({'driver': 'success', 'vmtest': outcome})))
        assert refused.returncode == 1 and 'did not run' in refused.stdout, (outcome, refused.stdout)
    assert helper('step-facts', str(out), env=dict(base_env, STEP_OUTCOMES='not json')).returncode == 1
    assert helper('step-facts', str(out), env=dict(base_env, STEP_OUTCOMES='{}')).returncode == 1
    print('passed: a step-based job note records each step outcome; a skipped, cancelled or missing step means no note, a failed one a failure')

    # --- cleanup: key overwritten and removed
    alias = tmp / 'alias'
    os.link(home / 'signing-key', alias)
    assert helper('cleanup', env=dict(RUNNER_TEMP=str(runner))).returncode == 0
    assert not home.exists() and alias.read_bytes().strip(b'\0') == b'', 'the key bytes are overwritten, not just unlinked'
    assert helper('cleanup', env=dict(RUNNER_TEMP=str(runner))).returncode == 0, 'cleanup is safe to repeat'
    print('passed: cleanup overwrites and removes the key, and is safe to run twice')

# --- lint: pushing refs/notes/evidence/* must not start any workflow
pushes = 0
for workflow in sorted((ROOT / '.github/workflows').glob('*.yml')):
    lines = workflow.read_text().splitlines()
    for number, line in enumerate(lines):
        if re.fullmatch(r'  push:\s*', line):
            block = []
            for follower in lines[number + 1:]:
                if follower.strip() and not follower.startswith('   '):
                    break
                block.append(follower.strip())
            filters = [b for b in block if re.match(r'(branches|tags)(-ignore)?:', b)]
            assert filters, f'{workflow.name}: a push trigger without a branches or tags filter would fire on refs/notes pushes'
            pushes += 1
assert pushes >= 1, 'the lint found no push trigger at all, so it checked nothing'
print(f'passed: all {pushes} push triggers in the generated workflows are filtered to branches or tags')
