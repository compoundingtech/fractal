#!/usr/bin/env python3
"""Native bundle pin validation, using a real local archive and no network."""
import hashlib
import importlib.machinery
import importlib.util
import io
import json
from pathlib import Path
import sys
import tarfile
import tempfile
import urllib.error
import unittest
from unittest.mock import patch

loader = importlib.machinery.SourceFileLoader("compat_baseline", str(Path(__file__).with_name("compat-baseline")))
spec = importlib.util.spec_from_loader(loader.name, loader)
module = importlib.util.module_from_spec(spec)
loader.exec_module(module)


class BundleTests(unittest.TestCase):
    def setUp(self):
        self.temporary = tempfile.TemporaryDirectory()
        self.addCleanup(self.temporary.cleanup)
        self.root = Path(self.temporary.name)
        self.target = "x86_64-unknown-linux-gnu"
        self.package = self.root / f"smalltalk-{self.target}"
        (self.package / "bin").mkdir(parents=True)
        binary = self.package / "bin/st3"
        binary.write_text("#!/bin/sh\nexit 0\n")
        binary.chmod(0o755)
        self.commit = "a" * 40
        (self.package / "BUILD.json").write_text(json.dumps({"source": self.commit, "target": self.target}))
        archive = self.root / "bundle.tar.gz"
        with tarfile.open(archive, "w:gz") as stream:
            stream.add(self.package, arcname=self.package.name)
        self.pin = {"commit": self.commit, "tag": "v0.3.17", "bundles": {self.target: {
            "url": archive.as_uri(), "sha256": hashlib.sha256(archive.read_bytes()).hexdigest()}}}
        (self.root / ".github").mkdir()
        self.output = self.root / "output"

    def run_loader(self):
        (self.root / ".github/fleet-compat-baseline.json").write_text(json.dumps(self.pin))
        with patch.object(module, "REPO", self.root), patch.object(module.platform, "system", return_value="Linux"), \
             patch.object(module.platform, "machine", return_value="x86_64"), \
             patch.object(sys, "argv", ["compat-baseline", "fleet", str(self.output)]):
            module.main()

    def test_checksum_verified_archive_is_reused(self):
        self.run_loader()
        with patch.object(module.urllib.request, "urlopen", side_effect=AssertionError("cache miss")):
            self.run_loader()
        self.assertTrue((self.output / self.pin["bundles"][self.target]["sha256"] / self.package.name / "bin/st3").is_file())

    def test_fractal_root_prefers_st3_and_reuses_cache(self):
        self.check_fractal_archive("st3")

    def test_fractal_only_executable_is_supported(self):
        (self.package / "bin/st3").rename(self.package / "bin/fractal")
        self.check_fractal_archive("fractal")

    def check_fractal_archive(self, executable):
        self.package = self.package.rename(self.root / f"fractal-{self.target}")
        if executable == "st3":
            (self.package / "bin/fractal").symlink_to("st3")
        archive = self.root / "bundle.tar.gz"
        with tarfile.open(archive, "w:gz") as stream:
            stream.add(self.package, arcname=self.package.name)
        self.pin["bundles"][self.target]["sha256"] = hashlib.sha256(archive.read_bytes()).hexdigest()
        with patch("sys.stdout", new=io.StringIO()) as stdout:
            self.run_loader()
            with patch.object(module.urllib.request, "urlopen", side_effect=AssertionError("cache miss")):
                self.run_loader()
        expected = self.output / self.pin["bundles"][self.target]["sha256"] / self.package.name / "bin" / executable
        self.assertEqual(stdout.getvalue().splitlines(), [str(expected), str(expected)])

    def test_download_has_a_timeout(self):
        with patch.object(module.urllib.request, "urlopen", wraps=module.urllib.request.urlopen) as download:
            self.run_loader()
        download.assert_called_once_with(self.pin["bundles"][self.target]["url"], timeout=60)

    def test_a_local_archive_is_read_instead_of_downloading_and_is_checked_the_same(self):
        local = self.root / "bundle.tar.gz"
        with patch.dict(module.os.environ, {"COMPAT_BASELINE_ARCHIVE": str(local)}), \
             patch.object(module.urllib.request, "urlopen", side_effect=AssertionError("no download")):
            self.pin["bundles"][self.target]["url"] = "https://invalid.example/never-fetched.tar.gz"
            self.run_loader()
            self.assertTrue((self.output / self.pin["bundles"][self.target]["sha256"] / self.package.name / "bin/st3").is_file())
            self.pin["bundles"][self.target]["sha256"] = "0" * 64
            with self.assertRaisesRegex(ValueError, "SHA-256 mismatch"):
                self.run_loader()

    def test_download_timeout_does_not_publish(self):
        self.remote_bundle()
        with patch.object(module.urllib.request, "urlopen", side_effect=TimeoutError("download timed out")), \
             patch.object(module.time, "sleep"):
            with self.assertRaisesRegex(RuntimeError, "browser: download timed out; API fallback: download timed out"):
                self.run_loader()
        self.assertEqual([], list(self.output.iterdir()))

    def remote_bundle(self):
        self.pin["bundles"][self.target]["url"] = (
            "https://github.com/compoundingtech/fractal/releases/download/v0.3.17/bundle.tar.gz")

    def api_download(self, payload=None, primary=None):
        self.remote_bundle()
        primary = primary or urllib.error.HTTPError("browser", 504, "Gateway Timeout", {}, None)
        metadata = io.BytesIO(json.dumps({"assets": [{"id": 123, "name": "bundle.tar.gz"}]}).encode())
        archive = io.BytesIO(payload if payload is not None else (self.root / "bundle.tar.gz").read_bytes())
        with patch.dict(module.os.environ, {"GH_TOKEN": "test-token"}), \
             patch.object(module.urllib.request, "urlopen", side_effect=[primary, metadata, archive]) as opener, \
             patch("sys.stderr", new=io.StringIO()) as stderr:
            self.run_loader()
        self.assertIn("API asset served the archive", stderr.getvalue())
        metadata_request = opener.call_args_list[1].args[0]
        asset_request = opener.call_args_list[2].args[0]
        self.assertEqual(metadata_request.full_url,
                         "https://api.github.com/repos/compoundingtech/fractal/releases/tags/v0.3.17")
        self.assertEqual(asset_request.full_url,
                         "https://api.github.com/repos/compoundingtech/fractal/releases/assets/123")
        for request in (metadata_request, asset_request):
            self.assertEqual(request.get_header("Authorization"), "Bearer test-token")
        self.assertEqual(asset_request.get_header("Accept"), "application/octet-stream")

    def test_primary_504_falls_back_and_verifies_digest(self):
        self.api_download()
        self.assertTrue((self.output / self.pin["bundles"][self.target]["sha256"] / self.package.name / "bin/st3").is_file())

    def test_primary_timeout_falls_back(self):
        self.api_download(primary=TimeoutError("browser timed out"))

    def test_fallback_digest_mismatch_does_not_publish(self):
        with self.assertRaisesRegex(ValueError, "SHA-256 mismatch"):
            self.api_download(payload=b"corrupt archive")
        self.assertEqual([], list(self.output.iterdir()))

    def test_fallback_source_mismatch_does_not_publish(self):
        self.pin["commit"] = "b" * 40
        with self.assertRaisesRegex(ValueError, "source/target"):
            self.api_download()
        self.assertEqual([], list(self.output.iterdir()))

    def test_both_5xx_fail_clearly_with_bounded_retries(self):
        self.remote_bundle()
        failure = urllib.error.HTTPError("download", 504, "Gateway Timeout", {}, None)
        metadata = io.BytesIO(json.dumps({"assets": [{"id": 123, "name": "bundle.tar.gz"}]}).encode())
        with patch.object(module.urllib.request, "urlopen",
                          side_effect=[failure, metadata, failure, failure]) as opener, \
             patch.object(module.time, "sleep"):
            with self.assertRaisesRegex(RuntimeError, "browser: HTTP Error 504.*API fallback: HTTP Error 504"):
                self.run_loader()
        self.assertEqual(opener.call_count, 4)
        self.assertEqual([], list(self.output.iterdir()))

    def test_primary_404_does_not_fall_back(self):
        failure = urllib.error.HTTPError("browser", 404, "Not Found", {}, None)
        with patch.object(module.urllib.request, "urlopen", side_effect=failure) as opener:
            with self.assertRaises(urllib.error.HTTPError):
                self.run_loader()
        self.assertEqual(opener.call_count, 1)

    def test_checksum_mismatch_does_not_publish(self):
        self.pin["bundles"][self.target]["sha256"] = "0" * 64
        with self.assertRaisesRegex(ValueError, "SHA-256 mismatch"):
            self.run_loader()
        self.assertEqual([], list(self.output.iterdir()))

    def test_source_mismatch_does_not_publish(self):
        self.pin["commit"] = "b" * 40
        with self.assertRaisesRegex(ValueError, "source/target"):
            self.run_loader()
        self.assertEqual([], list(self.output.iterdir()))


if __name__ == "__main__":
    unittest.main()
