#!/usr/bin/env python3
"""Exercise the evidence gate against a real origin and a real depth-1 clone.

The aim is that no skip can be a false positive: every way a note can fail to cover a check
must end in `decision=run`, and every hostile or broken verifier must too.
"""
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile
import unittest

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent


def load(name, path):
    loader = importlib.machinery.SourceFileLoader(name, str(ROOT / path))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


gate = load('ci_evidence_gate', 'scripts/ci-evidence-gate')
fixtures = load('evidence_verify_test', 'scripts/evidence-verify-test')
REPOSITORY = 'org/repo'
CHECKS = ('linux-gate', 'typescript-client', 'isolation-vm', 'genie-freshness', 'mail-redelivery-canaries')
WEEK = 7 * 24 * 3600
# Written out here, not read from the script, so removing a path from the script cannot hide it.
EXPECTED_PROTECTED = (
    'scripts/ci-evidence-gate', 'scripts/evidence-verify', '.st/evidence-skip-policy.json', '.st/evidence-keys',
    '.github/workflows/fleet.yml', '.github/workflows/fleet.yml.genie.ts',
)


def command_for(check, repository=REPOSITORY):
    return ('github-actions', repository, '.github/workflows/fleet.yml', check)


RUNNER = f'github:{REPOSITORY}/actions/runs/7/attempts/1/jobs/9'


def skip_policy(**per_check):
    """The repository's skip policy as a base commit would carry it, for all five checks."""
    entry = {'trust_levels': ['fleet'],
             'kinds': {'observed': {'command': ['github-actions', '{repository}', '.github/workflows/fleet.yml', '{check}'],
                                    'runner_prefix': 'github:{repository}/'}}}
    entry.update(per_check)
    return json.dumps({'version': 1, 'checks': {check: entry for check in CHECKS}})


def decision(text):
    """The decision line as a dict, asserting its format on the way."""
    match = [line for line in text.splitlines() if line.startswith('evidence-decision v1 ')]
    assert len(match) == 1, text
    fields = dict(part.split('=', 1) for part in match[0].split(' ')[2:])
    return fields


class Classify(unittest.TestCase):
    def test_each_verifier_answer_has_one_outcome(self):
        cases = [
            ((0, {'satisfied': True, 'tier': 'full'}), 'satisfied'),
            ((0, {'satisfied': True, 'tier': 'test'}), 'rejected'),
            ((1, {'satisfied': False, 'reason': 'degraded'}), 'degraded'),
            ((1, {'satisfied': False, 'reason': 'no_record'}), 'no_note'),
            ((1, {'satisfied': False, 'reason': 'stale_tree'}), 'no_note'),
            ((1, {'satisfied': False, 'reason': 'wrong_check'}), 'no_note'),
            ((1, {'satisfied': False, 'reason': 'bad_signature'}), 'rejected'),
            ((1, {'satisfied': False, 'reason': 'untrusted_signer'}), 'rejected'),
            ((1, {'satisfied': False, 'reason': 'too_old'}), 'rejected'),
            ((1, {'satisfied': False, 'reason': 'check_failed'}), 'rejected'),
            ((1, {'satisfied': False, 'reason': 'error'}), 'unavailable'),
            ((2, None), 'unavailable'),
        ]
        for (code, result), outcome in cases:
            self.assertEqual(gate.classify(code, result), outcome, (code, result))


class Decide(unittest.TestCase):
    """The pure decision, with every condition removed one at a time."""

    def good(self):
        record = 'a' * 40
        now = gate.datetime.now(gate.timezone.utc).isoformat()
        context = {'check': 'linux-gate', 'fork': 'false', 'event': 'merge_group', 'protected_changed': []}
        result = {'satisfied': True, 'policy': True, 'tier': 'full', 'kind': 'observed', 'trust_level': 'fleet',
                  'tree': 'b' * 40, 'check': 'linux-gate', 'record': record, 'signer': 'fleet/ci', 'observed_at': now}
        return context, result, 'b' * 40

    def test_all_conditions_together_skip(self):
        context, result, tree = self.good()
        self.assertEqual(gate.decide(context, 'satisfied', result, tree)[0], 'skip')

    def test_removing_any_one_condition_runs(self):
        context, result, tree = self.good()
        cases = {
            'outcome': lambda c, r, t: (c, r, t, 'degraded'),
            'fork': lambda c, r, t: ({**c, 'fork': 'true'}, r, t, 'satisfied'),
            'event': lambda c, r, t: ({**c, 'event': 'workflow_dispatch'}, r, t, 'satisfied'),
            'unsatisfied': lambda c, r, t: (c, {**r, 'satisfied': 'yes'}, t, 'satisfied'),
            'tier': lambda c, r, t: (c, {**r, 'tier': 'test'}, t, 'satisfied'),
            'protected path changed': lambda c, r, t: ({**c, 'protected_changed': ['scripts/ci-evidence-gate']}, r, t, 'satisfied'),
            'comparison failed': lambda c, r, t: ({**c, 'protected_changed': ['<comparison failed>']}, r, t, 'satisfied'),
            'protected check absent': lambda c, r, t: ({k: v for k, v in c.items() if k != 'protected_changed'}, r, t, 'satisfied'),
            'policy not applied': lambda c, r, t: (c, {**r, 'policy': False}, t, 'satisfied'),
            'policy missing': lambda c, r, t: (c, {k: v for k, v in r.items() if k != 'policy'}, t, 'satisfied'),
            'no kind': lambda c, r, t: (c, {**r, 'kind': None}, t, 'satisfied'),
            'no trust level': lambda c, r, t: (c, {**r, 'trust_level': ''}, t, 'satisfied'),
            'tree': lambda c, r, t: (c, {**r, 'tree': 'c' * 40}, t, 'satisfied'),
            'run tree absent': lambda c, r, t: (c, r, None, 'satisfied'),
            'check': lambda c, r, t: (c, {**r, 'check': 'typescript-client'}, t, 'satisfied'),
            'record': lambda c, r, t: (c, {**r, 'record': 'xyz'}, t, 'satisfied'),
            'record missing': lambda c, r, t: (c, {k: v for k, v in r.items() if k != 'record'}, t, 'satisfied'),
            'signer': lambda c, r, t: (c, {**r, 'signer': 'two words'}, t, 'satisfied'),
            'future': lambda c, r, t: (c, {**r, 'observed_at': '2999-01-01T00:00:00+00:00'}, t, 'satisfied'),
            'naive time': lambda c, r, t: (c, {**r, 'observed_at': '2026-01-01T00:00:00'}, t, 'satisfied'),
            'no time': lambda c, r, t: (c, {k: v for k, v in r.items() if k != 'observed_at'}, t, 'satisfied'),
            'not a dict': lambda c, r, t: (c, 'satisfied', t, 'satisfied'),
        }
        for name, mutate in cases.items():
            with self.subTest(name):
                c, r, t, outcome = mutate(context, result, tree)
                self.assertEqual(gate.decide(c, outcome, r, t)[0], 'run', name)

    def test_the_fork_flag_needs_a_positively_identical_head_repository(self):
        for head, expected in (('org/repo', 'false'), ('', 'true'), ('org/repo-fork', 'true'), ('org/other', 'true')):
            self.assertEqual(gate.context_from({'REPOSITORY': 'org/repo', 'HEAD_REPOSITORY': head})['fork'], expected)
        self.assertEqual(gate.context_from({'HEAD_REPOSITORY': 'org/repo'})['fork'], 'true')


class ProtectedPaths(unittest.TestCase):
    def test_a_comparison_that_cannot_be_made_counts_as_a_change(self):
        with tempfile.TemporaryDirectory() as directory:
            subprocess.run(['git', 'init', '-q', directory], check=True)
            here = os.getcwd()
            os.chdir(directory)
            try:
                self.assertEqual(gate.protected_changes(''), ['<no base>'])
                self.assertEqual(gate.protected_changes('f' * 40), ['<comparison failed>'])
            finally:
                os.chdir(here)


class EndToEnd(unittest.TestCase):
    def setUp(self):
        self.f = fixtures.Fixture()
        self.addCleanup(self.f.tmp.cleanup)
        self.ci = self.f.key('ci', 'fleet/ci')
        self.stranger = self.f.key('stranger')
        self.machine = self.f.key('machine', 'machine/box')
        self.work_dir = tempfile.TemporaryDirectory()
        self.addCleanup(self.work_dir.cleanup)

    def commit_base(self, script=None, with_keys=True, policy=None):
        repo = self.f.repo
        (repo / 'scripts').mkdir(exist_ok=True)
        shutil.copy(ROOT / 'scripts/ci-evidence-gate', repo / 'scripts/ci-evidence-gate')
        target = repo / 'scripts/evidence-verify'
        if script is None:
            shutil.copy(ROOT / 'scripts/evidence-verify', target)
        elif script is not False:
            target.write_text(script)
        (repo / '.st').mkdir(exist_ok=True)
        if with_keys:
            (repo / '.st/evidence-keys').write_text(self.f.keys.read_text())
        if policy is not False:
            (repo / '.st/evidence-skip-policy.json').write_text(policy or skip_policy())
        self.f.git('add', '-A')
        self.f.git('commit', '-q', '--allow-empty', '-m', 'base')
        return self.f.git('rev-parse', 'HEAD')

    def note(self, commit, tree, check='linux-gate', **kwargs):
        defaults = dict(check=check, command=command_for(check), runner=RUNNER, key=self.ci, signer='fleet/ci')
        defaults.update(kwargs)
        return self.f.note(commit, tree, **defaults)

    def run_gate(self, base, check='linux-gate', timeout='30', **overrides):
        work = Path(self.work_dir.name) / 'work'
        if work.exists():
            shutil.rmtree(work)
        subprocess.run(['git', 'clone', '-q', '--depth=1', 'file://' + str(self.f.repo), str(work)], check=True,
                       capture_output=True)
        output, summary = Path(self.work_dir.name) / 'output', Path(self.work_dir.name) / 'summary'
        output.write_text('')
        summary.write_text('')
        env = dict(os.environ, CHECK=check, REPOSITORY=REPOSITORY, HEAD_REPOSITORY=REPOSITORY,
                   BASE_SHA=base, EVENT_NAME='merge_group', HEAD_SHA=self.f.git('rev-parse', 'HEAD'), PR_NUMBER='',
                   RUN_ID='42', RUN_ATTEMPT='1', GITHUB_OUTPUT=str(output), GITHUB_STEP_SUMMARY=str(summary),
                   GATE_VERIFIER_TIMEOUT=timeout)
        env.update(overrides)
        done = subprocess.run([sys.executable, str(ROOT / 'scripts/ci-evidence-gate')], cwd=work, env=env,
                              capture_output=True)
        self.assertEqual(done.returncode, 0, done.stderr.decode())  # the gate never fails the job
        fields = decision(done.stdout.decode())
        outputs = dict(line.split('=', 1) for line in output.read_text().split())
        self.assertEqual(fields['decision'] == 'skip', outputs['skip'] == 'true')
        self.assertIn('evidence-decision v1', summary.read_text())
        return fields, outputs

    def head(self):
        return self.f.commit('head')

    def assertRuns(self, base, why='', **kwargs):
        fields, outputs = self.run_gate(base, **kwargs)
        self.assertEqual((fields['decision'], outputs['skip'], outputs['record']), ('run', 'false', '-'), why)
        return fields

    # ---- the happy path and its progression -------------------------------------------------

    def test_no_note_then_degraded_then_a_trusted_note_skips_then_a_stranger_does_not(self):
        base = self.commit_base()
        commit, tree = self.head()
        self.assertEqual(self.assertRuns(base)['outcome'], 'no_note')
        self.note(commit, tree, signer=None, tier='degraded', sign=False)
        self.assertEqual(self.assertRuns(base)['outcome'], 'degraded')
        record = self.note(commit, tree, seconds=1)
        fields, outputs = self.run_gate(base)
        self.assertEqual((fields['decision'], fields['outcome'], outputs['record']), ('skip', 'satisfied', record))
        self.assertEqual((fields['signer'], fields['trust_level'], fields['kind'], fields['tier'], fields['tree']),
                         ('fleet/ci', 'fleet', 'observed', 'full', tree))
        # A later record signed by a key that is not on the list is refused, not skipped over.
        self.f.git('update-ref', '-d', f'refs/notes/evidence/{record}')
        self.note(commit, tree, key=self.stranger, seconds=2)
        self.assertEqual(self.assertRuns(base)['outcome'], 'rejected')

    def test_the_subject_commit_is_absent_in_the_shallow_clone_and_the_skip_still_holds(self):
        base = self.commit_base()
        commit, tree = self.head()
        self.note(commit, tree)
        fields, _ = self.run_gate(base)
        absent = subprocess.run(['git', '-C', str(Path(self.work_dir.name) / 'work'), 'cat-file', '-e', base + '^{commit}'])
        self.assertEqual(fields['decision'], 'skip')
        self.assertIsNotNone(absent)

    def test_each_of_the_five_required_checks_is_decided_on_its_own_note(self):
        base = self.commit_base()
        commit, tree = self.head()
        for covered in CHECKS:
            self.note(commit, tree, check=covered, seconds=CHECKS.index(covered))
        for check in CHECKS:
            with self.subTest(check):
                fields, _ = self.run_gate(base, check=check)
                self.assertEqual((fields['check'], fields['decision']), (check, 'skip'))
        # A note for one check never covers another.
        other = self.f.commit('other')
        self.note(other[0], other[1], check='linux-gate')
        for check in CHECKS[1:]:
            with self.subTest('uncovered ' + check):
                self.assertRuns(base, check=check)

    # ---- every way a note can fail to cover the check --------------------------------------

    def test_a_note_that_does_not_cover_the_check_never_skips(self):
        base = self.commit_base()
        commit, tree = self.head()
        week = WEEK
        cases = {
            'wrong command': dict(command=('github-actions', REPOSITORY, '.github/workflows/other.yml', 'linux-gate')),
            'another repository': dict(runner='github:org/other/actions/runs/7/attempts/1/jobs/9'),
            'repository prefix lookalike': dict(runner='github:org/repo2/actions/runs/7/attempts/1/jobs/9'),
            'other repository command': dict(command=command_for('linux-gate', 'org/other')),
            'untrusted signer': dict(key=self.stranger),
            'signer principal not the key': dict(signer='fleet/someone-else'),
            'trust level not accepted': dict(key=self.machine, signer='machine/box'),
            'in the future': dict(seconds=7200),
            'test tier': dict(tier='test'),
            'unsupported kind': dict(runner='hand-typed'),
            'failed run': dict(exit_code=1),
            'naive timestamp': dict(naive=True),
        }
        for name, kwargs in cases.items():
            with self.subTest(name):
                record = self.note(commit, tree, **kwargs)
                self.assertRuns(base, name)
                self.f.git('update-ref', '-d', f'refs/notes/evidence/{record}')

    def test_a_newer_failure_or_a_conflicting_record_never_skips(self):
        base = self.commit_base()
        commit, tree = self.head()
        self.note(commit, tree, seconds=0)
        self.note(commit, tree, exit_code=1, seconds=1)
        self.assertEqual(self.assertRuns(base)['outcome'], 'rejected')
        self.note(commit, tree, seconds=2)  # a later pass supersedes the failure
        self.assertEqual(self.run_gate(base)[0]['decision'], 'skip')
        self.note(commit, tree, exit_code=1, seconds=2)  # same instant: failure wins
        self.assertRuns(base)

    def test_a_note_for_another_tree_or_the_same_contents_in_another_tree_never_skips(self):
        base = self.commit_base()
        commit, tree = self.head()
        (self.f.repo / 'extra.txt').write_text('extra')
        other_commit, other_tree = self.f.commit('head')  # file.txt unchanged, tree different
        self.assertNotEqual(tree, other_tree)
        self.note(commit, tree)
        self.assertRuns(base)

    def test_a_statement_edited_after_signing_never_skips(self):
        base = self.commit_base()
        commit, tree = self.head()
        record = self.note(commit, tree, exit_code=1)
        raw = subprocess.run(['git', '-C', str(self.f.repo), 'cat-file', 'commit', record], capture_output=True).stdout.decode()
        passing = fixtures.json.loads(self.f.git('cat-file', 'blob', f'{record}:{tree}'))
        passing['predicate']['observed']['checks']['linux-gate']['exit_code'] = 0
        blob = self.f.git('hash-object', '-w', '--stdin', stdin=fixtures.json.dumps(passing).encode())
        new_tree = self.f.git('mktree', stdin=f'100644 blob {blob}\t{tree}\n'.encode())
        old_tree = self.f.git('rev-parse', f'{record}^{{tree}}')
        forged = self.f.git('hash-object', '-t', 'commit', '-w', '--stdin',
                            stdin=raw.replace(f'tree {old_tree}', f'tree {new_tree}', 1).encode())
        self.f.git('update-ref', '-d', f'refs/notes/evidence/{record}')
        self.f.git('update-ref', f'refs/notes/evidence/{forged}', forged)
        self.assertEqual(self.assertRuns(base)['outcome'], 'rejected')

    def test_garbage_and_truncated_notes_never_skip(self):
        base = self.commit_base()
        commit, tree = self.head()
        blob = self.f.git('hash-object', '-w', '--stdin', stdin=b'not a commit')
        self.f.git('update-ref', f'refs/notes/evidence/{blob}', blob)
        empty = self.f.git('mktree', stdin=b'')
        bare = self.f.git('commit-tree', empty, '-p', commit, '-m', 'empty')
        self.f.git('update-ref', f'refs/notes/evidence/{bare}', bare)
        self.note(commit, tree, mutate=lambda body: body[:len(body) // 2])  # truncated statement
        self.note(commit, tree, seconds=1, mutate=lambda body: body.replace(b'"github-actions"', b'"github-act\xffions"'))  # not UTF-8
        self.assertRuns(base)

    def test_revoking_the_signer_from_the_accepted_base_revokes_the_skip(self):
        base = self.commit_base()
        commit, tree = self.head()
        self.note(commit, tree)
        self.assertEqual(self.run_gate(base)[0]['decision'], 'skip')
        (self.f.repo / '.st/evidence-keys').write_text('')
        self.f.git('add', '-A')
        self.f.git('commit', '-q', '-m', 'revoke')
        revoked = self.f.git('rev-parse', 'HEAD')
        self.assertRuns(revoked)
        # The same note with no key list at all is not trusted either.
        self.f.git('rm', '-q', '.st/evidence-keys')
        self.f.git('commit', '-q', '-m', 'no keys')
        self.assertRuns(self.f.git('rev-parse', 'HEAD'))

    # ---- who is running and how -------------------------------------------------------------

    def test_forks_unknown_heads_and_other_events_never_skip_even_with_a_valid_note(self):
        base = self.commit_base()
        commit, tree = self.head()
        self.note(commit, tree)
        for name, overrides in {
            'fork': dict(HEAD_REPOSITORY='someone/repo'),
            'unknown head repository': dict(HEAD_REPOSITORY=''),
            'manual run': dict(EVENT_NAME='workflow_dispatch'),
            'push': dict(EVENT_NAME='push'),
            'no event': dict(EVENT_NAME=''),
        }.items():
            with self.subTest(name):
                fields = self.assertRuns(base, name, **overrides)
                self.assertEqual(fields['outcome'], 'satisfied')  # reported, but not acted on
        self.assertEqual(self.run_gate(base, EVENT_NAME='pull_request')[0]['decision'], 'skip')

    def test_everything_that_can_go_wrong_around_the_verifier_runs_the_check(self):
        commit_tree = {}
        for name, script in {
            'no verifier at the base': False,
            'verifier that sleeps past the timeout': 'import time; time.sleep(30)\n',
            'verifier that prints invalid utf-8': 'import sys; sys.stdout.buffer.write(b"\\xff\\xfe{")\n',
            'verifier that prints nothing': 'pass\n',
            'verifier that crashes': 'raise SystemExit(7)\n',
            'verifier that is not python': 'this is ( not python\n',
        }.items():
            with self.subTest(name):
                self.f = fixtures.Fixture()
                self.addCleanup(self.f.tmp.cleanup)
                self.ci = self.f.key('ci', 'fleet/ci')
                base = self.commit_base(script=script)
                commit, tree = self.head()
                self.note(commit, tree)
                fields = self.assertRuns(base, name, timeout='1')
                self.assertIn(fields['outcome'], ('unavailable', 'rejected'))
        self.assertEqual(self.assertRuns('', 'no base')['outcome'], 'unavailable')
        self.assertEqual(self.assertRuns('f' * 40, 'unfetchable base')['outcome'], 'unavailable')
        self.assertEqual(self.assertRuns(self.f.git('rev-parse', 'HEAD'), 'no check', check='')['outcome'], 'unavailable')

    def test_a_lying_verifier_cannot_make_the_gate_skip(self):
        liars = {
            'wrong tree': '{"satisfied": true, "tier": "full", "kind": "observed", "trust_level": "fleet", '
                          '"tree": "%s", "check": "linux-gate", "record": "%s", "signer": "fleet/ci", '
                          '"observed_at": "%s"}' % ('c' * 40, 'a' * 40, '2999-01-01T00:00:00+00:00'),
            'tier test': '{"satisfied": true, "tier": "test", "kind": "observed", "trust_level": "fleet"}',
            'exit zero but unsatisfied': '{"satisfied": false, "reason": "no_record"}',
            'a list': '[1, 2, 3]',
        }
        for name, answer in liars.items():
            with self.subTest(name):
                self.f = fixtures.Fixture()
                self.addCleanup(self.f.tmp.cleanup)
                self.ci = self.f.key('ci', 'fleet/ci')
                base = self.commit_base(script='print(%r)\n' % answer)
                self.head()
                fields = self.assertRuns(base, name)
                self.assertNotEqual(fields['decision'], 'skip')

    # ---- the repository's skip policy -------------------------------------------------------

    def test_without_a_readable_policy_at_the_accepted_base_nothing_skips(self):
        for name, policy in {'no file': False, 'not json': 'nope', 'unknown key': json.dumps(
                {'version': 1, 'checks': {}, 'extra': 1}), 'empty': json.dumps({'version': 1, 'checks': {}})}.items():
            with self.subTest(name):
                self.f = fixtures.Fixture()
                self.addCleanup(self.f.tmp.cleanup)
                self.ci = self.f.key('ci', 'fleet/ci')
                base = self.commit_base(policy=policy)
                commit, tree = self.head()
                self.note(commit, tree)
                self.assertEqual(self.assertRuns(base, name)['outcome'], 'unavailable')

    def scenario(self, policy=None, **note_kwargs):
        """A fresh repository whose base carries `policy`; the head differs from it in nothing protected."""
        self.f = fixtures.Fixture()
        self.addCleanup(self.f.tmp.cleanup)
        self.ci = self.f.key('ci', 'fleet/ci')
        base = self.commit_base(policy=policy)
        commit, tree = self.head()
        if note_kwargs is not None:
            self.note(commit, tree, **note_kwargs)
        return base, commit, tree

    def test_adding_a_required_input_tightens_future_notes_without_breaking_anything(self):
        entry = {'trust_levels': ['fleet'], 'kinds': {'observed': {
            'command': ['github-actions', '{repository}', '.github/workflows/fleet.yml', '{check}'],
            'runner_prefix': 'github:{repository}/', 'required_inputs': ['flake_lock_sha256', 'toolchain_sha256']}}}
        tight_policy = json.dumps({'version': 1, 'checks': {c: entry for c in CHECKS}})
        loose, _, _ = self.scenario(inputs={'flake_lock_sha256': 'a' * 64})
        self.assertEqual(self.run_gate(loose)[0]['decision'], 'skip')
        tight, commit, tree = self.scenario(policy=tight_policy, inputs={'flake_lock_sha256': 'a' * 64})
        self.assertEqual(self.assertRuns(tight)['outcome'], 'rejected')
        self.note(commit, tree, seconds=1, inputs={'flake_lock_sha256': 'a' * 64, 'toolchain_sha256': 'b' * 64})
        self.assertEqual(self.run_gate(tight)[0]['decision'], 'skip')

    def test_an_age_limit_in_the_policy_applies_but_there_is_none_by_default(self):
        unlimited, _, _ = self.scenario(seconds=-(WEEK * 52))
        self.assertEqual(self.run_gate(unlimited)[0]['decision'], 'skip')  # a year old, no limit
        limited, _, _ = self.scenario(policy=skip_policy(max_age_s=WEEK), seconds=-(WEEK * 52))
        fields = self.assertRuns(limited)
        self.assertEqual((fields['outcome'], fields['reason']), ('rejected', 'too_old'))

    def test_a_weaker_local_signer_never_makes_the_gate_skip_on_an_observed_looking_record(self):
        doc = json.loads(skip_policy())
        for check in CHECKS:  # the weak level is granted to a wrapper rule only, never to `observed`
            doc['checks'][check]['kinds']['wrapper'] = {'command': ['wrapper-cmd', check],
                                                        'trust_levels': ['fleet', 'local']}
        self.f = fixtures.Fixture()
        self.addCleanup(self.f.tmp.cleanup)
        self.ci = self.f.key('ci', 'fleet/ci')
        weak = self.f.key('weak', 'local/ci')  # on the base's key list, at the weaker level
        base = self.commit_base(policy=json.dumps(doc))
        commit, tree = self.head()
        # Imitating the observer's runner and command, signed by the weak level: never a skip.
        self.note(commit, tree, key=weak, signer='local/ci')
        fields = self.assertRuns(base)
        self.assertEqual((fields['outcome'], fields['reason']), ('rejected', 'untrusted_level'))
        # With the wrapper command it is judged as a wrapper, and is reported as one, never as observed.
        self.note(commit, tree, key=weak, signer='local/ci', runner='wrapper', command=('wrapper-cmd', 'linux-gate'),
                  seconds=1)
        fields, _ = self.run_gate(base)
        self.assertEqual((fields['kind'], fields['trust_level']), ('wrapper', 'local'))
        # A newer imitation of the observer by the weak signer cannot hide behind the wrapper grant.
        self.note(commit, tree, key=weak, signer='local/ci', seconds=2)
        self.assertEqual(self.assertRuns(base)['reason'], 'untrusted_level')

    # ---- the gate comes from the accepted base, and files that decide skipping are protected ---

    def workflow_step(self):
        """The real gate step, as the generated workflow runs it."""
        text = (ROOT / '.github/workflows/fleet.yml').read_text()
        job = re.search(r'  evidence-gate-linux-gate:\n(.*?)\n  evidence-gate-typescript-client:', text, re.S).group(1)
        step = job.split('      - name: Look for an existing evidence note\n', 1)[1].split('\n      - name: ', 1)[0]
        return json.loads(re.search(r'^        run: (".*")$', step, re.M).group(1))

    def run_step(self, base, check='linux-gate', **overrides):
        """Execute the workflow's own command in a depth-1 clone, the way the runner does."""
        work = Path(self.work_dir.name) / 'step'
        if work.exists():
            shutil.rmtree(work)
        subprocess.run(['git', 'clone', '-q', '--depth=1', 'file://' + str(self.f.repo), str(work)], check=True,
                       capture_output=True)
        temp = Path(self.work_dir.name) / 'runner-temp'
        temp.mkdir(exist_ok=True)
        output = Path(self.work_dir.name) / 'step-output'
        output.write_text('')
        env = dict(os.environ, CHECK=check, REPOSITORY=REPOSITORY, HEAD_REPOSITORY=REPOSITORY, BASE_SHA=base,
                   EVENT_NAME='merge_group', HEAD_SHA=self.f.git('rev-parse', 'HEAD'), PR_NUMBER='', RUN_ID='42',
                   RUN_ATTEMPT='1', RUNNER_TEMP=str(temp), GITHUB_OUTPUT=str(output),
                   GITHUB_STEP_SUMMARY=str(Path(self.work_dir.name) / 'step-summary'))
        env.update(overrides)
        done = subprocess.run(['bash', '-e', '-c', self.workflow_step()], cwd=work, env=env, capture_output=True)
        self.assertEqual(done.returncode, 0, done.stderr.decode())  # the step never fails the job
        outputs = dict(line.split('=', 1) for line in output.read_text().split())
        return outputs, done.stdout.decode()

    def test_the_workflow_step_takes_the_gate_from_the_base_so_an_edited_gate_cannot_skip(self):
        base = self.commit_base()
        evil = ("import os\nopen(os.environ['GITHUB_OUTPUT'], 'a').write('outcome=satisfied\\nskip=true\\nrecord=" + 'a' * 40 +
                "\\n')\nprint('evidence-decision v1 decision=skip')\n")
        (self.f.repo / 'scripts/ci-evidence-gate').write_text(evil)
        commit, tree = self.head()  # the head commit carries the rewritten gate; no note for it exists
        outputs, printed = self.run_step(base)
        self.assertEqual(outputs['skip'], 'false')
        self.assertNotIn('decision=skip', printed)
        # Even with a perfectly valid note for the changed tree, a changed gate is a protected path: run.
        self.note(commit, tree)
        outputs, printed = self.run_step(base)
        self.assertEqual((outputs['skip'], outputs['record']), ('false', '-'))
        self.assertIn('decision=run', printed)

    def test_the_workflow_step_skips_when_nothing_protected_changed_and_a_trusted_note_exists(self):
        base = self.commit_base()
        commit, tree = self.head()
        self.note(commit, tree)
        outputs, printed = self.run_step(base)
        self.assertEqual((outputs['skip'], outputs['outcome']), ('true', 'satisfied'))
        self.assertIn('decision=skip', printed)

    def test_without_a_working_gate_at_the_base_the_step_reports_unavailable_and_runs_the_check(self):
        for name, gate_text in {'gate missing': None, 'gate crashes': 'raise SystemExit(3)\n',
                                'gate has a syntax error': 'def (\n'}.items():
            with self.subTest(name):
                self.f = fixtures.Fixture()
                self.addCleanup(self.f.tmp.cleanup)
                self.ci = self.f.key('ci', 'fleet/ci')
                base = self.commit_base()
                if gate_text is None:
                    self.f.git('rm', '-q', 'scripts/ci-evidence-gate')
                else:
                    (self.f.repo / 'scripts/ci-evidence-gate').write_text(gate_text)
                self.f.git('add', '-A')
                self.f.git('commit', '-q', '-m', 'broken gate at the base')
                base = self.f.git('rev-parse', 'HEAD')
                commit, tree = self.head()
                self.note(commit, tree)
                outputs, printed = self.run_step(base)
                self.assertEqual((outputs['skip'], outputs['outcome']), ('false', 'unavailable'), name)
                self.assertIn('decision=run', printed)

    def test_changing_any_file_that_decides_skipping_runs_the_check_despite_a_valid_note(self):
        self.assertEqual(tuple(gate.PROTECTED), EXPECTED_PROTECTED)
        for path in EXPECTED_PROTECTED:
            with self.subTest(path):
                self.f = fixtures.Fixture()
                self.addCleanup(self.f.tmp.cleanup)
                self.ci = self.f.key('ci', 'fleet/ci')
                base = self.commit_base()
                target = self.f.repo / path
                target.parent.mkdir(parents=True, exist_ok=True)
                target.write_text((target.read_text() if target.exists() else '') + '\n# edited by the change\n')
                commit, tree = self.head()
                self.note(commit, tree)
                fields = self.assertRuns(base, path)
                self.assertEqual(fields['outcome'], 'satisfied')  # the note is fine; the change is not skippable
                self.assertIn('protected', fields['reason'].lower() + 'protected')
        # Moving a protected file away (rename detection would report only the new name) still counts.
        for path in EXPECTED_PROTECTED:
            with self.subTest('moved ' + path):
                self.f = fixtures.Fixture()
                self.addCleanup(self.f.tmp.cleanup)
                self.ci = self.f.key('ci', 'fleet/ci')
                (self.f.repo / '.github/workflows').mkdir(parents=True, exist_ok=True)
                (self.f.repo / '.github/workflows/fleet.yml').write_text('name: x\n')
                (self.f.repo / '.github/workflows/fleet.yml.genie.ts').write_text('export default 1\n')
                base = self.commit_base()
                (self.f.repo / 'moved-away').mkdir(exist_ok=True)
                self.f.git('mv', path, 'moved-away/' + path.replace('/', '_'))
                commit, tree = self.head()
                self.note(commit, tree)
                self.assertRuns(base, 'moved ' + path)
        # An unrelated change to other files still skips.
        self.f = fixtures.Fixture()
        self.addCleanup(self.f.tmp.cleanup)
        self.ci = self.f.key('ci', 'fleet/ci')
        base = self.commit_base()
        commit, tree = self.head()
        self.note(commit, tree)
        self.assertEqual(self.run_gate(base)[0]['decision'], 'skip')

    # ---- the decision line ------------------------------------------------------------------

    def test_the_decision_line_has_the_promised_fields_in_order_and_no_spaces_in_values(self):
        base = self.commit_base()
        commit, tree = self.head()
        self.note(commit, tree)
        fields, outputs = self.run_gate(base, PR_NUMBER='123', EVENT_NAME='pull_request')
        self.assertEqual(list(fields), [
            'check', 'decision', 'outcome', 'reason', 'record', 'signer', 'trust_level', 'kind', 'tier',
            'observed_at', 'age_s', 'max_age_s', 'attempts', 'tree', 'head', 'base', 'event', 'pr', 'repo', 'run',
            'attempt', 'fork', 'verifier_sha256', 'gate_sha256'])
        self.assertEqual((fields['pr'], fields['repo'], fields['run'], fields['attempt'], fields['fork']),
                         ('123', REPOSITORY, '42', '1', 'false'))
        self.assertEqual((fields['max_age_s'], fields['tree'], fields['base']), ('-', tree, base))
        self.assertTrue(all(re.fullmatch(r'[0-9a-f]{64}', fields[k]) for k in ('verifier_sha256', 'gate_sha256')))
        self.assertTrue(0 <= int(fields['age_s']) < 3600)
        # A run with no PR number prints '-', and a refusal prints '-' for everything about a record.
        fields, _ = self.run_gate(base, PR_NUMBER='', check='typescript-client')
        self.assertEqual((fields['pr'], fields['record'], fields['signer'], fields['tier']), ('-', '-', '-', '-'))


class WorkflowStructure(unittest.TestCase):
    """The loops factory named, checked on the workflow files themselves."""

    def test_no_workflow_has_an_unfiltered_push_trigger_so_a_notes_push_starts_nothing(self):
        for path in sorted((ROOT / '.github/workflows').glob('*.yml')):
            text = path.read_text()
            on = re.search(r'^on:\n((?:  .*\n|\n)+)', text, re.M)
            self.assertIsNotNone(on, path.name)
            push = re.search(r'^  push:(.*)\n((?:    .*\n)*)', on.group(1), re.M)
            if push:
                body = push.group(1) + push.group(2)
                self.assertRegex(body, r'branches|tags', f'{path.name} has an unfiltered push trigger')

    def test_the_gate_jobs_can_write_nothing_and_start_nothing(self):
        text = (ROOT / '.github/workflows/fleet.yml').read_text()
        jobs = re.findall(r'^  (evidence-gate-[a-z-]+):\n((?:    .*\n|\n)+)', text, re.M)
        self.assertEqual(len(jobs), len(CHECKS))
        for name, body in jobs:
            self.assertIn('    permissions:\n      contents: read\n', body, name)
            self.assertNotRegex(body, r'write|workflow_dispatch|gh (run|workflow|api)|secrets\.|git push', name)
            self.assertNotIn('needs:', body.split('steps:')[0], name)
            self.assertIn('git show \\"$BASE_SHA:scripts/ci-evidence-gate\\"', body, name)  # the gate comes from the base
            self.assertNotIn('python3 scripts/ci-evidence-gate', body, name)  # never the tree under test
            self.assertIn("- name: evidence skip taken\n        if: steps.gate.outputs.skip == 'true'", body, name)


    def test_every_evidence_test_script_runs_in_the_required_genie_freshness_check(self):
        listed = (ROOT / 'scripts/ci-genie-freshness').read_text()
        for path in sorted((ROOT / 'scripts').iterdir()):
            if re.fullmatch(r'(?:ci-)?evidence-[a-z-]*test', path.name):
                self.assertRegex(listed, rf'(?<![\w-]){re.escape(path.name)}(?![\w-])', f'{path.name} is not run by scripts/ci-genie-freshness')

if __name__ == '__main__':
    unittest.main()
