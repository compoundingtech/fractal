#!/usr/bin/python3
"""Review-gated, operator-installed Slice0 fixture. Never execute on a host.

The image/trigger/egress/guest bootstrap principal require separate approval.
This file contains no Docker, sudo, environment-clearing or service-install command.
"""
import hashlib
import http.client
import json
import os
from pathlib import Path
import re
import socket
import socketserver
import subprocess
import sys
import threading
import time
import urllib.parse

BUILD = "21fd968d3c5534a1ebb33458e8ff25c6d4e2da90"
BINARY_SHA = "eeae8c11562b4c048ce59c52dd0b75b543bb139e68caae274ad45da06d3f5938"
BINARY = Path("/opt/st-scratch/st3")
ROOT = Path("/state")
SOCKET = ROOT / "run/st3.sock"
PREFIX = "doc/scratch-pair-proof/"
MAX_REPLY = 8 * 1024 * 1024
MAX_CLAIMS = 500
MAX_RECEIPT = 48 * 1024
MAX_CONTROL = 256 * 1024
MAX_RELAY_CONNECTIONS = 64
MAX_RELAY_BYTES = 64 * 1024 * 1024
PORTS = {"a": 31313, "b": 31314}
CONTROL = 31320
ENVIRONMENT = {"HOME": "/state/home", "XDG_CONFIG_HOME": "/state/config",
               "XDG_STATE_HOME": "/state/data", "XDG_RUNTIME_DIR": "/state/run",
               "PATH": "/usr/bin:/bin", "PYTHONDONTWRITEBYTECODE": "1"}
ADMISSION_FIELDS = ("pending_records", "unknown_records", "waiting_claims", "invalid_records",
                    "repaired_records", "unsigned_envelopes", "fenced_envelopes",
                    "unhealthy_projections")
COMPARE_FIELDS = ("scope", "build", "fleet_id", "member_key_fingerprints", "input_sha256",
                  "claim_count", "documents", "documents_sha256")
REFUSAL_CODES = {
    "unexpected-environment", "wrong-environment", "missing-hostname", "request-width",
    "response-width", "child-exited", "condition-not-reached", "root-not-readonly",
    "private-tmpfs-required", "document-count", "duplicate-document", "missing-document",
    "document-hash", "document-size", "document-not-current", "binding-id",
    "binding-not-in-cut", "binding-kind-or-subject", "binding-body-mismatch",
    "binding-time-mismatch", "binding-physical-index-mismatch", "binding-owner-mismatch",
    "not-a-fleet", "fleet-status-mismatch", "wrong-running-build", "claim-history-over-budget",
    "claim-count", "duplicate-claim", "document-page-incomplete", "content-reference",
    "content-field-mismatch", "cut-changed", "build-changed", "unexpected-fleet-anchor",
    "unexpected-fleet-members", "unexpected-local-member", "uncurrent-fleet-member",
    "local-member-key-mismatch", "duplicate-member-key", "missing-fleet-id",
    "relay-connection-budget", "relay-total-byte-budget", "relay-byte-budget",
    "relay-copy-not-finished", "cli-failed", "cli-output-width", "wrong-role-or-uid",
    "guest-isolation-check-failed", "wrong-state-root", "wrong-binary", "state-not-empty",
    "fixed-member-argv-only", "unexpected-control-peer", "control-response-width",
    "unknown-control", "control-width", "peer-proof-not-finished", "invite-shape",
} | {"unready-admission-" + field for field in ADMISSION_FIELDS} | {
    "member-field-mismatch-" + field for field in COMPARE_FIELDS}


class Refused(Exception):
    pass


class CutMismatch(Refused):
    def __init__(self, differences):
        super().__init__("member-field-mismatch-input_sha256")
        self.differences = differences


def require(condition, code):
    if not condition:
        raise Refused(code)


def safe_error(error):
    if isinstance(error, Refused):
        code = str(error)
        return code if code in REFUSAL_CODES or re.fullmatch(r"http-[1-5][0-9]{2}", code) else "unrecognized-refusal"
    return type(error).__name__


def encoded(value):
    return json.dumps(value, sort_keys=True, separators=(",", ":")).encode()


def digest(value):
    return hashlib.sha256(encoded(value)).hexdigest()


def check_environment(environment):
    require(set(environment) == set(ENVIRONMENT) | {"HOSTNAME"}, "unexpected-environment")
    require(all(environment[key] == value for key, value in ENVIRONMENT.items()), "wrong-environment")
    require(bool(environment["HOSTNAME"]), "missing-hostname")


def isolation_checks(status, ipv4_routes, ipv6_routes, resolver, interfaces, resolve):
    """Return all honest-guest interlocks so failures are visible in the final receipt."""
    fields = dict(line.split(":", 1) for line in status.splitlines() if ":" in line)
    nameservers = [line.split()[1] for line in resolver.splitlines()
                   if line.strip().startswith("nameserver ") and len(line.split()) == 2]
    resolver_lines = [line.split() for line in resolver.splitlines()
                      if line.strip() and not line.lstrip().startswith("#")]
    try:
        resolve("example.com", None)
        external_dns_refused = False
    except socket.gaierror:
        external_dns_refused = True
    route_lines = ipv4_routes.splitlines()
    routes = [line.split() for line in route_lines[1:]]
    ipv6 = [line.split() for line in ipv6_routes.splitlines()]
    routes_well_formed = (bool(route_lines) and route_lines[0].split()[:2] == ["Iface", "Destination"]
                          and all(len(row) >= 11 for row in routes) and all(len(row) >= 10 for row in ipv6))
    return {
        "no_new_privileges": fields.get("NoNewPrivs", "").strip() == "1",
        "no_effective_capabilities": fields.get("CapEff", "").strip() == "0000000000000000",
        "no_default_route": (routes_well_formed
                             and not any(row[1] == "00000000" for row in routes)
                             and not any(row and row[0] == "0" * 32 and row[1] == "00" for row in ipv6)),
        "embedded_resolver_only": (nameservers == ["127.0.0.11"] and
                                   all(row[0] in {"nameserver", "options"} for row in resolver_lines)),
        "external_dns_refused": external_dns_refused,
        "expected_interfaces": set(interfaces) == {"lo", "eth0"},
    }


def guest_isolation():
    return isolation_checks(Path("/proc/self/status").read_text(),
                            Path("/proc/net/route").read_text(),
                            Path("/proc/net/ipv6_route").read_text(),
                            Path("/etc/resolv.conf").read_text(),
                            os.listdir("/sys/class/net"), socket.getaddrinfo)


class UnixHTTP(http.client.HTTPConnection):
    def connect(self):
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(str(SOCKET))


def request(connection, method, path, body=None):
    """Bound the wire bytes before JSON decode; API errors reveal no response bodies."""
    try:
        payload = None if body is None else encoded(body)
        require(payload is None or len(payload) <= MAX_REPLY, "request-width")
        connection.request(method, path, payload, {"Content-Type": "application/json"})
        response = connection.getresponse()
        data = response.read(MAX_REPLY + 1)
        require(len(data) <= MAX_REPLY, "response-width")
        require(response.status == 200, f"http-{response.status}")
        return json.loads(data)
    finally:
        connection.close()


def local(method, path, body=None):
    return request(UnixHTTP("local", timeout=15), method, path, body)


def peer(method, path, body=None):
    return request(http.client.HTTPConnection("a", CONTROL, timeout=15), method, path, body)


def await_ready(check, children, seconds=120):
    """Startup/sync condition waiting, not retry of a failed mutation."""
    until = time.monotonic() + seconds
    while time.monotonic() < until:
        require(all(child.poll() is None for child in children), "child-exited")
        try:
            if check():
                return
        except (ConnectionError, FileNotFoundError, socket.timeout):
            pass
        time.sleep(0.2)
    raise Refused("condition-not-reached")


def document_bytes(number):
    return f"invented fixture document {number:02d}\n".encode()


def check_mounts(text):
    mounts = {}
    for line in text.splitlines():
        fields = line.split()
        separator = fields.index("-")
        mounts[fields[4]] = (set(fields[5].split(",")), fields[separator + 1])
    require("ro" in mounts.get("/", (set(), ""))[0], "root-not-readonly")
    for path in ("/state", "/tmp"):
        flags, kind = mounts.get(path, (set(), ""))
        require(kind == "tmpfs" and {"rw", "noexec", "nodev", "nosuid"} <= flags,
                "private-tmpfs-required")


def compare_documents(rows):
    require(isinstance(rows, list) and len(rows) == 50, "document-count")
    by_name = {row["name"]: row for row in rows}
    require(len(by_name) == 50, "duplicate-document")
    for number in range(50):
        name = PREFIX + f"{number:02d}"
        require(name in by_name, "missing-document")
        body = document_bytes(number)
        row = by_name[name]
        require(row["hash"] == hashlib.sha256(body).hexdigest(), "document-hash")
        require(row["size"] == len(body), "document-size")
        require(row["latest"] is True, "document-not-current")
        require(isinstance(row["binding_claim_id"], str) and row["binding_claim_id"], "binding-id")
    return [by_name[PREFIX + f"{number:02d}"] for number in range(50)]


def verify_binding(row, claims):
    matches = [claim for claim in claims if claim["id"] == row["binding_claim_id"]]
    require(len(matches) == 1, "binding-not-in-cut")
    claim = matches[0]
    require(claim["kind"] == "doc.bound" and claim["subject"] == row["name"], "binding-kind-or-subject")
    for field in ("name", "hash", "size"):
        require(claim["body"][field] == row[field], "binding-body-mismatch")
    require(claim["accepted_at_unix_ms"] == row["created_at_unix_ms"], "binding-time-mismatch")
    require(claim["store_index"] == row["created_index"], "binding-physical-index-mismatch")
    require((claim["actor"] or claim["origin"]) == row["owner"], "binding-owner-mismatch")


def capture_cut():
    """Exhaustive bounded *fixture document/input* cut, not a global Source capability.

    The approved external backend supplies exclusive writer ownership. A whole claim
    page must fit; physical index stability refuses concurrent changes. Physical arrival
    indices are retained locally but excluded from cross-member semantic comparison.
    All projected document fields and content are checked, not cached digests alone.
    """
    status = local("GET", "/v1/replication/status")
    require(status["configured"] is True and status["fleet_id"], "not-a-fleet")
    fleet = local("GET", "/v1/internal/fleet/status")
    require(fleet["fleet_id"] == status["fleet_id"], "fleet-status-mismatch")
    members = fleet_members(fleet)
    for field in ADMISSION_FIELDS:
        require(status[field] == 0, "unready-admission-" + field)
    before = local("GET", "/v1/health")
    require(before["build"]["commit"] == BUILD, "wrong-running-build")
    page = local("GET", f"/v1/claims?after_index=0&limit={MAX_CLAIMS}")
    require(page.get("next_cursor") is None, "claim-history-over-budget")
    claims = page["claims"]
    require(isinstance(claims, list) and len(claims) < MAX_CLAIMS, "claim-count")
    require(len({claim["id"] for claim in claims}) == len(claims), "duplicate-claim")
    listing = local("GET", "/v1/documents?prefix=" + urllib.parse.quote(PREFIX, safe="") + "&limit=51")
    require(listing.get("has_more") is False, "document-page-incomplete")
    semantic = []
    for row in compare_documents(listing["items"]):
        reference = row["name"] + "@" + row["hash"]
        content = local("GET", "/v1/documents/content?reference=" + urllib.parse.quote(reference, safe=""))
        require(content["reference"] == reference, "content-reference")
        number = int(row["name"].removeprefix(PREFIX))
        require(content["bytes"] == list(document_bytes(number)), "content-field-mismatch")
        verify_binding(row, claims)
        # created_index is a physical arrival index, not a replicated logical field.
        semantic.append({key: value for key, value in row.items() if key != "created_index"})
    after = local("GET", "/v1/health")
    require(before["store_index"] == after["store_index"], "cut-changed")
    require(after["build"]["commit"] == BUILD, "build-changed")
    logical_claims = [{key: value for key, value in claim.items() if key != "store_index"}
                      for claim in sorted(claims, key=lambda item: item["id"])]
    return {
        "scope": "exhaustive-fixture-documents-and-admitted-claims-v1",
        "not_global_source_or_projection_oracle": True,
        "build": BUILD,
        "fleet_id": status["fleet_id"],
        "member_key_fingerprints": members,
        "physical_store_index": after["store_index"],
        "claim_count": len(claims),
        "input_sha256": digest(logical_claims),
        "_claim_refs": sorted((claim["id"], claim["kind"],
                               digest({key: value for key, value in claim.items()
                                       if key != "store_index"})) for claim in claims),
        "documents": semantic,
        "documents_sha256": digest(semantic),
    }


def fleet_members(fleet):
    view = fleet["view"]
    members = view["members"]
    require(not view["legacy_removed"], "unexpected-fleet-anchor")
    require(len(members) == 2 and {member["name"] for member in members} == set(PORTS),
            "unexpected-fleet-members")
    require(fleet["node"] in PORTS, "unexpected-local-member")
    require(all(member["state"] == "current" and member["end"] is None and
                isinstance(member["member_key"], str) and member["member_key"] for member in members),
            "uncurrent-fleet-member")
    own = next(member for member in members if member["name"] == fleet["node"])
    require(own["member_key"] == fleet["member_key"], "local-member-key-mismatch")
    require(len({member["member_key"] for member in members}) == 2, "duplicate-member-key")
    require(view["anchor"] == next(member["member_key"] for member in members
                                   if member["name"] == "a"), "unexpected-fleet-anchor")
    return {member["name"]: hashlib.sha256(member["member_key"].encode()).hexdigest()
            for member in members}


def claim_differences(left, right):
    left_refs = {claim_id: (kind, claim_hash) for claim_id, kind, claim_hash in left["_claim_refs"]}
    right_refs = {claim_id: (kind, claim_hash) for claim_id, kind, claim_hash in right["_claim_refs"]}
    ids = sorted(set(left_refs) | set(right_refs))
    def safe_kind(kind):
        return kind if isinstance(kind, str) and re.fullmatch(r"[a-z][a-z0-9.-]{0,63}", kind) else None
    differences = [{"id": claim_id if re.fullmatch(r"[0-9a-f]{64}", claim_id) else "invalid-claim-id",
                    "a_kind": safe_kind(left_refs[claim_id][0]) if claim_id in left_refs else None,
                    "b_kind": safe_kind(right_refs[claim_id][0]) if claim_id in right_refs else None}
                   for claim_id in ids if left_refs.get(claim_id) != right_refs.get(claim_id)]
    return differences[:20]


def compare_cuts(left, right):
    for cut in (left, right):
        require(isinstance(cut["fleet_id"], str) and cut["fleet_id"], "missing-fleet-id")
        require(set(cut["member_key_fingerprints"]) == set(PORTS)
                and len(set(cut["member_key_fingerprints"].values())) == 2,
                "unexpected-fleet-members")
    for key in COMPARE_FIELDS:
        if key == "input_sha256" and left[key] != right[key]:
            raise CutMismatch(claim_differences(left, right))
        require(left[key] == right[key], "member-field-mismatch-" + key)


def public_cut(cut):
    return {key: value for key, value in cut.items() if key != "_claim_refs"}


class Relay(socketserver.ThreadingTCPServer):
    allow_reuse_address = False
    daemon_threads = True

    def __init__(self, address, handler, destination, fixture):
        super().__init__(address, handler)
        self.destination = destination
        self.fixture = fixture
        self.lock = threading.Lock()
        self.connections = 0
        self.total_bytes = 0

    def reserve_connection(self):
        with self.lock:
            self.connections += 1
            require(self.connections <= MAX_RELAY_CONNECTIONS, "relay-connection-budget")

    def verify_request(self, request, client_address):
        try:
            self.reserve_connection()
            return True
        except Refused as error:
            self.fixture.relay_error = safe_error(error)
            self.fixture.finished.set()
            return False

    def charge(self, size):
        with self.lock:
            self.total_bytes += size
            require(self.total_bytes <= MAX_RELAY_BYTES, "relay-total-byte-budget")


class RelayHandler(socketserver.BaseRequestHandler):
    def handle(self):
        # Fixed loopback tunneling for a local-TCP fixture, NOT Fabric/Tailscale.
        try:
            with socket.create_connection(self.server.destination, timeout=10) as other:
                def copy(source, target):
                    transferred = 0
                    try:
                        while True:
                            data = source.recv(65536)
                            if not data:
                                break
                            transferred += len(data)
                            require(transferred <= 16 * 1024 * 1024, "relay-byte-budget")
                            self.server.charge(len(data))
                            target.sendall(data)
                    except Refused as error:
                        self.server.fixture.relay_error = safe_error(error)
                        self.server.fixture.finished.set()
                    finally:
                        try:
                            target.shutdown(socket.SHUT_WR)
                        except OSError:
                            pass
                worker = threading.Thread(target=copy, args=(self.request, other), daemon=True)
                worker.start()
                copy(other, self.request)
                worker.join(timeout=15)
                require(not worker.is_alive(), "relay-copy-not-finished")
        except Refused as error:
            self.server.fixture.relay_error = safe_error(error)
            self.server.fixture.finished.set()


class Fixture:
    def __init__(self, role):
        self.role = role
        self.children = []
        self.servers = []
        self.files = []
        self.manifest = None
        self.code = None
        self.cut = None
        self.protocol_error = None
        self.relay_error = None
        self.cut_differences = None
        self.isolation = {key: False for key in ("no_new_privileges", "no_effective_capabilities",
                                                 "no_default_route", "embedded_resolver_only",
                                                 "external_dns_refused", "expected_interfaces")}
        self.finished = threading.Event()

    def cli(self, *arguments):
        # File-backed capture, bounded before copy; never print a join code/error body.
        with (ROOT / "command-out").open("w+b") as out, (ROOT / "command-err").open("w+b") as err:
            result = subprocess.run([str(BINARY), "--daemon-wait", "0", *arguments],
                                    stdin=subprocess.DEVNULL, stdout=out, stderr=err,
                                    timeout=30, check=False)
            require(result.returncode == 0, "cli-failed")
            require(out.tell() <= 65536 and err.tell() <= 65536, "cli-output-width")
            out.seek(0)
            return out.read()

    def child(self, *arguments):
        log = (ROOT / f"child-{len(self.children)}.log").open("xb")
        self.files.append(log)
        child = subprocess.Popen([str(BINARY), *arguments], stdin=subprocess.DEVNULL,
                                 stdout=log, stderr=log)
        self.children.append(child)

    def prepare(self):
        require(self.role in PORTS and os.geteuid() == 65534, "wrong-role-or-uid")
        check_environment(os.environ)
        check_mounts(Path("/proc/self/mountinfo").read_text())
        self.isolation = guest_isolation()
        require(all(self.isolation.values()), "guest-isolation-check-failed")
        require(ROOT.is_dir() and not ROOT.is_symlink() and ROOT.stat().st_uid == 65534,
                "wrong-state-root")
        require(hashlib.sha256(BINARY.read_bytes()).hexdigest() == BINARY_SHA, "wrong-binary")
        require(not (ROOT / "data").exists() and not SOCKET.exists(), "state-not-empty")
        for directory in ("home", "config/st3", "data", "run"):
            (ROOT / directory).mkdir(parents=True, exist_ok=False)
        # Synthetic guest-local test principal, not a host person/seat. Security review
        # of this operator-owned bootstrap path is mandatory before any fixture run.
        (ROOT / "config/st3/config.toml").write_text(
            f'node="{self.role}"\nperson="person/scratch-fixture"\n'
            f'peer_listen="0.0.0.0:{PORTS[self.role]}"\n'
            'peer_listen_allow_plain_http=true\n')
        other = "b" if self.role == "a" else "a"
        relay = Relay(("127.0.0.1", PORTS[other]), RelayHandler,
                      (other, PORTS[other]), self)
        self.servers.append(relay)
        threading.Thread(target=relay.serve_forever, daemon=True).start()

    def start(self):
        self.child("up")
        await_ready(lambda: local("GET", "/v1/health")["status"] == "ready", self.children)
        self.child("replication-worker")

    def cleanup(self):
        first_error = None
        for server in self.servers:
            try:
                server.shutdown()
                server.server_close()
            except Exception as error:
                first_error = first_error or error
        for child in reversed(self.children):
            try:
                if child.poll() is None:
                    child.terminate()
                try:
                    child.wait(timeout=10)
                except subprocess.TimeoutExpired:
                    child.kill()
                    child.wait(timeout=10)
            except Exception as error:
                first_error = first_error or error
        for file in self.files:
            try:
                file.close()
            except Exception as error:
                first_error = first_error or error
        if first_error is not None:
            raise first_error


def receipt_output(receipt):
    output = encoded(receipt)
    if len(output) > MAX_RECEIPT:
        receipt = {"kind": "interim-scratch-proof", "member": receipt["member"],
                   "accepted": False, "error": "receipt-width",
                   "owned_children_reaped": receipt["owned_children_reaped"],
                   "isolation_checks": receipt["isolation_checks"]}
        output = encoded(receipt)
    return output


def main():
    require(len(sys.argv) == 2 and sys.argv[1] in PORTS, "fixed-member-argv-only")
    fixture = Fixture(sys.argv[1])
    receipt = {"kind": "interim-scratch-proof", "member": fixture.role, "accepted": False}
    try:
        fixture.prepare()
        if fixture.role == "a":
            fixture.cli("fleet", "create", "--name", "a", "--no-service", "--port", str(PORTS["a"]),
                        "--transports", "tailscale", "--advertise-loopback")
            fixture.start()
            for number in range(50):
                local("POST", "/v1/documents", {"name": PREFIX + f"{number:02d}",
                      "bytes": list(document_bytes(number)), "expected_document": None,
                      "idempotency_key": f"fixed-fixture-document-{number:02d}"})
            fixture.cli("fleet", "invite", "b", "--via", "loopback", "--expires", "15m",
                        "--code-file", "/state/invite.code")
            fixture.code = (ROOT / "invite.code").read_text().strip()
            # Force sealing before the later guarded cut capture; no proof from digests alone.
            local("GET", "/v1/replication/status")
            run_sponsor(fixture)
            receipt["cut"] = public_cut(fixture.cut)
        else:
            run_joiner(fixture)
            receipt["cut"] = public_cut(fixture.cut)
        require(fixture.relay_error is None, fixture.relay_error)
        receipt["accepted"] = True
    except Exception as error:
        # Never serialize arbitrary API, child or join-code error text.
        receipt["error"] = safe_error(error)
        if isinstance(error, CutMismatch):
            receipt["differing_claims"] = error.differences
    finally:
        try:
            fixture.cleanup()
        except Exception as error:
            receipt["accepted"] = False
            receipt["cleanup_error"] = type(error).__name__
        receipt["owned_children_reaped"] = all(child.poll() is not None for child in fixture.children)
        receipt["isolation_checks"] = fixture.isolation
        if fixture.cut_differences is not None:
            receipt["differing_claims"] = fixture.cut_differences
        if fixture.relay_error is not None:
            receipt["accepted"] = False
            receipt["error"] = fixture.relay_error
    output = receipt_output(receipt)
    print(output.decode(), flush=True)
    return 0 if json.loads(output)["accepted"] and receipt["owned_children_reaped"] else 1


def check_control_peer(address, expected):
    require(address == expected, "unexpected-control-peer")


def sponsor_handler_class(fixture):
    from http.server import BaseHTTPRequestHandler
    class Handler(BaseHTTPRequestHandler):
        def log_message(self, *arguments):
            pass

        def dispatch(self, method):
            try:
                check_control_peer(self.client_address[0], socket.gethostbyname("b"))
                if method == "GET":
                    answer = self.get()
                else:
                    answer = self.post()
                data = encoded(answer)
                require(len(data) <= MAX_CONTROL, "control-response-width")
                self.send_response(200)
            except Exception as error:
                fixture.protocol_error = safe_error(error)
                if isinstance(error, CutMismatch):
                    fixture.cut_differences = error.differences
                fixture.finished.set()
                data = encoded({"refused": fixture.protocol_error})
                self.send_response(409)
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def get(self):
            if self.path == "/invite":
                answer = {"code": fixture.code}
            elif self.path == "/readiness":
                answer = {"graph_digest": local("GET", "/v1/replication/status")["graph_digest"]}
            elif self.path == "/cut":
                fixture.cut = capture_cut()
                answer = fixture.cut
            else:
                raise Refused("unknown-control")
            return answer

        def post(self):
            require(self.path == "/done", "unknown-control")
            size = int(self.headers.get("Content-Length", "0"))
            require(0 < size <= MAX_CONTROL, "control-width")
            remote = json.loads(self.rfile.read(size))
            compare_cuts(fixture.cut, capture_cut())
            compare_cuts(fixture.cut, remote)
            fixture.finished.set()
            return {}

        def do_GET(self):
            self.dispatch("GET")

        def do_POST(self):
            self.dispatch("POST")
    return Handler


def run_sponsor(fixture):
    from http.server import HTTPServer
    server = HTTPServer(("0.0.0.0", CONTROL), sponsor_handler_class(fixture))
    fixture.servers.append(server)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    require(fixture.finished.wait(600), "peer-proof-not-finished")
    require(fixture.protocol_error is None, fixture.protocol_error)
    require(fixture.relay_error is None, fixture.relay_error)


def run_joiner(fixture):
    invite = None
    def sponsor_ready():
        nonlocal invite
        invite = peer("GET", "/invite")
        return bool(invite.get("code"))
    await_ready(sponsor_ready, fixture.children)
    code = invite["code"]
    require(isinstance(code, str) and len(code) <= 8192 and code.startswith("stj1-"), "invite-shape")
    path = ROOT / "invite.code"
    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    with os.fdopen(descriptor, "w") as output:
        output.write(code)
    fixture.cli("fleet", "join", "--name", "b", "--no-service", "--no-wait",
                "--code-file", str(path), "--port", str(PORTS["b"]),
                "--transports", "tailscale", "--advertise-loopback")
    fixture.start()
    def complete():
        listing = local("GET", "/v1/documents?prefix=" + urllib.parse.quote(PREFIX, safe="") + "&limit=51")
        return len(listing["items"]) == 50
    await_ready(complete, fixture.children)
    # Digest equality is only readiness; the subsequent complete field/input capture
    # still refuses stale/missing inputs and cannot pass on this cached value alone.
    await_ready(lambda: local("GET", "/v1/replication/status")["graph_digest"]
                == peer("GET", "/readiness")["graph_digest"], fixture.children)
    sponsor = peer("GET", "/cut")
    fixture.cut = capture_cut()
    compare_cuts(sponsor, fixture.cut)
    peer("POST", "/done", fixture.cut)


if __name__ == "__main__":
    sys.exit(main())
