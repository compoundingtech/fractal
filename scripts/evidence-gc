#!/usr/bin/env python3
"""Garbage-collect the evidence records (tags and notes): a pure plan of whole trees to delete, then exactly those deletions.

  scripts/evidence-gc [--repo .] [--remote origin] [--fetch] [--apply] [--main origin/main]
                      [--retention FILE] [--as-of UNIX] [--head COMMIT ...] [--heads-from FILE] [--open-heads-from FILE]
                      [--plan-out FILE] [--before-delete JSON_ARGV]

Dry run by default: it reads the records in --repo and prints the plan, changing nothing. With --fetch it first fetches
every `refs/tags/evidence/*`, `refs/notes/evidence/*` and `refs/notes/evidence-input/*`, main's recent history and the tip
of every branch (`refs/heads/*`, into `refs/evidence-gc/tips/*`) from --remote: this is the one tool that pays for the whole
namespace. With --apply it deletes the plan's refs (and migrates the first layout) locally, and with --remote also on the
remote (EVIDENCE_PUSH_TOKEN, if set, is sent as an authorization header and never printed), in batches of at most 500 refs.

THE PLAN is a pure function of git data, so anyone holding the same refs can recompute it (its `inputs_sha256` says which):
  gc_plan(records, index, live trees, live keys, retention, as_of) -> whole trees and whole input keys to delete.
  live trees    the tree of every branch tip (`refs/evidence-gc/tips/*`, plus --head/--heads-from) committed within
                retention.branch_days of as_of: open pull request heads and merge-queue tips are branches; the tree of every
                open pull request head (--open-heads-from) whatever its age; and the trees of main's first-parent commits
                within retention.main_days of as_of, main's tip always
  live keys     the input key each live tree projects to, for every check whose policy declares inputs, and the per-crate keys
                of every live tree for rust-tests (main's scripts/rust-test-keys over main's .st/rust-test-inputs.json; a live tree
                whose crates cannot be keyed keeps every rust-tests key)
  retention     `.st/evidence-retention.json` at --main (or --retention FILE): main_days, branch_days, grace_hours,
                soft_records, cap_records, and an optional reason (text)
  as_of         main's tip commit time (or --as-of), printed in the plan
A tree's records are deleted together or not at all, and a live tree's never: a record of a kept tree cannot disappear, so no
verdict on a kept tree changes, and a dropped tree's verdict can only become "no record, run the check". An input key is the
same: all of its index refs or none. A dead tree or key whose newest record is younger than grace_hours is always kept (a
signing run pushes its first records before its branch, so its tree is dead until then); `grace_records` counts them.
soft_records deletes nothing (it once deleted kept-by-grace groups oldest first, which since the live set outgrew it meant all of
them, #4186); it is still read and checked. A record filed both as a tag and as a note is one record: it counts once. If the
live set alone is over cap_records the tool prints it and exits 3, deleting nothing live.

The FIRST LAYOUT (`refs/notes/evidence/<record>`, no tree in the name): its tree is read from the note. In a live tree it is
MIGRATED (the tree-prefixed ref `refs/notes/evidence/<tree>/<record>` is created, then the old name removed); in a dead tree
it goes with its tree. Refs that are not well-formed records, and everything outside the evidence namespaces, are never touched.

ON THE REMOTE a dead group goes whole or not at all: first the names whose record keeps another name in its group (a note beside
its tag, a migrated or duplicate first-layout name), which changes no verdict; then each group's remaining names in one atomic push.
A push that the remote's protection refuses keeps its groups whole and is reported (`kept_by_protection`), not a failure; the local
refs follow exactly what the remote deleted. The evidence-tags ruleset protects tags against update and non-fast-forward only, so
GC deletes with the host's own login and needs no window.

BEFORE DELETING (--before-delete JSON_ARGV, needs --plan-out): with --apply, the command runs once the plan is written and before
anything is deleted or migrated, with the plan file's path as its last argument, without a shell. The evidence log's GC lines go
here (scripts/evidence-gc-timer runs `evidence-log-timer gc --plan FILE`), so the log says GC removed a tree before its records
disappear. If it fails, nothing is deleted (`refused`, exit 1).

OPEN PULL REQUEST HEADS (--open-heads-from FILE, one commit id a line, an empty file for none): their trees are live however old
the head is, so a pull request that waits longer than branch_days keeps its records. With --fetch the commits are fetched by id
(a fork's head is on no branch here). A missing FILE is refused.

FAILS CLOSED: if a commit named by --head or --open-heads-from cannot be turned into a tree, or no branch tip is known at all, or the --before-delete
command fails, --apply refuses to delete anything.

  exit 0  done (or a dry run)    exit 1  a step failed or a head could not be resolved    exit 2  usage
  exit 3  the live set alone exceeds cap_records (nothing live was deleted)
"""
import argparse
import base64
import collections
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True

NOTES = 'refs/notes/evidence/'
INPUT_NOTES = 'refs/notes/evidence-input/'
TAGS = 'refs/tags/evidence/'
INPUT_TAGS = 'refs/tags/evidence/input/'
OID = re.compile(r'^(?:[0-9a-f]{40}|[0-9a-f]{64})$')
CHECK = re.compile(r'^[A-Za-z0-9._-]+$')
BATCH = 500
TIPS = 'refs/evidence-gc/tips/'
RETENTION_PATH = '.st/evidence-retention.json'
RETENTION_KEYS = ('main_days', 'branch_days', 'grace_hours', 'soft_records', 'cap_records')
# The per-crate check: its policy declares no `inputs`, because each crate has a key of its own (scripts/rust-test-keys over main's
# .st/rust-test-inputs.json, as the gate keys a pull request against its base). Those keys are live keys too (2026-10-28: a plan
# with only the policy's `inputs` deleted the crate keys an open pull request's rust-tests decision had just chosen).
PER_CRATE_CHECK = 'rust-tests'
RUST_TEST_KEYS, RUST_TEST_INPUTS = 'scripts/rust-test-keys', '.st/rust-test-inputs.json'


class Refused(Exception):
    pass


class Usage(Refused):
    pass


def git(repo, *args, stdin=None, header=None, check=True):
    clean = {k: v for k, v in os.environ.items() if not k.startswith('GIT_')}
    if header:
        clean.update(GIT_CONFIG_COUNT='1', GIT_CONFIG_KEY_0='http.extraheader', GIT_CONFIG_VALUE_0=header)  # in the environment: a process listing must not show it
    done = subprocess.run(['git', '-C', repo, '-c', 'core.hooksPath=/dev/null', *args], input=stdin, capture_output=True, timeout=1800,
                          env=dict(clean, GIT_NO_REPLACE_OBJECTS='1', GIT_TERMINAL_PROMPT='0', LC_ALL='C'))
    if check and done.returncode != 0:
        raise Refused(f'git {args[0]}: {done.stderr.decode(errors="replace").strip()[-300:]}')
    return done


def verifier_module():
    here = os.path.dirname(os.path.abspath(__file__))
    loader = importlib.machinery.SourceFileLoader('evidence_verify_for_gc', os.path.join(here, 'evidence-verify'))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


def read_refs(repo):
    """Every ref of the namespaces: (records, index) where record = (ref, oid, layout, tree or None, unix date) and index = (ref, check, key, oid)."""
    out = git(repo, 'for-each-ref', '--format=%(objectname) %(refname) %(committerdate:unix)', 'refs/tags/evidence', 'refs/notes/evidence',
              'refs/notes/evidence-input').stdout.decode()
    records, index = [], []
    for line in out.splitlines():
        oid, _, rest = line.partition(' ')
        name, _, date = rest.rpartition(' ')
        if not OID.match(oid) or not date.isdigit():
            continue
        if name.startswith(INPUT_TAGS) or name.startswith(INPUT_NOTES):
            parts = name[len(INPUT_TAGS if name.startswith(INPUT_TAGS) else INPUT_NOTES):].split('/')
            if len(parts) == 3 and CHECK.match(parts[0]) and OID.match(parts[1]) and parts[2] == oid:
                index.append((name, parts[0], parts[1], oid, int(date)))
        elif name.startswith(TAGS):
            parts = name[len(TAGS):].split('/')
            if len(parts) == 2 and OID.match(parts[0]) and parts[1] == oid:
                records.append((name, oid, 'tag', parts[0], int(date)))
        elif name.startswith(NOTES):
            parts = name[len(NOTES):].split('/')
            if len(parts) == 1 and parts[0] == oid:
                records.append((name, oid, 'legacy', None, int(date)))
            elif len(parts) == 2 and OID.match(parts[0]) and parts[1] == oid:
                records.append((name, oid, 'tree', parts[0], int(date)))
    return records, index


def note_trees(repo, ids):
    """{record id: the tree its note is about} read from each note commit's one-entry notes tree."""
    if not ids:
        return {}
    roots = git(repo, 'cat-file', '--batch-check=%(objectname)', stdin=''.join(f'{r}^{{tree}}\n' for r in ids).encode()).stdout.decode().split()
    raw = git(repo, 'cat-file', '--batch', stdin=''.join(f'{r}\n' for r in roots).encode()).stdout
    width = len(ids[0]) // 2
    found, position = {}, 0
    for record in ids:
        newline = raw.index(b'\n', position)
        header = raw[position:newline].split()
        if len(header) < 3 or header[1] == b'missing':
            position = newline + 1
            continue
        size = int(header[2])
        body = raw[newline + 1:newline + 1 + size]
        position = newline + 1 + size + 1
        names, cursor = [], 0
        while cursor < len(body):
            end = body.index(b'\0', cursor)
            names.append(body[cursor:end].split(b' ', 1)[1].decode(errors='replace'))
            cursor = end + 1 + width
        if len(names) == 1 and OID.match(names[0]):
            found[record] = names[0]
    return found


def load_retention(text):
    """The retention rules, strictly validated: every key present, numbers in range, nothing unknown but an optional `reason` (a
    non-empty string saying why the numbers are what they are; JSON has no comments)."""
    try:
        value = json.loads(text)
    except ValueError as error:
        raise Usage(f'retention is not valid JSON: {error}')
    if not isinstance(value, dict) or value.get('version') != 1 or set(value) - {'reason'} != {'version', *RETENTION_KEYS}:
        raise Usage(f'retention must be {{"version": 1, {", ".join(RETENTION_KEYS)}}}, an optional reason, and nothing else')
    if 'reason' in value and not (isinstance(value['reason'], str) and value['reason'].strip()):
        raise Usage('retention: reason must be a non-empty string')
    if not all(isinstance(value[k], (int, float)) and not isinstance(value[k], bool) for k in RETENTION_KEYS):
        raise Usage('retention values must be numbers')
    if not 1 <= value['main_days'] <= 30 or value['branch_days'] < 1 or value['grace_hours'] < 0 or value['soft_records'] < 1 \
            or value['cap_records'] < value['soft_records'] or not all(isinstance(value[k], int) for k in ('soft_records', 'cap_records')):
        raise Usage('retention: main_days from 1 to 30 (--fetch reads 40 days of main), branch_days at least 1, grace_hours at least 0, soft_records at least 1, cap_records at least soft_records')
    return value


def commit_facts(repo, commits):
    """({commit: (tree, unix committer time)}, unresolved commits)."""
    facts, unresolved = {}, []
    if commits:
        out = git(repo, 'cat-file', '--batch-check=%(objectname) %(objecttype)', stdin=''.join(f'{c}^{{commit}}\n' for c in commits).encode()).stdout.decode()
        found = [line.split()[0] for line in out.splitlines() if line.endswith(' commit')]
        if found:
            shown = git(repo, 'show', '-s', '--format=%H %T %ct', *found, check=False).stdout.decode().split('\n')
            for line in shown:
                parts = line.split()
                if len(parts) == 3 and OID.match(parts[0]) and OID.match(parts[1]) and parts[2].isdigit():
                    facts[parts[0]] = (parts[1], int(parts[2]))
    unresolved = [c for c in commits if c not in facts]
    return facts, unresolved


def main_log(repo, main, days, as_of):
    """[(commit, tree, unix time)] of main's first-parent commits newest first, back to `days` before as_of (main's tip always)."""
    if git(repo, 'rev-parse', '--verify', '--quiet', f'{main}^{{commit}}', check=False).returncode != 0:
        raise Refused(f'{main} does not name a commit')
    out = git(repo, 'log', '--first-parent', '--format=%H %T %ct', main, check=False).stdout.decode().split('\n')
    log = []
    for line in out:
        parts = line.split()
        if len(parts) != 3 or not OID.match(parts[0]) or not OID.match(parts[1]) or not parts[2].isdigit():
            continue
        if log and int(parts[2]) < as_of - int(days * 86400):
            break
        log.append((parts[0], parts[1], int(parts[2])))
    return log


def live_trees(tips, main_history, retention, as_of, open_heads=()):
    """PURE. {tree: reason}: each branch tip's tree committed within branch_days of as_of, each open pull request head's tree
    whatever its age, and main's first-parent trees within main_days of as_of (main's tip, the first entry, always).
    tips: [(tree, unix time)]; main_history: [(tree, unix time)] newest first; open_heads: [tree]."""
    live = {}
    for index, (tree, when) in enumerate(main_history):
        if index == 0 or when >= as_of - retention['main_days'] * 86400:
            live.setdefault(tree, 'main-window')
    for tree, when in sorted(tips):
        if when >= as_of - retention['branch_days'] * 86400:
            live[tree] = 'branch-tip'
    for tree in sorted(open_heads):
        live[tree] = 'open-pull-request'
    return live


def protected_keys(repo, trees, policy_text, repository):
    """{(check, key)} that a protected tree projects to, for every check whose policy declares inputs."""
    verifier = verifier_module()
    keys = set()
    try:
        checks = json.loads(policy_text)['checks']
    except (ValueError, KeyError, TypeError):
        return keys
    for check in checks:
        if not CHECK.match(check):
            continue
        try:
            rules = verifier.policy_rules(policy_text, check, repository)
        except Exception:  # a check whose policy does not parse protects no key
            continue
        if not rules or rules.get('inputs') is None:
            continue
        for tree in trees:
            try:
                key = verifier.project(repo, tree, rules['inputs'])
            except Exception:
                key = None
            if key:
                keys.add((check, key))
    return keys


def crate_keys(repo, trees, main, index, prefetch=None):
    """({(PER_CRATE_CHECK, key)}, report): the per-crate keys every live tree projects to, by main's scripts/rust-test-keys over main's
    .st/rust-test-inputs.json, with the verifier's own projection. Fail closed: when main has no such tool or file nothing is keyed this
    way, but once it has them, a live tree whose crates cannot be keyed (a manifest that cannot be read or parsed) keeps EVERY index key
    of the check, since the keys it would protect are unknown. `prefetch`, when given, is called with the trees first (a partial clone
    fetches the manifests it lacks in one go). report: {'trees': keyed, 'keys': protected, 'unreadable': [tree, ...] (the first 5)}."""
    report = {'trees': 0, 'keys': 0, 'unreadable': []}
    tool = git(repo, 'show', f'{main}:{RUST_TEST_KEYS}', check=False)
    if tool.returncode != 0 or git(repo, 'cat-file', '-e', f'{main}:{RUST_TEST_INPUTS}', check=False).returncode != 0:
        return set(), report
    with tempfile.TemporaryDirectory(prefix='evidence-gc-keys-') as scratch:
        path = os.path.join(scratch, 'rust-test-keys')
        with open(path, 'wb') as handle:
            handle.write(tool.stdout)
        loader = importlib.machinery.SourceFileLoader('rust_test_keys_for_gc', path)
        module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
        loader.exec_module(module)
    project = verifier_module().project
    if prefetch:
        prefetch(sorted(trees))
    keys, unreadable = set(), []
    try:
        inputs = module.read_inputs(repo, main)
    except module.Failure:
        unreadable.append(main)
    else:
        for tree in sorted(trees):
            try:
                found = module.keys(repo, tree, inputs, project)
            except module.Failure:
                unreadable.append(tree)
                continue
            report['trees'] += 1
            keys |= {(PER_CRATE_CHECK, key) for key, _ in found.values() if key}
    if unreadable:
        keys |= {(check, key) for _, check, key, _, _ in index if check == PER_CRATE_CHECK}
    report.update(keys=len(keys), unreadable=unreadable[:5])
    return keys, report


def prefetch_manifests(repo, remote, header):
    """For crate_keys in a partial clone (`--filter=blob:none`): the Cargo.toml blobs of the given trees and main's inputs file that are
    not here yet, fetched by id in batches, so keying hundreds of trees does not lazily fetch each manifest on its own. Best effort: a
    blob still missing after it makes its tree unreadable, which crate_keys counts as a reason to keep every key."""
    def prefetch(trees):
        wanted = set()
        for tree in trees:
            listed = git(repo, 'ls-tree', '-r', '--full-tree', tree, check=False).stdout.decode(errors='replace')
            for line in listed.splitlines():
                meta, _, path = line.partition('\t')
                parts = meta.split()
                if len(parts) == 3 and parts[1] == 'blob' and (path == 'Cargo.toml' or path.endswith('/Cargo.toml')
                                                              or path == RUST_TEST_INPUTS):
                    wanted.add(parts[2])
        if not wanted:
            return
        checked = subprocess.run(['git', '-C', repo, 'cat-file', '--batch-check=%(objectname) %(objecttype)'],
                                 input='\n'.join(sorted(wanted)).encode() + b'\n', capture_output=True, timeout=600,
                                 env=dict(os.environ, GIT_NO_LAZY_FETCH='1', LC_ALL='C'))
        missing = [line.split()[0] for line in checked.stdout.decode().splitlines() if line.endswith(' missing')]
        for start in range(0, len(missing), BATCH):
            git(repo, 'fetch', '--no-tags', '-q', '--no-write-fetch-head', '--filter=blob:none', remote, *missing[start:start + BATCH],
                header=header, check=False)
    return prefetch


def advertised_bytes(count_name_lengths):
    return sum(length + 41 + 2 for length in count_name_lengths)  # "<oid> <ref>\n" in a v0 advertisement (a close upper bound)


def gc_plan(records, index, live, live_keys, retention, as_of):
    """PURE: the same inputs in any order give the same plan.

    records    [(ref, record oid, layout ('tag', 'tree' or 'legacy'), tree or None, unix time)]; a legacy record's tree is
               read from its note before this is called, None when unreadable (such a record is always kept)
    index      [(ref, check, key, record oid, unix time)]
    live       {tree: reason}; live_keys {(check, key)}
    Returns {'delete': sorted refs, 'migrate': sorted (old ref, new ref), 'trees': sorted dead trees deleted,
             'keys': sorted dead (check, key) deleted, 'groups': the refs of each deleted group (what must go together),
             and the counts}."""
    records = sorted(records)
    index = sorted(index)
    cutoff = as_of - int(retention['grace_hours'] * 3600)
    # A group is what is deleted together: every name of every record of one tree, or every index ref of one input key.
    groups = {}
    for ref, oid, layout, tree, when in records:
        groups.setdefault(('tree', tree) if tree else ('unreadable', ref), []).append((ref, oid, layout, when))
    for ref, check, key, oid, when in index:
        groups.setdefault(('key', check, key), []).append((ref, oid, 'index', when))

    def units(group, names):
        return {(('index',) + group[1:] if group[0] == 'key' else ('record',)) + (oid,) for _, oid, _, _ in names}

    reasons = collections.Counter()
    delete, migrate, candidates = [], [], []
    live_units, all_units = set(), set()
    tree_names = {ref for ref, _, layout, _, _ in records if layout == 'tree'}
    for group, names in sorted(groups.items()):
        all_units |= units(group, names)
        if group[0] == 'unreadable':
            reasons['kept: no readable tree'] += len(names)
            live_units |= units(group, names)
            continue
        why = live.get(group[1]) if group[0] == 'tree' else ('input-key' if group[1:] in live_keys else None)
        if why:
            live_units |= units(group, names)
            for ref, oid, layout, _ in names:
                if layout != 'legacy':
                    reasons[f'kept: {why}'] += 1
                elif f'{NOTES}{group[1]}/{oid}' in tree_names:
                    delete.append(ref)  # already filed under its tree: the old name is only a duplicate
                    reasons['deleted: first-layout duplicate of a tree-prefixed ref'] += 1
                else:
                    migrate.append((ref, f'{NOTES}{group[1]}/{oid}'))
                    reasons[f'kept: {why}'] += 1
                    reasons['migrated: first layout to tree-prefixed'] += 1
            continue
        newest = max(when for _, _, _, when in names)
        if newest >= cutoff:
            candidates.append((newest, group, names))
            reasons['kept: grace'] += len(names)
        else:
            delete += [ref for ref, _, _, _ in names]
            reasons['deleted: dead input key' if group[0] == 'key' else 'deleted: dead tree'] += len(names)
    dead = [group for group, names in groups.items() if group[0] != 'unreadable' and not (live.get(group[1]) if group[0] == 'tree' else group[1:] in live_keys)]
    # Grace is absolute: a dead group younger than grace_hours is never deleted, however many records remain. Until 2026-10-29 the
    # soft limit deleted them oldest first while more than soft_records records remained, and since the live set alone passed
    # soft_records (about 2026-10-23) that deleted every one, every night, including the first records of a signing run whose branch
    # was not pushed yet (#4186). soft_records deletes nothing now; the summary says how many records grace keeps.
    deleted_groups = {group for group in dead if group not in {c[1] for c in candidates}}
    remaining = all_units - set().union(set(), *(units(g, groups[g]) for g in deleted_groups))
    grace_units = set().union(set(), *(units(group, names) for _, group, names in candidates))
    delete = sorted(set(delete))
    doomed = set(delete)
    lengths_before = [len(r[0]) for r in records] + [len(i[0]) for i in index]
    lengths_after = [len(r[0]) for r in records if r[0] not in doomed] + [len(i[0]) for i in index if i[0] not in doomed]
    return {
        'delete': delete, 'migrate': sorted(migrate),
        'trees': sorted(g[1] for g in deleted_groups if g[0] == 'tree'),
        'groups': sorted(sorted(ref for ref, _, _, _ in groups[g]) for g in deleted_groups),
        'keys': sorted([g[1], g[2]] for g in deleted_groups if g[0] == 'key'),
        'refs_before': len(lengths_before), 'refs_after': len(lengths_after),
        'records_before': len(all_units), 'records_after': len(remaining), 'protected_records': len(live_units),
        'grace_records': len(grace_units),
        'protected_refs': sum(len(names) for group, names in groups.items() if group[0] == 'unreadable' or group not in dead),
        'advertised_bytes_before': advertised_bytes(lengths_before), 'advertised_bytes_after': advertised_bytes(lengths_after),
        'reasons': {k: v for k, v in sorted(reasons.items()) if v},
    }


def digest(value):
    return hashlib.sha256(json.dumps(value, sort_keys=True, separators=(',', ':')).encode()).hexdigest()


def header_for_token():
    token = os.environ.get('EVIDENCE_PUSH_TOKEN', '')
    return token, ('Authorization: Basic ' + base64.b64encode(f'x-access-token:{token}'.encode()).decode() if token else None)


# GitHub's answer when a ruleset refuses a push: "GH013: Repository rule violations found for <ref>".
PROTECTION_REFUSED = re.compile(r'GH013: Repository rule violations')


def push_deletions(repo, remote, refs, header, token, atomic):
    """(refs the remote deleted, error text or None) of one push deleting REFS: with `atomic`, all of them or none."""
    done = git(repo, 'push', '--porcelain', *(['--atomic'] if atomic else []), remote, *[f':{ref}' for ref in refs], header=header, check=False)
    deleted = set()
    for line in done.stdout.decode(errors='replace').splitlines():
        parts = line.split('\t')
        if len(parts) >= 3 and parts[0] == '-' and parts[1].startswith(':'):
            deleted.add(parts[1][1:])
    if done.returncode == 0:
        return deleted, None
    text = (done.stdout + done.stderr).decode(errors='replace')
    return deleted, (text.replace(token, '***') if token else text).strip()[-300:]


def apply_remote(repo, remote, migrate, doomed, groups):
    """Make the remote match the plan without ever splitting a group:
    (failures, refs gone from the remote, refs its protection kept, whether the migrations' new names exist there).

    1. The migrations' new names are created.
    2. Names whose record keeps another name in its own group are deleted (the migrated old names, first-layout duplicates, the note
       name of a record that is also a tag): no record leaves any group, so no verdict can change, whatever fails next.
    3. Each dead group's remaining names go in one atomic push (several whole groups to a push, at most BATCH refs, a bigger group
       alone): a group is deleted whole or not at all. The groups without a tag go first, so a protection that refuses deleting
       tags (the evidence-tags ruleset before the deploy key may bypass it) keeps the groups it covers whole and stops nothing else."""
    token, header = header_for_token()
    failed, deleted, protected = [], set(), set()
    listed = git(repo, 'ls-remote', remote, f'{TAGS}*', f'{NOTES}*', f'{INPUT_NOTES}*', header=header).stdout.decode().split('\n')
    there = {line.split()[1] for line in listed if len(line.split()) == 2}
    deleted |= {ref for ref in doomed if ref not in there}  # already gone (a run stopped halfway): nothing to push, only to forget
    deleted |= {old for old, _ in migrate if old not in there}
    creates = [f'{old}:{new}' for old, new in migrate if new not in there]
    for start in range(0, len(creates), BATCH):
        done = git(repo, 'push', '--porcelain', remote, *creates[start:start + BATCH], header=header, check=False)
        if done.returncode != 0:
            text = (done.stdout + done.stderr).decode(errors='replace')
            failed.append((text.replace(token, '***') if token else text).strip()[-300:])
    if failed:
        return failed, set(), set(), False
    grouped = {ref for group in groups for ref in group}
    redundant = [ref for ref in doomed if ref not in grouped] + [old for old, _ in migrate]
    for group in groups:
        tagged = {ref.rsplit('/', 1)[1] for ref in group if ref.startswith(TAGS)}
        redundant += [ref for ref in group if not ref.startswith(TAGS) and ref.rsplit('/', 1)[1] in tagged]
    redundant = sorted(ref for ref in set(redundant) if ref in there)
    for start in range(0, len(redundant), BATCH):
        gone, error = push_deletions(repo, remote, redundant[start:start + BATCH], header, token, atomic=False)
        deleted |= gone
        if error:
            failed.append(error)
    batches = []
    for tagged in (False, True):  # never in one push: a refused tag would take a tagless group down with it
        batch = []
        for group in sorted(sorted(r for r in group if r in there and r not in deleted) for group in groups):
            if not group or any(r.startswith(TAGS) for r in group) != tagged:
                continue
            if batch and len(batch) + len(group) > BATCH:
                batches.append(batch)
                batch = []
            batch += group
        if batch:
            batches.append(batch)
    for batch in batches:
        gone, error = push_deletions(repo, remote, batch, header, token, atomic=True)
        deleted |= gone
        if error and PROTECTION_REFUSED.search(error) and any(ref.startswith(TAGS) for ref in batch):
            protected |= set(batch) - gone
        elif error:
            failed.append(error)
    return failed, deleted, protected, True


def before_delete(argv, plan_path, summary):
    """Run the --before-delete command on the plan; True when it exited 0. Its stdout goes to stderr: ours is the summary."""
    try:
        done = subprocess.run([*argv, plan_path], stdin=subprocess.DEVNULL, capture_output=True, timeout=600)
    except (OSError, subprocess.TimeoutExpired) as error:
        summary['before_delete'] = {'exit_code': None, 'error': str(error)}
        return False
    sys.stderr.write((done.stdout + done.stderr).decode(errors='replace'))
    summary['before_delete'] = {'exit_code': done.returncode}
    return done.returncode == 0


def apply_local(repo, migrate, doomed):
    commands = ''.join(f'create {new} {git(repo, "rev-parse", old).stdout.decode().strip()}\n' for old, new in migrate)
    commands += ''.join(f'delete {ref}\n' for ref in sorted(doomed))  # a migration's old name among them once the remote dropped it
    git(repo, 'update-ref', '--stdin', stdin=f'start\n{commands}prepare\ncommit\n'.encode())
    git(repo, 'pack-refs', '--all')


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('--repo', default='.')
    parser.add_argument('--remote')
    parser.add_argument('--apply', action='store_true')
    parser.add_argument('--fetch', action='store_true', help='first fetch every record, main and every branch tip from --remote')
    parser.add_argument('--main', default='origin/main')
    parser.add_argument('--retention', help=f'retention file (default: {RETENTION_PATH} at --main)')
    parser.add_argument('--as-of', type=int, default=None, help="unix time the plan is computed at (default: main's tip commit time)")
    parser.add_argument('--head', action='append', default=[], help='a commit whose tree is live, besides the branch tips')
    parser.add_argument('--heads-from')
    parser.add_argument('--open-heads-from', help='file of open pull request head commits, one a line: their trees are live at any age')
    parser.add_argument('--repository', default='compoundingtech/fractal', help='OWNER/NAME the skip policy is read for')
    parser.add_argument('--policy-from', help='revision whose .st/evidence-skip-policy.json says which checks have inputs (default --main)')
    parser.add_argument('--plan-out', help='also write the plan, with its inputs digest, to this file')
    parser.add_argument('--before-delete', help='JSON argv run with the --plan-out path appended, after planning and before deleting')
    try:
        args = parser.parse_args(argv)
    except SystemExit as error:
        return 2 if error.code else 0
    try:
        before = None
        if args.before_delete:
            try:
                before = json.loads(args.before_delete)
            except ValueError:
                before = None
            if not isinstance(before, list) or not before or not all(isinstance(a, str) for a in before):
                raise Usage('--before-delete must be a JSON array of strings')
            if not args.plan_out:
                raise Usage('--before-delete needs --plan-out: the command is given the plan file')
        open_heads = []
        if args.open_heads_from:
            try:
                with open(args.open_heads_from) as handle:
                    open_heads = [line.strip() for line in handle if line.strip()]
            except OSError as error:
                raise Usage(f'--open-heads-from: {error}')
            if not all(OID.match(h) for h in open_heads):
                raise Refused('--open-heads-from values must be full commit ids')
        if args.fetch:
            if not args.remote:
                raise Usage('--fetch needs --remote')
            token, header = header_for_token()
            git(args.repo, 'fetch', '--no-tags', '-q', args.remote, f'+{TAGS}*:{TAGS}*', f'+{NOTES}*:{NOTES}*', f'+{INPUT_NOTES}*:{INPUT_NOTES}*', header=header)
            remote_main = args.main.split('/', 1)[-1]
            # Every branch tip but main, one commit deep with its trees (a live tree's input key is projected from its tree), and the
            # tips of deleted branches dropped. Then main, 40 days of it with trees: a one-commit fetch of main would cut its history.
            listed = git(args.repo, 'ls-remote', '--heads', args.remote, header=header).stdout.decode().split('\n')
            branches = {line.split()[1][len('refs/heads/'):] for line in listed if len(line.split()) == 2 and line.split()[1].startswith('refs/heads/')}
            branches.discard(remote_main)
            if branches:  # with nothing left to fetch, `git fetch --depth=1` exits 1 without a word
                git(args.repo, 'fetch', '--no-tags', '-q', '--depth=1', '--filter=blob:none', args.remote, f'+refs/heads/*:{TIPS}*',
                    f'^refs/heads/{remote_main}', header=header)
            stale = [ref for ref in git(args.repo, 'for-each-ref', '--format=%(refname)', TIPS).stdout.decode().split() if ref[len(TIPS):] not in branches]
            if stale:
                git(args.repo, 'update-ref', '--stdin', stdin=''.join(f'delete {ref}\n' for ref in stale).encode())
            git(args.repo, 'fetch', '--no-tags', '-q', '--filter=blob:none', '--shallow-since=40.days.ago', args.remote,
                f'+refs/heads/{remote_main}:refs/remotes/{args.main}', header=header)
            for start in range(0, len(open_heads), BATCH):  # by id, one commit deep: a head that is gone stays unresolved below
                git(args.repo, 'fetch', '--no-tags', '-q', '--depth=1', '--filter=blob:none', args.remote, *open_heads[start:start + BATCH],
                    header=header, check=False)
        if args.retention:
            with open(args.retention) as handle:
                retention_text = handle.read()
        else:
            shown = git(args.repo, 'show', f'{args.main}:{RETENTION_PATH}', check=False)
            if shown.returncode != 0:
                raise Usage(f'{args.main} has no {RETENTION_PATH}: give --retention')
            retention_text = shown.stdout.decode()
        retention = load_retention(retention_text)
        if args.as_of is not None:
            as_of = args.as_of
        else:
            tip_time = git(args.repo, 'show', '-s', '--format=%ct', f'{args.main}^{{commit}}', check=False).stdout.decode().strip()
            if not tip_time.isdigit():
                raise Refused(f'{args.main} does not name a commit')
            as_of = int(tip_time)
        heads = list(args.head)
        if args.heads_from:
            with open(args.heads_from) as handle:
                heads += [line.strip() for line in handle if line.strip()]
        if not all(OID.match(h) for h in heads):
            raise Refused('--head values must be full commit ids')
        tip_commits = git(args.repo, 'for-each-ref', '--format=%(objectname)', TIPS).stdout.decode().split()
        if args.apply and not heads and not tip_commits and not open_heads:
            raise Usage(f'--apply needs the branch tips to protect: --fetch them into {TIPS}, or give --head or --heads-from (an empty list would delete them)')
        facts, unresolved = commit_facts(args.repo, list(dict.fromkeys(heads + open_heads + tip_commits)))
        # A tip fetched without its commit is a fetch problem; a named head, or an open pull request's, is a promise.
        unresolved = [c for c in unresolved if c in heads or c in open_heads]
        history = main_log(args.repo, args.main, retention['main_days'], as_of)
        live = live_trees([(tree, when) for commit, (tree, when) in facts.items() if commit not in open_heads],
                          [(tree, when) for _, tree, when in history], retention, as_of,
                          [facts[c][0] for c in open_heads if c in facts])
        records, index = read_refs(args.repo)
        legacy_tree = note_trees(args.repo, [oid for _, oid, layout, _, _ in records if layout == 'legacy'])
        records = [(ref, oid, layout, tree or legacy_tree.get(oid), when) for ref, oid, layout, tree, when in records]
        policy = git(args.repo, 'show', f'{args.policy_from or args.main}:.st/evidence-skip-policy.json', check=False)
        policy_text = policy.stdout.decode() if policy.returncode == 0 else ''
        live_keys = protected_keys(args.repo, set(live), policy_text, args.repository) if policy_text else set()
        crate_live, crates = crate_keys(args.repo, set(live), args.main, index,
                                        prefetch_manifests(args.repo, args.remote, header) if args.fetch else None)
        live_keys |= crate_live
        inputs = {'records': sorted(records), 'index': sorted(index), 'live': sorted(live.items()), 'live_keys': sorted(live_keys),
                  'retention': retention, 'as_of': as_of}
        plan = gc_plan(records, index, live, live_keys, retention, as_of)
        summary = {'mode': 'apply' if args.apply else 'dry-run', 'as_of': as_of,
                   'main': git(args.repo, 'rev-parse', f'{args.main}^{{commit}}').stdout.decode().strip(),
                   'inputs_sha256': digest(inputs), 'plan_sha256': digest({k: plan[k] for k in ('delete', 'migrate')}),
                   'retention': retention, 'unresolved_heads': unresolved,
                   'live_trees': {'branch_tips': sum(1 for r in live.values() if r == 'branch-tip'),
                                  'open_pull_requests': sum(1 for r in live.values() if r == 'open-pull-request'),
                                  'main_window': sum(1 for r in live.values() if r == 'main-window')},
                   'crate_keys': crates, 'trees_deleted': len(plan['trees']), 'keys_deleted': len(plan['keys']),
                   **{k: v for k, v in plan.items() if k not in ('delete', 'migrate', 'trees', 'keys', 'groups')}}
        if args.plan_out:
            with open(args.plan_out, 'w') as handle:
                json.dump({**summary, 'inputs': inputs, **{k: plan[k] for k in ('delete', 'migrate', 'trees', 'keys')}}, handle, indent=1)
        status = 0
        doomed, migrate = plan['delete'], plan['migrate']
        if unresolved and args.apply:
            summary['refused'] = 'a live head could not be resolved to a tree: nothing was changed'
            status = 1
        elif args.apply and (doomed or migrate) and before and not before_delete(before, args.plan_out, summary):
            summary['refused'] = 'the --before-delete command failed: nothing was changed'
            status = 1
        elif args.apply and (doomed or migrate):
            if args.remote:
                failed, gone, protected, migrated = apply_remote(args.repo, args.remote, migrate, doomed, plan['groups'])
            else:
                failed, gone, protected, migrated = [], set(doomed) | {old for old, _ in migrate}, set(), True
            if failed:
                summary['failed'] = failed
                status = 1
            if protected:
                summary['kept_by_protection'] = {'refs': len(protected), 'groups': sum(1 for g in plan['groups'] if protected & set(g)),
                                                 'why': 'the remote refused deleting their tags: they stay, each group whole'}
                print(f'evidence-gc: the remote\'s protection kept {len(protected)} refs of dead groups whole', file=sys.stderr)
            if migrated:  # the local refs follow exactly what the remote did
                apply_local(args.repo, migrate, gone)
                summary['applied'] = True
            summary['deleted_refs'] = len(gone)
        if status == 0 and plan['protected_records'] > retention['cap_records']:
            summary['alert'] = f'the live set ({plan["protected_records"]} records) is over the cap ({retention["cap_records"]}); nothing live was deleted'
            status = 3
        print(json.dumps(summary, indent=2))
        return status
    except Refused as error:
        print(f'evidence-gc: {error}', file=sys.stderr)
        return 2 if isinstance(error, Usage) else 1


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
