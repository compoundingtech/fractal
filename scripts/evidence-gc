#!/usr/bin/env python3
"""Garbage-collect the evidence records (tags and notes): keep what a run can still ask about, bound the rest, and report.

  scripts/evidence-gc [--repo .] [--remote origin] [--apply] [--fetch]
                      [--main origin/main] [--keep-main-days 3] [--grace-hours 24] [--soft 3000] [--cap 5000]
                      [--head COMMIT ...] [--heads-from FILE] [--github OWNER/NAME] [--policy-from REV]

Dry run by default: it reads the records in --repo (with --fetch it first fetches all of `refs/tags/evidence/*`,
`refs/notes/evidence/*` and `refs/notes/evidence-input/*` from the remote: this is the one tool that pays for the whole
namespace), prints what it would
do, and changes nothing. With --apply it migrates and deletes locally, and with --remote also on the remote
(EVIDENCE_PUSH_TOKEN, if set, is sent as an authorization header and never printed), in batches of at most 500 refs.

THE KEEP SET (a note applies to the exact tree it is about, so a superseded head's note is not needed):
  open-pr-head    records of the CURRENT head tree of each open pull request, and of each merge-queue tip while it is queued
                  (--head / --heads-from FILE, or --github OWNER/NAME to list them with `gh` and `git ls-remote`)
  main-window     records of the trees of main's first-parent commits of the last --keep-main-days
  input-key       an input-index ref (`refs/tags/evidence/input/<check>/<key>/<record>` or
                  `refs/notes/evidence-input/<check>/<key>/<record>`) whose key still equals the key a
                  protected head tree projects to for that check, so unchanged-input reuse keeps working. The index ref is what
                  keeps its record alive; index refs of any other key are removed.
Everything else is unprotected: kept for --grace-hours (a note written moments ago for a head the listing raced with), then deleted.
A record filed both as a tag and as a note (producers write both while gates on older bases read only notes) is one record: both
names get the same decision, and it counts once against --soft and --cap. If more records remain than --soft, the OLDEST
unprotected ones go first. Protected records are never deleted for size: if the protected set alone is over --cap the tool prints
it and exits 3 so a job summary or an alert shows it.

The FIRST LAYOUT (`refs/notes/evidence/<record>`, no tree in the name): its tree is read from the note. A protected one is MIGRATED
(the tree-prefixed ref `refs/notes/evidence/<tree>/<record>` is created, then the old name removed); an unprotected one is
deleted by the same rules. Refs that are not well-formed records, and everything outside the evidence namespaces, are never touched.

FAILS CLOSED: if a head commit named by --head/--github cannot be turned into a tree, --apply refuses to delete anything (exit 1).

  exit 0  done (or a dry run)    exit 1  a step failed or a head could not be resolved    exit 2  usage
  exit 3  the protected set alone exceeds --cap (nothing protected was deleted)
"""
import argparse
import base64
import collections
import datetime
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import time

sys.dont_write_bytecode = True

NOTES = 'refs/notes/evidence/'
INPUT_NOTES = 'refs/notes/evidence-input/'
TAGS = 'refs/tags/evidence/'
INPUT_TAGS = 'refs/tags/evidence/input/'
OID = re.compile(r'^(?:[0-9a-f]{40}|[0-9a-f]{64})$')
CHECK = re.compile(r'^[A-Za-z0-9._-]+$')
BATCH = 500


class Refused(Exception):
    pass


class Usage(Refused):
    pass


def git(repo, *args, stdin=None, header=None, check=True):
    clean = {k: v for k, v in os.environ.items() if not k.startswith('GIT_')}
    if header:
        clean.update(GIT_CONFIG_COUNT='1', GIT_CONFIG_KEY_0='http.extraheader', GIT_CONFIG_VALUE_0=header)  # in the environment: a process listing must not show it
    done = subprocess.run(['git', '-C', repo, '-c', 'core.hooksPath=/dev/null', *args], input=stdin, capture_output=True, timeout=1800,
                          env=dict(clean, GIT_NO_REPLACE_OBJECTS='1', GIT_TERMINAL_PROMPT='0', LC_ALL='C'))
    if check and done.returncode != 0:
        raise Refused(f'git {args[0]}: {done.stderr.decode(errors="replace").strip()[-300:]}')
    return done


def verifier_module():
    here = os.path.dirname(os.path.abspath(__file__))
    loader = importlib.machinery.SourceFileLoader('evidence_verify_for_gc', os.path.join(here, 'evidence-verify'))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


def read_refs(repo):
    """Every ref of the namespaces: (records, index) where record = (ref, oid, layout, tree or None, unix date) and index = (ref, check, key, oid)."""
    out = git(repo, 'for-each-ref', '--format=%(objectname) %(refname) %(committerdate:unix)', 'refs/tags/evidence', 'refs/notes/evidence',
              'refs/notes/evidence-input').stdout.decode()
    records, index = [], []
    for line in out.splitlines():
        oid, _, rest = line.partition(' ')
        name, _, date = rest.rpartition(' ')
        if not OID.match(oid) or not date.isdigit():
            continue
        if name.startswith(INPUT_TAGS) or name.startswith(INPUT_NOTES):
            parts = name[len(INPUT_TAGS if name.startswith(INPUT_TAGS) else INPUT_NOTES):].split('/')
            if len(parts) == 3 and CHECK.match(parts[0]) and OID.match(parts[1]) and parts[2] == oid:
                index.append((name, parts[0], parts[1], oid, int(date)))
        elif name.startswith(TAGS):
            parts = name[len(TAGS):].split('/')
            if len(parts) == 2 and OID.match(parts[0]) and parts[1] == oid:
                records.append((name, oid, 'tag', parts[0], int(date)))
        elif name.startswith(NOTES):
            parts = name[len(NOTES):].split('/')
            if len(parts) == 1 and parts[0] == oid:
                records.append((name, oid, 'legacy', None, int(date)))
            elif len(parts) == 2 and OID.match(parts[0]) and parts[1] == oid:
                records.append((name, oid, 'tree', parts[0], int(date)))
    return records, index


def note_trees(repo, ids):
    """{record id: the tree its note is about} read from each note commit's one-entry notes tree."""
    if not ids:
        return {}
    roots = git(repo, 'cat-file', '--batch-check=%(objectname)', stdin=''.join(f'{r}^{{tree}}\n' for r in ids).encode()).stdout.decode().split()
    raw = git(repo, 'cat-file', '--batch', stdin=''.join(f'{r}\n' for r in roots).encode()).stdout
    width = len(ids[0]) // 2
    found, position = {}, 0
    for record in ids:
        newline = raw.index(b'\n', position)
        header = raw[position:newline].split()
        if len(header) < 3 or header[1] == b'missing':
            position = newline + 1
            continue
        size = int(header[2])
        body = raw[newline + 1:newline + 1 + size]
        position = newline + 1 + size + 1
        names, cursor = [], 0
        while cursor < len(body):
            end = body.index(b'\0', cursor)
            names.append(body[cursor:end].split(b' ', 1)[1].decode(errors='replace'))
            cursor = end + 1 + width
        if len(names) == 1 and OID.match(names[0]):
            found[record] = names[0]
    return found


def head_trees(repo, commits):
    """(trees, unresolved): the tree of each protected head commit."""
    trees, unresolved = set(), []
    for commit in commits:
        done = git(repo, 'rev-parse', '--verify', '--quiet', f'{commit}^{{tree}}', check=False)
        tree = done.stdout.decode().strip()
        if done.returncode == 0 and OID.match(tree):
            trees.add(tree)
        else:
            unresolved.append(commit)
    return trees, unresolved


def main_trees(repo, main, days, now):
    since = now - int(days * 86400)
    if git(repo, 'rev-parse', '--verify', '--quiet', f'{main}^{{commit}}', check=False).returncode != 0:
        raise Refused(f'{main} does not name a commit')
    out = git(repo, 'log', '--first-parent', f'--since=@{since}', '--format=%T', main).stdout.decode().split()
    if not out:
        raise Refused(f'{main} has no commit in the last {days} days: refusing to treat every tree as old')
    return set(out)


def protected_keys(repo, trees, policy_text, repository):
    """{(check, key)} that a protected tree projects to, for every check whose policy declares inputs."""
    verifier = verifier_module()
    keys = set()
    try:
        checks = json.loads(policy_text)['checks']
    except (ValueError, KeyError, TypeError):
        return keys
    for check in checks:
        if not CHECK.match(check):
            continue
        try:
            rules = verifier.policy_rules(policy_text, check, repository)
        except Exception:  # a check whose policy does not parse protects no key
            continue
        if not rules or rules.get('inputs') is None:
            continue
        for tree in trees:
            try:
                key = verifier.project(repo, tree, rules['inputs'])
            except Exception:
                key = None
            if key:
                keys.add((check, key))
    return keys


def advertised_bytes(count_name_lengths):
    return sum(length + 41 + 2 for length in count_name_lengths)  # "<oid> <ref>\n" in a v0 advertisement (a close upper bound)


def plan(repo, args, heads, now, policy_text, repository):
    records, index = read_refs(repo)
    legacy_ids = [oid for _, oid, layout, _, _ in records if layout == 'legacy']
    legacy_tree = note_trees(repo, legacy_ids)
    heads_set, unresolved = head_trees(repo, heads)
    main_set = main_trees(repo, args.main, args.keep_main_days, now)
    tip = git(repo, 'rev-parse', '--verify', '--quiet', f'{args.main}^{{tree}}', check=False).stdout.decode().strip()
    keys = protected_keys(repo, heads_set | ({tip} if OID.match(tip) else set()), policy_text, repository) if policy_text else set()
    grace_cutoff = now - int(args.grace_hours * 3600)
    # One record may have several names (its tag, its note, a first-layout note): they share a unit, which is what is counted.
    unit_of = {ref: ('record', oid) for ref, oid, _, _, _ in records}
    unit_of.update({ref: ('index', check, key, oid) for ref, check, key, oid, _ in index})
    protected_units = set()
    reasons = collections.Counter()
    delete, migrate, keep_unprotected = [], [], []  # delete: (ref, date); migrate: (old ref, new ref)
    protected_refs = 0
    seen_new = {ref for ref, _, layout, _, _ in records if layout == 'tree'}
    for ref, oid, layout, tree, date in records:
        tree = tree or legacy_tree.get(oid)
        if tree is None:
            reasons['kept: no readable tree'] += 1
            protected_refs += 1
            protected_units.add(unit_of[ref])
            continue
        why = 'open-pr-head' if tree in heads_set else 'main-window' if tree in main_set else None
        if why:
            reasons[f'kept: {why}'] += 1
            protected_refs += 1
            protected_units.add(unit_of[ref])
            if layout == 'legacy':
                new = f'{NOTES}{tree}/{oid}'
                if new in seen_new:
                    delete.append((ref, date))  # already filed under its tree: the old name is only a duplicate
                    reasons['deleted: first-layout duplicate of a tree-prefixed ref'] += 1
                    protected_refs -= 1
                else:
                    migrate.append((ref, new))
                    reasons['migrated: first layout to tree-prefixed'] += 1
            continue
        if date >= grace_cutoff:
            keep_unprotected.append((ref, date))
            reasons['kept: grace'] += 1
        else:
            delete.append((ref, date))
            reasons['deleted: unprotected' + (' (first layout)' if layout == 'legacy' else '')] += 1
    for ref, check, key, oid, date in index:
        if (check, key) in keys:
            reasons['kept: input-key'] += 1
            protected_refs += 1
            protected_units.add(unit_of[ref])
        elif date >= grace_cutoff:
            keep_unprotected.append((ref, date))
            reasons['kept: grace'] += 1
        else:
            delete.append((ref, date))
            reasons['deleted: input-key no longer used'] += 1
    deleted = {ref for ref, _ in delete}
    records_after = len({unit_of[ref] for ref in unit_of if ref not in deleted})  # a migration renames a ref: the count is unchanged
    evicted = []
    if records_after > args.soft:
        groups = {}
        for ref, date in keep_unprotected:
            groups.setdefault(unit_of[ref], []).append((ref, date))
        for unit, names in sorted(groups.items(), key=lambda item: (min(date for _, date in item[1]), item[0])):
            if records_after <= args.soft:
                break
            if unit in protected_units:
                continue
            evicted += names
            records_after -= 1
        reasons['deleted: over the soft limit (oldest first)'] += len(evicted)
    names_before = [len(r[0]) for r in records] + [len(i[0]) for i in index]
    doomed = {ref for ref, _ in delete} | {ref for ref, _ in evicted}
    names_after = [len(r[0]) for r in records if r[0] not in doomed] + [len(i[0]) for i in index if i[0] not in doomed]
    summary = {'refs_before': len(names_before), 'refs_after': len(names_after), 'records_before': len(set(unit_of.values())),
               'records_after': records_after, 'advertised_bytes_before': advertised_bytes(names_before),
               'advertised_bytes_after': advertised_bytes(names_after), 'reasons': dict(sorted(reasons.items())), 'protected_refs': protected_refs,
               'protected_records': len(protected_units),
               'soft': args.soft, 'cap': args.cap, 'unresolved_heads': unresolved,
               'protected_trees': {'open_pr_heads': len(heads_set), 'main_window': len(main_set)}}
    return summary, sorted(doomed), migrate


def header_for_token():
    token = os.environ.get('EVIDENCE_PUSH_TOKEN', '')
    return token, ('Authorization: Basic ' + base64.b64encode(f'x-access-token:{token}'.encode()).decode() if token else None)


def apply_remote(repo, remote, migrate, doomed):
    token, header = header_for_token()
    failed = []

    def push(refspecs):
        for start in range(0, len(refspecs), BATCH):
            done = git(repo, 'push', '--porcelain', remote, *refspecs[start:start + BATCH], header=header, check=False)
            if done.returncode != 0:
                text = (done.stdout + done.stderr).decode(errors='replace')
                failed.append((text.replace(token, '***') if token else text).strip()[-300:])
    # Create the new names first, so a failure leaves both and loses nothing; then remove everything doomed and the old names.
    push([f'{old}:{new}' for old, new in migrate])
    if not failed:
        push([f':{ref}' for ref in doomed] + [f':{old}' for old, _ in migrate])
    return failed


def apply_local(repo, migrate, doomed):
    commands = ''.join(f'create {new} {git(repo, "rev-parse", old).stdout.decode().strip()}\n' for old, new in migrate)
    commands += ''.join(f'delete {ref}\n' for ref in doomed)
    commands += ''.join(f'delete {old}\n' for old, _ in migrate)
    git(repo, 'update-ref', '--stdin', stdin=f'start\n{commands}prepare\ncommit\n'.encode())
    git(repo, 'pack-refs', '--all')


def github_heads(repo, repository, remote):
    """(commits, errors): same-repository open pull request heads and merge-queue tips, fetched so their trees exist locally."""
    listing = subprocess.run(['gh', 'api', '--paginate', f'repos/{repository}/pulls?state=open&per_page=100', '--jq', '.[] | select(.head.repo.full_name == "' + repository + '") | .head.sha'],
                             capture_output=True, text=True, timeout=300)
    if listing.returncode != 0:
        raise Refused(f'could not list open pull requests: {listing.stderr.strip()[-200:]}')
    commits = [line for line in listing.stdout.split() if OID.match(line)]
    queue = git(repo, 'ls-remote', remote, 'refs/heads/gh-readonly-queue/*').stdout.decode().split('\n')
    commits += [line.split()[0] for line in queue if line.strip() and OID.match(line.split()[0])]
    commits = list(dict.fromkeys(commits))
    for start in range(0, len(commits), 50):
        git(repo, 'fetch', '--no-tags', '--depth=1', '--filter=blob:none', '-q', remote, *commits[start:start + 50], check=False)
    return commits


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('--repo', default='.')
    parser.add_argument('--remote')
    parser.add_argument('--apply', action='store_true')
    parser.add_argument('--fetch', action='store_true', help='first fetch every note and the main window from --remote')
    parser.add_argument('--main', default='origin/main')
    parser.add_argument('--keep-main-days', type=float, default=3.0)
    parser.add_argument('--grace-hours', type=float, default=24.0)
    parser.add_argument('--soft', type=int, default=3000)
    parser.add_argument('--cap', type=int, default=5000)
    parser.add_argument('--head', action='append', default=[])
    parser.add_argument('--heads-from')
    parser.add_argument('--github', metavar='OWNER/NAME')
    parser.add_argument('--policy-from', help='revision whose .st/evidence-skip-policy.json says which checks have inputs (default --main)')
    parser.add_argument('--now', type=int, default=None, help='unix time (tests)')
    try:
        args = parser.parse_args(argv)
    except SystemExit as error:
        return 2 if error.code else 0
    if args.keep_main_days < 1 or args.grace_hours < 0 or args.soft < 1 or args.cap < args.soft:
        print('evidence-gc: bad --keep-main-days, --grace-hours, --soft or --cap', file=sys.stderr)
        return 2
    now = args.now if args.now is not None else int(time.time())
    try:
        if args.fetch:
            if not args.remote:
                raise Refused('--fetch needs --remote')
            token, header = header_for_token()
            git(args.repo, 'fetch', '--no-tags', '-q', args.remote, f'+{TAGS}*:{TAGS}*', f'+{NOTES}*:{NOTES}*', f'+{INPUT_NOTES}*:{INPUT_NOTES}*', header=header)
            remote_main = args.main.split('/', 1)[-1]
            git(args.repo, 'fetch', '--no-tags', '-q', '--filter=tree:0', f'--shallow-since={int(args.keep_main_days) + 1}.days.ago', args.remote, f'+refs/heads/{remote_main}:refs/remotes/{args.main}')
        heads = list(args.head)
        if args.heads_from:
            with open(args.heads_from) as handle:
                heads += [line.strip() for line in handle if line.strip()]
        if args.github:
            heads += github_heads(args.repo, args.github, args.remote or 'origin')
        heads = [h for h in dict.fromkeys(heads)]
        if not all(OID.match(h) for h in heads):
            raise Refused('--head values must be full commit ids')
        if args.apply and not heads and not args.github:
            raise Usage('--apply needs the open pull request heads to protect: give --head, --heads-from or --github (an empty list would delete them)')
        repository = args.github or 'compoundingtech/smalltalk'
        policy = git(args.repo, 'show', f'{args.policy_from or args.main}:.st/evidence-skip-policy.json', check=False)
        policy_text = policy.stdout.decode() if policy.returncode == 0 else ''
        summary, doomed, migrate = plan(args.repo, args, heads, now, policy_text, repository)
        summary['mode'] = 'apply' if args.apply else 'dry-run'
        status = 0
        if summary['unresolved_heads'] and args.apply:
            summary['refused'] = 'a protected head could not be resolved to a tree: nothing was changed'
            status = 1
        elif args.apply and (doomed or migrate):
            failed = apply_remote(args.repo, args.remote, migrate, doomed) if args.remote else []
            if failed:
                summary['failed'] = failed
                status = 1
            else:
                apply_local(args.repo, migrate, doomed)
                summary['applied'] = True
        if status == 0 and summary['protected_records'] > args.cap:
            summary['alert'] = f'the protected set ({summary["protected_records"]} records) is over the cap ({args.cap}); nothing protected was deleted'
            status = 3
        print(json.dumps(summary, indent=2))
        return status
    except Refused as error:
        print(f'evidence-gc: {error}', file=sys.stderr)
        return 2 if isinstance(error, Usage) else 1


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
