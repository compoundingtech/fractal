#!/usr/bin/env bash
# Client, shared-view and iOS checks over the root workspace's frozen installation
# (`pnpm install --frozen-lockfile`).
set -euo pipefail
cd "$(dirname "$0")/.."

pnpm --filter @fractal/client test
pnpm --filter @fractal/client typecheck
pnpm --filter @fractal/views test
pnpm --filter @fractal/views typecheck
pnpm --filter fractal-ios-starter exec tsc --noEmit -p .
pnpm --filter fractal-ios-starter test
