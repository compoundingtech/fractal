#!/usr/bin/env python3
"""Move the rolling `edge` pre-release to a main commit whose release archives are verified.

Usage: scripts/release-fractal-edge --source SHA --dist DIRECTORY [--run-url URL] [--dry-run]
Environment: GH_TOKEN and GH_REPO (as for gh). Run from a full-history checkout with tags.
Needs contents: write.

There is one release, tagged `edge`, never one per commit. Each call replaces its assets with the
archives, checksums and RELEASE.json of SOURCE, rewrites its notes with the commits since the
previous edge, and moves the tag to SOURCE. It is a pre-release, so `latest` and the daily
versioned release (which reads the latest release) ignore it. Publication only moves forward from
both the current tag and manifest; equal-source retries finish interrupted cleanup and notes.
"""
import argparse
import base64
import hashlib
import json
import os
import pathlib
import re
import subprocess
import sys
import tempfile

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from release_gh import gh as gh_call, missing  # noqa: E402

TAG = 'edge'
SHA = re.compile(r'[0-9a-f]{40}')
LISTED = 30


def run(*cmd, cwd=None, check=True, env=None):
    done = subprocess.run(cmd, check=False, text=True, capture_output=True, cwd=cwd, env=env)
    if check and done.returncode != 0:
        raise SystemExit(f'release-fractal-edge: {" ".join(cmd[:3])} failed: {done.stderr.strip() or done.stdout.strip()}')
    return done


def say(message):
    print(f'release-fractal-edge: {message}', flush=True)


def gh(*args, **options):
    """A GitHub call that survives a 5xx or a timeout (scripts/release_gh.py)."""
    return gh_call(*args, step='release-fractal-edge', **options)



def is_ancestor(repo, older, newer):
    result = run('git', 'merge-base', '--is-ancestor', older, newer, cwd=repo, check=False)
    if result.returncode not in (0, 1):
        raise SystemExit('release-fractal-edge: ancestry lookup failed; refusing publication')
    return result.returncode == 0


def changelog(repo, previous, source):
    if previous is None:
        lines, heading = log(repo, source, '-n', str(LISTED + 1)), 'First edge release; the newest commits on main:'
    elif previous == source:
        return 'No change since the previous edge (a rerun of the same commit).'
    elif is_ancestor(repo, previous, source):
        lines, heading = log(repo, f'{previous}..{source}'), f'Changes since the previous edge (`{previous}`):'
    else:
        lines = log(repo, source, '-n', str(LISTED + 1))
        heading = f'The previous edge (`{previous}`) is not an ancestor of this commit; the newest commits on main:'
    extra = max(0, len(lines) - LISTED)
    body = '\n'.join(lines[:LISTED]) or '- (no commits)'
    return heading + '\n\n' + body + (f'\n- and {extra} more' if extra else '')


def log(repo, *revisions):
    out = run('git', 'log', '--first-parent', '--format=- %s (`%h`)', *revisions, cwd=repo).stdout
    return out.splitlines()


def notes(source, previous, repo, run_url):
    text = ['Rolling pre-release built from the newest green `main` commit. Each update replaces the',
            'assets below; use a `v` release for a fixed version. Install with `install.sh --edge`.', '',
            f'Exact source: `{source}`.' + (f' Built by {run_url}.' if run_url else ''), '',
            changelog(repo, previous, source), '']
    return '\n'.join(text)


def assets_in(dist):
    names = sorted(p.name for pattern in ('*.tar.gz', '*.sha256') for p in dist.glob(pattern))
    names += ['SHA256SUMS', 'RELEASE.json']
    missing = [n for n in names if not (dist / n).is_file()]
    if missing or not any(n.endswith('.tar.gz') for n in names):
        raise SystemExit(f'release-fractal-edge: {dist} lacks release files: {missing or ["*.tar.gz"]}')
    return names


def release_assets(repository):
    """The edge release's asset names, or None when there is no edge release. Any other failure,
    after retries, ends the step: an unreadable release is not an absent one."""
    done = gh('release', 'view', TAG, '--repo', repository, '--json', 'assets', check=False)
    if missing(done):
        return None
    if done.returncode != 0:
        raise SystemExit(f'release-fractal-edge: reading the {TAG} release failed: {done.stderr.strip()}')
    return {a['name'] for a in json.loads(done.stdout)['assets']}


def tag_target(repository):
    """Return the observed ref object SHA and its peeled commit SHA."""
    done = gh('api', f'repos/{repository}/git/ref/tags/{TAG}', check=False)
    if missing(done):
        return None, None
    if done.returncode != 0:
        raise SystemExit(f'release-fractal-edge: reading the {TAG} tag failed: {done.stderr.strip()}')
    ref = json.loads(done.stdout)['object']
    if ref['type'] == 'commit':
        return ref['sha'], ref['sha']
    return ref['sha'], json.loads(gh('api', f'repos/{repository}/git/tags/{ref["sha"]}').stdout)['object']['sha']


def tag_commit(repository):
    return tag_target(repository)[1]


def manifest_source(repository, assets):
    if not assets or 'RELEASE.json' not in assets:
        return None
    done = gh('release', 'download', TAG, '--repo', repository, '--pattern', 'RELEASE.json', '--output', '-')
    source = json.loads(done.stdout)['source']
    if not SHA.fullmatch(source):
        raise SystemExit('release-fractal-edge: invalid source in edge RELEASE.json')
    return source


def stale(repo, source, tag, manifest):
    revisions = sorted({value for value in (source, tag, manifest) if value})
    shallow = run('git', 'rev-parse', '--is-shallow-repository', cwd=repo).stdout.strip() == 'true'
    run('git', 'fetch', '--no-tags', *(['--unshallow'] if shallow else []), 'origin', *revisions, cwd=repo)
    return any(value and not is_ancestor(repo, value, source) for value in (tag, manifest))


def download_asset(repository, name, path):
    gh('release', 'download', TAG, '--repo', repository, '--pattern', name,
       '--output', str(path), '--clobber')
    return hashlib.sha256(path.read_bytes()).digest()


def ledger_entries(path, names):
    try:
        entries = {}
        for line in path.read_text().splitlines():
            digest, name = line.split('  ', 1)
            if name in entries or not re.fullmatch(r'[0-9a-f]{64}', digest):
                return None
            entries[name] = bytes.fromhex(digest)
        return entries if set(entries) == set(names) else None
    except (UnicodeError, ValueError):
        return None


def publish_assets(repository, dist, names, source, existing):
    # Source markers alone do not prove aliases survived an interrupted clobber.
    # Keep staged bytes until every fixed asset has been compared and repaired.
    with tempfile.TemporaryDirectory(prefix='fractal-edge-assets-') as directory:
        root = pathlib.Path(directory)
        staged = {name: root / f'{source}-{name}' for name in names}
        ledger = root / f'{source}-STAGING-LEDGER.sha256'
        complete = ledger.name in existing and all(path.name in existing for path in staged.values())
        expected = None
        if complete:
            download_asset(repository, ledger.name, ledger)
            expected = ledger_entries(ledger, names)
            if expected is not None:
                for name, path in staged.items():
                    if download_asset(repository, path.name, path) != expected[name]:
                        expected = None
                        break
        if expected is None:
            # A partial or corrupt set cannot be mixed with a different build of this
            # same source. Replace the entire unit from the already validated dist.
            expected = {}
            for name, path in staged.items():
                if path.exists():
                    path.unlink()
                path.symlink_to(dist / name)
                expected[name] = hashlib.sha256(path.read_bytes()).digest()
            gh('release', 'upload', TAG, '--repo', repository, '--clobber',
               *(str(path) for path in staged.values()))
            ledger.write_text(''.join(f'{expected[name].hex()}  {name}\n' for name in names))
            # This distinct ledger, not public SHA256SUMS, commits the complete staged
            # unit and is always uploaded alone after every staged payload has landed.
            gh('release', 'upload', TAG, '--repo', repository, '--clobber', str(ledger))
            for name, path in staged.items():
                if download_asset(repository, path.name, root / f'checked-{name}') != expected[name]:
                    raise SystemExit(f'release-fractal-edge: staged asset verification failed for {name}')
        repaired = False
        for name in names:
            path = root / name
            actual = download_asset(repository, name, path) if name in existing else None
            # Republish the manifest last whenever any alias/checksum needed repair.
            if actual != expected[name] or (name == 'RELEASE.json' and repaired):
                if path.exists():
                    path.unlink()
                path.symlink_to(staged[name])
                gh('release', 'upload', TAG, '--repo', repository, '--clobber', str(path))
                repaired = True
            if download_asset(repository, name, root / f'verified-{name}') != expected[name]:
                raise SystemExit(f'release-fractal-edge: asset verification failed for {name}')


def main():
    parser = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    parser.add_argument('--source', required=True)
    parser.add_argument('--dist', required=True, type=pathlib.Path)
    parser.add_argument('--run-url', default='')
    parser.add_argument('--dry-run', action='store_true', help='verify and print the notes; publish nothing')
    args = parser.parse_args()
    repo = pathlib.Path(__file__).resolve().parent.parent
    repository = os.environ.get('GH_REPO', 'compoundingtech/fractal')
    if not SHA.fullmatch(args.source):
        raise SystemExit('release-fractal-edge: --source must be a full lowercase commit hash')

    dist = args.dist.resolve()
    names = assets_in(dist)
    # The checks the tag workflow makes, so edge carries only bytes that main already proved.
    run('sha256sum', '--check', 'SHA256SUMS', cwd=dist)
    say(run('python3', str(repo / 'scripts/release-fractal-manifest.py'), args.source, cwd=dist).stdout.strip())

    existing = release_assets(repository)
    previous = tag_commit(repository)
    published_source = manifest_source(repository, existing)
    if stale(repo, args.source, previous, published_source):
        say(f'edge has a newer or divergent source (tag {previous}, manifest {published_source}); leaving it unchanged')
        return 0
    body = notes(args.source, previous, repo, args.run_url)
    title = f'Fractal edge ({args.source[:9]})'
    if previous == published_source == args.source:
        metadata = json.loads(gh('release', 'view', TAG, '--repo', repository,
                                 '--json', 'body,name,isPrerelease').stdout)
        if (metadata['name'] == title and metadata['isPrerelease']
                and f'Exact source: `{args.source}`.' in metadata['body']):
            body = metadata['body']
    if args.dry_run:
        print(body)
        say(f'dry run: would publish {len(names)} assets as {TAG} at {args.source}')
        return 0

    notes_file = pathlib.Path(tempfile.mkdtemp(prefix='fractal-edge-')) / 'NOTES.md'
    notes_file.write_text(body)
    observed, commit = tag_target(repository)
    if commit != args.source:
        # Checkout does not persist credentials. Pass the job token only through
        # git's environment, never its command line or the remote URL.
        push_env = os.environ.copy()
        if token := push_env.get('GH_TOKEN'):
            index = int(push_env.get('GIT_CONFIG_COUNT', '0'))
            push_env.update({
                'GIT_CONFIG_COUNT': str(index + 1),
                f'GIT_CONFIG_KEY_{index}': 'http.https://github.com/.extraheader',
                f'GIT_CONFIG_VALUE_{index}': 'AUTHORIZATION: basic ' + base64.b64encode(
                    f'x-access-token:{token}'.encode()).decode(),
            })
        run('git', 'push', f'--force-with-lease=refs/tags/{TAG}:{observed or ""}',
            f'https://github.com/{repository}.git', f'{args.source}:refs/tags/{TAG}',
            cwd=repo, env=push_env)
    existing = release_assets(repository)
    if existing is None:
        # The leased tag move precedes every release mutation, including creation.
        gh('release', 'create', TAG, '--repo', repository, '--verify-tag', '--target', args.source, '--prerelease',
           '--latest=false', '--title', title, '--notes-file', str(notes_file),
           done=lambda: release_assets(repository) is not None)
        say(f'created the {TAG} pre-release')
        existing = release_assets(repository) or set()
    publish_assets(repository, dist, names, args.source, existing)
    for leftover in sorted((release_assets(repository) or set()) - set(names)):
        gh('release', 'delete-asset', TAG, leftover, '--repo', repository, '--yes',
           done=lambda leftover=leftover: leftover not in (release_assets(repository) or set()))
    gh('release', 'edit', TAG, '--repo', repository, '--prerelease', '--latest=false', '--title', title,
       '--notes-file', str(notes_file))

    final = tag_commit(repository)
    published = release_assets(repository)
    final_source = manifest_source(repository, published)
    metadata = json.loads(gh('release', 'view', TAG, '--repo', repository,
                             '--json', 'body,name,isPrerelease').stdout)
    if metadata['body'] != body or metadata['name'] != title or not metadata['isPrerelease']:
        raise SystemExit('release-fractal-edge: release notes verification failed')
    if final != args.source or published != set(names) or final_source != args.source:
        raise SystemExit(f'release-fractal-edge: {TAG} is at {final} with assets {sorted(published or [])}, '
                         f'expected {args.source} with {names}')
    say(f'{TAG} now at {args.source} with {len(names)} assets')
    return 0


if __name__ == '__main__':
    sys.exit(main())
