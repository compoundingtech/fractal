#!/usr/bin/env python3
"""Main requires exact-attempt hosted push checks, never borrowed queue or PR proof."""
import copy
import importlib.machinery
import importlib.util
import os
from pathlib import Path
import re
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
sys.dont_write_bytecode = True
loader = importlib.machinery.SourceFileLoader('check_main_ci', str(ROOT / 'scripts/check-main-ci'))
spec = importlib.util.spec_from_loader(loader.name, loader)
module = importlib.util.module_from_spec(spec)
loader.exec_module(module)
module.WAIT_ATTEMPTS = 2
module.time.sleep = lambda seconds: None
SHA = 'a' * 40
run = dict(head_sha=SHA, event='push', path='.github/workflows/fleet.yml',
           status='completed', conclusion='success', head_branch='main', run_number=1,
           id=1, run_attempt=2, html_url='https://github.com/example/project/actions/runs/1')
jobs = [dict(name=name, conclusion='success', head_sha=SHA) for name in sorted(module.REQUIRED)]


def check(name, runs, results, expected):
    def api(path):
        if '/actions/workflows/' in path:
            assert f'event=push&head_sha={SHA}' in path
            return [{'workflow_runs': []}, {'workflow_runs': runs}]
        assert '/runs/1/attempts/2/jobs?per_page=100' in path, path
        return [{'jobs': results[:1]}, {'jobs': results[1:]}]
    module.api = api
    with tempfile.TemporaryDirectory() as tmp:
        os.environ.update(GITHUB_REPOSITORY='example/project', GITHUB_SHA=SHA,
                          GITHUB_STEP_SUMMARY=str(Path(tmp) / 'summary'))
        assert module.main() == expected, name
        summary = Path(os.environ['GITHUB_STEP_SUMMARY'])
        assert summary.exists() == (expected == 0), name
    print('passed:', name)


assert module.REQUIRED == {'linux-test-build', 'linux-clippy', 'linux-fleet-compat'}
check('exact push attempt and paginated jobs', [run], jobs, 0)
check('no push run times out without success', [], jobs, 1)
for field, value in [('head_sha', 'b' * 40), ('event', 'merge_group'), ('event', 'pull_request'),
                     ('path', '.github/workflows/other.yml'), ('head_branch', 'feature')]:
    check('reject ' + field + '=' + value, [{**run, field: value}], jobs, 1)
for conclusion in ('failure', 'cancelled', 'skipped', 'neutral', None):
    changed = copy.deepcopy(jobs)
    changed[0]['conclusion'] = conclusion
    check('reject required conclusion ' + str(conclusion), [run], changed, 1)
check('reject missing required job', [run], jobs[:-1], 1)
check('reject duplicate required job', [run], jobs + [jobs[0]], 1)
changed = copy.deepcopy(jobs)
changed[0]['head_sha'] = 'b' * 40
check('reject wrong-SHA required job', [run], changed, 1)
for conclusion in ('failure', 'cancelled', None):
    check('advisory outcome does not change fast-lane proof ' + str(conclusion),
          [{**run, 'conclusion': conclusion, 'status': 'in_progress'}],
          jobs + [dict(name='linux-gate', conclusion=conclusion, head_sha=SHA)], 0)
# A prior successful attempt cannot override the selected current attempt's red job.
check('latest attempt owns proof', [{**run, 'run_attempt': 1}, run],
      [dict(job, conclusion='failure') for job in jobs], 1)
# Run creation and pending jobs are expected while Main upkeep and Workspace start concurrently.
polls = []
def pending_api(path):
    if '/actions/workflows/' in path:
        polls.append(path)
        return [{'workflow_runs': [] if len(polls) == 1 else [run]}]
    return [{'jobs': jobs}]
module.api = pending_api
with tempfile.TemporaryDirectory() as tmp:
    os.environ['GITHUB_STEP_SUMMARY'] = str(Path(tmp) / 'summary')
    assert module.main() == 0 and len(polls) == 2
print('passed: wait for concurrently created exact push run')

fleet = (ROOT / '.github/workflows/fleet.yml').read_text()
upkeep = (ROOT / '.github/workflows/main-upkeep.yml').read_text()
trigger = fleet.split('\non:\n', 1)[1].split('\npermissions:', 1)[0]
assert all(event + ':' in trigger for event in ('push', 'merge_group', 'pull_request'))
assert re.search(r'push:\n\s+branches: \[main\]', trigger)
assert not re.search(r'^  proof-', upkeep, re.M), 'Workspace push is the only hosted proof graph'
assert 'Await required hosted main push checks' in upkeep
assert 'timeout-minutes: 125' in upkeep
assert 'main is red; revert the merged change.' in upkeep
assert 'github.run_id' in upkeep.split('concurrency:', 1)[1].split('jobs:', 1)[0]


def job_blocks(text):
    text = text.split('\njobs:\n', 1)[1]
    starts = list(re.finditer(r'^  ([\w-]+):\n', text, re.M))
    return {match[1]: text[match.end():starts[i + 1].start() if i + 1 < len(starts) else len(text)]
            for i, match in enumerate(starts)}


blocks = job_blocks(fleet)
for index, name in enumerate(('linux-tests', 'linux-tests-shard-2', 'linux-tests-shard-3', 'linux-tests-shard-4'), 1):
    assert f'hash:{index}/4' in blocks[name], name
    if index <= 2:
        partition = next(line for line in blocks[name].splitlines() if 'CI_TEST_PARTITION:' in line)
        assert "github.event_name == 'push'" in partition and "refs/heads/main" in partition, name
    else:
        condition = re.search(r'^    if: (.*)$', blocks[name], re.M)[1]
        assert "github.event_name == 'push'" in condition and "refs/heads/main" in condition, name
assert '[ "$EVENT" = merge_group ] || [ "$EVENT" = push ]' in blocks['linux-gate']
assert "github.event.before" in blocks['upgrade-impact']
topology = next(line for line in blocks['evidence-note-rust-tests'].splitlines() if 'CI_TEST_TOPOLOGY:' in line)
assert "github.event_name == 'push' && github.ref == 'refs/heads/main' && 'merge-group' || ''" in topology
# Queue observer remains queue-only; push proof never waits for or cancels an ephemeral queue ref.
assert "if: github.event_name == 'merge_group'" in blocks['namespace-capacity']
print('passed: canonical main push graph, four partitions, exact base and no duplicate projection')
