[Unit]
Description=Shadow merge-queue signer, observe: record the queue's entries, the predicted tree and the queue's own results (scripts/evidence-queue-signer)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/run/current-system/sw/bin:/usr/bin:/bin
# Settings only (EVIDENCE_QUEUE_*, EVIDENCE_PRESIGN_*); no token, password or other secret.
EnvironmentFile=-%h/.config/evidence-queue-signer/env
ExecStart=/usr/bin/env bash %h/.local/bin/evidence-queue-timer observe
TimeoutStartSec=10min
