#!/usr/bin/env bash
# The fractal-web execution lanes, run inside `nix develop .#web`. Each lane is timed into the
# job summary. Packages that join the workspace add their lanes here.
set -euo pipefail
cd "$(dirname "$0")/.."

summary=${GITHUB_STEP_SUMMARY:-/dev/null}
printf '| Lane | Elapsed |\n| --- | --- |\n' >> "$summary"
lane() {
  local name=$1 start=$SECONDS
  shift
  echo "::group::$name"
  "$@"
  echo "::endgroup::"
  printf '| %s | %ss |\n' "$name" "$((SECONDS - start))" >> "$summary"
}

toolchain() {
  [ "$(pnpm --version)" = 12.7.0 ] || { echo "pnpm $(pnpm --version) is not 12.7.0" >&2; return 1; }
  [ "$(node --version)" = v24.20.0 ] || { echo "Node $(node --version) is not 24.20.0" >&2; return 1; }
  grep -q '"packageManager": "pnpm@12.7.0"' package.json || { echo 'package.json must declare pnpm@12.7.0' >&2; return 1; }
  # The checked-in Buck root is the Nix-rendered consumer root below Genie's three-line header.
  [ -n "${FRACTAL_WEB_BUCK_ROOT:-}" ] || { echo 'run inside nix develop .#web' >&2; return 1; }
  [ ! -s .buckroot ] || { echo '.buckroot must be empty' >&2; return 1; }
  local file expected
  for file in .buckconfig BUCK buck2/toolchains/BUCK; do
    expected="$FRACTAL_WEB_BUCK_ROOT/$file"
    if ! tail -n +4 "$file" | head -c "$(wc -c < "$expected")" | cmp -s - "$expected"; then
      echo "$file no longer starts with the mkConsumerBuckRoot rendering; regenerate buck2/root.ts from $expected" >&2
      return 1
    fi
  done
  pnpm --version && node --version && buck2 --version
}

production_build() (
  local out_dir
  out_dir=$(mktemp -d "${TMPDIR:-/tmp}/fractal-web-build.XXXXXX")
  trap 'rm -rf "$out_dir"' EXIT
  pnpm --dir apps/fractal-web exec vite build --config vite.config.ts --configLoader runner --outDir "$out_dir"
)


kit_receipt_dir=${KIT_RECEIPT_DIRECTORY:-${RUNNER_TEMP:-${TMPDIR:-/tmp}}/kit-play-receipts}

kit_storybook() (
  # The module graph proves every bundled repository file is a declared kit input. The build's
  # seconds go to this shard's strict-play receipt, which reports the duplicated build cost.
  local stats_dir start=$SECONDS
  stats_dir=$(mktemp -d "${TMPDIR:-/tmp}/fractal-kit-stats.XXXXXX")
  trap 'rm -rf "$stats_dir"' EXIT
  pnpm --filter @fractal/ui build-storybook --stats-json "$stats_dir"
  mkdir -p "$kit_receipt_dir"
  echo "$((SECONDS - start))" > "$kit_receipt_dir/storybook-build-seconds"
  python3 scripts/ci-fractal-web-kit-graph "$stats_dir/preview-stats.json"
)

kit_plays() (
  mkdir -p "$kit_receipt_dir"
  # Sharding is scoped to the kit invocation, and only KIT_PLAY_SET=all is sharded.
  KIT_STORYBOOK_BUILD_SECONDS=$(cat "$kit_receipt_dir/storybook-build-seconds" 2>/dev/null || echo 0) \
  KIT_PLAY_SHARD_INDEX=${KIT_SHARD_INDEX:-0} KIT_PLAY_SHARD_COUNT=${KIT_SHARD_COUNT:-1} \
    node packages/fractal-ui/scripts/kit-play-gate.mjs packages/fractal-ui/storybook-static "$kit_receipt_dir"
)
# The four lightweight streams share the runner's four vCPUs; print each stream's output whole
# once all have finished. Kit browser controls and Storybook run afterwards so they cannot
# contend with the scenario, app or SDK tests. The play gate saturates every vCPU and the
# frame CPU budgets measure CPU time, so those also run alone.
run_streams() {
  local logs name pid status=0 stream_started=$SECONDS
  logs=$(mktemp -d "${TMPDIR:-/tmp}/fractal-web-streams.XXXXXX")
  local -a names=() pids=()
  for name in "$@"; do
    ( set -e; "$name" ) > "$logs/$name.log" 2>&1 &
    names+=("$name") pids+=($!)
  done
  for index in "${!pids[@]}"; do
    pid=${pids[$index]}
    wait "$pid" || { status=1; echo "::error::stream ${names[$index]} failed"; }
  done
  for name in "${names[@]}"; do
    echo "::group::stream $name"
    cat "$logs/$name.log"
    echo "::endgroup::"
  done
  rm -rf "$logs"
  printf '| streams %s | %ss |\n' "${names[*]}" "$((SECONDS - stream_started))" >> "$summary"
  return "$status"
}

stream_scenarios() {
  lane "Scenario typecheck" pnpm --filter @fractal/scenarios typecheck
  lane "Scenario tests" pnpm --filter @fractal/scenarios test
  lane "Scenario freshness" pnpm --filter @fractal/scenarios emit:check
  lane "Scenario privacy" pnpm --filter @fractal/scenarios scan
}

stream_checks() {
  lane "Dependency licenses" python3 scripts/ci-fractal-web-licenses --check
  lane "Buck typecheck" buck2 build //:typecheck
  lane "Scenario decode" pnpm --filter @fractal/scenarios decode
  lane "Measurement contracts" node --experimental-strip-types --test apps/fractal-web/src/telemetry/measurement/measurement.node-test.ts
  lane "Measurement bundle exclusion" bun apps/fractal-web/src/telemetry/measurement/check-bundles.mjs
  lane "Synthetic fixtures" bash apps/fractal-web/scripts/ci/fixtures-gate.sh
  lane "Extension registry" node --experimental-strip-types --test apps/fractal-web/src/extensions/registry.unit.test.ts
  lane "Folders core" node --test apps/fractal-web/src/folders/core.node-test.mjs
  lane "SDK typecheck" pnpm --filter @fractal/sdk typecheck
  lane "SDK unit tests" pnpm --dir packages/fractal-sdk exec vitest run --config vitest.config.ts
}

stream_app() {
  lane "App typecheck" pnpm --filter fractal-web typecheck
  lane "CSS asset guard" node --test apps/fractal-web/scripts/vite-css-assets.node-test.mjs
  lane "App production build" production_build
  lane "App unit test selection" node --test apps/fractal-web/scripts/ci/unit-tests.node-test.mjs
  # Pull requests run the tests that import a changed file; other events run all of them.
  lane "App unit tests" node apps/fractal-web/scripts/ci/unit-tests.mjs
}

# --- kit lane selection
# Merge groups shard the full kit play set (KIT_SHARD_INDEX of KIT_SHARD_COUNT). Shard 0 runs every
# lane; the other shards run only the kit's Storybook build and their share of the strict plays.
first_shard() { [ "${KIT_SHARD_INDEX:-0}" -eq 0 ]; }

stream_kit() {
  if first_shard; then
    lane "UI kit typecheck" pnpm --filter @fractal/ui typecheck
    lane "UI kit scenario story check" pnpm --filter @fractal/ui test:stories
  fi
  case "${KIT_INPUTS:-true}" in
    true)
      lane "UI kit play index contracts" node --test packages/fractal-ui/scripts/kit-play-index.node-test.mjs
      ;;
    false)
      printf 'UI kit plays skipped: no kit inputs changed (%s..%s)\n' "${BASE_SHA:?}" "${HEAD_SHA:?}" | tee -a "$summary"
      ;;
    *)
      echo "::error::KIT_INPUTS must be true or false" >&2
      exit 1
      ;;
  esac
}

# Browser controls and builds must not overlap the timing-sensitive test streams.
exclusive_lanes() {
  if [ "${KIT_INPUTS:-true}" = true ]; then
    if first_shard; then
      lane "UI kit context isolation controls" node packages/fractal-ui/scripts/kit-play-isolation.browser-test.mjs
      lane "UI kit gate set, a11y and budget controls" node --test packages/fractal-ui/scripts/kit-play-gate.browser-test.mjs
    fi
    lane "UI kit Storybook and module graph" kit_storybook
  fi
  if first_shard; then
    # Replay covers the app even when no kit inputs changed; never duplicate it across kit shards.
    lane "App replay browser e2e" node apps/fractal-web/scripts/replay-e2e.mjs
    lane "SDK frame CPU budgets" pnpm --dir packages/fractal-sdk exec vitest run --config vitest.perf.config.ts
  fi
  if [ "${KIT_INPUTS:-true}" = true ]; then
    lane "UI kit strict plays (440/1440 × dark/light)" kit_plays
  fi
}
# --- end kit lane selection

lane "Toolchain and Buck root" toolchain
lane "Frozen install" pnpm install --frozen-lockfile
# Storybook imports the app changelog too, so every shard needs its generated registry.
lane "Changelog registry derives from its directory" bash -c 'node apps/fractal-web/scripts/changelog-registry.mjs && node apps/fractal-web/scripts/changelog-registry.mjs --check'
if first_shard; then
  run_streams stream_scenarios stream_checks stream_app stream_kit
else
  run_streams stream_kit
fi
exclusive_lanes
