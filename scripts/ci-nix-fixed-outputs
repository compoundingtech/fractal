#!/usr/bin/env bash
# Realise the fixed-output derivations fractal-web and the release build from, and prove their pinned hashes.
#
# A fixed-output path is named by its name and declared hash alone, so a store or binary cache that already holds it serves it
# without building, whatever the derivation's inputs became: a stale nix/typescript-client-deps.hash stayed green that way until
# a lockfile change renamed the path, and main could not release. So a path the store holds is trusted only when the derivation
# that produced it (its deriver) is this one; otherwise it is built again (`--rebuild`), and Nix compares the hash. A path the
# store lacks is built or substituted, and is checked the same way.
#
# Usage: scripts/ci-nix-fixed-outputs [INSTALLABLE...]   (default: this checkout's typescript-client installation)
set -euo pipefail
cd "$(dirname "$0")/.."
if [ "$#" -eq 0 ]; then
  system=$(nix eval --impure --raw --expr builtins.currentSystem)
  set -- ".#checks.$system.typescript-client.installation"
fi
for installable in "$@"; do
  paths=$(nix eval --raw "$installable" --apply 'd: d.drvPath + " " + d.outPath')
  drv=${paths% *} out=${paths#* }
  if ! nix-store --check-validity "$out" 2>/dev/null; then
    nix build --no-link "$installable"
  fi
  deriver=$(nix-store --query --deriver "$out")
  if [ "$deriver" = "$drv" ]; then
    echo "ci-nix-fixed-outputs: $out was built from this derivation"
    continue
  fi
  echo "ci-nix-fixed-outputs: $out came from $deriver, not $drv: building it again to check its hash"
  nix build --no-link --rebuild "$installable"
done
