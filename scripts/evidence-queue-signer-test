#!/usr/bin/env python3
"""scripts/evidence-queue-signer: what it records per merge-queue entry (group tree, merge-tree equality, a dropped entry, the
depth-1 prediction), which tree it signs (the prediction first, then the queue in order, our own authors only, never twice), how
it compares its notes with the queue's gate, and when it seeds main's per-crate notes (once per new tip, not beside another seed).
gh, fractal-test, the host's pressure files and its process list are stand-ins; nothing is signed."""
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time
import unittest

ROOT = Path(__file__).resolve().parent.parent
SIGNER = ROOT / 'scripts/evidence-queue-signer'
CLEAN = dict(PATH=os.environ['PATH'], GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_SYSTEM='/dev/null',
             GIT_AUTHOR_NAME='t', GIT_AUTHOR_EMAIL='t@example.invalid', GIT_COMMITTER_NAME='t', GIT_COMMITTER_EMAIL='t@example.invalid')
# The base's self-contained st-test: --list (two light checks, one heavy) and a run, recorded with the commit it ran on.
ST_TEST = '''#!/usr/bin/env python3
import json, os, subprocess, sys, time
argv = sys.argv[1:]
if '--list' in argv:
    for name in ['typescript-client', 'genie-freshness'] + (['linux-gate'] if '--all' in argv else []):
        print(f'{name}: command')
    sys.exit(0)
head = subprocess.run(['git', 'rev-parse', 'HEAD'], capture_output=True, text=True).stdout.strip()
tree = subprocess.run(['git', 'rev-parse', 'HEAD^{tree}'], capture_output=True, text=True).stdout.strip()
parents = subprocess.run(['git', 'rev-parse', 'HEAD^@'], capture_output=True, text=True).stdout.split()
checks = [argv[i + 1] for i, a in enumerate(argv) if a == '--check']
if '--seed' in argv:
    # --seed COMMIT: the per-crate rust-tests notes of that commit's tree, a row for the run and one per crate that did not sign.
    seed = argv[argv.index('--seed') + 1]
    with open(os.environ['STUB_LOG'], 'a') as log:
        log.write(json.dumps({'seed': seed, 'head': head, 'checks': checks}) + '\\n')
    stop = os.environ.get('STUB_SEED_STOP')
    if stop:
        # Load rises during the run, before or after nextest started: the watcher stops it.
        if stop == 'after':
            print('    Starting 3 tests across 1 binaries', flush=True)
        with open(os.environ['EVIDENCE_PRESIGN_PRESSURE'], 'w') as pressure:
            pressure.write('some avg10=40 avg60=40.00 avg300=40 total=1\\n')
        import time
        time.sleep(60)
    print('fractal-test: tree 0123456789ab (HEAD), in a clean worktree')
    print(f'  {"rust-tests":<20} {os.environ.get("STUB_SEED", "passed"):<12} {60:>6}s  2 of 2 crates run and signed')
    for crate in json.loads(os.environ.get('STUB_SEED_FAILED', '[]')):
        print(f'  {"rust-tests:" + crate:<20} {"FAILED (1)":<12} {0:>6}s  signer refused')
    sys.exit(0)
with open(os.environ['STUB_LOG'], 'a') as log:
    log.write(json.dumps({'head': head, 'tree': tree, 'parents': parents, 'checks': checks,
                          'target': os.environ.get('CARGO_TARGET_DIR')}) + '\\n')
results = json.loads(os.environ.get('STUB_RESULTS', '{}'))
time.sleep(float(os.environ.get('STUB_RUN_SECONDS', '0')))  # a run that outlives the watcher's one-second sample
if os.environ.get('STUB_PUSH_NOTES'):
    # A note per check, as evidence-wrap pushes it: a commit holding one file named after the tree, under refs/tags/evidence/TREE/.
    for name in checks:
        statement = {'predicate': {'observed_at': os.environ['STUB_PUSH_NOTES'], 'observed': {'checks': {name: {}}}}}
        blob = subprocess.run(['git', 'hash-object', '-w', '--stdin'], input=json.dumps(statement), capture_output=True,
                              text=True).stdout.strip()
        listing = subprocess.run(['git', 'mktree'], input=f'100644 blob {blob}\\t{tree}\\n', capture_output=True, text=True).stdout.strip()
        note = subprocess.run(['git', 'commit-tree', listing, '-m', 'st gate observation v1'], capture_output=True, text=True).stdout.strip()
        subprocess.run(['git', 'push', '-q', 'origin', f'{note}:refs/tags/evidence/{tree}/{name}'], check=True)
print('fractal-test: tree 0123456789ab (HEAD), in a clean worktree')
for name in checks:
    print(f'  {name:<20} {results.get(name, "passed"):<12} {60:>6}s  why')
'''
# gh: the merge queue, pull request authors, and the queue's runs and jobs, from one JSON file the test rewrites.
GH = '''#!/usr/bin/env python3
import json, os, sys
data = json.load(open(os.environ['STUB_GH']))
argv = sys.argv[1:]
path = argv[1] if len(argv) > 1 else ''
if argv[:2] == ['api', 'graphql']:
    print(json.dumps({'data': {'repository': {'mergeQueue': {'entries': {'nodes': data.get('queue', [])}}}}}))
elif '/pulls/' in path:
    print(json.dumps({'user': {'login': data.get('authors', {}).get(path.rsplit('/', 1)[1], 'ours')}}))
elif '/jobs' in path:
    print(json.dumps({'jobs': data.get('jobs', {}).get(path.split('/runs/')[1].split('/')[0], [])}))
elif '/actions/runs' in path:
    sha = path.split('head_sha=')[1].split('&')[0]
    print(json.dumps({'workflow_runs': data.get('runs', {}).get(sha, [])}))
else:
    sys.exit(f'unexpected gh {argv}')
'''


def git(repo, *args, env=None):
    done = subprocess.run(['git', '-C', str(repo), *args], capture_output=True, text=True, env=env or CLEAN)
    assert done.returncode == 0, (args, done.stderr)
    return done.stdout.strip()


class QueueSigner(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        tmp = Path(self.tmp.name)
        self.origin = tmp / 'origin.git'
        git(tmp, 'init', '-q', '--bare', '-b', 'main', str(self.origin))
        self.work = tmp / 'work'
        git(tmp, 'clone', '-q', str(self.origin), str(self.work))
        git(self.work, 'checkout', '-q', '-b', 'main')
        (self.work / 'scripts').mkdir()
        (self.work / 'scripts/st-test').write_text(ST_TEST)
        (self.work / 'a').write_text('a\n')
        git(self.work, 'add', '.')
        git(self.work, 'commit', '-q', '-m', 'base')
        git(self.work, 'push', '-q', 'origin', 'main')
        self.main = git(self.work, 'rev-parse', 'HEAD')
        self.config, self.state, self.presign = tmp / 'config', tmp / 'state', tmp / 'presign'
        self.config.mkdir()
        self.presign.mkdir()
        (self.presign / 'authors').write_text('ours\n')
        (self.presign / 'limits.json').write_text(json.dumps({'sample': 1}))
        (self.config / 'start.json').write_text(json.dumps({'min_free_gib': 0}))
        self.pressure, self.meminfo, self.proc = tmp / 'pressure', tmp / 'meminfo', tmp / 'proc'
        self.proc.mkdir()
        self.pressure.write_text('some avg10=1.00 avg60=2.00 avg300=1.00 total=1\nfull avg10=0 avg60=0 avg300=0 total=0\n')
        self.meminfo.write_text('MemTotal: 67108864 kB\nMemAvailable: 50331648 kB\n')
        (tmp / 'gh').write_text(GH)
        (tmp / 'gh').chmod(0o755)
        self.gh_data, self.log = tmp / 'gh.json', tmp / 'st-test.jsonl'
        self.gh = {'queue': [], 'authors': {}, 'runs': {}, 'jobs': {}}
        self.prs = {}

    def env(self, **extra):
        return dict(CLEAN, HOME=self.tmp.name, EVIDENCE_QUEUE_CONFIG=str(self.config), EVIDENCE_QUEUE_STATE=str(self.state),
                    EVIDENCE_PRESIGN_CONFIG=str(self.presign), EVIDENCE_PRESIGN_REMOTE=str(self.origin),
                    EVIDENCE_PRESIGN_PRESSURE=str(self.pressure), EVIDENCE_PRESIGN_MEMINFO=str(self.meminfo), EVIDENCE_PRESIGN_FREE_GIB='1000',
                    EVIDENCE_PRESIGN_ADMISSION='/nonexistent', EVIDENCE_QUEUE_PROC=str(self.proc), ST_TEST_POOL_MAX_GB='170', EVIDENCE_QUEUE_GH=str(Path(self.tmp.name) / 'gh'),
                    STUB_GH=str(self.gh_data), STUB_LOG=str(self.log), **extra)

    def run_signer(self, *args, **extra):
        self.gh_data.write_text(json.dumps(self.gh))
        repo = Path(self.tmp.name) / f'repo-{args[0]}'
        done = subprocess.run([sys.executable, '-I', str(SIGNER), *args, '--repo', str(repo), '--repository', 'o/r'],
                              capture_output=True, text=True, env=self.env(**extra))
        self.assertEqual(done.returncode, 0, done.stderr)
        return done

    def pull(self, number, name, author='ours'):
        """A pull request branched from main, with refs/pull/N/head on the origin."""
        git(self.work, 'checkout', '-q', '-B', f'pr{number}', self.main)
        (self.work / name).write_text(f'{number}\n')
        git(self.work, 'add', '.')
        git(self.work, 'commit', '-q', '-m', f'pr {number}')
        head = git(self.work, 'rev-parse', 'HEAD')
        git(self.work, 'push', '-q', 'origin', f'HEAD:refs/pull/{number}/head')
        self.prs[number] = head
        self.gh['authors'][str(number)] = author
        return head

    def enqueue(self, number, base, position, author='ours'):
        """GitHub's group commit: the PR head merged onto `base`, on a gh-readonly-queue branch."""
        git(self.work, 'checkout', '-q', '--detach', base)
        git(self.work, 'merge', '-q', '--no-ff', '-m', f'queue {number}', self.prs[number])
        group = git(self.work, 'rev-parse', 'HEAD')
        git(self.work, 'push', '-q', 'origin', f'HEAD:refs/heads/gh-readonly-queue/main/pr-{number}-{base[:8]}')
        self.gh['queue'].append({'position': position, 'state': 'AWAITING_CHECKS', 'enqueuedAt': '2026-10-23T10:00:00Z',
                                 'pullRequest': {'number': number, 'headRefOid': self.prs[number], 'author': {'login': author}},
                                 'headCommit': {'oid': group}, 'baseCommit': {'oid': base}})
        return group

    def leave(self, number, group, landed):
        """The entry leaves the queue: its branch is deleted; when it landed, main moves to the group commit."""
        self.gh['queue'] = [e for e in self.gh['queue'] if e['pullRequest']['number'] != number]
        for ref in git(self.origin, 'for-each-ref', '--format=%(refname)', 'refs/heads/gh-readonly-queue/').split():
            if f'pr-{number}-' in ref:
                git(self.origin, 'update-ref', '-d', ref)
        if landed:
            git(self.origin, 'update-ref', 'refs/heads/main', group)

    def queue_ran(self, group, run_id, gate_at, results):
        self.gh['runs'][group] = [{'id': run_id, 'status': 'completed'}]
        jobs = []
        for name, conclusion in results.items():
            jobs += [{'name': f'evidence-gate-{name}', 'started_at': gate_at, 'status': 'completed', 'conclusion': 'success'},
                     {'name': name, 'started_at': gate_at, 'status': 'completed', 'conclusion': conclusion}]
        self.gh['jobs'][str(run_id)] = jobs

    def state_now(self):
        return json.loads((self.state / 'entries.json').read_text())

    def lines(self, name):
        path = self.state / name
        return [json.loads(line) for line in path.read_text().splitlines()] if path.exists() else []

    def runs(self):
        return [json.loads(line) for line in self.log.read_text().splitlines()] if self.log.exists() else []

    def base_runners(self, runners):
        git(self.work, 'checkout', '-q', 'main')
        for name in ('fractal-test', 'st-test'):
            (self.work / 'scripts' / name).unlink(missing_ok=True)
        for name, source in runners.items():
            (self.work / 'scripts' / name).write_text(source)
        git(self.work, 'add', '-A')
        git(self.work, 'commit', '-q', '-m', 'base runners')
        git(self.work, 'push', '-q', 'origin', 'main')
        self.main = git(self.work, 'rev-parse', 'HEAD')

    def test_a_st_test_only_base_seeds_and_reads_the_old_summary_header(self):
        self.base_runners({'st-test': ST_TEST.replace('fractal-test: tree ', 'st-test: tree ')})
        self.run_signer('seed')
        self.assertEqual(len(self.runs()), 1)
        self.assertEqual(self.lines('seeds.jsonl')[0]['outcome'], 'seeded')

    def test_both_base_names_seed_with_st_test_not_the_python_shim(self):
        self.base_runners({'st-test': ST_TEST, 'fractal-test': 'raise RuntimeError("POISON: shim must not be copied")\n'})
        self.run_signer('seed')
        self.assertEqual(len(self.runs()), 1)
        self.assertEqual(self.lines('seeds.jsonl')[0]['outcome'], 'seeded')

    def test_a_seed_from_an_old_base_also_prevents_a_second_seed(self):
        (self.proc / '4242').mkdir()
        (self.proc / '4242/cmdline').write_bytes(b'python3\0-I\0/tmp/st-test\0--seed\0')
        self.run_signer('seed')
        self.assertEqual(self.runs(), [])

    def test_a_st_test_only_base_preserves_old_header_per_check_timing(self):
        self.base_runners({'st-test': ST_TEST.replace('fractal-test: tree ', 'st-test: tree ')})
        self.pull(1, 'one')
        self.enqueue(1, self.main, 1)
        self.run_signer('observe')
        self.run_signer('sign')
        [attempt] = self.lines('attempts.jsonl')
        self.assertEqual(attempt['stage_seconds'],
                         dict.fromkeys(['typescript-client', 'genie-freshness', 'linux-gate'], 60))

    def test_a_run_that_outlives_a_sample_is_judged_by_the_stand_in_disk_not_the_hosts(self):
        self.pull(1, 'one')
        self.enqueue(1, self.main, 1)
        self.run_signer('observe')
        self.run_signer('sign', STUB_RUN_SECONDS='2.5')
        [attempt] = self.lines('attempts.jsonl')
        self.assertEqual((attempt['outcome'], attempt.get('stopped')), ('signed', None))

    def test_an_entry_records_its_group_tree_and_merge_tree_and_a_dropped_entry_is_measured_too(self):
        self.pull(1, 'one')
        group = self.enqueue(1, self.main, 1)
        self.run_signer('observe')
        record = self.state_now()['entries'][group]
        self.assertEqual(record['group_tree'], git(self.work, 'rev-parse', f'{group}^{{tree}}'))
        self.assertTrue(record['merge_tree_equal'])
        # Dropped: the branch is gone and main never got it; the queue's run finished.
        self.leave(1, group, landed=False)
        self.queue_ran(group, 7, '2026-10-23T10:01:00Z', {'linux-gate': 'failure'})
        self.run_signer('observe')
        [line] = self.lines('entries.jsonl')
        self.assertEqual((line['pr'], line['landed'], line['merge_tree_equal'], line['queue']['linux-gate']['result']),
                         (1, False, True, 'failure'))
        self.assertEqual(self.state_now()['entries'], {})

    def test_the_prediction_is_signed_before_enqueue_and_the_entry_it_predicted_is_not_signed_again(self):
        head = self.pull(2, 'two')
        script = Path(self.tmp.name) / 'next.sh'
        script.write_text(f'#!/bin/sh\necho "2 {head}"\n')
        script.chmod(0o755)
        (self.config / 'next-command').write_text(json.dumps([str(script)]))
        self.run_signer('observe')
        prediction = self.state_now()['prediction']
        self.assertEqual((prediction['pr'], prediction['on']), (2, self.main))
        signed = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime(time.time() + 30))
        self.run_signer('sign', STUB_PUSH_NOTES=signed)
        [run] = self.runs()
        self.assertEqual((run['tree'], run['parents']), (prediction['tree'], [self.main, head]))
        self.assertEqual(run['checks'], ['typescript-client', 'genie-freshness', 'linux-gate'], 'every local check, heavy too')
        self.assertIsNone(run['target'], "fractal-test's own kept target, not the pre-sign worker's")
        [attempt] = self.lines('attempts.jsonl')
        self.assertEqual((attempt['kind'], attempt['outcome'], attempt['signed_at_source']), ('predicted', 'signed', 'note'))
        self.assertEqual(attempt['stage_seconds'],
                         dict.fromkeys(['typescript-client', 'genie-freshness', 'linux-gate'], 60))
        self.assertEqual(attempt['signed_at'], dict.fromkeys(['typescript-client', 'genie-freshness', 'linux-gate'], signed),
                         "each note's own time, read back from the pushed notes")
        # Queued as predicted: the group tree is the predicted tree, already signed.
        group = self.enqueue(2, self.main, 1)
        self.run_signer('observe')
        record = self.state_now()['entries'][group]
        self.assertTrue(record['predicted_equal'])
        self.run_signer('sign')
        self.assertEqual(len(self.runs()), 1, 'a tree is signed once')
        # The gate looked a day after the note: ready before it, and the results agree.
        self.leave(2, group, landed=True)
        gate = time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime(time.time() + 86400))
        self.queue_ran(group, 8, gate, {'linux-gate': 'success', 'typescript-client': 'success'})
        self.run_signer('observe')
        [line] = self.lines('entries.jsonl')
        self.assertTrue(line['landed'])
        self.assertTrue(line['compare']['linux-gate']['ready_before_gate'])
        self.assertGreater(line['compare']['linux-gate']['minutes'], 0)
        self.assertTrue(line['compare']['linux-gate']['agree'])
        done = subprocess.run([sys.executable, '-I', str(SIGNER), 'report', '--hours', '1000000'], capture_output=True, text=True,
                              env=self.env())
        report = json.loads(done.stdout)
        self.assertEqual((report['entries'], report['predicted_equal'], report['entries_signed'], report['disagreements']), (1, 1, 1, 0))
        self.assertEqual(report['checks_ready_before_gate'], 2)

    def test_queue_entries_are_signed_in_order_and_only_when_every_author_up_to_them_is_ours(self):
        self.pull(3, 'three', author='outside')
        self.pull(4, 'four')
        first = self.enqueue(3, self.main, 1, author='outside')
        second = self.enqueue(4, first, 2)
        self.run_signer('observe')
        self.run_signer('sign')
        self.assertEqual(self.runs(), [], 'an outside entry, and the entry behind it, do not run here')
        (self.config / 'every-author').write_text('')
        self.run_signer('sign')
        self.run_signer('sign')
        self.assertEqual([run['head'] for run in self.runs()], [first, second], 'position order')
        # No note read back (this fractal-test pushes none): the note times are estimated, and the line says so.
        self.assertEqual({a['signed_at_source'] for a in self.lines('attempts.jsonl')}, {'estimate'})

    def test_a_busy_full_or_short_of_memory_host_starts_nothing_and_says_so(self):
        self.pull(5, 'five')
        self.enqueue(5, self.main, 1)
        self.run_signer('observe')
        # Operations' start line is 12%, under the 15% stop: 13% starts nothing.
        self.pressure.write_text('some avg10=13 avg60=13.00 avg300=13 total=1\n')
        self.run_signer('sign')
        self.pressure.write_text('some avg10=1 avg60=1.00 avg300=1 total=1\n')
        self.meminfo.write_text('MemTotal: 67108864 kB\nMemAvailable: 18874368 kB\n')
        self.run_signer('sign')
        (self.config / 'start.json').write_text(json.dumps({'min_free_gib': 1e9}))
        self.meminfo.write_text('MemTotal: 67108864 kB\nMemAvailable: 50331648 kB\n')
        self.run_signer('sign')
        self.assertEqual(self.runs(), [])
        self.assertEqual([skip['reason'] for skip in self.lines('skips.jsonl')], ['busy', 'memory', 'disk'])

    def merge_to_main(self, name):
        git(self.work, 'checkout', '-q', '-B', 'main', git(self.origin, 'rev-parse', 'main'))
        (self.work / name).write_text(f'{name}\n')
        git(self.work, 'add', '.')
        git(self.work, 'commit', '-q', '-m', f'merge {name}')
        git(self.work, 'push', '-q', 'origin', 'main')
        return git(self.work, 'rev-parse', 'HEAD')

    def test_seed_runs_once_per_new_tip_of_main_on_that_commit(self):
        self.run_signer('seed')
        self.run_signer('seed')
        self.assertEqual([(run['seed'], run['head']) for run in self.runs()], [(self.main, self.main)])
        tip = self.merge_to_main('next')
        self.run_signer('seed', STUB_SEED='covered')
        third = self.merge_to_main('third')
        self.run_signer('seed', STUB_SEED_FAILED=json.dumps(['crate-b']))
        self.assertEqual([run['seed'] for run in self.runs()], [self.main, tip, third])
        seeds = self.lines('seeds.jsonl')
        self.assertEqual([(s['commit'], s['outcome']) for s in seeds], [(self.main, 'seeded'), (tip, 'covered'), (third, 'failed')])
        self.assertEqual(seeds[2]['not_signed'], {'rust-tests:crate-b': 'FAILED (1)'})
        self.assertEqual(seeds[0]['tree'], git(self.origin, 'rev-parse', f'{self.main}^{{tree}}'))
        self.assertEqual(seeds[0]['detail'], '2 of 2 crates run and signed')
        self.assertGreaterEqual(seeds[0]['wait_s'], 0)  # from the merge (main's commit time) to the start
        done = subprocess.run([sys.executable, '-I', str(SIGNER), 'report'], capture_output=True, text=True, env=self.env())
        report = json.loads(done.stdout)
        self.assertEqual((report['seeds'], report['seed_outcomes']), (3, {'covered': 1, 'failed': 1, 'seeded': 1}))

    def calm(self):
        self.pressure.write_text('some avg10=1 avg60=1.00 avg300=1 total=1\n')

    def test_a_seed_stopped_for_load_before_its_tests_start_tries_the_same_tip_again_up_to_six_times(self):
        for _ in range(7):
            self.calm()
            self.run_signer('seed', STUB_SEED_STOP='before')
        seeds = self.lines('seeds.jsonl')
        self.assertEqual([(s['commit'], s['try'], s['outcome'], s['retry']) for s in seeds],
                         [(self.main, n, 'deferred', n < 6) for n in range(1, 7)])
        self.assertEqual(len(self.runs()), 6)
        self.assertFalse(seeds[0]['tests_started'])
        self.assertEqual(seeds[0]['pool_max_gb'], '170')
        # A newer merge replaces the tip: it is seeded, the old one is not tried again.
        self.calm()
        tip = self.merge_to_main('next')
        self.run_signer('seed')
        self.run_signer('seed')
        self.assertEqual([run['seed'] for run in self.runs()][6:], [tip])
        done = subprocess.run([sys.executable, '-I', str(SIGNER), 'report'], capture_output=True, text=True, env=self.env())
        self.assertEqual(json.loads(done.stdout)['seed_retries'], 5)

    def test_a_seed_stopped_after_its_tests_started_is_not_tried_again(self):
        self.run_signer('seed', STUB_SEED_STOP='after')
        self.calm()
        self.run_signer('seed')
        seeds = self.lines('seeds.jsonl')
        self.assertEqual([(s['outcome'], s['tests_started'], s['retry']) for s in seeds], [('deferred', True, False)])
        self.assertEqual(len(self.runs()), 1)

    def test_seed_waits_while_another_seed_runs_or_the_host_is_busy(self):
        # Another seat's fractal-test --seed on the host: this tick starts nothing, and the next one, once it ended, seeds the tip.
        (self.proc / '4242').mkdir()
        (self.proc / '4242/cmdline').write_bytes(b'python3\0-I\0/srv/fractal/scripts/fractal-test\0--seed\0')
        (self.proc / '4243').mkdir()
        (self.proc / '4243/cmdline').write_bytes(b'python3\0-I\0/tmp/fractal-test\0--push\0origin\0')  # runner, but no seed
        self.run_signer('seed')
        self.assertEqual(self.runs(), [])
        (self.proc / '4242/cmdline').unlink()
        self.pressure.write_text('some avg10=13 avg60=13.00 avg300=13 total=1\n')
        self.run_signer('seed')
        self.assertEqual(self.runs(), [])
        self.pressure.write_text('some avg10=1 avg60=1.00 avg300=1 total=1\n')
        self.run_signer('seed')
        self.assertEqual([run['seed'] for run in self.runs()], [self.main])
        self.assertEqual([(skip['kind'], skip['reason']) for skip in self.lines('skips.jsonl')], [('seed', 'seeding'), ('seed', 'busy')])

    def test_off_stops_all_three(self):
        self.pull(6, 'six')
        self.enqueue(6, self.main, 1)
        (self.config / 'off').write_text('')
        self.run_signer('observe')
        self.run_signer('sign')
        self.run_signer('seed')
        self.assertFalse((self.state / 'entries.json').exists())
        self.assertEqual(self.runs(), [])


if __name__ == '__main__':
    unittest.main()
