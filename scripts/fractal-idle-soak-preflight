#!/usr/bin/env bash
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
set -Eeuo pipefail
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
fractal_preflight_start=${FRACTAL_IDLE_PREFLIGHT_START_UNIX-${ST3_IDLE_PREFLIGHT_START_UNIX-}}

# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
: "${FRACTAL_IDLE_PREFLIGHT_START_UNIX-${ST3_IDLE_PREFLIGHT_START_UNIX:?set the first final-build sample epoch}}"
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
[[ ${FRACTAL_IDLE_PREFLIGHT_START_UNIX-${ST3_IDLE_PREFLIGHT_START_UNIX-}} =~ ^[0-9]+$ ]] || {
  echo 'invalid idle preflight start epoch' >&2
  exit 2
}
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
now=${FRACTAL_IDLE_REPORT_NOW_UNIX-${ST3_IDLE_REPORT_NOW_UNIX:-$(date -u +%s)}}
[[ $now =~ ^[0-9]+$ ]] || { echo 'invalid idle preflight now epoch' >&2; exit 2; }
(( now >= fractal_preflight_start )) || {
  echo 'idle preflight start is in the future' >&2
  exit 2
}

report="$(dirname "$0")/fractal-idle-soak-report"
duration=$((now - fractal_preflight_start))
(( duration > 0 )) || duration=1
# The release report is intentionally still allowed to fail for insufficient
# duration, quiet intervals, or CPU. This preflight checks only whether the
# retained post-rollout evidence is continuous and belongs to one healthy PID.
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
result=$(FRACTAL_IDLE_REPORT_DURATION_SECONDS="$duration" ST3_IDLE_REPORT_DURATION_SECONDS="$duration" \
  FRACTAL_IDLE_REPORT_MIN_SAMPLES=1 ST3_IDLE_REPORT_MIN_SAMPLES=1 FRACTAL_IDLE_REPORT_MIN_QUIET=0 ST3_IDLE_REPORT_MIN_QUIET=0 \
  "$report" 2>&1) || :
summary=$(jq -cr '{hosts:[.hosts[]|{host,samples,errors,pid_count,
  first_at,last_at,max_sample_gap}]}' <<<"$result" 2>/dev/null) || summary=$result
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
if ! jq -e --argjson now "$now" \
  --argjson start "${FRACTAL_IDLE_PREFLIGHT_START_UNIX-${ST3_IDLE_PREFLIGHT_START_UNIX-}}" '
    (.hosts | length) == 2 and
    all(.hosts[];
      .samples > 0 and .errors == 0 and .pid_count == 1 and
      .first_at != null and .first_at <= ($start + 180) and
      .last_at != null and .last_at >= ($now - 180) and
      (.max_sample_gap // 0) <= 180)
  ' <<<"$result" >/dev/null 2>&1; then
  printf 'FAIL: post-rollout idle evidence is missing, stale, discontinuous, or unhealthy: %.600s\n' "$summary"
  exit 1
fi
printf 'PASS: post-rollout idle evidence is continuous and healthy: %.600s\n' "$summary"
