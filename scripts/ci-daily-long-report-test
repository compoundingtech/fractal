#!/usr/bin/env python3
"""The daily long-lane report: every lane counts, times come from the run, and red reaches exactly one issue."""
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import shutil
import tempfile

ROOT = Path(__file__).resolve().parent.parent
loader = importlib.machinery.SourceFileLoader('ci_daily_long_report', str(ROOT / 'scripts/ci-daily-long-report'))
spec = importlib.util.spec_from_loader(loader.name, loader)
report = importlib.util.module_from_spec(spec)
loader.exec_module(report)

lanes = {'linux-test-build': 'daily-test-build', 'isolation-vm': 'daily-isolation-vm', 'mail-redelivery-canaries': 'daily-mail-redelivery-canaries'}
jobs = [
    {'name': 'daily-test-build', 'started_at': '2026-10-19T03:00:00Z', 'completed_at': '2026-10-19T03:21:05Z',
     'html_url': 'https://example.invalid/job/1', 'steps': [
         {'name': 'Compile', 'conclusion': 'success', 'started_at': '2026-10-19T03:01:00Z', 'completed_at': '2026-10-19T03:20:00Z'},
         {'name': 'Upload', 'conclusion': 'success', 'started_at': '2026-10-19T03:20:00Z', 'completed_at': '2026-10-19T03:21:00Z'}]},
    {'name': 'daily-isolation-vm', 'started_at': '2026-10-19T03:22:00Z', 'completed_at': '2026-10-19T03:31:00Z',
     'html_url': 'https://example.invalid/job/2', 'steps': [
         {'name': 'Probe KVM', 'conclusion': 'success', 'started_at': '2026-10-19T03:22:10Z', 'completed_at': '2026-10-19T03:22:12Z'},
         {'name': 'Run all three systemd-scope tests in the VM', 'conclusion': 'failure', 'started_at': '2026-10-19T03:23:00Z', 'completed_at': '2026-10-19T03:30:00Z'}]},
]
needs = {'linux-test-build': {'result': 'success'}, 'isolation-vm': {'result': 'failure'}}

rows = report.rows(lanes, needs, jobs)
assert [row['lane'] for row in rows] == list(lanes.values()), 'lanes keep their declared order'
assert rows[0]['seconds'] == 1265 and rows[0]['longest'] == (1140, 'Compile')
assert rows[1]['failed'] == ['Run all three systemd-scope tests in the VM']
assert rows[2]['result'] == 'missing' and rows[2]['seconds'] is None, 'a lane absent from needs is not green'
assert [row['lane'] for row in report.red(rows)] == ['daily-isolation-vm', 'daily-mail-redelivery-canaries']
text = report.table(rows)
assert '| [daily-test-build](https://example.invalid/job/1) | ✅ success | 21m 05s | Compile (19m 00s) | — |' in text, text
assert '| daily-mail-redelivery-canaries | ❌ missing | n/a | n/a | none recorded |' in text, text
assert report.duration(7) == '7s' and report.duration(None) == 'n/a'
unfinished = [dict(jobs[1], completed_at=None)]
assert report.rows({'isolation-vm': 'daily-isolation-vm'}, needs, unfinished)[0]['seconds'] == 480, 'a job without completed_at ends at its last step'
print('passed: rows, order, durations and red lanes')

# The generated report covers every lane it waits for, the cost check included.
workflow = (ROOT / '.github/workflows/daily-long.yml').read_text()
reporter = workflow.split('\n  daily-report:\n', 1)[1]
needed = reporter.split('    needs:\n', 1)[1].split('\n    if:', 1)[0].split('\n')
declared = json.loads(reporter.split("LANES: '", 1)[1].split("'\n", 1)[0])
assert [line.removeprefix('      - ') for line in needed] == list(declared), (needed, declared)
assert declared.get('perf-cost') == 'daily-perf-cost' and '\n  perf-cost:\n    name: daily-perf-cost\n' in workflow, declared
print('passed: the report covers every lane it needs, including daily-perf-cost')

# The load jobs run here once a day on main, unconditionally, from the definitions Performance dispatches
# (perf-load.ts): same runners, artifacts and snapshot restore. No continue-on-error, so a red one is red in
# `needs` and reaches the report and its issue.
import re
blocks = dict(re.findall(r"(?ms)^  ([\w-]+):\n(.*?)(?=^  [\w-]+:\n|\Z)", workflow.split('\njobs:\n', 1)[1]))
performance = dict(re.findall(r"(?ms)^  ([\w-]+):\n(.*?)(?=^  [\w-]+:\n|\Z)", (ROOT / '.github/workflows/perf.yml').read_text().split('\njobs:\n', 1)[1]))
for job, artifact in (('perf-load', 'perf-load-logs'), ('perf-load-hog', 'perf-load-hog-logs'), ('perf-load-hog-macos', 'perf-load-hog-macos')):
    assert declared.get(job) == f'daily-{job}', (job, declared)
    block = blocks[job]
    assert block.startswith(f"    name: daily-{job}\n    if: github.ref == 'refs/heads/main'\n    runs-on:"), (job, 'main only, on every daily run')
    assert 'continue-on-error' not in block and 'needs:' not in block and 'workflow_dispatch' not in block, job
    assert f'name: {artifact}\n' in block and f'name: {artifact}\n' in performance[job], (job, 'same artifact in both workflows')
    shared = performance[job].split('\n    runs-on:', 1)[1]
    assert block.split('\n    runs-on:', 1)[1].startswith(shared.split('\n      - name: Report job cache coverage', 1)[0]), (job, 'one definition')
for job in ('perf-load', 'perf-load-hog'):
    assert 'nscloud-ubuntu-24.04-amd64-8x16-with-features;job.priority=3' in blocks[job], job
    assert 'python3 scripts/ci-perf-cache restore' in blocks[job], job
assert 'namespace-profile-macos-arm64' in blocks['perf-load-hog-macos']
assert 'scripts/ci-perf-cache pack' in blocks['perf-load'], "main's daily load publishes the snapshots"
print('passed: daily-perf-load, daily-perf-load-hog and daily-perf-load-hog-macos run on main every day and report red')


def run(needs, issues, jobs_exit=0):
    with tempfile.TemporaryDirectory() as scratch:
        tmp = Path(scratch)
        bash = shutil.which('bash')
        (tmp / 'jobs').write_text('\n'.join(json.dumps(job) for job in jobs))
        (tmp / 'issues').write_text(json.dumps(issues))
        gh = tmp / 'gh'
        gh.write_text(f'''#!{bash}
args="$*"; printf '%s\\n' "${{args//$'\\n'/ }}" >> "{tmp}/calls"
case "$1 $2" in
  "api --paginate") [ {jobs_exit} = 0 ] || exit {jobs_exit}; cat "{tmp}/jobs" ;;
  "issue list") cat "{tmp}/issues" ;;
  "issue create") echo https://example.invalid/issues/9 ;;
esac
''')
        gh.chmod(0o755)
        summary = tmp / 'summary'
        environment = {**os.environ, 'PATH': f"{tmp}:{os.environ['PATH']}", 'LANES': json.dumps(lanes),
                       'NEEDS_JSON': json.dumps(needs), 'GITHUB_REPOSITORY': 'example/project', 'GITHUB_RUN_ID': '77',
                       'GITHUB_RUN_ATTEMPT': '2', 'GITHUB_SERVER_URL': 'https://example.invalid', 'GITHUB_SHA': 'abc123',
                       'GITHUB_STEP_SUMMARY': str(summary), 'TITLE': 'Daily long-lane run failed'}
        saved = os.environ.copy()
        os.environ.update(environment)
        try:
            report.main(environment)
        finally:
            os.environ.clear()
            os.environ.update(saved)
        calls = (tmp / 'calls').read_text().splitlines()
        return summary.read_text(), calls


green = {lane: {'result': 'success'} for lane in lanes}
written, calls = run(green, [])
assert written.startswith('## Daily long lanes: green') and 'Tracking issue' not in written, written
assert calls == ['api --paginate repos/example/project/actions/runs/77/attempts/2/jobs?per_page=100 --jq .jobs[]|@json'], calls
print('passed: green writes the summary and touches no issue')

failing = {**green, 'isolation-vm': {'result': 'failure'}}
written, calls = run(failing, [{'number': 4, 'title': 'Daily long-lane run failed (old)'}, {'number': 12, 'title': 'Daily long-lane run failed'}])
assert written.startswith('## Daily long lanes: red (1 of 3 lanes)') and 'Tracking issue: commented on #12' in written, written
assert calls[-1].startswith('issue comment 12 --body ## Daily long lanes: red'), calls
print('passed: red comments on the one open issue with the exact title')

written, calls = run(failing, [])
assert 'Tracking issue: opened https://example.invalid/issues/9' in written and calls[-1].startswith('issue create --title Daily long-lane run failed'), calls
print('passed: red with no open issue opens one')

written, calls = run(failing, [], jobs_exit=1)
assert 'Lane times are unavailable' in written and '❌ failure' in written and 'Tracking issue: opened' in written, written
print('passed: an unreadable jobs list still reports every result and the issue')
