#!/usr/bin/env python3
"""CI's per-crate `rust-tests` notes, signed with CI's own key from the linux-tests shards' own nextest run (docs/per-crate-test-signing.md, 14).

  describe --out FILE        in a test shard, after nextest: what the note job must know about this shard's JUnit report
                             (SHARD_JOB, CI_TEST_PARTITION, GITHUB_RUN_ATTEMPT, NEXTEST_OUTCOME; the dev shell digest and the system)
  plan --reports DIR --out DIR
                             in the note job, BEFORE the key exists: read every shard's report (DIR/rust-test-junit-<job>-<attempt>/),
                             decide which crates may be signed and write DIR/plan.json and the union of the reports, DIR/junit.xml
  guard                      the events this job signs for: the merge queue, push to main and manual runs on main; never a pull request
  sign --plan DIR --out DIR  with the signer's HOME: one `evidence-wrap --aggregate --out` record per planned crate

Nothing is signed unless ALL of these hold: the event is a signing event (guard); neither evidence gate the test jobs read
(linux-gate's, rust-tests') decided to skip; every test shard of this event (four in a merge group, two otherwise; the merge-only
shards must then be skipped) ended `success` and left a whole JUnit report of THIS run attempt for its own partition; the shards
agree on the dev shell and the system; and no test case appears in two shards. Any of these failing signs nothing for any crate:
never a note from partial data.

A crate is then signed only when, across the union of all the shards' reports, every one of its test cases passed on the first try
(no failure, no error, and none that passed only on a retry: nextest's flaky tests count as passing for scripts/ci-rust-test-result
and for the CI gate, never for a CI note), no report of an earlier attempt of the same run shows one of its tests failing or flaky,
and it ran at least one test, unless the accepted base lists it under `no_tests` in .st/rust-test-inputs.json (the rule
scripts/evidence-verify applies to every per-crate note). The other crates get no note at all, so a failure is never hidden
behind a record either way.

The key of each crate is computed exactly as scripts/fractal-test computes it: the accepted base's scripts/rust-test-keys over the
tested tree, with the base's .st/rust-test-inputs.json and the base's scripts/evidence-verify projection. The record is the one
fractal-test signs (command `python3 scripts/ci-rust-test-result`, its output digest over this crate's part of the union report, and
the inputs crate, source_inputs, tests_run, tests_ignored, test_list_sha256, ignored_list_sha256, filterset, run_command_sha256),
so the rust-tests policy entry judges it as it judges fractal-test's. Every script used comes from the base commit (the directory this
script is in), never from the tree under test.

Exit 0: done (sign: every planned crate signed). Exit 1: refused or failed, with a ::warning:: that says why; the job is fail-soft.
"""
import argparse
import concurrent.futures
import fnmatch
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import xml.etree.ElementTree as ET

sys.dont_write_bytecode = True

HERE = Path(__file__).resolve().parent
CHECK = 'rust-tests'
COMMAND = ['python3', 'scripts/ci-rust-test-result']  # the rust-tests policy entry's wrapper command, as fractal-test records it
STAGE_COMMAND = ['bash', 'scripts/ci-linux', 'tests']
SIGNING_EVENTS = {
    'merge_group': ['refs/heads/gh-readonly-queue/*'],
    'push': ['refs/heads/main'],
    'workflow_dispatch': ['refs/heads/main'],
}
SHARDS = ('linux-tests', 'linux-tests-shard-2', 'linux-tests-shard-3', 'linux-tests-shard-4')
MERGE_ONLY = ('linux-tests-shard-3', 'linux-tests-shard-4')
GATES = ('evidence-gate-linux-gate', 'evidence-gate-rust-tests')
ARTIFACT = re.compile(r'rust-test-junit-(linux-tests(?:-shard-[234])?)-([1-9][0-9]{0,3})')
BAD = {'failure', 'error', 'rerunFailure', 'rerunError'}
FLAKY = {'flakyFailure', 'flakyError'}
SIGN_JOBS = 8
HEX64 = re.compile(r'[0-9a-f]{64}')
OID = re.compile(r'[0-9a-f]{40}|[0-9a-f]{64}')


class Refused(Exception):
    pass


def env(name, default=''):
    return os.environ.get(name, default)


def clean_env(**extra):
    return dict({k: v for k, v in os.environ.items() if not k.startswith('GIT_')}, **extra)


def git(*args, repo='.'):
    done = subprocess.run(['git', '-C', str(repo), '-c', 'core.fsmonitor=false', '-c', 'core.hooksPath=/dev/null', *args],
                          capture_output=True, env=clean_env(GIT_NO_REPLACE_OBJECTS='1', LC_ALL='C'))
    if done.returncode != 0:
        raise Refused(f'git {args[0]} failed: {done.stderr.decode(errors="replace").strip()[-300:]}')
    return done.stdout


def expected_shards(event):
    """{job: partition} of the shards this event runs, and the shards it must skip (the matrix of the workflow's linux-tests jobs)."""
    if event == 'merge_group':
        return {job: f'hash:{index}/4' for index, job in enumerate(SHARDS, 1)}, ()
    return {SHARDS[0]: 'hash:1/2', SHARDS[1]: 'hash:2/2'}, MERGE_ONLY


def guard():
    event, ref = env('GITHUB_EVENT_NAME'), env('GITHUB_REF')
    patterns = SIGNING_EVENTS.get(event)
    if patterns is None:
        raise Refused(f'refusing event {event!r}: per-crate rust-tests notes are signed for the merge queue, push to main and manual runs on '
                      'main only, never for a pull request')
    if not any(fnmatch.fnmatchcase(ref, pattern) for pattern in patterns):
        raise Refused(f'refusing ref {ref!r} for {event}: expected one of {patterns}')
    return f'{event} on {ref}'


def checked_needs(needs, event):
    """The shards to read ({job: partition}); refuses a run whose gate skipped or whose shards did not all succeed."""
    for gate in GATES:
        if gate not in needs:
            raise Refused(f'{gate} is not among the needed jobs, so whether it skipped the tests is unknown')
        if str((needs[gate].get('outputs') or {}).get('skip', '')).lower() == 'true':
            raise Refused(f'{gate} decided to skip in this run: the test jobs did not test this tree themselves')
    shards, skipped = expected_shards(event)
    results = {job: str((needs.get(job) or {}).get('result', 'missing')) for job in SHARDS}
    bad = sorted(f'{job}={results[job]}' for job in shards if results[job] != 'success')
    if bad:
        raise Refused(f'not every test shard of this {event} run succeeded ({", ".join(bad)}): nothing is signed from partial data')
    extra = sorted(f'{job}={results[job]}' for job in skipped if results[job] != 'skipped')
    if extra:
        raise Refused(f'the merge-only shards must be skipped outside a merge group ({", ".join(extra)})')
    return shards


def statuses(root):
    """{(suite, case): status} for the test cases of one report: FAIL, flaky, skip or pass."""
    found = {}
    for suite in root.iter('testsuite'):
        for case in suite.iter('testcase'):
            children = {child.tag for child in case}
            status = 'FAIL' if children & BAD else 'flaky' if children & FLAKY else 'skip' if 'skipped' in children else 'pass'
            name = (suite.get('name', ''), case.get('name', ''))
            if name in found:
                raise Refused(f'test {name[0]} {name[1]} appears twice in one report')
            found[name] = status
    return found


def report(path):
    try:
        root = ET.parse(path).getroot()
    except (OSError, ET.ParseError) as error:
        raise Refused(f'{path.parent.name}: the JUnit report is missing or not whole ({error})')
    if root.tag != 'testsuites':
        raise Refused(f'{path.parent.name}: {path.name} is not a nextest JUnit report')
    return root


def crate_of(suite, crates):
    """The workspace crate a suite belongs to (nextest's binary id is `<crate>` or `<crate>::<binary>`), as ci-rust-test-result reads it."""
    for crate in crates:
        if suite == crate or suite.startswith(crate + '::'):
            return crate
    return None


def read_reports(directory, shards, attempt):
    """(the union report, the shards' common description, crates failing or flaky in an earlier attempt of this run)."""
    directory = Path(directory)
    current, earlier = {}, []
    for entry in sorted(directory.iterdir()) if directory.is_dir() else []:
        match = ARTIFACT.fullmatch(entry.name)
        if not match or not entry.is_dir():
            continue
        job, made = match.group(1), int(match.group(2))
        if made == attempt:
            current[job] = entry
        elif made < attempt:
            earlier.append(entry)
    missing = sorted(set(shards) - set(current))
    if missing:
        raise Refused(f'no JUnit report of attempt {attempt} from {", ".join(missing)}: nothing is signed from partial data')
    union = ET.Element('testsuites')
    seen, described = {}, []
    for job, partition in sorted(shards.items()):
        try:
            meta = json.loads((current[job] / 'shard.json').read_text())
        except (OSError, ValueError) as error:
            raise Refused(f'{job}: no readable shard.json beside its report ({error})')
        want = {'job': job, 'partition': partition, 'run_attempt': str(attempt), 'nextest_outcome': 'success'}
        wrong = sorted(f'{key}={meta.get(key)!r}' for key, value in want.items() if meta.get(key) != value)
        if wrong:
            raise Refused(f'{job}: its report is not this shard\'s successful run of attempt {attempt} ({", ".join(wrong)})')
        if not (isinstance(meta.get('toolchain_sha256'), str) and HEX64.fullmatch(meta['toolchain_sha256'])
                and isinstance(meta.get('system'), str) and meta['system']):
            raise Refused(f'{job}: its shard.json does not name the dev shell digest and the system')
        described.append((meta['toolchain_sha256'], meta['system']))
        root = report(current[job] / 'junit.xml')
        for name in statuses(root):
            if name in seen:
                raise Refused(f'test {name[0]} {name[1]} ran in both {seen[name]} and {job}: the shards do not partition the run')
            seen[name] = job
        union.extend(root.findall('testsuite'))
    if len(set(described)) != 1:
        raise Refused('the shards ran on different dev shells or systems: ' + ', '.join(sorted({f'{t[:12]}/{s}' for t, s in described})))
    failed_before = {}
    for entry in earlier:
        try:
            found = statuses(ET.parse(entry / 'junit.xml').getroot())
        except (OSError, ET.ParseError, Refused):
            continue  # an earlier attempt's report that is missing or cut short cannot clear anything, and is not needed here
        for (suite, case), status in found.items():
            if status in ('FAIL', 'flaky'):
                failed_before.setdefault(suite, entry.name)
    return union, described[0], failed_before


# arn:lmig:smalltalk:2026-10-27-dot-fractal-config — accepted base only, including probes.
def base_file(base, path):
    preferred = path.replace('.st/', '.fractal/', 1)
    listing = git('ls-tree', '-z', '--full-tree', base, '--', preferred, path)
    names = {entry.partition(b'\t')[2].decode() for entry in listing.split(b'\0') if entry}
    selected = preferred if preferred in names else path if path in names else None
    return git('show', f'{base}:{selected}') if selected is not None else None


def crate_keys(base, tree, scratch):
    """{crate: key} for the tested tree, the way scripts/fractal-test's crate_keys computes it once the base's policy judges rust-tests: the
    base's rust-test-keys and inputs file and the base's evidence-verify projection, never the tree's own copies."""
    tool, verifier = HERE / 'rust-test-keys', HERE / 'evidence-verify'
    if not (tool.exists() and verifier.exists()) or base_file(base, '.st/rust-test-inputs.json') is None:
        raise Refused('the base commit has no scripts/rust-test-keys, scripts/evidence-verify and .st/rust-test-inputs.json: only the base\'s tool '
                      'and inputs may key a note')
    done = subprocess.run([sys.executable, str(tool), '--repo', '.', '--tree', tree, '--inputs-from', base, '--verifier', str(verifier), '--json'],
                          capture_output=True, text=True, env=clean_env())
    if done.returncode != 0:
        raise Refused(f'rust-test-keys failed: {done.stderr.strip()[-300:]}')
    return json.loads(done.stdout)


def no_tests(base):
    """The crates the base lists under no_tests (reviewed: they have no test); a malformed list is a refusal, as in the verifier."""
    data = base_file(base, '.st/rust-test-inputs.json')
    try:
        listed = json.loads(data.decode()).get('no_tests', []) if data is not None else []
    except (ValueError, AttributeError, UnicodeDecodeError):
        raise Refused('.st/rust-test-inputs.json at the base is not readable')
    if not isinstance(listed, list) or not all(isinstance(name, str) for name in listed):
        raise Refused('.st/rust-test-inputs.json: no_tests must be an array of crate names')
    return set(listed)


def crate_result(junit, crate):
    """(exit code, output sha256, summary) of the base's ci-rust-test-result for this crate: the command the record names, run once."""
    tool = HERE / 'ci-rust-test-result'
    variables = clean_env(RUST_TEST_JUNIT=str(junit), RUST_TEST_CRATE=crate)
    shown = subprocess.run([sys.executable, str(tool)], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, env=variables)
    summary = subprocess.run([sys.executable, str(tool), '--summary'], capture_output=True, text=True, env=variables)
    if summary.returncode != 0:
        raise Refused(f'ci-rust-test-result --summary failed for {crate}: {summary.stderr.strip()[-200:]}')
    return shown.returncode, hashlib.sha256(shown.stdout).hexdigest(), json.loads(summary.stdout)


def planning_event(event, topology):
    if topology and (topology != 'merge-group' or event != 'push'):
        raise Refused('explicit merge-group test topology is only valid on a guarded main push')
    return 'merge_group' if topology else event


def plan(reports, out):
    """Decide what may be signed, before the key exists. Writes OUT/plan.json and OUT/junit.xml; returns the plan."""
    guard()
    event = env('GITHUB_EVENT_NAME')
    attempt = env('GITHUB_RUN_ATTEMPT')
    if not re.fullmatch(r'[1-9][0-9]{0,3}', attempt):
        raise Refused('GITHUB_RUN_ATTEMPT must be the run attempt')
    base = env('BASE_SHA')
    if not OID.fullmatch(base):
        raise Refused('BASE_SHA must name the accepted base commit')
    try:
        needs = json.loads(env('NEEDS_JSON') or '{}')
    except ValueError:
        raise Refused('NEEDS_JSON is not JSON')
    shards = checked_needs(needs, planning_event(event, env('CI_TEST_TOPOLOGY')))
    union, (toolchain, system), failed_before = read_reports(reports, shards, int(attempt))
    commit = git('rev-parse', 'HEAD').decode().strip()
    tree = git('rev-parse', 'HEAD^{tree}').decode().strip()
    out = Path(out)
    out.mkdir(parents=True, exist_ok=True)
    junit = out / 'junit.xml'
    ET.ElementTree(union).write(junit, encoding='utf-8', xml_declaration=True)
    keys = crate_keys(base, tree, out)
    listed = no_tests(base)
    found = statuses(union)
    by_crate = {}
    names = sorted(keys, key=len, reverse=True)  # the longest name first, so `a-b::x` is never read as crate `a`
    for (suite, _), status in found.items():
        crate = crate_of(suite, names)
        if crate:
            by_crate.setdefault(crate, []).append(status)
    planned, excluded = [], {}
    for crate in sorted(keys):
        seen = by_crate.get(crate, [])
        earlier = [suite for suite, artifact in failed_before.items() if crate_of(suite, names) == crate]
        if not keys[crate]:
            excluded[crate] = 'no declared path exists in this tree'
        elif 'FAIL' in seen:
            excluded[crate] = f'{seen.count("FAIL")} test(s) failed'
        elif 'flaky' in seen:
            excluded[crate] = f'{seen.count("flaky")} test(s) passed only on a retry'
        elif earlier:
            excluded[crate] = 'a test failed or was flaky in an earlier attempt of this run'
        else:
            code, digest, summary = crate_result(junit, crate)
            if code != 0:
                excluded[crate] = f'ci-rust-test-result exited {code}'
            elif int(summary['tests_run']) == 0 and crate not in listed:
                excluded[crate] = 'it ran no test and is not listed under no_tests'
            else:
                planned.append({'crate': crate, 'key': keys[crate], 'output_sha256': digest, **{k: str(v) for k, v in summary.items()}})
    partitions = [shards[job] for job in sorted(shards, key=lambda job: shards[job])]
    result = {
        'version': 1, 'commit': commit, 'tree': tree, 'base': base, 'event_name': event, 'run_attempt': attempt,
        'toolchain_sha256': toolchain, 'system': system, 'shard_jobs': sorted(shards), 'partitions': partitions,
        'run_command_sha256': hashlib.sha256(json.dumps([STAGE_COMMAND, partitions]).encode()).hexdigest(),
        'junit': str(junit), 'crates': planned, 'excluded': excluded,
    }
    (out / 'plan.json').write_text(json.dumps(result, indent=1, sort_keys=True))
    summarize(f'### Per-crate rust-tests notes for `{commit[:12]}`\n\n{len(planned)} of {len(keys)} crates may be signed from '
              f'{len(shards)} shards ({", ".join(partitions)}).\n' + ''.join(f'- not signed `{c}`: {why}\n' for c, why in sorted(excluded.items())))
    return result


def summarize(text):
    path = env('GITHUB_STEP_SUMMARY')
    if path:
        with open(path, 'a') as stream:
            stream.write(text + '\n')
    print(text)


def own_system():
    found = subprocess.run(['uname', '-sm'], capture_output=True, text=True).stdout.split()
    return ' '.join(found)


def sign(plan_dir, out):
    """One record per planned crate, written as packs for evidence-publish (`evidence-wrap --aggregate --out`)."""
    guard()
    plan_dir, out = Path(plan_dir), Path(out)
    planned = json.loads((plan_dir / 'plan.json').read_text())
    if git('rev-parse', 'HEAD^{tree}').decode().strip() != planned['tree'] or git('rev-parse', 'HEAD').decode().strip() != planned['commit']:
        raise Refused('the checkout is not the commit the plan was made for')
    if own_system() != planned['system']:
        raise Refused(f'this job runs on {own_system()!r} and the tests ran on {planned["system"]!r}: evidence-wrap would record the wrong system')
    if not planned['crates']:
        summarize('no crate qualifies for a per-crate note in this run')
        return 0
    out.mkdir(parents=True, exist_ok=True)
    facts_dir = plan_dir / 'facts'
    facts_dir.mkdir(exist_ok=True)
    context = {'run_id': env('GITHUB_RUN_ID'), 'run_attempt': planned['run_attempt'], 'event_name': planned['event_name'],
               'ref': env('GITHUB_REF'), 'workflow': env('GITHUB_WORKFLOW'), 'shard_jobs': ','.join(planned['shard_jobs']),
               'partitions': ','.join(planned['partitions']), 'junit_source': 'linux-tests shards'}
    context = {k: v for k, v in context.items() if v}
    signer = json.dumps([sys.executable, str(HERE / 'evidence-sign')])

    def one(entry):
        crate = entry['crate']
        facts = facts_dir / f'{crate}.json'
        facts.write_text(json.dumps({'command': COMMAND, 'exit_code': 0, 'output_sha256': entry['output_sha256'], 'inputs': context}))
        wrap = [sys.executable, str(HERE / 'evidence-wrap'), '--check', CHECK, '--aggregate', str(facts), '--attempt', planned['run_attempt'],
                '--change-id', f'github:{env("GITHUB_REPOSITORY")}@{planned["commit"]}', '--signer', signer,
                '--toolchain-sha256', planned['toolchain_sha256'], '--out', str(out),
                '--input', f'crate={crate}', '--input', f'source_inputs={entry["key"]}', '--input', f'tests_run={entry["tests_run"]}',
                '--input', f'tests_ignored={entry["tests_ignored"]}', '--input', f'test_list_sha256={entry["test_list_sha256"]}',
                '--input', f'ignored_list_sha256={entry["ignored_list_sha256"]}', '--input', 'filterset=workspace',
                '--input', f'run_command_sha256={planned["run_command_sha256"]}']
        done = subprocess.run(wrap, capture_output=True, text=True)
        return crate, done.returncode, (done.stderr.strip().splitlines() or ['failed'])[-1][:200]

    entries = planned['crates']
    # The first goes alone: the signer creates its scratch repository when it is missing, and two signers racing to create it fail one.
    outcomes = [one(entries[0])]
    with concurrent.futures.ThreadPoolExecutor(max_workers=SIGN_JOBS) as pool:
        outcomes += list(pool.map(one, entries[1:]))
    failed = [(crate, code, detail) for crate, code, detail in outcomes if code != 0]
    summarize(f'signed {len(outcomes) - len(failed)} of {len(outcomes)} per-crate rust-tests notes'
              + ''.join(f'\n- **not signed** `{crate}` (exit {code}): {detail}' for crate, code, detail in failed))
    return 1 if failed else 0


def describe(out):
    """This shard's facts for the note job: which job and partition, which attempt, how nextest ended, the dev shell and the system.
    The dev shell digest is the one evidence-wrap records (the sha256 of the default dev shell's derivation path)."""
    system = subprocess.run(['nix', 'eval', '--impure', '--raw', '--expr', 'builtins.currentSystem'], capture_output=True, text=True)
    drv = subprocess.run(['nix', 'eval', '--raw', '--no-update-lock-file', f'.#devShells.{system.stdout.strip()}.default.drvPath'],
                         capture_output=True, text=True)
    if system.returncode or drv.returncode or not drv.stdout.startswith('/'):
        raise Refused('could not name the dev shell derivation: ' + (drv.stderr or system.stderr).strip()[-300:])
    meta = {'job': env('SHARD_JOB'), 'partition': env('CI_TEST_PARTITION'), 'run_attempt': env('GITHUB_RUN_ATTEMPT'),
            'nextest_outcome': env('NEXTEST_OUTCOME'), 'toolchain_sha256': hashlib.sha256(drv.stdout.strip().encode()).hexdigest(),
            'system': own_system()}
    Path(out).parent.mkdir(parents=True, exist_ok=True)
    Path(out).write_text(json.dumps(meta, sort_keys=True))
    print(json.dumps(meta))
    return 0


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest='command', required=True)
    sub.add_parser('guard')
    one = sub.add_parser('describe')
    one.add_argument('--out', required=True)
    two = sub.add_parser('plan')
    two.add_argument('--reports', required=True)
    two.add_argument('--out', required=True)
    three = sub.add_parser('sign')
    three.add_argument('--plan', required=True)
    three.add_argument('--out', required=True)
    args = parser.parse_args(argv)
    try:
        if args.command == 'guard':
            print(guard())
            return 0
        if args.command == 'describe':
            return describe(args.out)
        if args.command == 'plan':
            plan(args.reports, args.out)
            return 0
        return sign(args.plan, args.out)
    except Refused as refusal:
        print(f'::warning::per-crate rust-tests notes: {refusal}')
        return 1
    except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
        print(f'::warning::per-crate rust-tests notes: {args.command} failed: {error}')
        return 1


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
