#!/usr/bin/env python3
"""Exercise public repository guard boundaries using invented identities."""
import runpy
import os
import subprocess
import tempfile
import shutil
import unittest
from pathlib import Path

CHECK = runpy.run_path(str(Path(__file__).with_name('check-public-repo')))


class PublicRepositoryCheck(unittest.TestCase):
    def findings(self, content='', path='docs/example.md'):
        return list(CHECK['findings'](Path(path), content))

    def test_public_examples(self):
        self.assertEqual(self.findings(
            'host/example-linux /home/example/src /Users/example/src /home/ada/work '
            'person/alex person%2Falex agent/example/worker agent%2Fexample%2Fworker '
            'agent/fleet/fixture-web/standing/web agent%2Ffleet%2Ffixture-web%2Fworker'
        ), [])

    def test_unknown_identity_and_home(self):
        for text in ['person' + '/unknown-fixture', 'person' + '%2Funknown-fixture',
                     '/home/' + 'unknown-fixture/src', '/Users/' + 'unknown-fixture/src']:
            with self.subTest(text=text):
                self.assertTrue(self.findings(text))

    def test_legacy_provider_templates_allow_only_invented_accounts(self):
        self.assertEqual(self.findings('person/discord-{id} person/discord-404 person/discord-606'), [])
        self.assertTrue(self.findings('person' + '/discord-123456789012345678'))

    def test_internal_namespace(self):
        for separator in ['/', '%2F', '%2f']:
            self.assertTrue(self.findings(separator.join(['agent', 'fleet', 'fixture'])))

    def test_host_boundaries(self):
        # Build these probes from the checker's denylist, rather than writing host identities.
        for escaped in CHECK['HOSTS']:
            name = escaped.replace('\\', '')
            for text in [name, name.upper(), f'host/{name}', f'https://{name}.example']:
                self.assertTrue(self.findings(text))
            self.assertEqual(self.findings(f'prefix{name}suffix'), [])
            self.assertTrue(self.findings(path=f'docs/{name}.md'))

    def test_notes_merged_before_a_host_was_listed_may_name_only_that_host_and_only_as_merged(self):
        later = [host.replace('\\', '') for host in CHECK['LATER_HOSTS']]
        earlier = [host.replace('\\', '') for host in CHECK['HOSTS'] if host not in CHECK['LATER_HOSTS']]
        root = Path(__file__).resolve().parent.parent
        for path in sorted(CHECK['HOST_NAME_NOTES']):
            with self.subTest(path=path):
                merged = root.joinpath(path).read_text(encoding='utf-8')
                self.assertTrue(CHECK['HOST'].search(merged), 'a listed note names a later host')
                self.assertEqual(self.findings(merged, path=path), [])
                # Any change to the note, even one that adds nothing else, loses the exception.
                self.assertTrue(self.findings(merged + ' ', path=path))
                for name in earlier:
                    self.assertTrue(self.findings(merged + f'ran on {name}', path=path))
        for name in later:
            self.assertTrue(self.findings(f'ran on {name}', path='release-notes/example.json'))
            self.assertTrue(self.findings(path=f'release-notes/{name}.json'))

    def test_private_repository_references(self):
        for separator in ['-', '%2d']:
            name = separator.join(['st3', 'network'])
            for text in [name, name.upper(), f'https://github.com/example/{name}/tree/main',
                         f'git@github.com:example/{name}.git']:
                self.assertTrue(self.findings(text))
            self.assertTrue(self.findings(path=f'docs/{name}.md'))
        self.assertEqual(self.findings('Keep fleet configuration outside the public repository.'), [])

    def test_retired_documents(self):
        for path in ['docs/st3/release-status.md', 'docs/st3/rollout.md',
                     'docs/st3/trial-handoff.md', 'docs/st3/audit-2026-09-30.md',
                     'docs/st3/operational-state/audit-2027-01-01.md']:
            self.assertTrue(self.findings(path=path))
        self.assertEqual(self.findings(path='docs/st3/invariants.md'), [])
        self.assertEqual(self.findings(path='evals/fractal/example/reports/2026-09-30.md'), [])


class PublicHistoryCheck(unittest.TestCase):
    def setUp(self):
        self.temp = tempfile.TemporaryDirectory()
        self.addCleanup(self.temp.cleanup)
        self.repo = Path(self.temp.name)
        self.env = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
        self.env.update(GIT_CONFIG_GLOBAL="/dev/null", GIT_CONFIG_NOSYSTEM="1")
        self.git("init", "-b", "main")
        self.git("config", "user.name", "Example")
        self.git("config", "user.email", "example@example.com")
        self.git("config", "commit.gpgsign", "false")
        self.git("config", "core.hooksPath", "/dev/null")
        self.base = self.commit("example.txt", "clean\n")

    def git(self, *args):
        return subprocess.check_output(["git", "-C", str(self.repo), *args], env=self.env,
                                       stderr=subprocess.DEVNULL).decode().strip()

    def commit(self, path, content, message="Example change"):
        (self.repo / path).write_text(content)
        self.git("add", "--", path)
        self.git("commit", "-m", message)
        return self.git("rev-parse", "HEAD")

    def scan(self, head=None):
        commits = CHECK["introduced_commits"](self.repo, self.base, head or self.git("rev-parse", "HEAD"))
        return list(CHECK["commit_findings"](self.repo, commits))

    def test_dirty_intermediate_commit_fixed_later_fails(self):
        dirty = self.commit("example.txt", "person" + "/unknown-fixture\n")
        self.commit("example.txt", "clean again\n")
        errors = self.scan()
        self.assertTrue(any(error.startswith(dirty + ":") for error in errors))

    def test_messages_and_paths(self):
        self.commit("example.txt", "clean change\n", "person" + "/unknown-fixture")
        self.assertTrue(any(":message:" in error for error in self.scan()))
        self.commit("docs-" + "st3" + "-network.txt", "clean")
        self.assertTrue(any(":path:" in error for error in self.scan()))

    def test_side_history_and_merge_resolution(self):
        self.git("checkout", "-b", "side", self.base)
        dirty = self.commit("side.txt", "person" + "/unknown-fixture")
        self.commit("side.txt", "clean")
        self.git("checkout", "main")
        self.commit("main.txt", "clean")
        self.git("merge", "--no-ff", "side", "-m", "Merge example")
        self.assertTrue(any(error.startswith(dirty + ":") for error in self.scan()))
        self.git("checkout", "-b", "resolution", self.base)
        self.commit("resolution.txt", "clean")
        self.git("checkout", "main")
        self.git("merge", "--no-ff", "--no-commit", "resolution")
        (self.repo / "resolution.txt").write_text("person" + "/unknown-fixture")
        self.git("add", ".")
        self.git("commit", "-m", "Merge resolution")
        head = self.git("rev-parse", "HEAD")
        self.assertTrue(any(error.startswith(head + ":diff:") for error in self.scan()))

    def test_outgoing_all_refs_deletions_and_known_remote_history(self):
        self.git("update-ref", "refs/remotes/origin/main", self.base)
        clean = self.commit("example.txt", "clean change")
        dirty = self.commit("other.txt", "person" + "/unknown-fixture")
        self.git("checkout", "--detach", clean)
        zero = "0" * 40
        lines = [
            f"refs/heads/clean {clean} refs/heads/clean {zero}",
            f"refs/heads/other {dirty} refs/heads/other {zero}",
            f"(delete) {zero} refs/heads/deleted {dirty}",
        ]
        errors = list(CHECK["outgoing_findings"](self.repo, "origin", lines))
        self.assertTrue(any(error.startswith(dirty + ":") for error in errors))
        self.assertEqual(list(CHECK["outgoing_findings"](self.repo, "origin", lines[:1])), [])
        self.assertEqual(list(CHECK["outgoing_findings"](self.repo, "origin", lines[2:])), [])

    def test_existing_ref_uses_remote_old_oid(self):
        dirty = self.commit("other.txt", "person" + "/unknown-fixture")
        head = self.commit("other.txt", "clean")
        line = f"refs/heads/main {head} refs/heads/main {self.base}"
        self.assertTrue(list(CHECK["outgoing_findings"](self.repo, "origin", [line])))
        self.git("tag", "-a", "example", "-m", "person" + "/unknown-fixture", self.base)
        tag = self.git("rev-parse", "example")
        errors = list(CHECK["outgoing_findings"](
            self.repo, "origin", [f"refs/tags/example {tag} refs/tags/example {'0' * 40}"]))
        self.assertTrue(any(":tag:" in error for error in errors))

    def test_binary_attribute_cannot_hide_content(self):
        self.commit(".gitattributes", "*.txt -diff\n")
        self.commit("example.txt", "\0person" + "/unknown-fixture\n")
        self.assertTrue(self.scan())

    def test_installed_hook_blocks_dirty_history_even_with_skip_evidence(self):
        scripts = self.repo / "scripts"
        scripts.mkdir()
        source = Path(__file__).resolve().parent
        for name in ("install-git-hooks", "check-public-repo"):
            shutil.copyfile(source / name, scripts / name)
        self.git("add", "scripts")
        self.git("commit", "-m", "Install public guard")
        accepted = self.git("rev-parse", "HEAD")
        self.git("remote", "add", "origin", str(self.repo))
        self.git("update-ref", "refs/remotes/origin/main", accepted)
        self.git("config", "--unset", "core.hooksPath")
        subprocess.run(["bash", str(scripts / "install-git-hooks")], cwd=self.repo,
                       env={**self.env, "CI": "", "GITHUB_ACTIONS": ""}, check=True,
                       stdout=subprocess.DEVNULL)
        dirty = self.commit("example.txt", "person" + "/unknown-fixture")
        head = self.commit("example.txt", "clean again")
        # A candidate cannot replace the scanner used by the installed hook.
        (scripts / "check-public-repo").write_text("raise SystemExit(0)\n")
        self.git("add", "scripts/check-public-repo")
        self.git("commit", "-m", "Candidate scanner change")
        head = self.git("rev-parse", "HEAD")
        hook = self.repo / ".git/hooks/pre-push"
        result = subprocess.run(["bash", str(hook), "origin", str(self.repo)],
                                input=f"refs/heads/main {head} refs/heads/main {accepted}\n",
                                text=True, capture_output=True, cwd=self.repo,
                                env={**self.env, "ST_SKIP_EVIDENCE": "1"})
        self.assertNotEqual(result.returncode, 0)
        self.assertIn(dirty + ":diff:", result.stderr)
        result = subprocess.run(["bash", str(hook), "origin", str(self.repo)],
                                input=f"refs/heads/clean {accepted} refs/heads/clean {'0' * 40}\n",
                                text=True, capture_output=True, cwd=self.repo,
                                env={**self.env, "ST_SKIP_EVIDENCE": "1"})
        self.assertEqual(result.returncode, 0, result.stderr)


if __name__ == '__main__':
    unittest.main()
