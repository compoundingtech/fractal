#!/usr/bin/env python3
"""The repository paths each workspace crate's Rust sources name, outside the crate's own dependency closure.

  scripts/rust-test-inputs-scan [--repo DIR] [--tree TREEISH] [--write FILE | --check FILE]

The first pass of `extra` in .st/rust-test-inputs.json (docs/per-crate-test-signing.md): a textual scan, so it over-declares rather
than misses what a literal names, and it cannot see a path built at run time (the daily trace finds those). For every string literal of a
crate's `.rs` files that has a `/` (or is a bare name of a tracked top-level path in a file that also builds a path from
CARGO_MANIFEST_DIR or `..`), it resolves the text against the repository root, the file's directory and the crate directory and its
parents, and keeps the longest prefix, by path components, that is a tracked file or directory. A literal cut at its first `{`
(a format string) still names its prefix. Anything inside the crate's closure is dropped; the rest is that crate's extra.

--write FILE writes the whole inputs file (global paths as in docs/per-crate-test-signing.md) with these extras; --check FILE fails
when a crate's scan names a path its entry in FILE does not cover, which is the committed-policy test that keeps the list honest.
"""
import argparse
import json
import posixpath
import re
import subprocess
import sys
from pathlib import Path

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
import importlib.machinery
import importlib.util

LOADER = importlib.machinery.SourceFileLoader('rust_test_keys_for_scan', str(Path(__file__).resolve().parent / 'rust-test-keys'))
keys = importlib.util.module_from_spec(importlib.util.spec_from_loader(LOADER.name, LOADER))
LOADER.exec_module(keys)

GLOBAL = ['.cargo', '.config/daily-only.filterset', '.config/nextest.toml', 'Cargo.lock', 'Cargo.toml', 'flake.lock', 'flake.nix',
          'scripts/ci-local', 'scripts/ci-linux', 'scripts/ci-nextest', 'scripts/ci-nextest-flaky',
          'scripts/ci-rustc-wrapper', 'scripts/rust-test-keys', 'scripts/fractal_test_process.py']
LITERAL = re.compile(r'"((?:[^"\\\n]|\\.)*)"')
BUILDS_A_PATH = re.compile(r'CARGO_MANIFEST_DIR|"\.\."')
SKIP_NAMES = {'target', '.git', 'node_modules'}


def tracked(repo, tree):
    out = subprocess.run(['git', '-C', str(repo), 'ls-tree', '-r', '--name-only', '-z', tree], capture_output=True, check=True).stdout
    files = [name for name in out.decode().split('\0') if name]
    directories = {''}
    for name in files:
        parts = name.split('/')
        directories.update('/'.join(parts[:i]) for i in range(1, len(parts)))
    return files, set(files), directories


def longest_tracked_prefix(candidate, files, directories):
    parts = [part for part in candidate.split('/') if part]
    for count in range(len(parts), 0, -1):
        prefix = '/'.join(parts[:count])
        if prefix in files or prefix in directories:
            return prefix
    return None


def inside(path, roots):
    return any(path == root or path.startswith(root + '/') or (root == '.') for root in roots)


def named_paths(source_path, text, crate_dir, files, file_set, directories, tops):
    found = set()
    builds = bool(BUILDS_A_PATH.search(text))
    for whole in LITERAL.findall(text):
        literal = whole.split('{')[0]
        partial = literal != whole or literal.endswith('/')  # a format string or a directory prefix: its longest tracked prefix counts
        if not literal or literal.startswith('/') or '\\' in literal or len(literal) > 300 or set(literal.split('/')) <= {'', '.', '..'}:
            continue
        bare = '/' not in literal
        if bare and not (builds and (literal in tops)):
            continue
        base_dirs = ['', posixpath.dirname(source_path), crate_dir, posixpath.dirname(crate_dir), posixpath.dirname(posixpath.dirname(crate_dir))]
        for base in base_dirs:
            resolved = posixpath.normpath(posixpath.join(base, literal))
            if resolved.startswith('..') or resolved in ('.', ''):
                continue
            if resolved in file_set or resolved in directories:
                prefix = resolved
            else:
                prefix = longest_tracked_prefix(resolved, file_set, directories) if partial else None
            if prefix and not (crate_dir + '/').startswith(prefix + '/'):  # never an ancestor of the crate itself (`..`)
                found.add(prefix)
    return found


def scan(repo, tree):
    members, _, _ = keys.layout(repo, tree)
    files, file_set, directories = tracked(repo, tree)
    inputs = {'global': GLOBAL, 'crates': {}}
    tops = {name.split('/')[0] for name in files if name.split('/')[0] not in SKIP_NAMES | {'src', 'tests'}}  # crate-local words
    workspace_deps = (keys.manifest(repo, tree, '.').get('workspace') or {}).get('dependencies') or {}
    cache = {}
    result = {}
    for name, directory in sorted(members.items()):
        owned = keys.closure(repo, tree, directory, workspace_deps, cache)
        roots = [path for member_dir in owned for path in keys.source_paths(member_dir)]
        own_sources = [f for f in files if f.endswith('.rs') and (f.startswith(directory + '/') or directory == '.' and f.split('/')[0] in keys.ROOT_PACKAGE_PATHS)]
        names = set()
        for source in own_sources:
            text = subprocess.run(['git', '-C', str(repo), 'cat-file', 'blob', f'{tree}:{source}'], capture_output=True, check=True).stdout.decode(errors='replace')
            names |= named_paths(source, text, directory, files, file_set, directories, tops)
        extra = sorted(path for path in names if not inside(path, roots) and not inside(path, GLOBAL) and path not in GLOBAL)
        # A directory and a file below it: keep the directory.
        extra = [path for path in extra if not any(path != other and path.startswith(other + '/') for other in extra)]
        result[name] = extra
    inputs['crates'] = {name: {'extra': extra} for name, extra in result.items()}
    return inputs


def covered(path, declared):
    return any(path == d or path.startswith(d.rstrip('/') + '/') or d == '.' for d in declared)


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('--repo', default='.')
    parser.add_argument('--tree', default='HEAD')
    parser.add_argument('--write', metavar='FILE')
    parser.add_argument('--check', metavar='FILE')
    args = parser.parse_args(argv)
    tree = subprocess.run(['git', '-C', args.repo, 'rev-parse', '--verify', args.tree + '^{tree}'], capture_output=True, text=True, check=True).stdout.strip()
    try:
        scanned = scan(args.repo, tree)
    except keys.Failure as error:
        print(f'rust-test-inputs-scan: {error}', file=sys.stderr)
        return 2
    if args.write:
        target = Path(args.write)
        if target.exists():  # the reviewed list of crates with no test is not something a scan can find: keep it
            try:
                scanned['no_tests'] = json.loads(target.read_text()).get('no_tests', [])
            except (ValueError, AttributeError):
                pass
        target.write_text(json.dumps(scanned, indent=1) + '\n')
        return 0
    if args.check:
        committed = json.loads(Path(args.check).read_text())
        missing = []
        for name, entry in scanned['crates'].items():
            have = (committed.get('crates', {}).get(name) or {}).get('extra')
            if have is None:
                continue  # unreviewed: keyed by the whole tree, which covers everything
            missing += [f'{name}: {path}' for path in entry['extra'] if not covered(path, list(have) + list(committed.get('global', [])))]
        for line in missing:
            print(f'not covered by the declared extras: {line}')
        return 1 if missing else 0
    print(json.dumps(scanned, indent=1))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
