[Unit]
Description=Evidence log: copy every trusted evidence record to this host and append it to the signed log (scripts/evidence-log)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/run/current-system/sw/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/evidence-log/env
ExecStart=/usr/bin/env bash %h/.local/bin/evidence-log-timer pull
# 2h, not 30min (Operations, Factory GO 2026-11-02). After hetz2 was down 19 h the pull needed 49 min 44 s (49 min 20 s CPU, 693 MB) to add 21,552
# records; at 30 min it was killed twice and the log stayed stale. The timer never starts a second run while this one is active, so a long limit
# only lets a big backlog catch up without hand work. Measured after the catch-up: the next runs took 4 min (50 min of records) and then 33 s.
TimeoutStartSec=2h
Nice=5
