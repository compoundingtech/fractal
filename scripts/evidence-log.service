[Unit]
Description=Evidence log: copy every trusted evidence record to this host and append it to the signed log (scripts/evidence-log)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/run/current-system/sw/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/evidence-log/env
ExecStart=/usr/bin/env bash %h/.local/bin/evidence-log-timer pull
TimeoutStartSec=30min
Nice=5
