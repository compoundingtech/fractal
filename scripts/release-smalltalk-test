#!/usr/bin/env python3
"""Exercise the real Cargo stamp with the files present on warm release runners."""
import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile

repo = Path(__file__).resolve().parent.parent


def run(*args, cwd):
    return subprocess.check_output(args, cwd=cwd, text=True).strip()


with tempfile.TemporaryDirectory() as temporary:
    root = Path(temporary)
    checkout = root / 'checkout'
    checkout.mkdir()
    shutil.copy(repo / '.gitignore', checkout / '.gitignore')
    shutil.copy(repo / 'build.rs', checkout / 'build.rs')
    run('git', 'init', '-q', cwd=checkout)
    run('git', 'add', '.', cwd=checkout)
    run('git', '-c', 'user.name=Example', '-c', 'user.email=example@example.invalid',
        '-c', 'commit.gpgsign=false', '-c', 'core.hooksPath=/dev/null',
        'commit', '-qm', 'Release fixture', cwd=checkout)
    stamp_binary = root / 'build-stamp'
    run('rustc', '--edition=2024', str(checkout / 'build.rs'), '-o', str(stamp_binary), cwd=root)
    revision = run('git', 'rev-parse', '--short', 'HEAD', cwd=checkout)

    def stamp(version='0.1.0'):
        output = subprocess.check_output([str(stamp_binary)], cwd=checkout, text=True,
                                         env=dict(os.environ, CARGO_PKG_VERSION=version))
        prefix = 'cargo:rustc-env=ST_BUILD_STAMP_LOCAL='
        return json.loads(next(line[len(prefix):] for line in output.splitlines()
                               if line.startswith(prefix)))

    assert stamp()['dirty'] is False
    # setup-zig restores this before Cargo runs. A previous archive or Cargo cache
    # must also leave a clean source stamp on a subsequent release build.
    for directory in ('.zig-cache', 'dist', 'target', 'scripts/__pycache__'):
        (checkout / directory).mkdir(parents=True)
        (checkout / directory / 'cached-output').write_text('generated bytes\n')
    cached = stamp()
    assert cached['dirty'] is False, cached
    assert cached['rev'] == revision, cached
    assert run('git', 'status', '--porcelain', cwd=checkout) == ''
    # Ignoring generated outputs must still detect actual source changes.
    (checkout / 'build.rs').write_text('// changed source\n')
    assert stamp()['dirty'] is True
    shutil.copy(repo / 'build.rs', checkout / 'build.rs')
    (checkout / 'new-source.rs').write_text('// untracked source\n')
    assert stamp()['dirty'] is True
    # Git abbreviations can expand to a full hash. Test the actual emitted stamp at
    # the byte boundary, with the dirty suffix included, before a binary can exist.
    run('git', 'config', 'core.abbrev', '40', cwd=checkout)
    maximal = stamp('0.1.0-' + 'x' * 69)
    assert maximal['dirty'] is True and len(maximal['rev']) == 40
    assert len(('0.1.0-' + 'x' * 69 + '+local.' + maximal['rev'] + '.dirty').encode()) == 128
    for version in ['0.1.0-' + 'x' * 70, '0.1.0-' + 'é' * 35]:
        failed = subprocess.run([str(stamp_binary)], cwd=checkout, text=True,
                                env=dict(os.environ, CARGO_PKG_VERSION=version),
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        assert failed.returncode != 0 and 'exceeds 128 bytes' in failed.stderr, failed
        assert 'cargo:rustc-env=ST_BUILD_STAMP_LOCAL=' not in failed.stdout

print('Native release build stamp tests passed')
