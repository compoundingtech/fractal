#!/usr/bin/env python3
"""The evidence log: a copy of every trusted evidence record on a host we hold, and a signed, append-only list of them.

  scripts/evidence-log pull --repo DIR --signer JSON_ARGV --log-keys FILE [--remote origin] [--main origin/main]
                            [--publish] [--restore] [--now UNIX]
  scripts/evidence-log gc   --repo DIR --signer JSON_ARGV --log-keys FILE --plan FILE [--now UNIX]

GitHub is only the transport. One `pull` (scripts/evidence-log.timer runs it every 2 minutes):
  1. fetches main (for `.st/evidence-keys`), every evidence record and index ref (into `refs/evidence-seen/`, pruned, so it is
     what the remote holds now; with full history, so the copy is never shallow and a record can be pushed back), and the
     published log head;
  2. accepts each record it has not logged yet if it is well formed and signed by a key that main's `.st/evidence-keys` trusts
     for the signer it names, and keeps it under `refs/evidence-copy/` (never pruned: GitHub losing it does not lose it here);
  3. appends one line per accepted record and check to the log, and one per accepted input-index ref;
  4. commits the log, ALWAYS, even with nothing new: the commit's message carries its time, and a verifier refuses a head older
     than its bound, so a deleted or rewound log costs skips and never makes an old one count;
  5. with --publish, pushes the head to `refs/evidence-log/main` on the remote; with --restore, pushes back any logged record
     the remote no longer has (and reports it: `missing`).
`gc` appends a GC line for every tree and input key of an evidence-gc plan (`--plan-out`) and drops their copies: run it BEFORE
the plan's deletions, so a pull does not restore what GC removed.

THE LOG is a chain of commits signed with the log key (`--signer` signs stdin to an SSH signature on stdout, for example
["ssh-keygen", "-Y", "sign", "-n", "git", "-f", KEY], or the same through `st sekrets`, so no seat reads the key). Its tree:
  trees/<tree[:2]>/<tree>              record <record> <check> <exit_code> <signer> <observed_at>   one per record and check
  keys/<check>/<key[:2]>/<key>         record <record> <check> <exit_code> <signer> <observed_at>   one per input-index ref
                                       gc <time> <plan sha256>                                        GC removed what came before
A verifier reads one file at the head and needs nothing else. Before extending the chain a pull checks that the current head is
signed by a key in --log-keys (principal log/...), so a head that is not ours is never extended.

  exit 0  done    exit 1  a step failed    exit 2  usage    exit 4  logged records are missing on the remote (an alarm)
"""
import argparse
import datetime
import fcntl
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import tempfile
import time

sys.dont_write_bytecode = True

OID = re.compile(r'^(?:[0-9a-f]{40}|[0-9a-f]{64})$')
CHECK = re.compile(r'^[A-Za-z0-9._-]+$')
TOKEN = re.compile(r'^[^\s]+$')
SOURCES = {'refs/tags/evidence/': 'tags/', 'refs/notes/evidence/': 'notes/', 'refs/notes/evidence-input/': 'notes-input/'}
SEEN = 'refs/evidence-seen/'
COPY = 'refs/evidence-copy/'
LOG = 'refs/evidence-log/main'
REMOTE_LOG = 'refs/evidence-log/remote'
IDENTITY = 'evidence-log <evidence-log@invalid>'
LOADER_PREFIXES = ('LD_', 'DYLD_', 'PYTHON')
LOADER_VARIABLES = ('GLIBC_TUNABLES', 'GCONV_PATH', 'NLSPATH')


class Refused(Exception):
    pass


class Usage(Refused):
    pass


def git(repo, *args, stdin=None, check=True, env=None, config=()):
    clean = {k: v for k, v in os.environ.items() if not k.startswith('GIT_')}
    clean.update(env or {})
    # No automatic maintenance: a detached `git maintenance run --auto` after one fetch rewrote the shallow file while the next
    # fetch ran ("shallow file has changed since we read it").
    command = ['git', '-C', repo, '-c', 'core.hooksPath=/dev/null', '-c', 'gpg.format=ssh', '-c', 'maintenance.auto=false', '-c', 'gc.auto=0']
    for item in config:
        command += ['-c', item]
    done = subprocess.run([*command, *args], input=stdin, capture_output=True, timeout=1800,
                          env=dict(clean, GIT_NO_REPLACE_OBJECTS='1', GIT_NO_LAZY_FETCH='1', GIT_TERMINAL_PROMPT='0', LC_ALL='C'))
    if check and done.returncode != 0:
        raise Refused(f'git {args[0]}: {done.stderr.decode(errors="replace").strip()[-300:]}')
    return done


def verifier():
    here = os.path.dirname(os.path.abspath(__file__))
    loader = importlib.machinery.SourceFileLoader('evidence_verify_for_log', os.path.join(here, 'evidence-verify'))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


def iso(unix):
    return datetime.datetime.fromtimestamp(unix, datetime.timezone.utc).isoformat()


def refs(repo, prefix):
    out = git(repo, 'for-each-ref', '--format=%(objectname) %(refname)', prefix).stdout.decode().split('\n')
    return {line.split()[1]: line.split()[0] for line in out if len(line.split()) == 2}


def original(name, base):
    """refs/evidence-seen/tags/evidence/... -> refs/tags/evidence/...: the remote's name of a local copy."""
    rest = name[len(base):]
    for remote, local in SOURCES.items():
        if rest.startswith(local):
            return remote + rest[len(local):]
    return None


def local(name, base):
    """refs/tags/evidence/... -> refs/evidence-copy/tags/evidence/...: the inverse of original()."""
    for remote, prefix in SOURCES.items():
        if name.startswith(remote):
            return base + prefix + name[len(remote):]
    raise Refused(f'not an evidence ref: {name}')


def parse(name):
    """('record', tree, oid) or ('index', check, key, oid) for a well-formed evidence ref name, else None."""
    for prefix in ('refs/tags/evidence/input/', 'refs/notes/evidence-input/'):
        if name.startswith(prefix):
            parts = name[len(prefix):].split('/')
            return ('index', *parts) if len(parts) == 3 and CHECK.match(parts[0]) and OID.match(parts[1]) and OID.match(parts[2]) else None
    for prefix in ('refs/tags/evidence/', 'refs/notes/evidence/'):
        if name.startswith(prefix):
            parts = name[len(prefix):].split('/')
            return ('record', *parts) if len(parts) == 2 and OID.match(parts[0]) and OID.match(parts[1]) else None
    return None


def path_of(kind):
    if kind[0] == 'record':
        return f'trees/{kind[1][:2]}/{kind[1]}'
    return f'keys/{kind[1]}/{kind[2][:2]}/{kind[2]}'


def accept(repo, module, keys, revocations, name, oid):
    """(lines, why not): the log lines a ref earns, or the reason it earns none."""
    kind = parse(name)
    if kind is None or kind[-1] != oid:
        return [], 'malformed'
    statement = module.load(repo, oid, kind[1] if kind[0] == 'record' else None)
    if statement is None:
        return [], 'malformed'
    predicate = statement['predicate']
    if predicate['tier'] != 'full':
        return [], 'not_full'
    status, principal = module.signature(repo, oid, keys, revocations)
    if status != 'G' or not principal or principal != predicate['signer']:
        return [], 'untrusted'
    checks = predicate['observed']['checks']
    if kind[0] == 'index':
        if kind[1] not in checks or predicate['observed'].get('inputs', {}).get('source_inputs') != kind[2]:
            return [], 'malformed'
        checks = {kind[1]: checks[kind[1]]}
    lines = []
    for check, result in sorted(checks.items()):
        if CHECK.match(check) and TOKEN.match(principal) and TOKEN.match(predicate['observed_at']):
            lines.append(f'record {oid} {check} {result["exit_code"]} {principal} {predicate["observed_at"]}')
    return lines, None if lines else 'malformed'


def scrubbed(argv):
    if not argv or not all(isinstance(a, str) for a in argv):
        raise Usage('--signer must be a JSON array of strings')
    env = {k: v for k, v in os.environ.items() if not k.startswith(LOADER_PREFIXES) and k not in LOADER_VARIABLES}
    return argv, env


def commit(repo, tree, parent, message, signer, now):
    """A commit object signed by the log key, written by hand: git signs a file, and the key may live where no file of ours is."""
    stamp = f'{int(now)} +0000'
    body = f'tree {tree}\n' + (f'parent {parent}\n' if parent else '') + f'author {IDENTITY} {stamp}\ncommitter {IDENTITY} {stamp}\n\n{message}\n'
    argv, env = scrubbed(signer)
    try:
        done = subprocess.run(argv, input=body.encode(), capture_output=True, timeout=120, env=env)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise Refused(f'the log signer did not run: {error}')
    signature = done.stdout.decode(errors='replace').strip()
    if done.returncode != 0 or not signature.startswith('-----BEGIN SSH SIGNATURE-----'):
        raise Refused(f'the log signer failed: {done.stderr.decode(errors="replace").strip()[-300:]}')
    head, _, rest = body.partition('\n\n')
    signed = head + '\ngpgsig ' + signature.replace('\n', '\n ') + '\n\n' + rest
    return git(repo, 'hash-object', '-t', 'commit', '-w', '--stdin', stdin=signed.encode()).stdout.decode().strip()


def log_signed(repo, oid, log_keys):
    shown = git(repo, 'show', '-s', '--format=%G?%x00%GS', oid, config=[f'gpg.ssh.allowedSignersFile={log_keys}'], check=False)
    status, _, principal = shown.stdout.decode().strip('\n').partition('\0')
    return status == 'G' and principal.startswith('log/')


def extend(repo, additions, removals, signer, log_keys, now, summary):
    """Append `additions` {path: [lines]} (and a gc line for each path in `removals`) to the log and commit, signed."""
    head = refs(repo, LOG).get(LOG)
    if head and not log_signed(repo, head, log_keys):
        raise Refused(f'the local log head {head} is not signed by a key in --log-keys: refusing to extend it')
    touched = sorted(set(additions) | set(removals))
    current = {}
    if head and touched:
        for path in touched:
            shown = git(repo, 'cat-file', 'blob', f'{head}:{path}', check=False)
            current[path] = shown.stdout.decode().splitlines() if shown.returncode == 0 else []
    with tempfile.TemporaryDirectory() as scratch:
        env = {'GIT_INDEX_FILE': os.path.join(scratch, 'index')}
        if head:
            git(repo, 'read-tree', head, env=env)
        info = []
        for path in touched:
            lines = list(current.get(path, []))
            for line in additions.get(path, []):
                if line not in lines[lines_after_gc(lines):]:
                    lines.append(line)
            if path in removals:
                lines.append(removals[path])
            blob = git(repo, 'hash-object', '-w', '--stdin', stdin=''.join(f'{line}\n' for line in lines).encode()).stdout.decode().strip()
            info.append(f'100644 {blob}\t{path}\n')
        if info:
            git(repo, 'update-index', '--add', '--index-info', stdin=''.join(info).encode(), env=env)
        tree = git(repo, 'write-tree', env=env).stdout.decode().strip()
    message = (f'evidence-log v1 as_of={iso(now)} added={summary.get("added", 0)} gc={len(removals)} '
               f'missing={len(summary.get("missing", []))}')
    new = commit(repo, tree, head, message, signer, now)
    git(repo, 'update-ref', LOG, new, *([head] if head else []))
    summary['head'] = new
    summary['as_of'] = iso(now)
    return new


def lines_after_gc(lines):
    """The index of the first line after the last gc line: what still has to exist."""
    for index in range(len(lines) - 1, -1, -1):
        if lines[index].startswith('gc '):
            return index + 1
    return 0


def locked(repo):
    handle = open(os.path.join(repo, 'evidence-log.lock'), 'w')
    fcntl.flock(handle, fcntl.LOCK_EX)
    return handle


def pull(args):
    repo, remote, summary = args.repo, args.remote, {'mode': 'pull'}
    module = verifier()
    remote_main = args.main.split('/', 1)[-1]
    listed = git(repo, 'ls-remote', remote, *[f'{prefix}*' for prefix in SOURCES], LOG, f'refs/heads/{remote_main}').stdout.decode().split('\n')
    there = {line.split()[1]: line.split()[0] for line in listed if len(line.split()) == 2 and OID.match(line.split()[0])}
    published = there.pop(LOG, None)
    main_tip = there.pop(f'refs/heads/{remote_main}', None)
    if main_tip != refs(repo, f'refs/remotes/{args.main}').get(f'refs/remotes/{args.main}'):
        git(repo, 'fetch', '--no-tags', '-q', remote, f'+refs/heads/{remote_main}:refs/remotes/{args.main}')
    keys_text = git(repo, 'show', f'{args.main}:.st/evidence-keys').stdout
    # refs/evidence-seen is exactly what the remote holds now. Only refs whose object is new are fetched, by name: a glob fetch
    # negotiates every ref (9 s for 5,000, against 0.6 s for the listing). With full history, never shallow: a shallow copy sends
    # every shallow root on every fetch (13 s to fetch 20 records into a copy of 5,000), and a restore from it is refused as a
    # shallow update. The history is main's, which the copy holds anyway, and the commits pull requests tested.
    seen_now = {original(ref, SEEN): oid for ref, oid in refs(repo, SEEN).items()}
    wanted = sorted(name for name, oid in there.items() if seen_now.get(name) != oid)
    present = set()
    if wanted:
        out = git(repo, 'cat-file', '--batch-check=%(objectname) %(objecttype)', stdin=''.join(f'{there[n]}\n' for n in wanted).encode()).stdout.decode()
        present = {line.split()[0] for line in out.splitlines() if line.endswith(' commit')}  # a missing one reads "<oid> missing"
    fetch = [name for name in wanted if there[name] not in present]
    for start in range(0, len(fetch), 500):
        git(repo, 'fetch', '--no-tags', '-q', remote, *[f'+{name}:{local(name, SEEN)}' for name in fetch[start:start + 500]])
    commands = ''.join(f'update {local(name, SEEN)} {there[name]}\n' for name in wanted if there[name] in present)
    commands += ''.join(f'delete {local(name, SEEN)}\n' for name in seen_now if name and name not in there)
    if commands:
        git(repo, 'update-ref', '--stdin', stdin=commands.encode())
    if published and published != refs(repo, REMOTE_LOG).get(REMOTE_LOG):
        git(repo, 'fetch', '--no-tags', '-q', remote, f'+{LOG}:{REMOTE_LOG}', check=False)
    seen = {original(ref, SEEN): oid for ref, oid in refs(repo, SEEN).items()}
    copied = {original(ref, COPY): oid for ref, oid in refs(repo, COPY).items()}
    additions, rejected, new_copies = {}, {}, []
    with tempfile.NamedTemporaryFile() as keys, tempfile.NamedTemporaryFile() as revocations:
        keys.write(keys_text)
        keys.flush()
        for name, oid in sorted(seen.items()):
            if name is None or copied.get(name) == oid:
                continue
            lines, why = accept(repo, module, keys.name, revocations.name, name, oid)
            if why:
                rejected[why] = rejected.get(why, 0) + 1
                continue
            additions.setdefault(path_of(parse(name)), []).extend(lines)
            new_copies.append((name, oid))
    if new_copies:
        git(repo, 'update-ref', '--stdin', stdin=''.join(f'update {local(name, COPY)} {oid}\n' for name, oid in new_copies).encode())
    summary.update(added=len(new_copies), rejected=rejected)
    summary['missing'] = sorted(name for name, oid in copied.items() if name and seen.get(name) != oid)
    published_head = refs(repo, REMOTE_LOG).get(REMOTE_LOG)
    local_head = refs(repo, LOG).get(LOG)
    if published_head and local_head and published_head != local_head:
        summary['published_head_differs'] = published_head  # someone else moved it, or our last publish failed: ours wins
    extend(repo, additions, {}, args.signer_argv, args.log_keys, args.now, summary)
    git(repo, 'pack-refs', '--all')  # thousands of loose refs made one for-each-ref take 7 s
    status = 0
    if args.restore and summary['missing']:
        pushed = git(repo, 'push', '--porcelain', remote, *[f'{copied[name]}:{name}' for name in summary['missing']], check=False)
        summary['restored'] = pushed.returncode == 0
        if pushed.returncode != 0:
            summary['restore_failed'] = (pushed.stdout + pushed.stderr).decode(errors='replace').strip()[-300:]
    if summary['missing']:
        status = 4
    if args.publish:
        done = git(repo, 'push', '--porcelain', remote, f'+{LOG}:{LOG}', check=False)
        summary['published'] = done.returncode == 0
        if done.returncode != 0:
            summary['publish_failed'] = (done.stdout + done.stderr).decode(errors='replace').strip()[-300:]
            status = status or 1
    return status, summary


def gc(args):
    with open(args.plan) as handle:
        plan = json.load(handle)
    if not isinstance(plan.get('trees'), list) or not isinstance(plan.get('keys'), list) or not isinstance(plan.get('plan_sha256'), str):
        raise Usage('--plan must be the output of evidence-gc --plan-out (trees, keys, plan_sha256)')
    line = f'gc {iso(args.now)} {plan["plan_sha256"]}'
    removals = {}
    for tree in plan['trees']:
        if OID.match(tree):
            removals[path_of(('record', tree))] = line
    for check, key in plan['keys']:
        if CHECK.match(check) and OID.match(key):
            removals[path_of(('index', check, key))] = line
    summary = {'mode': 'gc', 'gc_paths': len(removals)}
    extend(args.repo, {}, removals, args.signer_argv, args.log_keys, args.now, summary)
    # Drop the copies of what GC removes, so a pull does not restore them and the copy stays as bounded as the remote.
    doomed = []
    for name in refs(args.repo, COPY):
        kind = parse(original(name, COPY) or '')
        if kind and path_of(kind) in removals:
            doomed.append(name)
    if doomed:
        git(args.repo, 'update-ref', '--stdin', stdin=''.join(f'delete {ref}\n' for ref in doomed).encode())
    summary['copies_dropped'] = len(doomed)
    return 0, summary


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('mode', choices=('pull', 'gc'))
    parser.add_argument('--repo', required=True, help='the bare repository this host keeps')
    parser.add_argument('--remote', default='origin')
    parser.add_argument('--main', default='origin/main')
    parser.add_argument('--signer', required=True, help='JSON argv that signs stdin and prints an SSH signature')
    parser.add_argument('--log-keys', required=True, help='allowed-signers file of the log key (principal log/...)')
    parser.add_argument('--publish', action='store_true')
    parser.add_argument('--restore', action='store_true')
    parser.add_argument('--plan', help='gc: the evidence-gc --plan-out file')
    parser.add_argument('--now', type=int, default=None, help='unix time (tests)')
    try:
        args = parser.parse_args(argv)
    except SystemExit as error:
        return 2 if error.code else 0
    try:
        args.signer_argv = json.loads(args.signer)
        scrubbed(args.signer_argv)
    except (ValueError, Usage) as error:
        print(f'evidence-log: --signer must be a JSON array of strings ({error})', file=sys.stderr)
        return 2
    if args.mode == 'gc' and not args.plan:
        print('evidence-log: gc needs --plan', file=sys.stderr)
        return 2
    args.now = args.now if args.now is not None else int(time.time())
    # Never a lazy fetch (git() sets it too; this is for the verifier's own git calls): in a partial clone a presence check of a
    # missing record fetches it with no negotiation, that is with its whole history (seen: 3.4 GB before the first record was
    # logged). Every fetch here is explicit, and nothing here makes the copy a partial clone.
    os.environ['GIT_NO_LAZY_FETCH'] = '1'
    try:
        with locked(args.repo):
            status, summary = (pull if args.mode == 'pull' else gc)(args)
        print(json.dumps(summary, indent=2))
        return status
    except Refused as error:
        print(f'evidence-log: {error}', file=sys.stderr)
        return 2 if isinstance(error, Usage) else 1


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
