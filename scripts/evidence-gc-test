#!/usr/bin/env python3
"""scripts/evidence-gc against real repositories and signed notes: the keep/delete matrix, migration of the first layout, the input-key
index, the soft limit and the cap, fail-closed on an unresolved head, a remote, and idempotence. An open pull request head is never deleted.
gc_plan itself is checked as a pure function: random worlds, any input order, whole trees only, and no verdict of a kept tree changes."""
import importlib.machinery
import importlib.util
import json
import os
import random
import signal
from pathlib import Path
import subprocess
import sys
import time
import unittest

# Fixture repositories must not inherit a developer's hooks, identity or signing settings, even outside ci-script-tests.
os.environ.update(GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_NOSYSTEM='1')

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
GC = ROOT / 'scripts/evidence-gc'
TIMER = ROOT / 'scripts/evidence-gc-timer'
gc_loader = importlib.machinery.SourceFileLoader('evidence_gc_test_module', str(GC))
evidence_gc = importlib.util.module_from_spec(importlib.util.spec_from_loader(gc_loader.name, gc_loader))
gc_loader.exec_module(evidence_gc)
loader = importlib.machinery.SourceFileLoader('evidence_verify_test', str(ROOT / 'scripts/evidence-verify-test'))
support = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(support)
Fixture, evidence_verify = support.Fixture, support.evidence_verify
DAY = 86400
NOW = 1_800_000_000
RETENTION = {'version': 1, 'main_days': 3, 'branch_days': 60, 'grace_hours': 24, 'soft_records': 3000, 'cap_records': 5000}


class At:
    """Run git inside with its dates `days_ago` days before NOW, so commits and notes have controllable ages."""

    def __init__(self, days_ago):
        self.stamp = f'{NOW - int(days_ago * DAY)} +0000'

    def __enter__(self):
        self.saved = {k: os.environ.get(k) for k in ('GIT_COMMITTER_DATE', 'GIT_AUTHOR_DATE')}
        os.environ['GIT_COMMITTER_DATE'] = os.environ['GIT_AUTHOR_DATE'] = self.stamp

    def __exit__(self, *exc):
        for key, value in self.saved.items():
            os.environ.pop(key, None)
            if value is not None:
                os.environ[key] = value


class Gc(unittest.TestCase):
    def setUp(self):
        self.f = Fixture()
        self.addCleanup(self.f.tmp.cleanup)
        self.ci = self.f.key('ci', 'machine/ci1')
        (self.f.repo / 'src').mkdir()
        (self.f.repo / '.st').mkdir()
        (self.f.repo / '.st/evidence-skip-policy.json').write_text(support.policy_text(inputs=['src']))
        self.n = 0
        self.main_commits = []
        self.f.git('checkout', '-q', '-b', 'main')

    def land(self, days_ago):
        """A commit on main `days_ago` days old that changes src/, so its tree and its input key are new."""
        self.n += 1
        with At(days_ago):
            (self.f.repo / 'src/a.txt').write_text(f'main {self.n}\n')
            self.f.git('add', '-A')
            self.f.git('commit', '-q', '-m', f'main {self.n}')
            commit, tree = self.f.git('rev-parse', 'HEAD'), self.f.git('rev-parse', 'HEAD^{tree}')
        self.main_commits.append((commit, tree))
        return commit, tree

    def branch_commit(self, days_ago, content=None):
        """A commit off main's tip that is not on main (a pull request head)."""
        self.n += 1
        tip = self.f.git('rev-parse', 'main')
        self.f.git('checkout', '-q', '--detach', tip)
        with At(days_ago):
            (self.f.repo / 'src/b.txt').write_text(content or f'pr {self.n}\n')
            self.f.git('add', '-A')
            self.f.git('commit', '-q', '-m', f'pr {self.n}')
            commit, tree = self.f.git('rev-parse', 'HEAD'), self.f.git('rev-parse', 'HEAD^{tree}')
        self.f.git('checkout', '-q', 'main')
        return commit, tree

    def record(self, commit, tree, days_ago, layout='tree'):
        self.f.layout = layout
        with At(days_ago):
            return self.f.note(commit, tree, self.ci, 'machine/ci1', check='unit', seconds=self.n)

    def index(self, check, tree, record, paths=('src',)):
        key = evidence_verify.project(str(self.f.repo), tree, list(paths))
        ref = f'refs/notes/evidence-input/{check}/{key}/{record}'
        self.f.git('update-ref', ref, record)
        return ref

    def both(self, commit, tree, days_ago):
        """A record filed the way producers file it during the move to tags: as a tag and as a note naming the same commit."""
        record = self.record(commit, tree, days_ago)
        self.f.git('update-ref', f'refs/tags/evidence/{tree}/{record}', record)
        return record

    def index_both(self, check, tree, record):
        ref = self.index(check, tree, record)
        tag = 'refs/tags/evidence/input/' + ref[len('refs/notes/evidence-input/'):]
        self.f.git('update-ref', tag, record)
        return ref, tag

    def refs(self, prefix='refs/notes'):
        return set(self.f.git('for-each-ref', '--format=%(refname)', prefix).splitlines())

    def retention(self, **changes):
        path = self.f.root / f'retention-{len(changes)}-{abs(hash(tuple(sorted(changes.items()))))}.json'
        path.write_text(json.dumps({**RETENTION, **changes}))
        return str(path)

    def run_gc(self, *args, repo=None):
        base = ['--repo', str(repo or self.f.repo), '--main', 'main', '--as-of', str(NOW)]
        if '--retention' not in args:
            base += ['--retention', self.retention()]
        done = subprocess.run([sys.executable, str(GC), *base, *args], capture_output=True, text=True,
                              env={k: v for k, v in os.environ.items() if k != 'EVIDENCE_PUSH_TOKEN'})
        return done.returncode, (json.loads(done.stdout) if done.stdout.strip() else None), done.stderr

    def world(self):
        """main: an old commit (20 d) and a recent one (1 d); one open pull request head that is 30 days old."""
        self.f.git('add', '-A')
        with At(40):
            self.f.git('commit', '-q', '-m', 'base')
        old = self.land(20)
        recent = self.land(1)
        pr = self.branch_commit(30)
        return old, recent, pr

    def test_the_keep_and_delete_matrix(self):
        old, recent, pr = self.world()
        head_old = self.record(pr[0], pr[1], 29)        # a note 29 days old, but for the CURRENT head of an open PR: kept
        main_recent = self.record(recent[0], recent[1], 5)  # a 5-day-old note for a tree of main within the window: kept
        main_old = self.record(old[0], old[1], 19)      # the tree left the window 17 days ago: deleted
        superseded = self.record(old[0], 'a' * 40, 10)  # a note for a head that was force-pushed away: deleted
        recent_unprotected = self.record(old[0], 'b' * 40, 0.1)  # written two hours ago for a tree nobody listed: kept for the grace period
        first_layout_head = self.record(pr[0], pr[1], 28, layout='legacy')  # the first layout, for an open head: migrated
        first_layout_old = self.record(old[0], 'c' * 40, 27, layout='legacy')  # the first layout, unprotected: deleted
        foreign = 'refs/notes/other/x'
        self.f.git('update-ref', foreign, head_old)
        code, result, _ = self.run_gc('--head', pr[0], '--apply')
        self.assertEqual(code, 0, result)
        names = self.refs('refs/notes/evidence')
        want = {f'refs/notes/evidence/{pr[1]}/{head_old}', f'refs/notes/evidence/{pr[1]}/{first_layout_head}',
                f'refs/notes/evidence/{recent[1]}/{main_recent}', f'refs/notes/evidence/{"b" * 40}/{recent_unprotected}'}
        self.assertEqual(names, want, result)
        self.assertIn(foreign, self.refs(), 'a ref outside the two namespaces is never touched')
        reasons = result['reasons']
        self.assertEqual(reasons['kept: branch-tip'], 2)
        self.assertEqual(reasons['migrated: first layout to tree-prefixed'], 1)
        self.assertEqual(reasons['kept: main-window'], 1)
        self.assertEqual(reasons['kept: grace'], 1)
        self.assertEqual(reasons['deleted: dead tree'], 3)
        self.assertEqual((result['trees_deleted'], result['live_trees']), (3, {'branch_tips': 1, 'open_pull_requests': 0, 'main_window': 1}))
        self.assertEqual((result['refs_before'], result['refs_after']), (7, 4))
        self.assertLess(result['advertised_bytes_after'], result['advertised_bytes_before'])
        for gone in (main_old, superseded, first_layout_old):
            self.assertFalse([n for n in names if n.endswith(gone)], gone)

    def test_the_open_pull_request_head_still_verifies_after_the_first_layout_is_migrated(self):
        old, recent, pr = self.world()
        record = self.record(pr[0], pr[1], 29, layout='legacy')
        self.assertEqual(self.f.verify(pr[1])[0], 0)
        self.assertEqual(self.run_gc('--head', pr[0], '--apply')[0], 0)
        self.assertEqual(self.refs('refs/notes/evidence'), {f'refs/notes/evidence/{pr[1]}/{record}'})
        code, result = self.f.verify(pr[1])
        self.assertEqual((code, result['record']), (0, record))

    def test_a_dry_run_changes_nothing_and_says_what_it_would_do(self):
        old, recent, pr = self.world()
        self.record(old[0], 'a' * 40, 10)
        self.record(pr[0], pr[1], 28, layout='legacy')
        before = self.refs()
        code, result, _ = self.run_gc('--head', pr[0])
        self.assertEqual(code, 0)
        self.assertEqual(result['mode'], 'dry-run')
        self.assertEqual(result['reasons']['deleted: dead tree'], 1)
        self.assertEqual(self.refs(), before)

    def test_an_input_index_ref_survives_only_while_a_protected_head_has_its_key(self):
        old, recent, pr = self.world()
        head_record = self.record(pr[0], pr[1], 29)
        shared = self.index('unit', pr[1], head_record)  # the key the open head projects to: kept
        stale_record = self.record(old[0], old[1], 25)
        stale = self.index('unit', old[1], stale_record)  # a key no protected head has: removed
        code, result, _ = self.run_gc('--head', pr[0], '--apply')
        self.assertEqual(code, 0, result)
        self.assertEqual(self.refs('refs/notes/evidence-input'), {shared})
        self.assertEqual(result['reasons']['kept: input-key'], 1)
        self.assertEqual(result['reasons']['deleted: dead input key'], 1)
        self.assertNotIn(stale, self.refs())

    def crates(self, broken_pr=False):
        """A two-crate workspace on main (b depends on a), keyed by main's scripts/rust-test-keys, and the commits whose crate keys matter:
        an old main commit (20 d, outside main_days), a recent one (1 d), and an open pull request head that changes only crate b."""
        (self.f.repo / 'scripts').mkdir(exist_ok=True)
        (self.f.repo / 'scripts/rust-test-keys').write_bytes((ROOT / 'scripts/rust-test-keys').read_bytes())
        (self.f.repo / 'Cargo.toml').write_text('[workspace]\nmembers = ["crates/a", "crates/b"]\n')
        for name, extra in (('a', ''), ('b', '\n[dependencies]\na = { path = "../a" }\n')):
            (self.f.repo / f'crates/{name}/src').mkdir(parents=True)
            (self.f.repo / f'crates/{name}/Cargo.toml').write_text(f'[package]\nname = "{name}"\nversion = "0.1.0"\n{extra}')
            (self.f.repo / f'crates/{name}/src/lib.rs').write_text('// 0\n')
        (self.f.repo / '.st/rust-test-inputs.json').write_text(json.dumps({'global': ['Cargo.toml'], 'crates': {'a': {'extra': []}, 'b': {'extra': []}}}))
        self.f.git('add', '-A')
        with At(40):
            self.f.git('commit', '-q', '-m', 'base')

        def change(path, days_ago, branch=False):
            self.n += 1
            tip = self.f.git('rev-parse', 'main')
            if branch:
                self.f.git('checkout', '-q', '--detach', tip)
            with At(days_ago):
                (self.f.repo / path).write_text(f'// {self.n}\n')
                self.f.git('add', '-A')
                self.f.git('commit', '-q', '-m', f'change {self.n}')
                commit, tree = self.f.git('rev-parse', 'HEAD'), self.f.git('rev-parse', 'HEAD^{tree}')
            if branch:
                self.f.git('checkout', '-q', 'main')
            return commit, tree

        old = change('crates/a/src/lib.rs', 20)
        recent = change('crates/a/src/lib.rs', 1)
        pr = change('crates/b/Cargo.toml' if broken_pr else 'crates/b/src/lib.rs', 30, branch=True)
        return old, recent, pr

    def crate_key(self, tree, crate):
        done = subprocess.run([sys.executable, str(ROOT / 'scripts/rust-test-keys'), '--repo', str(self.f.repo), '--tree', tree,
                               '--inputs-from', 'main', '--json'], capture_output=True, text=True, check=True)
        return json.loads(done.stdout)[crate]

    def crate_index(self, commit, tree, crate, days_ago):
        """A per-crate record of `crate` at `tree`, indexed under its crate key as CI and st-test file them."""
        record = self.record(commit, tree, days_ago)
        ref = f'refs/notes/evidence-input/rust-tests/{self.crate_key(tree, crate)}/{record}'
        self.f.git('update-ref', ref, record)
        return ref

    def test_a_live_pull_requests_crate_keys_and_recent_mains_survive_a_plan_and_an_old_mains_go(self):
        old, recent, pr = self.crates()
        pr_b = self.crate_index(pr[0], pr[1], 'b', 29)            # only the open head has this key for b: kept at any age
        pr_a = self.crate_index(pr[0], pr[1], 'a', 29)            # a is unchanged on the branch: the same key as recent main's a
        recent_b = self.crate_index(recent[0], recent[1], 'b', 2)  # recent main (main_days 3): kept
        old_a = self.crate_index(old[0], old[1], 'a', 25)          # old main's a: no live tree has that key any more
        self.assertEqual(self.crate_key(pr[1], 'a'), self.crate_key(recent[1], 'a'))
        self.assertNotEqual(self.crate_key(old[1], 'a'), self.crate_key(recent[1], 'a'))
        with open(self.f.root / 'open-heads', 'w') as handle:
            handle.write(pr[0] + '\n')
        code, result, err = self.run_gc('--head', recent[0], '--open-heads-from', str(self.f.root / 'open-heads'), '--apply')
        self.assertEqual(code, 0, (result, err))
        self.assertEqual(self.refs('refs/notes/evidence-input'), {pr_b, pr_a, recent_b})
        self.assertNotIn(old_a, self.refs())
        self.assertEqual(result['crate_keys']['unreadable'], [])
        self.assertGreaterEqual(result['crate_keys']['trees'], 2)

    def test_a_live_tree_whose_crates_cannot_be_keyed_keeps_every_crate_key(self):
        old, recent, pr = self.crates(broken_pr=True)            # the open head's crate b manifest is no longer TOML
        old_a = self.crate_index(old[0], old[1], 'a', 25)          # dead by its key, but the head's keys are unknown
        with open(self.f.root / 'open-heads', 'w') as handle:
            handle.write(pr[0] + '\n')
        code, result, err = self.run_gc('--head', recent[0], '--open-heads-from', str(self.f.root / 'open-heads'), '--apply')
        self.assertEqual(code, 0, (result, err))
        self.assertIn(old_a, self.refs())
        self.assertEqual(result['crate_keys']['unreadable'], [pr[1]])

    def test_a_partial_clone_fetches_the_manifests_it_lacks_in_one_go_before_keying(self):
        old, recent, pr = self.crates()
        self.f.git('config', 'uploadpack.allowFilter', 'true')
        self.f.git('config', 'uploadpack.allowAnySHA1InWant', 'true')
        clone = self.f.root / 'partial.git'
        subprocess.run(['git', 'clone', '-q', '--bare', '--filter=blob:none', '--no-local', str(self.f.repo), str(clone)], check=True)
        manifest = self.f.git('rev-parse', f'{recent[1]}:crates/b/Cargo.toml')
        lacks = lambda: subprocess.run(['git', '-C', str(clone), 'cat-file', '-e', manifest],
                                       env=dict(os.environ, GIT_NO_LAZY_FETCH='1')).returncode != 0
        self.assertTrue(lacks(), 'a blob:none clone has no manifest yet')
        saved = os.environ.get('GIT_NO_LAZY_FETCH')
        os.environ['GIT_NO_LAZY_FETCH'] = '1'  # keying itself may not fetch: only the prefetch can bring the manifests
        try:
            keys, report = evidence_gc.crate_keys(str(clone), {recent[1]}, 'main', [],
                                                  evidence_gc.prefetch_manifests(str(clone), 'origin', None))
        finally:
            os.environ.pop('GIT_NO_LAZY_FETCH')
            if saved is not None:
                os.environ['GIT_NO_LAZY_FETCH'] = saved
        self.assertFalse(lacks())
        self.assertEqual((report['trees'], report['unreadable']), (1, []))
        self.assertEqual(keys, {('rust-tests', self.crate_key(recent[1], 'a')), ('rust-tests', self.crate_key(recent[1], 'b'))})

    def test_past_the_soft_limit_the_oldest_unprotected_notes_go_first_and_protected_ones_never(self):
        old, recent, pr = self.world()
        head = self.record(pr[0], pr[1], 29)
        young = [self.record(old[0], f'{n}' * 40, 0.5 - n / 100) for n in range(1, 5)]  # all inside the grace period; 1 is the oldest
        code, result, _ = self.run_gc('--head', pr[0], '--retention', self.retention(soft_records=3), '--apply')
        self.assertEqual(code, 0, result)
        self.assertEqual(result['reasons']['deleted: over the soft limit (oldest first)'], 2)
        left = {name.rsplit('/', 1)[1] for name in self.refs('refs/notes/evidence')}
        self.assertEqual(left, {head, young[2], young[3]})

    def test_a_protected_set_over_the_cap_is_reported_and_nothing_protected_is_deleted(self):
        old, recent, pr = self.world()
        records = [self.record(pr[0], pr[1], 29 - n / 10) for n in range(5)]
        code, result, _ = self.run_gc('--head', pr[0], '--retention', self.retention(soft_records=2, cap_records=3), '--apply')
        self.assertEqual(code, 3, result)
        self.assertIn('over the cap', result['alert'])
        self.assertEqual({n.rsplit('/', 1)[1] for n in self.refs('refs/notes/evidence')}, set(records))

    def test_a_head_that_cannot_be_resolved_stops_an_apply_before_it_deletes_anything(self):
        old, recent, pr = self.world()
        doomed = self.record(old[0], 'a' * 40, 10)
        before = self.refs()
        code, result, _ = self.run_gc('--head', pr[0], '--head', 'f' * 40, '--apply')
        self.assertEqual(code, 1)
        self.assertEqual(result['unresolved_heads'], ['f' * 40])
        self.assertIn('nothing was changed', result['refused'])
        self.assertEqual(self.refs(), before)
        code, result, _ = self.run_gc('--head', 'f' * 40)  # a dry run only reports it
        self.assertEqual((code, result['unresolved_heads']), (0, ['f' * 40]))
        self.assertIn(f'refs/notes/evidence/{"a" * 40}/{doomed}', self.refs())

    def test_a_second_run_finds_nothing_to_do(self):
        old, recent, pr = self.world()
        self.record(pr[0], pr[1], 28, layout='legacy')
        self.record(old[0], 'a' * 40, 10)
        self.record(recent[0], recent[1], 2)
        self.assertEqual(self.run_gc('--head', pr[0], '--apply')[0], 0)
        after = self.refs()
        code, result, _ = self.run_gc('--head', pr[0], '--apply')
        self.assertEqual(code, 0)
        self.assertEqual((result['refs_before'], result['refs_after']), (len(after), len(after)))
        self.assertEqual({k: v for k, v in result['reasons'].items() if k.startswith(('deleted', 'migrated'))}, {})
        self.assertEqual(self.refs(), after)

    def test_a_remote_gets_the_migrations_first_and_then_the_deletions(self):
        old, recent, pr = self.world()
        head = self.record(pr[0], pr[1], 28, layout='legacy')
        doomed = self.record(old[0], 'a' * 40, 10)
        kept = self.record(recent[0], recent[1], 2)
        bare = self.f.root / 'remote.git'
        subprocess.run(['git', 'init', '-q', '--bare', str(bare)], check=True)
        self.f.git('remote', 'add', 'origin', str(bare))
        self.f.git('push', '-q', 'origin', *[f'{ref}:{ref}' for ref in self.refs('refs/notes/evidence')])
        code, result, _ = self.run_gc('--head', pr[0], '--remote', 'origin', '--apply')
        self.assertEqual(code, 0, result)
        remote = set(subprocess.run(['git', '-C', str(bare), 'for-each-ref', '--format=%(refname)', 'refs/notes/evidence'],
                                    capture_output=True, text=True).stdout.split())
        self.assertEqual(remote, {f'refs/notes/evidence/{pr[1]}/{head}', f'refs/notes/evidence/{recent[1]}/{kept}'})
        self.assertEqual(remote, self.refs('refs/notes/evidence'))
        self.assertNotIn(doomed, ' '.join(remote))

    def test_a_failed_remote_push_leaves_the_local_refs_and_never_prints_the_token(self):
        old, recent, pr = self.world()
        self.record(old[0], 'a' * 40, 10)
        self.f.git('remote', 'add', 'origin', str(self.f.root / 'nowhere.git'))
        before = self.refs()
        done = subprocess.run([sys.executable, str(GC), '--repo', str(self.f.repo), '--main', 'main', '--as-of', str(NOW), '--head', pr[0],
                               '--retention', self.retention(),
                               '--remote', 'origin', '--apply'], capture_output=True, text=True,
                              env=dict(os.environ, EVIDENCE_PUSH_TOKEN='sekrit-token-value'))
        self.assertEqual(done.returncode, 1)
        self.assertNotIn('sekrit-token-value', done.stdout + done.stderr)
        self.assertEqual(self.refs(), before)

    def test_as_of_defaults_to_main_s_tip_time_so_a_quiet_main_ages_nothing_and_its_tip_is_always_live(self):
        self.f.git('add', '-A')
        with At(40):
            self.f.git('commit', '-q', '-m', 'only an old commit')
        tip = (self.f.git('rev-parse', 'HEAD'), self.f.git('rev-parse', 'HEAD^{tree}'))
        on_tip = self.record(tip[0], tip[1], 39)
        other = self.record(tip[0], 'a' * 40, 39.5)  # a dead tree, but only half a day older than main's tip: in grace
        self.f.git('update-ref', 'refs/evidence-gc/tips/somebody-else', self.f.git('commit-tree', '-m', 'unrelated', self.f.git('mktree', stdin=b'')))
        base = ['--repo', str(self.f.repo), '--main', 'main', '--retention', self.retention()]
        done = subprocess.run([sys.executable, str(GC), *base, '--apply'], capture_output=True, text=True)
        self.assertEqual(done.returncode, 0, done.stderr)
        result = json.loads(done.stdout)
        self.assertEqual(result['as_of'], NOW - 40 * DAY)
        self.assertEqual(result['reasons'], {'kept: grace': 1, 'kept: main-window': 1}, result)
        tips = self.f.root / 'no-tips'
        tips.write_text('')
        code, result, _ = self.run_gc('--apply', '--heads-from', str(tips))  # 40 days later the tip is still live; the other tree is not
        self.assertEqual((code, result['reasons']), (0, {'kept: main-window': 1, 'deleted: dead tree': 1}), result)
        self.assertEqual({n.rsplit('/', 1)[1] for n in self.refs('refs/notes/evidence')}, {on_tip})
        self.assertNotIn(other, ' '.join(self.refs()))

    def test_apply_without_naming_any_head_is_refused_and_a_dry_run_is_not(self):
        old, recent, pr = self.world()
        record = self.record(pr[0], pr[1], 29)  # the head of an open PR, old: an empty head list would delete it
        before = self.refs()
        code, _, error = self.run_gc('--apply')
        self.assertEqual(code, 2)
        self.assertIn('needs the branch tips', error)
        self.assertEqual(self.refs(), before)
        code, result, _ = self.run_gc()  # a dry run may be asked with no heads: it only reports
        self.assertEqual((code, result['mode']), (0, 'dry-run'))
        self.assertEqual(self.run_gc('--head', pr[0], '--apply')[0], 0)
        self.assertIn(f'refs/notes/evidence/{pr[1]}/{record}', self.refs())

    def test_a_record_filed_as_a_tag_and_a_note_gets_one_decision_for_both_names(self):
        old, recent, pr = self.world()
        head = self.both(pr[0], pr[1], 29)
        kept = self.both(recent[0], recent[1], 5)
        doomed = self.both(old[0], old[1], 19)
        shared = self.index_both('unit', pr[1], head)
        stale = self.index_both('unit', old[1], doomed)
        code, result, _ = self.run_gc('--head', pr[0], '--apply')
        self.assertEqual(code, 0, result)
        self.assertEqual(self.refs('refs/tags/evidence'), {f'refs/tags/evidence/{pr[1]}/{head}', f'refs/tags/evidence/{recent[1]}/{kept}', shared[1]})
        self.assertEqual(self.refs('refs/notes/evidence'), {f'refs/notes/evidence/{pr[1]}/{head}', f'refs/notes/evidence/{recent[1]}/{kept}'})
        self.assertEqual(self.refs('refs/notes/evidence-input'), {shared[0]})
        self.assertFalse(set(stale) & self.refs('refs'))
        self.assertEqual((result['refs_before'], result['refs_after'], result['records_before'], result['records_after']), (10, 6, 5, 3))
        self.assertEqual(result['protected_records'], 3)
        self.assertEqual(result['reasons']['deleted: dead tree'], 2, 'the tag and the note of the one record of a dead tree')
        self.f.git('update-ref', '-d', f'refs/notes/evidence/{pr[1]}/{head}')
        code, verified = self.f.verify(pr[1])
        self.assertEqual((code, verified['record']), (0, head), 'the open head still verifies from its tag')

    def test_a_record_with_two_names_counts_once_against_the_soft_limit_and_the_cap(self):
        old, recent, pr = self.world()
        head = self.both(pr[0], pr[1], 29)
        young = [self.both(old[0], f'{n}' * 40, 0.5 - n / 100) for n in range(1, 5)]  # all inside the grace period; 1 is the oldest
        code, result, _ = self.run_gc('--head', pr[0], '--retention', self.retention(soft_records=3), '--apply')
        self.assertEqual(code, 0, result)
        self.assertEqual(result['reasons']['deleted: over the soft limit (oldest first)'], 4, 'two records, both names of each')
        for prefix in ('refs/tags/evidence', 'refs/notes/evidence'):
            self.assertEqual({name.rsplit('/', 1)[1] for name in self.refs(prefix)}, {head, young[2], young[3]}, prefix)
        # Five records under ten names: over a cap of 4 records, not over one of 5.
        for n in range(4):
            self.both(pr[0], pr[1], 28 - n / 10)
        self.assertEqual(self.run_gc('--head', pr[0], '--retention', self.retention(soft_records=3, cap_records=5), '--apply')[0], 0)
        code, result, _ = self.run_gc('--head', pr[0], '--retention', self.retention(soft_records=3, cap_records=4), '--apply')
        self.assertEqual(code, 3, result)
        self.assertEqual((result['protected_records'], result['protected_refs']), (5, 10))

    def test_a_remote_loses_both_names_and_fetch_reads_the_tags(self):
        old, recent, pr = self.world()
        head = self.both(pr[0], pr[1], 28)
        doomed = self.both(old[0], 'a' * 40, 10)
        bare = self.f.root / 'remote.git'
        subprocess.run(['git', 'init', '-q', '--bare', str(bare)], check=True)
        self.f.git('remote', 'add', 'origin', str(bare))
        self.f.git('push', '-q', 'origin', 'main:main', *[f'{ref}:{ref}' for ref in self.refs('refs/notes/evidence') | self.refs('refs/tags/evidence')])
        for ref in self.refs('refs/tags/evidence'):
            self.f.git('update-ref', '-d', ref)  # only --fetch can bring the tags back
        code, result, error = self.run_gc('--head', pr[0], '--remote', 'origin', '--fetch', '--apply')
        self.assertEqual(code, 0, error)
        self.assertEqual((result['refs_before'], result['records_before']), (4, 2), result)
        remote = set(subprocess.run(['git', '-C', str(bare), 'for-each-ref', '--format=%(refname)', 'refs/notes/evidence', 'refs/tags/evidence'],
                                    capture_output=True, text=True).stdout.split())
        self.assertEqual(remote, {f'refs/notes/evidence/{pr[1]}/{head}', f'refs/tags/evidence/{pr[1]}/{head}'})
        self.assertNotIn(doomed, ' '.join(remote))

    def test_fetch_reads_every_branch_tip_and_forgets_deleted_branches(self):
        old, recent, pr = self.world()
        head = self.both(pr[0], pr[1], 28)
        gone = self.branch_commit(2, content='a branch that is deleted\n')
        gone_record = self.both(gone[0], gone[1], 1.5)
        bare = self.f.root / 'remote.git'
        subprocess.run(['git', 'init', '-q', '--bare', str(bare)], check=True)
        self.f.git('remote', 'add', 'origin', str(bare))
        self.f.git('push', '-q', 'origin', 'main:main', f'{pr[0]}:refs/heads/agent/feature', f'{gone[0]}:refs/heads/agent/old',
                   *[f'{ref}:{ref}' for ref in self.refs('refs/notes/evidence') | self.refs('refs/tags/evidence')])
        code, result, error = self.run_gc('--remote', 'origin', '--fetch', '--apply')  # no --head: the remote's branches are the tips
        self.assertEqual(code, 0, error)
        self.assertEqual(result['live_trees']['branch_tips'], 2, result)
        self.assertEqual(self.refs('refs/evidence-gc/tips'), {'refs/evidence-gc/tips/agent/feature', 'refs/evidence-gc/tips/agent/old'})
        subprocess.run(['git', '-C', str(bare), 'branch', '-q', '-D', 'agent/old'], check=True)
        code, result, error = self.run_gc('--remote', 'origin', '--fetch', '--apply')
        self.assertEqual(code, 0, error)
        self.assertEqual(self.refs('refs/evidence-gc/tips'), {'refs/evidence-gc/tips/agent/feature'})
        remote = subprocess.run(['git', '-C', str(bare), 'for-each-ref', '--format=%(refname)', 'refs/tags/evidence'], capture_output=True, text=True).stdout.split()
        self.assertEqual(set(remote), {f'refs/tags/evidence/{pr[1]}/{head}'}, 'the deleted branch\'s tree went (past grace, as_of is NOW)')
        self.assertNotIn(gone_record, ' '.join(remote))
        subprocess.run(['git', '-C', str(bare), 'branch', '-q', '-D', 'agent/feature'], check=True)
        code, _, error = self.run_gc('--remote', 'origin', '--fetch', '--apply')  # only main is left: the fetch has nothing to do
        self.assertEqual(code, 2, error)
        self.assertIn('needs the branch tips', error)
        self.assertEqual(self.refs('refs/evidence-gc/tips'), set())

    def protected_remote(self, rules='update deletion'):
        """A bare remote whose pre-receive hook plays a tag ruleset on refs/tags/evidence/**: RULES (a file the test may rewrite) says
        what it refuses, `update` (moving a tag, always) and `deletion` (the ruleset before it dropped that rule), in GitHub's words."""
        bare = self.f.root / 'protected.git'
        subprocess.run(['git', 'init', '-q', '--bare', str(bare)], check=True)
        flag = self.f.root / 'ruleset-rules'
        flag.write_text(rules)
        hook = bare / 'hooks/pre-receive'
        zero = '0' * 40
        hook.write_text(f"""#!/bin/sh
rules=$(cat '{flag}')
while read old new ref; do
  case "$ref" in refs/tags/evidence/*)
    if [ "$old" != {zero} ] && [ "$new" != {zero} ]; then echo "error: GH013: Repository rule violations found for $ref (update)"; exit 1; fi
    if [ "$new" = {zero} ]; then case "$rules" in *deletion*) echo "error: GH013: Repository rule violations found for $ref"; exit 1;; esac; fi;;
  esac
done
""")
        hook.chmod(0o755)
        self.f.git('remote', 'add', 'origin', str(bare))
        # evidence-gc clears GIT_CONFIG_* for its Git commands, so pin the server's hook lookup locally too.
        self.f.git('-C', str(bare), 'config', 'core.hooksPath', str(bare / 'hooks'))
        return bare, flag

    def remote_refs(self, bare, prefix='refs'):
        return set(subprocess.run(['git', '-C', str(bare), 'for-each-ref', '--format=%(refname)', prefix], capture_output=True, text=True).stdout.split())

    def evidence_refs(self, bare=None):
        prefixes = ('refs/tags/evidence', 'refs/notes/evidence', 'refs/notes/evidence-input')
        return set().union(*(self.remote_refs(bare, p) if bare else self.refs(p) for p in prefixes))

    def lock_world(self):
        old, recent, pr = self.world()
        head = self.both(pr[0], pr[1], 28)
        doomed = [self.both(old[0], f'{n}' * 40, 10) for n in range(1, 4)]
        bystander = self.both(recent[0], recent[1], 1)
        return pr, head, doomed, bystander

    def push_all(self):
        self.f.git('push', '-q', 'origin', 'main:main', *[f'{ref}:{ref}' for ref in self.evidence_refs()])

    def test_a_remote_that_refuses_deleting_tags_keeps_every_dead_group_whole_and_drops_only_duplicate_names(self):
        pr, head, doomed, bystander = self.lock_world()
        newer_failure = self.record(self.f.git('rev-parse', 'main'), '1' * 40, 9)  # a note only, beside the tree's tag-and-note record
        tagless = self.record(self.f.git('rev-parse', 'main'), 'c' * 40, 10)  # a dead tree with no tag at all
        bare, flag = self.protected_remote('update deletion')
        self.push_all()
        code, result, error = self.run_gc('--head', pr[0], '--remote', 'origin', '--apply')
        self.assertEqual(code, 0, (result, error))
        self.assertEqual(result['kept_by_protection']['groups'], 3, result)
        remote = self.evidence_refs(bare)
        for record, tree in zip(doomed, ('1' * 40, '2' * 40, '3' * 40)):
            self.assertIn(f'refs/tags/evidence/{tree}/{record}', remote)  # the record stays, by its tag
            self.assertNotIn(f'refs/notes/evidence/{tree}/{record}', remote)  # its duplicate note name went
        self.assertIn(f'refs/notes/evidence/{"1" * 40}/{newer_failure}', remote, 'the newer failure stays with the older pass beside it')
        self.assertNotIn(tagless, ' '.join(remote), 'a group with no tag is deleted whole')
        self.assertEqual(self.evidence_refs(), remote, 'the local refs follow exactly what the remote did')
        flag.write_text('update')  # the ruleset without its deletion rule
        code, result, error = self.run_gc('--head', pr[0], '--remote', 'origin', '--apply')
        self.assertEqual((code, 'kept_by_protection' in result), (0, False), (result, error))
        left = {ref.rsplit('/', 1)[1] for ref in self.evidence_refs(bare)}
        self.assertEqual(left, {head, bystander})
        self.assertEqual(self.evidence_refs(), self.evidence_refs(bare))

    def test_a_ref_already_gone_from_the_remote_is_forgotten_and_a_second_run_does_nothing(self):
        pr, head, doomed, bystander = self.lock_world()
        bare, flag = self.protected_remote('update')
        self.push_all()
        subprocess.run(['git', '-C', str(bare), 'update-ref', '-d', f'refs/tags/evidence/{"1" * 40}/{doomed[0]}'], check=True)
        code, result, error = self.run_gc('--head', pr[0], '--remote', 'origin', '--apply')
        self.assertEqual(code, 0, (result, error))
        self.assertEqual({ref.rsplit('/', 1)[1] for ref in self.evidence_refs(bare)}, {head, bystander})
        self.assertEqual(self.evidence_refs(), self.evidence_refs(bare))
        code, result, _ = self.run_gc('--head', pr[0], '--remote', 'origin', '--apply')
        self.assertEqual((code, result['trees_deleted'], result.get('deleted_refs', 0)), (0, 0, 0), result)

    def test_a_push_that_fails_for_another_reason_is_a_failure_and_splits_no_group(self):
        pr, head, doomed, bystander = self.lock_world()
        bare, flag = self.protected_remote('update')
        self.push_all()
        hook = bare / 'hooks/pre-receive'
        hook.write_text('#!/bin/sh\nwhile read old new ref; do case "$ref" in refs/tags/*) echo "disk full"; exit 1;; esac; done\n')
        code, result, error = self.run_gc('--head', pr[0], '--remote', 'origin', '--apply')
        self.assertEqual(code, 1, (result, error))
        self.assertTrue(any('disk full' in failure for failure in result['failed']), result)
        for record, tree in zip(doomed, ('1' * 40, '2' * 40, '3' * 40)):
            self.assertIn(f'refs/tags/evidence/{tree}/{record}', self.evidence_refs(bare))
        self.assertEqual(self.evidence_refs(), self.evidence_refs(bare))

    def recorder(self, bare, exit_code=0):
        """A --before-delete command: it writes its arguments and the remote's evidence tags at the moment it runs, then exits."""
        seen = self.f.root / f'before-{exit_code}.json'
        script = self.f.root / f'before-{exit_code}.py'
        script.write_text(f"""import json, subprocess, sys
tags = subprocess.run(['git', '-C', {str(bare)!r}, 'for-each-ref', '--format=%(refname)', 'refs/tags/evidence'], capture_output=True, text=True).stdout.split()
plan = json.load(open(sys.argv[-1]))
json.dump({{'argv': sys.argv[1:], 'tags': tags, 'plan_delete': plan['delete']}}, open({str(seen)!r}, 'w'))
sys.exit({exit_code})
""")
        return [sys.executable, str(script)], seen

    def test_before_delete_runs_on_the_written_plan_while_every_doomed_tag_still_exists(self):
        pr, head, doomed, bystander = self.lock_world()
        bare, flag = self.protected_remote('update')
        self.push_all()
        argv, seen = self.recorder(bare)
        plan = self.f.root / 'plan.json'
        code, result, error = self.run_gc('--head', pr[0], '--remote', 'origin', '--apply', '--plan-out', str(plan),
                                          '--before-delete', json.dumps([*argv, '--flag']))
        self.assertEqual((code, result['before_delete']), (0, {'exit_code': 0}), error)
        before = json.loads(seen.read_text())
        self.assertEqual(before['argv'], ['--flag', str(plan)], 'the plan path is the last argument')
        doomed_tags = {ref for ref in before['plan_delete'] if ref.startswith('refs/tags/evidence/')}
        self.assertEqual({ref.rsplit('/', 1)[1] for ref in doomed_tags}, set(doomed))
        self.assertTrue(doomed_tags <= set(before['tags']), 'nothing was deleted before the command ran')
        self.assertTrue(doomed_tags.isdisjoint(self.remote_refs(bare, 'refs/tags/evidence')), 'and all of it after')

    def test_a_failing_before_delete_command_deletes_and_migrates_nothing(self):
        pr, head, doomed, bystander = self.lock_world()
        self.record(pr[0], pr[1], 27, layout='legacy')  # a migration is a change too
        bare, flag = self.protected_remote('update')
        self.push_all()
        remote_before, local_before = self.remote_refs(bare), self.refs('refs')
        argv, seen = self.recorder(bare, exit_code=3)
        code, result, error = self.run_gc('--head', pr[0], '--remote', 'origin', '--apply', '--plan-out', str(self.f.root / 'plan.json'),
                                          '--before-delete', json.dumps(argv))
        self.assertEqual((code, result['before_delete'], 'applied' in result), (1, {'exit_code': 3}, False), error)
        self.assertIn('--before-delete', result['refused'])
        self.assertEqual((self.remote_refs(bare), self.refs('refs')), (remote_before, local_before))
        self.assertTrue(seen.exists())
        code, result, error = self.run_gc('--head', pr[0], '--remote', 'origin', '--apply', '--plan-out', str(self.f.root / 'plan.json'),
                                          '--before-delete', json.dumps([str(self.f.root / 'no-such-command')]))
        self.assertEqual((code, result['before_delete']['exit_code']), (1, None), error)
        self.assertEqual(self.remote_refs(bare), remote_before)

    def test_before_delete_needs_a_plan_file_and_a_json_argv(self):
        self.world()
        for extra in (['--before-delete', '["true"]'], ['--before-delete', 'true', '--plan-out', 'p.json'], ['--before-delete', '[]', '--plan-out', 'p.json']):
            code, _, error = self.run_gc('--apply', '--head', self.f.git('rev-parse', 'main'), *extra)
            self.assertEqual(code, 2, (extra, error))

    def timer_world(self):
        pr, head, doomed, bystander = self.lock_world()
        for tool in ('evidence-gc', 'evidence-verify'):  # main carries the tools the timer runs; the branch under test does not matter
            (self.f.repo / 'scripts').mkdir(exist_ok=True)
            (self.f.repo / 'scripts' / tool).write_bytes((ROOT / 'scripts' / tool).read_bytes())
        (self.f.repo / '.st/evidence-retention.json').write_text(json.dumps(RETENTION))
        self.f.git('add', '-A')
        with At(0.5):
            self.f.git('commit', '-q', '-m', 'tools')
        bare, flag = self.protected_remote('update')
        self.push_all()
        self.f.git('push', '-q', 'origin', f'{pr[0]}:refs/heads/agent/feature')
        pulls = self.f.root / 'pulls.json'  # what the GitHub API answers: the open pull requests, one page
        pulls.write_text(json.dumps([{'number': 1, 'head': {'sha': pr[0]}}]))
        (bin_dir := self.f.root / 'bin').mkdir()
        (bin_dir / 'curl').write_text(f'#!/bin/sh\nfor a; do url=$a; done\necho "$url" >> {str(self.f.root / "curl.urls")!r}\ncat {str(pulls)!r}\n')
        (bin_dir / 'curl').chmod(0o755)
        stored = self.f.root / 'stored'
        (bin_dir / 'st').write_text(f'#!/bin/sh\ncp "$3" {str(stored)!r}-$(ls {str(self.f.root)!r} | grep -c stored)\necho "$5" >> {str(stored)!r}.names\n')
        (bin_dir / 'st').chmod(0o755)
        state = self.f.root / 'state'
        env = dict({k: v for k, v in os.environ.items() if not k.startswith('GIT_')}, PATH=f'{bin_dir}:{os.environ["PATH"]}',
                   EVIDENCE_GC_STATE=str(state), EVIDENCE_GC_REMOTE=str(bare), EVIDENCE_GC_API='https://api.example.invalid',
                   GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_NOSYSTEM='1',
                   GIT_AUTHOR_NAME='t', GIT_AUTHOR_EMAIL='t@example.invalid', GIT_COMMITTER_NAME='t', GIT_COMMITTER_EMAIL='t@example.invalid')
        return env, bare, flag, head, doomed, stored, state

    def test_the_timer_runs_main_s_gc_with_the_open_pull_requests_and_stores_each_summary_as_a_document(self):
        env, bare, flag, head, doomed, stored, state = self.timer_world()
        env['EVIDENCE_GC_LOG_TIMER'] = str(self.f.root / 'no-log-here')  # this host runs no evidence log
        done = subprocess.run(['bash', str(TIMER)], capture_output=True, text=True, env=env)
        self.assertEqual(done.returncode, 0, done.stderr)
        left = {r.rsplit('/', 1)[1] for r in self.remote_refs(bare, 'refs/tags/evidence')}
        self.assertTrue(left.isdisjoint(doomed) and head in left, left)
        self.assertEqual((self.f.root / 'curl.urls').read_text().split(),
                         ['https://api.example.invalid/repos/compoundingtech/fractal/pulls?state=open&per_page=100&page=1'])
        summaries = sorted(stored.parent.glob('stored-*'))
        self.assertEqual(len(summaries), 1)
        summary = json.loads(summaries[0].read_text())
        self.assertEqual((summary['mode'], summary['live_trees']['open_pull_requests'], 'lock' in summary), ('apply', 1, False), summary)
        self.assertEqual(stored.with_suffix('.names').read_text().split(), ['doc/fleet/factory/evidence-gc/runs'])
        self.assertEqual(len(list((state / 'runs').glob('*.plan.json'))), 1)

    def test_the_timer_deletes_nothing_when_the_open_pull_requests_cannot_be_read(self):
        env, bare, flag, head, doomed, stored, state = self.timer_world()
        env['EVIDENCE_GC_LOG_TIMER'] = str(self.f.root / 'no-log-here')
        (self.f.root / 'bin' / 'curl').write_text('#!/bin/sh\necho "curl: (22) The requested URL returned error: 403" >&2\nexit 22\n')
        before = self.remote_refs(bare)
        done = subprocess.run(['bash', str(TIMER)], capture_output=True, text=True, env=env)
        self.assertNotEqual(done.returncode, 0, done.stderr)
        self.assertEqual(self.remote_refs(bare), before)
        self.assertFalse(list(stored.parent.glob('stored-*')))

    def test_on_a_host_with_the_evidence_log_the_timer_writes_gc_s_lines_and_publishes_before_deleting(self):
        env, bare, flag, head, doomed, stored, state = self.timer_world()
        argv, seen = self.recorder(bare)
        log_timer = self.f.root / 'evidence-log-timer'  # stands in for the installed wrapper: bash runs it with its arguments
        log_timer.write_text(f'exec {" ".join(argv)} "$@"\n')
        log_config = self.f.root / 'evidence-log-config'
        log_config.mkdir()
        (log_config / 'signer.json').write_text('["true"]')
        env.update(EVIDENCE_GC_LOG_TIMER=str(log_timer), EVIDENCE_LOG_CONFIG=str(log_config))
        done = subprocess.run(['bash', str(TIMER)], capture_output=True, text=True, env=env)
        self.assertEqual(done.returncode, 0, done.stderr)
        before = json.loads(seen.read_text())
        self.assertEqual(before['argv'][:3], ['gc', '--publish', '--plan'])
        self.assertTrue(before['argv'][3].endswith('.plan.json'))
        self.assertTrue(set(doomed) <= {ref.rsplit('/', 1)[1] for ref in before['tags']}, 'the log heard first')
        self.assertTrue(set(doomed).isdisjoint(ref.rsplit('/', 1)[1] for ref in self.remote_refs(bare, 'refs/tags/evidence')))

    def test_on_a_host_with_the_evidence_log_a_failed_log_step_stops_the_deletions(self):
        env, bare, flag, head, doomed, stored, state = self.timer_world()
        log_timer = self.f.root / 'evidence-log-timer'
        log_timer.write_text('echo "evidence-log: the log signer failed" >&2; exit 1\n')
        log_config = self.f.root / 'evidence-log-config'
        log_config.mkdir()
        (log_config / 'signer.json').write_text('["true"]')
        env.update(EVIDENCE_GC_LOG_TIMER=str(log_timer), EVIDENCE_LOG_CONFIG=str(log_config))
        done = subprocess.run(['bash', str(TIMER)], capture_output=True, text=True, env=env)
        self.assertEqual(done.returncode, 1, done.stderr)
        self.assertIn('the log signer failed', done.stderr)
        self.assertTrue(set(doomed) <= {ref.rsplit('/', 1)[1] for ref in self.remote_refs(bare, 'refs/tags/evidence')})

    def test_bad_retention_and_bad_arguments_are_refused(self):
        self.world()
        for bad in ({'soft_records': 5, 'cap_records': 3}, {'main_days': 0}, {'main_days': 31}, {'grace_hours': -1}, {'extra': 1},
                    {'soft_records': 2.5}, {'version': 2}):
            code, _, error = self.run_gc('--retention', self.retention(**bad))
            self.assertEqual(code, 2, (bad, error))
        self.assertEqual(self.run_gc('--head', 'short')[0], 1)
        done = subprocess.run([sys.executable, str(GC), '--repo', str(self.f.repo), '--main', 'main'], capture_output=True, text=True)
        self.assertEqual(done.returncode, 2)
        self.assertIn('has no .st/evidence-retention.json', done.stderr)

    def test_the_retention_file_is_read_from_main(self):
        old, recent, pr = self.world()
        kept = self.record(old[0], 'a' * 40, 10)
        (self.f.repo / '.st/evidence-retention.json').write_text(json.dumps({**RETENTION, 'grace_hours': 24 * 11}))
        self.f.git('add', '-A')
        with At(0.5):
            self.f.git('commit', '-q', '-m', 'retention')
        done = subprocess.run([sys.executable, str(GC), '--repo', str(self.f.repo), '--main', 'main', '--as-of', str(NOW), '--head', pr[0]],
                              capture_output=True, text=True)
        self.assertEqual(done.returncode, 0, done.stderr)
        result = json.loads(done.stdout)
        self.assertEqual(result['retention']['grace_hours'], 264)
        self.assertEqual(result['reasons'].get('kept: grace'), 1, kept)

    def test_a_branch_tip_protects_its_tree_until_it_is_older_than_branch_days(self):
        old, recent, pr = self.world()  # the pull request head is 30 days old
        head = self.record(pr[0], pr[1], 29)
        self.f.git('update-ref', 'refs/evidence-gc/tips/agent/feature', pr[0])
        code, result, _ = self.run_gc('--retention', self.retention(branch_days=31), '--apply')  # no --head: the tip is enough
        self.assertEqual(code, 0, result)
        self.assertIn(f'refs/notes/evidence/{pr[1]}/{head}', self.refs())
        self.assertEqual(result['live_trees']['branch_tips'], 1)
        code, result, _ = self.run_gc('--retention', self.retention(branch_days=29), '--apply')
        self.assertEqual((code, result['live_trees']['branch_tips']), (0, 0), result)
        self.assertNotIn(head, ' '.join(self.refs()))

    def test_an_open_pull_request_head_keeps_its_records_at_any_age(self):
        old, recent, pr = self.world()  # the pull request head is 30 days old, past branch_days below
        head = self.record(pr[0], pr[1], 29)
        self.f.git('update-ref', 'refs/evidence-gc/tips/agent/feature', pr[0])
        opened = self.f.root / 'open-heads.txt'
        opened.write_text(pr[0] + '\n')
        code, result, _ = self.run_gc('--retention', self.retention(branch_days=14), '--open-heads-from', str(opened), '--apply')
        self.assertEqual(code, 0, result)
        self.assertIn(f'refs/notes/evidence/{pr[1]}/{head}', self.refs())
        self.assertEqual(result['live_trees'], {'branch_tips': 0, 'open_pull_requests': 1, 'main_window': 1}, result)
        opened.write_text('')  # the pull request closed: its branch tip alone is too old to protect it
        code, result, _ = self.run_gc('--retention', self.retention(branch_days=14), '--open-heads-from', str(opened), '--apply')
        self.assertEqual((code, result['live_trees']['open_pull_requests']), (0, 0), result)
        self.assertNotIn(head, ' '.join(self.refs()))

    def test_an_open_head_that_cannot_be_resolved_stops_an_apply_and_a_missing_or_bad_file_is_refused(self):
        old, recent, pr = self.world()
        self.record(pr[0], pr[1], 1)
        before = self.refs()
        opened = self.f.root / 'open-heads.txt'
        opened.write_text(f'{pr[0]}\n{"e" * 40}\n')
        code, result, _ = self.run_gc('--head', pr[0], '--open-heads-from', str(opened), '--apply')
        self.assertEqual((code, result['unresolved_heads']), (1, ['e' * 40]), result)
        self.assertEqual(self.refs(), before)
        self.assertEqual(self.run_gc('--head', pr[0], '--open-heads-from', str(self.f.root / 'absent.txt'), '--apply')[0], 2)
        opened.write_text('not-a-commit\n')
        self.assertEqual(self.run_gc('--head', pr[0], '--open-heads-from', str(opened), '--apply')[0], 1)
        self.assertEqual(self.refs(), before)

    def test_a_dead_tree_goes_whole_so_a_failure_beside_a_pass_is_never_left_out(self):
        # Before gc_plan, records went one at a time by age: the failure (just past the grace period) went and the pass, dated
        # within the 2-minute shadow window after it and so still shadowed by it, stayed: the tree's verdict turned to satisfied.
        old, recent, pr = self.world()
        dead, tree = self.branch_commit(5, content='a head that was force-pushed away\n')
        self.f.layout = 'tree'
        with At(1 + 30 / DAY):
            failure = self.f.note(dead, tree, self.ci, 'machine/ci1', exit_code=1, seconds=0)
        with At(1 - 30 / DAY):
            passing = self.f.note(dead, tree, self.ci, 'machine/ci1', exit_code=0, seconds=60)
        self.assertEqual(self.f.verify(tree)[1]['reason'], 'check_failed')
        code, result, _ = self.run_gc('--head', pr[0], '--apply')
        self.assertEqual(code, 0, result)
        self.assertEqual(result['reasons'].get('kept: grace'), 2, 'the newest record is in grace, so the whole tree is')
        self.assertEqual(self.f.verify(tree)[1]['reason'], 'check_failed', 'the verdict did not change')
        code, result, _ = self.run_gc('--head', pr[0], '--retention', self.retention(soft_records=1), '--apply')
        self.assertEqual(code, 0, result)
        self.assertEqual(result['reasons']['deleted: over the soft limit (oldest first)'], 2)
        self.assertEqual(self.f.verify(tree)[1]['reason'], 'no_record', 'both went: the check runs')
        self.assertFalse({failure, passing} & {n.rsplit('/', 1)[1] for n in self.refs()})

    def test_no_verdict_of_a_kept_tree_changes_and_a_dropped_tree_only_ever_runs_its_check(self):
        old, recent, pr = self.world()
        other = self.branch_commit(2, content='other\n')
        trees = {'pr': pr, 'recent': recent, 'old': old, 'other': other}
        self.f.layout = 'tree'
        for n, (name, (commit, tree)) in enumerate(sorted(trees.items())):
            for k, days in enumerate((25, 10, 1.5, 0.2)):
                with At(days):
                    self.f.note(commit, tree, self.ci, 'machine/ci1', exit_code=(n + k) % 2, seconds=-int(days * DAY))
            if name in ('old', 'pr'):
                self.index('unit', tree, self.f.git('for-each-ref', '--format=%(objectname)', '--count=1', f'refs/notes/evidence/{tree}/'))
        rules = evidence_verify.policy_rules(support.policy_text(inputs=['src']), 'unit', 'compoundingtech/fractal')
        verdicts = lambda: {name: self.f.verify(tree, rules=rules)[1].get('reason', 'satisfied') for name, (_, tree) in trees.items()}
        before = verdicts()
        code, result, _ = self.run_gc('--head', pr[0], '--retention', self.retention(soft_records=5), '--apply')
        self.assertEqual(code, 0, result)
        after = verdicts()
        live = {'pr', 'recent'}
        self.assertEqual({k: after[k] for k in live}, {k: before[k] for k in live}, result)
        for name in set(trees) - live:
            self.assertIn(after[name], (before[name], 'no_record'), name)
        self.assertTrue(result['trees_deleted'] >= 1, result)

    def test_the_same_refs_give_the_same_plan_and_the_plan_file_carries_its_inputs(self):
        old, recent, pr = self.world()
        self.record(pr[0], pr[1], 29)
        self.record(old[0], 'a' * 40, 10)
        out = [self.f.root / f'plan-{n}.json' for n in range(2)]
        results = [self.run_gc('--head', pr[0], '--plan-out', str(path))[1] for path in out]
        self.assertEqual(results[0]['inputs_sha256'], results[1]['inputs_sha256'])
        self.assertEqual(results[0]['plan_sha256'], results[1]['plan_sha256'])
        written = json.loads(out[0].read_text())
        self.assertEqual(written['delete'], [f'refs/notes/evidence/{"a" * 40}/' + self.refs('refs/notes/evidence/' + 'a' * 40).pop().rsplit('/', 1)[1]])
        self.assertEqual(evidence_gc.digest(written['inputs']), written['inputs_sha256'])
        replayed = evidence_gc.gc_plan([tuple(r) for r in written['inputs']['records']], [tuple(i) for i in written['inputs']['index']],
                                       dict(written['inputs']['live']), {tuple(k) for k in written['inputs']['live_keys']},
                                       written['inputs']['retention'], written['inputs']['as_of'])
        self.assertEqual((replayed['delete'], replayed['migrate']), (written['delete'], [tuple(m) for m in written['migrate']]))


class PurePlan(unittest.TestCase):
    """gc_plan on random worlds: a model of the verifier (the newest record decides, a failure shadows a pass dated within the skew
    after it; an input key's records count for every tree that projects to it) must give the same verdict for every live tree
    after the plan is applied. A dead tree that comes back is a new tree: its verdict is its old one, no record at all, or what its
    input key alone says, the verdict any new tree with the same inputs gets."""

    @staticmethod
    def verdict(records, index, tree, key):
        mine = {(oid, when, failed) for _, oid, _, t, when, failed in records if t == tree}
        mine |= {(oid, when, failed) for _, _, k, oid, when, failed in index if k == key}
        if not mine:
            return 'no_record'
        chosen = max(mine, key=lambda r: (r[1], r[2]))
        if not chosen[2] and any(f and w >= chosen[1] - 120 for _, w, f in mine):
            return 'failed'
        return 'failed' if chosen[2] else 'satisfied'

    def test_random_worlds(self):
        rng = random.Random(3062)
        for case in range(400):
            as_of = NOW
            trees = [f'{n:040x}' for n in range(1, rng.randint(2, 12))]
            key_of = {t: rng.choice(['k1', 'k2', 'k3', None]) for t in trees}
            live = {t: rng.choice(['branch-tip', 'main-window']) for t in trees if rng.random() < 0.4}
            live_keys = {('unit', key_of[t]) for t in live if key_of[t]}
            records, index = [], []
            for t in trees:
                for r in range(rng.randint(0, 4)):
                    oid = f'{rng.getrandbits(160):040x}'
                    when = as_of - rng.randint(0, 4 * DAY)
                    failed = rng.random() < 0.4
                    for layout in rng.sample(['tag', 'tree'], rng.randint(1, 2)):
                        prefix = evidence_gc.TAGS if layout == 'tag' else evidence_gc.NOTES
                        records.append((f'{prefix}{t}/{oid}', oid, layout, t, when, failed))
                    if key_of[t] and rng.random() < 0.5:
                        index.append((f'{evidence_gc.INPUT_TAGS}unit/{key_of[t]}/{oid}', 'unit', key_of[t], oid, when, failed))
            retention = {**RETENTION, 'grace_hours': rng.choice([0, 6, 24, 72]), 'soft_records': rng.randint(1, 30)}
            retention['cap_records'] = retention['soft_records'] + rng.randint(0, 10)
            strip = lambda rows: [row[:-1] for row in rows]
            plan = evidence_gc.gc_plan(strip(records), strip(index), live, live_keys, retention, as_of)
            shuffled_r, shuffled_i = strip(records), strip(index)
            rng.shuffle(shuffled_r)
            rng.shuffle(shuffled_i)
            again = evidence_gc.gc_plan(shuffled_r, shuffled_i, dict(reversed(list(live.items()))), set(live_keys), retention, as_of)
            self.assertEqual(plan, again, f'case {case}: input order changed the plan')
            doomed = set(plan['delete'])
            for t in trees:
                names = {r[0] for r in records if r[3] == t}
                self.assertIn(names & doomed, (set(), names), f'case {case}: tree {t} was split')
                if t in live:
                    self.assertFalse(names & doomed, f'case {case}: a live tree lost a record')
            for k in ('k1', 'k2', 'k3'):
                names = {i[0] for i in index if i[2] == k}
                self.assertIn(names & doomed, (set(), names), f'case {case}: key {k} was split')
                if ('unit', k) in live_keys:
                    self.assertFalse(names & doomed, f'case {case}: a live key lost a record')
            kept_r = [r for r in records if r[0] not in doomed]
            kept_i = [i for i in index if i[0] not in doomed]
            for t in trees:
                before = self.verdict(records, index, t, key_of[t])
                after = self.verdict(kept_r, kept_i, t, key_of[t])
                if t in live:
                    self.assertEqual(after, before, f'case {case}: live tree {t} changed its verdict')
                else:
                    fresh = self.verdict([], kept_i, None, key_of[t])
                    self.assertIn(after, (before, 'no_record', fresh), f'case {case}: dead tree {t} changed its verdict')
            if plan['records_after'] > retention['soft_records']:
                cutoff = as_of - retention['grace_hours'] * 3600
                young_dead = [r for r in kept_r if r[3] not in live and r[4] < cutoff]
                self.assertFalse(young_dead, f'case {case}: over the soft limit yet an old dead record remains')


if __name__ == '__main__':
    unittest.main()
