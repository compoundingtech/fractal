#!/usr/bin/env python3
"""scripts/evidence-gc against real repositories and signed notes: the keep/delete matrix, migration of the first layout, the input-key
index, the soft limit and the cap, fail-closed on an unresolved head, a remote, and idempotence. An open pull request head is never deleted."""
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import sys
import unittest

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
GC = ROOT / 'scripts/evidence-gc'
loader = importlib.machinery.SourceFileLoader('evidence_verify_test', str(ROOT / 'scripts/evidence-verify-test'))
support = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(support)
Fixture, evidence_verify = support.Fixture, support.evidence_verify
DAY = 86400
NOW = 1_800_000_000


class At:
    """Run git inside with its dates `days_ago` days before NOW, so commits and notes have controllable ages."""

    def __init__(self, days_ago):
        self.stamp = f'{NOW - int(days_ago * DAY)} +0000'

    def __enter__(self):
        self.saved = {k: os.environ.get(k) for k in ('GIT_COMMITTER_DATE', 'GIT_AUTHOR_DATE')}
        os.environ['GIT_COMMITTER_DATE'] = os.environ['GIT_AUTHOR_DATE'] = self.stamp

    def __exit__(self, *exc):
        for key, value in self.saved.items():
            os.environ.pop(key, None)
            if value is not None:
                os.environ[key] = value


class Gc(unittest.TestCase):
    def setUp(self):
        self.f = Fixture()
        self.addCleanup(self.f.tmp.cleanup)
        self.ci = self.f.key('ci', 'machine/ci1')
        (self.f.repo / 'src').mkdir()
        (self.f.repo / '.st').mkdir()
        (self.f.repo / '.st/evidence-skip-policy.json').write_text(support.policy_text(inputs=['src']))
        self.n = 0
        self.main_commits = []
        self.f.git('checkout', '-q', '-b', 'main')

    def land(self, days_ago):
        """A commit on main `days_ago` days old that changes src/, so its tree and its input key are new."""
        self.n += 1
        with At(days_ago):
            (self.f.repo / 'src/a.txt').write_text(f'main {self.n}\n')
            self.f.git('add', '-A')
            self.f.git('commit', '-q', '-m', f'main {self.n}')
            commit, tree = self.f.git('rev-parse', 'HEAD'), self.f.git('rev-parse', 'HEAD^{tree}')
        self.main_commits.append((commit, tree))
        return commit, tree

    def branch_commit(self, days_ago, content=None):
        """A commit off main's tip that is not on main (a pull request head)."""
        self.n += 1
        tip = self.f.git('rev-parse', 'main')
        self.f.git('checkout', '-q', '--detach', tip)
        with At(days_ago):
            (self.f.repo / 'src/b.txt').write_text(content or f'pr {self.n}\n')
            self.f.git('add', '-A')
            self.f.git('commit', '-q', '-m', f'pr {self.n}')
            commit, tree = self.f.git('rev-parse', 'HEAD'), self.f.git('rev-parse', 'HEAD^{tree}')
        self.f.git('checkout', '-q', 'main')
        return commit, tree

    def record(self, commit, tree, days_ago, layout='tree'):
        self.f.layout = layout
        with At(days_ago):
            return self.f.note(commit, tree, self.ci, 'machine/ci1', check='unit', seconds=self.n)

    def index(self, check, tree, record, paths=('src',)):
        key = evidence_verify.project(str(self.f.repo), tree, list(paths))
        ref = f'refs/notes/evidence-input/{check}/{key}/{record}'
        self.f.git('update-ref', ref, record)
        return ref

    def both(self, commit, tree, days_ago):
        """A record filed the way producers file it during the move to tags: as a tag and as a note naming the same commit."""
        record = self.record(commit, tree, days_ago)
        self.f.git('update-ref', f'refs/tags/evidence/{tree}/{record}', record)
        return record

    def index_both(self, check, tree, record):
        ref = self.index(check, tree, record)
        tag = 'refs/tags/evidence/input/' + ref[len('refs/notes/evidence-input/'):]
        self.f.git('update-ref', tag, record)
        return ref, tag

    def refs(self, prefix='refs/notes'):
        return set(self.f.git('for-each-ref', '--format=%(refname)', prefix).splitlines())

    def run_gc(self, *args, repo=None):
        base = ['--repo', str(repo or self.f.repo), '--main', 'main', '--now', str(NOW)]
        done = subprocess.run([sys.executable, str(GC), *base, *args], capture_output=True, text=True,
                              env={k: v for k, v in os.environ.items() if k != 'EVIDENCE_PUSH_TOKEN'})
        return done.returncode, (json.loads(done.stdout) if done.stdout.strip() else None), done.stderr

    def world(self):
        """main: an old commit (20 d) and a recent one (1 d); one open pull request head that is 30 days old."""
        self.f.git('add', '-A')
        with At(40):
            self.f.git('commit', '-q', '-m', 'base')
        old = self.land(20)
        recent = self.land(1)
        pr = self.branch_commit(30)
        return old, recent, pr

    def test_the_keep_and_delete_matrix(self):
        old, recent, pr = self.world()
        head_old = self.record(pr[0], pr[1], 29)        # a note 29 days old, but for the CURRENT head of an open PR: kept
        main_recent = self.record(recent[0], recent[1], 5)  # a 5-day-old note for a tree of main within the window: kept
        main_old = self.record(old[0], old[1], 19)      # the tree left the window 17 days ago: deleted
        superseded = self.record(old[0], 'a' * 40, 10)  # a note for a head that was force-pushed away: deleted
        recent_unprotected = self.record(old[0], 'b' * 40, 0.1)  # written two hours ago for a tree nobody listed: kept for the grace period
        first_layout_head = self.record(pr[0], pr[1], 28, layout='legacy')  # the first layout, for an open head: migrated
        first_layout_old = self.record(old[0], 'c' * 40, 27, layout='legacy')  # the first layout, unprotected: deleted
        foreign = 'refs/notes/other/x'
        self.f.git('update-ref', foreign, head_old)
        code, result, _ = self.run_gc('--head', pr[0], '--apply')
        self.assertEqual(code, 0, result)
        names = self.refs('refs/notes/evidence')
        want = {f'refs/notes/evidence/{pr[1]}/{head_old}', f'refs/notes/evidence/{pr[1]}/{first_layout_head}',
                f'refs/notes/evidence/{recent[1]}/{main_recent}', f'refs/notes/evidence/{"b" * 40}/{recent_unprotected}'}
        self.assertEqual(names, want, result)
        self.assertIn(foreign, self.refs(), 'a ref outside the two namespaces is never touched')
        reasons = result['reasons']
        self.assertEqual(reasons['kept: open-pr-head'], 2)
        self.assertEqual(reasons['migrated: first layout to tree-prefixed'], 1)
        self.assertEqual(reasons['kept: main-window'], 1)
        self.assertEqual(reasons['kept: grace'], 1)
        self.assertEqual(reasons['deleted: unprotected'], 2)
        self.assertEqual(reasons['deleted: unprotected (first layout)'], 1)
        self.assertEqual((result['refs_before'], result['refs_after']), (7, 4))
        self.assertLess(result['advertised_bytes_after'], result['advertised_bytes_before'])
        for gone in (main_old, superseded, first_layout_old):
            self.assertFalse([n for n in names if n.endswith(gone)], gone)

    def test_the_open_pull_request_head_still_verifies_after_the_first_layout_is_migrated(self):
        old, recent, pr = self.world()
        record = self.record(pr[0], pr[1], 29, layout='legacy')
        self.assertEqual(self.f.verify(pr[1])[0], 0)
        self.assertEqual(self.run_gc('--head', pr[0], '--apply')[0], 0)
        self.assertEqual(self.refs('refs/notes/evidence'), {f'refs/notes/evidence/{pr[1]}/{record}'})
        code, result = self.f.verify(pr[1])
        self.assertEqual((code, result['record']), (0, record))

    def test_a_dry_run_changes_nothing_and_says_what_it_would_do(self):
        old, recent, pr = self.world()
        self.record(old[0], 'a' * 40, 10)
        self.record(pr[0], pr[1], 28, layout='legacy')
        before = self.refs()
        code, result, _ = self.run_gc('--head', pr[0])
        self.assertEqual(code, 0)
        self.assertEqual(result['mode'], 'dry-run')
        self.assertEqual(result['reasons']['deleted: unprotected'], 1)
        self.assertEqual(self.refs(), before)

    def test_an_input_index_ref_survives_only_while_a_protected_head_has_its_key(self):
        old, recent, pr = self.world()
        head_record = self.record(pr[0], pr[1], 29)
        shared = self.index('unit', pr[1], head_record)  # the key the open head projects to: kept
        stale_record = self.record(old[0], old[1], 25)
        stale = self.index('unit', old[1], stale_record)  # a key no protected head has: removed
        code, result, _ = self.run_gc('--head', pr[0], '--apply')
        self.assertEqual(code, 0, result)
        self.assertEqual(self.refs('refs/notes/evidence-input'), {shared})
        self.assertEqual(result['reasons']['kept: input-key'], 1)
        self.assertEqual(result['reasons']['deleted: input-key no longer used'], 1)
        self.assertNotIn(stale, self.refs())

    def test_past_the_soft_limit_the_oldest_unprotected_notes_go_first_and_protected_ones_never(self):
        old, recent, pr = self.world()
        head = self.record(pr[0], pr[1], 29)
        young = [self.record(old[0], f'{n}' * 40, 0.5 - n / 100) for n in range(1, 5)]  # all inside the grace period; 1 is the oldest
        code, result, _ = self.run_gc('--head', pr[0], '--soft', '3', '--apply')
        self.assertEqual(code, 0, result)
        self.assertEqual(result['reasons']['deleted: over the soft limit (oldest first)'], 2)
        left = {name.rsplit('/', 1)[1] for name in self.refs('refs/notes/evidence')}
        self.assertEqual(left, {head, young[2], young[3]})

    def test_a_protected_set_over_the_cap_is_reported_and_nothing_protected_is_deleted(self):
        old, recent, pr = self.world()
        records = [self.record(pr[0], pr[1], 29 - n / 10) for n in range(5)]
        code, result, _ = self.run_gc('--head', pr[0], '--soft', '2', '--cap', '3', '--apply')
        self.assertEqual(code, 3, result)
        self.assertIn('over the cap', result['alert'])
        self.assertEqual({n.rsplit('/', 1)[1] for n in self.refs('refs/notes/evidence')}, set(records))

    def test_a_head_that_cannot_be_resolved_stops_an_apply_before_it_deletes_anything(self):
        old, recent, pr = self.world()
        doomed = self.record(old[0], 'a' * 40, 10)
        before = self.refs()
        code, result, _ = self.run_gc('--head', pr[0], '--head', 'f' * 40, '--apply')
        self.assertEqual(code, 1)
        self.assertEqual(result['unresolved_heads'], ['f' * 40])
        self.assertIn('nothing was changed', result['refused'])
        self.assertEqual(self.refs(), before)
        code, result, _ = self.run_gc('--head', 'f' * 40)  # a dry run only reports it
        self.assertEqual((code, result['unresolved_heads']), (0, ['f' * 40]))
        self.assertIn(f'refs/notes/evidence/{"a" * 40}/{doomed}', self.refs())

    def test_a_second_run_finds_nothing_to_do(self):
        old, recent, pr = self.world()
        self.record(pr[0], pr[1], 28, layout='legacy')
        self.record(old[0], 'a' * 40, 10)
        self.record(recent[0], recent[1], 2)
        self.assertEqual(self.run_gc('--head', pr[0], '--apply')[0], 0)
        after = self.refs()
        code, result, _ = self.run_gc('--head', pr[0], '--apply')
        self.assertEqual(code, 0)
        self.assertEqual((result['refs_before'], result['refs_after']), (len(after), len(after)))
        self.assertEqual({k: v for k, v in result['reasons'].items() if k.startswith(('deleted', 'migrated'))}, {})
        self.assertEqual(self.refs(), after)

    def test_a_remote_gets_the_migrations_first_and_then_the_deletions(self):
        old, recent, pr = self.world()
        head = self.record(pr[0], pr[1], 28, layout='legacy')
        doomed = self.record(old[0], 'a' * 40, 10)
        kept = self.record(recent[0], recent[1], 2)
        bare = self.f.root / 'remote.git'
        subprocess.run(['git', 'init', '-q', '--bare', str(bare)], check=True)
        self.f.git('remote', 'add', 'origin', str(bare))
        self.f.git('push', '-q', 'origin', *[f'{ref}:{ref}' for ref in self.refs('refs/notes/evidence')])
        code, result, _ = self.run_gc('--head', pr[0], '--remote', 'origin', '--apply')
        self.assertEqual(code, 0, result)
        remote = set(subprocess.run(['git', '-C', str(bare), 'for-each-ref', '--format=%(refname)', 'refs/notes/evidence'],
                                    capture_output=True, text=True).stdout.split())
        self.assertEqual(remote, {f'refs/notes/evidence/{pr[1]}/{head}', f'refs/notes/evidence/{recent[1]}/{kept}'})
        self.assertEqual(remote, self.refs('refs/notes/evidence'))
        self.assertNotIn(doomed, ' '.join(remote))

    def test_a_failed_remote_push_leaves_the_local_refs_and_never_prints_the_token(self):
        old, recent, pr = self.world()
        self.record(old[0], 'a' * 40, 10)
        self.f.git('remote', 'add', 'origin', str(self.f.root / 'nowhere.git'))
        before = self.refs()
        done = subprocess.run([sys.executable, str(GC), '--repo', str(self.f.repo), '--main', 'main', '--now', str(NOW), '--head', pr[0],
                               '--remote', 'origin', '--apply'], capture_output=True, text=True,
                              env=dict(os.environ, EVIDENCE_PUSH_TOKEN='sekrit-token-value'))
        self.assertEqual(done.returncode, 1)
        self.assertNotIn('sekrit-token-value', done.stdout + done.stderr)
        self.assertEqual(self.refs(), before)

    def test_a_main_with_no_recent_commit_is_refused_rather_than_treating_every_tree_as_old(self):
        self.f.git('add', '-A')
        with At(40):
            self.f.git('commit', '-q', '-m', 'only an old commit')
        code, _, error = self.run_gc('--apply', '--head', 'f' * 40)
        self.assertEqual(code, 1)
        self.assertIn('refusing', error)

    def test_apply_without_naming_any_head_is_refused_and_a_dry_run_is_not(self):
        old, recent, pr = self.world()
        record = self.record(pr[0], pr[1], 29)  # the head of an open PR, old: an empty head list would delete it
        before = self.refs()
        code, _, error = self.run_gc('--apply')
        self.assertEqual(code, 2)
        self.assertIn('needs the open pull request heads', error)
        self.assertEqual(self.refs(), before)
        code, result, _ = self.run_gc()  # a dry run may be asked with no heads: it only reports
        self.assertEqual((code, result['mode']), (0, 'dry-run'))
        self.assertEqual(self.run_gc('--head', pr[0], '--apply')[0], 0)
        self.assertIn(f'refs/notes/evidence/{pr[1]}/{record}', self.refs())

    def test_a_record_filed_as_a_tag_and_a_note_gets_one_decision_for_both_names(self):
        old, recent, pr = self.world()
        head = self.both(pr[0], pr[1], 29)
        kept = self.both(recent[0], recent[1], 5)
        doomed = self.both(old[0], old[1], 19)
        shared = self.index_both('unit', pr[1], head)
        stale = self.index_both('unit', old[1], doomed)
        code, result, _ = self.run_gc('--head', pr[0], '--apply')
        self.assertEqual(code, 0, result)
        self.assertEqual(self.refs('refs/tags/evidence'), {f'refs/tags/evidence/{pr[1]}/{head}', f'refs/tags/evidence/{recent[1]}/{kept}', shared[1]})
        self.assertEqual(self.refs('refs/notes/evidence'), {f'refs/notes/evidence/{pr[1]}/{head}', f'refs/notes/evidence/{recent[1]}/{kept}'})
        self.assertEqual(self.refs('refs/notes/evidence-input'), {shared[0]})
        self.assertFalse(set(stale) & self.refs('refs'))
        self.assertEqual((result['refs_before'], result['refs_after'], result['records_before'], result['records_after']), (10, 6, 5, 3))
        self.assertEqual(result['protected_records'], 3)
        self.assertEqual(result['reasons']['deleted: unprotected'], 2, 'the tag and the note of the one unprotected record')
        self.f.git('update-ref', '-d', f'refs/notes/evidence/{pr[1]}/{head}')
        code, verified = self.f.verify(pr[1])
        self.assertEqual((code, verified['record']), (0, head), 'the open head still verifies from its tag')

    def test_a_record_with_two_names_counts_once_against_the_soft_limit_and_the_cap(self):
        old, recent, pr = self.world()
        head = self.both(pr[0], pr[1], 29)
        young = [self.both(old[0], f'{n}' * 40, 0.5 - n / 100) for n in range(1, 5)]  # all inside the grace period; 1 is the oldest
        code, result, _ = self.run_gc('--head', pr[0], '--soft', '3', '--apply')
        self.assertEqual(code, 0, result)
        self.assertEqual(result['reasons']['deleted: over the soft limit (oldest first)'], 4, 'two records, both names of each')
        for prefix in ('refs/tags/evidence', 'refs/notes/evidence'):
            self.assertEqual({name.rsplit('/', 1)[1] for name in self.refs(prefix)}, {head, young[2], young[3]}, prefix)
        # Five records under ten names: over a cap of 4 records, not over one of 5.
        for n in range(4):
            self.both(pr[0], pr[1], 28 - n / 10)
        self.assertEqual(self.run_gc('--head', pr[0], '--soft', '3', '--cap', '5', '--apply')[0], 0)
        code, result, _ = self.run_gc('--head', pr[0], '--soft', '3', '--cap', '4', '--apply')
        self.assertEqual(code, 3, result)
        self.assertEqual((result['protected_records'], result['protected_refs']), (5, 10))

    def test_a_remote_loses_both_names_and_fetch_reads_the_tags(self):
        old, recent, pr = self.world()
        head = self.both(pr[0], pr[1], 28)
        doomed = self.both(old[0], 'a' * 40, 10)
        bare = self.f.root / 'remote.git'
        subprocess.run(['git', 'init', '-q', '--bare', str(bare)], check=True)
        self.f.git('remote', 'add', 'origin', str(bare))
        self.f.git('push', '-q', 'origin', 'main:main', *[f'{ref}:{ref}' for ref in self.refs('refs/notes/evidence') | self.refs('refs/tags/evidence')])
        for ref in self.refs('refs/tags/evidence'):
            self.f.git('update-ref', '-d', ref)  # only --fetch can bring the tags back
        code, result, _ = self.run_gc('--head', pr[0], '--remote', 'origin', '--fetch', '--apply')
        self.assertEqual(code, 0, result)
        self.assertEqual((result['refs_before'], result['records_before']), (4, 2), result)
        remote = set(subprocess.run(['git', '-C', str(bare), 'for-each-ref', '--format=%(refname)', 'refs/notes/evidence', 'refs/tags/evidence'],
                                    capture_output=True, text=True).stdout.split())
        self.assertEqual(remote, {f'refs/notes/evidence/{pr[1]}/{head}', f'refs/tags/evidence/{pr[1]}/{head}'})
        self.assertNotIn(doomed, ' '.join(remote))

    def test_bad_arguments_are_refused(self):
        self.world()
        self.assertEqual(self.run_gc('--soft', '5', '--cap', '3')[0], 2)
        self.assertEqual(self.run_gc('--keep-main-days', '0')[0], 2)
        self.assertEqual(self.run_gc('--head', 'short')[0], 1)


if __name__ == '__main__':
    unittest.main()
