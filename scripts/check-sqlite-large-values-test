#!/usr/bin/env python3
"""Mutation controls for the source inventory policy; never opens SQLite or compiles Rust."""
import json
from pathlib import Path
import sys
import subprocess
import tempfile
import unittest
sys.dont_write_bytecode = True
from sqlite_large_values import MANIFEST, REGENERATE, declarations, findings, formatting_findings, manifest_text, record, scan, scan_file, sqlite_crates, flow_site, inventory_delta


class Policy(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory(prefix="sqlite-source-policy-")
        self.addCleanup(self.tmp.cleanup)
        self.root = Path(self.tmp.name)
        self.path = self.root / "crates/sample/src/lib.rs"
        self.path.parent.mkdir(parents=True)
        (self.path.parent.parent / "Cargo.toml").write_text('[dependencies]\nrusqlite = "0.32"\n')
        self.manifest = {"version": 1, "coverage": "rust-source-sql-sites-v1", "sites": [], "sqlite_crates": ["sample"]}

    def register(self, text):
        self.path.write_text(text)
        sites, _ = scan(self.root)
        self.manifest["sites"] = [record(s) for s in sites]
        self.manifest["declarations"] = declarations(self.root, sites)
        for s in reversed(sites):
            marker = f"/* sqlite-large-value: allow-for-now {s.id} owner={s.owner} TODO={s.todo} */"
            text = text[:s.start] + marker + " " + text[s.start:]
        self.path.write_text(text)
        self.assertEqual(findings(self.root, self.manifest), [])
        return text

    def fails(self, text, contains):
        self.path.write_text(text)
        errors = findings(self.root, self.manifest)
        self.assertTrue(any(contains in error for error in errors), errors)

    def test_canonical_order_and_single_line_records(self):
        manifest = {"version": 1, "reviewed_base": "reviewed-not-current-head",
                    "sites": [{"id": "lv-hf00000000000", "excerpt": "a\nb"},
                              {"id": "lv-h100000000000"}]}
        text = manifest_text(manifest)
        parsed = json.loads(text)
        self.assertEqual([e["id"] for e in parsed["sites"]],
                         ["lv-h100000000000", "lv-hf00000000000"])
        self.assertEqual(parsed["reviewed_base"], manifest["reviewed_base"])
        self.assertEqual(len([line for line in text.splitlines() if '"id":' in line]), 2)
        self.assertEqual(formatting_findings(text, parsed), [])
        wrong_order = text.replace('lv-h100000000000', 'lv-hf00000000001')
        for invalid in (wrong_order, json.dumps(parsed, indent=2) + "\n"):
            errors = formatting_findings(invalid, json.loads(invalid))
            self.assertEqual(len(errors), 1)
            self.assertIn(REGENERATE, errors[0])

    def test_guard_rejects_noncanonical_text_and_format_command_repairs_it(self):
        path = self.root / MANIFEST
        path.parent.mkdir(parents=True)
        path.write_text(json.dumps(self.manifest, indent=4) + "\n")
        command = [sys.executable, str(Path(__file__).with_name("check-sqlite-large-values")),
                   "--root", str(self.root)]
        result = subprocess.run(command, capture_output=True, text=True)
        self.assertEqual(result.returncode, 1)
        self.assertIn(REGENERATE, result.stderr)
        subprocess.run([*command, "--format"], check=True, capture_output=True)
        self.assertEqual(path.read_text(), manifest_text(self.manifest))

    def test_independent_hash_ordered_inserts_merge_cleanly(self):
        base = {"sites": [{"id": f"lv-h{value:012x}"} for value in
                          (0x100, 0x300, 0x500, 0x700, 0x900, 0xb00, 0xd00, 0xf00)]}
        ours = dict(base, sites=[*base["sites"], {"id": "lv-h000000000200"}])
        theirs = dict(base, sites=[*base["sites"], {"id": "lv-h000000000e00"}])
        paths = [self.root / name for name in ("ours.json", "base.json", "theirs.json")]
        for path, manifest in zip(paths, (ours, base, theirs)):
            path.write_text(manifest_text(manifest))
        result = subprocess.run(["git", "merge-file", "-p", *map(str, paths)],
                                capture_output=True, text=True)
        self.assertEqual(result.returncode, 0, result.stdout + result.stderr)
        merged = json.loads(result.stdout)
        self.assertEqual(len(merged["sites"]), 10)
        self.assertEqual(result.stdout, manifest_text(merged))
        self.assertIn({"id": "lv-h000000000200"}, merged["sites"])
        self.assertIn({"id": "lv-h000000000e00"}, merged["sites"])
        print("git merge-file: two independent hash-ordered inserts merged cleanly (10 records)")

    def test_new_inline_write_is_not_grandfathered_by_old_exception(self):
        old = self.register('fn write() { db.execute("INSERT INTO facts(body) VALUES(?1)", [body]); }')
        self.fails(old + '\nfn extra() { db.execute("UPDATE facts SET body=?1", [other]); }', "unregistered")

    def test_records_carry_no_stored_diagnostics(self):
        self.register('fn write() { db.execute("INSERT INTO facts(body) VALUES(?1)", [body]); }')
        self.assertEqual(set(self.manifest["sites"][0]),
                         {"id", "path", "kind", "fingerprint", "owner", "todo", "disposition"})

    def test_unregistered_site_failure_reports_excerpt_and_line_from_source(self):
        old = self.register('fn write() { db.execute("INSERT INTO facts(body) VALUES(?1)", [body]); }')
        text = old + '\nfn extra() { db.execute("UPDATE facts SET body=?1", [other]); }'
        self.path.write_text(text)
        errors = findings(self.root, self.manifest)
        self.assertTrue(any("unregistered" in e for e in errors), errors)
        line = text.count("\n", 0, text.index("UPDATE facts")) + 1
        self.assertTrue(any(f"crates/sample/src/lib.rs:{line}: " in e and "UPDATE facts SET body=?1" in e
                            for e in errors), errors)

    def test_stored_diagnostic_fields_are_rejected(self):
        self.register('fn write() { db.execute("INSERT INTO facts(body) VALUES(?1)", [body]); }')
        self.manifest["sites"][0]["excerpt"] = "stale excerpt"
        self.assertTrue(any("non-canonical fields" in e for e in findings(self.root, self.manifest)))
        del self.manifest["sites"][0]["excerpt"]
        self.manifest["sites"][0]["line_hint"] = 1
        self.assertTrue(any("non-canonical fields" in e for e in findings(self.root, self.manifest)))

    def test_empty_ambiguous_sink_keeps_marker_stable(self):
        self.register("fn candidate() { publication.prepare(); }")

    def test_new_dynamic_sink_requires_its_own_disposition(self):
        old = self.register('fn write() { db.execute("INSERT INTO facts(body) VALUES(?1)", [body]); }')
        self.fails(old + '\nfn extra() { db.execute_batch(generated_sql); }', "unregistered unresolved-sql-sink")

    def test_sql_edit_invalidates_old_exception(self):
        old = self.register('fn write() { db.execute("INSERT INTO facts(body) VALUES(?1)", [body]); }')
        self.fails(old.replace('facts(body)', 'facts(payload)'), "unregistered")

    def test_missing_source_site_leaves_stale_entry(self):
        self.register('fn write() { db.execute("INSERT INTO facts(body) VALUES(?1)", [body]); }')
        self.fails('fn write() {}', "stale inventory")

    def test_marker_removal_and_owner_todo_tampering_fail(self):
        old = self.register('fn write() { db.execute("INSERT INTO facts(body) VALUES(?1)", [body]); }')
        begin, end = old.index('/*'), old.index('*/') + 2
        self.fails(old[:begin] + old[end:], "missing/mismatched")
        self.fails(old.replace('owner=sample', 'owner=unknown'), "missing/mismatched")
        self.fails(old.replace('TODO=bound-or-reference-values-and-reclamation', 'TODO=later'), "missing/mismatched")
        self.fails(old.replace('allow-for-now', 'allowed'), "malformed sqlite-large-value")

    def test_manifest_owner_todo_and_disposition_tampering_fail(self):
        self.register('fn write() { db.execute("INSERT INTO facts(body) VALUES(?1)", [body]); }')
        for key, value in [('owner', 'unknown'), ('todo', ''), ('disposition', 'permanent')]:
            with self.subTest(key=key):
                saved = self.manifest['sites'][0][key]
                self.manifest['sites'][0][key] = value
                self.assertTrue(any('stale/malformed' in e for e in findings(self.root, self.manifest)))
                self.manifest['sites'][0][key] = saved

    def test_duplicate_exception_and_orphan_marker_fail(self):
        old = self.register('fn write() { db.execute("INSERT INTO facts(body) VALUES(?1)", [body]); }')
        self.manifest['sites'].append(dict(self.manifest['sites'][0]))
        self.assertTrue(any('duplicate inventory' in e for e in findings(self.root, self.manifest)))
        self.manifest['sites'].pop()
        marker = old[old.index('/*'):old.index('*/') + 2]
        self.fails(old + '\n' + marker, 'duplicate marker')

    def test_same_sql_at_another_site_is_not_covered_by_one_marker(self):
        old = self.register('fn write() { db.execute("INSERT INTO facts(body) VALUES(?1)", [body]); }')
        self.fails(old + '\nfn another() { db.execute("INSERT INTO facts(body) VALUES(?1)", [body]); }', 'unregistered')

    def test_raw_strings_nested_comments_chars_and_lifetimes_are_lexed(self):
        text = '''/* outer /* nested "DELETE FROM fake" */ comment */
fn write<'a>(db: &'a Db) {
 let brace = '{'; let quoted = '\\'';
 db.execute(r###"UPDATE facts SET body='/* not Rust comment */'"###, [body]);
}'''
        sites, _ = scan_file('crates/sample/src/lib.rs', text)
        self.assertEqual([s.kind for s in sites], ['sql-template'])
        self.register(text)

    def test_explicit_inline_cfg_test_is_excluded_but_not_not_test(self):
        sites, _ = scan_file('crates/sample/src/lib.rs', '''
#[cfg(test)] mod tests { fn fixture() { db.execute("DELETE FROM fake", []); } }
#[cfg(not(test))] fn live() { db.execute("DELETE FROM facts", []); }
''')
        self.assertEqual(len(sites), 1)
        self.assertIn('facts', sites[0].excerpt)

    def test_read_literal_is_not_write_but_prepared_bind_is_unresolved(self):
        sites, _ = scan_file('crates/sample/src/lib.rs', '''
fn read() { db.query_row("SELECT body FROM facts", [], row); }
fn bind() { statement.execute(params!["SELECT not a query", body]); }
''')
        self.assertEqual([s.kind for s in sites], ['unresolved-sql-sink'])

    def test_included_source_and_new_standalone_sql_fail_closed(self):
        self.path.write_text('include_str!("schema.data");')
        self.assertTrue(any('unregistered included-source' in e for e in findings(self.root, self.manifest)))
        self.path.write_text('')
        (self.path.parent / 'schema.sql').write_text('INSERT INTO facts VALUES(1);')
        self.assertTrue(any('outside v1 coverage' in e for e in findings(self.root, self.manifest)))

    def test_malformed_inventory_cannot_skip_coverage(self):
        self.path.write_text('')
        self.assertTrue(findings(self.root, {}))
        self.assertTrue(findings(self.root, {**self.manifest, 'sites': None}))

    def test_column_and_index_catalog_cannot_be_silently_edited(self):
        self.register('fn schema() { db.execute_batch("CREATE TABLE facts(body TEXT, payload BLOB, key TEXT); CREATE INDEX facts_key ON facts(key);"); }')
        self.assertEqual(len(self.manifest['declarations']), 2)
        self.assertEqual([c['name'] for c in self.manifest['declarations'][0]['columns']], ['body', 'payload', 'key'])
        self.manifest['declarations'][0]['columns'][0]['value_size_proven'] = True
        self.assertTrue(any('potential-column/index catalog' in e for e in findings(self.root, self.manifest)))

    def test_alter_added_variable_column_and_dynamic_name_are_cataloged(self):
        self.register('fn upgrade() { db.execute_batch("ALTER TABLE facts ADD COLUMN payload BLOB; ALTER TABLE {table} ADD COLUMN {column} TEXT;"); }')
        first, dynamic = self.manifest['declarations']
        self.assertEqual(first['operation'], 'add-column')
        self.assertEqual(first['columns'][0]['name'], 'payload')
        self.assertEqual(first['columns'][0]['declared_type'], 'BLOB')
        self.assertFalse(first['columns'][0]['value_size_proven'])
        self.assertTrue(dynamic['unresolved_template'])

    def test_manual_import_flow_is_source_bound_and_not_permanent(self):
        text = self.register('pub fn import_history(value: Value) { forward(value); }')
        flow = flow_site('crates/sample/src/lib.rs', text, 'import_history')
        start = flow.pop('start')
        flow['todo'] = 'chunk-or-reference-exact-wire-values'; flow['disposition'] = 'allow-for-now'
        self.manifest['flows'] = [flow]
        marker = f"/* sqlite-large-value-flow: allow-for-now {flow['id']} owner={flow['owner']} TODO={flow['todo']} */ "
        marked = text[:start] + marker + text[start:]
        self.path.write_text(marked)
        self.assertEqual(findings(self.root, self.manifest), [])
        flow['disposition'] = 'permanent'
        self.assertTrue(any('stale/malformed flow' in e for e in findings(self.root, self.manifest)))
        self.assertEqual(inventory_delta(self.root, self.manifest)['manual_flow_changes'][0]['proposed']['disposition'], 'allow-for-now')
        del flow['disposition']
        self.assertTrue(any('stale/malformed flow' in e for e in findings(self.root, self.manifest)))
        flow['disposition'] = 'allow-for-now'
        self.fails(marked.replace('forward(value)', 'forward(replacement)'), 'stale/malformed flow')
        self.fails(text, 'missing/malformed adjacent flow')
        self.fails(marked.replace('allow-for-now', 'permanent'), 'malformed flow')
        self.fails('fn removed() {}', 'must name one')

    def test_new_sqlite_dependency_crate_requires_coverage_review(self):
        self.register('fn no_sql() {}')
        path = self.root / 'crates/new/Cargo.toml'
        path.parent.mkdir(parents=True)
        path.write_text('[dependencies]\nlibsqlite3-sys = "0.1"\n')
        self.assertTrue(any('dependency crate inventory changed' in e for e in findings(self.root, self.manifest)))

    def test_marker_inside_sql_string_is_not_a_rust_exception(self):
        text = 'fn bad() { db.execute("INSERT INTO facts VALUES(1) /* sqlite-large-value: allow-for-now lv-h000000000000 owner=sample TODO=bound-or-reference-values-and-reclamation */", []); }'
        self.path.write_text(text)
        self.assertTrue(any('missing/mismatched adjacent' in e for e in findings(self.root, self.manifest)))

    def test_proposal_pairs_changed_marker_and_preserves_new_removed_sites(self):
        old = self.register('fn first() { db.execute("INSERT INTO facts(body) VALUES(?1)", [body]); }')
        unchanged = inventory_delta(self.root, self.manifest)
        self.assertEqual([unchanged[k] for k in ('added', 'changed', 'removed')], [[], [], []])
        changed = old.replace('facts(body)', 'facts(payload)')
        self.path.write_text(changed + '\nfn new() { db.execute("DELETE FROM gone", []); }')
        proposal = inventory_delta(self.root, self.manifest)
        self.assertEqual(len(proposal['changed']), 1)
        self.assertNotEqual(proposal['changed'][0]['before']['fingerprint'], proposal['changed'][0]['proposed']['fingerprint'])
        self.assertEqual(len(proposal['added']), 1)
        self.assertEqual(proposal['removed'], [])
        self.assertTrue(proposal['requires_human_owner_TODO_review'])
        self.assertFalse(proposal['writes_files'])
        self.path.write_text('fn replaced() { db.execute("DELETE FROM replacement", []); }')
        unanchored = inventory_delta(self.root, self.manifest)
        self.assertEqual([len(unanchored[k]) for k in ('added', 'changed', 'removed')], [1, 0, 1])

    def test_proposal_is_deterministic_and_cannot_make_the_guard_pass(self):
        old = self.register('fn schema() { db.execute_batch("CREATE TABLE facts(body TEXT);"); }')
        self.path.write_text(old.replace('body TEXT', 'payload BLOB'))
        before = self.path.read_bytes()
        manifest_before = json.dumps(self.manifest, sort_keys=True)
        proposal = inventory_delta(self.root, self.manifest)
        self.assertEqual(proposal, inventory_delta(self.root, self.manifest))
        self.assertEqual(len(proposal['declarations_added']), 1)
        self.assertEqual(len(proposal['declarations_removed']), 1)
        self.assertEqual(self.path.read_bytes(), before)
        self.assertEqual(json.dumps(self.manifest, sort_keys=True), manifest_before)
        self.assertTrue(findings(self.root, self.manifest))
        self.manifest['sites'].append(dict(self.manifest['sites'][0]))
        with self.assertRaisesRegex(ValueError, 'duplicate'):
            inventory_delta(self.root, self.manifest)

    def test_proposal_manual_flow_fingerprint_is_not_silently_renewed(self):
        self.register('fn import_history(value: Value) { forward(value); }')
        flow = flow_site('crates/sample/src/lib.rs', self.path.read_text(), 'import_history')
        flow.pop('start'); flow['todo'] = 'chunk-or-reference-exact-wire-values'; flow['disposition'] = 'allow-for-now'
        self.manifest['flows'] = [flow]
        self.path.write_text('fn import_history(value: Value) { forward(replacement); }')
        proposal = inventory_delta(self.root, self.manifest)
        self.assertEqual(len(proposal['manual_flow_changes']), 1)
        self.assertEqual(self.manifest['flows'][0]['fingerprint'], flow['fingerprint'])
        self.assertNotEqual(proposal['manual_flow_changes'][0]['proposed']['fingerprint'], flow['fingerprint'])

    def test_proposal_cli_prints_deterministic_delta_without_editing_files(self):
        old = self.register('fn old() { db.execute("INSERT INTO facts VALUES(1)", []); }')
        self.path.write_text(old.replace('VALUES(1)', 'VALUES(2)'))
        inventory = self.root / MANIFEST
        inventory.parent.mkdir(parents=True)
        inventory.write_text(json.dumps(self.manifest))
        before = {p: p.read_bytes() for p in self.root.rglob('*') if p.is_file()}
        command = [sys.executable, str(Path(__file__).with_name('propose-sqlite-large-values')), '--root', str(self.root)]
        first = subprocess.run(command, check=True, capture_output=True, text=True)
        second = subprocess.run(command, check=True, capture_output=True, text=True)
        self.assertEqual(first.stdout, second.stdout)
        self.assertEqual(json.loads(first.stdout)['mode'], 'proposal-only')
        self.assertEqual(len(json.loads(first.stdout)['changed']), 1)
        self.assertEqual({p: p.read_bytes() for p in self.root.rglob('*') if p.is_file()}, before)
        self.assertTrue(findings(self.root, self.manifest))

    def test_typed_hash_ids_do_not_look_like_bare_decision_citations(self):
        # Model the held VRS boundary predicate on invented marker lines only.
        # The actual Rust ledger oracle is unchanged and remains a hosted gate.
        def bare(line, number):
            named = number + '-' in line
            rest = line
            while number in rest:
                at = rest.index(number)
                after = rest[at + len(number):]
                inside = (bool(after) and after[0].isnumeric()) or (at > 0 and rest[at - 1].isalnum())
                if not named and not after.startswith('-') and not inside:
                    return True
                rest = after
            return False
        for number in ('0005', '0007', '0014', '0015'):
            for prefix in ('lv', 'flow'):
                old = f'{prefix}-{number}abcdefab'
                self.assertTrue(bare(old, number))
                for suffix in (number + 'abcdefab', 'abcd' + number + 'abcd', 'abcdefab' + number):
                    new = f'{prefix}-h{suffix}'
                    self.assertRegex(new, r'^(lv|flow)-h[0-9a-f]{12}$')
                    self.assertFalse(bare(new, number))
        text = self.register('fn write() { db.execute("INSERT INTO facts VALUES(1)", []); }')
        self.assertRegex(self.manifest['sites'][0]['id'], r'^lv-h[0-9a-f]{12}$')
        self.assertRegex(flow_site('crates/sample/src/lib.rs', text, 'write')['id'], r'^flow-h[0-9a-f]{12}$')
        self.fails(text.replace('lv-h', 'lv-'), 'malformed sqlite-large-value exception')


if __name__ == '__main__':
    unittest.main()
