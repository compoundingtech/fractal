#!/usr/bin/env bash
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
# Install physical fractal and its tools from one source build. The temporary
# st and st3 commands are reverse aliases, never separately copied binaries.
#
# usage: scripts/install [--bin-dir DIR] [--from DIR] [--instance NAME]
#
#   --bin-dir DIR  install destination (default: $HOME/.local/bin)
#   --from DIR     install already-built binaries from DIR instead of running cargo
#   --instance NAME  install a second, separate copy below ~/.st-instance/NAME (its own
#                  command directory, macOS app, bundle identifier and launchd services)
set -Eeuo pipefail

bin_dir=""
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
instance="${FRACTAL_INSTANCE-${ST_INSTANCE:-}}"
from=""
while (($#)); do
  case $1 in
    --bin-dir) bin_dir=${2:?--bin-dir needs a directory}; shift 2 ;;
    --instance) instance=${2:?--instance needs a name}; shift 2 ;;
    --from) from=${2:?--from needs a directory}; shift 2 ;;
    -h | --help) sed -n '2,10p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "install: unknown argument: $1" >&2; exit 2 ;;
  esac
done

if [[ -n $instance ]]; then
  [[ ${#instance} -le 24 && $instance =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || {
    echo "install: an instance name is lowercase letters, digits and single hyphens, at most 24 characters" >&2
    exit 2
  }
  # A named instance installs below its own directory unless told otherwise.
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
  [[ -n $bin_dir ]] || bin_dir=${FRACTAL_MACOS_BIN_DIR-${ST_MACOS_BIN_DIR:-$HOME/.st-instance/$instance/bin}}
fi
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read — normalize shared installs too.
export FRACTAL_INSTANCE=$instance ST_INSTANCE=$instance
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
bin_dir=${bin_dir:-${FRACTAL_MACOS_BIN_DIR-${ST_MACOS_BIN_DIR:-$HOME/.local/bin}}}

binaries=(fractal st3-migrate)

if [[ -z $from ]]; then
  repo=$(cd "$(dirname "$0")/.." && pwd)
  cargo build --release --locked --manifest-path "$repo/Cargo.toml" \
    -p fractal-cli -p fractal-migrate
  from=${CARGO_TARGET_DIR:-$repo/target}/release
  # The terminal client's speech helper, on a Mac whose Swift has the macOS 26 SDK; SmallTalk.app takes it in.
  if [[ $(uname -s) == Darwin ]] && ! "$repo/apps/macos/listen/build.sh" "$from" >/dev/null; then
    echo "install: the speech helper did not build here; the terminal interface will have no voice" >&2
    rm -rf "$from/StListen.app"
  fi
fi

for binary in "${binaries[@]}"; do
  [[ -x $from/$binary && ! -d $from/$binary && ! -L $from/$binary ]] || {
    echo "install: $from/$binary is not an executable file" >&2
    exit 1
  }
done
# Share the release installer's Nix and canonical-command ownership policy.
installer="$(cd "$(dirname "$0")" && pwd)/install-release"
bash "$installer" --source-preflight --bin-dir "$bin_dir"
bin_dir=$(cd "$bin_dir" && pwd)
for name in "${binaries[@]}" st st3 stui; do
  [[ ! -d $bin_dir/$name ]] || {
    echo "install: $bin_dir/$name is a directory; refusing to replace it" >&2
    exit 1
  }
done
stage=
locked=false
rollback_ready=false
committed=false
# Compare the directory entries themselves, including hardlinked dangling
# symlinks. Neither GNU nor Darwin stat follows links without an explicit -L.
previous_entry_is_unchanged() {
  local previous current
  if $macos; then
    previous=$(stat -f '%d:%i' "$1" 2>/dev/null) || return 1
    current=$(stat -f '%d:%i' "$2" 2>/dev/null) || return 1
  else
    previous=$(stat -c '%d:%i' -- "$1" 2>/dev/null) || return 1
    current=$(stat -c '%d:%i' -- "$2" 2>/dev/null) || return 1
  fi
  [[ -n $previous && -n $current && $previous == "$current" ]]
}

cleanup() {
  status=$?
  trap - EXIT
  set +e
  restored=true
  if $rollback_ready && ! $committed; then
    for name in "${binaries[@]}" st st3 stui; do
      # The macOS helper owns its independent signed-app/link transaction.
      if $macos && [[ $name == fractal || $name == st || $name == st3 ]]; then continue; fi
      if [[ -e $stage/previous/$name || -L $stage/previous/$name ]]; then
        # An untouched hardlink is already restored; mv rejects identical
        # source/destination entries. Uncertain identity uses the original
        # restore path, retaining evidence if that operation really fails.
        if previous_entry_is_unchanged "$stage/previous/$name" "$bin_dir/$name"; then continue; fi
        mv -f "$stage/previous/$name" "$bin_dir/$name" || restored=false
      else
        rm -f -- "$bin_dir/$name" || restored=false
      fi
    done
  fi
  if $restored; then
    [[ -z $stage ]] || rm -rf "$stage"
    if $locked; then rmdir "$bin_dir/.smalltalk-install.lock"; fi
  else
    echo "install: rollback failed; prior files and lock retained in $stage" >&2
    status=1
  fi
  exit "$status"
}
macos=false
[[ $(uname -s) != Darwin ]] || macos=true
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
mkdir "$bin_dir/.smalltalk-install.lock" || {
  echo "install: another install or retained recovery lock exists: $bin_dir/.smalltalk-install.lock" >&2
  exit 1
}
locked=true
stage=$(mktemp -d "$bin_dir/.source.install.XXXXXX")
mkdir "$stage/previous"
for name in "${binaries[@]}" st st3 stui; do
  if [[ -e $bin_dir/$name || -L $bin_dir/$name ]]; then
    ln -P "$bin_dir/$name" "$stage/previous/$name"
  fi
done
for binary in "${binaries[@]}"; do
  cp "$from/$binary" "$stage/$binary"
  chmod 0755 "$stage/$binary"
done
# LIVE-MIGRATION BRIDGE arn:lmig:smalltalk:2026-10-16-fractal-binary-aliases — DELETE at contraction — https://github.com/compoundingtech/fractal/issues/3032
ln -s fractal "$stage/st"
ln -s fractal "$stage/st3"
# LIVE-MIGRATION END arn:lmig:smalltalk:2026-10-16-fractal-binary-aliases
if $macos; then
  python3 "$(dirname "$installer")/install-macos.py" --from "$from" --bin-dir "$bin_dir"
fi
rollback_ready=true
for name in "${binaries[@]}" st st3; do
  if $macos && [[ $name == fractal || $name == st || $name == st3 ]]; then continue; fi
  mv -f "$stage/$name" "$bin_dir/$name"
done
rm -f -- "$bin_dir/stui"
committed=true
printf 'installed %s and st/st3 -> fractal in %s\n' "${binaries[*]}" "$bin_dir"
