#!/usr/bin/env python3
"""Does a trusted, signed evidence note exist for this tree and this check?

Standalone on purpose: git, ssh-keygen and the Python standard library, no built st.
It reads the notes written by `st evidence` (refs/tags/evidence/<tree>/<record-id> or
refs/notes/evidence/<tree>/<record-id>, one SSH-signed commit per record, found by one prefix listing
of the tree's own refs in each namespace; the first layout, refs/notes/evidence/<record-id>, is still
read until scripts/evidence-gc has removed it) and answers with one JSON document on stdout.
Records are moving to tags because a ruleset can protect tags and not notes (docs/st3/gate-evidence.md,
"Records as tags"); either name of a record is the same signed commit, read once.

  exit 0  satisfied
  exit 1  not satisfied (JSON carries the reason), including unreadable input
  exit 2  usage error

Trust comes only from the key list given with --keys or --keys-from (the accepted
base, never the change under test). The trust level of a signer is the part of its
principal before the first slash, and is never read from the record itself.
"""
import argparse
import concurrent.futures
import copy
import hashlib
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import tempfile
import threading
from datetime import datetime, timedelta, timezone

sys.dont_write_bytecode = True

OID = re.compile(r'^(?:[0-9a-f]{40}|[0-9a-f]{64})\Z')
SHA256 = re.compile(r'^[0-9a-f]{64}\Z')
NOTES = 'refs/notes/evidence/'
INPUT_NOTES = 'refs/notes/evidence-input/'
# The protected layout first, then the notes it replaces. A tree id is hex, so `input/` never collides with a tree's prefix.
TAGS = 'refs/tags/evidence/'
INPUT_TAGS = 'refs/tags/evidence/input/'
STATEMENT_TYPE = 'https://in-toto.io/Statement/v1'
PREDICATE_TYPE = 'https://compounding.tech/fractal/evidence/gate/v1'
# Permanent signed-history decoder exception: evidence predicate URI, #3032.
LEGACY_PREDICATE_TYPE = 'https://smalltalk.dev/evidence/gate/v1'
KEYS_PATH = '.st/evidence-keys'
LOG_KEY_PATH = '.st/evidence-log-key'
LOG_REF = 'refs/evidence-log/main'
LOG_MAX_AGE = 600  # five pulls of the log host; an older head is stale (docs/st3/gate-evidence.md, "The evidence log")
UNLOGGED_SHOWN = 5  # members an unlogged pass names on the decision line
POLICY_PATH = '.st/evidence-skip-policy.json'
LANES_PATH = '.st/required-lanes.json'
KINDS = ('nix', 'wrapper', 'sekrets', 'observed')
FUTURE_SKEW = timedelta(minutes=2)


class Failure(Exception):
    def __init__(self, reason, detail, **extra):
        super().__init__(detail)
        self.reason = reason
        self.detail = detail
        self.extra = extra


def git(repo, *args, stdin=None, config=(), env=None):
    command = ['git', '-C', repo, '-c', 'gpg.format=ssh', '-c', 'gpg.ssh.program=ssh-keygen',
               '-c', 'commit.gpgSign=false']
    for item in config:
        command += ['-c', item]
    command += list(args)
    environment = dict(os.environ, GIT_NO_REPLACE_OBJECTS='1', LC_ALL='C', **(env or {}))
    try:
        done = subprocess.run(command, input=stdin, capture_output=True, env=environment, timeout=60)
    except (OSError, subprocess.TimeoutExpired) as error:
        raise Failure('error', f'git {args[0]}: {error}')
    if done.returncode != 0:
        raise Failure('error', f'git {args[0]}: {done.stderr.decode(errors="replace").strip()}')
    return done.stdout


# arn:lmig:smalltalk:2026-10-27-dot-fractal-config — embedded for extracted base tools.
def config_path(repo, revision, legacy):
    preferred = legacy.replace('.st/', '.fractal/', 1)
    listing = git(repo, 'ls-tree', '-z', '--full-tree', revision, '--', preferred, legacy)
    names = {entry.partition(b'\t')[2].decode() for entry in listing.split(b'\0') if entry}
    return preferred if preferred in names else legacy if legacy in names else None


def config_blob(repo, revision, legacy):
    path = config_path(repo, revision, legacy)
    return git(repo, 'show', '--end-of-options', f'{revision}:{path or legacy}')


POLICY_KEYS = {'version', 'checks'}
CHECK_KEYS = {'kinds', 'trust_levels', 'max_age_s', 'enforce', 'inputs', 'sample_one_in', 'require', 'events'}
REQUIRE_MODES = ('off', 'shadow', 'reject')
CHECK_NAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9._-]{0,99}')
PATH_PART = re.compile(r'[A-Za-z0-9._@+=,~#-]+')
SELECTOR = re.compile(r'jobs\.[A-Za-z0-9_-]+|[A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+)*')
MAX_INPUTS = 300
KIND_KEYS = {'command', 'runner_prefix', 'required_inputs', 'bind_inputs', 'trust_levels', 'by_level', 'input_order', 'shard_inputs',
             'base_inputs'}
SHARD_KEYS = {'count', 'results', 'pull_request_count', 'index'}
LEVEL_KEYS = {'command', 'required_inputs', 'bind_inputs', 'events', 'lane'}
EVENTS = ('pull_request', 'merge_group')


def checked_command_inputs(rule, where):
    command = rule['command']
    if not (isinstance(command, list) and command and all(isinstance(v, str) and v for v in command)):
        raise Failure('error', f'skip policy for {where}: command must be a nonempty list of strings')
    required = rule.get('required_inputs', [])
    bind = rule.get('bind_inputs', {})
    if not (isinstance(required, list) and all(isinstance(v, str) and v for v in required)
            and isinstance(bind, dict) and all(isinstance(k, str) and k and isinstance(v, str) and v for k, v in bind.items())):
        raise Failure('error', f'skip policy for {where}: malformed required_inputs or bind_inputs')
    return command, required, bind


def checked_value_rules(rule, where):
    """A kind's checks on input VALUES, beyond presence: `input_order` and `shard_inputs`.

    `input_order` maps an input to its values from strongest to weakest: a note covers a run only when its value ranks at or above the
    run's own value (passed with --run-input KEY=VALUE). A run that did not say its value is never covered.
    `shard_inputs` names a sharded job's inputs: `count` (1 to 16) and `results` (`0=success,1=success,...`, every shard, all success);
    `pull_request_count`, when given, is the only count a note from a pull_request run may carry. `index`, when given, names the input
    that only one shard's own record carries: that record is a part of a run, not its verdict (shard_part)."""
    order = rule.get('input_order', {})
    if not (isinstance(order, dict) and all(isinstance(k, str) and k and isinstance(v, list) and len(v) >= 2 and len(set(v)) == len(v)
                                            and all(isinstance(x, str) and x for x in v) for k, v in order.items())):
        raise Failure('error', f'skip policy for {where}: input_order maps an input to two or more distinct values, strongest first')
    shards = rule.get('shard_inputs')
    if shards is not None:
        count = shards.get('pull_request_count') if isinstance(shards, dict) else None
        if not (isinstance(shards, dict) and set(shards) - SHARD_KEYS == set() and {'count', 'results'} <= set(shards)
                and all(isinstance(shards[k], str) and shards[k] for k in ('count', 'results') + (('index',) if 'index' in shards else ()))
                and (count is None or (not isinstance(count, bool) and isinstance(count, int) and 1 <= count <= 16))):
            raise Failure('error', f'skip policy for {where}: shard_inputs needs count and results input names, an optional '
                          'pull_request_count from 1 to 16 and an optional index input name')
    return {key: list(values) for key, values in order.items()}, (dict(shards) if shards is not None else None)


def checked_base_inputs(rule, where):
    """`base_inputs` maps an input name to a file whose content at the accepted base the verdict depends on, though it is not in the tree
    (linux-clippy's ratchet reads the base's .github/clippy-baseline.json). A note covers a run only when its value is the sha256 of that
    file at this run's base, or `absent` when the base has none; the verifier computes the run's value itself (base_input_values)."""
    base = rule.get('base_inputs', {})
    if not (isinstance(base, dict) and all(isinstance(k, str) and k and isinstance(v, str) and v for k, v in base.items())):
        raise Failure('error', f'skip policy for {where}: base_inputs maps an input name to a path')
    return {key: declared_paths([path], f'skip policy for {where}: base_inputs')[0] for key, path in base.items()}


def base_input_values(repo, base, rules):
    """{input: sha256 of its file at `base`, or 'absent'} for every base_inputs entry of the check's kinds."""
    values = {}
    for rule in (rules or {}).get('kinds', {}).values():
        for key, path in rule.get('base_inputs', {}).items():
            code, data = no_lazy(repo, 'show', '--end-of-options', f'{base}:{path}')
            values[key] = hashlib.sha256(data).hexdigest() if code == 0 else 'absent'
    return values


def policy_rules(text, check, repository):
    """The rules for one check from the repository's skip policy, strictly validated.

    Unknown keys are refused so a typo can never silently weaken a rule. Placeholders
    {repository} and {check} are filled in. Anything wrong is a refusal, not a pass."""
    try:
        doc = json.loads(text)
    except ValueError as error:
        raise Failure('error', f'skip policy is not valid JSON: {error}')
    if not isinstance(doc, dict) or set(doc) != POLICY_KEYS or doc['version'] != 1 or not isinstance(doc['checks'], dict):
        raise Failure('error', 'skip policy must be {"version": 1, "checks": {...}}')
    if check not in doc['checks']:
        raise Failure('no_policy', f'the skip policy has no entry for check {check}')
    entry = doc['checks'][check]
    if not isinstance(entry, dict) or set(entry) - CHECK_KEYS or not {'kinds', 'trust_levels'} <= set(entry):
        raise Failure('error', f'skip policy for {check} needs kinds and trust_levels, and nothing unknown')
    levels = entry['trust_levels']
    if not (isinstance(levels, list) and levels and all(isinstance(v, str) and v for v in levels)):
        raise Failure('error', f'skip policy for {check}: trust_levels must be a nonempty list of names')
    max_age = entry.get('max_age_s')
    if max_age is not None and (isinstance(max_age, bool) or not isinstance(max_age, int) or max_age <= 0):
        raise Failure('error', f'skip policy for {check}: max_age_s must be null or a positive integer')
    # Skipping is OFF unless a check says `"enforce": true`: without it the decision is only recorded.
    enforce = entry.get('enforce', False)
    if not isinstance(enforce, bool):
        raise Failure('error', f'skip policy for {check}: enforce must be true or false')
    # `require` is the separate switch for rejecting an unsigned change at queue entry: off (default) / shadow (report what would be
    # rejected, reject nothing) / reject. It never turns on skipping; `enforce` does that.
    require = entry.get('require', 'off')
    if not isinstance(require, str) or require not in REQUIRE_MODES:
        raise Failure('error', f'skip policy for {check}: require must be one of {", ".join(REQUIRE_MODES)}')
    inputs = entry.get('inputs')
    if inputs is not None:
        inputs = declared_paths(inputs, f'skip policy for {check}', selectors=True)
    sample = entry.get('sample_one_in', 1)
    if isinstance(sample, bool) or not isinstance(sample, int) or not 1 <= sample <= 1000:
        raise Failure('error', f'skip policy for {check}: sample_one_in must be an integer from 1 to 1000')
    if not (isinstance(entry['kinds'], dict) and entry['kinds']):
        raise Failure('error', f'skip policy for {check}: kinds must name at least one kind')
    # `events` (optional) limits the runs a note for this check may skip, whoever signed it: ["pull_request"] keeps the merge queue
    # testing the combined tree. Absent means every event the gate allows; a signer level's own `events` can only narrow it further.
    check_events = entry.get('events')
    if check_events is not None and not valid_events(check_events):
        raise Failure('error', f'skip policy for {check}: events must be a nonempty list of {", ".join(EVENTS)}')

    def fill(value):
        return value.replace('{repository}', repository).replace('{check}', check)

    kinds = {}
    for kind, rule in entry['kinds'].items():
        if kind not in KINDS or not isinstance(rule, dict) or set(rule) - KIND_KEYS or 'command' not in rule:
            raise Failure('error', f'skip policy for {check}: kind {kind!r} is not valid')
        command, required, bind = checked_command_inputs(rule, f'{check}/{kind}')
        order, shards = checked_value_rules(rule, f'{check}/{kind}')
        base_inputs = checked_base_inputs(rule, f'{check}/{kind}')
        prefix = rule.get('runner_prefix')
        kind_levels = rule.get('trust_levels')
        if kind_levels is not None and not (isinstance(kind_levels, list) and kind_levels
                                            and all(isinstance(v, str) and v for v in kind_levels)):
            raise Failure('error', f'skip policy for {check}/{kind}: trust_levels must be a nonempty list of names')
        if not (prefix is None or (isinstance(prefix, str) and prefix)):
            raise Failure('error', f'skip policy for {check}/{kind}: malformed runner_prefix')
        by_level = {}
        for level, override in (rule.get('by_level') or {}).items():
            # `events` is required: an override that left it out would cover every event, the merge queue included.
            if not isinstance(level, str) or not level or not isinstance(override, dict) or set(override) - LEVEL_KEYS \
                    or not {'command', 'events'} <= set(override):
                raise Failure('error', f'skip policy for {check}/{kind}: by_level {level!r} is not valid')
            if level not in (kind_levels or levels):
                raise Failure('error', f'skip policy for {check}/{kind}: by_level {level!r} is not among the trust levels this kind accepts')
            events = override['events']
            if not valid_events(events):
                raise Failure('error', f'skip policy for {check}/{kind}: events must be a nonempty list of {", ".join(EVENTS)}')
            lcommand, lrequired, lbind = checked_command_inputs(override, f'{check}/{kind}/{level}')
            # `lane: true` holds this level's notes to the lane definition at the accepted base (.st/required-lanes.json at the policy's
            # commit): the tree must not change the lane's definition paths and the note must carry its lane_definition_sha256.
            # `lane: "tree"` holds them to the lane as the SIGNED tree defines it: the base's argv and paths, the tree's bytes at those
            # paths. A tree that edits its lane is then covered by a note made with that edited definition, and by no other.
            if not (override.get('lane', False) in (True, False) and isinstance(override.get('lane', False), bool) or override.get('lane') == 'tree'):
                raise Failure('error', f'skip policy for {check}/{kind}: by_level {level!r} lane must be true, false or "tree"')
            by_level[level] = {'command': [fill(v) for v in lcommand], 'required_inputs': sorted(set(lrequired) | set(lbind)),
                               'bind_inputs': dict(lbind), 'events': list(events), 'lane': override.get('lane', False)}
        kinds[kind] = {'command': [fill(v) for v in command],
                       'runner_prefix': fill(prefix) if prefix else None,
                       # Binding an input also requires it, so the list can never be shorter than the binding.
                       'required_inputs': sorted(set(required) | set(bind)),
                       'bind_inputs': dict(bind),
                       # A kind may name its own signer levels; otherwise it uses the check's. Naming them
                       # per kind is what lets a weaker signer satisfy `wrapper` without ever satisfying `observed`.
                       'trust_levels': tuple(kind_levels) if kind_levels else None,
                       # A signer level may be held to its own command, inputs and events (a host key may sign a different command and
                       # may cover pull requests only), whatever the rest of the kind says.
                       'by_level': by_level,
                       # Values, not just presence: the note's value must cover the run's (input_order), and a sharded job's
                       # inputs must name every shard as a success (shard_inputs). Whatever the signer level.
                       'input_order': order, 'shard_inputs': shards, 'base_inputs': base_inputs}
    return {'kinds': kinds, 'trust_levels': tuple(levels), 'max_age_s': max_age, 'enforce': enforce,
            'inputs': inputs, 'sample_one_in': sample, 'require': require,
            'events': list(check_events) if check_events is not None else None}


def value_checks(rule, inputs, run_inputs, attempts):
    """The kind's value rules (checked_value_rules) on a record's inputs, against this run's own values where they apply."""
    for key, order in rule.get('input_order', {}).items():
        run_value, note_value = run_inputs.get(key), inputs.get(key)
        if run_value not in order:
            raise Failure('no_run_input', f'this run did not say its {key} (one of {", ".join(order)}), so no record can cover it',
                          attempts=attempts)
        if note_value not in order:
            raise Failure('wrong_input', f'record input {key} is {note_value!r}, not one of {", ".join(order)}', attempts=attempts)
        if order.index(note_value) > order.index(run_value):
            raise Failure('wrong_input', f'record input {key}={note_value} does not cover this run\'s {key}={run_value}',
                          attempts=attempts)
    for key in rule.get('base_inputs', {}):
        run_value, note_value = run_inputs.get(key), inputs.get(key)
        if not run_value:
            raise Failure('no_run_input', f'the accepted base\'s {key} is not known, so no record can cover it', attempts=attempts)
        if note_value != run_value:
            raise Failure('wrong_input', f'record input {key}={note_value} is not the accepted base\'s {key}={run_value}',
                          attempts=attempts)
    shards = rule.get('shard_inputs')
    if shards:
        count = inputs.get(shards['count'])
        if not (isinstance(count, str) and count.isdigit() and 1 <= int(count) <= 16):
            raise Failure('wrong_input', f'record input {shards["count"]} is {count!r}, not a shard count from 1 to 16', attempts=attempts)
        expected = ','.join(f'{index}=success' for index in range(int(count)))
        if inputs.get(shards['results']) != expected:
            raise Failure('wrong_input', f'record input {shards["results"]} must name every one of its {count} shards as a success '
                          f'({expected})', attempts=attempts)
        if shards.get('pull_request_count') is not None and inputs.get('event_name') == 'pull_request' \
                and int(count) != shards['pull_request_count']:
            raise Failure('wrong_input', f'a pull_request record must have {shards["pull_request_count"]} shard(s), not {count}',
                          attempts=attempts)


def valid_events(events):
    return isinstance(events, list) and events and len(set(events)) == len(events) and all(e in EVENTS for e in events)


def narrowed_events(check_events, level_events):
    """The events a satisfied note may skip: the check's list, narrowed by the signer level's; None (any) only when neither limits it."""
    if check_events is None:
        return level_events
    if level_events is None:
        return list(check_events)
    return [event for event in level_events if event in check_events]


LANES_KEYS = {'version', 'lanes'}
LANE_KEYS = {'argv', 'definition_paths', 'tree_inputs', 'absent_paths', 'ci_inputs'}


def lane_rules(text, lane):
    """One lane from `.st/required-lanes.json` (read from the accepted base), strictly validated.

    `argv` is what a producer runs, `definition_paths` the files whose bytes define what that argv does (a directory means
    everything below it), `tree_inputs` the sources the lane is meant to test (informational: they may differ between the
    signed tree and the base), and `absent_paths` the paths the lane LOOKS FOR and does not find (a `.pnpmfile.cjs`, a
    `package.yaml`): a tracked file appearing there changes what the lane does, so none may exist in the signed tree.
    `ci_inputs` (optional) are the protected CI files the check uses (docs/st3/gate-evidence.md, "A check's CI inputs"): with them, main
    moving a protected file the check does not use keeps the pull request's own tree for this check; without them, any does not.
    Unknown keys are refused, like the skip policy."""
    try:
        doc = json.loads(text)
    except ValueError as error:
        raise Failure('error', f'lane file is not valid JSON: {error}')
    if not isinstance(doc, dict) or set(doc) != LANES_KEYS or doc['version'] != 1 or not isinstance(doc['lanes'], dict):
        raise Failure('error', 'lane file must be {"version": 1, "lanes": {...}}')
    if lane not in doc['lanes']:
        raise Failure('no_lane', f'the lane file has no entry for {lane}')
    entry = doc['lanes'][lane]
    if not isinstance(entry, dict) or set(entry) - LANE_KEYS or not {'argv', 'definition_paths'} <= set(entry):
        raise Failure('error', f'lane {lane} needs argv and definition_paths, and nothing unknown')
    argv = entry['argv']
    if not (isinstance(argv, list) and argv and all(isinstance(v, str) and v for v in argv)):
        raise Failure('error', f'lane {lane}: argv must be a nonempty list of strings')
    paths = declared_paths(entry['definition_paths'], f'lane {lane} definition_paths')
    if '.' in paths:
        raise Failure('error', f'lane {lane}: definition_paths must name files or directories, not the whole tree')
    inputs = entry.get('tree_inputs', [])
    if inputs:
        inputs = declared_paths(inputs, f'lane {lane} tree_inputs')
    absent = entry.get('absent_paths', [])
    if absent:
        absent = declared_paths(absent, f'lane {lane} absent_paths')
        if '.' in absent:
            raise Failure('error', f'lane {lane}: absent_paths must name files or directories, not the whole tree')
    ci = entry.get('ci_inputs')
    if ci is not None:
        ci = declared_paths(ci, f'lane {lane} ci_inputs', selectors=True)
    return {'argv': argv, 'definition_paths': paths, 'tree_inputs': tuple(inputs), 'absent_paths': tuple(absent), 'ci_inputs': ci}


def lane_entry(text, lane):
    """The canonical bytes of one lane's entry in a lane file's text, or None when the text or the entry is not there."""
    try:
        entry = json.loads(text)['lanes'][lane]
    except (ValueError, KeyError, TypeError):
        return None
    return json.dumps(entry, sort_keys=True, separators=(',', ':'))


def ci_inputs_unchanged(repo, ci, revisions):
    """True when the CI inputs `ci` (a lane's declared ci_inputs) name something at every one of `revisions` and project to the same key
    at each. An entry that names nothing (a job main renamed, a typo) would project to nothing at every revision and so look unchanged
    while the job it meant changes: it is not unchanged, and the check falls back to the merge tree."""
    trees = [git(repo, 'rev-parse', '--verify', '--end-of-options', f'{rev}^{{tree}}').decode().strip() for rev in revisions]
    if any(unresolved_ci_inputs(repo, tree, ci) for tree in trees):
        return False
    return len({project(repo, tree, ci) for tree in trees}) == 1


def unresolved_ci_inputs(repo, tree, ci):
    """The declared CI inputs that name nothing in `tree`: a path it lacks, or a job or JSON entry its file does not have. An excluded
    path (!PATH) may name nothing."""
    return [item for item in ci if not item.startswith('!') and item != '.'
            and not (selected(repo, tree, item) if '::' in item else git(repo, 'ls-tree', '--full-tree', tree, '--', item).strip())]


def definition_entries(repo, tree, paths):
    """(mode, blob, path) of every file at or below the paths in `tree`."""
    found = set()
    for path in paths:
        out = git(repo, 'ls-tree', '-r', '-z', '--full-tree', '--end-of-options', tree, '--', path)
        for record in out.split(b'\0'):
            if record:
                meta, _, name = record.partition(b'\t')
                mode, _, oid = meta.decode().split(' ')
                found.add((mode, oid, name.decode('utf-8', 'surrogateescape')))
    return found


def lane_definition(repo, base_tree, tree, rules):
    """The digest of a lane's definition at the accepted base and the paths whose bytes differ between the base and `tree`."""
    base = definition_entries(repo, base_tree, rules['definition_paths'])
    for path in rules['definition_paths']:
        if not any(name == path or name.startswith(path + '/') for _, _, name in base):
            raise Failure('error', f'lane definition path {path} does not exist at the accepted base')
    absent = tuple(rules.get('absent_paths', ()))
    if absent:
        there = definition_entries(repo, base_tree, absent)
        if there:
            raise Failure('error', f'lane absent path {sorted(there, key=lambda e: e[2])[0][2]} exists at the accepted base')
    other = definition_entries(repo, tree, rules['definition_paths'])
    present = definition_entries(repo, tree, absent) if absent else set()
    changed = sorted({name for _, _, name in base ^ other} | {name for _, _, name in present})
    # `tree_sha256` is the same digest over the tree's own bytes (and any file it has at an absent path): equal to `sha256` exactly when
    # nothing changed. It is what a note made on a tree that edits its lane records (by_level lane "tree").
    return {'sha256': definition_digest(base, rules['argv'], absent), 'changed': changed,
            'tree_sha256': definition_digest(other | present, rules['argv'], absent)}


def definition_digest(entries, argv, absent):
    lines = ''.join(f'{mode} {oid} {name}\n' for mode, oid, name in sorted(entries, key=lambda e: e[2]))
    text = lines + 'argv:' + json.dumps(argv) + ('\nabsent:' + json.dumps(sorted(absent)) if absent else '')
    return hashlib.sha256(text.encode('utf-8', 'surrogateescape')).hexdigest()


def literal_path(item):
    parts = item.split('/')
    return all(PATH_PART.fullmatch(part) and part not in ('.', '..') for part in parts)


def declared_paths(value, where, selectors=False):
    """The declared input paths of a check: relative, literal, no `..`, at most MAX_INPUTS. `.` means everything.

    With `selectors` (a skip policy's inputs, which make a check's key) two more forms are allowed, so a check's key can hold the part of
    a shared CI file it uses and not the rest of it (docs/st3/gate-evidence.md, "A check's CI inputs"):
      PATH::jobs.ID    one job of a workflow (.yml): its block, every job it needs, transitively, and the workflow's top-level blocks
      PATH::KEY.KEY    one entry of a JSON file
      !PATH            PATH (a file or directory under a declared path) left out of it
    """
    if not (isinstance(value, list) and value and len(value) <= MAX_INPUTS):
        raise Failure('error', f'{where}: inputs must be a nonempty list of at most {MAX_INPUTS} paths')
    paths = set()
    for item in value:
        if not isinstance(item, str) or len(item) > 300:
            raise Failure('error', f'{where}: an input path is not a short string')
        if selectors and item.startswith('!'):
            if not literal_path(item[1:]):
                raise Failure('error', f'{where}: excluded path {item!r} must be relative, literal and without . or .. parts')
        elif selectors and '::' in item:
            path, _, selector = item.partition('::')
            if not literal_path(path) or not SELECTOR.fullmatch(selector):
                raise Failure('error', f'{where}: input {item!r} must be PATH::jobs.ID (a workflow) or PATH::KEY.KEY (a JSON file)')
            if path.endswith(('.yml', '.yaml')) != selector.startswith('jobs.') or not path.endswith(('.yml', '.yaml', '.json')):
                raise Failure('error', f'{where}: input {item!r}: a .yml selects jobs.ID, a .json selects KEY.KEY')
        elif item != '.' and not literal_path(item):
            raise Failure('error', f'{where}: input path {item!r} must be relative, literal and without . or .. parts')
        paths.add(item)
    plain = [p for p in paths if not p.startswith('!') and '::' not in p]
    for item in paths:
        if item.startswith('!') and not any(d == '.' or item[1:].startswith(d.rstrip('/') + '/') for d in plain):
            raise Failure('error', f'{where}: excluded path {item!r} is not under a declared path, so it leaves nothing out')
    return tuple(sorted(paths))


def workflow_job(text, job):
    """The bytes of a generated workflow that job `job` depends on: the top-level blocks other than `jobs:` (on, env, defaults,
    permissions, concurrency, as written), then the block of the job and of every job it needs, transitively, in name order. None
    when the workflow has no such job. It reads the layout the generator writes (top-level keys at column 0, jobs at two spaces) and
    refuses anything else rather than guess."""
    top, jobs, current, in_jobs = [], {}, None, False
    for line in text.splitlines(keepends=True):
        if line.strip() == '' or line.startswith('#'):
            (jobs[current] if in_jobs and current else top).append(line)
            continue
        if not line.startswith(' '):
            in_jobs, current = line.rstrip() == 'jobs:', None
            if not in_jobs:
                top.append(line)
            continue
        if in_jobs:
            match = re.fullmatch(r'  ([A-Za-z0-9_-]+):\s*', line.rstrip('\n'))
            if match:
                current = match.group(1)
                jobs[current] = [line]
            elif current is None or not line.startswith('    '):
                raise Failure('error', f'workflow layout not understood at {line.strip()[:60]!r}')
            else:
                jobs[current].append(line)
        else:
            top.append(line)
    if job not in jobs:
        return None
    wanted, queue = set(), [job]
    while queue:
        name = queue.pop()
        if name in wanted:
            continue
        if name not in jobs:
            raise Failure('error', f'workflow job {job} needs {name}, which the workflow does not have')
        wanted.add(name)
        queue += job_needs(jobs[name])
    return (''.join(top) + ''.join(f'\0job {name}\n' + ''.join(jobs[name]) for name in sorted(wanted))).encode()


def job_needs(lines):
    """The job names a job block's `needs:` lists (inline `[a, b]`, a single name, or `- a` lines)."""
    for index, line in enumerate(lines):
        match = re.fullmatch(r'    needs:\s*(.*?)\s*', line.rstrip('\n'))
        if not match:
            continue
        value = match.group(1)
        if value.startswith('['):
            return [name.strip().strip('"\'') for name in value.strip('[]').split(',') if name.strip()]
        if value:
            return [value.strip('"\'')]
        names = []
        for item in lines[index + 1:]:
            listed = re.fullmatch(r'      - ([A-Za-z0-9_"\'-]+)\s*', item.rstrip('\n'))
            if not listed:
                break
            names.append(listed.group(1).strip('"\''))
        return names
    return []


# arn:lmig:smalltalk:2026-10-27-dot-fractal-config — selectors read the selected layout at this exact tree.
def selector_item(repo, tree, item):
    path, separator, selector = item.partition('::')
    if separator and path.startswith(('.st/', '.fractal/')):
        legacy = path.replace('.fractal/', '.st/', 1)
        path = config_path(repo, tree, legacy)
        return f'{path}::{selector}' if path is not None else None
    return item


def selected(repo, tree, item):
    """Canonical selected bytes, using the same tree's configuration layout; None for an absent file or entry."""
    resolved = selector_item(repo, tree, item)
    return selected_content(repo, tree, resolved) if resolved is not None else None


def selected_content(repo, tree, item):
    """Read an already resolved PATH::SELECTOR without changing its identity."""
    path, _, selector = item.partition('::')
    if not git(repo, 'ls-tree', '--full-tree', tree, '--', path).strip():
        return None
    try:
        text = git(repo, 'show', '--end-of-options', f'{tree}:{path}').decode()
    except UnicodeDecodeError:
        raise Failure('error', f'{path} is not text')
    return select_part(text, path, selector)


def select_part(text, path, selector):
    """The canonical bytes SELECTOR selects in the text of the file at `path`, or None when the job or the entry is not there."""
    if selector.startswith('jobs.'):
        return workflow_job(text, selector[len('jobs.'):])
    try:
        value = json.loads(text)
    except ValueError:
        raise Failure('error', f'{path} is not JSON')
    for key in selector.split('.'):
        if not isinstance(value, dict) or key not in value:
            return None
        value = value[key]
    return json.dumps(value, sort_keys=True, separators=(',', ':')).encode()


def project(repo, tree, paths):
    """The git tree id of `tree` reduced to the declared paths: only those files (mode, blob id, name) remain.

    It needs only git, so a producer, the observer and a verifier compute the same key from the same paths.
    A declared path the tree lacks simply contributes nothing. `.` declares the whole tree, whose key is the tree.
    When none of the declared paths exists the projection is the empty tree, which every such tree shares, so
    there is no key (None) and nothing can match by it. Names travel as bytes and NUL-terminated both ways, so a
    newline or any other byte in a name cannot turn one entry into two; symlinks and gitlinks keep their mode."""
    plain = [p for p in paths if not p.startswith('!') and '::' not in p]
    excluded = [p[1:].encode() for p in paths if p.startswith('!')]
    chosen = sorted({resolved for p in paths if '::' in p
                     for resolved in [selector_item(repo, tree, p)] if resolved is not None})
    if '.' in plain and not excluded and not chosen:
        return tree
    listing = git(repo, 'ls-tree', '-r', '-z', '--full-tree', tree, *(['--', *plain] if '.' not in plain else [])) if plain else b''
    entries = []
    for entry in listing.split(b'\0'):
        if not entry:
            continue
        meta, tab, name = entry.partition(b'\t')
        parts = meta.decode().split()
        if not tab or len(parts) != 3 or not OID.match(parts[2]):
            raise Failure('error', 'unexpected git ls-tree output')
        if any(name == out or name.startswith(out.rstrip(b'/') + b'/') for out in excluded):
            continue
        entries.append(f'{parts[0]} {parts[2]} 0\t'.encode() + name + b'\0')
    for item in chosen:
        # One selected part of a shared CI file is an entry of its own, named PATH::SELECTOR, whose blob is the canonical bytes of that
        # part: the key stays a git tree id, and a change elsewhere in the file leaves it alone.
        content = selected_content(repo, tree, item)
        if content is not None:
            blob = git(repo, 'hash-object', '--stdin', stdin=content).decode().strip()
            entries.append(f'100644 {blob} 0\t'.encode() + item.encode() + b'\0')
    if not entries:
        return None
    with tempfile.TemporaryDirectory() as scratch:
        env = {'GIT_INDEX_FILE': os.path.join(scratch, 'index')}
        git(repo, 'update-index', '-z', '--index-info', stdin=b''.join(entries), env=env)
        # --missing-ok: a tree id does not depend on its blobs being here, and in a partial clone checking them fetches them.
        return git(repo, 'write-tree', '--missing-ok', env=env).decode().strip()


def shard_part(rules, statement):
    """Whether a record is one shard's own (its kind's shard_inputs.index input is set): a part of a run, never the record that judges
    the whole run."""
    if rules is None:
        return False
    observed = statement['predicate']['observed']
    kind = kind_of(observed.get('runner', ''))
    shards = (rules['kinds'].get(kind) or {}).get('shard_inputs') if kind else None
    return bool(shards and shards.get('index')) and bool(observed.get('inputs', {}).get(shards['index']))


def kind_of(runner):
    """The record kind a runner string names, or None. `github:` is the central observer's
    record of a finished GitHub job (`st evidence observe-ci`); the others are producers."""
    if runner in ('nix', 'wrapper', 'sekrets'):
        return runner
    if runner.startswith('github:'):
        return 'observed'
    return None


def parse_time(value):
    return datetime.fromisoformat(value.replace('Z', '+00:00'))


def statement_of(blob, tree):
    """The statement if it is a well-formed tests record keyed to this tree, else None."""
    try:
        value = json.loads(blob)
        predicate = value['predicate']
        subject = value['subject']
        observed = predicate['observed']
        if (value['_type'] != STATEMENT_TYPE or value['predicateType'] not in (PREDICATE_TYPE, LEGACY_PREDICATE_TYPE)
                or len(subject) != 1 or not OID.match(subject[0]['name'])
                or subject[0]['digest'] != {'gitTree': tree}
                or predicate['schema_version'] != 1
                or not isinstance(predicate['change_id'], str) or not predicate['change_id'].strip()
                or predicate['tier'] not in ('full', 'degraded', 'test')
                or not (predicate['signer'] is None or isinstance(predicate['signer'], str))
                or observed.get('kind') != 'tests'
                or not isinstance(observed.get('runner'), str)
                or not isinstance(observed.get('checks'), dict)):
            return None
        inputs = observed.get('inputs', {})
        if not isinstance(inputs, dict) or not all(
                isinstance(k, str) and isinstance(v, str) and k.strip() and v.strip() for k, v in inputs.items()):
            return None
        # A zone is required: naive and aware times cannot be ordered against each other.
        if parse_time(predicate['observed_at']).tzinfo is None:
            return None
        for name, check in observed['checks'].items():
            if (not isinstance(name, str) or not name.strip()
                    or not isinstance(check['command'], list) or not check['command']
                    or not all(isinstance(part, str) for part in check['command'])
                    or isinstance(check['exit_code'], bool) or not isinstance(check['exit_code'], int)
                    or not SHA256.match(check['output_sha256'])):
                return None
        return value
    except (ValueError, KeyError, TypeError, AttributeError):
        return None


def legacy_refs(repo, width):
    """Records of the FIRST layout, refs/notes/evidence/<record-id> (the ref name is exactly one object id long, so this pattern never
    lists a tree-prefixed ref). Only refs of that layout that still exist are listed, and `scripts/evidence-gc` removes them: when
    none are left this is an empty listing."""
    out = git(repo, 'for-each-ref', '--format=%(objectname) %(refname)', NOTES + '?' * width).decode()
    found = []
    for line in out.splitlines():
        oid, _, name = line.partition(' ')
        if OID.match(oid) and name == NOTES + oid:
            found.append(oid)
    return found


def records_under(repo, prefixes):
    """The records named <prefix><record-id> under each prefix, in that order, each once: one listing per prefix. A ref that names another
    object than its suffix finds nothing."""
    found = []
    for prefix in prefixes:
        out = git(repo, 'for-each-ref', '--format=%(objectname) %(refname)', prefix.rstrip('/')).decode()
        for line in out.splitlines():
            oid, _, name = line.partition(' ')
            if OID.match(oid) and name == prefix + oid and oid not in found:
                found.append(oid)
    return found


def tree_refs(repo, tree):
    """Records of ONE tree, refs/tags/evidence/<tree>/<record-id> and refs/notes/evidence/<tree>/<record-id>: one prefix listing in each,
    bounded by that tree's own records, however many trees have records. load() requires the note to be about this tree."""
    return records_under(repo, (f'{TAGS}{tree}/', f'{NOTES}{tree}/'))


def input_refs(repo, check, key):
    """Records indexed under this check and input key: refs/tags/evidence/input/<check>/<key>/<record id> and
    refs/notes/evidence-input/<check>/<key>/<record id>. The ref is only an index. A ref that names another object than its
    suffix, or a malformed name, finds nothing, and whatever it finds must still carry this key in its signed statement."""
    if not CHECK_NAME.fullmatch(check) or not OID.fullmatch(key):
        return []
    return records_under(repo, (f'{INPUT_TAGS}{check}/{key}/', f'{INPUT_NOTES}{check}/{key}/'))


def with_note_for(repo, commits, tree):
    """One git process: which of these commits carry a note named by the tree."""
    if not commits:
        return []
    asked = ''.join(f'{commit}:{tree}\n' for commit in commits).encode()
    answers = git(repo, 'cat-file', '--batch-check', stdin=asked).decode().splitlines()
    return [commit for commit, answer in zip(commits, answers) if not answer.endswith(' missing')]


_LOADED = {}


def load(repo, commit, tree=None):
    """The record's statement (a copy), read once per process: a record is content-addressed, so what it says does not change, and a
    per-crate check (`--members`) looks at every record of the tree once for each of its crates, 52 times each, which was most of its time."""
    key = (repo, commit, tree)
    if key not in _LOADED:
        _LOADED[key] = read_statement(repo, commit, tree)
    return copy.deepcopy(_LOADED[key])


def read_statement(repo, commit, tree=None):
    """The record's statement. With `tree` the record must be for that tree; without it, the tree is the one
    the record names (used when a record is found by its input key, not by the tree)."""
    entries = [e for e in git(repo, 'ls-tree', '-r', '-z', commit).split(b'\0') if e]
    if len(entries) != 1:
        return None
    meta, _, path = entries[0].decode().partition('\t')
    parts = meta.split()
    if len(parts) != 3 or parts[0] != '100644' or parts[1] != 'blob' or not OID.match(path) or (tree is not None and path != tree):
        return None
    tree = path
    statement = statement_of(git(repo, 'cat-file', 'blob', parts[2]), tree)
    if statement is None:
        return None
    subject = statement['subject'][0]['name']
    # Read the parent from the raw commit: `git show` hides it in a shallow fetch, which is
    # how a CI checkout gets the notes.
    header = git(repo, 'cat-file', 'commit', commit).split(b'\n\n', 1)[0].decode(errors='replace')
    parents = [line.split(' ', 1)[1] for line in header.splitlines() if line.startswith('parent ')]
    if parents != [subject]:
        return None
    # The signed statement already names the tree. When the subject commit is present it must
    # agree; when it is not (shallow fetch), the signer's claim stands. Never fetched to find out: in a partial
    # clone (the gate's checkout after it deepens with blob:none) a missing commit is fetched lazily with no
    # negotiation, that is with its whole history, about 3.4 s each; a record found by input key names another
    # tree's commit, so 34 of them took a verify to 55 s and past the gate's 30 s.
    try:
        present = git(repo, 'rev-parse', '--verify', '--quiet', '--end-of-options', subject + '^{tree}',
                      env={'GIT_NO_LAZY_FETCH': '1'}).decode().strip()
    except Failure:
        present = None
    if present is not None and present != tree:
        return None
    return statement


def signature(repo, commit, keys, revocations):
    """(status, principal) from git's own SSH verification against the key list."""
    config = [f'gpg.ssh.allowedSignersFile={keys}', f'gpg.ssh.revocationFile={revocations}']
    shown = git(repo, 'show', '-s', '--format=%G?%x00%GS', commit, config=config).decode().strip('\n')
    status, _, principal = shown.partition('\0')
    return status, principal


def no_lazy(repo, *args):
    """A git read that never fetches: (exit status, stdout)."""
    done = subprocess.run(['git', '-C', repo, '-c', 'gpg.format=ssh', '-c', 'gpg.ssh.program=ssh-keygen', *args], capture_output=True,
                          env=dict(os.environ, GIT_NO_LAZY_FETCH='1', GIT_NO_REPLACE_OBJECTS='1', LC_ALL='C'), timeout=60)
    return done.returncode, done.stdout


def log_lines(repo, head, path, check):
    """The record ids the log lists for `check` in one file, counting only what came after its last GC line."""
    code, out = no_lazy(repo, 'cat-file', 'blob', f'{head}:{path}')
    if code != 0:
        return set()
    lines = out.decode(errors='replace').splitlines()
    for index in range(len(lines) - 1, -1, -1):
        if lines[index].startswith('gc '):
            lines = lines[index + 1:]
            break
    found = set()
    for line in lines:
        parts = line.split()
        if len(parts) == 6 and parts[0] == 'record' and OID.match(parts[1]) and parts[2] == check:
            found.add(parts[1])
    return found


def log_view(repo, log_keys, tree, check, input_key, chosen, now=None, max_age=LOG_MAX_AGE):
    """SHADOW: what the evidence log says about this decision; it never changes one. `log` is
      absent        no log head here           unsigned  the head is not signed by a key in log_keys (principal log/...)
      stale         the head is older than max_age, or names no time
      missing       a record the log lists for this tree (or input key) and check is not here: deleted, or not fetched
      unlogged_pass the chosen record is a pass the log does not list (a pass counts only once the log has it)
      ok            none of these
    A failure counts whether it is logged or not, which the verdict already does: it reads every record that is here."""
    view = {'log': None, 'log_head': None, 'log_age_s': None, 'log_missing': None}
    code, out = no_lazy(repo, 'rev-parse', '--verify', '--quiet', '--end-of-options', f'{LOG_REF}^{{commit}}')
    head = out.decode().strip()
    if code != 0 or not OID.match(head):
        view['log'] = 'absent'
        return view
    view['log_head'] = head
    with tempfile.NamedTemporaryFile() as revocations:
        code, out = no_lazy(repo, '-c', f'gpg.ssh.allowedSignersFile={log_keys}', '-c', f'gpg.ssh.revocationFile={revocations.name}',
                            'show', '-s', '--format=%G?%x00%GS%x00%s', head)
    status, _, rest = out.decode(errors='replace').strip('\n').partition('\0')
    principal, _, subject = rest.partition('\0')
    if code != 0 or status != 'G' or not principal.startswith('log/'):
        view['log'] = 'unsigned'
        return view
    stamp = re.search(r'(?:^| )as_of=(\S+)', subject)
    try:
        as_of = parse_time(stamp.group(1)) if stamp else None
    except ValueError:
        as_of = None
    current = now or datetime.now(timezone.utc)
    if as_of is None or as_of.tzinfo is None:
        view['log'] = 'stale'
        return view
    view['log_age_s'] = int((current - as_of).total_seconds())
    if view['log_age_s'] > max_age or view['log_age_s'] < -FUTURE_SKEW.total_seconds():
        view['log'] = 'stale'
        return view
    logged = log_lines(repo, head, f'trees/{tree[:2]}/{tree}', check)
    here = set(tree_refs(repo, tree))
    if input_key:
        logged |= log_lines(repo, head, f'keys/{check}/{input_key[:2]}/{input_key}', check)
        here |= set(input_refs(repo, check, input_key))
    here = {name.rsplit('/', 1)[-1] for name in here}
    missing = sorted(logged - here)
    view['log_missing'] = len(missing)
    if missing:
        view['log'] = 'missing'
    elif chosen and chosen not in logged:
        view['log'] = 'unlogged_pass'
    else:
        view['log'] = 'ok'
    return view


def members_log_view(repo, log_keys, tree, check, member_records, now=None, max_age=LOG_MAX_AGE):
    """SHADOW: log_view for a per-crate check, over every member at once. The log head is judged once (absent, unsigned, stale as for one
    record); then each member's own key is read: `missing` when the log lists a record of that key (or of the tree) that is not here,
    else `unlogged_pass` when a member's chosen record is not listed, else `ok`. `member_records` maps crate to (key, chosen record or
    None, and optionally that record's observed_at); a check that did not hold passes None for every member, so only `missing` can follow,
    as log_view does without a choice. An unlogged pass names its members: `log_unlogged_crates`, the first UNLOGGED_SHOWN as
    crate=record (12 hex), and `log_unlogged_observed_at`, the oldest observed_at among them (the one log lag would have to explain)."""
    view = log_view(repo, log_keys, tree, check, None, None, now, max_age)
    if view['log'] not in ('ok', 'missing'):
        return view  # absent, unsigned or stale: the head itself says it
    head = view['log_head']
    logged_tree = log_lines(repo, head, f'trees/{tree[:2]}/{tree}', check)
    missing, unlogged = set(logged_tree - {name.rsplit('/', 1)[-1] for name in tree_refs(repo, tree)}), []
    for crate, (key, chosen, *observed) in sorted(member_records.items()):
        if not OID.fullmatch(key or ''):
            continue
        logged = log_lines(repo, head, f'keys/{check}/{key[:2]}/{key}', check)
        here = {name.rsplit('/', 1)[-1] for name in input_refs(repo, check, key)}
        missing |= logged - here
        if chosen and chosen not in logged and chosen not in logged_tree:
            unlogged.append((crate, chosen, observed[0] if observed else None))
    view['log_missing'] = len(missing)
    view['log_unlogged'] = len(unlogged)
    if unlogged:
        view['log_unlogged_crates'] = '+'.join(f'{crate}={chosen[:12]}' for crate, chosen, _ in unlogged[:UNLOGGED_SHOWN]) + (
            f'+{len(unlogged) - UNLOGGED_SHOWN}_more' if len(unlogged) > UNLOGGED_SHOWN else '')
        times = []
        for _, _, observed in unlogged:
            try:
                times.append((parse_time(observed), observed))
            except (AttributeError, TypeError, ValueError):
                times = None  # one member without a readable time: no time explains them all
                break
        view['log_unlogged_observed_at'] = min(times)[1] if times else None
    view['log'] = 'missing' if missing else ('unlogged_pass' if unlogged else 'ok')
    return view


def verify(repo, tree, check, keys, command, kinds=KINDS, bind=(), max_age=None, runner_prefix=None,
           trust_levels=None, now=None, rules=None, lane=None, level_lane=None, log_keys=None, run_inputs=None, crate_key=None,
           prefer_levels=None):
    """verified(...) and, with log_keys, the evidence log's shadow view of the same decision (docs/st3/gate-evidence.md)."""
    if not log_keys:
        return verified(repo, tree, check, keys, command, kinds, bind, max_age, runner_prefix, trust_levels, now, rules, lane, level_lane,
                        run_inputs, crate_key, prefer_levels)
    input_key = crate_key[1] if crate_key else None
    if crate_key is None and rules is not None and rules.get('inputs') is not None:
        try:
            input_key = project(repo, tree, rules['inputs'])
        except Failure:
            input_key = None
    try:
        result = verified(repo, tree, check, keys, command, kinds, bind, max_age, runner_prefix, trust_levels, now, rules, lane, level_lane,
                        run_inputs, crate_key, prefer_levels)
    except Failure as failure:
        failure.extra.update(log_view(repo, log_keys, tree, check, input_key, None, now))
        raise
    result.update(log_view(repo, log_keys, tree, check, input_key, result.get('record'), now))
    return result


def signed_for_crate(statement, crate, key, needs_tests=False):
    """Whether the record signed this crate and this key. `needs_tests` (the accepted base judges the check, and the crate is not listed
    under `no_tests` in its .st/rust-test-inputs.json) also requires a run that ran at least one test: a run whose selection matched
    nothing (nextest exit 4, a filter that no longer names the crate) signs tests_run=0 and passes, and that must not stand for the crate."""
    inputs = statement['predicate']['observed'].get('inputs', {})
    if inputs.get('crate') != crate or inputs.get('source_inputs') != key:
        return False
    if needs_tests:
        ran = str(inputs.get('tests_run', ''))
        return ran.isdigit() and int(ran) > 0
    return True


def zero_test_crates(repo, policy_base):
    """The crates the accepted base lists under `no_tests` (reviewed: they have no test to run). Empty when the base has no such list;
    a list that is not an array of crate names is a verifier error, never an empty allowance by accident."""
    path = config_path(repo, policy_base, '.st/rust-test-inputs.json')
    if path is None:
        return set()
    data = git(repo, 'show', '--end-of-options', f'{policy_base}:{path}')
    try:
        listed = json.loads(data.decode()).get('no_tests', [])
    except (ValueError, AttributeError, UnicodeDecodeError):
        raise Failure('error', '.st/rust-test-inputs.json at the accepted base is not readable')
    if not isinstance(listed, list) or not all(isinstance(name, str) for name in listed):
        raise Failure('error', '.st/rust-test-inputs.json: no_tests must be an array of crate names')
    return set(listed)


def verified(repo, tree, check, keys, command, kinds=KINDS, bind=(), max_age=None, runner_prefix=None,
             trust_levels=None, now=None, rules=None, lane=None, level_lane=None, run_inputs=None, crate_key=None, prefer_levels=None):
    """`level_lane`, when given, is a callable returning the lane check at the policy's base; it is used only for a signer level
    whose by_level rule says `lane: true`, so the cost and any lane-file error fall on those records alone.

    `crate_key` is (crate, key[, needs_tests]) for a per-crate check (docs/per-crate-test-signing.md): the key is the crate's own input key rather than a
    projection of the policy's declared paths, and a record counts only if it signed that crate AND that key, whichever tree it is for
    (the several records of one tree, one per crate, are told apart by the signed `crate`).

    `prefer_levels`, when given, names signer levels whose newest passing record decides instead of a newer pass from another level, as
    long as no failing record is dated after it (within FUTURE_SKEW): a newer failure still decides, and every other rule applies to the
    record chosen. The gate asks for it when only those levels can cover the run (our pull request editing a protected file), so a pass
    that CI signed later for the same inputs does not hide the host's own note."""
    with tempfile.NamedTemporaryFile() as revocations:
        everything = legacy_refs(repo, len(tree))  # the first layout, until the GC has removed it
        hits = with_note_for(repo, list(dict.fromkeys(tree_refs(repo, tree) + everything)), tree)  # commits that carry a note named by the tree
        mine = []
        for commit in hits:
            statement = load(repo, commit, tree)
            if statement is not None:
                mine.append((commit, statement))
        # A check that declares inputs also accepts a record of ANOTHER tree whose signed key equals this tree's
        # projection onto the declared paths. Every other rule applies to it exactly as to a record of this tree.
        input_key = None
        if crate_key is not None:
            input_key = crate_key[1]
            mine = [(commit, statement) for commit, statement in mine if signed_for_crate(statement, *crate_key)]
        elif rules is not None and rules.get('inputs') is not None:
            input_key = project(repo, tree, rules['inputs'])
        if input_key is not None:
            have = {commit for commit, _ in mine}
            for commit in input_refs(repo, check, input_key):
                if commit in have:
                    continue
                statement = load(repo, commit)
                if statement is not None and statement['predicate']['observed'].get('inputs', {}).get('source_inputs') == input_key \
                        and (crate_key is None or signed_for_crate(statement, *crate_key)):
                    mine.append((commit, statement))
        trusted, untrusted, degraded = [], [], []
        for commit, statement in mine:
            predicate = statement['predicate']
            if predicate['tier'] == 'degraded':
                # Unsigned by design (the signer was unreachable): never evidence, never a signature fault.
                degraded.append((commit, statement))
                continue
            status, principal = signature(repo, commit, keys, revocations.name)
            if status == 'G' and principal and principal == predicate['signer']:
                trusted.append((commit, statement, principal))
            elif status in ('B', 'N'):
                untrusted.append(('bad_signature', commit))
            else:
                untrusted.append(('untrusted_signer', commit))
    with_check = [c for c in trusted if check in c[1]['predicate']['observed']['checks']]
    if not with_check:
        only_degraded = [c for c in degraded if check in c[1]['predicate']['observed']['checks']]
        if only_degraded and not untrusted:
            raise Failure('degraded', f'only unsigned degraded records exist for check {check}',
                          attempts=len(only_degraded))
        if untrusted and not trusted:
            raise Failure(untrusted[0][0], f'no record for check {check} is signed by a trusted key')
        if trusted:
            raise Failure('wrong_check', f'trusted records for this tree do not include check {check}')
        stale = other_trees_have(repo, everything, tree, check)
        raise Failure('stale_tree' if stale else 'no_record',
                      f'check {check} has records only for other trees' if stale else f'no record for check {check}')
    # The latest record decides, so a newer failure supersedes an older pass. observed_at is the signer's own clock, so the order is
    # biased toward failure: a pass replaces a failure only when it is dated MORE than FUTURE_SKEW after it. A pass dated equal,
    # inverted or within the margin of a failure never hides it (a signer or a skewed clock cannot bury a failure by dating a pass).
    def failed(entry):
        return entry[1]['predicate']['observed']['checks'][check]['exit_code'] != 0

    def dated(entry):
        return parse_time(entry[1]['predicate']['observed_at'])

    # A passing shard part never decides: a merge queue signs each shard of fractal-web under the same input key as the record for the
    # whole run, and the newest part would otherwise shadow that record and be refused for the inputs only the whole run carries. A
    # failing part still decides, as the failure it is, so leaving parts out can never hide one.
    parts = [c for c in with_check if not failed(c) and shard_part(rules, c[1])]
    if parts:
        with_check = [c for c in with_check if c not in parts]
        if not with_check:
            raise Failure('no_record', f'check {check} has only passing shard parts, no record for the whole run', attempts=len(parts))
    # Which record decides (#4241). A crate's (or a check's) input key is shared by every tree with the same inputs, so the records found
    # for it come from many trees and signers. The newest used to decide and only then be validated, so a newer pass that could never
    # cover THIS tree hid an older one that does: CI's per-crate notes at `fleet`, a level no kind of rust-tests accepts, and host notes
    # signed for another tree's lane definition. Now the newest pass that validates decides. What can cover a tree is unchanged: every rule
    # in `judge` applies to that record. Failures stay conservative: a failing record of any level dated after the deciding pass (within
    # FUTURE_SKEW) refuses, whatever tree's lane it was signed for. A newer pass refused for any other reason still decides, and is refused,
    # as before (a signer cannot hide a newer claim of another kind behind its own older grant). With no pass that validates, the newest
    # record decides as before. `decided_by` and `skipped_newer` (one entry per newer pass passed over, and why) say how the choice was made.
    if rules is not None:
        kind_levels = [rule['trust_levels'] if rule['trust_levels'] else rules['trust_levels'] for rule in rules['kinds'].values()]
        accepted = None if any(levels is None for levels in kind_levels) else {level for levels in kind_levels for level in levels}
    else:
        accepted = None if trust_levels is None else set(trust_levels)
    attempts = len(with_check)
    lanes = []

    def lane_once():
        if not lanes:
            lanes.append(level_lane())
        return lanes[0]

    def level_of(entry):
        return entry[2].split('/', 1)[0]

    def judge(chosen, command=command, kinds=kinds, bind=bind, max_age=max_age, runner_prefix=runner_prefix, trust_levels=trust_levels,
              lane=lane):
        commit, statement, principal = chosen
        predicate = statement['predicate']
        observed = predicate['observed']
        result = observed['checks'][check]
        if failed(chosen) and shard_part(rules, statement):
            raise Failure('check_failed', f'a shard of the latest run of check {check} exited {result["exit_code"]}', attempts=attempts)
        if predicate['tier'] != 'full':
            raise Failure('untrusted_tier', f'latest record has tier {predicate["tier"]}, not full', attempts=attempts)
        kind = kind_of(observed['runner'])
        required_inputs = ()
        rule, events = None, None
        if rules is not None:
            # The repository's skip policy decides everything about this record, by its kind.
            rule = rules['kinds'].get(kind) if kind else None
            kinds = (kind,) if rule else ()
            if rule:
                command, runner_prefix, bind = rule['command'], rule['runner_prefix'], list(rule['bind_inputs'].items())
                required_inputs = rule['required_inputs']
            trust_levels = (rule['trust_levels'] if rule and rule['trust_levels'] else rules['trust_levels'])
            max_age = rules['max_age_s']
        if kind is None or kind not in kinds:
            raise Failure('unsupported_kind', f'runner {observed["runner"]!r} is not one of {", ".join(kinds)}',
                          attempts=attempts)
        level = principal.split('/', 1)[0]
        if trust_levels is not None and level not in trust_levels:
            raise Failure('untrusted_level', f'signer trust level {level!r} is not accepted for this check',
                          attempts=attempts)
        # A signer level may be held to its own command, required inputs and events (by_level in the kind's rule).
        override = rule['by_level'].get(level) if rule else None
        lane_mode = override.get('lane') if override else None
        if override:
            command, bind, required_inputs, events = override['command'], list(override['bind_inputs'].items()), override['required_inputs'], override['events']
            if override.get('lane') and lane is None:
                if level_lane is None:
                    raise Failure('no_lane', f'signer level {level!r} must be held to a lane definition, and none was given', attempts=attempts)
                lane = lane_once()
                if lane is None:
                    raise Failure('no_lane', f'no lane definition for check {check} at the accepted base', attempts=attempts)
        if runner_prefix is not None and not observed['runner'].startswith(runner_prefix):
            raise Failure('wrong_runner', 'record is for a different repository or producer', attempts=attempts)
        # A future-dated record is refused whether or not an age limit is set: otherwise a trusted
        # signer's future-dated pass would stay the latest record and hide every later real failure.
        moment = parse_time(predicate['observed_at'])
        current = now or datetime.now(timezone.utc)
        if moment > current + FUTURE_SKEW:
            raise Failure('future_dated', 'record claims to be observed in the future', attempts=attempts)
        if max_age is not None and current - moment > timedelta(seconds=max_age):
            raise Failure('too_old', f'record is older than {max_age} seconds', attempts=attempts)
        inputs = observed.get('inputs', {})
        for key in required_inputs:
            value = inputs.get(key)
            if not isinstance(value, str) or not value:
                raise Failure('missing_input', f'record lacks required input {key}', attempts=attempts)
        if result['exit_code'] != 0:
            raise Failure('check_failed', f'latest record for check {check} exited {result["exit_code"]}',
                          attempts=attempts)
        if command is not None and result['command'] != command:
            raise Failure('wrong_command', f'latest record for check {check} ran a different command',
                          attempts=attempts)
        if rule:
            value_checks(rule, observed.get('inputs', {}), run_inputs or {}, attempts)
        if lane is not None:
            # The scripts that decide what the lane runs must be the accepted base's, byte for byte, in the tree that was signed; and the
            # note must carry the digest of that definition, so a note made against other scripts or another argv is not this lane's.
            # A level held to the tree's own definition (lane "tree") may edit the lane: its note must then carry the edited definition's digest.
            expected = lane['sha256']
            if lane['changed'] and lane_mode == 'tree':
                expected = lane['tree_sha256']
            elif lane['changed']:
                raise Failure('definition_changed', 'the lane definition differs between the signed tree and the accepted base: '
                              + ', '.join(lane['changed'][:5]) + (' ...' if len(lane['changed']) > 5 else ''), attempts=attempts)
            recorded_definition = observed.get('inputs', {}).get('lane_definition_sha256')
            if recorded_definition != expected:
                raise Failure('wrong_definition', 'the record does not carry the digest of the lane definition '
                              + ('this tree defines' if expected != lane['sha256'] else 'at the accepted base'), attempts=attempts)
        inputs = observed.get('inputs', {})
        for key, path in bind:
            actual = blob_sha256(repo, tree, path)
            recorded = inputs.get(key)
            # Both must exist: a missing file and a missing key must never count as equal.
            if actual is None or not isinstance(recorded, str) or not recorded or recorded != actual:
                raise Failure('wrong_input', f'record input {key} does not match {path} in this tree',
                              attempts=attempts)
        return {
            'satisfied': True, 'tree': tree, 'check': check, 'record': commit,
            'kind': kind, 'signer': principal, 'trust_level': level,
            'tier': predicate['tier'], 'observed_at': predicate['observed_at'],
            'command': result['command'], 'inputs': inputs, 'attempts': attempts, 'policy': rules is not None,
            'max_age_s': rules['max_age_s'] if rules is not None else max_age,
            'enforce': rules['enforce'] if rules is not None else False,
            'match': 'tree' if statement['subject'][0]['digest']['gitTree'] == tree else 'inputs',
            'matched_tree': statement['subject'][0]['digest']['gitTree'], 'source_inputs': input_key,
            'sample_one_in': rules['sample_one_in'] if rules is not None else 1,
            'events': narrowed_events(rules.get('events') if rules is not None else None, events),
        }


    skipped = []

    def first_valid(candidates):
        """(record, result) of the newest candidate pass that validates, or None; a pass refused for a reason other than being made
        for something else decides, and is raised."""
        for candidate in candidates:
            if accepted is not None and level_of(candidate) not in accepted:
                note = f'{candidate[0]} {level_of(candidate)} level_not_accepted'
            else:
                try:
                    return candidate, judge(candidate)
                except Failure as failure:
                    if failure.reason != 'wrong_definition':  # only a pass signed for another tree's lane definition is passed over
                        failure.extra.update(decided_by=candidate[0], skipped_newer=skipped)
                        raise
                    note = f'{candidate[0]} {level_of(candidate)} {failure.reason}'
            if note not in skipped:
                skipped.append(note)
        return None

    def failed_after(candidate):
        return [c for c in with_check if failed(c) and dated(c) >= dated(candidate) - FUTURE_SKEW]

    order = sorted((c for c in with_check if not failed(c)), key=dated, reverse=True)
    # Preferred levels (the gate's --prefer-levels): their newest valid pass decides, unless a failure is dated after it.
    found = first_valid([c for c in order if level_of(c) in prefer_levels]) if prefer_levels else None
    if found is None or failed_after(found[0]):
        found = first_valid(order)
    if found is not None:
        candidate, result = found
        later = failed_after(candidate)
        if later:
            failure = max(later, key=dated)
            raise Failure('check_failed', f'record {failure[0]} ({level_of(failure)}) for check {check} failed, dated after the pass that '
                          f'would decide ({candidate[0]})', attempts=attempts, decided_by=failure[0], skipped_newer=skipped)
        result.update(decided_by=candidate[0], skipped_newer=skipped)
        return result
    chosen = max(with_check, key=lambda c: (dated(c), failed(c)))
    if not failed(chosen):
        shadowing = [c for c in with_check if failed(c) and dated(c) >= dated(chosen) - FUTURE_SKEW]
        if shadowing:
            chosen = max(shadowing, key=dated)
    try:
        return judge(chosen)
    except Failure as failure:
        failure.extra.update(decided_by=chosen[0], skipped_newer=skipped)
        raise

def sibling(name):
    """A script that sits next to this one (the gate copies the accepted base's both)."""
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)), name)
    if not os.path.isfile(path):
        raise Failure('error', f'{name} is not next to the verifier')
    loader = importlib.machinery.SourceFileLoader('evidence_sibling_' + name.replace('-', '_'), path)
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


def member_keys(repo, tree, policy_base):
    """{crate: key} for every workspace member of `tree`: the member list and closure from the tree's manifests, the declared extras from
    .st/rust-test-inputs.json at the accepted base, the code from the accepted base's scripts/rust-test-keys (docs/per-crate-test-signing.md)."""
    if not policy_base:
        raise Failure('error', '--members needs --policy-from: the keys are defined by the accepted base')
    rtk = sibling('rust-test-keys')
    # The manifests are read with plain git, never fetched on demand: in a blob:none clone a missing one is a refusal ('error'), and the
    # caller prefetches them in one request (a lazy read of every manifest would be one round trip each).
    previous = os.environ.get('GIT_NO_LAZY_FETCH')
    os.environ['GIT_NO_LAZY_FETCH'] = '1'
    try:
        members = {crate: key for crate, (key, _) in rtk.keys(repo, tree, rtk.read_inputs(repo, policy_base), project).items()}
    except rtk.Failure as failure:
        raise Failure('error', f'per-crate keys: {failure}')
    finally:
        if previous is None:
            os.environ.pop('GIT_NO_LAZY_FETCH', None)
        else:
            os.environ['GIT_NO_LAZY_FETCH'] = previous
    if not members:
        raise Failure('error', 'the tree has no workspace member: nothing to cover is not a pass')
    return members


def member_refspecs(check, key):
    """The refspecs that fetch the records indexed under this check and key, in both namespaces (the layout evidence-publish and
    evidence-wrap write), so the gate builds one fetch from the verifier's output."""
    return [f'+{INPUT_TAGS}{check}/{key}/*:{INPUT_TAGS}{check}/{key}/*', f'+{INPUT_NOTES}{check}/{key}/*:{INPUT_NOTES}{check}/{key}/*']


def verify_members(repo, tree, check, keys, command, kinds, bind, max_age, runner_prefix, trust_levels, rules, lane, level_lane, run_inputs,
                   policy_base, log_keys=None):
    """`check` holds for the tree when EVERY workspace member has a satisfying note for its own key (a per-crate check, scripts/rust-test-keys).

    One verify() per member (the same rules as any note, with the member's crate and key). Satisfied only when none is missing; the result
    names the oldest note's time and the weakest signer level so the gate's age and trust conditions judge the weakest link, and a
    combined key (the sha1 of the sorted crate=key lines) for the gate's sampling seed."""
    members = member_keys(repo, tree, policy_base)
    no_tests = zero_test_crates(repo, policy_base)
    lane_cache, lane_lock = [], threading.Lock()

    def memoized_level_lane():
        with lane_lock:
            if not lane_cache:
                lane_cache.append(level_lane() if level_lane else None)
            return lane_cache[0]

    def check_one(item):
        crate, key = item
        if key is None:
            return crate, None, 'no_key'
        try:
            return crate, verified(repo, tree, check, keys, command, kinds, bind, max_age, runner_prefix, trust_levels, None, rules, lane,
                                   memoized_level_lane if level_lane else None, run_inputs, (crate, key, crate not in no_tests)), None
        except Failure as failure:
            return crate, None, failure.reason

    # Each member's check is a handful of git and ssh-keygen runs (the signature of every candidate record): independent, so side by side, 8 at
    # a time; the answers are read back in crate order, so the result is the one a serial loop gives.
    found, missing = {}, {}
    with concurrent.futures.ThreadPoolExecutor(max_workers=min(8, max(1, len(members)))) as pool:
        for crate, note, reason in pool.map(check_one, sorted(members.items())):
            if reason is not None:
                missing[crate] = reason
            else:
                found[crate] = note
    if missing:
        failure = Failure('crate_uncovered', f'{len(missing)} of {len(members)} crates have no satisfying note for their key: '
                      + ', '.join(f'{crate} ({reason})' for crate, reason in list(missing.items())[:12]) + (' ...' if len(missing) > 12 else ''),
                      missing=missing, members=len(members))
        if log_keys:  # the log's view of the same decision, as verify() gives one for a check that did not hold
            failure.extra.update(members_log_view(repo, log_keys, tree, check, {crate: (key, None) for crate, key in members.items()}))
        raise failure
    order = {'host': 1, 'agent': 2}
    notes = list(found.values())
    oldest = min(notes, key=lambda note: parse_time(note['observed_at']))
    weakest = max(notes, key=lambda note: order.get(note['trust_level'], 0))
    combined = hashlib.sha1('\n'.join(f'{crate}={key}' for crate, key in sorted(members.items())).encode()).hexdigest()
    events = rules.get('events') if rules is not None else None
    for note in notes:
        events = narrowed_events(events, note['events']) if note['events'] is not None else events
    result = dict(oldest)
    result.update({'record': oldest['record'], 'signer': oldest['signer'], 'trust_level': weakest['trust_level'],
                   'match': 'inputs' if any(note['match'] == 'inputs' for note in notes) else 'tree', 'source_inputs': combined,
                   'events': events, 'members': len(members), 'crates': {crate: note['record'] for crate, note in sorted(found.items())},
                   'attempts': max(note['attempts'] for note in notes), 'missing': {}})
    if log_keys:
        result.update(members_log_view(repo, log_keys, tree, check, {crate: (members[crate], note['record'], note['observed_at']) for crate, note in found.items()}))
    return result


def read_policy(repo, commit):
    try:
        return config_blob(repo, commit, POLICY_PATH).decode()
    except (Failure, UnicodeDecodeError):
        raise Failure('no_policy', f'no readable skip policy at {commit}:{POLICY_PATH}')


def read_lanes(repo, commit):
    try:
        return config_blob(repo, commit, LANES_PATH).decode()
    except (Failure, UnicodeDecodeError):
        raise Failure('error', f'no readable lane file at {commit}:{LANES_PATH}')


def lane_for(repo, tree, lanes, check, lane_base=None):
    """The lane check of `check` for the verified tree, from (lane file text, accepted base commit); None without a lane file.

    `lane_base` (the pull request's branch point) holds the tree to the lane's definition at that commit instead of the base's: a
    branch that is only behind main, and changes none of the lane's files itself, is not a lane edit, and its note carries the
    branch point's digest. The branch point must be an ancestor of the base (a definition main accepted) and this lane's own entry
    must be the same at both, so its argv and paths are the base's either way; another lane's entry changing on main is not this one's."""
    if lanes is None:
        return None
    text, base = lanes
    definition_base = base
    if lane_base is not None:
        if not OID.match(lane_base):
            raise Failure('error', 'the lane base must be a full lowercase commit ID')
        code, _ = no_lazy(repo, 'merge-base', '--is-ancestor', lane_base, base)
        if code != 0:
            raise Failure('error', f'the lane base {lane_base[:12]} is not an ancestor of the accepted base')
        # arn:lmig:smalltalk:2026-10-27-dot-fractal-config — resolve at the branch point, not the checkout.
        path = config_path(repo, lane_base, LANES_PATH)
        code, shown = no_lazy(repo, 'show', f'{lane_base}:{path or LANES_PATH}')
        if path is not None and code != 0:
            raise Failure('error', f'could not read lane file at {lane_base}:{path}')
        here = lane_entry(shown.decode(errors='replace'), check) if code == 0 else None
        if here is None or here != lane_entry(text, check):
            raise Failure('definition_changed', f'lane {check} in {LANES_PATH} differs between the branch point and the accepted base')
        definition_base = lane_base
    base_tree = git(repo, 'rev-parse', '--verify', '--end-of-options', definition_base + '^{tree}').decode().strip()
    return lane_definition(repo, base_tree, tree, lane_rules(text, check))


def require_all(repo, tree, keys, policy_text, repository, lane_file=None, lane_base=None):
    """Every check whose policy says `require` (shadow or reject), judged by the same rules as a single check.

    One entry per such check with its own reason, so a missing lane is named, not folded into one boolean. The overall
    `decision` is `reject` when a check in mode reject is not satisfied, `would-reject` when only shadow checks are not,
    and `ok` otherwise (also when no check requires anything). Nothing here reads the pull request's own copy of the
    policy: the caller passes the text of the accepted base."""
    try:
        doc = json.loads(policy_text)
    except ValueError as error:
        raise Failure('error', f'skip policy is not valid JSON: {error}')
    if not isinstance(doc, dict) or set(doc) != POLICY_KEYS or doc['version'] != 1 or not isinstance(doc['checks'], dict):
        raise Failure('error', 'skip policy must be {"version": 1, "checks": {...}}')
    lanes = {}
    for check in sorted(doc['checks']):
        rules = policy_rules(policy_text, check, repository)  # validates the whole entry, `require` included
        mode = rules['require']
        if mode == 'off':
            continue
        try:
            # A broken lane file or a missing definition path is a verifier error (it propagates); only a check without a lane entry is a lane refusal.
            definition = lane_for(repo, tree, lane_file, check, lane_base)
        except Failure as failure:
            if failure.reason != 'no_lane':
                raise
            lanes[check] = {'require': mode, 'satisfied': False, 'reason': failure.reason, 'detail': failure.detail,
                            'decision': 'reject' if mode == 'reject' else 'would-reject'}
            continue
        try:
            result = verify(repo, tree, check, keys, None, rules=rules, lane=definition)
            lane = {'require': mode, 'satisfied': True, 'decision': 'ok', 'record': result.get('record'),
                    'signer': result.get('signer'), 'tier': result.get('tier')}
        except Failure as failure:
            lane = {'require': mode, 'satisfied': False, 'reason': failure.reason, 'detail': failure.detail,
                    'decision': 'reject' if mode == 'reject' else 'would-reject'}
        lanes[check] = lane
    decisions = {lane['decision'] for lane in lanes.values()}
    decision = 'reject' if 'reject' in decisions else 'would-reject' if 'would-reject' in decisions else 'ok'
    return {'mode': 'require-all', 'tree': tree, 'satisfied': all(lane['satisfied'] for lane in lanes.values()),
            'decision': decision, 'lanes': lanes}


def blob_sha256(repo, tree, path):
    """sha256 of a file as it is in the tree being verified, or None if the tree lacks it."""
    try:
        content = git(repo, 'cat-file', 'blob', f'{tree}:{path}')
    except Failure:
        return None
    return hashlib.sha256(content).hexdigest()


def batch(output):
    """Objects from `git cat-file --batch` output: (header fields, body)."""
    position = 0
    while position < len(output):
        end = output.index(b'\n', position)
        header = output[position:end].split()
        if len(header) != 3 or header[1] == b'missing':
            position = end + 1
            continue
        size = int(header[2])
        yield header, output[end + 1:end + 1 + size]
        position = end + 1 + size + 1


def other_trees_have(repo, commits, tree, check):
    """Slow path, only after a miss: does any record for another tree include this check?"""
    if not commits:
        return False
    width = len(tree) // 2
    listing = git(repo, 'cat-file', '--batch', stdin=''.join(f'{c}^{{tree}}\n' for c in commits).encode())
    blobs = []
    for header, body in batch(listing):
        entry = 0
        while entry < len(body):
            nul = body.index(b'\0', entry)
            name = body[entry:nul].split(b' ', 1)[1].decode(errors='replace')
            if OID.match(name) and name != tree:
                blobs.append(body[nul + 1:nul + 1 + width].hex())
            entry = nul + 1 + width
    if not blobs:
        return False
    content = git(repo, 'cat-file', '--batch', stdin=''.join(f'{b}\n' for b in blobs).encode())
    for header, body in batch(content):
        try:
            if check in json.loads(body)['predicate']['observed']['checks']:
                return True
        except (ValueError, KeyError, TypeError):
            continue
    return False


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('--repo', default='.')
    target = parser.add_mutually_exclusive_group(required=True)
    target.add_argument('--tree')
    target.add_argument('--revision')
    parser.add_argument('--check')
    parser.add_argument('--lanes-from', metavar='COMMIT',
                        help=f'also hold the check to its lane definition in {LANES_PATH} at this accepted base: the lane\'s script blobs must be '
                             'identical in the verified tree and the base (definition_changed) and the note must carry the base\'s digest (wrong_definition)')
    parser.add_argument('--lane-base', metavar='COMMIT',
                        help='hold the lane to its definition at this commit (a pull request\'s branch point, an ancestor of the base with the '
                             'same lane file) instead of at the base: a tree that only lags main is not a lane edit')
    parser.add_argument('--require-all', action='store_true',
                        help='judge every check whose policy says `require` (needs --policy-from, --repository and keys); '
                             'exit 1 only when a check in mode reject is not satisfied, exit 2 (decision error) when it could not decide')
    parser.add_argument('--project', action='store_true',
                        help='print the input key of the tree for the check\'s declared paths and exit (needs no keys)')
    parser.add_argument('--paths', metavar='PATH[,PATH...]', help='with --project: declared paths instead of the policy\'s')
    parser.add_argument('--members', action='store_true',
                        help='a per-crate check: satisfied only when every workspace member of the tree has a satisfying note for its own key '
                             '(needs --policy-from; accepts --lane-base; reads manifests without fetching; the keys come from scripts/rust-test-keys next to this script and .st/rust-test-inputs.json at '
                             'the base). With --project: print the member keys and stop')
    parser.add_argument('--crate-key', metavar='CRATE=KEY',
                        help='a per-crate check (docs/per-crate-test-signing.md): only records that signed this crate and this input key count, '
                             'whichever tree they are for (scripts/rust-test-keys prints the keys)')
    source = parser.add_mutually_exclusive_group(required=False)
    source.add_argument('--keys', help='allowed-signers file')
    source.add_argument('--keys-from', help=f'read {KEYS_PATH} from this commit (the accepted base)')
    logs = parser.add_mutually_exclusive_group(required=False)
    logs.add_argument('--log-keys', help=f'allowed-signers file of the evidence log key: adds the log\'s shadow view ({LOG_REF})')
    logs.add_argument('--log-keys-from', metavar='COMMIT', help=f'read {LOG_KEY_PATH} from this commit (none there: no log view)')
    parser.add_argument('--command', help='JSON argument vector the record must have run')
    parser.add_argument('--run-input', action='append', default=[], metavar='KEY=VALUE',
                        help="this run's own value of an input the policy's input_order compares a record's value with (repeatable)")
    parser.add_argument('--kinds', help=f'comma-separated record kinds this check accepts (default: {",".join(KINDS)})')
    parser.add_argument('--policy-from', metavar='COMMIT',
                        help=f'apply the skip policy {POLICY_PATH} read from this accepted base (needs --repository)')
    parser.add_argument('--repository', help='OWNER/NAME, filled into the skip policy placeholders')
    parser.add_argument('--max-age', type=int, metavar='SECONDS',
                        help='reject a record observed longer ago than this, or claiming a future time')
    parser.add_argument('--runner-prefix', help='the record runner must start with this (e.g. github:org/repo/)')
    parser.add_argument('--trust-levels', help='comma-separated signer trust levels this check accepts')
    parser.add_argument('--prefer-levels', metavar='LEVELS',
                        help='comma-separated signer levels whose newest passing record decides instead of a newer pass from another '
                             'level, unless a failing record is dated after it; every other rule still applies')
    parser.add_argument('--bind-input', action='append', default=[], metavar='KEY=PATH',
                        help="require the record's input KEY to equal the sha256 of PATH in the verified tree")
    try:
        args = parser.parse_args(argv)
    except SystemExit as error:
        return 2 if error.code else 0
    if args.require_all:
        loose = [args.check, args.command, args.kinds, args.runner_prefix, args.trust_levels, args.max_age, args.paths,
                 args.bind_input or None, args.project or None]
        if args.policy_from is None or args.repository is None or any(v is not None for v in loose):
            print('--require-all needs --policy-from and --repository and replaces --check, --project, --paths, --command, --kinds, '
                  '--runner-prefix, --trust-levels, --max-age and --bind-input', file=sys.stderr)
            return 2
    elif args.check is None:
        print('--check is required', file=sys.stderr)
        return 2
    if not args.project and not (args.keys or args.keys_from):
        print('one of --keys or --keys-from is required', file=sys.stderr)
        return 2
    if args.paths is not None and not args.project:
        print('--paths is only used with --project', file=sys.stderr)
        return 2
    command = None
    if args.command is not None:
        try:
            command = json.loads(args.command)
            if not (isinstance(command, list) and command and all(isinstance(p, str) for p in command)):
                raise ValueError
        except ValueError:
            print('--command must be a JSON array of strings', file=sys.stderr)
            return 2
    kinds = KINDS
    if args.kinds is not None:
        kinds = tuple(k for k in args.kinds.split(',') if k)
        if not kinds or not set(kinds) <= set(KINDS):
            print(f'--kinds must be a comma-separated subset of {",".join(KINDS)}', file=sys.stderr)
            return 2
    if args.policy_from is not None:
        loose = [args.command, args.kinds, args.runner_prefix, args.trust_levels, args.max_age,
                 args.bind_input or None]
        if args.repository is None or any(v is not None for v in loose):
            print('--policy-from needs --repository and replaces --command, --kinds, --runner-prefix, '
                  '--trust-levels, --max-age and --bind-input', file=sys.stderr)
            return 2
    elif args.repository is not None:
        print('--repository is only used with --policy-from', file=sys.stderr)
        return 2
    if args.lane_base is not None and not (args.lanes_from or args.policy_from):
        print('--lane-base is only used with --lanes-from or --policy-from', file=sys.stderr)
        return 2
    if args.max_age is not None and args.max_age <= 0:
        print('--max-age must be a positive number of seconds', file=sys.stderr)
        return 2
    prefer_levels = None
    if args.prefer_levels is not None:
        prefer_levels = tuple(level for level in args.prefer_levels.split(',') if level)
        if not prefer_levels or args.members or args.require_all:
            print('--prefer-levels must name at least one level, and is not used with --members or --require-all', file=sys.stderr)
            return 2
    trust_levels = None
    if args.trust_levels is not None:
        trust_levels = tuple(level for level in args.trust_levels.split(',') if level)
        if not trust_levels:
            print('--trust-levels must name at least one level', file=sys.stderr)
            return 2
    bind = []
    for item in args.bind_input:
        key, sep, path = item.partition('=')
        if not sep or not key or not path:
            print('--bind-input must be KEY=PATH', file=sys.stderr)
            return 2
        bind.append((key, path))
    keyfile = None
    try:
        tree = args.tree
        if tree is None:
            tree = git(args.repo, 'rev-parse', '--verify', '--end-of-options', args.revision + '^{tree}').decode().strip()
        if not OID.match(tree):
            raise Failure('error', 'expected a full lowercase Git tree ID')
        if args.project and args.members:
            members = member_keys(args.repo, tree, args.policy_from)
            print(json.dumps({'crates': {crate: {'key': key, 'refspecs': member_refspecs(args.check, key) if key else []}
                                         for crate, key in sorted(members.items())},
                              'members': len(members), 'tree': tree, 'check': args.check}, indent=2))
            return 0
        if args.project:
            rules = None
            if args.policy_from:
                try:
                    text = config_blob(args.repo, args.policy_from, POLICY_PATH).decode()
                except (Failure, UnicodeDecodeError):
                    raise Failure('no_policy', f'no readable skip policy at {args.policy_from}:{POLICY_PATH}')
                rules = policy_rules(text, args.check, args.repository)
            if args.paths is not None:
                paths = declared_paths([p for p in args.paths.split(',') if p], '--paths')
            else:
                paths = rules['inputs'] if rules is not None else None
            # base_inputs: the values a signer records for the policy's base_inputs (the same ones this verifier will compare).
            print(json.dumps({'source_inputs': project(args.repo, tree, paths) if paths else None,
                              'paths': list(paths) if paths else None, 'tree': tree, 'check': args.check,
                              'base_inputs': base_input_values(args.repo, args.policy_from, rules) if rules is not None else {}}, indent=2))
            return 0
        if args.keys_from:
            keyfile = tempfile.NamedTemporaryFile(suffix='.keys')
            keyfile.write(config_blob(args.repo, args.keys_from, KEYS_PATH))
            keyfile.flush()
            keys = keyfile.name
        else:
            keys = os.path.abspath(args.keys)
            if not os.path.isfile(keys):
                raise Failure('error', f'key list {args.keys} not found')
        if args.require_all:
            lane_file = (read_lanes(args.repo, args.lanes_from), args.lanes_from) if args.lanes_from else None
            result = require_all(args.repo, tree, keys, read_policy(args.repo, args.policy_from), args.repository, lane_file,
                                 args.lane_base)
            print(json.dumps(result, indent=2))
            return 1 if result['decision'] == 'reject' else 0
        rules = None
        if args.policy_from:
            try:
                text = config_blob(args.repo, args.policy_from, POLICY_PATH).decode()
            except (Failure, UnicodeDecodeError):
                raise Failure('no_policy', f'no readable skip policy at {args.policy_from}:{POLICY_PATH}')
            rules = policy_rules(text, args.check, args.repository)
        lanes = (read_lanes(args.repo, args.lanes_from), args.lanes_from) if args.lanes_from else None
        run_inputs = {}
        for pair in args.run_input:
            key, sep, value = pair.partition('=')
            if not sep or not key:
                raise Failure('error', f'--run-input must be KEY=VALUE, not {pair!r}')
            run_inputs[key] = value
        if rules is not None:  # computed here from the accepted base, never taken from the caller
            run_inputs.update(base_input_values(args.repo, args.policy_from, rules))
        log_keys = os.path.abspath(args.log_keys) if args.log_keys else None
        if args.log_keys_from:
            log_path = config_path(args.repo, args.log_keys_from, LOG_KEY_PATH)
            if log_path is not None:
                text = git(args.repo, 'show', '--end-of-options', f'{args.log_keys_from}:{log_path}')
                logfile = tempfile.NamedTemporaryFile(suffix='.log-keys')
                logfile.write(text)
                logfile.flush()
                log_keys = logfile.name
        # A level held to its lane (by_level lane: true) is judged against the lane file of the same base as the policy.
        policy_base = args.policy_from
        crate_key = None
        if args.crate_key:
            crate, sep, key = args.crate_key.partition('=')
            if not sep or not crate or not OID.match(key):
                raise Failure('error', f'--crate-key must be CRATE=KEY with a git tree id, not {args.crate_key!r}')
            # Judged by a policy (the accepted base is given): a note must have run a test unless the base lists the crate as having none.
            crate_key = (crate, key, bool(policy_base) and crate not in zero_test_crates(args.repo, policy_base))
        level_lane = (lambda: lane_for(args.repo, tree, (read_lanes(args.repo, policy_base), policy_base), args.check,
                                       args.lane_base)) if policy_base else None
        if args.members:
            result = verify_members(args.repo, tree, args.check, keys, command, kinds, bind, args.max_age, args.runner_prefix, trust_levels,
                                    rules, lane_for(args.repo, tree, lanes, args.check, args.lane_base), level_lane, run_inputs, policy_base,
                                    log_keys=log_keys)
            print(json.dumps(result, indent=2))
            return 0
        result = verify(args.repo, tree, args.check, keys, command, kinds, bind, args.max_age, args.runner_prefix,
                        trust_levels, crate_key=crate_key, rules=rules, lane=lane_for(args.repo, tree, lanes, args.check, args.lane_base),
                        level_lane=level_lane, log_keys=log_keys, run_inputs=run_inputs, prefer_levels=prefer_levels)
        print(json.dumps(result, indent=2))
        return 0
    except Failure as failure:
        if args.require_all:
            # Exit 1 means exactly "a reject lane is not satisfied"; a verifier that could not decide exits 2.
            print(json.dumps({'mode': 'require-all', 'decision': 'error', 'satisfied': False, 'reason': failure.reason,
                              'detail': failure.detail}, indent=2))
            return 2
        print(json.dumps({'satisfied': False, 'reason': failure.reason, 'check': args.check,
                          'detail': failure.detail, **failure.extra}, indent=2))
        return 1
    except Exception as error:  # any surprise is a refusal with a reason, never a traceback or a pass
        if args.require_all:
            print(json.dumps({'mode': 'require-all', 'decision': 'error', 'satisfied': False, 'reason': 'error',
                              'detail': f'{type(error).__name__}: {error}'}, indent=2))
            return 2
        print(json.dumps({'satisfied': False, 'reason': 'error', 'check': args.check,
                          'detail': f'{type(error).__name__}: {error}'}, indent=2))
        return 1
    finally:
        if keyfile is not None:
            keyfile.close()


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
