#!/usr/bin/env python3
"""Reject internal identities and machine details in public repository files."""

import hashlib
import re
import subprocess
import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parent.parent
# Listed after release notes that name them had merged (HOST_NAME_NOTES).
LATER_HOSTS = tuple(re.escape(part) for part in ("he" + "tz2", "de" + "v3"))
HOSTS = tuple(re.escape(part) for part in ("he" + "tz", "Sil" + "ber", "bl" + "uey")) + LATER_HOSTS


def host_pattern(hosts):
    return re.compile(r"(?i)(?<![a-z0-9])(?:" + "|".join(hosts) + r")(?![a-z0-9])")


HOST = host_pattern(HOSTS)
EARLIER_HOST = host_pattern(host for host in HOSTS if host not in LATER_HOSTS)
HOME = re.compile(r"/(?:home|Users)/([A-Za-z][A-Za-z0-9_.-]*)")
# Reserved invented homes used by public examples and clean-machine fixtures.
EXAMPLE_HOMES = {"example", "ada"}
PERSON_NAME = r"([A-Za-z][A-Za-z0-9_-]*(?:\.[A-Za-z0-9_-]+)*)"
PERSON = re.compile("person" + r"/" + PERSON_NAME)
ENCODED_PERSON = re.compile("person" + r"%2[fF]" + PERSON_NAME)
# Default mission authority specifically requires fleet/PROJECT identities. These tests
# use the reserved invented fixture- project prefix; other fleet seats remain forbidden.
FLEET_AGENT = re.compile("agent" + r"/fleet/(?!fixture-)[A-Za-z0-9_./-]+")
ENCODED_FLEET_AGENT = re.compile("agent" + r"%2[fF]fleet%2[fF](?!fixture-)[A-Za-z0-9_.%-]+")
PRIVATE_CONFIGURATION_REPO = re.compile(
    r"(?i)st3" + r"(?:-|%2d)" + r"network(?![a-z0-9_-])"
)
# Release notes are immutable once merged, and these named a LATER_HOSTS name before it was listed. Each may still name
# those, and only those, while its content is exactly what merged: every other host and every other check still applies.
HOST_NAME_NOTES = {
    "release-notes/coordination-ceiling-follows-live-sends.json": "cb53282e7065b110cd7d118362385e5a034c35bbbad9461e1e880c6d687f3e81",
    "release-notes/driver-resume-settle.json": "05af6a4859fe41b8cf1f6646b56af8e00851f4e7d57a406efb83f2821e3219fe",
    "release-notes/evidence-log-publish-guard.json": "84d3d6e18deb0262cbd46d77076191e209b585710f0804121d9f0c933d476354",
    "release-notes/evidence-log-timeout-2h.json": "dc51768524e74f6beaad0a71f0e278cdd7f34efbb544c8deb9ceaa41d2b0b9b9",
    "release-notes/evidence-signer-loader-env.json": "dd48f571bbce2cfd8adc073fd9ffc2cf7bcd57e6a7d4615b1d3bc5340fc19df9",
    "release-notes/fractal-web-machine-filter.json": "66f0a01017585369de805b5f69a030208b67939ce7ffcd288cecb9edf0f072aa",
    "release-notes/heal-checkpoint-covering-current-main.json": "7218f34f57f9c98c963c19af30ab55f76ea63779293bd0d1c602d76d72119def",
    "release-notes/heal-checkpoint-digest-extrema.json": "e697d12cb60d3daf648511e62453cacb6b56d7e1bc1348c5749851a1204da657",
    "release-notes/hm-single-config.json": "6217665ea7cda1d043103b4e017e21cd10be51fa531cdf343c4a7f6afc2f3c62",
    "release-notes/reader-mmap.json": "a80ed4eabae4fdff5468dd38e0348c226680d59ad246154e631f33d904773c86",
    "release-notes/sekrets-vouch-endpoint.json": "3875f5d263c96d634e013186a0b3f37f291d828493daf58237d643d098883791",
    "release-notes/stop-deferral-history-off-startup.json": "56e528d365b43a616fddc20f4ffb96415d4de3c7a78b3efb79a2ac23fb98db4b",
    "release-notes/test-fleet-nodes-no-web-ui.json": "048ea9573b3a23b4fc38b9133551ad17cfacb58ca1c30c10c1576ce19d638256",
    "release-notes/tiles-root-sweep-prefix.json": "2b5d4c83a4a881c99056ef88e1034386983f326f22fa23b83263b2e8477e6a2b",
    "release-notes/tiles-uids.json": "9dbd82b87c3999428bc82eebfb92a98082e28314d223074bd2f57c36a4914884",
    "release-notes/perf-load-slot-" + "he" + "tz2.json": "2706eba35d0aeff9a55d4408a1676d7848896c678ee613080c092953301438d8",
}
DATED_OPERATIONAL_DOC = re.compile(r"^docs/st3/(?:.*/)?[^/]*20[0-9]{2}-[01][0-9]-[0-3][0-9][^/]*\.md$")
STATUS_DOC = re.compile(r"^docs/st3/(?:.*/)?[^/]*(?:status|rollout|handoff)[^/]*\.md$")

# These are invented actors used by examples and tests. Additions require review.
EXAMPLE_PEOPLE = set("""
NAME IDENTITY alex operator eval-requester test requester ada reviewer eval-operator
example one someone-else mission-reviewer fixture eval receiver step-reviewer
tester operator-two config-operator perf-operator avery intruder worker explicit
mission step operator-one queue-operator bench-operator two source a any other system
migration-reviewer uninstall sender recipient first-reviewer fleet-tester device
release-smoke owner eval-attention robin lichen visitor blair demo pat wrong-local-actor probe
discord- discord-404 discord-606
""".split())
# Canonical principal grammar fixture exercises hyphen, underscore and dot together.
EXAMPLE_PEOPLE.add("operator-2_name.test")


def tracked_files():
    paths = subprocess.check_output(
        ["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z"], cwd=ROOT
    )
    return sorted(set(Path(path.decode()) for path in paths.split(b"\0") if path))


def findings(path, content):
    name = path.as_posix()
    if PRIVATE_CONFIGURATION_REPO.search(name):
        yield "private fleet configuration repository in path"
    merged = HOST_NAME_NOTES.get(name) == hashlib.sha256(content.encode()).hexdigest()
    host = EARLIER_HOST if merged else HOST
    if host.search(name):
        yield "real host name in path"
    if DATED_OPERATIONAL_DOC.match(name) or STATUS_DOC.match(name):
        yield "operational status, rollout, or handoff document"
    for number, line in enumerate(content.splitlines(), 1):
        reasons = []
        if PRIVATE_CONFIGURATION_REPO.search(line):
            reasons.append("private fleet configuration repository")
        if host.search(line):
            reasons.append("real host name")
        for match in HOME.finditer(line):
            if match.group(1) not in EXAMPLE_HOMES:
                reasons.append("personal home path")
        for match in PERSON.finditer(line):
            if match.group(1) not in EXAMPLE_PEOPLE:
                reasons.append("unlisted person ID")
        for match in ENCODED_PERSON.finditer(line):
            if match.group(1) not in EXAMPLE_PEOPLE:
                reasons.append("unlisted encoded person ID")
        if FLEET_AGENT.search(line) or ENCODED_FLEET_AGENT.search(line):
            reasons.append("internal fleet agent ID")
        for reason in sorted(set(reasons)):
            yield f"{number}: {reason}"


def main():
    errors = []
    for path in tracked_files():
        full = ROOT / path
        if not full.is_file():
            continue
        try:
            content = full.read_text(encoding="utf-8")
        except UnicodeError:
            continue
        errors.extend(f"{path}:{reason}" for reason in findings(path, content))
    for error in errors:
        print(error, file=sys.stderr)
    if errors:
        print(f"public repository check failed: {len(errors)} finding(s)", file=sys.stderr)
        return 1
    print("public repository check passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
