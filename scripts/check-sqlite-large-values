#!/usr/bin/env python3
"""Check explicit, source-bound exceptions; this does not prove SQLite value sizes."""
import argparse
import json
from pathlib import Path
import sys
import time
sys.dont_write_bytecode = True
from sqlite_large_values import MANIFEST, findings, formatting_findings, manifest_text


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent)
    parser.add_argument("--format", action="store_true",
                        help="canonicalize JSON only; never accept exceptions or refresh metadata")
    args = parser.parse_args()
    started = time.monotonic()
    try:
        path = args.root / MANIFEST
        text = path.read_text()
        manifest = json.loads(text)
        if args.format:
            path.write_text(manifest_text(manifest))
            print(f"Canonicalized {MANIFEST}; source acceptance and reviewed_base unchanged")
            return 0
        errors = formatting_findings(text, manifest) + findings(args.root, manifest)
    except (OSError, ValueError, KeyError, TypeError) as error:
        print(f"SQLite large-value inventory: {error}", file=sys.stderr)
        return 1
    for error in errors:
        print(error, file=sys.stderr)
    if errors:
        return 1
    print(f"SQLite source-site inventory passed: {len(manifest['sites'])} explicit allow-for-now sites; sizes remain unproven; elapsed {time.monotonic() - started:.3f}s")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
