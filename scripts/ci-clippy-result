#!/usr/bin/env python3
"""linux-clippy's result out of a clippy stage's report (docs/keyed-clippy.md).

  CLIPPY_REPORT=DIR scripts/ci-clippy-result

The local command a linux-clippy note records, as scripts/ci-rust-test-result is rust-tests'. scripts/st-test runs the clippy stage once,
inside linux-gate's run when that runs (so clippy never runs twice) or else alone (scripts/ci-local clippy), with CI_CLIPPY_REPORT=DIR.
The stage leaves its cargo messages and metadata in DIR, and `passed` only when the whole stage passed (clippy, the ratchet against the
base, the codegen check). This exits 0 only when `passed` is there and every repository file those compiles and build scripts read is in
linux-clippy's input key (scripts/dep-info-check against the tree's skip policy). linux-gate's command never reads the policy; this does,
after the stage. The report comes from the environment so the recorded argv stays the one the skip policy pins, and the note says which
run made it (run_command_sha256).
"""
import os
from pathlib import Path
import subprocess
import sys

sys.dont_write_bytecode = True

POLICY = '.st/evidence-skip-policy.json'


# arn:lmig:smalltalk:2026-10-27-dot-fractal-config — checkout missing-only bridge, as scripts/ci-linux's keyed_policy resolves it for CI's
# linux-clippy job: the .fractal/ copy when the checkout has one, else the .st/ path.
def policy_path(path=POLICY):
    preferred = os.path.join('.fractal', os.path.basename(path))
    try:
        os.lstat(preferred)
    except FileNotFoundError:
        return path
    return preferred


def main(argv):
    report = os.environ.get('CLIPPY_REPORT')
    if argv or not report:
        print('usage: CLIPPY_REPORT=DIR scripts/ci-clippy-result', file=sys.stderr)
        return 2
    if not (Path(report) / 'passed').is_file():
        print(f'ci-clippy-result: the clippy stage did not pass ({report} has no `passed`)')
        return 1
    check = [sys.executable, str(Path(__file__).resolve().parent / 'dep-info-check'), '--logs', report, '--check', 'linux-clippy',
             '--policy', policy_path(), '--jsonl', 'clippy-*.jsonl']
    return subprocess.run(check).returncode


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
