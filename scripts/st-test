#!/usr/bin/env python3
"""Run the required checks on this machine and sign what they measured. Nobody has to ask for a signature.

  scripts/st-test [--check NAME]... [--base origin/main] [--push REMOTE] [--attempt N] [--time-limit SECONDS]
  scripts/st-test --list
  scripts/st-test --status [--base origin/main]

For every check that has a local command (the table below: the whole per-PR suite; run `scripts/st-test --push origin` on the head
you mark ready, and --all, accepted, means the same) it runs that command once, on the tree the pull request will be tested as, through scripts/evidence-wrap, and the signer records the exit code and the digest of
the output it measured under this host's key (scripts/evidence-keygen). A failing run is recorded too. It then
asks the verifier, from the accepted base, whether the tree is now covered, and prints one line per check.

The tree: HEAD, the commit you are pushing. The CI gate looks up the note for the pull request head's own tree, so the tree
you built and signed is the tree that counts even when main has moved since; the merge queue still tests the integrated tree.
It tells you how far behind the base the branch is. The command always runs in a clean worktree of that commit, never
in this checkout, so untracked or ignored files here cannot change the result. The worktree is one of a small pool of persistent
ones per repository (~/.cache/st-test/<hash of the git common dir>/tree-N, one flock each, so no two runs share one), reset to the
commit and stripped of untracked and ignored files before every run: the same path every time keeps cargo's fingerprints and
sccache's absolute-path keys valid, so a second run is warm. Nothing is linked in from here: when the tree
has a megarepo.lock, its members are materialized under repos/ first, with the command CI's `megarepoApplyStep` runs
(`mr apply`, from the flake's effect-utils pin), because both lanes read repos/effect-utils and their dev shells no longer
create it.

evidence-wrap, evidence-sign and evidence-verify come from the accepted base, not from the change under test.
Commands that call cargo reach the build admission shim on PATH like any other cargo; nothing here knows about
admission. With --push the signed notes are pushed to REMOTE after they verify, with the identity git uses for REMOTE
(or EVIDENCE_PUSH_TOKEN if set), as refs/tags/evidence/<tree>/<record> and refs/notes/evidence/<tree>/<record> (see
evidence-wrap); whether that identity may create them is a repository rule that has not been confirmed for agent seats.
On a host that runs the evidence log (scripts/evidence-log.service installed as a systemd user unit), a run with --push then
asks it to pull at once, without waiting: a pass counts only once the log lists it, so this saves up to one pull interval.
ST_EVIDENCE_LOG_NUDGE (a JSON argv) replaces that command; asking never changes the result.

It runs `nix develop` and `pnpm install` from the tree under test, on this machine, as this user, with the host's
signing key within reach: code in that tree runs here. That is the cooperative trust of docs/st3/gate-evidence.md
("Host keys"); do not run it on a branch you would not run by hand.

Exit 0 when every selected check passed and was signed; 1 when a check failed, timed out or could not be signed; 2 when it
could not start (a refusal: dirty tree, bad argument); 3 from --status when the tree is not covered; 4 when nothing failed but a check
was not signed because the tree edits that check's lane (evidence-wrap would refuse it; CI runs it).
"""
import argparse
import fcntl
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import threading
import time

sys.dont_write_bytecode = True

# The local command of each check: exactly the argv the wrapper records and a policy's `wrapper` kind pins.
# A check without an entry cannot be signed from a checkout; it is not listed, and nothing pretends otherwise.
# In the order they run: typescript-client first, because it is signed for nearly every tree (genie-freshness is refused for every
# tree that edits its lane, and a cold genie dev shell takes minutes), so the pre-push hook's wait covers it first.
LOCAL = {
    'typescript-client': ['nix', 'develop', '.#web', '-c', 'bash', '-c',
                          'pnpm install --frozen-lockfile && bash scripts/ci-typescript-client'],
    'genie-freshness': ['nix', 'develop', '.#genie', '-c', 'bash', 'scripts/ci-genie-freshness'],
    # The stages a linux-gate skip covers (the tests, clippy and fleet compatibility), in one run, as their CI jobs run them but
    # with a home of their own (scripts/ci-local). The VM tests and the mail redelivery canaries run daily (daily-long.yml).
    'linux-gate': ['nix', 'develop', '-c', 'bash', 'scripts/ci-local', 'tests', 'clippy', 'fleet-compat'],
    # The web lane as ONE shard that covers every kit play and app test (scripts/ci-local-web); it runs only when a web input changed.
    'fractal-web': ['nix', 'develop', '.#web', '-c', 'bash', 'scripts/ci-local-web'],
    # One signature per workspace crate (docs/per-crate-test-signing.md): the recorded command is the small script that reads one crate's
    # result out of the run's JUnit report; the run itself is RUN_TESTS, for the crates that have no passing note for their key.
    'rust-tests': ['python3', 'scripts/ci-rust-test-result'],
}
RUST_TESTS = 'rust-tests'
RUST_TESTS_COMMAND = LOCAL[RUST_TESTS]
# The tests stage, run as CI runs it with the crates to test in CI_TEST_PACKAGES and the report in CI_TEST_JUNIT.
RUN_TESTS = ['nix', 'develop', '-c', 'bash', 'scripts/ci-local', 'tests']
# nextest: 0 every test passed, 100 some test failed (the report is complete either way), 4 the selection matched no test.
RUN_COMPLETED = frozenset({0, 4, 100})
# Checks that build and test the Rust workspace. Every check runs by default; these are the ones the host's capacity guard governs
# (a builds.slice scope, the kept target below), which nobody has to ask for.
BUILDS = frozenset({'linux-gate', 'fractal-web', RUST_TESTS})
# Named with --check only, temporarily: --all and the default run linux-gate, whose tests stage rust-tests splits per crate, so running
# both would test twice. It joins the default when the gate accepts per-crate notes and linux-gate stops running the tests stage
# (docs/per-crate-test-signing.md, step 5).
OPT_IN = frozenset({RUST_TESTS})
# Checks whose result depends on the base as well as the tree (clippy's ratchet): the base commit is recorded as an input.
BASE_BOUND = frozenset({'linux-gate'})  # rust-tests is not: a test's result does not depend on the base
# What the fractal-web note records about the run, as CI's aggregate note does (scripts/ci-evidence-signing): one shard, every kit
# play and app test, for a pull request. The verifier's shard-count and input-order rules read these.
WEB = 'fractal-web'
WEB_INPUTS = {'kit_shard_count': '1', 'shard_results': '0=success', 'kit_inputs': 'true', 'kit_play_set': 'all',
              'app_test_set': 'all', 'event_name': 'pull_request'}
BASE_SCRIPTS = ('evidence-wrap', 'evidence-sign', 'evidence-verify')
# The checks that build use one cargo target per pool tree (<pool>/target-N, outside the tree so the cleaning keeps it), kept between
# runs, so a run does not start cold: the tree's path is the same every run, so the workspace's own crates rebuild only when they
# changed and the dependencies and build scripts are reused. It is removed before a run once it passes TARGET_MAX_GB (the run holds
# the tree's lock, so nobody else uses it). ST_EVIDENCE_TARGET=PATH names one shared target for all trees instead (kept as before:
# trimmed only while no other run uses it); ST_EVIDENCE_TARGET=off builds in the tree itself; a CARGO_TARGET_DIR the caller set is
# left alone.
TARGET_MAX_GB = 25.0  # operations' terms for a kept target on a shared host (as the pre-sign worker had)
# The pool of persistent worktrees: ST_TEST_TREES trees (default: the host's heavy slots from ~/.config/cargo-heavy-slots, plus one)
# under ST_TEST_POOL (default ~/.cache/st-test). ST_TEST_TREES=off runs in a fresh throwaway worktree, as before.
POOL_WAIT_SECONDS = 5
POOL_SETTINGS = {}  # ST_TEST_TREES and ST_TEST_POOL as the caller set them: read before the seat scrub drops every ST_* name


class Failure(Exception):
    pass


SELECTING = ('GIT_DIR', 'GIT_WORK_TREE', 'GIT_INDEX_FILE', 'GIT_OBJECT_DIRECTORY', 'GIT_ALTERNATE_OBJECT_DIRECTORIES', 'GIT_COMMON_DIR',
                  'GIT_NAMESPACE', 'GIT_PREFIX', 'GIT_QUARANTINE_PATH', 'GIT_REPLACE_REF_BASE', 'GIT_NO_REPLACE_OBJECTS', 'GIT_GRAFT_FILE',
                  'GIT_SHALLOW_FILE', 'GIT_INTERNAL_SUPER_PREFIX', 'GIT_AUTHOR_NAME', 'GIT_AUTHOR_EMAIL', 'GIT_AUTHOR_DATE',
                  'GIT_COMMITTER_NAME', 'GIT_COMMITTER_EMAIL', 'GIT_COMMITTER_DATE')


def selecting(name):
    """A variable that names a repository or an identity: git exports them to a hook, and a check that kept them would act on the
    caller's repository. Transport and credential variables (GIT_SSH_COMMAND, GIT_ASKPASS, GIT_CONFIG_*, ...) are not here."""
    return name in SELECTING or name.startswith('GIT_PUSH_OPTION')


SEAT_PREFIXES = ('ST_', 'ST2_', 'ST3_', 'CLAUDE', 'ANTHROPIC_')
KEPT_SEAT = ('ST_AGENT', 'ST_SKIP_EVIDENCE')  # exact names, plus every ST_EVIDENCE* switch; this list is the only exception mechanism


def scrub_seat_environment():
    """A CI runner has none of the variables an agent seat carries (identity, mission, session, daemon endpoint, hook and messaging
    settings), and the checks must see what CI sees: tests that read them fail or behave differently under a seat (the ci-local-gate
    drill's claude hook tests did). ST_AGENT stays because the host ranks `nix develop` starts by it (so a check can still read it: the nix wrapper that needs it
    starts the check); the evidence switches stay. The kept list is the only exception mechanism for a future ST_* switch."""
    for name in [name for name in os.environ
                 if name.startswith(SEAT_PREFIXES) and name not in KEPT_SEAT and not name.startswith('ST_EVIDENCE')]:
        del os.environ[name]


def scrub_git_environment():
    """Drop the repository- and identity-selecting GIT_* variables (st2#3014); the notes push keeps its transport variables."""
    for name in [name for name in os.environ if selecting(name)]:
        del os.environ[name]


def git(*args, cwd=None, env=None, check=True, stdin=None):
    done = subprocess.run(['git', *args], cwd=cwd, capture_output=True, input=stdin,
                          env=dict(os.environ, **(env or {})))
    if check and done.returncode != 0:
        raise Failure(f'git {args[0]} failed: {done.stderr.decode(errors="replace").strip()[-400:]}')
    return done


def text(done):
    return done.stdout.decode().strip()


def target_commit(base):
    """The commit that is signed: HEAD, the commit being pushed.

    A pull request check is reported on the head commit, and the CI gate looks up the note for the head's own tree (see
    docs/st3/gate-evidence.md, "Which tree a pull request run asks about"), so the tree an agent built and signed is the
    tree that counts, whether or not main has moved since. The merge queue still tests the integrated tree."""
    return text(git('rev-parse', 'HEAD'))


def branch_point(commit, base):
    """Where the branch left the base (the base itself when the branch holds it): the commit whose lane definition the tree is
    held to. The CI gate judges a pull request head the same way (docs/st3/gate-evidence.md, "Which lane definition a pull request
    is held to"): a branch that only lags main changed no lane file itself. When the lane file itself changed on main since then, the
    base: the gate never uses such a head's tree (the lane file is one of the files that decide a skip).
    """
    point = text(git('merge-base', commit, base))
    lanes = [git('rev-parse', '--verify', '-q', f'{at}:.st/required-lanes.json', check=False).stdout for at in (point, base)]
    return point if lanes[0] == lanes[1] else base


def size_gb(path):
    total = 0
    for root, _, files in os.walk(path):
        for name in files:
            try:
                total += os.lstat(os.path.join(root, name)).st_blocks * 512
            except OSError:
                pass
    return total / 1e9


def trim(target):
    """Empty a target past TARGET_MAX_GB. Only a directory cargo made (it writes CACHEDIR.TAG into a target) is emptied: never one a
    caller named for something else."""
    if (target / 'CACHEDIR.TAG').is_file() and size_gb(target) > TARGET_MAX_GB:
        shutil.rmtree(target, ignore_errors=True)
        target.mkdir(parents=True, exist_ok=True)


def shared_target(tree_target=None):
    """The kept target for the checks that build and a lock held while they use it, or (None, None) when it is off or the caller set one.

    With a pool tree's own target (and no ST_EVIDENCE_TARGET), that target: the tree's lock is held, so there is nothing to lock here."""
    if os.environ.get('ST_EVIDENCE_TARGET') == 'off' or os.environ.get('CARGO_TARGET_DIR'):
        return None, None
    if tree_target and not os.environ.get('ST_EVIDENCE_TARGET'):
        tree_target.mkdir(parents=True, exist_ok=True)
        trim(tree_target)
        return tree_target, None
    target = Path(os.environ.get('ST_EVIDENCE_TARGET') or Path.home() / '.cache/st-test-target')
    target.mkdir(parents=True, exist_ok=True)
    lock = open(target.parent / f'{target.name}.lock', 'w')
    # A target several trees share is held EXCLUSIVELY for the whole run, builds and tests: cargo's own lock orders builds, but not
    # one run's builds against another run's tests, and two runs on different trees sharing one target once relinked st3 under each
    # other's tests (a test ran the other tree's st3), so a note could name a tree whose binaries were not the ones tested. A second
    # run waits for the first, and says so.
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        print(f'st-test: another run is using {target}; waiting for it (one run builds and tests in it at a time)', file=sys.stderr, flush=True)
        fcntl.flock(lock, fcntl.LOCK_EX)
    trim(target)  # nobody else is using it: the moment to keep it small
    return target, lock


def governed(argv, name):
    """`argv` (evidence-wrap and the check under it) as the host's build cap governs a check that builds: a builds.slice scope around
    everything it starts, so compiles a test runner starts without the shim (cargo-nextest, sccache) still get the slice's CPU, IO and
    memory limits, while each cargo command inside takes the host's build slots through the admission shim as any build does.

    No heavy-slot ticket is held for the whole check (`cargo --stage-slot`): the checks' tests run under the test guardian
    (scripts/st3_test_process.py), which detaches from its parents, and the shim lets a cargo command skip the queue under a held
    stage only when the stage is its ancestor. The cargo commands under the guardian then queued for the one heavy slot their own
    stage held, until the stage limit killed it (2026-10-23, on a build host). The recorded command is unchanged: only what starts
    evidence-wrap changes. A host without a user systemd bus runs it as before, and says so; ST_EVIDENCE_GOVERN=off does too."""
    if os.environ.get('ST_EVIDENCE_GOVERN') == 'off':
        return argv
    runtime = os.environ.get('XDG_RUNTIME_DIR')
    if shutil.which('systemd-run') and runtime and Path(runtime, 'bus').exists():
        return ['systemd-run', '--user', '--scope', '--quiet', '--collect', '--slice=builds.slice', '--'] + argv
    print(f'st-test: {name} runs without the host build cap (no user systemd bus for a builds.slice scope)', file=sys.stderr)
    return argv


def web_unchanged(base):
    """Why CI would not run the fractal-web lane for HEAD: no web-relevant path changed since HEAD's merge base with the accepted base,
    by the base's own scripts/ci-fractal-web-changes rules. None when one did, or when that cannot be told (then the lane runs)."""
    source = git('show', f'{base}:scripts/ci-fractal-web-changes', check=False)
    start = git('merge-base', base, 'HEAD', check=False)
    if source.returncode or start.returncode:
        return None
    diff = git('diff', '--name-only', '--no-renames', '-z', text(start), 'HEAD', check=False)
    if diff.returncode:
        return None
    with tempfile.TemporaryDirectory(prefix='st-test-') as scratch:
        path = Path(scratch) / 'ci_fractal_web_changes.py'
        path.write_bytes(source.stdout)
        try:
            loader = importlib.machinery.SourceFileLoader('ci_fractal_web_changes_for_st_test', str(path))
            module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
            loader.exec_module(module)
            changed = [name for name in diff.stdout.decode().split('\0') if name]
            relevant = module.relevant_paths(changed)
        except Exception:
            return None
    return None if relevant else f'no web input changed since {text(start)[:12]}: CI does not run the lane'


def lane_names(base):
    """The lanes the accepted base defines in .st/required-lanes.json (none when the file is absent or unreadable: then nothing changes)."""
    done = git('show', f'{base}:.st/required-lanes.json', check=False)
    if done.returncode != 0:
        return set()
    try:
        lanes = json.loads(done.stdout.decode())['lanes']
        return set(lanes) if isinstance(lanes, dict) else set()
    except (ValueError, KeyError, UnicodeDecodeError, TypeError):
        return set()


def policy_checks(base):
    """The checks the accepted base's skip policy names (none when it is absent or unreadable)."""
    done = git('show', f'{base}:.st/evidence-skip-policy.json', check=False)
    try:
        return list(json.loads(done.stdout.decode())['checks']) if done.returncode == 0 else []
    except (ValueError, KeyError, UnicodeDecodeError, TypeError):
        return []


def lane_edits(verifier_path, directory, base, check, tree):
    """The paths of `check`'s lane definition that `tree` changes relative to `base`, the branch point (empty when it changes none). evidence-wrap refuses
    to sign such a tree; asking first lets the run say so plainly, as "not signed", instead of reporting a failed check."""
    loader = importlib.machinery.SourceFileLoader('evidence_verify_for_st_test', verifier_path)
    verifier = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(verifier)
    try:
        rules = verifier.lane_rules(git('show', f'{base}:{verifier.LANES_PATH}').stdout.decode(), check)
        base_tree = text(git('rev-parse', '--verify', '--end-of-options', base + '^{tree}'))
        return verifier.lane_definition(str(directory), base_tree, tree, rules)['changed']
    except verifier.Failure:
        return []  # evidence-wrap gives the reason


def behind(base):
    """How many commits of the base this branch lacks (0 when it holds the base's tip)."""
    done = git('rev-list', '--count', f'HEAD..{base}', check=False)
    return int(text(done)) if done.returncode == 0 and text(done).isdigit() else None


def target_worktree(base, scratch):
    """(directory, commit): a clean throwaway worktree of that commit.

    Always a fresh worktree, never this checkout, so untracked or ignored files here cannot change the result, and nothing
    is linked in from here (materialize_members fills repos/ from the tree's own locks)."""
    commit = target_commit(base)
    directory = Path(scratch) / 'tree'
    git('worktree', 'add', '--detach', '-q', str(directory), commit)
    return directory, commit


def pool_size():
    """How many persistent trees the pool holds: ST_TEST_TREES, else the host's heavy slots plus one; None (off) for fresh worktrees."""
    value = POOL_SETTINGS.get('ST_TEST_TREES', '')
    if value == 'off':
        return None
    if value:
        if not value.isdigit() or int(value) < 1:
            raise Failure(f'ST_TEST_TREES={value!r} must be a positive number or "off"')
        return int(value)
    try:
        slots = int((Path.home() / '.config/cargo-heavy-slots').read_text().split()[0])
    except (OSError, ValueError, IndexError):
        slots = 1
    return max(slots, 1) + 1


def pool_root():
    """This repository's pool: one directory per git common dir, so clones and worktrees of one repository share it."""
    common = text(git('rev-parse', '--path-format=absolute', '--git-common-dir'))
    key = hashlib.sha256(os.path.realpath(common).encode()).hexdigest()[:16]
    return Path(POOL_SETTINGS.get('ST_TEST_POOL') or Path.home() / '.cache/st-test') / key


def acquire_tree(root, size):
    """(n, lock): the lowest free tree of the pool, held by an flock until the lock is closed; waits while every tree is in use."""
    root.mkdir(parents=True, exist_ok=True)
    waited = False
    while True:
        for n in range(size):
            lock = open(root / f'tree-{n}.lock', 'w')
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
                return n, lock
            except BlockingIOError:
                lock.close()
        if not waited:
            print(f'st-test: all {size} pool trees are in use; waiting for one', file=sys.stderr)
            waited = True
        time.sleep(POOL_WAIT_SECONDS)


def is_pool_tree(directory):
    """Whether `directory` is a worktree of this repository (a leftover from another clone or a broken one is replaced)."""
    done = git('rev-parse', '--path-format=absolute', '--git-common-dir', cwd=directory, check=False)
    ours = git('rev-parse', '--path-format=absolute', '--git-common-dir', check=False)
    return done.returncode == 0 and ours.returncode == 0 and os.path.realpath(text(done)) == os.path.realpath(text(ours))


def prepare_tree(root, n, commit):
    """The pool tree `n`, at `commit` with nothing untracked or ignored left in it (build output lives outside, in target-N), or a
    Failure when it is still not clean: the signature is for the committed tree."""
    directory = root / f'tree-{n}'
    if directory.exists() and not is_pool_tree(directory):
        git('worktree', 'remove', '--force', str(directory), check=False)
        shutil.rmtree(directory, ignore_errors=True)
    git('worktree', 'prune', check=False)
    if directory.exists():
        git('reset', '--hard', '-q', cwd=directory)
        git('checkout', '--detach', '-q', '-f', commit, cwd=directory)
    else:
        git('worktree', 'add', '--detach', '--force', '-q', str(directory), commit)
    if git('clean', '-ffdxq', cwd=directory, check=False).returncode != 0:
        # A check can leave read-only directories (copies of nix store paths, under .devenv/ and repos/): make them writable, once.
        subprocess.run(['chmod', '-R', 'u+rwX', '--', str(directory)], check=False, capture_output=True)
        git('clean', '-ffdxq', cwd=directory)
    dirty = text(git('status', '--porcelain', cwd=directory))
    if dirty:
        raise Failure(f'pool tree {directory} is not clean after resetting it to {commit[:12]}: {dirty.splitlines()[0]}')
    return directory


def members_command(directory):
    """CI's `megarepoApplyStep` (.github/workflows/workspace-ci.ts): `mr` from the flake's effect-utils pin. A test pins the two together."""
    rev = json.loads((directory / 'flake.lock').read_text())['nodes']['effect-utils']['locked']['rev']
    if not re.fullmatch(r'[0-9a-f]{40}', rev):
        raise ValueError(f'effect-utils rev {rev!r} is not a commit id')
    return ['nix', 'run', f'github:overengineeringstudio/effect-utils/{rev}#megarepo', '--',
            'apply', '--worktree-mode', 'commit', '--git-protocol', 'https']


def materialize_members(directory):
    """Fill repos/ from the tree's megarepo.lock, as CI does before every lane that reads it; a tree without one needs nothing.

    Returns None, or why the members could not be materialized (then no check runs and nothing is signed)."""
    if not (directory / 'megarepo.lock').is_file():
        return None
    try:
        command = members_command(directory)
    except (OSError, ValueError, KeyError, TypeError) as error:
        return f'cannot read the effect-utils pin from flake.lock: {error}'
    done = subprocess.run(command, cwd=directory, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    if done.returncode != 0:
        sys.stderr.write(done.stdout.decode(errors='replace')[-4000:])
        return f'materializing the megarepo members failed ({done.returncode})'
    return None


def reap_stale():
    """Remove worktrees an earlier st-test left when it was killed (no TERM, no cleanup): its scratch directory names its pid."""
    listing = text(git('worktree', 'list', '--porcelain', check=False))
    for block in listing.split('\n\n'):
        match = re.search(r'^worktree (\S*/st-test-[^/]+)/tree$', block, re.M)
        if not match:
            continue
        scratch = Path(match.group(1))
        try:
            os.kill(int((scratch / 'pid').read_text()), 0)
            continue  # still running
        except PermissionError:
            continue  # alive, and another user's: not ours to reap
        except (OSError, ValueError):
            pass
        git('worktree', 'remove', '--force', str(scratch / 'tree'), check=False)
        shutil.rmtree(scratch, ignore_errors=True)
    git('worktree', 'prune', check=False)


def covered(verifier, directory, tree, check, base, repository, lane_base=None, crate_key=None):
    command = [sys.executable, verifier, '--repo', str(directory), '--tree', tree, '--check', check, '--keys-from', base]
    if crate_key:
        command += ['--crate-key', crate_key]
    if repository:
        command += ['--policy-from', base, '--repository', repository]
        if lane_base and b'--lane-base' in Path(verifier).read_bytes():
            command += ['--lane-base', lane_base]
    done = subprocess.run(command, capture_output=True, text=True)
    try:
        result = json.loads(done.stdout)
    except ValueError:
        return False, 'verifier gave no answer: ' + (done.stderr.strip().splitlines() or ['-'])[-1][:120]
    if done.returncode == 0:
        return True, f'covered by {result.get("kind")} {result.get("record", "")[:12]}'
    return False, result.get('reason') or 'not covered'


LOG_UNIT = 'evidence-log.service'


def log_nudge_argv():
    """The command that asks this host's evidence log to pull now, or None when the host runs no log."""
    configured = os.environ.get('ST_EVIDENCE_LOG_NUDGE')
    if configured:
        argv = json.loads(configured)
        if not isinstance(argv, list) or not argv or not all(isinstance(a, str) for a in argv):
            raise ValueError('ST_EVIDENCE_LOG_NUDGE must be a JSON array of strings')
        return argv
    if (Path.home() / '.config/systemd/user' / LOG_UNIT).exists() and shutil.which('systemctl'):
        return ['systemctl', '--user', 'start', '--no-block', LOG_UNIT]
    return None


def nudge_log():
    """One line for the summary, or None when there is no log to ask. Best effort: the pull's own timer runs anyway."""
    try:
        argv = log_nudge_argv()
    except ValueError as error:
        return f'evidence log: not asked ({error})'
    if argv is None:
        return None
    try:
        done = subprocess.run(argv, stdin=subprocess.DEVNULL, capture_output=True, timeout=15)
    except (OSError, subprocess.TimeoutExpired) as error:
        return f'evidence log: could not ask it to pull now ({error}); its timer will'
    if done.returncode != 0:
        return f'evidence log: asking it to pull now failed ({done.stderr.decode(errors="replace").strip()[-200:]}); its timer will'
    return 'evidence log: asked this host\'s log to pull now'


def repository_of(remote):
    url = text(git('remote', 'get-url', remote, check=False))
    for prefix in ('https://github.com/', 'git@github.com:', 'ssh://git@github.com/'):
        if url.startswith(prefix):
            return url[len(prefix):].removesuffix('.git').strip('/')
    return None


RUST_TEST_KEYS = 'scripts/rust-test-keys'
RUST_TEST_INPUTS = '.st/rust-test-inputs.json'


def only_crates(keys, names):
    """(keys narrowed to `names`, or None and why a name is not a workspace crate of this tree)."""
    unknown = [name for name in names if name not in keys]
    if unknown:
        return None, f'not a workspace crate of this tree: {", ".join(unknown)}'
    return ({name: keys[name] for name in names} if names else keys), None


def judged_by_policy(base):
    """Whether the accepted base's skip policy names rust-tests; until it does (docs/per-crate-test-signing.md, step 3) a note counts by its
    signature, crate and key alone, which is all this machine's own skip decision needs."""
    return 'rust-tests' in policy_checks(base)


def crate_keys(base, directory, tree, scratch):
    """{crate: key} for `tree`, from the accepted base's scripts/rust-test-keys and inputs file (a verifier must use the base's). Only
    while the base's policy does not name rust-tests, so nothing judges a note yet, are the tree's own used: the change that introduces them
    is judged by itself. Once the base's policy names it, a base without them is an error, never a fallback. Returns (keys, error)."""
    tool = Path(scratch) / 'rust-test-keys'
    shown = git('show', f'{base}:{RUST_TEST_KEYS}', check=False)
    inputs_at = base
    if shown.returncode == 0 and git('cat-file', '-e', f'{base}:{RUST_TEST_INPUTS}', check=False).returncode == 0:
        tool.write_bytes(shown.stdout)
    elif judged_by_policy(base):
        return None, f'the accepted base judges rust-tests but has no {RUST_TEST_KEYS} and {RUST_TEST_INPUTS}: only the base\'s tool and inputs may key a note'
    else:
        tool.write_bytes((Path(directory) / RUST_TEST_KEYS).read_bytes())
        inputs_at = tree
    verifier = Path(scratch) / 'evidence-verify'
    verifier.write_bytes(git('show', f'{base}:scripts/evidence-verify').stdout)
    done = subprocess.run([sys.executable, str(tool), '--repo', str(directory), '--tree', tree, '--inputs-from', inputs_at,
                           '--verifier', str(verifier), '--json'], capture_output=True, text=True)
    if done.returncode != 0:
        return None, done.stderr.strip()[-300:] or 'rust-test-keys failed'
    return json.loads(done.stdout), None


def fetch_crate_notes(remote, keys):
    """The per-crate records indexed under these keys, from the remote in one fetch (best effort: a remote without them is no error)."""
    if not remote:
        return
    refspecs = []
    for key in keys.values():
        if key:
            refspecs += [f'+refs/notes/evidence-input/rust-tests/{key}/*:refs/notes/evidence-input/rust-tests/{key}/*',
                         f'+refs/tags/evidence/input/rust-tests/{key}/*:refs/tags/evidence/input/rust-tests/{key}/*']
    for start in range(0, len(refspecs), 200):
        git('fetch', '-q', '--no-tags', remote, *refspecs[start:start + 200], check=False)


def uncovered_crates(verifier, directory, tree, base, repository, lane_base, keys):
    """[(crate, reason)] for the crates with no passing note for their key, and the number of covered ones."""
    missing, have = [], 0
    for crate, key in sorted(keys.items()):
        if not key:
            missing.append((crate, 'no declared path exists in this tree'))
            continue
        ok, why = covered(verifier, directory, tree, 'rust-tests', base, repository, lane_base, crate_key=f'{crate}={key}')
        if ok:
            have += 1
        else:
            missing.append((crate, why))
    return missing, have


def run_rust_tests(args, directory, tools, scratch, tree, commit, base_commit, lane_base, repository, signer, lanes, target):
    """The `rust-tests` check: one nextest run of the crates that have no passing note for their key, on the workspace build CI makes,
    then one signature per crate over that crate's part of the run. Returns the summary rows."""
    keys, error = crate_keys(args.base, directory, tree, scratch)
    if not error:
        keys, error = only_crates(keys, args.crate)
    if error:
        return [('rust-tests', 'NOT RUN', 0, f'cannot compute the per-crate keys: {error}')], True
    fetch_crate_notes(args.push or 'origin', keys)
    missing, have = uncovered_crates(tools['evidence-verify'], directory, tree, args.base, repository if judged_by_policy(args.base) else None,
                                     lane_base, keys)
    if not missing:
        return [('rust-tests', 'covered', 0, f'all {len(keys)} crates already have a passing note for their key')], False
    selected = [crate for crate, _ in missing]
    junit = Path(scratch) / 'nextest-junit.xml'
    environment = dict(os.environ, CI_TEST_PACKAGES=','.join(selected), CI_TEST_JUNIT=str(junit))
    if target:
        environment['CARGO_TARGET_DIR'] = str(target)
    started = time.monotonic()
    try:
        done = subprocess.run(governed(RUN_TESTS, 'rust-tests'), cwd=directory, timeout=args.time_limit, env=environment)
        code = done.returncode
    except subprocess.TimeoutExpired:
        code = 124
    ran_seconds = round(time.monotonic() - started)
    if code not in RUN_COMPLETED or not junit.exists():
        return [('rust-tests', 'timed out' if code == 124 else 'NOT SIGNED', ran_seconds,
                 f'the run did not complete (exit {code}{"" if junit.exists() else ", no report"}): no crate was signed')], True
    # Exactly the expression scripts/ci-linux builds from CI_TEST_PACKAGES: the record says which crates the run was filtered to.
    filterset = ' or '.join(f'package(={crate})' for crate in selected)
    run_sha = hashlib.sha256(json.dumps([RUN_TESTS, selected]).encode()).hexdigest()
    rows, failed, signed_count, empty = [], False, 0, []
    for crate in selected:
        facts = json.loads(subprocess.run([sys.executable, str(directory / 'scripts/ci-rust-test-result'), '--summary'], capture_output=True,
                                          text=True, env=dict(os.environ, RUST_TEST_JUNIT=str(junit), RUST_TEST_CRATE=crate)).stdout or 'null')
        if not facts:
            rows.append((f'rust-tests:{crate}', 'NOT SIGNED', 0, 'cannot read its result from the report'))
            failed = True
            continue
        wrap = [sys.executable, tools['evidence-wrap'], '--check', 'rust-tests', '--attempt', args.attempt,
                '--signer', signer, '--verifier', tools['evidence-verify'], '--keys-from', args.base,
                '--input', f'crate={crate}', '--input', f'source_inputs={keys[crate]}', '--input', f'tests_run={facts["tests_run"]}',
                '--input', f'tests_ignored={facts["tests_ignored"]}', '--input', f'test_list_sha256={facts["test_list_sha256"]}',
                '--input', f'ignored_list_sha256={facts["ignored_list_sha256"]}',
                '--input', f'filterset={filterset}', '--input', f'run_command_sha256={run_sha}']
        if RUST_TESTS in lanes:
            wrap += ['--lanes-from', lane_base]
        if args.toolchain_sha256:
            wrap += ['--toolchain-sha256', args.toolchain_sha256]
        if args.push:
            wrap += ['--push', args.push]
        started = time.monotonic()
        signed = subprocess.run(wrap + ['--'] + RUST_TESTS_COMMAND, cwd=directory, env=dict(os.environ, RUST_TEST_JUNIT=str(junit), RUST_TEST_CRATE=crate),
                                stdout=subprocess.DEVNULL, stderr=subprocess.PIPE, text=True)
        ok = signed.returncode == 0
        failed = failed or not ok
        if ok:
            signed_count += 1
            if not int(facts['tests_run']):
                empty.append(crate)
        else:
            detail = (signed.stderr.strip().splitlines() or ['failed'])[-1][:160]
            rows.append((f'rust-tests:{crate}', f'FAILED ({signed.returncode})', round(time.monotonic() - started), detail))
    detail = f'{signed_count} of {len(selected)} crates run and signed ({have} of {len(keys)} already had a passing note); one nextest run on the workspace build'
    if empty:
        # A note that ran no test covers nothing once a policy judges it: the crate belongs under no_tests in .st/rust-test-inputs.json (reviewed).
        detail += f'; {len(empty)} ran no test (list under no_tests if they have none): {", ".join(empty[:8])}' + (' ...' if len(empty) > 8 else '')
    rows.insert(0, ('rust-tests', 'passed' if not failed else 'FAILED', ran_seconds, detail))
    return rows, failed


def main(argv):
    POOL_SETTINGS.clear()
    POOL_SETTINGS.update({name: os.environ[name] for name in ('ST_TEST_TREES', 'ST_TEST_POOL') if name in os.environ})
    scrub_git_environment()
    scrub_seat_environment()
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('--check', action='append', default=[], metavar='NAME', help='only this check (repeatable)')
    parser.add_argument('--base', default='origin/main', help='the accepted base (default origin/main)')
    parser.add_argument('--push', metavar='REMOTE', help='push the signed notes here after they verify')
    parser.add_argument('--repository', metavar='OWNER/NAME', help='default: from the remote\'s GitHub URL; without it the policy is not applied')
    parser.add_argument('--crate', action='append', default=[], metavar='NAME', help='with --check rust-tests: only these crates (repeatable)')
    parser.add_argument('--attempt', default='1')
    parser.add_argument('--time-limit', type=int, default=7200, help='seconds per check (default 7200)')
    parser.add_argument('--list', action='store_true', help='print the checks and their commands and stop')
    parser.add_argument('--all', action='store_true', help='accepted, and the same as no flag: every check runs')
    parser.add_argument('--status', action='store_true', help='run nothing: say whether each check is already covered for this tree (a lane edit, '
                        'and with no --check a policy check that has no local command, count as covered: CI runs them); exit 0 if all are, 3 if not')
    parser.add_argument('--toolchain-sha256', help='passed to evidence-wrap: skip the nix evaluation, record this digest')
    args = parser.parse_args(argv)
    if not re.fullmatch(r'[A-Za-z0-9_][A-Za-z0-9._/-]*', args.base):
        raise Failure(f'--base {args.base!r} must be a branch or ref name (it may not start with "-")')
    unknown = [name for name in args.check if name not in LOCAL]
    if unknown:
        raise Failure(f'no local command for {", ".join(unknown)}; known: {", ".join(LOCAL)}')
    checks = args.check or [name for name in LOCAL if name not in OPT_IN]
    if args.list:
        for name in checks:
            print(f'{name}: {" ".join(LOCAL[name])}')
        return 0

    remote, _, branch = args.base.partition('/')
    if branch:
        git('fetch', '-q', remote, branch)  # the base moves; the lag and the policy are read at its current tip
    base_commit = text(git('rev-parse', '--verify', '-q', args.base + '^{commit}'))
    if args.status:
        commit = target_commit(args.base)
        tree = text(git('rev-parse', f'{commit}^{{tree}}'))
        lane_base = branch_point(commit, base_commit)
        with tempfile.TemporaryDirectory(prefix='st-test-') as scratch:
            verifier = Path(scratch) / 'evidence-verify'
            verifier.write_bytes(git('show', f'{args.base}:scripts/evidence-verify').stdout)
            repository = args.repository or repository_of(remote or 'origin')
            lanes, rows = lane_names(args.base), []
            for name in checks:
                # A tree that edits a check's lane cannot be signed here (evidence-wrap refuses it): CI runs that check.
                edits = lane_edits(str(verifier), Path('.'), lane_base, name, tree) if name in lanes else []
                unchanged = web_unchanged(args.base) if name == WEB else None
                if edits:
                    rows.append((name, True, 'lane edit: CI runs it', f'this tree edits its lane ({", ".join(edits[:3])})'))
                elif name == RUST_TESTS:
                    keys, error = crate_keys(args.base, Path('.'), tree, scratch)
                    if not error:
                        keys, error = only_crates(keys, args.crate)
                    if error:
                        rows.append((name, False, 'not covered', f'cannot compute the per-crate keys: {error}'))
                    else:
                        fetch_crate_notes(args.push or 'origin', keys)
                        missing, have = uncovered_crates(str(verifier), Path('.'), tree, args.base,
                                                         repository if judged_by_policy(args.base) else None, lane_base, keys)
                        rows.append((name, not missing, 'covered' if not missing else f'{len(missing)} crates to run',
                                     f'{have} of {len(keys)} crates covered' + (f'; to run: {", ".join(c for c, _ in missing[:6])}'
                                                                                 + (' ...' if len(missing) > 6 else '') if missing else '')))
                elif unchanged:
                    rows.append((name, True, 'not relevant', unchanged))
                else:
                    is_covered, why = covered(str(verifier), Path('.'), tree, name, args.base, repository, lane_base)
                    rows.append((name, is_covered, 'covered' if is_covered else 'not covered', why))
            if not args.check:
                # Every check of the skip policy: one without a local command cannot be signed here, so CI runs it.
                rows += [(name, True, 'CI runs it', 'no local command') for name in policy_checks(args.base) if name not in LOCAL]
        for name, is_covered, label, why in rows:
            print(f'  {name:<24} {label:<22} {why}')
        return 0 if all(row[1] for row in rows) else 3
    status = git('status', '--porcelain', '--untracked-files=no').stdout.decode().strip()
    if status:
        raise Failure('the checkout has uncommitted changes to tracked files; commit them first, the note is for the committed tree')
    reap_stale()
    with tempfile.TemporaryDirectory(prefix='st-test-') as scratch:
        os.chmod(scratch, 0o700)
        (Path(scratch) / 'pid').write_text(str(os.getpid()))
        tools = {}
        for name in BASE_SCRIPTS:
            path = Path(scratch) / name
            path.write_bytes(git('show', f'{args.base}:scripts/{name}').stdout)
            path.chmod(0o700)
            tools[name] = str(path)
        directory = Path(scratch) / 'tree'
        pool_trees, tree_lock, tree_target = pool_size(), None, None
        try:
            if pool_trees:
                commit, root = target_commit(args.base), pool_root()
                n, tree_lock = acquire_tree(root, pool_trees)
                directory, tree_target = prepare_tree(root, n, commit), root / f'target-{n}'
            else:
                directory, commit = target_worktree(args.base, scratch)
            lag = behind(args.base)
            tree = text(git('rev-parse', f'{commit}^{{tree}}', cwd=directory))
            lane_base = branch_point(commit, base_commit)
            repository = args.repository or repository_of(remote or 'origin')
            # -I: the signer's interpreter reads no PYTHON* variable, user site or current directory (evidence-wrap also drops them).
            signer = os.environ.get('EVIDENCE_SIGNER') or json.dumps([sys.executable, '-I', tools['evidence-sign']])
            rows, failed, unsigned = [], False, False
            lanes = lane_names(args.base)
            target, target_lock = shared_target(tree_target) if any(name in BUILDS for name in checks) else (None, None)
            unmaterialized = materialize_members(directory)
            def run_one(name, output=None):
                """(row, failed, unsigned) for one check; its output goes to `output` (a file) when given, else to this terminal."""
                if unmaterialized:
                    return (name, 'NOT RUN', 0, unmaterialized), True, False
                edits = lane_edits(tools['evidence-verify'], directory, lane_base, name, tree) if name in lanes else []
                if edits:
                    return (name, 'not signed', 0, f'this tree edits its lane ({", ".join(edits[:3])}); CI runs it'), False, True
                if name == RUST_TESTS:
                    # One run, one row for the run and one for each crate that did not sign (a list: the collector below takes either).
                    new_rows, bad = run_rust_tests(args, directory, tools, scratch, tree, commit, base_commit, lane_base, repository, signer, lanes,
                                                   target)
                    return new_rows, bad, False
                unchanged = web_unchanged(args.base) if name == WEB else None
                if unchanged:
                    return (name, 'not relevant', 0, unchanged), False, False  # nothing to run, nothing to sign: not a failure
                wrap = [sys.executable, tools['evidence-wrap'], '--check', name, '--attempt', args.attempt,
                        '--signer', signer, '--verifier', tools['evidence-verify'], '--keys-from', args.base]
                if name in lanes:
                    # The branch point defines this lane: the note carries the digest of its definition, and a tree that edits the lane is not
                    # signed. It is the base itself when the branch holds the base's tip.
                    wrap += ['--lanes-from', lane_base]
                if args.toolchain_sha256:
                    wrap += ['--toolchain-sha256', args.toolchain_sha256]
                if args.push:
                    wrap += ['--push', args.push]
                environment = dict(os.environ, CARGO_TARGET_DIR=str(target)) if target and name in BUILDS else None
                if name in BASE_BOUND:
                    # clippy's ratchet compares with the base, as CI compares with the event's base: the base as just fetched,
                    # given to the stage and recorded in the note, so the base it was measured against is part of what is signed.
                    wrap += ['--input', f'clippy_base_sha={base_commit}']
                    environment = dict(environment or os.environ, CLIPPY_BASE_SHA=base_commit)
                if name == WEB:
                    wrap += [argument for key, value in WEB_INPUTS.items() for argument in ('--input', f'{key}={value}')]
                started = time.monotonic()
                try:
                    command = wrap + ['--'] + LOCAL[name]
                    done = subprocess.run(governed(command, name) if name in BUILDS else command, cwd=directory, timeout=args.time_limit,
                                          env=environment, stdout=output, stderr=subprocess.STDOUT if output else None)
                    code = done.returncode
                except subprocess.TimeoutExpired:
                    code = 124
                seconds = round(time.monotonic() - started)
                ok = code == 0
                is_covered, why = covered(tools['evidence-verify'], directory, tree, name, args.base, repository, lane_base)
                return (name, 'passed' if ok else ('timed out' if code == 124 else f'FAILED ({code})'), seconds, why), not ok, False

            # The light checks run alongside the ones that build, one after another in a lane of their own, as CI runs them on runners of
            # their own: they wait on network, Nix and Node rather than the Rust build, and run after it they added minutes to every
            # run. Their output is kept and printed in order once the build lane is done, so the two never interleave. ST_EVIDENCE_SERIAL=1
            # runs every check one after another, as before.
            builds = [name for name in checks if name in BUILDS]
            light = [name for name in checks if name not in BUILDS]
            results = {}
            if builds and light and os.environ.get('ST_EVIDENCE_SERIAL') != '1':
                logs = {name: Path(scratch) / f'{name}.log' for name in light}

                def light_lane():
                    for name in light:
                        with open(logs[name], 'w') as output:
                            try:
                                results[name] = run_one(name, output)
                            except Exception as error:  # a lane that dies is a failed check, never a silent pass
                                results[name] = ((name, f'FAILED ({type(error).__name__})', 0, str(error)[:120]), True, False)

                lane = threading.Thread(target=light_lane, name='st-test-light')
                print(f'st-test: {", ".join(light)} run alongside {", ".join(builds)}; their output follows when it is done', flush=True)
                lane.start()
                for name in builds:
                    results[name] = run_one(name)
                lane.join()
                for name in light:
                    print(f'\n----- st-test: {name} output -----', flush=True)
                    sys.stdout.write(logs[name].read_text(errors='replace') if logs[name].exists() else '(no output)\n')
                    sys.stdout.flush()
            else:
                for name in checks:
                    results[name] = run_one(name)
            for name in checks:
                row, check_failed, check_unsigned = results[name]
                rows += row if isinstance(row, list) else [row]
                failed = failed or check_failed
                unsigned = unsigned or check_unsigned
            print(f'\nst-test: tree {tree[:12]} (HEAD{f", {lag} commit(s) behind {args.base}: the queue tests the merge" if lag else ""}), in a clean worktree')
            for name, result, seconds, why in rows:
                print(f'  {name:<20} {result:<12} {seconds:>6}s  {why}')
            if args.push and any(result != 'NOT RUN' for _, result, _, _ in rows):
                line = nudge_log()
                if line:
                    print(f'  {line}')
            return 1 if failed else (4 if unsigned else 0)
        finally:
            if not pool_trees and directory.exists():
                git('worktree', 'remove', '--force', str(directory), check=False)
            if tree_lock:
                tree_lock.close()


if __name__ == '__main__':
    # TERM (the pre-push hook's timeout, a closed terminal) unwinds like an error so the throwaway worktree is removed.
    signal.signal(signal.SIGTERM, lambda signum, frame: sys.exit(143))
    try:
        sys.exit(main(sys.argv[1:]))
    except Failure as error:
        print(f'st-test: {error}', file=sys.stderr)
        sys.exit(2)
