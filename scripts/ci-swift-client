#!/usr/bin/env bash
set -euo pipefail
: "${SWIFT_IMAGE:?set SWIFT_IMAGE to the pinned official Swift image}"
# Keep fixture paths relative to the checkout while all compiler output stays in tmpfs.
docker run --rm --cpus 4 --memory 4g --read-only \
  --tmpfs /tmp:rw,exec,size=2g \
  --env HOME=/tmp --env CLANG_MODULE_CACHE_PATH=/tmp/clang-cache \
  --mount "type=bind,src=$PWD,dst=/repo,readonly" --workdir /repo \
  "$SWIFT_IMAGE" bash -c 'swift --version && swift test \
    --package-path /repo/clients/swift/FractalClient \
    --scratch-path /tmp/swift-build --cache-path /tmp/swift-cache \
    --config-path /tmp/swift-config --security-path /tmp/swift-security --jobs 4'
