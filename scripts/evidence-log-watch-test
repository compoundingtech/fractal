#!/usr/bin/env python3
"""scripts/evidence-log-watch against a real remote: a current log is quiet, a stalled one alerts once, again after --repeat while it lasts,
and once when it moves again; a head that cannot be read alerts only after --max-age; a failed notification is sent again on the next run."""
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest

os.environ.update(GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_NOSYSTEM='1')
sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
WATCH = ROOT / 'scripts/evidence-log-watch'
loader = importlib.machinery.SourceFileLoader('evidence_log_watch', str(WATCH))
watch = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(watch)
T0 = 1_800_000_000


class Watch(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        self.root = Path(self.tmp.name)
        self.remote = self.root / 'remote.git'
        subprocess.run(['git', 'init', '-q', '--bare', str(self.remote)], check=True)
        self.sent = self.root / 'sent.txt'
        self.notify = [sys.executable, '-c', 'import sys; open(sys.argv[1], "a").write(sys.argv[2] + "\\n")', str(self.sent)]

    def publish(self, as_of):
        """A log head on the remote whose subject names `as_of`, as each pull commits it."""
        env = dict(os.environ, GIT_AUTHOR_NAME='l', GIT_AUTHOR_EMAIL='l@x', GIT_COMMITTER_NAME='l', GIT_COMMITTER_EMAIL='l@x')
        tree = subprocess.run(['git', '-C', str(self.remote), 'mktree'], input=b'', capture_output=True, check=True).stdout.decode().strip()
        subject = f'evidence-log v1 as_of={watch.iso(as_of).replace("Z", "+00:00")} added=0 gc=0 missing=0'
        commit = subprocess.run(['git', '-C', str(self.remote), 'commit-tree', tree, '-m', subject], capture_output=True, env=env,
                                check=True).stdout.decode().strip()
        subprocess.run(['git', '-C', str(self.remote), 'update-ref', watch.LOG, commit], check=True)

    def run_watch(self, now, notify=None):
        done = subprocess.run([sys.executable, str(WATCH), '--remote', str(self.remote), '--state', str(self.root / 'state'),
                               '--notify', json.dumps(notify or self.notify), '--now', str(now), '--repeat', '3600'],
                              capture_output=True, text=True)
        return done.returncode, json.loads(done.stdout.strip().splitlines()[-1])

    def lines(self):
        return self.sent.read_text().splitlines() if self.sent.exists() else []

    def test_a_current_log_is_quiet_a_stall_alerts_once_then_hourly_and_the_recovery_once(self):
        self.publish(T0)
        self.assertEqual(self.run_watch(T0 + 130)[0], 0)
        self.assertEqual(self.lines(), [])
        code, result = self.run_watch(T0 + 400)                                # three pulls missed
        self.assertEqual((code, result['stalled'], result['notified']), (1, True, True))
        self.assertEqual(len(self.lines()), 1)
        self.assertIn('evidence log STALLED', self.lines()[0])
        self.assertIn('400s old', self.lines()[0])
        self.assertEqual(self.run_watch(T0 + 520)[0], 1)
        self.assertEqual(len(self.lines()), 1, 'once per stall, not every run')
        self.assertEqual(self.run_watch(T0 + 400 + 3600)[0], 1)
        self.assertEqual(len(self.lines()), 2)
        self.assertIn('still stalled since', self.lines()[1])
        self.publish(T0 + 4100)
        self.assertEqual(self.run_watch(T0 + 4120)[0], 0)
        self.assertEqual(len(self.lines()), 3)
        self.assertIn('evidence log moving again', self.lines()[2])
        self.assertEqual(self.run_watch(T0 + 4240)[0], 0)
        self.assertEqual(len(self.lines()), 3)

    def test_a_head_that_cannot_be_read_alerts_only_after_max_age(self):
        code, result = self.run_watch(T0)                                      # no log ref on the remote yet
        self.assertEqual((code, result['stalled']), (0, False))
        self.assertIn('fetch of the log head failed', result['problem'])
        self.assertEqual(self.run_watch(T0 + 300)[0], 0)
        self.assertEqual(self.lines(), [])
        self.assertEqual(self.run_watch(T0 + 400)[0], 1)
        self.assertIn('cannot be read for 400s', self.lines()[0])

    def test_a_failed_notification_is_sent_again_on_the_next_run(self):
        self.publish(T0)
        failing = [sys.executable, '-c', 'import sys; sys.exit(1)']
        self.assertEqual(self.run_watch(T0 + 400, notify=failing)[0], 3)
        self.assertEqual(self.run_watch(T0 + 520)[0], 1)
        self.assertEqual(len(self.lines()), 1)
        self.assertIn('evidence log STALLED', self.lines()[0])

    def test_step_is_pure_and_an_unreadable_head_keeps_counting_from_when_it_first_was(self):
        state, line, stalled = watch.step({}, T0, None, 'no ref', 360, 3600)
        self.assertEqual((line, stalled, state['unreadable_since']), (None, False, T0))
        state, line, stalled = watch.step(state, T0 + 361, None, 'no ref', 360, 3600)
        self.assertTrue(stalled)
        self.assertIn('cannot be read for 361s: no ref', line)

    def test_a_bad_notify_argv_is_a_usage_error(self):
        done = subprocess.run([sys.executable, str(WATCH), '--remote', str(self.remote), '--state', str(self.root / 's'), '--notify', '"x"'],
                              capture_output=True, text=True)
        self.assertEqual(done.returncode, 2)


if __name__ == '__main__':
    unittest.main()
