#!/usr/bin/env python3
"""scripts/evidence-presign-worker: which heads it signs (ready, ours, not forks, newest first, one per tick), what it never repeats,
and when load keeps it from starting or stops it. gh, st-test and the host's pressure files are stand-ins; nothing is signed."""
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import time
import unittest

ROOT = Path(__file__).resolve().parent.parent
WORKER = ROOT / 'scripts/evidence-presign-worker'
CLEAN = dict(PATH=os.environ['PATH'], GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_SYSTEM='/dev/null',
             GIT_AUTHOR_NAME='t', GIT_AUTHOR_EMAIL='t@example.invalid', GIT_COMMITTER_NAME='t', GIT_COMMITTER_EMAIL='t@example.invalid')
# The base's st-test, as the worker reads it from origin/main: --list, --status and a run, each recorded.
STUB = '''#!/usr/bin/env python3
import json, os, subprocess, sys, time
argv = sys.argv[1:]
head = subprocess.run(['git', 'rev-parse', 'HEAD'], capture_output=True, text=True).stdout.strip()
checks = [argv[i + 1] for i, a in enumerate(argv) if a == '--check']
if '--list' in argv:
    for name in ['typescript-client', 'genie-freshness'] + (['linux-gate', 'mail-redelivery-canaries'] if '--all' in argv else []):
        print(f'{name}: command')
    sys.exit(0)
covered = json.loads(os.environ.get('STUB_COVERED', '{}')).get(head, [])
if '--status' in argv:
    for name in checks:
        print(f'  {name:<20} {"covered" if name in covered else "not covered":<12} why')
    sys.exit(0 if all(name in covered for name in checks) else 3)
with open(os.environ['STUB_LOG'], 'a') as log:
    log.write(json.dumps({'head': head, 'argv': argv, 'tmpdir': os.environ.get('TMPDIR'),
                          'target': os.environ.get('CARGO_TARGET_DIR')}) + '\\n')
time.sleep(float(os.environ.get('STUB_SLEEP', '0')))
if os.environ.get('STUB_LEFTOVER'):
    # A test's stray background process, still in the run's process group when st-test exits.
    stray = subprocess.Popen(['sleep', '60'])
    open(os.environ['STUB_LEFTOVER'], 'w').write(str(stray.pid))
results = json.loads(os.environ.get('STUB_RESULTS', '{}'))
# What a pull request's own test output could print: rows shaped like st-test's, before its summary.
for name in checks:
    print(f'  {name:<20} {"passed":<12} {1:>6}s  printed by a test')
print()
print('st-test: tree 0123456789ab (HEAD), in a clean worktree')
for name in checks:
    print(f'  {name:<20} {results.get(name, "passed"):<12} {12:>6}s  why')
sys.exit(0)
'''


def git(repo, *args):
    done = subprocess.run(['git', '-C', str(repo), *args], capture_output=True, text=True, env=CLEAN)
    assert done.returncode == 0, (args, done.stderr)
    return done.stdout.strip()


class Worker(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        tmp = Path(self.tmp.name)
        self.origin = tmp / 'origin.git'
        git(tmp, 'init', '-q', '--bare', '-b', 'main', str(self.origin))
        self.work = tmp / 'work'
        git(tmp, 'clone', '-q', str(self.origin), str(self.work))
        git(self.work, 'checkout', '-q', '-b', 'main')
        (self.work / 'scripts').mkdir()
        (self.work / 'scripts/st-test').write_text(STUB)
        git(self.work, 'add', '.')
        git(self.work, 'commit', '-q', '-m', 'base')
        git(self.work, 'push', '-q', 'origin', 'main')
        self.config, self.state = tmp / 'config', tmp / 'state'
        self.config.mkdir()
        (self.config / 'authors').write_text('# our own account\nours\n')
        (self.config / 'limits.json').write_text(json.dumps({'calm_seconds': 0, 'calm_wait': 3, 'sample': 1, 'min_free_gib': 0}))
        self.pressure, self.meminfo = tmp / 'pressure', tmp / 'meminfo'
        self.set_pressure(2.0)
        self.meminfo.write_text('MemTotal: 67108864 kB\nMemAvailable: 50331648 kB\n')
        self.admission = tmp / 'build-admission'
        self.admission.write_text('#!/bin/sh\necho \'{"active": 0}\'\n')
        self.admission.chmod(0o755)
        self.gh_answer = tmp / 'prs.json'
        self.gh = tmp / 'gh'
        self.gh.write_text(f'#!/bin/sh\ncat {self.gh_answer}\n')
        self.gh.chmod(0o755)
        self.log = tmp / 'stub.log'
        self.prs = []
        self.covered = {}
        self.target = tmp / 'cache' / 'evidence-presign-target'

    def set_pressure(self, avg60):
        self.pressure.write_text(f'some avg10=0.00 avg60={avg60:.2f} avg300=0.00 total=0\nfull avg10=0.00 avg60=0.00 avg300=0.00 total=0\n')

    def pr(self, number, author='ours', draft=False, base='main', fork=False, updated='2026-10-22T10:00:00Z', head=None):
        """A pull request whose head is a new commit on refs/pull/N/head of the remote."""
        git(self.work, 'checkout', '-q', '--detach', 'main')
        (self.work / f'pr{number}.txt').write_text(f'{number} {time.monotonic()}')
        git(self.work, 'add', '.')
        git(self.work, 'commit', '-q', '-m', f'pr {number}')
        sha = git(self.work, 'rev-parse', 'HEAD')
        git(self.work, 'push', '-q', '--force', 'origin', f'HEAD:refs/pull/{number}/head')
        self.prs.append({'number': number, 'isDraft': draft, 'headRefOid': head or sha, 'baseRefName': base, 'updatedAt': updated,
                         'author': {'login': author}, 'headRepository': {'nameWithOwner': 'someone/fork' if fork else 'example/repo'}})
        return sha

    def tick(self, kind='light', *extra, **env):
        self.gh_answer.write_text(json.dumps({'data': {'repository': {'pullRequests': {'nodes': self.prs}}}}))
        environment = dict(CLEAN, HOME=self.tmp.name, EVIDENCE_PRESIGN_CONFIG=str(self.config), EVIDENCE_PRESIGN_STATE=str(self.state),
                           EVIDENCE_PRESIGN_GH=str(self.gh), EVIDENCE_PRESIGN_REMOTE=str(self.origin),
                           EVIDENCE_PRESIGN_PRESSURE=str(self.pressure), EVIDENCE_PRESIGN_MEMINFO=str(self.meminfo),
                           EVIDENCE_PRESIGN_ADMISSION=str(self.admission), STUB_LOG=str(self.log),
                           EVIDENCE_PRESIGN_TARGET=str(self.target), STUB_COVERED=json.dumps(self.covered), **env)
        return subprocess.run([sys.executable, str(WORKER), 'tick', '--class', kind, '--repo', str(self.state / 'repo'),
                               '--repository', 'example/repo', *extra], capture_output=True, text=True, env=environment, timeout=120)

    def runs(self):
        return [json.loads(line) for line in self.log.read_text().splitlines()] if self.log.exists() else []

    def attempts(self):
        path = self.state / 'attempts.jsonl'
        return [json.loads(line) for line in path.read_text().splitlines()] if path.exists() else []

    def checks_of(self, run):
        return [run['argv'][i + 1] for i, a in enumerate(run['argv']) if a == '--check']

    def test_without_an_author_list_it_refuses_to_run_anything(self):
        self.pr(1)
        for content in (None, '# nobody\n\n'):
            with self.subTest(content):
                if content is None:
                    (self.config / 'authors').unlink()
                else:
                    (self.config / 'authors').write_text(content)
                done = self.tick()
                self.assertEqual(done.returncode, 2, done.stderr)
                self.assertIn("refusing to run anyone's code", done.stderr)
                self.assertEqual(self.runs(), [])

    def test_the_off_switch_stops_a_tick_before_it_does_anything(self):
        self.pr(1)
        (self.config / 'off').write_text('')
        done = self.tick()
        self.assertEqual((done.returncode, self.runs()), (0, []), done.stderr)
        self.assertFalse((self.state / 'repo').exists())

    def test_it_signs_the_newest_ready_head_of_our_own_authors_only_one_per_tick(self):
        older = self.pr(1, updated='2026-10-22T09:00:00Z')
        self.pr(2, draft=True, updated='2026-10-22T12:00:00Z')
        self.pr(3, author='outsider', updated='2026-10-22T12:00:00Z')
        self.pr(4, fork=True, updated='2026-10-22T12:00:00Z')
        self.pr(5, base='release', updated='2026-10-22T12:00:00Z')
        newer = self.pr(6, updated='2026-10-22T11:00:00Z')
        done = self.tick()
        self.assertEqual(done.returncode, 0, done.stderr)
        run, = self.runs()
        self.assertEqual(run['head'], newer)
        self.assertEqual(self.checks_of(run), ['typescript-client', 'genie-freshness'])
        self.assertEqual(run['argv'][:4], ['--base', 'origin/main', '--push', 'origin'])
        attempt, = self.attempts()
        self.assertEqual((attempt['pr'], attempt['outcome'], attempt['class']), (6, 'worker_signed', 'light'))
        self.assertEqual(attempt['checks'], {'typescript-client': 'passed', 'genie-freshness': 'passed'})
        self.assertEqual(self.tick().returncode, 0)  # the next tick takes the next head, never the same tree again
        self.assertEqual([r['head'] for r in self.runs()], [newer, older])
        self.assertEqual(self.tick().returncode, 0)
        self.assertEqual(len(self.runs()), 2)

    def test_covered_checks_are_not_run_and_a_failed_or_lane_edited_one_is_not_retried(self):
        head = self.pr(1)
        self.covered = {head: ['typescript-client']}
        self.tick(STUB_RESULTS=json.dumps({'genie-freshness': 'not signed'}))
        run, = self.runs()
        self.assertEqual(self.checks_of(run), ['genie-freshness'])
        self.assertEqual(self.attempts()[-1]['outcome'], 'lane_edit_not_signed', 'nothing was signed')
        both = self.pr(3, updated='2026-10-22T13:00:00Z')
        self.tick(STUB_RESULTS=json.dumps({'genie-freshness': 'not signed'}))
        self.assertEqual((self.runs()[-1]['head'], self.attempts()[-1]['outcome']), (both, 'worker_signed_lane_edit'))
        self.tick()
        self.assertEqual(len(self.runs()), 2)
        failing = self.pr(2, updated='2026-10-22T11:00:00Z')
        self.tick(STUB_RESULTS=json.dumps({'typescript-client': 'FAILED (1)'}))
        self.assertEqual(self.attempts()[-1]['outcome'], 'failed')
        self.tick()
        self.assertEqual([r['head'] for r in self.runs()], [head, both, failing])

    def test_a_head_that_moved_since_the_listing_waits_for_the_next_tick(self):
        self.pr(1, head='0' * 40)
        done = self.tick()
        self.assertEqual((done.returncode, self.runs()), (0, []), done.stderr)

    def test_the_heavy_class_runs_the_all_extras_with_scratch_on_dev_shm_and_the_kept_target(self):
        self.pr(1)
        done = self.tick('heavy')
        self.assertEqual(done.returncode, 0, done.stderr)
        run, = self.runs()
        self.assertEqual(self.checks_of(run), ['linux-gate', 'mail-redelivery-canaries'])
        self.assertEqual(run['target'], str(self.target))
        self.assertFalse((self.target / '.keep').exists())
        if Path('/dev/shm').is_dir():
            self.assertTrue(run['tmpdir'].startswith('/dev/shm/evidence-presign-'))
            self.assertFalse(Path(run['tmpdir']).exists(), 'the scratch is removed afterwards')

    def test_heavy_never_starts_on_a_busy_or_full_host(self):
        self.pr(1)
        self.set_pressure(9.0)
        done = self.tick('heavy')
        self.assertIn('did not stay calm', done.stderr)
        self.set_pressure(2.0)
        self.admission.write_text('#!/bin/sh\necho \'{"active": 1}\'\n')
        self.assertIn('did not stay calm', self.tick('heavy').stderr)
        self.admission.write_text('#!/bin/sh\necho \'{"active": 0}\'\n')
        (self.config / 'limits.json').write_text(json.dumps({'calm_seconds': 0, 'sample': 1, 'min_free_gib': 10 ** 9}))
        self.assertIn('not starting', self.tick('heavy').stderr)
        self.assertEqual(self.runs(), [])
        self.set_pressure(20.0)
        self.assertIn('is over 15.0%', self.tick('light').stderr)
        self.assertEqual(self.runs(), [])

    def test_a_run_stopped_for_load_is_deferred_not_recorded_as_a_result(self):
        head = self.pr(1)
        worker = subprocess.Popen  # the tick runs in the background while the pressure rises
        self.gh_answer.write_text(json.dumps({'data': {'repository': {'pullRequests': {'nodes': self.prs}}}}))
        environment = dict(CLEAN, HOME=self.tmp.name, EVIDENCE_PRESIGN_CONFIG=str(self.config), EVIDENCE_PRESIGN_STATE=str(self.state),
                           EVIDENCE_PRESIGN_GH=str(self.gh), EVIDENCE_PRESIGN_REMOTE=str(self.origin),
                           EVIDENCE_PRESIGN_PRESSURE=str(self.pressure), EVIDENCE_PRESIGN_MEMINFO=str(self.meminfo),
                           EVIDENCE_PRESIGN_ADMISSION=str(self.admission), STUB_LOG=str(self.log), STUB_SLEEP='30')
        process = worker([sys.executable, str(WORKER), 'tick', '--class', 'heavy', '--repo', str(self.state / 'repo'),
                          '--repository', 'example/repo'], stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, env=environment)
        deadline = time.monotonic() + 30
        while time.monotonic() < deadline and not self.runs():
            time.sleep(0.2)
        self.set_pressure(16.0)
        _, err = process.communicate(timeout=60)
        self.assertEqual(process.returncode, 0, err)
        attempt, = self.attempts()
        self.assertEqual((attempt['outcome'], attempt['stopped']), ('deferred', 'io60 16.0'))
        self.assertLess(attempt['seconds'], 25)
        self.assertNotIn(git(self.work, 'rev-parse', f'{head}^{{tree}}'), json.loads((self.state / 'done-heavy.json').read_text()))
        self.set_pressure(2.0)
        self.tick('heavy')
        self.assertEqual(len(self.runs()), 1, 'a deferred head waits before it is tried again')

    def test_a_kept_target_past_its_size_limit_is_removed_before_the_run(self):
        self.pr(1)
        self.target.mkdir(parents=True)
        (self.target / 'big').write_bytes(b'x' * 2_000_000)
        (self.config / 'limits.json').write_text(json.dumps({'calm_seconds': 0, 'sample': 1, 'min_free_gib': 0, 'target_max_gb': 0.001}))
        done = self.tick('heavy')
        self.assertIn('over 0: removing it; this run starts cold', done.stderr)
        self.assertFalse((self.target / 'big').exists())
        self.assertEqual(len(self.runs()), 1)

    def test_heavy_never_starts_under_the_disk_floor_and_a_run_stops_under_the_stop_line(self):
        self.pr(1)
        (self.config / 'limits.json').write_text(json.dumps({'calm_seconds': 0, 'sample': 1, 'min_free_gib': 10 ** 9}))
        done = self.tick('heavy')
        self.assertIn('not starting', done.stderr)
        self.assertEqual(self.runs(), [])
        skip, = [json.loads(line) for line in (self.state / 'skips.jsonl').read_text().splitlines()]
        self.assertEqual((skip['class'], skip['reason'], skip['pr']), ('heavy', 'disk', 1))
        (self.config / 'limits.json').write_text(json.dumps({'calm_seconds': 0, 'sample': 1, 'min_free_gib': 0, 'stop_free_gib': 10 ** 9}))
        done = self.tick('heavy', STUB_SLEEP='10')
        attempt, = self.attempts()
        self.assertEqual(attempt['outcome'], 'deferred')
        self.assertTrue(attempt['stopped'].startswith('free disk'), attempt)
        report = json.loads(subprocess.run([sys.executable, str(WORKER), 'summary'], capture_output=True, text=True,
                                           env=dict(CLEAN, EVIDENCE_PRESIGN_STATE=str(self.state))).stdout)['classes']['heavy']
        self.assertEqual((report['not_started'], report['stopped']['free disk']), ({'disk': 1, 'busy': 0}, 1))

    def test_what_the_run_leaves_behind_in_its_process_group_is_ended_before_the_log_is_read(self):
        self.pr(1)
        leftover = Path(self.tmp.name) / 'leftover'
        done = self.tick(STUB_LEFTOVER=str(leftover))
        self.assertEqual(done.returncode, 0, done.stderr)
        pid = int(leftover.read_text())
        deadline = time.monotonic() + 5
        while time.monotonic() < deadline and Path(f'/proc/{pid}').exists() and 'Z' not in Path(f'/proc/{pid}/stat').read_text().split()[2]:
            time.sleep(0.1)
        alive = Path(f'/proc/{pid}').exists() and Path(f'/proc/{pid}/stat').read_text().split()[2] != 'Z'
        self.assertFalse(alive, 'the stray process outlived the run')

    def test_a_dry_run_says_what_it_would_run_and_runs_nothing(self):
        head = self.pr(1)
        done = self.tick('light', '--dry-run')
        self.assertEqual(json.loads(done.stdout)['head'], head)
        self.assertEqual(self.runs(), [])

    def test_the_summary_counts_ready_heads_covered_and_the_wait(self):
        self.pr(1)
        head = self.pr(2, updated='2026-10-22T11:00:00Z')
        self.covered = {head: ['typescript-client', 'genie-freshness']}
        self.tick()  # #2 is covered already (a seat signed it), #1 is signed now
        done = subprocess.run([sys.executable, str(WORKER), 'summary'], capture_output=True, text=True,
                              env=dict(CLEAN, EVIDENCE_PRESIGN_STATE=str(self.state), EVIDENCE_PRESIGN_CONFIG=str(self.config)))
        light = json.loads(done.stdout)['classes']['light']
        self.assertEqual((light['ready_heads'], light['ready_heads_covered'], light['runs']), (2, 2, 1), done.stdout)
        self.assertEqual(light['outcomes'], {'worker_signed': 1})
        self.assertLess(light['worst_ready_to_covered_s'], 60)


if __name__ == '__main__':
    unittest.main()
