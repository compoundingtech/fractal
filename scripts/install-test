#!/usr/bin/env bash
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
# Prove physical fractal installation and transactional reverse aliases.
set -Eeuo pipefail
. "$(dirname "$0")/script-test-supervisor"

install="$(cd "$(dirname "$0")" && pwd)/install"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
# These fixtures test regular-file installation; native macOS app transactions
# are covered separately by install-macos-test.
mkdir -p "$work/platform-bin"
printf '#!/bin/sh\necho Linux\n' > "$work/platform-bin/uname"
chmod +x "$work/platform-bin/uname"
export PATH="$work/platform-bin:$PATH"

fail() {
  echo "install-test: $*" >&2
  exit 1
}

build() {
  local dir=$1 version=$2 binary
  mkdir -p "$dir"
  for binary in fractal st3-migrate; do
    printf '#!/bin/sh\necho "%s %s"\n' "$binary" "$version" > "$dir/$binary"
    chmod 0755 "$dir/$binary"
  done
}

check() {
  local bin=$1 version=$2 binary
  for binary in st st3; do
    [[ -L $bin/$binary && $(readlink "$bin/$binary") == fractal ]] || fail "$binary is not a reverse alias"
    [[ $("$bin/$binary") == "fractal $version" ]] || fail "$binary does not run fractal $version"
  done
  for binary in fractal st3-migrate; do
    [[ -f $bin/$binary && ! -L $bin/$binary ]] || fail "$bin/$binary is not a regular file"
    [[ $("$bin/$binary") == "$binary $version" ]] || fail "$bin/$binary is not version $version"
  done
  [[ ! -e $bin/stui && ! -L $bin/stui ]] || fail "retired UI executable survived installation"
  [[ -z $(find "$bin" -name '.*.install.*') ]] || fail "staged files were left in $bin"
}

build "$work/one" 1
build "$work/two" 2

# A fresh destination.
bash "$install" --from "$work/one" --bin-dir "$work/fresh" > /dev/null
check "$work/fresh" 1

# A stale `st` copied from an older st3 build is replaced by the link.
mkdir -p "$work/stale"
cp "$work/one/fractal" "$work/stale/st"
cp "$work/one/fractal" "$work/stale/stui"
bash "$install" --from "$work/two" --bin-dir "$work/stale" > /dev/null
check "$work/stale" 2

# A reinstall over a previous physical installation.
bash "$install" --from "$work/one" --bin-dir "$work/stale" > /dev/null
check "$work/stale" 1

# Named instances keep the inherited default login command and its exact entries.
python3 - "$work/fresh" "$work/default-entries.json" <<'PY'
import json, os, sys
from pathlib import Path
root = Path(sys.argv[1])
Path(sys.argv[2]).write_text(json.dumps({
    p.name: [p.lstat().st_dev, p.lstat().st_ino, os.readlink(p) if p.is_symlink() else p.read_bytes().hex()]
    for p in root.iterdir()}))
PY
PATH="$work/fresh:$PATH" bash "$install" --instance coexist --from "$work/two" --bin-dir "$work/instance" > /dev/null
check "$work/instance" 2
python3 - "$work/fresh" "$work/default-entries.json" <<'PY'
import json, os, sys
from pathlib import Path
root = Path(sys.argv[1])
assert json.loads(Path(sys.argv[2]).read_text()) == {
    p.name: [p.lstat().st_dev, p.lstat().st_ino, os.readlink(p) if p.is_symlink() else p.read_bytes().hex()]
    for p in root.iterdir()}
PY

# Foreign canonical commands are refused before any command is installed.
for kind in file link dangling directory; do
  bin="$work/collision-$kind"
  mkdir -p "$bin"
  case $kind in
    file) printf foreign > "$bin/fractal" ;;
    link) ln -s "$work/one/fractal" "$bin/fractal" ;;
    dangling) ln -s /missing/fractal "$bin/fractal" ;;
    directory) mkdir "$bin/fractal" ;;
  esac
  if bash "$install" --from "$work/one" --bin-dir "$bin" > /dev/null 2> "$work/collision.err"; then
    fail "foreign canonical command accepted"
  fi
  if PATH="$work/fresh:$PATH" bash "$install" --instance coexist --from "$work/one" --bin-dir "$bin" > /dev/null 2> "$work/collision.err"; then
    fail "named instance accepted foreign destination"
  fi
  [[ ! -e $bin/st && ! -e $bin/st3 ]] || fail "refusal installed reverse aliases"
  grep -q 'foreign fractal command' "$work/collision.err" || fail "missing collision guidance"
  case $kind in
    file) [[ $(cat "$bin/fractal") == foreign ]] || fail "foreign file replaced" ;;
    link) [[ $(readlink "$bin/fractal") == "$work/one/fractal" ]] || fail "foreign link replaced" ;;
    dangling) [[ $(readlink "$bin/fractal") == /missing/fractal ]] || fail "dangling link replaced" ;;
    directory) [[ -d $bin/fractal && -z $(ls -A "$bin/fractal") ]] || fail "foreign directory modified" ;;
  esac
done
# The historical owned forward alias converges to a physical executable.
rm "$work/stale/fractal"
ln -sfn "$work/one/fractal" "$work/stale/st3"
ln -s st3 "$work/stale/fractal"
bash "$install" --from "$work/one" --bin-dir "$work/stale" > /dev/null
check "$work/stale" 1
# A free destination must not introduce an alias shadowing a foreign PATH command.
mkdir -p "$work/foreign-path"
cp "$work/one/fractal" "$work/foreign-path/fractal"
if PATH="$work/foreign-path:$PATH" bash "$install" --from "$work/one" --bin-dir "$work/path-collision" > /dev/null 2> "$work/path.err"; then
  fail "foreign PATH command accepted"
fi
[[ ! -e $work/path-collision/fractal && ! -L $work/path-collision/fractal ]] || fail "foreign PATH command shadowed"
[[ ! -e $work/path-collision/st ]] || fail "refusal installed st"
grep -q 'PATH contains a foreign fractal command' "$work/path.err" || fail "missing PATH guidance"
# A directory in the way is refused before anything is replaced.
mkdir -p "$work/blocked/st"
if bash "$install" --from "$work/two" --bin-dir "$work/blocked" 2> /dev/null; then
  fail "installing over a directory named st succeeded"
fi
[[ ! -e $work/blocked/st3 ]] || fail "a refused install still replaced st3"

# Missing binaries are refused.
rm "$work/two/st3-migrate"
if bash "$install" --from "$work/two" --bin-dir "$work/fresh" 2> /dev/null; then
  fail "installing without st3-migrate succeeded"
fi
check "$work/fresh" 1

# A named instance installs below its own directory and leaves the default bin directory alone.
mkdir -p "$work/home/.local/bin"
printf 'default\n' > "$work/home/.local/bin/st3"
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read — CLI selection replaces both inherited aliases.
HOME="$work/home" FRACTAL_INSTANCE=stale ST_INSTANCE=stale bash "$install" --from "$work/one" --instance try > /dev/null
check "$work/home/.st-instance/try/bin" 1
[[ $(cat "$work/home/.local/bin/st3") == default ]] || fail "an instance install replaced the default st3"
[[ $(ls "$work/home/.local/bin") == st3 ]] || fail "an instance install added files to the default bin directory"
# The environment variable names the instance too, and an explicit --bin-dir still wins.
build "$work/three" 3
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read — the preferred name wins over a legacy value.
HOME="$work/home" FRACTAL_INSTANCE=other ST_INSTANCE=legacy bash "$install" --from "$work/three" > /dev/null
check "$work/home/.st-instance/other/bin" 3
HOME="$work/home" bash "$install" --from "$work/one" --instance third --bin-dir "$work/chosen" > /dev/null
check "$work/chosen" 1
[[ ! -e $work/home/.st-instance/third ]] || fail "an explicit --bin-dir still created the instance bin directory"
# Names that are not plain are refused before anything is written.
for bad in Try a_b ../x -a a--b abcdefghijklmnopqrstuvwxy; do
  if HOME="$work/home" bash "$install" --from "$work/one" --instance "$bad" 2> /dev/null; then
    fail "instance name '$bad' was accepted"
  fi
done
[[ $(ls "$work/home/.st-instance" | sort | tr '\n' ' ') == "other try " ]] || fail "a refused name left a directory"

# Nix-owned canonical commands are refused, including dangling generations.
mkdir -p "$work/nix"
ln -s /nix/store/missing-fractal/bin/fractal "$work/nix/fractal"
if bash "$install" --from "$work/one" --bin-dir "$work/nix" 2> "$work/nix.err"; then
  fail "Nix-owned canonical command accepted"
fi
grep -q 'Nix-owned path' "$work/nix.err" || fail "missing Nix ownership guidance"
[[ $(readlink "$work/nix/fractal") == /nix/store/missing-fractal/bin/fractal ]] || fail "Nix link replaced"

# A failed alias rename restores the original canonical inode and both aliases.
bash "$install" --from "$work/one" --bin-dir "$work/rollback" > /dev/null
ln "$work/rollback/fractal" "$work/original-inode"
ln -P "$work/rollback/st" "$work/original-st-entry"
ln -P "$work/rollback/st3" "$work/original-st3-entry"
export INSTALL_REAL_MV
INSTALL_REAL_MV=$(command -v mv)
export INSTALL_FAIL_DEST="$work/rollback/st3" INSTALL_FAIL_MARKER="$work/failed"
cat > "$work/platform-bin/mv" <<'SH'
#!/usr/bin/env bash
set -eu
for argument in "$@"; do
  if [[ -n ${INSTALL_RESTORE_FAIL_NAME:-} && $argument == */previous/"$INSTALL_RESTORE_FAIL_NAME" ]]; then exit 1; fi
done
if [[ ${!#} == "$INSTALL_FAIL_DEST" && ! -e $INSTALL_FAIL_MARKER ]]; then
  : > "$INSTALL_FAIL_MARKER"
  exit 1
fi
exec "$INSTALL_REAL_MV" "$@"
SH
chmod +x "$work/platform-bin/mv"
if bash "$install" --from "$work/three" --bin-dir "$work/rollback" > /dev/null; then
  fail "failed transaction succeeded"
fi
check "$work/rollback" 1
[[ $work/rollback/fractal -ef $work/original-inode ]] || fail "rollback lost canonical inode"
[[ ! -e $work/rollback/.smalltalk-install.lock ]] || fail "rollback retained lock"
python3 - "$work" <<'PY_ENTRIES'
import os, sys
from pathlib import Path
root = Path(sys.argv[1])
for name in ('st', 'st3'):
    before = os.lstat(root / ('original-' + name + '-entry'))
    after = os.lstat(root / 'rollback' / name)
    assert (before.st_dev, before.st_ino) == (after.st_dev, after.st_ino), name
    assert os.readlink(root / 'rollback' / name) == 'fractal'
PY_ENTRIES

# Failure at the first move leaves regular files and retired relative/dangling
# symlink objects untouched. Rollback must recognize those hardlinked entries.
for kind in regular relative dangling; do
  destination="$work/unchanged-$kind"
  bash "$install" --from "$work/one" --bin-dir "$destination" > /dev/null
  case "$kind" in
    regular) printf 'previous retired tool\n' > "$destination/stui" ;;
    relative) ln -s fractal "$destination/stui" ;;
    dangling) ln -s missing-retired-tool "$destination/stui" ;;
  esac
  python3 - "$destination" "$work/before-$kind.json" <<'PY_SNAPSHOT'
import json, os, sys
from pathlib import Path
root = Path(sys.argv[1])
entries = {}
for path in root.iterdir():
    metadata = os.lstat(path)
    entries[path.name] = {
        'identity': [metadata.st_dev, metadata.st_ino],
        'link': os.readlink(path) if path.is_symlink() else None,
        'bytes': None if path.is_symlink() else path.read_bytes().hex(),
    }
Path(sys.argv[2]).write_text(json.dumps(entries))
PY_SNAPSHOT
  export INSTALL_FAIL_DEST="$destination/fractal" INSTALL_FAIL_MARKER="$work/failed-$kind"
  if bash "$install" --from "$work/three" --bin-dir "$destination" > /dev/null; then
    fail "first-move failure succeeded for $kind"
  fi
  python3 - "$destination" "$work/before-$kind.json" <<'PY_UNCHANGED'
import json, os, sys
from pathlib import Path
root = Path(sys.argv[1])
before = json.loads(Path(sys.argv[2]).read_text())
assert sorted(path.name for path in root.iterdir()) == sorted(before)
for name, prior in before.items():
    path = root / name
    metadata = os.lstat(path)
    assert [metadata.st_dev, metadata.st_ino] == prior['identity'], name
    assert (os.readlink(path) if path.is_symlink() else None) == prior['link'], name
    assert (None if path.is_symlink() else path.read_bytes().hex()) == prior['bytes'], name
PY_UNCHANGED
done
# Failed/empty identity reads must use the real restore path, not assume equality.
# A persistent restore failure must retain the original inode and recovery lock.
for fault in stat-error stat-empty restore; do
  destination="$work/recovery-$fault"
  bash "$install" --from "$work/one" --bin-dir "$destination" > /dev/null
  ln "$destination/fractal" "$work/recovery-original-$fault"
  export INSTALL_FAIL_DEST="$destination/st3" INSTALL_FAIL_MARKER="$work/failure-$fault"
  if [[ $fault == restore ]]; then
    export INSTALL_RESTORE_FAIL_NAME=fractal
  else
    # Fail the untouched alias restore regardless of native same-inode mv semantics.
    export INSTALL_RESTORE_FAIL_NAME=st3
    printf '#!/bin/sh\n%s\n' "$([[ $fault == stat-error ]] && echo 'exit 1' || echo 'exit 0')" > "$work/platform-bin/stat"
    chmod +x "$work/platform-bin/stat"
  fi
  if bash "$install" --from "$work/three" --bin-dir "$destination" > /dev/null 2> "$work/recovery-$fault.err"; then
    fail "$fault unexpectedly succeeded"
  fi
  grep -q 'rollback failed' "$work/recovery-$fault.err" || fail "$fault hid rollback failure"
  [[ -d $destination/.smalltalk-install.lock ]] || fail "$fault removed recovery lock"
  if [[ $fault == restore ]]; then
    previous=("$destination"/.source.install.*/previous/fractal)
    [[ ${#previous[@]} == 1 && ${previous[0]} -ef $work/recovery-original-$fault ]] || fail "restore failure lost original inode"
    [[ $("$destination/fractal") == 'fractal 3' ]] || fail "restore failure did not preserve failed replacement"
  else
    [[ $destination/fractal -ef $work/recovery-original-$fault ]] || fail "$fault skipped actual restore"
  fi
  unset INSTALL_RESTORE_FAIL_NAME
  rm -f "$work/platform-bin/stat"
done
rm "$work/platform-bin/mv"

echo 'install tests passed'
