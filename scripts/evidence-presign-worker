#!/usr/bin/env python3
"""Pre-sign the open, ready pull requests of this host's own authors, one head at a time (scripts/evidence-presign-*.timer).

  evidence-presign-worker tick --class light|heavy --repo DIR [--repository OWNER/NAME] [--dry-run]
  evidence-presign-worker summary [--hours 24]

A pull request head counts as pre-signed when its checks have a host note before CI looks. Seats sign the light checks when they
push (scripts/evidence-prepush), but not always (a push with ST_SKIP_EVIDENCE=1 does not wait, a merge of main made elsewhere
is pushed by no hook) and never the heavy ones. This worker closes that gap from the tools' side, so nobody has to remember to.

One tick: list the open pull requests (gh), keep those that are ready (not draft), target main, come from this repository (no
forks) and are authored by a GitHub login in ~/.config/evidence-presign/authors (one per line; outside authors are never run:
their code would run here, with the host's key within reach). Newest first, take the first head with a check of the class that
has no note yet and was not tried for that tree before, and run `scripts/fractal-test --check NAME... --push origin` (from origin/main,
as the pre-push hook does) on it in DIR, a clone this worker owns. Then stop: one head per tick, so the next head waits for the
next tick and two runs never overlap (a lock per class). The light class is what `fractal-test --list` prints, which is now every check
(fractal-test runs the whole per-PR suite by default); the heavy class is what --all adds to that, which is nothing.

What it never repeats: a check that `fractal-test --status` says is covered (whoever signed it), and a check this worker already ran
for the tree, whatever the result (a failure is recorded as a note and CI runs the check; the same tree fails the same way).
A run stopped for load is not a result: that tree waits DEFER seconds and is tried again.

Load (the heavy class; operations' numbers for this host): start only after IO pressure (some avg60) stayed under 8% for 10
minutes with no admitted heavy build active and at least 140 GiB free (it clears nothing to make room); stop the run (TERM, then
KILL of its process group) when avg60 passes 15%, available memory falls under 16 GiB, free disk under 136 GiB or its /dev/shm
scratch passes 20 GB. The heavy class keeps its cargo target in ~/.cache/evidence-presign-target, which the host's sweep may
reclaim when idle, and removes it itself before a run once it passes 25 GB. The light class starts below 15% and
stops the same way. ~/.config/evidence-presign/off stops every tick before it does anything.

Report: one JSON line per attempt in ~/.local/state/evidence-presign/attempts.jsonl (pr, head, tree, class, ready_at, started_at,
seconds, per-check results, io60 peak, outcome), and `summary` prints, for the heads seen ready in the window, how many got all
their checks covered and the median and worst wait from first seen ready to covered.
"""
import argparse
import calendar
import fcntl
import json
import os
from pathlib import Path
import re
import shutil
import signal
import statistics
import subprocess
import sys
import tempfile
import time

sys.dont_write_bytecode = True
CONFIG = Path(os.environ.get('EVIDENCE_PRESIGN_CONFIG') or Path.home() / '.config/evidence-presign')
STATE = Path(os.environ.get('EVIDENCE_PRESIGN_STATE') or Path.home() / '.local/state/evidence-presign')
BASE = 'main'
LIMITS = {
    'calm_io60': 8.0,          # heavy: start only after IO pressure stayed under this...
    'calm_seconds': 600,       # ...for this long
    'calm_wait': 1200,         # and give the tick up when that has not happened within this
    'start_io60': 15.0,        # light: start only under this
    'stop_io60': 15.0,         # every run: stop above this
    'stop_mem_gib': 16.0,      # every run: stop when available memory falls under this
    'min_free_gib': 140.0,     # heavy: never start with less free disk where the clone lives
    'stop_free_gib': 136.0,    # every run: stop when free disk falls under this
    'target_max_gb': 25.0,     # heavy: the kept cargo target is removed before a run when it has grown past this
    'shm_max_gb': 20.0,        # heavy: stop when the run's /dev/shm scratch passes this
    'sample': 30,              # seconds between load samples
    'defer': 1800,             # a tree stopped for load waits this long before it is tried again
    'time_limit': 7200,        # fractal-test --time-limit, per check
}
# The heavy class's cargo target, kept between runs so a head does not start cold (about ten minutes and 19 GB of writes). It is
# under ~/.cache/*-target, which the host's scratch sweep reclaims when it has been idle two hours and disk runs short: a busy
# worker keeps it warm, a quiet one starts cold. Never pinned (no .keep), and never larger than target_max_gb.
TARGET = Path(os.environ.get('EVIDENCE_PRESIGN_TARGET') or Path.home() / '.cache/evidence-presign-target')
QUERY = '''query($owner: String!, $name: String!) { repository(owner: $owner, name: $name) {
  pullRequests(states: OPEN, first: 50, orderBy: {field: UPDATED_AT, direction: DESC}) { nodes {
    number isDraft headRefOid baseRefName updatedAt author { login } headRepository { nameWithOwner } } } } }'''
ROW = re.compile(r'^  (\S+)\s+(passed|FAILED \(\d+\)|timed out|not signed|NOT RUN)\s+(\d+)s\s+(.*)$')
STATUS_ROW = re.compile(r'^  (\S+)\s+(covered|not covered)\s+(.*)$')
CHILD = None


class Failure(Exception):
    pass


def now():
    return time.time()


def stamp(seconds=None):
    return time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime(seconds if seconds is not None else now()))


def say(message):
    print(f'evidence-presign: {message}', file=sys.stderr, flush=True)


def limits():
    """The numbers above, with any override from ~/.config/evidence-presign/limits.json (agreed with operations)."""
    merged = dict(LIMITS)
    path = CONFIG / 'limits.json'
    if path.exists():
        given = json.loads(path.read_text())
        unknown = set(given) - set(LIMITS)
        if unknown:
            raise Failure(f'{path}: unknown limits {", ".join(sorted(unknown))}')
        merged.update({key: type(LIMITS[key])(value) for key, value in given.items()})
    return merged


def authors():
    path = CONFIG / 'authors'
    names = set()
    if path.exists():
        names = {line.strip() for line in path.read_text().splitlines() if line.strip() and not line.lstrip().startswith('#')}
    if not names:
        raise Failure(f'{path} is missing or lists no GitHub login: refusing to run anyone\'s code')
    return names


def git(repo, *args, check=True):
    done = subprocess.run(['git', '-C', str(repo), '-c', 'core.hooksPath=/dev/null', *args], capture_output=True, text=True)
    if check and done.returncode != 0:
        raise Failure(f'git {" ".join(args[:3])}: {done.stderr.strip()[-300:]}')
    return done


def read_json(path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def write_json(path, value):
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix('.tmp')
    temporary.write_text(json.dumps(value, sort_keys=True, indent=1) + '\n')
    temporary.replace(path)


def append(path, line):
    path.parent.mkdir(parents=True, exist_ok=True)
    with open(path, 'a') as out:
        out.write(json.dumps(line, sort_keys=True) + '\n')


def io60():
    for line in Path(os.environ.get('EVIDENCE_PRESIGN_PRESSURE', '/proc/pressure/io')).read_text().splitlines():
        if line.startswith('some '):
            return float(dict(field.split('=') for field in line.split()[1:])['avg60'])
    raise Failure('no IO pressure line')


def mem_gib():
    for line in Path(os.environ.get('EVIDENCE_PRESIGN_MEMINFO', '/proc/meminfo')).read_text().splitlines():
        if line.startswith('MemAvailable:'):
            return int(line.split()[1]) / 1048576
    raise Failure('no MemAvailable line')


def heavy_build_active():
    """True when the build admission says an admitted heavy build runs now (False on a host without it)."""
    admission = shutil.which(os.environ.get('EVIDENCE_PRESIGN_ADMISSION', str(Path.home() / '.local/bin/build-admission')))
    if not admission:
        return False
    done = subprocess.run([admission, 'status'], capture_output=True, text=True, timeout=60)
    try:
        return int(json.loads(done.stdout).get('active', 1)) > 0
    except (ValueError, TypeError, AttributeError):
        return True  # cannot tell: treat as busy


def candidates(repository, allowed):
    owner, name = repository.split('/')
    done = subprocess.run([os.environ.get('EVIDENCE_PRESIGN_GH', 'gh'), 'api', 'graphql', '-f', f'query={QUERY}',
                           '-F', f'owner={owner}', '-F', f'name={name}'], capture_output=True, text=True, timeout=120)
    if done.returncode != 0:
        raise Failure('gh api graphql: ' + done.stderr.strip()[-300:])
    nodes = json.loads(done.stdout)['data']['repository']['pullRequests']['nodes']
    kept = [pr for pr in nodes if not pr['isDraft'] and pr['baseRefName'] == BASE and (pr.get('author') or {}).get('login') in allowed
            and (pr.get('headRepository') or {}).get('nameWithOwner', '').lower() == repository.lower()]
    return sorted(kept, key=lambda pr: pr['updatedAt'], reverse=True)


def clone(repo, repository):
    if not (repo / '.git').exists():
        repo.parent.mkdir(parents=True, exist_ok=True)
        url = os.environ.get('EVIDENCE_PRESIGN_REMOTE') or f'https://github.com/{repository}.git'
        subprocess.run(['git', 'clone', '-q', '--no-tags', url, str(repo)], check=True, capture_output=True)
        git(repo, 'config', 'gc.auto', '0')
    git(repo, 'fetch', '-q', '--no-tags', 'origin', f'+refs/heads/{BASE}:refs/remotes/origin/{BASE}')


def base_tools(repo, scratch):
    """The base's runner, never a pull request's copy (it takes its signing tools from the base itself)."""
    # arn:lmig:smalltalk:2026-10-27-st-test-shim — copy-only readers need the self-contained implementation, not its shim.
    path = Path(scratch) / 'st-test'
    source = f'origin/{BASE}:scripts/st-test'
    path.write_text(git(repo, 'show', source).stdout)
    return path


def class_checks(st_test, repo, kind):
    def names(*extra):
        done = subprocess.run([sys.executable, '-I', str(st_test), '--list', *extra], cwd=repo, capture_output=True, text=True)
        if done.returncode != 0:
            raise Failure('fractal-test --list: ' + done.stderr.strip()[-300:])
        return [line.split(':', 1)[0] for line in done.stdout.splitlines() if ':' in line]
    light = names()
    return light if kind == 'light' else [name for name in names('--all') if name not in light]


def checkout(repo, pr):
    git(repo, 'fetch', '-q', '--no-tags', 'origin', f'+refs/pull/{pr["number"]}/head:refs/presign/head')
    head = git(repo, 'rev-parse', 'refs/presign/head').stdout.strip()
    if head != pr['headRefOid']:
        return None  # it moved since the listing: the next tick sees the new head
    git(repo, 'checkout', '-q', '--detach', '--force', head)
    return git(repo, 'rev-parse', f'{head}^{{tree}}').stdout.strip()


def uncovered(st_test, repo, wanted):
    args = [arg for name in wanted for arg in ('--check', name)]
    done = subprocess.run([sys.executable, '-I', str(st_test), '--status', '--base', f'origin/{BASE}', *args], cwd=repo,
                          capture_output=True, text=True, timeout=600)
    if done.returncode not in (0, 3):
        raise Failure('fractal-test --status: ' + (done.stderr or done.stdout).strip()[-300:])
    rows = {m[1]: m[2] for m in map(STATUS_ROW.match, done.stdout.splitlines()) if m}
    return [name for name in wanted if rows.get(name) != 'covered'], [name for name in wanted if rows.get(name) == 'covered']


def wait_calm(rules):
    """Heavy: True once IO pressure stayed under the calm line for calm_seconds with no admitted heavy build active."""
    calm_since, give_up = None, now() + rules['calm_wait']
    while now() < give_up:
        if io60() < rules['calm_io60'] and not heavy_build_active():
            calm_since = calm_since or now()
            if now() - calm_since >= rules['calm_seconds']:
                return True
        else:
            calm_since = None
        time.sleep(rules['sample'])
    return False


def free_gib(path):
    given = os.environ.get('EVIDENCE_PRESIGN_FREE_GIB')  # a stand-in for the disk, as EVIDENCE_PRESIGN_MEMINFO is for memory
    if given:
        return float(given)
    stat = os.statvfs(path)
    return stat.f_bavail * stat.f_frsize / 2**30


def du_gb(path):
    total = 0
    for root, _, files in os.walk(path):
        for name in files:
            try:
                total += os.lstat(os.path.join(root, name)).st_size
            except OSError:
                pass
    return total / 1e9


def stop(group):
    try:
        os.killpg(group.pid, signal.SIGTERM)
        try:
            group.wait(timeout=20)
        except subprocess.TimeoutExpired:
            pass
        os.killpg(group.pid, signal.SIGKILL)
    except ProcessLookupError:
        pass
    group.wait()


def run(st_test, repo, checks, kind, rules, log, extra=()):
    """fractal-test on the checked-out head (and `extra`, more runner arguments), watched; (rows, stopped_reason, seconds, io60_peak)."""
    global CHILD
    env = dict(os.environ)
    scratch = None
    if kind == 'heavy':
        if Path('/dev/shm').is_dir():
            scratch = Path(tempfile.mkdtemp(prefix='evidence-presign-', dir='/dev/shm'))
            env.update(TMPDIR=str(scratch), TMP=str(scratch), TEMP=str(scratch))
        env['CARGO_TARGET_DIR'] = str(TARGET)
    command = [sys.executable, '-I', str(st_test), '--base', f'origin/{BASE}', '--push', 'origin',
               '--time-limit', str(rules['time_limit']), *[arg for name in checks for arg in ('--check', name)], *extra]
    started, peak, reason = now(), io60(), None
    with open(log, 'ab') as sink:
        CHILD = subprocess.Popen(command, cwd=repo, env=env, stdout=sink, stderr=sink, start_new_session=True)
        try:
            while CHILD.poll() is None:
                try:
                    CHILD.wait(timeout=rules['sample'])
                    break
                except subprocess.TimeoutExpired:
                    pass
                pressure = io60()
                peak = max(peak, pressure)
                if pressure > rules['stop_io60']:
                    reason = f'io60 {pressure:.1f}'
                elif mem_gib() < rules['stop_mem_gib']:
                    reason = f'memory {mem_gib():.1f} GiB'
                elif scratch and du_gb(scratch) > rules['shm_max_gb']:
                    reason = f'/dev/shm scratch {du_gb(scratch):.1f} GB'
                elif free_gib(repo) < rules['stop_free_gib']:
                    reason = f'free disk {free_gib(repo):.0f} GiB'
                if reason:
                    stop(CHILD)
                    break
        finally:
            # Whatever the run left behind in its process group (a test's stray background process) is ended now, before the log is
            # read: nothing may write to the log after fractal-test's summary.
            try:
                os.killpg(CHILD.pid, signal.SIGKILL)
            except (ProcessLookupError, PermissionError):
                pass
            CHILD = None
            if scratch:
                shutil.rmtree(scratch, ignore_errors=True)
    return summary_rows(Path(log).read_text(errors='replace')), reason, round(now() - started), peak


def summary_rows(output):
    """The per-check results of fractal-test's own final summary: the rows after its last runner tree header. The log also holds the
    output of the pull request's tests, which could print a line shaped like a row; nothing before that header is read."""
    lines = output.splitlines()
    # arn:lmig:smalltalk:2026-10-27-st-test-shim — old bases still print the old header.
    starts = [i for i, line in enumerate(lines) if line.startswith(('fractal-test: tree ', 'st-test: tree '))]
    rows = {}
    for line in lines[starts[-1] + 1:] if starts else []:
        match = ROW.match(line)
        if not match:
            break
        rows[match[1]] = match[2]
    return rows


def tick(args):
    if (CONFIG / 'off').exists():
        say(f'{CONFIG / "off"} exists: not running')
        return 0
    allowed = authors()
    rules = limits()
    STATE.mkdir(parents=True, exist_ok=True)
    lock = open(STATE / f'{args.kind}.lock', 'w')
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        return 0  # the previous tick of this class still runs
    repo = Path(args.repo).resolve()
    clone(repo, args.repository)
    paths = {name: STATE / f'{name}-{args.kind}.json' for name in ('done', 'ready', 'deferred')}
    done, ready, deferred = (read_json(paths[name], {}) for name in ('done', 'ready', 'deferred'))
    old = now() - 7 * 86400  # a week of history is enough for the daily report
    ready = {head: seen for head, seen in ready.items() if seconds_of(seen['seen']) >= old}
    deferred = {head: until for head, until in deferred.items() if until > now()}
    prs = candidates(args.repository, allowed)
    for pr in prs:  # when each head was first seen ready: the start of its wait
        ready.setdefault(pr['headRefOid'], {'pr': pr['number'], 'seen': stamp()})
    write_json(paths['ready'], ready)
    write_json(paths['deferred'], deferred)
    with tempfile.TemporaryDirectory(prefix='evidence-presign-') as scratch:
        st_test = base_tools(repo, scratch)
        wanted_checks = class_checks(st_test, repo, args.kind)
        for pr in prs:
            if deferred.get(pr['headRefOid'], 0) > now():
                continue
            tree = checkout(repo, pr)
            if tree is None:
                continue
            ready[pr['headRefOid']].update(tree=tree, checks=wanted_checks)
            wanted = [name for name in wanted_checks if name not in done.get(tree, {})]
            if not wanted:
                continue
            missing, covered = uncovered(st_test, repo, wanted)
            for name in covered:
                done.setdefault(tree, {})[name] = {'result': 'covered', 'at': stamp()}
            write_json(paths['done'], done)
            if not missing:
                continue
            if args.dry_run:
                print(json.dumps({'pr': pr['number'], 'head': pr['headRefOid'], 'tree': tree, 'checks': missing}))
                return 0
            def not_starting(reason, message):
                say(message)
                append(STATE / 'skips.jsonl', {'time': stamp(), 'class': args.kind, 'pr': pr['number'], 'head': pr['headRefOid'],
                                               'reason': reason})
                return 0
            if args.kind == 'heavy':
                if free_gib(repo) < rules['min_free_gib']:
                    # It clears nothing to make room: the host's own sweep decides what goes.
                    return not_starting('disk', f'{free_gib(repo):.0f} GiB free, under {rules["min_free_gib"]:.0f}: not starting')
                if not wait_calm(rules):
                    return not_starting('busy', 'the host did not stay calm long enough: not starting this tick')
                if TARGET.exists() and du_gb(TARGET) > rules['target_max_gb']:
                    say(f'the kept target is {du_gb(TARGET):.1f} GB, over {rules["target_max_gb"]:.0f}: removing it; this run starts cold')
                    shutil.rmtree(TARGET, ignore_errors=True)
            elif io60() >= rules['start_io60']:
                return not_starting('busy', f'IO pressure {io60():.1f}% is over {rules["start_io60"]}%: not starting this tick')
            log = STATE / 'logs' / f'{time.strftime("%Y%m%dT%H%M%S")}-{pr["number"]}-{args.kind}.log'
            log.parent.mkdir(parents=True, exist_ok=True)
            started = now()
            rows, reason, seconds, peak = run(st_test, repo, missing, args.kind, rules, log)
            line = {'time': stamp(), 'class': args.kind, 'pr': pr['number'], 'head': pr['headRefOid'], 'tree': tree,
                    'ready_at': ready[pr['headRefOid']]['seen'], 'started_at': stamp(started), 'seconds': seconds,
                    'checks': {name: rows.get(name, 'no result') for name in missing}, 'io60_peak': round(peak, 2), 'log': str(log)}
            if reason:
                line['outcome'] = 'deferred'
                line['stopped'] = reason
                deferred[pr['headRefOid']] = now() + rules['defer']
                write_json(paths['deferred'], deferred)
            else:
                results = {rows.get(name, 'no result') for name in missing}
                # 'not signed': the tree edits that check's lane, so CI runs it; not a failure of the head.
                line['outcome'] = ('worker_signed' if results == {'passed'} else
                                   'worker_signed_lane_edit' if results == {'passed', 'not signed'} else
                                   'lane_edit_not_signed' if results == {'not signed'} else 'failed')
                for name in missing:
                    done.setdefault(tree, {})[name] = {'result': rows.get(name, 'no result'), 'at': stamp()}
                write_json(paths['done'], done)
            append(STATE / 'attempts.jsonl', line)
            write_json(paths['ready'], ready)
            say(f'#{pr["number"]} {pr["headRefOid"][:12]} {args.kind}: {line["outcome"]} in {seconds}s '
                f'({", ".join(f"{k} {v}" for k, v in line["checks"].items())})')
            return 0
    write_json(paths['ready'], ready)
    return 0


def seconds_of(text):
    return calendar.timegm(time.strptime(text, '%Y-%m-%dT%H:%M:%SZ'))


def summary(args):
    """Heads first seen ready in the window: how many had every check covered, and how long from first seen ready to covered."""
    since = now() - args.hours * 3600
    attempts = []
    if (STATE / 'attempts.jsonl').exists():
        attempts = [json.loads(line) for line in (STATE / 'attempts.jsonl').read_text().splitlines() if line.strip()]
    skips = []
    if (STATE / 'skips.jsonl').exists():
        skips = [k for k in (json.loads(line) for line in (STATE / 'skips.jsonl').read_text().splitlines() if line.strip())
                 if seconds_of(k['time']) >= since]
    report = {'hours': args.hours, 'classes': {}}
    for kind in ('light', 'heavy'):
        done, ready = read_json(STATE / f'done-{kind}.json', {}), read_json(STATE / f'ready-{kind}.json', {})
        heads = {head: seen for head, seen in ready.items() if seconds_of(seen['seen']) >= since and seen.get('tree')}
        waits, covered = [], 0
        for head, seen in heads.items():
            results = done.get(seen['tree'], {})
            if all(results.get(name, {}).get('result') in ('passed', 'covered') for name in seen.get('checks', ['?'])):
                covered += 1
                waits.append(max(0, max(seconds_of(results[name]['at']) for name in seen['checks']) - seconds_of(seen['seen'])))
        runs = [a for a in attempts if a['class'] == kind and seconds_of(a['time']) >= since]
        report['classes'][kind] = {
            'ready_heads': len(heads), 'ready_heads_covered': covered,
            'median_ready_to_covered_s': round(statistics.median(waits)) if waits else None,
            'worst_ready_to_covered_s': round(max(waits)) if waits else None,
            'runs': len(runs), 'outcomes': {o: sum(1 for a in runs if a['outcome'] == o) for o in sorted({a['outcome'] for a in runs})},
            'median_run_s': round(statistics.median([a['seconds'] for a in runs])) if runs else None,
            'io60_peak_max': max((a['io60_peak'] for a in runs), default=None),
            'not_started': {reason: sum(1 for k in skips if k['class'] == kind and k['reason'] == reason) for reason in ('disk', 'busy')},
            'stopped': {why: sum(1 for a in runs if a.get('stopped', '').startswith(why)) for why in ('io60', 'memory', 'free disk', '/dev/shm')},
        }
    print(json.dumps(report, indent=1, sort_keys=True))
    return 0


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    commands = parser.add_subparsers(dest='command', required=True)
    one = commands.add_parser('tick', help='one pass: sign at most one pull request head')
    one.add_argument('--class', dest='kind', choices=('light', 'heavy'), required=True)
    one.add_argument('--repo', required=True, help='the clone this worker owns (created on first use)')
    one.add_argument('--repository', default='compoundingtech/fractal')
    one.add_argument('--dry-run', action='store_true', help='print the head and checks it would run, run nothing')
    report = commands.add_parser('summary', help='the coverage and wait report')
    report.add_argument('--hours', type=float, default=24)
    args = parser.parse_args(argv)

    def interrupted(signum, frame):
        raise KeyboardInterrupt
    signal.signal(signal.SIGTERM, interrupted)
    try:
        return tick(args) if args.command == 'tick' else summary(args)
    except KeyboardInterrupt:
        if CHILD is not None:
            stop(CHILD)
        say('stopped')
        return 143
    except (Failure, subprocess.SubprocessError, OSError, ValueError, KeyError) as error:
        say(f'{type(error).__name__}: {error}')
        return 2


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
