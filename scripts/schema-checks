#!/usr/bin/env python3
"""Run the tests that list every table, index and trigger whenever a change adds or drops one.

  scripts/schema-checks [--base origin/main] [--head HEAD] [--repo .] [--list]

A new table must be classified in fractal-seats' canonical audit and registered in the
large-value inventory, and a schema change can break the schema-install tests. Hosted CI does not
run those tests for every pull request, so a change that adds a table without them can reach main
red (#6957 did). This looks at the lines the change adds under crates/*/src and, if any creates or
drops a table, index, trigger or view, runs CHECKS in the repository and fails if one fails. A
change without schema statements runs nothing. scripts/review runs this before it asks the model.
"""
import argparse
import os
import re
import subprocess
import sys
from pathlib import Path

CHECKS = [
    ("canonical table audit", ["cargo", "test", "-q", "-p", "fractal-seats", "--lib", "--", "store::tests::canonical_audit"]),
    ("schema install", ["cargo", "test", "-q", "-p", "smallclaims", "--lib", "--", "store::schema_install_tests"]),
    ("large-value inventory", ["python3", "scripts/check-sqlite-large-values"]),
]

SCHEMA = re.compile(
    r"\b(?:CREATE\s+(?:TEMP\s+|TEMPORARY\s+|UNIQUE\s+)*(?:TABLE|INDEX|TRIGGER|VIEW)|DROP\s+(?:TABLE|INDEX|TRIGGER|VIEW))\b", re.I
)


def git(repo, *args):
    return subprocess.run(["git", *args], cwd=repo, check=True, capture_output=True, text=True).stdout


def schema_lines(repo, base, head):
    """The added lines under crates/*/src that create or drop a schema object, with their files."""
    merge_base = git(repo, "merge-base", base, head).strip()
    diff = git(repo, "diff", "--no-color", "--unified=0", merge_base, head, "--", ":(glob)crates/*/src/**/*.rs")
    found, path = [], None
    for line in diff.splitlines():
        if line.startswith("+++ "):
            path = line[6:] if line.startswith("+++ b/") else None
        elif line.startswith("+") and not line.startswith("+++") and path and SCHEMA.search(line):
            found.append((path, line[1:].strip()))
    return found


def run(repo, base, head):
    found = schema_lines(repo, base, head)
    if not found:
        print("schema-checks: no table, index, trigger or view added or dropped; nothing to run")
        return 0
    print(f"schema-checks: {len(found)} schema line(s) added, e.g. {found[0][0]}: {found[0][1][:100]}")
    if git(repo, "rev-parse", "HEAD").strip() != git(repo, "rev-parse", head).strip():
        print(f"schema-checks: the checkout is not at {head}; check it out to run the schema checks", file=sys.stderr)
        return 2
    failed = []
    for name, command in CHECKS:
        done = subprocess.run(command, cwd=repo, capture_output=True, text=True, env=os.environ)
        result = [line for line in (done.stdout + done.stderr).splitlines() if line.startswith("test result") or "passed" in line][-1:]
        print(f"schema-checks: {name}: {'ok' if done.returncode == 0 else 'FAILED'} {' '.join(result)}")
        if done.returncode != 0:
            failed.append(name)
            tail = "\n".join((done.stdout + done.stderr).splitlines()[-25:])
            print(tail, file=sys.stderr)
    if failed:
        print(f"schema-checks: failed: {', '.join(failed)}", file=sys.stderr)
        return 1
    return 0


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--base", default="origin/main")
    parser.add_argument("--head", default="HEAD")
    parser.add_argument("--repo", type=Path, default=Path.cwd())
    parser.add_argument("--list", action="store_true", help="print the checks and the schema lines found, run nothing")
    args = parser.parse_args()
    if args.list:
        for name, command in CHECKS:
            print(f"{name}: {' '.join(command)}")
        for path, line in schema_lines(args.repo, args.base, args.head):
            print(f"{path}: {line}")
        return 0
    return run(args.repo, args.base, args.head)


if __name__ == "__main__":
    raise SystemExit(main())
