#!/usr/bin/env python3
"""Refresh nix/typescript-client-deps.hash after pnpm-lock.yaml (or the staged sources) changed.

  scripts/nix-typescript-client-deps-hash [--system x86_64-linux] [--flake .]

The frozen pnpm installation behind `checks.<system>.typescript-client` is a fixed-output derivation.
The JSON pin records its output hash and semantic installation inputsHash. This reads the
selected flake's identity before forcing the pin guard, sets a placeholder, builds only the
installation (the check wrapper is Linux-only), and atomically writes both measured values.
It needs network and a builder for the selected system. Failure or interruption restores the
original file.
"""
import argparse
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import tempfile

sys.dont_write_bytecode = True

PLACEHOLDER = 'sha256-' + 'A' * 43 + '='
GOT = re.compile(r'^\s*got:\s+(sha256-[A-Za-z0-9+/]{43}=)\s*$', re.MULTILINE)
HASH_FILE = Path(__file__).resolve().parent.parent / 'nix/typescript-client-deps.hash'


def replace_pin(hash_file, content):
    """Replace a complete pin on the same filesystem, never exposing a partial JSON file."""
    temporary = None
    try:
        with tempfile.NamedTemporaryFile(dir=hash_file.parent, prefix=f'.{hash_file.name}.',
                                         delete=False) as output:
            temporary = Path(output.name)
            os.fchmod(output.fileno(), hash_file.stat().st_mode & 0o777)
            output.write(content)
        os.replace(temporary, hash_file)
    finally:
        if temporary is not None:
            temporary.unlink(missing_ok=True)


def interrupted(signum, frame):
    raise InterruptedError(f'hash refresh interrupted by signal {signum}')


def main(argv, nix=('nix', '--extra-experimental-features', 'nix-command flakes'), hash_file=HASH_FILE):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--system', default='x86_64-linux')
    parser.add_argument('--flake', default='.')
    args = parser.parse_args(argv)
    before = hash_file.read_bytes()
    previous = json.loads(before)
    target = f'{args.flake}#checks.{args.system}.typescript-client.installation'
    handlers = {}
    changed = False
    try:
        for signum in (signal.SIGTERM, signal.SIGHUP):
            handlers[signum] = signal.signal(signum, interrupted)
        identity = subprocess.run([*nix, 'eval', '--raw', f'{target}.inputsHash'],
                                  capture_output=True, text=True)
        if identity.returncode:
            print(identity.stderr[-2000:], file=sys.stderr)
            return 1
        inputs_hash = identity.stdout.strip()
        if not re.fullmatch(r'[0-9a-f]{64}', inputs_hash):
            print('nix-typescript-client-deps-hash: invalid installation inputsHash', file=sys.stderr)
            return 1
        pin = {'schemaVersion': 1, 'inputsHash': inputs_hash, 'hash': PLACEHOLDER}
        changed = True
        replace_pin(hash_file, (json.dumps(pin, indent=2) + '\n').encode())
        built = subprocess.run([*nix, 'build', target, '--no-link', '-L'],
                               capture_output=True, text=True)
        found = GOT.search(built.stderr)
        if not found:
            replace_pin(hash_file, before)
            changed = False
            print(built.stderr[-2000:], file=sys.stderr)
            print('nix-typescript-client-deps-hash: the build reported no hash' + (' (it succeeded with the placeholder?)' if built.returncode == 0 else ''), file=sys.stderr)
            return 1
        pin['hash'] = found.group(1)
        replace_pin(hash_file, (json.dumps(pin, indent=2) + '\n').encode())
        print(f'nix/typescript-client-deps.hash: {pin["hash"]} (inputs {pin["inputsHash"]})' + (' (unchanged)' if previous == pin else ''))
    except BaseException:
        if changed:
            replace_pin(hash_file, before)
        raise
    finally:
        for signum, handler in handlers.items():
            signal.signal(signum, handler)
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
