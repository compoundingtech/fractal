#!/usr/bin/env python3
"""Refresh nix/typescript-client-deps.hash after pnpm-lock.yaml (or the staged sources) changed.

  scripts/nix-typescript-client-deps-hash [--system x86_64-linux] [--flake .]

The frozen pnpm installation behind `checks.typescript-client` is a fixed-output derivation: Nix checks
its output against the hash in nix/typescript-client-deps.hash and, when the lockfile changed, reports the
new one. This sets a placeholder, builds, reads the hash Nix reports and writes it. It needs network
access (the installation downloads the locked packages) and, like any build, a machine the build
admission allows. The file is restored if the build fails for another reason.
"""
import argparse
from pathlib import Path
import re
import subprocess
import sys

sys.dont_write_bytecode = True

PLACEHOLDER = 'sha256-' + 'A' * 43 + '='
GOT = re.compile(r'^\s*got:\s+(sha256-[A-Za-z0-9+/]{43}=)\s*$', re.MULTILINE)
HASH_FILE = Path(__file__).resolve().parent.parent / 'nix/typescript-client-deps.hash'


def main(argv, nix=('nix', '--extra-experimental-features', 'nix-command flakes'), hash_file=HASH_FILE):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--system', default='x86_64-linux')
    parser.add_argument('--flake', default='.')
    args = parser.parse_args(argv)
    before = hash_file.read_text()
    hash_file.write_text(PLACEHOLDER + '\n')
    try:
        built = subprocess.run([*nix, 'build', f'{args.flake}#checks.{args.system}.typescript-client', '--no-link', '-L'],
                               capture_output=True, text=True)
        found = GOT.search(built.stderr)
        if not found:
            hash_file.write_text(before)
            print(built.stderr[-2000:], file=sys.stderr)
            print('nix-typescript-client-deps-hash: the build reported no hash' + (' (it succeeded with the placeholder?)' if built.returncode == 0 else ''), file=sys.stderr)
            return 1
    except BaseException:
        hash_file.write_text(before)
        raise
    hash_file.write_text(found.group(1) + '\n')
    print(f'nix/typescript-client-deps.hash: {found.group(1)}' + (' (unchanged)' if before.strip() == found.group(1) else ''))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
