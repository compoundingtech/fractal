#!/usr/bin/env python3
"""Refresh nix/typescript-client-deps.hash after pnpm-lock.yaml (or the staged sources) changed.

  scripts/nix-typescript-client-deps-hash [--system x86_64-linux] [--flake .]

The frozen pnpm installation behind `checks.<system>.typescript-client` is a fixed-output derivation.
The JSON pin records its output hash and the effect-utils narHash it was measured with. This reads
the selected flake's actual input identity, sets a placeholder, builds only the installation (the
check wrapper is Linux-only), and writes both measured values. It needs network and a builder for
the selected system. The original file is restored if evaluation or the build fails.
"""
import argparse
import json
from pathlib import Path
import re
import subprocess
import sys

sys.dont_write_bytecode = True

PLACEHOLDER = 'sha256-' + 'A' * 43 + '='
GOT = re.compile(r'^\s*got:\s+(sha256-[A-Za-z0-9+/]{43}=)\s*$', re.MULTILINE)
HASH_FILE = Path(__file__).resolve().parent.parent / 'nix/typescript-client-deps.hash'


def main(argv, nix=('nix', '--extra-experimental-features', 'nix-command flakes'), hash_file=HASH_FILE):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--system', default='x86_64-linux')
    parser.add_argument('--flake', default='.')
    args = parser.parse_args(argv)
    before = hash_file.read_text()
    previous = json.loads(before)
    target = f'{args.flake}#checks.{args.system}.typescript-client.installation'
    try:
        identity = subprocess.run([*nix, 'eval', '--raw', f'{target}.effectUtilsNarHash'],
                                  capture_output=True, text=True)
        if identity.returncode:
            print(identity.stderr[-2000:], file=sys.stderr)
            return 1
        pin = {'hash': PLACEHOLDER, 'effectUtilsNarHash': identity.stdout.strip()}
        hash_file.write_text(json.dumps(pin, indent=2) + '\n')
        built = subprocess.run([*nix, 'build', target, '--no-link', '-L'],
                               capture_output=True, text=True)
        found = GOT.search(built.stderr)
        if not found:
            hash_file.write_text(before)
            print(built.stderr[-2000:], file=sys.stderr)
            print('nix-typescript-client-deps-hash: the build reported no hash' + (' (it succeeded with the placeholder?)' if built.returncode == 0 else ''), file=sys.stderr)
            return 1
    except BaseException:
        hash_file.write_text(before)
        raise
    pin['hash'] = found.group(1)
    hash_file.write_text(json.dumps(pin, indent=2) + '\n')
    print(f'nix/typescript-client-deps.hash: {pin["hash"]} (effect-utils {pin["effectUtilsNarHash"]})' + (' (unchanged)' if previous == pin else ''))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
