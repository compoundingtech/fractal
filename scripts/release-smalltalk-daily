#!/usr/bin/env python3
"""Publish a release from the archives main already built, when main changed since the last one.

Every main commit runs "Smalltalk tag release", which builds, tests and verifies both archives and
uploads them as the `smalltalk-release` artifact. This takes the newest commit whose run succeeded,
re-verifies its checksums and sources, tags that exact commit and publishes the same bytes. Nothing
is rebuilt, so a release is always an archive a main run has already proven.

Usage: scripts/release-smalltalk-daily [--dry-run] [--tag TAG]
Environment: GH_TOKEN and GH_REPO (as for gh). Run from a full-history checkout with tags.
Needs contents: write and actions: read to publish verified artifacts. Baseline PRs use a separate job.
"""
import argparse
import json
import os
import pathlib
import re
import subprocess
import sys
import tempfile

from release_notes import FIELDS, ImpactError, render

WORKFLOW = 'release-smalltalk.yml'
SEMVER = re.compile(r'v(\d+)\.(\d+)\.(\d+)')
# Stay below GitHub's 125000-character release-body limit.
RELEASE_BODY_LIMIT = 120000
FULL_NOTES_POINTER = ('The complete notes and upgrade guide are attached as the `RELEASE-NOTES.md` asset; '
                      'complete classifications are attached as `UPGRADE-IMPACT.json`.')


DIAGNOSTIC_LIMIT = 2000
# GitHub token shapes, authorization headers and bearer credentials. Ordinary words such as "token"
# stay readable, because the cause is often a permission message. The actual token in the
# environment is also removed by value, whatever shape it has.
SECRET = re.compile(r'(?i)\b(?:gh[pousr]_|github_pat_)[A-Za-z0-9_]{20,}|'
                    r'\bauthorization\s*[:=][^\n]*|'
                    r'\b(?:bearer|basic)\s+[A-Za-z0-9._~+/=-]{16,}')


class CommandFailed(Exception):
    """A command failed; the message names the command and the cause it printed."""


def diagnostic(text):
    """The end of a command's output, credential-safe and bounded; the cause is printed last."""
    for name in ('GH_TOKEN', 'GITHUB_TOKEN'):
        value = os.environ.get(name)
        if value and len(value) >= 8:
            text = text.replace(value, '***')
    text = SECRET.sub('***', text).strip()
    if len(text) > DIAGNOSTIC_LIMIT:
        text = '...' + text[-DIAGNOSTIC_LIMIT:]
    return text


def run(*cmd, cwd=None):
    done = subprocess.run(cmd, check=False, text=True, capture_output=True, cwd=cwd)
    if done.returncode != 0:
        # Name the command by its program and subcommands, never its other arguments.
        words = [word for word in cmd[:3] if re.fullmatch(r'[a-z][a-z0-9-]*', word)]
        cause = diagnostic(done.stderr) or diagnostic(done.stdout) or 'no output'
        raise CommandFailed(f'{" ".join(words)} exited {done.returncode}: {cause}')
    return done.stdout.strip()


def say(message):
    print(f'release-smalltalk-daily: {message}', flush=True)


def newest_verified_main_run():
    rows = json.loads(run('gh', 'run', 'list', '--workflow', WORKFLOW, '--branch', 'main', '--event', 'push',
                          '--status', 'success', '--limit', '1', '--json', 'databaseId,headSha'))
    return (rows[0]['databaseId'], rows[0]['headSha']) if rows else (None, None)


def latest_release_tag():
    return run('python3', str(pathlib.Path(__file__).resolve().parent / 'compat-baseline-release'), 'latest')


def next_tag():
    versions = [tuple(map(int, m.groups())) for t in run('git', 'tag', '--list', 'v*').split()
                if (m := SEMVER.fullmatch(t))]
    major, minor, patch = max(versions)
    return f'v{major}.{minor}.{patch + 1}'


def release_body(rendered, impact):
    """Summarize oversized intervals from classifications, never from sliced Markdown."""
    if len(rendered) <= RELEASE_BODY_LIMIT:
        return rendered
    headline, marker, _ = rendered.partition('\n## Upgrade impact\n')
    if not marker:
        raise ImpactError('cannot build bounded release body: missing release headline')
    fragments = impact['fragments']
    lines = [headline.rstrip(), '', '## Upgrade impact', '',
             'Summary only: review the attached complete notes before upgrading.', '']
    for field, label in FIELDS.items():
        counts = {status: sum(f[field]['status'] == status for f in fragments)
                  for status in ('changed', 'unknown', 'none')}
        lines.append(f'- **{label}:** {counts["changed"]} changed, {counts["unknown"]} unknown, '
                     f'{counts["none"]} none.')
    lines.extend(['', '## Priority upgrade items', '',
                  'Action-required and breaking changes first; details and the full upgrade guide are attached.', ''])

    def priority(fragment):
        if fragment['manual']['status'] != 'none':
            return 0
        if (any(fragment[field].get('transitions') for field in ('schema', 'rules'))
                or any(re.search(r'\bbreaking\b', fragment[field]['detail'], re.I) for field in FIELDS)):
            return 1
        return 2

    def plain(text, limit):
        text = ' '.join(text.split())
        if len(text) > limit:
            text = text[:limit].rstrip() + '…'
        return re.sub(r'([\\`*_{}\[\]()<>])', r'\\\1', text)

    items = []
    for fragment in sorted(fragments, key=priority):
        active = [field for field in FIELDS if fragment[field]['status'] != 'none']
        if not active:
            continue
        active.sort(key=lambda field: field != 'manual')
        classification = '; '.join(f'{FIELDS[field]}: {fragment[field]["status"]}' for field in active)
        detail = fragment[active[0]]['detail']
        link = impact['change_links'][fragment['path']]
        items.append(f'- **{classification}.** {plain(fragment["summary"], 240)} — '
                     f'{plain(detail, 360)} ([PR/source]({link}))\n')
    body = '\n'.join(lines)
    # Reserve the largest possible omission count before accepting any complete entry.
    reserve = f'\n{len(items)} more upgrade items; see the attached complete notes.\n\n{FULL_NOTES_POINTER}\n'
    if len(body) + len(reserve) > RELEASE_BODY_LIMIT:
        raise ImpactError('cannot build bounded release body: headline and classification counts exceed limit')
    included = 0
    for item in items:
        if len(body) + len(item) + len(reserve) > RELEASE_BODY_LIMIT:
            break
        body += item
        included += 1
    omitted = len(items) - included
    if omitted:
        body += f'\n{omitted} more upgrade items; see the attached complete notes.\n'
    return body + '\n' + FULL_NOTES_POINTER + '\n'


def main():
    parser = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    parser.add_argument('--dry-run', action='store_true', help='verify and print the notes; publish nothing')
    parser.add_argument('--tag', help='release tag; default is the next patch after the highest v tag')
    args = parser.parse_args()
    repo = pathlib.Path(__file__).resolve().parent.parent

    run_id, sha = newest_verified_main_run()
    if sha is None:
        say('no successful main run to release')
        return 1
    previous = latest_release_tag()
    since = run('git', 'rev-parse', f'{previous}^{{commit}}', cwd=repo)
    if since == sha or subprocess.run(['git', 'merge-base', '--is-ancestor', sha, since], cwd=repo).returncode == 0:
        say(f'main has not changed since {previous} ({since}); nothing to release')
        return 0
    changed = run('git', 'diff', '--name-only', since, sha, cwd=repo).splitlines()
    if changed and all(path in ('.github/fleet-compat-baseline.json', '.github/messaging-compat-baseline.json')
                       or re.fullmatch(r'release-notes/compat-baselines-v\d+\.\d+\.\d+\.json', path)
                       for path in changed):
        say('only postpublish baseline maintenance changed; nothing to release')
        return 0
    # The previous release must have reached main before cutting its successor.
    run('python3', str(repo / 'scripts/compat-baseline-release'), 'check', '--source', sha, '--require-latest')
    tag = args.tag or next_tag()
    if subprocess.run(['git', 'rev-parse', '-q', '--verify', f'refs/tags/{tag}'], cwd=repo,
                      capture_output=True).returncode == 0:
        say(f'{tag} already exists; refusing to reuse a tag')
        return 1
    try:
        rendered, impact = render(repo, previous, sha, tag, os.environ.get('GH_REPO', 'compoundingtech/smalltalk'), since)
        body = release_body(rendered, impact)
    except ImpactError as error:
        say(str(error))
        return 1
    say(f'releasing {tag} from {sha} (run {run_id}), previous release {previous} at {since}')

    dist = pathlib.Path(tempfile.mkdtemp(prefix='smalltalk-release-'))
    run('gh', 'run', 'download', str(run_id), '--name', 'smalltalk-release', '--dir', str(dist))
    # The same checks the tag workflow makes, so the bytes are proven before they are published.
    run('sha256sum', '--check', 'SHA256SUMS', cwd=dist)
    say(run('python3', str(repo / 'scripts/release-smalltalk-manifest.py'), sha, cwd=dist))

    notes = dist / 'RELEASE-NOTES.md'
    notes.write_text(rendered)
    body_notes = dist / 'RELEASE-BODY.md'
    body_notes.write_text(body)
    (dist / 'UPGRADE-IMPACT.json').write_text(json.dumps(impact, indent=2) + '\n')
    assets = sorted(str(p) for pattern in ('*.tar.gz', '*.sha256') for p in dist.glob(pattern))
    assets += [str(dist / 'SHA256SUMS'), str(dist / 'RELEASE.json'), str(dist / 'UPGRADE-IMPACT.json'), str(notes)]
    if args.dry_run:
        print(body)
        shortened = 'shortened' if body != rendered else 'unchanged'
        say(f'dry run: release body {shortened}: {len(body)} characters '
            f'(full notes: {len(rendered)}; limit: {RELEASE_BODY_LIMIT})')
        say(f'dry run: would publish {tag} at {sha} with {len(assets)} assets, including RELEASE-NOTES.md')
        return 0

    # A draft has no tag yet. Publishing it creates the tag at exactly this commit, so a partial
    # draft can be inspected and deleted without leaving a tag behind.
    run('gh', 'release', 'create', tag, '--target', sha, '--draft', '--title', f'Fractal {tag}',
        '--notes-file', str(body_notes), *assets)
    run('gh', 'release', 'edit', tag, '--draft=false')
    tagged = run('git', 'ls-remote', 'origin', f'refs/tags/{tag}^{{}}', f'refs/tags/{tag}', cwd=repo).split()
    if sha not in tagged:
        say(f'published {tag}, but the tag does not point at {sha}: {tagged}')
        return 1
    say(f'published {tag} at {sha}')
    return 0


def entry():
    try:
        return main()
    except CommandFailed as error:
        say(str(error))
        return 1


if __name__ == '__main__':
    sys.exit(entry())
