#!/usr/bin/env python3
"""Print a checksum-verified compatibility baseline binary path, without installing it.

COMPAT_BASELINE_ARCHIVE names a local copy of the pinned bundle (a Nix build has no network and
supplies it as a fixed-output fetch). It is read in place of the download and held to the same
SHA-256 and BUILD.json checks."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import platform
import shutil
import socket
import sys
import tarfile
import tempfile
import time
import urllib.error
import urllib.parse
import urllib.request

REPO = Path(__file__).resolve().parent.parent
TARGETS = {("Linux", "x86_64"): "x86_64-unknown-linux-gnu",
           ("Darwin", "arm64"): "aarch64-apple-darwin"}


def bundle_binary(root, target):
    package = root / f"fractal-{target}"
    if not package.is_dir():
        package = root / f"smalltalk-{target}"
    legacy = package / "bin/st3"
    return legacy if legacy.is_file() else package / "bin/fractal"


def transient(error):
    return (isinstance(error, urllib.error.HTTPError) and 500 <= error.code < 600
            or isinstance(error, (TimeoutError, socket.timeout))
            or isinstance(error, urllib.error.URLError)
            and isinstance(error.reason, (TimeoutError, socket.timeout)))


def api_request(url, accept):
    request = urllib.request.Request(url, headers={
        "Accept": accept, "User-Agent": "fractal-compat-baseline"})
    token = os.environ.get("GH_TOKEN") or os.environ.get("GITHUB_TOKEN")
    if token:
        request.add_unredirected_header("Authorization", f"Bearer {token}")
    return request


def api_asset(bundle):
    url = urllib.parse.urlsplit(bundle["url"])
    parts = url.path.strip("/").split("/")
    if url.hostname != "github.com" or len(parts) != 6 or parts[2:4] != ["releases", "download"]:
        raise ValueError("API fallback requires a GitHub release download URL")
    owner, repo, _, _, tag, name = parts
    endpoint = f"https://api.github.com/repos/{owner}/{repo}/releases"
    request = api_request(f"{endpoint}/tags/{tag}", "application/vnd.github+json")
    for attempt in range(2):
        try:
            with urllib.request.urlopen(request, timeout=60) as response:
                release = json.load(response)
            break
        except (OSError, urllib.error.HTTPError) as error:
            if not transient(error) or attempt == 1:
                raise
            time.sleep(1)
    asset = next((asset for asset in release["assets"]
                  if asset["name"] == urllib.parse.unquote(name)), None)
    if asset is None:
        raise ValueError(f"API fallback: release {tag} has no asset {name}")
    return api_request(f"{endpoint}/assets/{int(asset['id'])}", "application/octet-stream")


def download(bundle, archive):
    def transfer(source):
        digest = hashlib.sha256()
        with source as response, archive.open("wb") as stream:
            while chunk := response.read(1024 * 1024):
                digest.update(chunk)
                stream.write(chunk)
        return digest.hexdigest()

    local = os.environ.get("COMPAT_BASELINE_ARCHIVE")
    if local:
        return transfer(Path(local).open("rb"))
    for delay in (1, 3, None):
        try:
            digest = transfer(urllib.request.urlopen(bundle["url"], timeout=60))
            print("compat-baseline: browser download served the archive", file=sys.stderr)
            return digest
        except (OSError, urllib.error.HTTPError) as error:
            if not transient(error):
                raise
            primary = str(error)
            if isinstance(error, urllib.error.HTTPError):
                error.close()
                if error.code in (502, 503, 504) and delay is not None:
                    print(f"compat-baseline: browser download failed ({error}); retrying in {delay}s", file=sys.stderr)
                    time.sleep(delay)
                    continue
            break
    print(f"compat-baseline: browser download failed ({primary}); trying API asset", file=sys.stderr)
    try:
        request = api_asset(bundle)
        for attempt in range(2):
            try:
                digest = transfer(urllib.request.urlopen(request, timeout=60))
                print("compat-baseline: API asset served the archive", file=sys.stderr)
                return digest
            except (OSError, urllib.error.HTTPError) as error:
                if not transient(error) or attempt == 1:
                    raise
                time.sleep(1)
    except (OSError, ValueError, KeyError) as fallback:
        raise RuntimeError(f"baseline download failed: browser: {primary}; API fallback: {fallback}") from fallback


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("baseline", choices=("fleet", "messaging"))
    parser.add_argument("output", type=Path)
    parser.add_argument("--save-archive", type=Path,
                        help="atomically retain the SHA256/BUILD.json-verified archive for other jobs")
    parser.add_argument("--target", choices=tuple(TARGETS.values()),
                        help="verify an archive for this target without running its binary")
    args = parser.parse_args()
    target = args.target or TARGETS.get((platform.system(), platform.machine()))
    if target is None:
        parser.error("no native release bundle for this platform")
    pin = json.loads((REPO / f".github/{args.baseline}-compat-baseline.json").read_text())
    bundle = pin["bundles"][target]
    print(f"compat-baseline: {args.baseline} source={pin['commit']} tag={pin['tag']} target={target}",
          file=sys.stderr)
    output = args.output.resolve()
    output.mkdir(parents=True, exist_ok=True)
    # Each immutable archive has a separate directory. Concurrent tests may safely
    # download/extract the same archive without exposing a partial executable.
    installed = output / bundle["sha256"]
    binary = bundle_binary(installed, target)
    if binary.is_file() and not args.save_archive:
        local = os.environ.get("COMPAT_BASELINE_ARCHIVE")
        if local:
            with Path(local).open("rb") as source:
                if hashlib.file_digest(source, "sha256").hexdigest() != bundle["sha256"]:
                    raise ValueError(f"{pin['tag']} bundle SHA-256 mismatch")
    if not binary.is_file() or args.save_archive:
        with tempfile.TemporaryDirectory(prefix="download-", dir=output) as temporary:
            work = Path(temporary)
            archive = work / "bundle.tar.gz"
            digest = download(bundle, archive)
            if digest != bundle["sha256"]:
                raise ValueError(f"{pin['tag']} bundle SHA-256 mismatch")
            extracted = work / "extracted"
            extracted.mkdir()
            with tarfile.open(archive) as release:
                release.extractall(extracted, filter="data")
            extracted_binary = bundle_binary(extracted, target)
            binary = installed / extracted_binary.relative_to(extracted)
            build = json.loads((extracted_binary.parent.parent / "BUILD.json").read_text())
            if build["source"] != pin["commit"] or build["target"] != target:
                raise ValueError("release BUILD.json does not match the baseline source/target")
            if not os.access(extracted_binary, os.X_OK):
                raise ValueError(f"baseline executable missing: {extracted_binary}")
            if args.save_archive:
                destination = args.save_archive.resolve()
                destination.parent.mkdir(parents=True, exist_ok=True)
                with tempfile.NamedTemporaryFile(dir=destination.parent, delete=False) as retained:
                    retained_path = Path(retained.name)
                try:
                    shutil.copyfile(archive, retained_path)
                    os.replace(retained_path, destination)
                finally:
                    retained_path.unlink(missing_ok=True)
            try:
                os.rename(extracted, installed)
            except FileExistsError:
                pass  # Another reader published the same checksum-verified archive.
            except OSError:
                if not binary.is_file():
                    raise
    if not os.access(binary, os.X_OK):
        raise ValueError(f"baseline executable missing: {binary}")
    print(binary)


if __name__ == "__main__":
    main()
