#!/usr/bin/env bash
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
set -Eeuo pipefail
umask 077

MODE=${1:-}
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
FRACTAL_BIN=${FRACTAL_BIN-${ST3_BIN:-$HOME/.local/bin/st3}} ST3_BIN=${FRACTAL_BIN-${ST3_BIN:-$HOME/.local/bin/st3}}
if [[ $MODE != --local-only && $MODE != --local-once ]]; then
  : "${FABRIC_BIN:?set FABRIC_BIN to the installed Fabric executable}"
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
  : "${FRACTAL_SOAK_EXAMPLE_MAC_BIN-${ST3_SOAK_EXAMPLE_MAC_BIN:?set ST3_SOAK_EXAMPLE_MAC_BIN to the remote installed st3 executable}}"
fi
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
JQ_BIN=${FRACTAL_SOAK_JQ_BIN-${ST3_SOAK_JQ_BIN:-$(command -v jq)}}
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
TIMEOUT_BIN=${FRACTAL_SOAK_TIMEOUT_BIN-${ST3_SOAK_TIMEOUT_BIN:-/usr/bin/timeout}}
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
STATE_DIR=${FRACTAL_SOAK_IDLE_STATE_DIR-${ST3_SOAK_IDLE_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/st3/idle-soak}}
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
LOCAL_SAMPLE="$(/usr/bin/dirname "${FRACTAL_BIN-${ST3_BIN-}}")/fractal-idle-sample"
if [[ $MODE != --local-only && $MODE != --local-once ]]; then
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
  REMOTE_SAMPLE="$(/usr/bin/dirname "${FRACTAL_SOAK_EXAMPLE_MAC_BIN-${ST3_SOAK_EXAMPLE_MAC_BIN-}}")/fractal-idle-sample"
fi
/bin/mkdir -p "$STATE_DIR"

record() {
  local host=$1 result failure
  if [[ $host == example-linux ]]; then
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
    if result=$(FRACTAL_BIN="${FRACTAL_BIN-${ST3_BIN-}}" ST3_BIN="${FRACTAL_BIN-${ST3_BIN-}}" FRACTAL_SOAK_HOST=example-linux ST3_SOAK_HOST=example-linux "$TIMEOUT_BIN" -k 5s 30s "$LOCAL_SAMPLE" 2>/dev/null); then
      failure=invalid-local-sample
    else
      failure="local-exit-$?"
      result=
    fi
  elif [[ $MODE == --local-only || $MODE == --local-once ]]; then
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
    if result=$(FRACTAL_BIN="${FRACTAL_BIN-${ST3_BIN-}}" ST3_BIN="${FRACTAL_BIN-${ST3_BIN-}}" FRACTAL_SOAK_HOST="$host" ST3_SOAK_HOST="$host" \
      /usr/bin/perl -e 'alarm 30; exec @ARGV or die $!' \
      "$LOCAL_SAMPLE" 2>/dev/null); then
      failure=invalid-local-sample
    else
      failure="local-exit-$?"
      result=
    fi
  else
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
    if result=$("$TIMEOUT_BIN" -k 5s 45s "$FABRIC_BIN" exec example-mac -- /usr/bin/env \
      "FRACTAL_BIN=${FRACTAL_SOAK_EXAMPLE_MAC_BIN-${ST3_SOAK_EXAMPLE_MAC_BIN-}}" \
      "ST3_BIN=${FRACTAL_SOAK_EXAMPLE_MAC_BIN-${ST3_SOAK_EXAMPLE_MAC_BIN-}}" FRACTAL_SOAK_HOST=example-mac ST3_SOAK_HOST=example-mac "$REMOTE_SAMPLE" 2>/dev/null); then
      failure=invalid-remote-sample
    else
      failure="remote-exit-$?"
      result=
    fi
  fi
  if [[ -n ${result:-} ]] &&
    "$JQ_BIN" -e --arg host "$host" '.host == $host and (.peer_status | type == "string")' \
      <<<"$result" >/dev/null 2>&1; then
    /usr/bin/printf '%s\n' "$result" >>"$STATE_DIR/events.jsonl"
    return
  fi
  "$JQ_BIN" -nc --arg host "$host" --argjson at "$(/bin/date -u +%s)" --arg error "$failure" \
    '{at:$at,host:$host,error:$error}' >>"$STATE_DIR/events.jsonl"
}

while true; do
  if [[ $MODE == --local-only || $MODE == --local-once ]]; then
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
    record "${FRACTAL_SOAK_HOST-${ST3_SOAK_HOST:?set ST3_SOAK_HOST to the canonical host name}}"
  else
    record example-linux
    record example-mac
  fi
  [[ $MODE == --once || $MODE == --local-once ]] && exit 0
  /bin/sleep 60
done
