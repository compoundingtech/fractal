"""Exercise config selection without launching the long-running eval harnesses."""
import ast
import pathlib
import unittest

SCRIPTS = pathlib.Path(__file__).resolve().parent


class McpNameReadersTest(unittest.TestCase):
    def test_stub_readers_select_legacy_by_presence_not_validity(self):
        legacy = {"command": "legacy"}
        renamed = {"command": "renamed"}
        malformed = {}
        cases = [
            ({"st3": legacy}, legacy),
            ({"fractal": renamed}, renamed),
            ({"st3": legacy, "fractal": renamed}, legacy),
            ({"st3": None, "fractal": renamed}, None),
            ({"st3": malformed, "fractal": renamed}, malformed),
            ({"unknown": renamed}, None),
            ({}, None),
        ]
        for script in ("fractal-no-st2-eval/claude", "fractal-boot-canaries/stub-claude.py",
                       "fractal-subagents-eval/claude"):
            tree = ast.parse((SCRIPTS / script).read_text())
            selection = [node for node in tree.body if isinstance(node, ast.Assign)
                         and any(isinstance(target, ast.Name) and target.id in ("servers", "server")
                                 for target in node.targets)]
            self.assertEqual(len(selection), 2, script)
            code = compile(ast.Module(body=selection, type_ignores=[]), script, "exec")
            for servers, expected in cases:
                with self.subTest(script=script, servers=servers):
                    namespace = {"mcp": {"mcpServers": servers}}
                    exec(code, namespace)
                    self.assertIs(namespace["server"], expected)


if __name__ == "__main__":
    unittest.main()
