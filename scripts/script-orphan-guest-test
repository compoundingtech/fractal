#!/usr/bin/env python3
"""DESTRUCTIVE parent-signal regression: only the disposable NixOS VM calls this.

The unprotected control observes orphan adoption without signalling. The guarded
case deliberately kills its new parent; both the runner failure and continued
health of the same guest user-manager PID are asserted by the VM driver.
"""
import os
from pathlib import Path
import signal
import subprocess
import sys
import time


def main():
    mode, receipt, manager = sys.argv[1:]
    manager = int(manager)
    if subprocess.check_output(['systemd-detect-virt', '--vm'], text=True).strip() != 'kvm':
        raise SystemExit('orphan-signal proof requires the disposable KVM guest')
    if Path('/etc/hostname').read_text().strip() != 'script-signal-guest':
        raise SystemExit('orphan-signal proof requires the named disposable test guest')
    # Keep the suite task alive while a short-lived intermediate forks the
    # orphan. Otherwise the guardian could clean up at task exit before the
    # orphan reaches its deliberately unsafe signal.
    intermediate = os.fork()
    if intermediate:
        os.waitpid(intermediate, 0)
        deadline = time.monotonic() + 10
        while not Path(receipt).exists():
            if time.monotonic() >= deadline:
                raise SystemExit('orphan did not record adoption')
            time.sleep(0.01)
        if mode == 'observe':
            return
        time.sleep(30)
        raise SystemExit('guardian failed to stop its task')
    # A pidfd exit event occurs after reparenting, unlike pipe EOF during
    # exit_files(), which can race the kernel's later adoption step.
    parent_fd = os.pidfd_open(os.getpid())
    if os.fork():
        os._exit(0)
    import select
    assert select.select([parent_fd], [], [], 5)[0]
    os.close(parent_fd)
    parent = os.getppid()
    Path(receipt).write_text(f'{os.getpid()} {parent}\n')
    if mode == 'observe':
        assert parent == manager, (parent, manager)
        os._exit(0)
    if mode != 'signal':
        raise SystemExit('unknown proof mode')
    # A broken subreaper implementation can kill this GUEST manager. The VM
    # driver then fails its same-PID/live-bus assertion. No host manager is used.
    os.kill(os.getppid(), signal.SIGTERM)
    time.sleep(30)


if __name__ == '__main__':
    main()
