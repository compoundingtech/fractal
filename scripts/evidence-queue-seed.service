[Unit]
Description=Shadow merge-queue signer, seed: sign the per-crate rust-tests notes of main's new tip and push them (scripts/evidence-queue-signer)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# builds.slice: with every other build on the signing host; its nextest takes the host's build slots through the admission shim.
Slice=builds.slice
Environment=PATH=%h/.local/bin:/run/current-system/sw/bin:/usr/bin:/bin
# The same minimal environment as sign: the host's signing key and the git credential the notes push uses, nothing else.
EnvironmentFile=-%h/.config/evidence-queue-signer/env
ExecStart=/usr/bin/env bash %h/.local/bin/evidence-queue-timer seed
TimeoutStartSec=4h
Nice=10
IOSchedulingClass=idle
