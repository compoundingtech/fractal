#!/usr/bin/env python3
"""ci-nextest-flaky: the flaky count comes from nextest's Summary, the FLAKY lines are a fallback,
and the step output and artifact file follow the count."""
import importlib.machinery
import importlib.util
import os
from pathlib import Path
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parent.parent
SCRIPT = ROOT / 'scripts/ci-nextest-flaky'
loader = importlib.machinery.SourceFileLoader('ci_nextest_flaky', str(SCRIPT))
spec = importlib.util.spec_from_loader(loader.name, loader)
flaky = importlib.util.module_from_spec(spec)
loader.exec_module(flaky)

RULE = '────────────'
PASS = '        PASS [   1.428s] (2180/2184) garden ui::beds::tests::a_bed_opens'
TRY = '  TRY 1 FAIL [   2.765s] (─────────) garden-e2e::transports a_client_conforms_over_a_socket'
RETRY = '  TRY 2 PASS [   2.405s] (1772/2184) garden-e2e::transports a_client_conforms_over_a_socket'


def log(summary, *final):
    return [PASS, TRY, RETRY, RULE, f'     Summary [ 325.145s] {summary}', *final,
            'Test scratch: TMPDIR=/w/t on ext2/ext3, peak du of TMPDIR 1347 MiB']


# Shaped like a real CI log: the Summary's count, then one final FLAKY line per test.
one = log('2184 tests run: 2184 passed (5 slow, 1 flaky), 6754 skipped',
          '   FLAKY 2/3 [   2.405s] (1772/2184) garden-e2e::transports a_client_conforms_over_a_socket')
assert flaky.count(one) == (1, ['FLAKY 2/3 [   2.405s] (1772/2184) garden-e2e::transports a_client_conforms_over_a_socket'])
assert flaky.count(log('2184 tests run: 2184 passed (5 slow), 6754 skipped'))[0] == 0
assert flaky.count(log('12 tests run: 12 passed, 3 skipped'))[0] == 0
several = log('900 tests run: 899 passed (3 flaky), 1 failed, 20 skipped',
              '   FLAKY 2/3 [   1.000s] garden a', '   FLAKY 3/3 [   1.000s] garden b',
              '   FLAKY 2/3 [   1.000s] garden c', '        FAIL [   1.000s] garden d')
assert flaky.count(several) == (3, ['FLAKY 2/3 [   1.000s] garden a', 'FLAKY 3/3 [   1.000s] garden b', 'FLAKY 2/3 [   1.000s] garden c'])
assert flaky.count(log('1 test run: 1 passed (1 flaky), 0 skipped'))[0] == 1, 'the Summary wins over missing FLAKY lines'
# A test's own output that mentions flakiness is not nextest's Summary or a final status line.
assert flaky.count(['this test is 4 flaky?', '  note: FLAKY tests are counted', PASS]) == (0, [])
# A run that stopped before its Summary counts the FLAKY lines it has.
assert flaky.count([PASS, '   FLAKY 2/3 [   1.000s] garden a', '   FLAKY 2/3 [   1.000s] garden b'])[0] == 2
assert flaky.count([]) == (0, [])
print('passed: Summary counts 0, 1 and several; FLAKY lines as a fallback')

with tempfile.TemporaryDirectory() as scratch:
    scratch = Path(scratch)
    output, artifact = scratch / 'output', scratch / 'nextest-flaky.txt'

    def run(lines, github_output=True, names=None):
        (scratch / 'tests.log').write_text('\n'.join(lines) + '\n')
        env = {key: value for key, value in os.environ.items() if key not in ('GITHUB_OUTPUT', 'CI_TEST_FLAKY')}
        if github_output:
            env['GITHUB_OUTPUT'] = str(output)
        if names:
            env['CI_TEST_FLAKY'] = str(names)
        return subprocess.run([sys.executable, str(SCRIPT), str(scratch / 'tests.log'), str(artifact)],
                              env=env, capture_output=True, text=True, check=True).stdout

    assert run(several) == 'nextest flaky: 3\n'
    assert output.read_text() == 'flaky=3\n'
    assert artifact.read_text().splitlines()[:2] == ['nextest flaky: 3', 'FLAKY 2/3 [   1.000s] garden a']
    assert run(log('2 tests run: 2 passed, 0 skipped')) == 'nextest flaky: 0\n'
    assert output.read_text() == 'flaky=3\nflaky=0\n'
    assert not artifact.exists(), 'nothing is uploaded for 0'
    # A local run has no GITHUB_OUTPUT and still prints the count.
    output.unlink()
    assert run(one, github_output=False) == 'nextest flaky: 1\n'
    assert not output.exists() and artifact.exists()
    # fractal-test's linux-gate (CI_TEST_FLAKY): the tests' names for the note's flaky_tests, one per line, an empty file for none.
    names = scratch / 'flaky-names.txt'
    run(several + ['   FLAKY 2/3 [  11.707s] (2139/9040) fractal::integration ui_open::a_seat'], names=names)
    assert names.read_text().splitlines() == ['fractal::integration ui_open::a_seat', 'garden a', 'garden b', 'garden c'], names.read_text()
    run(log('2 tests run: 2 passed, 0 skipped'), names=names)
    assert names.read_text() == '', 'none: an empty file'
print('passed: step output, local runs, the artifact file and the names for fractal-test')

# Workspace CI uploads the count from the four test lanes only, named per lane, kept a day.
workflow = (ROOT / '.github/workflows/fleet.yml').read_text()
uploads = [line.strip() for line in workflow.splitlines() if 'name: "nextest-flaky-' in line]
lanes = ['linux-tests', 'linux-tests-shard-2', 'linux-tests-shard-3', 'linux-tests-shard-4']
assert uploads == [f'name: "nextest-flaky-{lane}-${{{{ steps.nextest.outputs.flaky }}}}"' for lane in lanes], uploads
for lane in lanes:
    job = workflow.split(f'\n  {lane}:\n', 1)[1].split('\n  linux-', 1)[0]
    assert '        id: nextest\n' in job and 'run: nix develop -c bash scripts/ci-linux tests' in job, lane
    step = job.split('      - name: Name the flaky test count\n', 1)[1].split('\n      - ', 1)[0]
    assert "if: ${{ !cancelled() && steps.nextest.outputs.flaky != '' && steps.nextest.outputs.flaky != '0' }}" in step, step
    assert 'retention-days: 1' in step and 'continue-on-error: true' in step, step
assert workflow.count('id: nextest\n') == len(lanes), 'only the test lanes publish a count'
print('passed: the four test lanes upload nextest-flaky-<lane>-<N>')
