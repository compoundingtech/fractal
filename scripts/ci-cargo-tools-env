#!/usr/bin/env bash
# Source after Nix has placed its pinned tools on PATH. Cargo otherwise searches
# CARGO_HOME/bin before PATH, which can select a runner's rustup proxies.
# https://doc.rust-lang.org/cargo/reference/external-tools.html#custom-subcommands
ci_cargo_tools_bin="${CARGO_HOME:-$HOME/.cargo}/bin"
case "$ci_cargo_tools_bin" in
  /*) ;;
  *) printf 'CI Cargo home must be absolute\n' >&2; return 1 ;;
esac
export PATH="$PATH:$ci_cargo_tools_bin"
unset ci_cargo_tools_bin
