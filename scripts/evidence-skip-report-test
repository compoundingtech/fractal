#!/usr/bin/env python3
"""Tests for scripts/evidence-skip-report: how each check of each pull request run is counted, and who pushed the unsigned ones."""
import datetime
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
loader = importlib.machinery.SourceFileLoader('evidence_skip_report', str(ROOT / 'scripts/evidence-skip-report'))
report = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(report)
NOW = datetime.datetime(2026, 10, 25, 12, 0, tzinfo=datetime.timezone.utc)
LANES = {'lanes': {'linux-gate': {'definition_paths': ['scripts/ci-local', '.config/nextest.toml']},
                   'typescript-client': {'definition_paths': ['scripts/ci-typescript-client', 'package.json']}}}


def line(check, **fields):
    fields = {'decision': 'run', 'outcome': 'no_note', 'reason': 'no_record', 'base': 'b' * 40, **fields}
    return f'check={check} ' + ' '.join(f'{key}={value}' for key, value in fields.items())


class FakeGitHub:
    repo = 'org/repo'

    def __init__(self):
        self.runs, self.jobs, self.lines, self.files = [], {}, {}, {}

    def run(self, run_id, number, branch, decisions, files, actor='bot', hours_ago=2):
        created = (NOW - datetime.timedelta(hours=hours_ago)).strftime('%Y-%m-%dT%H:%M:%SZ')
        self.runs.append({'id': run_id, 'status': 'completed', 'created_at': created, 'actor': {'login': actor}, 'head_branch': branch,
                          'head_sha': f'{run_id:040x}', 'pull_requests': [{'number': number}]})
        self.jobs[run_id] = []
        for offset, (check, text) in enumerate(decisions.items()):
            job_id = run_id * 100 + offset
            self.jobs[run_id].append({'id': job_id, 'name': f'evidence-gate-{check}', 'status': 'completed', 'conclusion': 'success'})
            self.lines[job_id] = [text]
        self.files[number] = files

    def gh(self, *args):
        path = args[-1]
        if '/workflows/fleet.yml/runs' in path:
            return json.dumps({'total_count': len(self.runs), 'workflow_runs': sorted(self.runs, key=lambda r: r['created_at'], reverse=True)}).encode()
        if '/pulls/' in path and path.split('/pulls/')[1].split('/')[0].isdigit():
            return json.dumps([[{'filename': name} for name in self.files[int(path.split('/pulls/')[1].split('/')[0])]]]).encode()
        raise AssertionError(path)

    def items(self, path, key):
        return self.jobs[int(path.split('/runs/')[1].split('/')[0])]

    def decision_lines(self, job_id):
        return self.lines[job_id]


def git_runner(command, **kwargs):
    if command[:1] == ['git'] and 'ls-tree' in command:
        return subprocess.CompletedProcess(command, 0, b'', b'')
    if command[:1] == ['git'] and 'show' in command:
        return subprocess.CompletedProcess(command, 0, json.dumps(LANES).encode(), b'')
    return subprocess.CompletedProcess(command, 1, b'', b'no')


class SkipReport(unittest.TestCase):
    def test_lane_reads_are_pinned_and_new_malformed_never_falls_back(self):
        with tempfile.TemporaryDirectory() as folder:
            root = Path(folder)
            def git(*args):
                return subprocess.run(['git', '-C', folder, '-c', 'core.hooksPath=/dev/null',
                                       '-c', 'commit.gpgsign=false', '-c', 'user.name=t', '-c', 'user.email=t@t', *args],
                                      capture_output=True, check=True, text=True).stdout.strip()
            git('init', '-q')
            (root / '.st').mkdir()
            (root / '.st/required-lanes.json').write_text(json.dumps(LANES))
            git('add', '-A')
            git('commit', '-qm', 'old')
            old = git('rev-parse', 'HEAD')
            (root / '.fractal').mkdir()
            new_data = {'lanes': {'demo': {'definition_paths': ['new-only']}}}
            new = root / '.fractal/required-lanes.json'
            new.write_text(json.dumps(new_data))
            git('add', '-A')
            git('commit', '-qm', 'new')
            new_revision = git('rev-parse', 'HEAD')
            new.write_text('{')
            self.assertEqual(report.lanes_at(root, old, report.flip.default_runner, {})['linux-gate'],
                             LANES['lanes']['linux-gate']['definition_paths'])
            self.assertEqual(report.lanes_at(root, new_revision, report.flip.default_runner, {}), {'demo': ['new-only']})
            git('add', '-A')
            git('commit', '-qm', 'malformed')
            with self.assertRaises(ValueError):
                report.lanes_at(root, git('rev-parse', 'HEAD'), report.flip.default_runner, {})
            with self.assertRaises(RuntimeError):
                report.lanes_at(root, 'f' * 40, report.flip.default_runner, {})

    def test_each_decision_is_counted_once_in_its_category(self):
        cases = [
            ({'decision': 'skip', 'outcome': 'satisfied', 'reason': 'satisfied'}, False, 'skipped'),
            ({'outcome': 'no_note', 'reason': 'no_record'}, True, 'lane_edit'),
            ({'outcome': 'no_note', 'reason': 'no_record'}, False, 'not_signed'),
            ({'outcome': 'no_note', 'reason': 'no_record', 'tree_of': 'merge'}, False, 'merge_tree'),
            ({'outcome': 'rejected', 'reason': 'crate_uncovered', 'tree_of': 'merge'}, False, 'merge_tree'),
            ({'outcome': 'no_note', 'reason': 'no_record', 'tree_of': 'head'}, False, 'not_signed'),
            ({'outcome': 'rejected', 'reason': 'crate_uncovered'}, False, 'not_signed'),
            ({'outcome': 'rejected', 'reason': 'check_failed'}, False, 'failed'),
            ({'outcome': 'satisfied', 'reason': 'satisfied_but_not_skipped:_a_file_that_decides_skipping_changed'}, False, 'protected'),
            ({'outcome': 'satisfied', 'reason': 'satisfied_but_not_skipped:_sampled:_the_real_job_runs_anyway'}, False, 'sampled'),
            ({'outcome': 'satisfied', 'reason': 'satisfied_but_not_skipped:_shadow:_the_note_would_cover'}, False, 'shadow'),
            ({'outcome': 'unavailable', 'reason': 'no_policy'}, False, 'other'),
            # a skip is a skip even when the pull request edits the lane (the gate decided on a note for its tree)
            ({'decision': 'skip', 'outcome': 'satisfied', 'reason': 'satisfied'}, True, 'skipped'),
        ]
        for fields, lane_edit, expected in cases:
            self.assertEqual(report.classify({'decision': 'run', **fields}, lane_edit), expected, (fields, lane_edit))

    def test_a_lane_edit_is_a_changed_file_that_is_or_is_under_a_definition_path(self):
        self.assertTrue(report.touches(['scripts/ci-local'], ['scripts/ci-local']))
        self.assertTrue(report.touches(['.st/x.json'], ['.st']))
        self.assertFalse(report.touches(['scripts/ci-local-web'], ['scripts/ci-local']), 'a prefix of a name is not its directory')
        self.assertFalse(report.touches(['README.md'], ['scripts']))

    def test_the_report_counts_our_runs_per_check_and_lists_the_unsigned_with_their_seat(self):
        gh = FakeGitHub()
        gh.run(1, 101, 'agent/a', {'linux-gate': line('linux-gate'), 'typescript-client': line('typescript-client', decision='skip',
               outcome='satisfied', reason='satisfied')}, ['crates/x/src/lib.rs'])
        gh.run(2, 102, 'agent/b', {'linux-gate': line('linux-gate'), 'typescript-client': line('typescript-client')},
               ['scripts/ci-local', 'apps/x.ts'])  # edits linux-gate's lane only
        gh.run(3, 103, 'other/c', {'linux-gate': line('linux-gate')}, ['crates/y.rs'], actor='someone-else')  # not ours
        # The gate fell back to the merge tree (a protected file changed since the branch point) and no note covered it: the seat may well
        # have signed its head, so it is merge_tree, never not_signed.
        gh.run(5, 105, 'agent/e', {'linux-gate': line('linux-gate', tree_of='merge',
                                                      head_tree='fallback:protected_files_differ_from_the_branch_point')}, ['crates/w.rs'])
        gh.run(4, 104, 'agent/d', {'linux-gate': line('linux-gate')}, ['crates/z.rs'], hours_ago=30)  # outside the window
        with tempfile.TemporaryDirectory() as tmp:
            receipts = Path(tmp) / 'receipts.jsonl'
            receipts.write_text('\n'.join(json.dumps(r) for r in [{'branch': 'agent/a', 'agent': 'agent/seat-one'}, {'nonsense': 1}]) + '\nnot json\n')
            result = report.report(gh, ROOT, git_runner, NOW - datetime.timedelta(hours=24), NOW, {'bot'}, [str(receipts)])
        self.assertEqual(result['runs'], 3)
        self.assertEqual(result['checks']['linux-gate']['merge_tree'], 1)
        self.assertEqual(result['checks']['linux-gate']['not_signed'], 1)
        self.assertEqual(result['checks']['linux-gate']['lane_edit'], 1)
        self.assertEqual(result['checks']['typescript-client']['skipped'], 1)
        self.assertEqual(result['checks']['typescript-client']['not_signed'], 1, 'run 2 leaves the typescript lane alone')
        self.assertEqual([(e['pr'], e['seat'], e['checks']) for e in result['not_signed']],
                         [(101, 'agent/seat-one', ['linux-gate']), (102, 'unknown', ['typescript-client'])])
        text = report.markdown(result)
        self.assertIn('| linux-gate | 0 | 1 | 1 | 1 |', text)
        self.assertIn('#101 `agent/a`, seat agent/seat-one: linux-gate (1 run(s))', text)

    def test_unreadable_github_exits_two(self):
        def broken(command, **kwargs):
            return subprocess.CompletedProcess(command, 1, b'', b'HTTP 502')
        report.flip.time.sleep = lambda seconds: None
        with tempfile.TemporaryDirectory() as tmp:
            self.assertEqual(report.main(['--repo', 'org/repo', '--cache', tmp], runner=broken, now=NOW), 2)


if __name__ == '__main__':
    unittest.main()
