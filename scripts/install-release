#!/usr/bin/env bash
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
# Install an extracted Fractal release without restarting any service.
set -Eeuo pipefail
source_dir=$(cd "$(dirname "$0")" && pwd)/bin
bin_dir=""
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
instance="${FRACTAL_INSTANCE-${ST_INSTANCE:-}}"
quiet=false
source_preflight=false
while (($#)); do
  case $1 in
    --bin-dir) bin_dir=${2:?--bin-dir needs a directory}; shift 2 ;;
    --instance) instance=${2:?--instance needs a name}; shift 2 ;;
    --quiet) quiet=true; shift ;;
    # Internal source-installer entry point: share ownership policy, not payloads.
    --source-preflight) source_preflight=true; shift ;;
    -h | --help) echo 'Usage: ./install.sh [--bin-dir DIRECTORY] [--instance NAME] [--quiet]'; exit 0 ;;
    *) echo "unknown option: $1" >&2; exit 2 ;;
  esac
done
if [[ -n $instance ]]; then
  [[ ${#instance} -le 24 && $instance =~ ^[a-z0-9]+(-[a-z0-9]+)*$ ]] || {
    echo "install: an instance name is lowercase letters, digits and single hyphens, at most 24 characters" >&2
    exit 2
  }
  # A named instance installs below its own directory unless told otherwise.
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
  [[ -n $bin_dir ]] || bin_dir=${FRACTAL_MACOS_BIN_DIR-${ST_MACOS_BIN_DIR:-$HOME/.st-instance/$instance/bin}}
fi
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read — normalize shared installs too.
export FRACTAL_INSTANCE=$instance ST_INSTANCE=$instance
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
bin_dir=${bin_dir:-${FRACTAL_MACOS_BIN_DIR-${ST_MACOS_BIN_DIR:-$HOME/.local/bin}}}
# Follow links without requiring GNU readlink -f (the installer also runs on macOS).
# Check each hop: a Home Manager link can be dangling, and must still remain owned
# by its package manager.
refuse_nix_path() (
    # Safety net for real Nix/Home Manager layouts (normally absolute links), not a hardened path resolver.
    normalize_path() (
        prefix=$1
        missing=
        while [ ! -d "$prefix" ]; do
            missing="/$(basename "$prefix")$missing"
            prefix=$(dirname "$prefix")
        done
        normalized=$(cd "$prefix" && pwd -P)
        while [ -n "$missing" ]; do
            part=${missing%%/*}
            if [ "$missing" = "$part" ]; then missing=; else missing=${missing#*/}; fi
            case "$part" in
                ''|.) ;;
                ..) normalized=${normalized%/*} ;;
                *) normalized=${normalized%/}/$part ;;
            esac
        done
        printf '%s\n' "${normalized:-/}"
    )
    path=$1
    hops=0
    # Compare roots and candidates in the same physical spelling (/var is a
    # symlink to /private/var on macOS), even when a profile leaf is missing.
    home_root=$(normalize_path "$HOME")
    default_profiles=$home_root/.local/state/nix/profiles
    xdg_profiles=$(normalize_path "${XDG_STATE_HOME:-$HOME/.local/state}/nix/profiles")
    while :; do
        case "$path" in
            /nix/store|/nix/store/*|/nix/var/nix/profiles|/nix/var/nix/profiles/*|"$home_root/.nix-profile"|"$home_root/.nix-profile/"*|"$default_profiles"|"$default_profiles/"*|"$xdg_profiles"|"$xdg_profiles/"*)
                printf 'install: refusing to overwrite Nix-owned path %s. Upgrade through the Home Manager configuration that owns this installation: https://fractal.how/docs/reference/home-manager\n' "$1" >&2
                exit 1 ;;
        esac
        parent=$(dirname "$path")
        if [ -d "$parent" ]; then
            resolved="$(cd "$parent" && pwd -P)/$(basename "$path")"
            if [ "$resolved" != "$path" ]; then path=$resolved; continue; fi
        fi
        # A GC'd generation can leave an ancestor dangling while the leaf itself
        # is not a symlink. Resolve the nearest symlink component, retaining the
        # missing suffix, rather than treating a missing parent as unowned.
        component=$path
        suffix=
        while [ ! -L "$component" ] && [ "$component" != / ] && [ "$component" != . ]; do
            suffix="/$(basename "$component")$suffix"
            component=$(dirname "$component")
        done
        [ -L "$component" ] || break
        hops=$((hops + 1))
        [ "$hops" -le 40 ] || { printf 'install: cannot resolve installation link %s\n' "$1" >&2; exit 1; }
        link=$(readlink "$component")
        case "$link" in /*) path=$link$suffix ;; *) path="$(dirname "$component")/$link$suffix" ;; esac
        path=$(normalize_path "$path")
    done
)
ownership_names=(fractal st3 st stui)
if $source_preflight; then ownership_names+=(st3-migrate); else ownership_names+=(pty); fi
for name in "${ownership_names[@]}"; do refuse_nix_path "$bin_dir/$name"; done
macos_home=
macos_app=
if [[ $(uname -s) == Darwin ]]; then
  macos_home="${FRACTAL_MACOS_INSTALL_HOME-${ST_MACOS_INSTALL_HOME:-$HOME}}"
  mkdir -p "$macos_home"
  macos_home=$(cd "$macos_home" && pwd)
  macos_app=$(python3 - "$macos_home" "$source_preflight" <<'PY'
import os
from pathlib import Path
import sys
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
app = os.environ.get('FRACTAL_MACOS_APP_PATH', os.environ.get('ST_MACOS_APP_PATH'))
default = Path(sys.argv[1]) / 'Applications/SmallTalk.app'
instance = os.environ.get('FRACTAL_INSTANCE')
if sys.argv[2] == 'true' and instance:
    # Source installs let the helper choose its instance default; archives
    # explicitly pass their shared-app default as --app below.
    default = Path(sys.argv[1]) / '.st-instance' / instance / 'app/SmallTalk.app'
print(Path(app).expanduser().absolute() if app else default)
PY
)
fi
# A physical install is owned only with both reverse aliases. Historical installs
# used the exact fractal -> st3 link; arbitrary executables are never adopted.
refuse_foreign_fractal() {
  local canonical="$bin_dir/fractal" target name directory candidate destination_directory="$bin_dir"
  if [[ -e $canonical || -L $canonical ]]; then
    if [[ -L $canonical ]]; then
      target=$(readlink "$canonical")
      [[ $target == st3 || $target == "$bin_dir/st3" ||
        ( -n $macos_app && $target == "$macos_app/Contents/MacOS/fractal" ) ]] || {
        echo "install: refusing to replace foreign fractal command: $canonical" >&2; return 1;
      }
    elif [[ -f $canonical && -x $canonical ]]; then
      for name in st st3; do
        [[ -L $bin_dir/$name ]] && target=$(readlink "$bin_dir/$name") &&
          [[ $target == fractal || $target == "$canonical" ]] || {
            echo "install: refusing to replace foreign fractal command: $canonical" >&2; return 1;
          }
      done
    else
      echo "install: refusing to replace foreign fractal command: $canonical" >&2; return 1
    fi
  fi
  # An explicit instance coexists with the default login command; its own
  # destination still requires positive ownership above.
  [[ -z $instance ]] || return 0
  local -a directories
  # Match the helper's resolved-parent exclusion without resolving link targets.
  if [[ -n $macos_app ]]; then destination_directory=$(cd "$bin_dir" && pwd -P); fi
  IFS=: read -ra directories <<< "${PATH:-}"
  for directory in "${directories[@]}"; do
    directory=${directory:-.}
    [[ -d $directory ]] || continue
    if [[ -n $macos_app ]]; then
      directory=$(cd "$directory" && pwd -P)
    else
      directory=$(cd "$directory" && pwd)
    fi
    [[ $directory != "$destination_directory" ]] || continue
    candidate="$directory/fractal"
    if [[ -e $candidate || -L $candidate ]]; then
      if [[ -L $candidate ]]; then
        target=$(readlink "$candidate")
        [[ $target == "$canonical" || $target == "$bin_dir/st3" ||
          ( -n $macos_app && $target == "$macos_app/Contents/MacOS/fractal" ) ]] && continue
      fi
      echo "install: refusing to install: PATH contains a foreign fractal command: $candidate" >&2
      return 1
    fi
  done
}
mkdir -p "$bin_dir"
bin_dir=$(cd "$bin_dir" && pwd)
# Refuse foreign commands before either version or service-status probes.
refuse_foreign_fractal
if $source_preflight; then exit 0; fi
installed_version() {
  local version
  version=$("$1" --version 2>/dev/null) || version=unknown
  printf '%s' "${version:-unknown}"
}
old_version=unknown
new_version=$(installed_version "$source_dir/fractal")
daemon_running=false
existing=false
for name in fractal st3 st; do
  if [[ -e $bin_dir/$name || -L $bin_dir/$name ]]; then
    existing=true
    if [[ -x $bin_dir/$name ]]; then
      old_version=$(installed_version "$bin_dir/$name")
      # Service status only inspects the manager; doctor can perform maintenance.
      status=$("$bin_dir/$name" service status --json 2>/dev/null | tr -d '[:space:]') || status=
      case "$status" in *'"running":true'*) daemon_running=true ;; esac
      break
    fi
  fi
done
if $existing && ! $quiet; then
  printf 'Upgrading Fractal %s → %s in %s\n' "$old_version" "$new_version" "$bin_dir"
fi
binaries=(fractal pty)
for binary in "${binaries[@]}"; do
  [[ -f $source_dir/$binary && -x $source_dir/$binary && ! -L $source_dir/$binary ]] || {
    echo "missing executable: $binary" >&2; exit 1;
  }
done
web_source="$source_dir/../share/fractal-web"
[[ -f $web_source/index.html ]] || { echo "missing web assets: share/fractal-web/index.html" >&2; exit 1; }
for name in "${binaries[@]}" st st3 stui; do
  [[ ! -d $bin_dir/$name ]] || { echo "refusing to replace directory: $name" >&2; exit 1; }
done
mkdir -p "$bin_dir"
bin_dir=$(cd "$bin_dir" && pwd)
web_dir="$(dirname "$bin_dir")/share/fractal-web"
web_replaced=false
stage=
locked=false
rollback_ready=false
committed=false
macos=false
macos_job=
macos_locked=false
macos_lock=
macos_helper="$(cd "$(dirname "$0")" && pwd)/install-macos.py"
previous_entry_is_unchanged() {
  local previous current
  if [[ $(uname -s) == Darwin ]]; then
    previous=$(stat -f '%d:%i' "$1" 2>/dev/null) || return 1
    current=$(stat -f '%d:%i' "$2" 2>/dev/null) || return 1
  else
    previous=$(stat -c '%d:%i' -- "$1" 2>/dev/null) || return 1
    current=$(stat -c '%d:%i' -- "$2" 2>/dev/null) || return 1
  fi
  [[ -n $previous && -n $current && $previous == "$current" ]]
}
cleanup() {
  status=$?
  trap - EXIT
  set +e
  restored=true
  restore_bins=true
  if $rollback_ready && ! $committed; then
    if [[ -n $macos_job && -f $macos_job/previous.json ]]; then
      # Historical/source callers only take the helper's flock. Its restore API
      # cannot compare ownership under that lock, so even a matching snapshot
      # cannot authorize a late restore. Preserve app, links and recovery files.
      printf 'install: macOS ownership cannot be established atomically; current app and links left intact\n' >&2
      restored=false
      restore_bins=false
    fi
    if $restore_bins; then
      mkdir -p "$stage/restore" || restored=false
      for name in "${binaries[@]}" st st3 stui; do
        if [[ -e $stage/previous/$name || -L $stage/previous/$name ]]; then
          previous_entry_is_unchanged "$stage/previous/$name" "$bin_dir/$name" && continue
          # Keep backups intact; hard links need no executable-sized allocation.
          ln -P "$stage/previous/$name" "$stage/restore/$name" && \
            mv -f "$stage/restore/$name" "$bin_dir/$name" || restored=false
        else
          rm -f -- "$bin_dir/$name" || restored=false
        fi
      done
    fi
    if $web_replaced; then
      rm -rf -- "$web_dir" || restored=false
      if [[ -e $stage/previous-web ]]; then
        mv "$stage/previous-web" "$web_dir" || restored=false
      fi
    fi
  fi
  if $restored; then
    [[ -z $stage ]] || rm -rf "$stage"
    if $locked; then rmdir "$bin_dir/.smalltalk-install.lock"; fi
    if $macos_locked; then rmdir "$macos_lock"; fi
  else
    printf 'install: rollback failed; prior files remain in %s/previous; the install lock is retained\n' "$stage" >&2
    if [[ -n $macos_job ]]; then printf 'install: retained macOS app/launchd job: %s\n' "$macos_job" >&2; fi
    status=1
  fi
  exit "$status"
}
# An install killed hard leaves its lock behind; say which lock it is and how to clear it.
take_lock() {
  if mkdir "$1" 2>/dev/null; then
    return 0
  fi
  if [[ -d $1 ]]; then
    echo "fractal install: the lock $1 exists. Another install may be running. If none is, an earlier one was killed: remove the lock with rmdir '$1' and run the installer again." >&2
    exit 1
  fi
  mkdir "$1"
}
trap cleanup EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
# Serialize command-file transactions as well as the helper's existing app lock.
take_lock "$bin_dir/.smalltalk-install.lock"
locked=true
stage=$(mktemp -d "$bin_dir/.smalltalk-install.XXXXXX")
mkdir "$stage/previous"
for name in "${binaries[@]}" st st3 stui; do
  if [[ -e $bin_dir/$name || -L $bin_dir/$name ]]; then
    ln -P "$bin_dir/$name" "$stage/previous/$name"
  fi
done
cp -R "$web_source" "$stage/web"
chmod -R u+w "$stage/web"
for binary in "${binaries[@]}"; do
  cp "$source_dir/$binary" "$stage/$binary"
  chmod 0755 "$stage/$binary"
done
# LIVE-MIGRATION BRIDGE arn:lmig:smalltalk:2026-10-16-fractal-binary-aliases — DELETE at contraction — https://github.com/compoundingtech/fractal/issues/3032
ln -s fractal "$stage/st"
ln -s fractal "$stage/st3"
# LIVE-MIGRATION END arn:lmig:smalltalk:2026-10-16-fractal-binary-aliases
if [[ $(uname -s) == Darwin ]]; then
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
  macos_lock="$(dirname "$macos_app")/.${macos_app##*/}.archive-install.lock"
  mkdir -p "$(dirname "$macos_app")"
  # Different bin directories can still install the same app. This is separate
  # from the helper's flock, so invoking the helper cannot deadlock on its own lock.
  take_lock "$macos_lock"
  macos_locked=true
  refuse_nix_path "$macos_app"
  if [[ -e $macos_app ]] && ! $existing; then
    existing=true
    app_binary="$macos_app/Contents/MacOS/fractal"
    # Read retained pre-cutover apps without changing their signed contents.
    [[ -x $app_binary ]] || app_binary="$macos_app/Contents/MacOS/st3"
    old_version=$(installed_version "$app_binary")
    status=$("$app_binary" service status --json 2>/dev/null | tr -d '[:space:]') || status=
    case "$status" in *'"running":true'*) daemon_running=true ;; esac
    if ! $quiet; then
      printf 'Upgrading Fractal %s → %s in %s\n' "$old_version" "$new_version" "$macos_app"
    fi
  fi
  macos_state="$macos_home/.local/state/st3/macos-installs"
  mkdir -p "$macos_state"
  # Retain this job just as the helper's default installation does. It holds the
  # signed previous app, command links and launchd files for the existing restore API.
  macos_job=$(mktemp -d "$macos_state/install-XXXXXXXX")
  rollback_ready=true
  if $quiet; then
    python3 "$macos_helper" --from "$source_dir" --bin-dir "$bin_dir" --job "$macos_job" \
      --home "$macos_home" --app "$macos_app" >/dev/null
  else
    python3 "$macos_helper" --from "$source_dir" --bin-dir "$bin_dir" --job "$macos_job" \
      --home "$macos_home" --app "$macos_app"
  fi
  macos=true
fi
rollback_ready=true
mkdir -p "$(dirname "$web_dir")"
if [[ -e $web_dir || -L $web_dir ]]; then
  if [[ -d $web_dir && ! -L $web_dir ]]; then
    chmod -R u+w "$web_dir"
  fi
  mv "$web_dir" "$stage/previous-web"
fi
web_replaced=true
mv "$stage/web" "$web_dir"
for name in "${binaries[@]}" st st3; do
  if [[ $macos == true && ( $name == fractal || $name == st || $name == st3 ) ]]; then continue; fi
  mv -f "$stage/$name" "$bin_dir/$name"
done
# Retire the old executable; no alias or shim remains.
rm -f -- "$bin_dir/stui"
committed=true
if $existing && ! $quiet; then
  printf 'Installed CLI: %s → %s\n' "$old_version" "$(installed_version "$bin_dir/fractal")"
fi
if $daemon_running; then
  printf 'A daemon is running; it keeps its current build until you restart it: ' >&2
  printf '%q ' "$bin_dir/fractal" >&2
  if [[ -n $instance ]]; then printf '%q %q ' --instance "$instance" >&2; fi
  printf 'service restart. Check with `fractal doctor` afterwards.\nUpgrade guide: https://fractal.how/docs/guides/upgrading\n' >&2
fi
if ! $quiet; then
  printf 'Installed fractal, st -> fractal, st3 -> fractal, and pty in %s\n' "$bin_dir"
  echo 'Running services were not restarted.'
fi
