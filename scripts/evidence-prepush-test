#!/usr/bin/env python3
"""The pre-push hook and its installer, through real `git push`es to a bare remote, with a stub st-test."""
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import time
import unittest

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
ENV = dict(os.environ, GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_SYSTEM='/dev/null', LC_ALL='C',
           GIT_AUTHOR_NAME='t', GIT_AUTHOR_EMAIL='t@example.invalid', GIT_COMMITTER_NAME='t', GIT_COMMITTER_EMAIL='t@example.invalid')
STUB = '''#!/usr/bin/env python3
import json, os, sys, time
with open(os.environ['STUB_LOG'], 'a') as log:
    log.write(json.dumps({'argv': sys.argv[1:], 'in_hook': os.environ.get('ST_EVIDENCE_IN_HOOK')}) + '\\n')
if '--status' in sys.argv:
    sys.exit(int(os.environ.get('STUB_STATUS', '3')))
time.sleep(float(os.environ.get('STUB_SLEEP', '0')))
sys.exit(int(os.environ.get('STUB_RUN_EXIT', '0')))
'''


def git(repo, *args):
    done = subprocess.run(['git', '-C', str(repo), *args], capture_output=True, text=True, env=ENV)
    assert done.returncode == 0, (args, done.stderr)
    return done.stdout.strip()


class Hook(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        tmp = Path(self.tmp.name)
        git(tmp, 'init', '-q', '--bare', '-b', 'main', str(tmp / 'origin.git'))
        self.work = tmp / 'work'
        git(tmp, 'clone', '-q', str(tmp / 'origin.git'), str(self.work))
        git(self.work, 'checkout', '-q', '-b', 'main')
        (self.work / 'scripts/git-hooks').mkdir(parents=True)
        for name in ('evidence-prepush', 'install-git-hooks', 'git-hooks/pre-push'):
            shutil.copy(ROOT / 'scripts' / name, self.work / 'scripts' / name)
        (self.work / 'scripts/st-test').write_text(STUB)
        for path in (self.work / 'scripts').rglob('*'):
            if path.is_file():
                path.chmod(0o755)
        (self.work / 'a.txt').write_text('one')
        git(self.work, 'add', '.')
        git(self.work, 'commit', '-q', '-m', 'base')
        git(self.work, 'push', '-q', 'origin', 'main')
        git(self.work, 'checkout', '-q', '-b', 'feature')
        (self.work / 'b.txt').write_text('two')
        git(self.work, 'add', '.')
        git(self.work, 'commit', '-q', '-m', 'feature')
        self.log = tmp / 'stub.log'
        installed = subprocess.run(['bash', str(self.work / 'scripts/install-git-hooks')], capture_output=True, text=True, env=ENV, cwd=self.work)
        self.assertEqual(installed.returncode, 0, installed.stderr)

    def calls(self):
        return [json.loads(line) for line in self.log.read_text().splitlines()] if self.log.exists() else []

    def push(self, *refspec, **env):
        refspec = refspec or ('feature',)
        done = subprocess.run(['git', '-C', str(self.work), 'push', 'origin', *refspec], capture_output=True, text=True,
                              env=dict(ENV, STUB_LOG=str(self.log), **env))
        return done

    def remote_has(self, branch):
        return subprocess.run(['git', '-C', str(self.work), 'ls-remote', '--exit-code', '--heads', 'origin', branch],
                              capture_output=True, env=ENV).returncode == 0

    def test_a_covered_tree_is_pushed_without_running_anything(self):
        done = self.push(STUB_STATUS='0')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn('already covered', done.stderr)
        self.assertEqual([c['argv'][0] for c in self.calls()], ['--status'])
        self.assertTrue(self.remote_has('feature'))

    def test_an_uncovered_tree_is_signed_first_and_then_pushed(self):
        done = self.push(STUB_STATUS='3')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn('signed; pushing', done.stderr)
        run = self.calls()[1]
        self.assertEqual(run['argv'][:6], ['--base', 'origin/main', '--push', 'origin', '--time-limit', '1200'])
        self.assertEqual(run['in_hook'], '1')  # the run's own notes push does not run this hook again
        self.assertTrue(self.remote_has('feature'))

    def test_a_failing_check_is_reported_and_the_push_still_goes(self):
        done = self.push(STUB_STATUS='3', STUB_RUN_EXIT='1')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn('Pushing anyway', done.stderr)
        self.assertTrue(self.remote_has('feature'))

    def test_a_run_past_the_time_limit_is_stopped_and_the_push_still_goes(self):
        started = time.monotonic()
        done = self.push(STUB_STATUS='3', STUB_SLEEP='30', ST_EVIDENCE_TIME_LIMIT='1')
        self.assertLess(time.monotonic() - started, 20)
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn('did not finish', done.stderr)
        self.assertTrue(self.remote_has('feature'))

    def test_skipping_says_so_and_runs_nothing(self):
        done = self.push(ST_SKIP_EVIDENCE='1')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn('NOT signing', done.stderr)
        self.assertEqual(self.calls(), [])
        self.assertTrue(self.remote_has('feature'))

    def test_a_status_it_cannot_read_is_not_a_reason_to_block_or_sign(self):
        done = self.push(STUB_STATUS='1')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn('could not tell', done.stderr)
        self.assertEqual([c['argv'][0] for c in self.calls()], ['--status'])
        self.assertTrue(self.remote_has('feature'))

    def test_the_base_branch_deletes_tags_and_other_branches_are_left_alone(self):
        git(self.work, 'tag', 'v1')
        git(self.work, 'branch', 'other')
        for refspec in (('v1',), ('other',), ('feature:refs/notes/evidence/x',)):
            self.assertEqual(self.push(*refspec).returncode, 0)
        self.assertEqual(self.push('feature').returncode, 0)  # creates feature on the remote (runs the hook once)
        before = len(self.calls())
        self.assertEqual(self.push('--delete', 'feature').returncode, 0)
        git(self.work, 'checkout', '-q', 'main')
        self.assertEqual(self.push('main').returncode, 0)
        self.assertEqual(len(self.calls()), before)

    def test_the_hook_inside_the_run_does_nothing(self):
        done = self.push(ST_EVIDENCE_IN_HOOK='1')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(self.calls(), [])

    def test_the_installer_is_idempotent_and_never_replaces_a_hook_it_did_not_write(self):
        hook = self.work / '.git/hooks/pre-push'
        first = hook.read_text()
        again = subprocess.run(['bash', str(self.work / 'scripts/install-git-hooks')], capture_output=True, text=True, env=ENV, cwd=self.work)
        self.assertEqual((again.returncode, hook.read_text()), (0, first))
        hook.write_text('#!/bin/sh\necho mine\n')
        refused = subprocess.run(['bash', str(self.work / 'scripts/install-git-hooks')], capture_output=True, text=True, env=ENV, cwd=self.work)
        self.assertEqual(refused.returncode, 0)
        self.assertIn('not ours', refused.stderr)
        self.assertEqual(hook.read_text(), '#!/bin/sh\necho mine\n')
        subprocess.run(['bash', str(self.work / 'scripts/install-git-hooks'), '--uninstall'], check=True, env=ENV, cwd=self.work)
        self.assertTrue(hook.exists())  # not ours: untouched by --uninstall
        hook.unlink()
        subprocess.run(['bash', str(self.work / 'scripts/install-git-hooks')], check=True, capture_output=True, env=ENV, cwd=self.work)
        subprocess.run(['bash', str(self.work / 'scripts/install-git-hooks'), '--uninstall'], check=True, env=ENV, cwd=self.work)
        self.assertFalse(hook.exists())

    def test_the_installer_leaves_a_configured_hooks_directory_alone(self):
        (self.work / '.git/hooks/pre-push').unlink()
        git(self.work, 'config', 'core.hooksPath', str(Path(self.tmp.name) / 'elsewhere'))
        done = subprocess.run(['bash', str(self.work / 'scripts/install-git-hooks')], capture_output=True, text=True, env=ENV, cwd=self.work)
        self.assertEqual(done.returncode, 0)
        self.assertIn('core.hooksPath is set', done.stderr)
        self.assertFalse((self.work / '.git/hooks/pre-push').exists())

    def test_a_checkout_without_st_test_pushes_untouched(self):
        (self.work / 'scripts/st-test').unlink()
        done = self.push()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn('not in this checkout', done.stderr)
        self.assertTrue(self.remote_has('feature'))


if __name__ == '__main__':
    unittest.main()
