#!/usr/bin/env python3
"""The pre-push hook and its installer, through real `git push`es to a bare remote, with a stub fractal-test."""
import json
import os
from pathlib import Path
import pty
import shutil
import signal
import subprocess
import sys
import tempfile
import time
import unittest

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
# Hermetic: nothing of the caller's ST_*/EVIDENCE_* settings, git config or HOME reaches the hook.
CLEAN = {k: v for k, v in os.environ.items() if not k.startswith(('ST_', 'EVIDENCE_', 'GIT_', 'STUB_')) and k not in ('GITHUB_ACTIONS', 'CI')}
CLEAN.update(GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_SYSTEM='/dev/null', LC_ALL='C',
             GIT_AUTHOR_NAME='t', GIT_AUTHOR_EMAIL='t@example.invalid', GIT_COMMITTER_NAME='t', GIT_COMMITTER_EMAIL='t@example.invalid')
SELECTING = ('GIT_DIR', 'GIT_WORK_TREE', 'GIT_INDEX_FILE', 'GIT_OBJECT_DIRECTORY', 'GIT_ALTERNATE_OBJECT_DIRECTORIES', 'GIT_COMMON_DIR',
             'GIT_NAMESPACE', 'GIT_PREFIX', 'GIT_QUARANTINE_PATH', 'GIT_AUTHOR_NAME', 'GIT_AUTHOR_EMAIL', 'GIT_COMMITTER_NAME', 'GIT_COMMITTER_EMAIL')
STUB = '''#!/usr/bin/env python3
import json, os, signal, sys, time
with open(os.environ['STUB_LOG'], 'a') as log:
    log.write(json.dumps({'argv': sys.argv[1:], 'in_hook': os.environ.get('ST_EVIDENCE_IN_HOOK'), 'pid': os.getpid(),
                          'pgid': os.getpgid(0), 'cwd': os.getcwd(),
                          'git_env': sorted(k for k in os.environ if k.startswith('GIT_'))}) + '\\n')
if os.environ.get('STUB_FIXTURE'):
    # What the repository's own fixture tests do: make a repository somewhere else and talk to it with `git -C`.
    import subprocess, tempfile
    elsewhere = tempfile.mkdtemp()
    for args in (['init', '-q'], ['config', 'user.name', 'Fixture Observer'], ['config', 'user.email', 'observer@example.invalid'],
                 ['commit', '-q', '--allow-empty', '-m', 'initial'], ['checkout', '-q', '-b', 'accepted-main'],
                 ['commit', '-q', '--allow-empty', '-m', 'author']):
        subprocess.run(['git', '-C', elsewhere, *args], check=True, capture_output=True)
if '--status' in sys.argv:
    time.sleep(float(os.environ.get('STUB_STATUS_SLEEP', '0')))
    print(os.environ.get('STUB_STATUS_OUT', ''))
    sys.exit(int(os.environ.get('STUB_STATUS', '3')))
signal.signal(signal.SIGTERM, lambda *a: (open(os.environ['STUB_LOG'], 'a').write('{"terminated": true}\\n'), sys.exit(143)))
if os.environ.get('STUB_GRANDCHILD'):
    import subprocess
    grand = subprocess.Popen(['sh', '-c', 'trap "" TERM; sleep 120'])  # ignores TERM: only KILL of the group ends it
    with open(os.environ['STUB_LOG'], 'a') as log:
        log.write(json.dumps({'grandchild': grand.pid}) + '\\n')
time.sleep(float(os.environ.get('STUB_SLEEP', '0')))
with open(os.environ['STUB_LOG'], 'a') as log:
    log.write(json.dumps({'done': True}) + '\\n')
sys.exit(int(os.environ.get('STUB_RUN_EXIT', '0')))
'''


def git(repo, *args):
    done = subprocess.run(['git', '-C', str(repo), *args], capture_output=True, text=True, env=CLEAN)
    assert done.returncode == 0, (args, done.stderr)
    return done.stdout.strip()


class Hook(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        tmp = Path(self.tmp.name)
        self.home = tmp / 'home'
        (self.home / '.config/st').mkdir(parents=True)
        (self.home / '.config/st/evidence-sign.json').write_text(json.dumps({'signer': 'host/box'}))
        git(tmp, 'init', '-q', '--bare', '-b', 'main', str(tmp / 'origin.git'))
        self.work = tmp / 'work'
        git(tmp, 'clone', '-q', str(tmp / 'origin.git'), str(self.work))
        # No automatic maintenance: after each push the remote's receive-pack starts a detached `git maintenance run
        # --auto`, which can still be writing into origin.git while the temporary directory is removed ("Directory not
        # empty: 'origin.git'"). A commit in the clone does the same there.
        for repo in (tmp / 'origin.git', self.work):
            git(repo, 'config', 'maintenance.auto', 'false')
            git(repo, 'config', 'gc.auto', '0')
        git(self.work, 'checkout', '-q', '-b', 'main')
        (self.work / 'scripts').mkdir(parents=True)
        (self.work / '.st').mkdir()
        (self.work / '.st/evidence-keys').write_text('host/box namespaces="git" ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\n')
        for name in ('evidence-prepush', 'install-git-hooks'):
            shutil.copy(ROOT / 'scripts' / name, self.work / 'scripts' / name)
        (self.work / 'scripts/st-test').write_text(STUB)
        for path in (self.work / 'scripts').rglob('*'):
            if path.is_file():
                path.chmod(0o755)
        (self.work / 'a.txt').write_text('one')
        git(self.work, 'add', '.')
        git(self.work, 'commit', '-q', '-m', 'base')
        git(self.work, 'push', '-q', 'origin', 'main')
        git(self.work, 'checkout', '-q', '-b', 'feature')
        (self.work / 'b.txt').write_text('two')
        git(self.work, 'add', '.')
        git(self.work, 'commit', '-q', '-m', 'feature')
        self.log = tmp / 'stub.log'
        self.assertEqual(self.install().returncode, 0)

    def env(self, **extra):
        return dict(CLEAN, HOME=str(self.home), STUB_LOG=str(self.log), **extra)

    def install(self, *args):
        return subprocess.run(['bash', str(self.work / 'scripts/install-git-hooks'), *args], capture_output=True, text=True,
                              env=self.env(), cwd=self.work)

    def entries(self):
        return [json.loads(line) for line in self.log.read_text().splitlines()] if self.log.exists() else []

    def calls(self):
        return [e for e in self.entries() if 'argv' in e]

    def push(self, *refspec, tty=False, **env):
        command = ['git', '-C', str(self.work), 'push', 'origin', *(refspec or ('feature',))]
        if not tty:  # no terminal on stderr: the hook treats this as an agent
            return subprocess.run(command, capture_output=True, text=True, env=self.env(**env))
        master, slave = pty.openpty()  # a terminal on stderr: an interactive push
        done = subprocess.run(command, stdout=subprocess.PIPE, stderr=slave, text=True, env=self.env(**env))
        os.close(slave)
        output = b''
        try:
            while True:
                chunk = os.read(master, 65536)
                if not chunk:
                    break
                output += chunk
        except OSError:
            pass
        os.close(master)
        done.stderr = output.decode(errors='replace').replace('\r\n', '\n')
        return done

    def remote_has(self, ref):
        return subprocess.run(['git', '-C', str(self.work), 'ls-remote', '--exit-code', 'origin', ref], capture_output=True,
                              env=CLEAN).returncode == 0

    def untouched(self, done, ref=None):
        """The push went, nothing was asked of fractal-test, and the hook said nothing."""
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(self.calls(), [])
        self.assertNotIn('evidence:', done.stderr)
        if ref:
            self.assertTrue(self.remote_has(ref))

    def base_runners(self, runners):
        git(self.work, 'checkout', '-q', 'main')
        for name in ('fractal-test', 'st-test'):
            (self.work / 'scripts' / name).unlink(missing_ok=True)
        for name, source in runners.items():
            (self.work / 'scripts' / name).write_text(source)
        git(self.work, 'add', '-A')
        git(self.work, 'commit', '-q', '-m', 'base runners')
        git(self.work, '-c', 'core.hooksPath=/dev/null', 'push', '-q', 'origin', 'main')
        git(self.work, 'checkout', '-q', 'feature')

    def test_a_st_test_only_base_still_checks_coverage(self):
        done = self.push(STUB_STATUS='0')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual([c['argv'][0] for c in self.calls()], ['--status'])

    def test_both_base_names_copy_st_test_not_the_python_shim(self):
        self.base_runners({'st-test': STUB, 'fractal-test': 'raise RuntimeError("POISON: shim must not be copied")\n'})
        done = self.push(STUB_STATUS='0')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertNotIn('POISON', done.stderr)
        self.assertEqual([c['argv'][0] for c in self.calls()], ['--status'])

    def test_a_base_without_either_runner_does_no_work(self):
        self.base_runners({})
        self.untouched(self.push())

    def test_a_base_with_only_the_human_runner_does_no_work(self):
        self.base_runners({'fractal-test': STUB})
        self.untouched(self.push())

    def test_a_st_test_only_base_still_refuses_an_uncovered_agent_push(self):
        done = self.push(ST_AGENT='agent/some/seat', STUB_STATUS='3')
        self.assertNotEqual(done.returncode, 0, done.stderr)
        self.assertIn('scripts/fractal-test --push origin', done.stderr)
        self.assertEqual([c['argv'][0] for c in self.calls()], ['--status'])

    def test_a_covered_tree_is_pushed_silently_without_running_anything(self):
        done = self.push(STUB_STATUS='0')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertNotIn('evidence:', done.stderr)
        self.assertEqual([c['argv'][0] for c in self.calls()], ['--status'])
        self.assertTrue(self.remote_has('refs/heads/feature'))

    def test_an_uncovered_tree_is_signed_first_and_then_pushed(self):
        done = self.push(STUB_STATUS='3')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn('signed; pushing', done.stderr)
        calls = self.calls()
        self.assertEqual([c['argv'][0] for c in calls], ['--status', '--base'])
        self.assertEqual(calls[1]['argv'][:6], ['--base', 'origin/main', '--push', 'origin', '--time-limit', '1200'])
        self.assertEqual(calls[1]['in_hook'], '1')  # the run's own notes push does not run this hook again
        self.assertTrue(self.remote_has('refs/heads/feature'))

    def test_a_failing_check_or_a_refusal_is_reported_distinctly_and_the_push_still_goes(self):
        done = self.push(STUB_STATUS='3', STUB_RUN_EXIT='1')
        self.assertIn('a check failed or could not be signed', done.stderr)
        self.assertNotIn('could not run', done.stderr)
        self.assertTrue(self.remote_has('refs/heads/feature'))
        (self.work / 'c.txt').write_text('three')
        git(self.work, 'add', '.')
        git(self.work, 'commit', '-q', '-m', 'more')
        done = self.push(STUB_STATUS='3', STUB_RUN_EXIT='2')
        self.assertIn('signing could not run (exit 2', done.stderr)
        self.assertEqual(done.returncode, 0, done.stderr)

    def test_a_run_past_the_time_limit_is_terminated_then_the_push_goes(self):
        started = time.monotonic()
        done = self.push(STUB_STATUS='3', STUB_SLEEP='60', ST_EVIDENCE_TIME_LIMIT='1', tty=True)
        self.assertLess(time.monotonic() - started, 30)
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn('did not finish', done.stderr)
        self.assertIn({'terminated': True}, self.entries())  # TERM first, so a real fractal-test removes its worktree
        self.assertTrue(self.remote_has('refs/heads/feature'))

    def test_a_status_that_hangs_does_not_hold_the_push(self):
        started = time.monotonic()
        done = self.push(STUB_STATUS='0', STUB_STATUS_SLEEP='60', ST_EVIDENCE_STATUS_TIMEOUT='1')
        self.assertLess(time.monotonic() - started, 30)
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn('could not tell whether the tree is covered in time', done.stderr)
        self.assertTrue(self.remote_has('refs/heads/feature'))

    def test_a_time_limit_that_is_not_a_positive_integer_is_replaced_and_said(self):
        for bad in ('0', '-5', 'soon', ''):
            self.log.unlink(missing_ok=True)
            done = self.push(STUB_STATUS='3', ST_EVIDENCE_TIME_LIMIT=bad)
            self.assertEqual(done.returncode, 0, (bad, done.stderr))
            self.assertIn('is not a positive integer; using 1200', done.stderr)
            self.assertEqual(self.calls()[1]['argv'][-1], '1200')
            git(self.work, 'commit', '-q', '--allow-empty', '-m', f'again {bad}')

    def test_the_skip_flag_does_not_wait_but_still_signs_in_the_background(self):
        started = time.monotonic()
        done = self.push(ST_SKIP_EVIDENCE='1', STUB_STATUS='3', STUB_SLEEP='4', tty=True)  # even at a terminal: no wait
        self.assertLess(time.monotonic() - started, 3)
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn('ST_SKIP_EVIDENCE=1: not waiting. The checks are signed in the background', done.stderr)
        self.assertIn('runs that check in full', done.stderr)
        self.assertTrue(self.remote_has('refs/heads/feature'))
        self.assertNotIn({'done': True}, self.entries())
        self.wait_done()  # the signing run went on by itself
        self.assertEqual([c['argv'][0] for c in self.calls()], ['--status', '--base'])
        self.assertEqual(self.receipts()[-1]['outcome'], 'skip_flag')
        self.assertTrue(list((self.home / '.local/state/st3/evidence-prepush').glob('*.log')))

    def test_local_off_does_no_local_work_at_all_and_says_so_in_one_line(self):
        for env in ({}, {'ST_SKIP_EVIDENCE': '1'}):  # it wins over the skip flag, which would start background work
            with self.subTest(env):
                git(self.work, 'commit', '-q', '--allow-empty', '-m', f'again {env}')
                done = self.push('--force', 'feature', ST_EVIDENCE_LOCAL='off', STUB_STATUS='3', **env)
                self.assertEqual(done.returncode, 0, done.stderr)
                self.assertEqual([line for line in done.stderr.splitlines() if line.startswith('evidence:')],
                                 ["evidence: ST_EVIDENCE_LOCAL=off: no local signing work for this push; the pull request's checks run in CI"])
                self.assertEqual(self.calls(), [])  # not even the status question
                self.assertEqual(self.receipts()[-1]['outcome'], 'local_off')
                self.assertTrue(self.remote_has('refs/heads/feature'))

    def test_the_skip_flag_on_a_covered_tree_is_as_quiet_as_without_it(self):
        done = self.push(ST_SKIP_EVIDENCE='1', STUB_STATUS='0')
        self.assertNotIn('evidence:', done.stderr)
        self.assertEqual(self.receipts()[-1]['outcome'], 'covered')

    def test_a_status_it_cannot_read_is_not_a_reason_to_block_or_sign(self):
        done = self.push(STUB_STATUS='2')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn('could not tell', done.stderr)
        self.assertEqual([c['argv'][0] for c in self.calls()], ['--status'])
        self.assertTrue(self.remote_has('refs/heads/feature'))

    def test_without_a_signing_key_it_says_what_to_run_and_does_not_call_the_checks_failed(self):
        (self.home / '.config/st/evidence-sign.json').unlink()
        done = self.push()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn('scripts/evidence-keygen', done.stderr)
        self.assertNotIn('did not all pass', done.stderr)
        self.assertEqual(self.calls(), [])
        self.assertTrue(self.remote_has('refs/heads/feature'))

    def test_the_missing_signing_key_is_said_once_per_machine_and_the_next_pushes_are_quiet(self):
        (self.home / '.config/st/evidence-sign.json').unlink()
        first = self.push()
        self.assertEqual(first.returncode, 0, first.stderr)
        self.assertIn('scripts/evidence-keygen', first.stderr)
        self.assertIn('ST_SKIP_EVIDENCE=1', first.stderr)
        self.assertIn('once per machine', first.stderr)
        git(self.work, 'commit', '-q', '--allow-empty', '-m', 'again')
        second = self.push()
        self.assertEqual(second.returncode, 0, second.stderr)
        self.assertNotIn('evidence-keygen', second.stderr)
        self.assertNotIn('evidence:', second.stderr)
        self.assertEqual(self.calls(), [])
        self.assertTrue(self.remote_has('refs/heads/feature'))
        # A key that appears later is used again: the notice is only about the missing key.
        (self.home / '.config/st/evidence-sign.json').write_text(json.dumps({'signer': 'host/box'}))
        git(self.work, 'commit', '-q', '--allow-empty', '-m', 'with a key')
        third = self.push()
        self.assertEqual(third.returncode, 0, third.stderr)
        self.assertNotIn('no signing key', third.stderr)
        self.assertEqual([c['argv'][0] for c in self.calls()][:1], ['--status'])

    def test_tags_notes_deletes_and_the_base_branch_are_untouched_and_silent(self):
        git(self.work, 'tag', 'v1')
        self.untouched(self.push('v1'), 'refs/tags/v1')
        self.untouched(self.push('feature:refs/notes/evidence/x'), 'refs/notes/evidence/x')
        git(self.work, 'checkout', '-q', 'main')
        git(self.work, 'commit', '-q', '--allow-empty', '-m', 'main moves')
        self.untouched(self.push('main'), 'refs/heads/main')
        git(self.work, 'checkout', '-q', 'feature')
        self.assertEqual(self.push('feature').returncode, 0)  # creates feature on the remote (the hook runs once)
        before = len(self.calls())
        self.assertGreater(before, 0)
        done = self.push('--delete', 'feature')
        self.assertEqual((done.returncode, len(self.calls()), 'evidence:' in done.stderr), (0, before, False))
        self.assertFalse(self.remote_has('refs/heads/feature'))

    def test_a_branch_that_is_not_checked_out_is_untouched(self):
        git(self.work, 'branch', 'other', 'HEAD~1')
        self.untouched(self.push('other'), 'refs/heads/other')

    def test_several_refs_in_one_push_sign_the_checked_out_tree_once(self):
        git(self.work, 'branch', 'other', 'HEAD~1')
        done = self.push('feature', 'other')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual([c['argv'][0] for c in self.calls()], ['--status', '--base'])
        self.assertTrue(self.remote_has('refs/heads/feature') and self.remote_has('refs/heads/other'))

    def test_a_detached_head_pushed_to_a_branch_is_the_checked_out_tree(self):
        git(self.work, 'checkout', '-q', '--detach')
        done = self.push('HEAD:refs/heads/detached')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn('signed; pushing', done.stderr)
        self.assertTrue(self.remote_has('refs/heads/detached'))

    def test_uncommitted_changes_to_tracked_files_mean_no_signing_and_say_so(self):
        (self.work / 'b.txt').write_text('edited, not committed')
        done = self.push()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn('uncommitted changes', done.stderr)
        self.assertEqual(self.calls(), [])
        self.assertTrue(self.remote_has('refs/heads/feature'))

    def test_a_remote_given_as_a_url_is_pushed_untouched(self):
        url = str(Path(self.tmp.name) / 'origin.git')
        done = subprocess.run(['git', '-C', str(self.work), 'push', url, 'feature'], capture_output=True, text=True, env=self.env())
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertNotIn('evidence:', done.stderr)  # no <url>/main tracking ref: the stub does nothing
        self.assertEqual(self.calls(), [])

    def test_an_exception_inside_the_hook_never_blocks_the_push(self):
        # No git on PATH: the hook's own first command raises FileNotFoundError.
        done = subprocess.run([sys.executable, str(self.work / 'scripts/evidence-prepush'), 'origin'], input='', capture_output=True,
                              text=True, cwd=self.work, env=dict(self.env(), PATH='/nonexistent'))
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn('FileNotFoundError', done.stderr)
        self.assertIn('pushing anyway', done.stderr)

    def test_a_missing_python3_never_blocks_the_push(self):
        directories = [d for d in os.environ['PATH'].split(':') if 'recorder' not in d]
        real = lambda name: os.path.realpath(shutil.which(name, path=':'.join(directories)))
        bin_dir = Path(self.tmp.name) / 'bin'
        bin_dir.mkdir()
        for name in ('bash', 'git', 'mktemp', 'tar', 'rm', 'cat'):
            (bin_dir / name).symlink_to(real(name))
        done = subprocess.run(['git', '-C', str(self.work), 'push', 'origin', 'feature'], capture_output=True, text=True,
                              env=dict(self.env(), PATH=str(bin_dir)))
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn('python3 is not on PATH', done.stderr)
        self.assertTrue(self.remote_has('refs/heads/feature'))

    def test_ctrl_c_stops_the_run_and_everything_in_its_process_group(self):
        refs = subprocess.run(['git', '-C', str(self.work), 'rev-parse', 'HEAD'], capture_output=True, text=True, env=CLEAN).stdout.strip()
        hook = subprocess.Popen([sys.executable, str(self.work / 'scripts/evidence-prepush'), 'origin'], stdin=subprocess.PIPE,
                                stderr=subprocess.PIPE, text=True, cwd=self.work,
                                env=self.env(STUB_STATUS='3', STUB_SLEEP='60'))
        hook.stdin.write(f'refs/heads/feature {refs} refs/heads/feature {"0" * 40}\n')
        hook.stdin.close()
        deadline = time.monotonic() + 20
        child = None
        while time.monotonic() < deadline and child is None:
            run = [c for c in self.calls() if c.get('argv', [''])[0] == '--base']
            child = run[0] if run else None
            time.sleep(0.1)
        self.assertIsNotNone(child, 'the signing run never started')
        hook.send_signal(signal.SIGINT)
        code = hook.wait(timeout=30)
        self.assertEqual(code, 0)
        self.assertIn('interrupted', hook.stderr.read())
        with self.assertRaises(ProcessLookupError):
            os.kill(child['pid'], 0)  # the run is gone, not orphaned

    def linked_worktree(self):
        """A linked worktree on its own branch, as every agent seat has: git exports GIT_DIR to a hook only for a push made from one."""
        path = Path(self.tmp.name) / 'linked'
        git(self.work, 'worktree', 'add', '-q', str(path), '-b', 'linked', 'feature')
        (path / 'c.txt').write_text('three')
        git(path, 'add', '.')
        git(path, 'commit', '-q', '-m', 'linked work')
        return path

    def push_from(self, path, *refspec, **env):
        return subprocess.run(['git', '-C', str(path), 'push', 'origin', *(refspec or ('linked',))], capture_output=True, text=True,
                              env=self.env(**env))

    def fingerprint(self, linked):
        """Everything of the caller's repository a stray git command could change, except the push's own remote-tracking refs."""
        parts = [(self.work / '.git/config').read_text(), git(linked, 'rev-parse', 'HEAD'), git(linked, 'status', '--porcelain'),
                 git(self.work, 'for-each-ref', '--format=%(refname) %(objectname)', 'refs/heads', 'refs/tags', 'refs/notes'),
                 git(linked, 'branch', '--show-current')]
        return '\n--\n'.join(parts)

    def test_git_exports_gitdir_to_a_hook_run_from_a_linked_worktree_and_nothing_it_starts_receives_it(self):
        linked = self.linked_worktree()
        probe = self.work / '.git/hooks/pre-push'
        saved = probe.read_text()
        probe.write_text('#!/usr/bin/env bash\nenv | grep "^GIT_DIR=" > "$STUB_LOG.hookenv"\nexit 0\n')
        done = self.push_from(linked)
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertTrue(Path(str(self.log) + '.hookenv').read_text().startswith('GIT_DIR='), 'the precondition: GIT_DIR reaches the hook')
        probe.write_text(saved)
        self.log.unlink(missing_ok=True)
        git(linked, 'commit', '-q', '--allow-empty', '-m', 'again')
        done = self.push_from(linked, STUB_STATUS='3')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual([c['argv'][0] for c in self.calls()], ['--status', '--base'])
        for call in self.calls():
            leaked = [name for name in call['git_env'] if name in SELECTING or name.startswith('GIT_PUSH_OPTION')]
            self.assertEqual(leaked, [], call)  # neither the --status call nor the signing run saw a repository- or identity-selecting variable

    def test_transport_and_credential_variables_survive_for_the_notes_push(self):
        linked = self.linked_worktree()
        done = self.push_from(linked, STUB_STATUS='3', GIT_SSH_COMMAND='ssh -i /nowhere', GIT_ASKPASS='/nowhere', GIT_TERMINAL_PROMPT='0')
        self.assertEqual(done.returncode, 0, done.stderr)
        for call in self.calls():
            self.assertTrue({'GIT_SSH_COMMAND', 'GIT_ASKPASS', 'GIT_TERMINAL_PROMPT'} <= set(call['git_env']), call)

    def test_checks_that_make_repositories_elsewhere_cannot_reach_the_callers_through_the_hooks_environment(self):
        linked = self.linked_worktree()
        before = self.fingerprint(linked)
        done = self.push_from(linked, STUB_STATUS='3', STUB_FIXTURE='1')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual([c['argv'][0] for c in self.calls()], ['--status', '--base'])
        self.assertTrue(self.remote_has('refs/heads/linked'))
        self.assertEqual(self.fingerprint(linked), before)  # the caller's config, HEAD, status, branches and tags are byte-identical
        self.assertNotIn('Fixture Observer', (self.work / '.git/config').read_text())
        self.assertEqual(git(self.work, 'branch', '--list', 'accepted-main'), '')
        self.assertEqual(subprocess.run(['git', '-C', str(Path(self.tmp.name) / 'origin.git'), 'branch', '--list', 'accepted-main'],
                                        capture_output=True, text=True, env=CLEAN).stdout.strip(), '')  # nothing reached the remote either

    def source_git_env_clean(self, prelude='', **env):
        return subprocess.run(['bash', '-c', prelude + '. scripts/git-env-clean; env'], cwd=ROOT, capture_output=True, text=True,
                              env=dict(CLEAN, **env))

    def test_sourcing_git_env_clean_drops_the_selecting_variables_and_keeps_the_rest(self):
        done = self.source_git_env_clean(GIT_DIR='/nowhere', GIT_WORK_TREE='/nowhere', GIT_INDEX_FILE='/nowhere', GIT_AUTHOR_NAME='a',
                                         GIT_PUSH_OPTION_COUNT='1', GIT_SSH_COMMAND='ssh', GIT_ASKPASS='x', KEEP='yes')
        self.assertEqual(done.returncode, 0, done.stderr)
        for name in ('GIT_DIR=', 'GIT_WORK_TREE=', 'GIT_INDEX_FILE=', 'GIT_AUTHOR_NAME=', 'GIT_PUSH_OPTION_COUNT='):
            self.assertNotIn(name, done.stdout)
        for name in ('GIT_SSH_COMMAND=ssh', 'GIT_ASKPASS=x', 'KEEP=yes'):
            self.assertIn(name, done.stdout)

    def test_it_works_in_a_bash_without_compgen_the_hosted_nix_shell_has_none(self):
        # `enable -n compgen` removes the builtin, as in a bash built without readline: the first version did nothing there.
        done = self.source_git_env_clean(prelude='enable -n compgen 2>/dev/null || true; ', GIT_DIR='/nowhere', GIT_WORK_TREE='/nowhere', GIT_INDEX_FILE='/nowhere')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(done.stderr, '')  # the scrub itself says nothing and needs no compgen (a bash without it has none to disable)
        for name in ('GIT_DIR=', 'GIT_WORK_TREE=', 'GIT_INDEX_FILE='):
            self.assertNotIn(name, done.stdout)

    def test_it_works_in_posix_mode_where_export_p_prints_export_not_declare(self):
        done = self.source_git_env_clean(prelude='set -o posix; ', GIT_DIR='/nowhere', GIT_WORK_TREE='/nowhere', GIT_SSH_COMMAND='ssh')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertNotIn('GIT_DIR=', done.stdout)
        self.assertNotIn('GIT_WORK_TREE=', done.stdout)
        self.assertIn('GIT_SSH_COMMAND=ssh', done.stdout)

    def test_a_scrub_that_did_not_work_stops_the_caller_instead_of_looking_like_success(self):
        done = subprocess.run(['bash', '-c', 'unset() { return 1; }; . scripts/git-env-clean || echo "sourced-failed:$?"'], cwd=ROOT,
                              capture_output=True, text=True, env=dict(CLEAN, GIT_DIR='/nowhere'))
        self.assertIn('sourced-failed:1', done.stdout)
        self.assertRegex(done.stderr, r'could not drop .*GIT_DIR')
        # And a caller with `set -e` (scripts/ci-genie-freshness) is stopped by it.
        stopped = subprocess.run(['bash', '-c', 'set -e; unset() { return 1; }; . scripts/git-env-clean; echo reached'], cwd=ROOT,
                                 capture_output=True, text=True, env=dict(CLEAN, GIT_DIR='/nowhere'))
        self.assertNotEqual(stopped.returncode, 0)
        self.assertNotIn('reached', stopped.stdout)

    def test_a_hook_whose_scrub_failed_skips_itself_with_a_line_and_the_push_goes(self):
        bash_env = Path(self.tmp.name) / 'bash-env'
        bash_env.write_text('unset() { return 1; }\n')
        linked = self.linked_worktree()
        done = self.push_from(linked, STUB_STATUS='3', BASH_ENV=str(bash_env))
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn('could not drop the git environment of the hook', done.stderr)
        self.assertEqual(self.calls(), [])  # nothing ran with GIT_DIR set
        self.assertTrue(self.remote_has('refs/heads/linked'))

    def test_the_stub_works_in_a_bash_without_compgen_too(self):
        bash_env = Path(self.tmp.name) / 'bash-env'
        bash_env.write_text('enable -n compgen 2>/dev/null || true\n')
        linked = self.linked_worktree()
        before = self.fingerprint(linked)
        done = self.push_from(linked, STUB_STATUS='3', STUB_FIXTURE='1', BASH_ENV=str(bash_env))
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual([c['argv'][0] for c in self.calls()], ['--status', '--base'])
        self.assertEqual(self.fingerprint(linked), before)

    def test_the_installer_is_idempotent_and_never_replaces_a_hook_it_did_not_write(self):
        hook = self.work / '.git/hooks/pre-push'
        first = hook.read_text()
        self.assertEqual((self.install().returncode, hook.read_text()), (0, first))
        hook.write_text('#!/bin/sh\necho mine\n')
        refused = self.install()
        self.assertEqual(refused.returncode, 0)
        self.assertIn('not ours', refused.stderr)
        self.assertEqual(hook.read_text(), '#!/bin/sh\necho mine\n')
        self.install('--uninstall')
        self.assertTrue(hook.exists())  # not ours: untouched by --uninstall
        hook.unlink()
        self.install()
        self.install('--uninstall')
        self.assertFalse(hook.exists())

    def test_the_installer_keeps_evidence_tags_out_of_fetch_tags(self):
        # Johannes's agents hung on `git fetch --tags` pulling every refs/tags/evidence/* record: after the installer, it brings none.
        origin = Path(self.tmp.name) / 'origin.git'
        note = git(origin, 'commit-tree', '-p', 'main', '-m', 'note', 'main^{tree}')
        git(origin, 'tag', 'evidence/' + 'a' * 40 + '/r1', note)
        git(origin, 'tag', 'v1', 'main')
        tags = lambda: set(git(self.work, 'tag', '-l').split())
        self.install()  # twice: the refspec is set once
        self.assertEqual(git(self.work, 'config', '--get-all', 'remote.origin.fetch').split().count('^refs/tags/evidence/*'), 1)
        git(self.work, 'fetch', '-q', '--tags', 'origin')
        self.assertEqual(tags(), {'v1'})
        # A fetch that names them still gets them (st-test and the verifier fetch one tree's records by name).
        git(self.work, 'fetch', '-q', 'origin', '+refs/tags/evidence/*:refs/tags/evidence/*')
        self.assertIn('evidence/' + 'a' * 40 + '/r1', tags())
        self.install('--uninstall')
        self.assertNotIn('^refs/tags/evidence/*', git(self.work, 'config', '--get-all', 'remote.origin.fetch').split())

    def test_the_installer_leaves_a_configured_hooks_directory_alone(self):
        (self.work / '.git/hooks/pre-push').unlink()
        git(self.work, 'config', 'core.hooksPath', str(Path(self.tmp.name) / 'elsewhere'))
        done = self.install()
        self.assertEqual(done.returncode, 0)
        self.assertIn('core.hooksPath is set', done.stderr)
        self.assertFalse((self.work / '.git/hooks/pre-push').exists())

    def test_when_the_base_has_no_hook_files_the_stub_does_nothing_silently(self):
        git(self.work, 'checkout', '-q', 'main')
        git(self.work, 'rm', '-q', 'scripts/evidence-prepush', 'scripts/st-test')
        git(self.work, 'commit', '-q', '-m', 'remove')
        git(self.work, 'push', '-q', 'origin', 'main')
        git(self.work, 'checkout', '-q', 'feature')
        self.untouched(self.push(), 'refs/heads/feature')

    def test_the_hook_that_runs_is_the_bases_never_the_pushed_trees(self):
        poison = self.work / 'scripts/evidence-prepush'
        poison.write_text('#!/usr/bin/env python3\nimport sys\nprint("POISON ran", file=sys.stderr)\nsys.exit(7)\n')
        (self.work / 'scripts/fractal-test').write_text('#!/usr/bin/env python3\nimport sys\nprint("POISON fractal-test", file=sys.stderr)\nsys.exit(7)\n')
        git(self.work, 'add', '.')
        git(self.work, 'commit', '-q', '-m', 'a branch that tampers with the hook and the runner')
        done = self.push(STUB_STATUS='0')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertNotIn('POISON', done.stderr)
        self.assertEqual([c['argv'][0] for c in self.calls()], ['--status'])  # the base's fractal-test stub ran, not the branch's

    def test_an_agent_waits_a_bounded_time_then_signing_continues_in_the_background(self):
        started = time.monotonic()
        done = self.push(STUB_STATUS='3', STUB_SLEEP='5', ST_EVIDENCE_AGENT_LIMIT='1')  # no terminal, no ST_AGENT: a script
        self.assertLess(time.monotonic() - started, 4)
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn('still signing in the background', done.stderr)
        self.assertTrue(self.remote_has('refs/heads/feature'))
        self.assertNotIn({'done': True}, self.entries())  # not finished when the push went
        deadline = time.monotonic() + 20
        while time.monotonic() < deadline and {'done': True} not in self.entries():
            time.sleep(0.2)
        self.assertIn({'done': True}, self.entries())  # and it finished by itself afterwards
        self.assertTrue(list((self.home / '.local/state/st3/evidence-prepush').glob('*.log')))

    def test_the_status_questions_time_counts_against_an_agents_wait(self):
        started = time.monotonic()
        done = self.push(STUB_STATUS='3', STUB_STATUS_SLEEP='6', STUB_SLEEP='60', ST_EVIDENCE_AGENT_LIMIT='8')  # a script
        self.assertLess(time.monotonic() - started, 12)  # about 8 s in all, not 6 + 8
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn('still signing in the background', done.stderr)
        self.assertTrue(self.remote_has('refs/heads/feature'))

    def receipts(self):
        path = self.home / '.local/state/st3/evidence-prepush/receipts.jsonl'
        return [json.loads(line) for line in path.read_text().splitlines()] if path.exists() else []

    def wait_done(self, count=1):
        deadline = time.monotonic() + 20
        while time.monotonic() < deadline and self.entries().count({'done': True}) < count:
            time.sleep(0.2)
        self.assertEqual(self.entries().count({'done': True}), count)

    def test_an_agent_waits_up_to_five_minutes_by_default(self):
        done = self.push(STUB_STATUS='3')
        self.assertIn('this push waits at most 5 min', done.stderr)

    def test_a_tree_that_edits_a_lane_is_reported_as_not_signed_not_as_a_failure(self):
        done = self.push(STUB_STATUS='3', STUB_RUN_EXIT='4')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn('a check whose lane this tree edits is not signed, so CI runs that one', done.stderr)
        self.assertNotIn('failed', done.stderr)
        self.assertEqual(self.receipts()[-1]['outcome'], 'signed_lane_edit')

    def test_each_push_of_the_checked_out_head_leaves_one_receipt_of_what_the_hook_did(self):
        tree = git(self.work, 'rev-parse', 'HEAD^{tree}')
        # The skip flag's run goes on in the background holding the tree's lock, so it comes last.
        for env, outcome in (({'STUB_STATUS': '0'}, 'covered'), ({'STUB_STATUS': '3'}, 'signed'),
                             ({'STUB_STATUS': '3', 'STUB_RUN_EXIT': '1'}, 'failed'), ({'STUB_STATUS': '7'}, 'not_signing:status_error'),
                             ({'ST_SKIP_EVIDENCE': '1', 'STUB_STATUS': '3', 'STUB_SLEEP': '3'}, 'skip_flag')):
            with self.subTest(outcome):
                # A new remote branch each time: git runs no pre-push hook for a push with nothing to update.
                branch = outcome.replace(':', '-')
                done = self.push(f'feature:refs/heads/{branch}', **env)
                self.assertEqual(done.returncode, 0, done.stderr)
                self.assertEqual({k: v for k, v in self.receipts()[-1].items() if k != 'time'},
                                 {'tree': tree, 'branch': branch, 'agent': None, 'outcome': outcome})
        self.wait_done(3)  # the skip flag's background run too
        (self.work / 'a.txt').write_text('changed, not committed')
        self.push('feature:refs/heads/dirty')
        self.assertEqual(self.receipts()[-1]['outcome'], 'not_signing:dirty')
        self.assertIsNone(self.receipts()[-1]['agent'])
        git(self.work, 'checkout', '-q', '--', 'a.txt')
        before = len(self.receipts())
        self.push('HEAD~1:refs/heads/elsewhere', 'refs/heads/feature:refs/tags/t')  # not the checked-out head
        self.assertEqual(len(self.receipts()), before)
        self.assertRegex(self.receipts()[0]['time'], r'^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ$')

    UNCOVERED = ('  typescript-client        covered                covered by wrapper abc\n'
                 '  linux-gate               not covered            no record\n'
                 '  mail-redelivery-canaries not covered            no record\n'
                 '  fractal-web              CI runs it             no local command')

    def test_an_agents_covered_tree_is_pushed_silently_after_asking_about_all_checks(self):
        done = self.push(STUB_STATUS='0', ST_AGENT='agent/some/seat')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertTrue(self.remote_has('refs/heads/feature'))
        self.assertNotIn('evidence:', done.stderr)
        self.assertEqual([c['argv'] for c in self.calls()], [['--status', '--base', 'origin/main']])
        self.assertEqual(self.receipts()[-1]['outcome'], 'covered')

    def test_an_agents_uncovered_tree_is_refused_with_the_command_and_nothing_is_signed(self):
        tree = git(self.work, 'rev-parse', 'HEAD^{tree}')
        for name, env in (('plain', {}), ('skip flag', {'ST_SKIP_EVIDENCE': '1'}), ('local off', {'ST_EVIDENCE_LOCAL': 'off'})):
            with self.subTest(name):
                done = self.push(STUB_STATUS='3', STUB_STATUS_OUT=self.UNCOVERED, ST_AGENT='agent/some/seat', **env)
                self.assertNotEqual(done.returncode, 0)
                self.assertFalse(self.remote_has('refs/heads/feature'))
                self.assertIn(f'refused: this tree ({tree[:12]}) is not covered for: linux-gate, mail-redelivery-canaries', done.stderr)
                self.assertIn('    scripts/fractal-test --push origin\n', done.stderr)
                self.assertIn('fractal-web              CI runs it', done.stderr)  # the status is shown as it is
                self.assertEqual({k: v for k, v in self.receipts()[-1].items() if k != 'time'},
                                 {'tree': tree, 'branch': 'feature', 'agent': 'agent/some/seat', 'outcome': 'refused',
                                  'uncovered': ['linux-gate', 'mail-redelivery-canaries']})
        self.assertEqual({c['argv'][0] for c in self.calls()}, {'--status'})  # the hook never signs for an agent

    def test_an_agents_push_of_a_lane_edit_left_to_ci_is_refused(self):
        tree = git(self.work, 'rev-parse', 'HEAD^{tree}')
        status = ('  typescript-client        covered                covered by wrapper abc\n'
                  '  genie-freshness          lane edit: CI runs it  this tree edits its lane (scripts/ci-genie-freshness)\n'
                  '  fractal-web              CI runs it             no local command')
        done = self.push(STUB_STATUS='0', STUB_STATUS_OUT=status, ST_AGENT='agent/some/seat')
        self.assertNotEqual(done.returncode, 0)
        self.assertFalse(self.remote_has('refs/heads/feature'))
        self.assertIn(f'refused: this tree ({tree[:12]}) is not covered for: genie-freshness', done.stderr)
        self.assertEqual({k: v for k, v in self.receipts()[-1].items() if k != 'time'},
                         {'tree': tree, 'branch': 'feature', 'agent': 'agent/some/seat', 'outcome': 'refused', 'uncovered': ['genie-freshness']})
        self.assertEqual({c['argv'][0] for c in self.calls()}, {'--status'})  # nothing is signed for an agent

    def test_an_agents_push_waits_for_a_status_that_takes_over_a_minute(self):
        # On a loaded build host the question takes about two minutes: under the old 60 s default every agent's push was refused.
        done = self.push(STUB_STATUS='0', STUB_STATUS_SLEEP='65', ST_AGENT='agent/some/seat')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertTrue(self.remote_has('refs/heads/feature'))
        self.assertEqual(self.receipts()[-1]['outcome'], 'covered')

    def test_an_agents_push_is_refused_when_the_status_cannot_be_read(self):
        for name, env in (('error', {'STUB_STATUS': '7'}), ('timeout', {'STUB_STATUS_SLEEP': '3', 'ST_EVIDENCE_STATUS_TIMEOUT': '1'})):
            with self.subTest(name):
                done = self.push(ST_AGENT='agent/some/seat', **env)
                self.assertNotEqual(done.returncode, 0)
                self.assertFalse(self.remote_has('refs/heads/feature'))
                self.assertIn('refused: could not tell whether this tree', done.stderr)
                self.assertEqual(self.receipts()[-1]['outcome'], 'refused')

    def test_an_override_lets_an_agents_push_go_and_is_recorded_with_its_reason(self):
        done = self.push(STUB_STATUS='3', ST_AGENT='agent/some/seat', ST_EVIDENCE_OVERRIDE='queue outage, fix for main')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertTrue(self.remote_has('refs/heads/feature'))
        self.assertIn('ST_EVIDENCE_OVERRIDE: pushing a tree that may not be covered (queue outage, fix for main); recorded', done.stderr)
        receipt = self.receipts()[-1]
        self.assertEqual((receipt['outcome'], receipt['reason'], receipt['agent']), ('override', 'queue outage, fix for main', 'agent/some/seat'))
        self.assertEqual(self.calls(), [])  # nothing asked, nothing signed

    def test_an_agent_without_a_listed_signer_keeps_the_signing_hook_and_is_not_refused(self):
        (self.home / '.config/st/evidence-sign.json').unlink()
        done = self.push(STUB_STATUS='3', ST_AGENT='agent/some/seat')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertTrue(self.remote_has('refs/heads/feature'))
        self.assertEqual(self.receipts()[-1]['outcome'], 'not_signing:no_signer')
        (self.home / '.config/st/evidence-sign.json').write_text(json.dumps({'signer': 'host/elsewhere'}))  # not in .st/evidence-keys
        done = self.push('feature:refs/heads/unlisted', STUB_STATUS='3', ST_AGENT='agent/some/seat')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(self.receipts()[-1]['outcome'], 'not_signing:signer_unlisted')

    def test_a_crash_of_the_hook_never_refuses_a_push(self):
        # Only the hook's own refusal (exit 3) blocks: a base copy that fails to run lets the push go.
        git(self.work, 'checkout', '-q', 'main')
        (self.work / 'scripts/evidence-prepush').write_text('raise SystemExit(1)\n')
        git(self.work, 'commit', '-q', '-am', 'a broken hook on main')
        git(self.work, 'push', '-q', '--no-verify', 'origin', 'main')
        git(self.work, 'checkout', '-q', 'feature')
        done = self.push(STUB_STATUS='3', ST_AGENT='agent/some/seat')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertTrue(self.remote_has('refs/heads/feature'))

    def test_a_receipt_that_cannot_be_written_does_not_stop_the_push(self):
        state = self.home / '.local/state/st3/evidence-prepush'
        state.mkdir(parents=True)
        (state / 'receipts.jsonl').mkdir()  # a directory where the file goes: every append fails
        done = self.push(STUB_STATUS='0')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertTrue(self.remote_has('refs/heads/feature'))

    def test_a_tree_still_being_signed_in_the_background_is_not_signed_twice(self):
        done = self.push(STUB_STATUS='3', STUB_SLEEP='4', ST_EVIDENCE_AGENT_LIMIT='1')
        self.assertIn('still signing in the background', done.stderr)
        again = self.push('feature:refs/heads/copy', STUB_STATUS='3', STUB_SLEEP='4', ST_EVIDENCE_AGENT_LIMIT='1')
        self.assertEqual(again.returncode, 0, again.stderr)
        self.assertIn('already being signed by another push', again.stderr)
        self.assertTrue(self.remote_has('refs/heads/copy'))
        self.assertEqual([r['outcome'] for r in self.receipts()], ['background', 'not_signing:in_progress'])
        self.wait_done()
        # The lock went with the run: the next push of the tree signs again.
        self.push('feature:refs/heads/third', STUB_STATUS='3')
        self.assertEqual(self.receipts()[-1]['outcome'], 'signed')
        self.assertEqual([c['argv'][0] for c in self.calls()].count('--base'), 2)

    def test_an_interactive_push_waits_for_the_whole_limit_not_the_agent_limit(self):
        done = self.push(STUB_STATUS='3', STUB_SLEEP='3', ST_EVIDENCE_AGENT_LIMIT='1', tty=True)
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn('signed; pushing', done.stderr)
        self.assertIn({'done': True}, self.entries())

    def test_a_timeout_kills_the_grandchildren_too(self):
        done = self.push(STUB_STATUS='3', STUB_SLEEP='60', STUB_GRANDCHILD='1', ST_EVIDENCE_TIME_LIMIT='2', tty=True)
        self.assertEqual(done.returncode, 0, done.stderr)
        grandchild = next(e['grandchild'] for e in self.entries() if 'grandchild' in e)
        deadline = time.monotonic() + 10
        while time.monotonic() < deadline:
            try:
                os.kill(grandchild, 0)
            except ProcessLookupError:
                break
            time.sleep(0.1)
        with self.assertRaises(ProcessLookupError):
            os.kill(grandchild, 0)

    def test_a_signer_that_the_base_key_list_does_not_name_is_not_run_for_nothing(self):
        (self.home / '.config/st/evidence-sign.json').write_text(json.dumps({'signer': 'host/other'}))
        done = self.push(STUB_STATUS='3')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn('not listed in .st/evidence-keys on main', done.stderr)
        self.assertEqual(self.calls(), [])
        self.assertTrue(self.remote_has('refs/heads/feature'))

    def test_the_installer_says_one_line_once_and_does_nothing_in_ci(self):
        hook = self.work / '.git/hooks/pre-push'
        hook.unlink()
        first = self.install()
        self.assertEqual(first.stdout.strip(), 'evidence pre-push hook installed (ST_SKIP_EVIDENCE=1: sign in the background, do not wait)')
        self.assertEqual(self.install().stdout.strip(), '')  # already installed: quiet
        hook.unlink()
        for name in ('GITHUB_ACTIONS', 'CI'):
            done = subprocess.run(['bash', str(self.work / 'scripts/install-git-hooks')], capture_output=True, text=True,
                                  env=dict(self.env(), **{name: 'true'}), cwd=self.work)
            self.assertEqual((done.returncode, done.stdout, hook.exists()), (0, '', False), name)


if __name__ == '__main__':
    unittest.main()
