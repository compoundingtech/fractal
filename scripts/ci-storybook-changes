#!/usr/bin/env python3
"""Scope Storybook deployment without filtering the PR-close cleanup event."""
import fnmatch
import json
import os
from pathlib import Path
import urllib.request


def matches(path, patterns):
    return any(fnmatch.fnmatchcase(path, pattern) or
               (pattern.startswith('**/') and fnmatch.fnmatchcase(path, pattern[3:]))
               for pattern in patterns)


def changed(event, patterns, get_page):
    if 'pull_request' not in event:
        return True  # Every push to main publishes the canonical site.
    seen = 0
    for page in range(1, 31):  # GitHub's PR-files endpoint caps responses at 3,000 files.
        files = get_page(page)
        for file in files:
            if matches(file['filename'], patterns) or matches(file.get('previous_filename', ''), patterns):
                return True
        seen += len(files)
        if len(files) < 100:
            # Never skip a deployment based on a truncated or changing file inventory.
            return seen != event['pull_request']['changed_files']
    return True


def main():
    event = json.loads(Path(os.environ['GITHUB_EVENT_PATH']).read_text())
    patterns = json.loads(os.environ['STORYBOOK_PATHS'])

    def get_page(page):
        url = (f"https://api.github.com/repos/{os.environ['GITHUB_REPOSITORY']}"
               f"/pulls/{event['number']}/files?per_page=100&page={page}")
        request = urllib.request.Request(url, headers={
            'Authorization': f"Bearer {os.environ['GH_TOKEN']}",
            'Accept': 'application/vnd.github+json',
            'X-GitHub-Api-Version': '2022-11-28',
        })
        with urllib.request.urlopen(request, timeout=30) as response:
            return json.load(response)

    result = changed(event, patterns, get_page)
    with open(os.environ['GITHUB_OUTPUT'], 'a') as output:
        output.write(f'changed={str(result).lower()}\n')
    print('Storybook inputs changed' if result else 'No Storybook input changes; deployment skipped')


if __name__ == '__main__':
    main()
