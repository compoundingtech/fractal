#!/usr/bin/env python3
"""Exercise actual Cargo subcommand discovery; these commands compile no Rust."""
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
import unittest

ROOT = Path(__file__).resolve().parent.parent
CARGO = os.environ.get('CI_TOOLCHAIN_TEST_CARGO') or shutil.which('cargo')
BASH = shutil.which('bash') or '/bin/bash'


class CargoToolOrder(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        if CARGO is None:
            raise RuntimeError('run this guard inside the pinned Nix shell')
        version = subprocess.run([CARGO, '--version'], check=True, capture_output=True, text=True)
        print(f'Cargo subcommand control: {CARGO}: {version.stdout.strip()}')

    def setUp(self):
        self.assertIsNotNone(CARGO, 'run this guard inside the pinned Nix shell')
        self.temp = tempfile.TemporaryDirectory()
        self.addCleanup(self.temp.cleanup)
        self.root = Path(self.temp.name)
        self.home = self.root / 'isolated home'
        self.cargo_home = self.root / 'cargo home'
        self.pinned = self.root / 'pinned tools'
        for p in (self.home, self.cargo_home / 'bin', self.pinned):
            p.mkdir(parents=True, exist_ok=True)
        self.plugin(self.cargo_home / 'bin', 'printf "rustup proxy without default\\n" >&2\nexit 73\n')
        self.plugin(self.pinned, 'printf "%s\\n" "$@"\nexit "${PROBE_EXIT:-0}"\n')
        self.env = {**os.environ, 'HOME': str(self.home), 'CARGO_HOME': str(self.cargo_home),
                    'PATH': f'{self.pinned}:/usr/bin:/bin', 'CI_TEST_CARGO': str(CARGO),
                    'RUSTUP_HOME': str(self.root / 'empty rustup')}
        self.env.pop('RUSTUP_TOOLCHAIN', None)

    def plugin(self, directory, body):
        p = directory / 'cargo-ci-tool-order'
        p.write_text('#!/bin/sh\n' + body)
        p.chmod(0o755)

    def run_probe(self, setup=True, args=('argument with spaces', '--probe')):
        setup_command = 'source "$1" || exit $?; shift; ' if setup else 'shift; '
        return subprocess.run([BASH, '-c', setup_command + 'exec "$CI_TEST_CARGO" ci-tool-order "$@"',
                               'probe', str(ROOT / 'scripts/ci-cargo-tools-env'), *args],
                              cwd=self.root, env=self.env, capture_output=True, text=True)

    def test_runner_proxy_shadows_pinned_path_until_the_shell_sets_explicit_order(self):
        before = self.run_probe(setup=False)
        self.assertEqual(before.returncode, 73, before.stderr)
        self.assertIn('rustup proxy without default', before.stderr)
        after = self.run_probe()
        self.assertEqual(after.returncode, 0, after.stderr)
        self.assertEqual(after.stdout.splitlines(), ['ci-tool-order', 'argument with spaces', '--probe'])
        self.assertNotIn('rustup proxy', after.stderr)

    def test_the_pinned_tools_real_failure_is_preserved(self):
        self.env['PROBE_EXIT'] = '41'
        result = self.run_probe()
        self.assertEqual(result.returncode, 41, result.stderr)
        self.assertNotIn('rustup proxy', result.stderr)

    def test_the_default_cargo_home_is_ordered_when_no_override_is_present(self):
        self.env.pop('CARGO_HOME')
        p = self.home / '.cargo' / 'bin'; p.mkdir(parents=True)
        self.plugin(p, 'exit 73\n')
        result = self.run_probe()
        self.assertEqual(result.returncode, 0, result.stderr)

    def test_relative_cargo_home_is_refused_before_tool_execution(self):
        self.env['CARGO_HOME'] = 'relative-home'
        result = self.run_probe()
        self.assertEqual(result.returncode, 1)
        self.assertIn('must be absolute', result.stderr)
        self.assertEqual(result.stdout, '')

    def test_workspace_rust_jobs_receive_the_pinned_shell_tool_order_guard(self):
        flake = (ROOT / 'flake.nix').read_text()
        block = flake.split('devShells.default =', 1)[1].split('devShells.perf', 1)[0]
        self.assertIn('source ${./scripts/ci-cargo-tools-env} || exit $?', block)
        self.assertIn('if [ "\'\'${GITHUB_ACTIONS:-}" = true ]; then', block)
        self.assertIn('python3 scripts/ci-cargo-tools-env-test', (ROOT / 'scripts/ci-linux').read_text())


if __name__ == '__main__':
    unittest.main()
