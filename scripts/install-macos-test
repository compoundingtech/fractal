#!/usr/bin/env python3
"""Isolated installer transactions; native signing/swap proof also runs on macOS."""
import hashlib
import contextlib
import io
import importlib.util
import json
import os
from pathlib import Path
import plistlib
import shutil
import subprocess
import sys
import tempfile
import unittest
from unittest.mock import patch

spec = importlib.util.spec_from_file_location('installer', Path(__file__).with_name('install-macos.py'))
m = importlib.util.module_from_spec(spec)
spec.loader.exec_module(m)
DER = b'invented signing certificate'
CERT = hashlib.sha1(DER).hexdigest().upper()


class Environment(unittest.TestCase):
    def load(self, environment):
        installer = importlib.util.module_from_spec(spec)
        with patch.dict(os.environ, environment, clear=True):
            spec.loader.exec_module(installer)
        return installer

    def test_preferred_names_legacy_fallback_and_explicit_empty_values(self):
        fields = {
            'MACOS_SIGNING_IDENTITY': ('CERTIFICATE', 'preferred identity', 'legacy identity'),
            'MACOS_SIGNING_TEAM': ('TEAM', 'PREFERRED', 'LEGACY'),
            'MACOS_APP_PATH': ('APP', '/preferred/app', '/legacy/app'),
            'MACOS_BIN_DIR': ('BIN_DIR', '/preferred/bin', '/legacy/bin'),
            'MACOS_BUNDLE_ID': ('IDENTIFIER', 'com.example.preferred', 'com.example.legacy'),
            'INSTANCE': ('INSTANCE', 'preferred', 'legacy'),
        }
        legacy = {'ST_' + name: old for name, (_, _, old) in fields.items()}
        preferred = {'FRACTAL_' + name: new for name, (_, new, _) in fields.items()}
        empty = {'FRACTAL_' + name: '' for name in fields}
        for mode, environment in [('preferred', legacy | preferred), ('legacy', legacy),
                                  ('empty', legacy | empty), ('unset', {})]:
            with self.subTest(mode=mode):
                installer = self.load(environment)
                for attribute, new, old in fields.values():
                    expected = new if mode == 'preferred' else old if mode == 'legacy' else None
                    if attribute == 'IDENTIFIER' and expected is None:
                        expected = 'com.compoundingtech.smalltalk'
                    self.assertEqual(getattr(installer, attribute), expected)

    def test_install_home_prefers_fractal_and_keeps_legacy_and_cli_support(self):
        cases = [
            ({'ST_MACOS_INSTALL_HOME': '/legacy/home'}, [], '/legacy/home'),
            ({'ST_MACOS_INSTALL_HOME': '/legacy/home',
              'FRACTAL_MACOS_INSTALL_HOME': '/preferred/home'}, [], '/preferred/home'),
            ({'ST_MACOS_INSTALL_HOME': '/legacy/home',
              'FRACTAL_MACOS_INSTALL_HOME': ''}, [], '.'),
            ({'FRACTAL_MACOS_INSTALL_HOME': '/preferred/home'},
             ['--home', '/cli/home'], '/cli/home'),
        ]
        for environment, arguments, expected in cases:
            with self.subTest(environment=environment, arguments=arguments):
                installer = self.load(environment)
                with patch.dict(os.environ, environment, clear=True), \
                        patch.object(sys, 'argv', ['install-macos'] + arguments), \
                        patch.object(installer, 'state_root', side_effect=RuntimeError('home selected')) as state:
                    with self.assertRaisesRegex(RuntimeError, '^home selected$'):
                        installer.main()
                state.assert_called_once_with(Path(expected).absolute())

    def test_instance_keeps_existing_bundle_and_service_identities(self):
        for prefix in ['FRACTAL_', 'ST_']:
            with self.subTest(prefix=prefix):
                installer = self.load({prefix + 'INSTANCE': 'try'})
                self.assertEqual(installer.IDENTIFIER, 'com.compoundingtech.smalltalk.instance.try')
                self.assertEqual(installer.SERVICES, ['com.compoundingtech.st3.instance.try',
                                                    'com.compoundingtech.st3.instance.try.replication'])


    def test_both_instance_names_reject_invalid_values(self):
        for prefix in ['FRACTAL_', 'ST_']:
            for value in ['Try', 'a b', '../x', '-a', 'a--b', 'x' * 25]:
                with self.subTest(prefix=prefix, value=value):
                    with self.assertRaisesRegex(SystemExit, 'invalid instance name'):
                        self.load({prefix + 'INSTANCE': value})


class Installer(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        self.home = Path(self.tmp.name)
        self.job = self.home / 'job'
        self.job.mkdir()
        self.source = self.home / 'built'
        self.source.mkdir()
        self.built = {}
        for name in ['fractal']:
            p = self.source / name
            p.write_bytes((name + '-one').encode())
            p.chmod(0o755)
            self.built[name] = p
        self.calls = []
        self.stack = patch.multiple(m, CERTIFICATE=None, TEAM=None, APP=None, BIN_DIR=None,
                                    IDENTIFIER='com.example.smalltalk')
        self.stack.start()
        self.addCleanup(self.stack.stop)
        self.original_path = os.environ.get('PATH', os.defpath)
        environment = patch.dict(os.environ, PATH='')
        environment.start()
        self.addCleanup(environment.stop)

    def test_foreign_canonical_refusal_preserves_installed_app_and_commands(self):
        with patch.object(m, 'command', side_effect=self.command), \
                patch.object(m, 'exchange', side_effect=self.exchange):
            app, _, _ = m.prepare(self.home, self.job, self.built)
            m.install(app, self.home, self.job)
            installed = m.fixed(self.home)
            inode = installed.stat().st_ino
            original = {p.relative_to(installed): p.read_bytes()
                        for p in installed.rglob('*') if p.is_file()}
            canonical = m.bin_dir(self.home) / 'fractal'
            canonical.unlink()
            canonical.write_bytes(b'foreign canonical owner')
            self.built['fractal'].write_bytes(b'fractal-two')
            second_job = self.home / 'second'
            second_job.mkdir()
            app, _, _ = m.prepare(self.home, second_job, self.built)
            had_app = m.backup(self.home, second_job)
            with self.assertRaisesRegex(RuntimeError, 'foreign fractal'):
                m.install(app, self.home, second_job)
            self.assertEqual(installed.stat().st_ino, inode)
            self.assertEqual({p.relative_to(installed): p.read_bytes()
                              for p in installed.rglob('*') if p.is_file()}, original)
            m.restore(self.home, second_job, had_app)
        self.assertEqual(canonical.read_bytes(), b'foreign canonical owner')
        for name in ['st', 'st3']:
            self.assertEqual(os.readlink(m.bin_dir(self.home) / name), 'fractal')

    def test_path_links_to_our_canonical_app_and_commands_are_owned(self):
        destination = m.bin_dir(self.home) / 'fractal'
        path_dir = self.home / 'other-bin'
        path_dir.mkdir()
        candidate = path_dir / 'fractal'
        for target in [m.binaries(m.fixed(self.home))['fractal'], destination,
                       destination.parent / 'st3']:
            with self.subTest(target=target), patch.dict(os.environ, PATH=str(path_dir)):
                candidate.symlink_to(target)
                self.assertFalse(m.foreign_fractal_on_path(destination, self.home))
                candidate.unlink()

    def test_release_darwin_ownership_table_matches_helper(self):
        repo = Path(__file__).resolve().parent.parent
        fakebin = self.home / 'platform-bin'
        fakebin.mkdir()
        uname = fakebin / 'uname'
        uname.write_text('#!/bin/sh\necho Darwin\n')
        uname.chmod(0o755)
        # Expose only tools, never an inherited host fractal command.
        for name in ('bash', 'python3', 'dirname', 'basename', 'readlink', 'mkdir'):
            (fakebin / name).symlink_to(shutil.which(name, path=self.original_path))
        bin_dir = self.home / 'commands'
        bin_dir.mkdir()
        canonical = bin_dir / 'fractal'
        other = self.home / 'other-bin'
        other.mkdir()
        parent_alias = self.home / 'commands-alias'
        parent_alias.symlink_to(bin_dir, target_is_directory=True)
        for mode in ('default', 'custom', 'instance'):
            # --source-preflight follows the source helper's instance default,
            # unlike the archive wrapper's later explicit shared --app.
            app = (self.home / 'custom/Fractal.app' if mode == 'custom'
                   else self.home / '.st-instance/table/app/SmallTalk.app' if mode == 'instance'
                   else self.home / 'Applications/SmallTalk.app')
            environment = dict(os.environ, HOME=str(self.home),
                               FRACTAL_MACOS_INSTALL_HOME=str(self.home),
                               FRACTAL_MACOS_APP_PATH=str(app),
                               FRACTAL_INSTANCE='table' if mode == 'instance' else '',
                               ST_INSTANCE='')
            if mode != 'custom':
                environment.pop('FRACTAL_MACOS_APP_PATH')
                environment.pop('ST_MACOS_APP_PATH', None)
            instance = environment['FRACTAL_INSTANCE'] or None
            app_binary = str(app / 'Contents/MacOS/fractal')
            # (form, raw target, shell ownership, helper ownership)
            rows = [
                ('absent', None, True, True),
                ('link', 'st3', True, True),
                ('link', str(bin_dir / 'st3'), True, True),
                ('link', app_binary, True, True),
                ('link', str(app / 'Contents/MacOS/st3'), False, False),
                ('link', str(app / 'Contents/MacOS/../MacOS/fractal'), False, False),
                ('link', '/missing/foreign-st3', False, False),
                ('file', None, False, False),
                ('one-alias', None, False, False),
                # HM's physical+two-alias marker is owned by the early guard;
                # helper physical->app conversion refusal is inherited.
                ('physical', None, True, False),
                ('directory', None, False, False),
            ]
            for form, target, shell_owned, helper_owned in rows:
                with self.subTest(mode=mode, form=form, target=target):
                    if form == 'link':
                        canonical.symlink_to(target)
                    elif form == 'directory':
                        canonical.mkdir()
                    elif form != 'absent':
                        canonical.write_text('#!/bin/sh\nexit 99\n')
                        canonical.chmod(0o755)
                        if form in ('physical', 'one-alias'):
                            (bin_dir / 'st').symlink_to('fractal')
                        if form == 'physical':
                            (bin_dir / 'st3').symlink_to(str(canonical))
                    env = dict(environment, PATH=str(fakebin))
                    result = subprocess.run(
                        [str(repo / 'scripts/install-release'), '--source-preflight',
                         '--bin-dir', str(bin_dir)], env=env, capture_output=True, text=True)
                    self.assertEqual(result.returncode == 0, shell_owned, result.stderr)
                    with patch.multiple(m, APP=str(app), BIN_DIR=str(bin_dir), INSTANCE=instance):
                        actual = not (canonical.exists() or canonical.is_symlink()) or m.owns_fractal(canonical, self.home)
                        self.assertEqual(actual, helper_owned)
                    if canonical.is_dir() and not canonical.is_symlink():
                        canonical.rmdir()
                    else:
                        canonical.unlink(missing_ok=True)
                    for name in ('st', 'st3'):
                        (bin_dir / name).unlink(missing_ok=True)
            # PATH targets share the helper's literal comparisons. Instances
            # bypass this scan, but never bypass the destination table above.
            canonical.symlink_to('st3')
            candidate = other / 'fractal'
            path_rows = [
                (str(canonical), True), (str(bin_dir / 'st3'), True),
                (app_binary, True), ('st3', False),
                (str(app / 'Contents/MacOS/st3'), False),
                ('/missing/foreign', False), (None, False),
            ]
            for target, owned in path_rows:
                with self.subTest(mode=mode, path_target=target):
                    if target is None:
                        candidate.write_text('#!/bin/sh\nexit 99\n')
                        candidate.chmod(0o755)
                    else:
                        candidate.symlink_to(target)
                    path = os.pathsep.join([str(other), str(fakebin)])
                    env = dict(environment, PATH=path)
                    result = subprocess.run(
                        [str(repo / 'scripts/install-release'), '--source-preflight',
                         '--bin-dir', str(bin_dir)], env=env, capture_output=True, text=True)
                    expected = owned or instance is not None
                    self.assertEqual(result.returncode == 0, expected, result.stderr)
                    with patch.multiple(m, APP=str(app), BIN_DIR=str(bin_dir), INSTANCE=instance), \
                            patch.dict(os.environ, PATH=path):
                        self.assertEqual(not m.foreign_fractal_on_path(canonical, self.home), expected)
                    candidate.unlink()
            # A PATH spelling of the destination's physical directory is not
            # an unrelated command, including a literal-st3 canonical link.
            path = os.pathsep.join([str(parent_alias), str(fakebin)])
            result = subprocess.run(
                [str(repo / 'scripts/install-release'), '--source-preflight', '--bin-dir', str(bin_dir)],
                env=dict(environment, PATH=path), capture_output=True, text=True)
            self.assertEqual(result.returncode, 0, result.stderr)
            with patch.multiple(m, APP=str(app), BIN_DIR=str(bin_dir), INSTANCE=instance), \
                    patch.dict(os.environ, PATH=path):
                self.assertFalse(m.foreign_fractal_on_path(canonical, self.home))
            canonical.unlink()

    def command(self, args):
        args = list(map(str, args))
        self.calls.append(args)
        if args[:2] == ['launchctl', 'print']:
            raise subprocess.CalledProcessError(113, args, 'service absent')
        if args[:2] == ['launchctl', 'print-disabled']:
            return 'disabled services = {\n}\n'
        if 'find-identity' in args:
            return '  1) ' + CERT + ' "Developer ID Application: Example Developer (EXAMPLE123)"\n'
        if 'find-certificate' in args:
            return 'invented PEM'
        if '/usr/bin/openssl' == args[0]:
            return 'subject=CN=Example Developer,OU=EXAMPLE123,O=Example\n'
        if args[0] == '/usr/bin/ditto':
            shutil.copytree(args[1], args[2])
        for arg in args:
            if arg.startswith('--extract-certificates='):
                Path(arg.split('=', 1)[1] + '0').write_bytes(DER)
        if '-r-' in args:
            metadata = json.loads((Path(args[-1]) / 'Contents/Resources/deploy-payload.json').read_text())
            req = 'identifier "' + metadata['identifier'] + '"'
            req += ' and anchor apple generic' if metadata['certificate'] else ' and cdhash H"1234"'
            return ('Identifier=' + metadata['identifier'] + '\nTeamIdentifier=' +
                    (metadata['team'] or 'not set') + '\ndesignated => ' + req + '\n')
        return ''

    def exchange(self, staged, destination):
        if destination.exists():
            old = staged.parent / '.old-app'
            os.replace(destination, old)
            os.replace(staged, destination)
            os.replace(old, staged)
        else:
            os.replace(staged, destination)

    def test_embedded_web_assets_are_signed_and_identified(self):
        web = self.built['fractal'].parent.parent / 'share/fractal-web'
        web.mkdir(parents=True)
        (web / 'index.html').write_text('embedded web')
        (web / 'index.html').chmod(0o444)
        web.chmod(0o555)
        self.addCleanup(web.chmod, 0o755)
        with patch.object(m, 'command', side_effect=self.command):
            app, _, payload = m.prepare(self.home, self.job, self.built)
        self.assertEqual((app / 'Contents/share/fractal-web/index.html').read_text(), 'embedded web')
        self.assertEqual(payload['web/index.html'], m.sha(web / 'index.html'))
        installed_web = app / 'Contents/share/fractal-web'
        self.assertTrue(installed_web.stat().st_mode & 0o200)
        self.assertTrue((installed_web / 'index.html').stat().st_mode & 0o200)

    def test_unconfigured_never_searches_keychain_and_signs_ad_hoc(self):
        with patch.object(m, 'command', side_effect=self.command):
            app, identity, _ = m.prepare(self.home, self.job, self.built)
        self.assertFalse(identity['persistent_identity'])
        self.assertFalse(any('security' in call[0] for call in self.calls))
        self.assertTrue(all(call[call.index('--sign') + 1] == '-' for call in self.calls if '--sign' in call))
        self.assertTrue(app.is_dir())

    def test_configured_missing_identity_fails_before_any_signing(self):
        m.CERTIFICATE = 'missing explicitly configured certificate'
        with patch.object(m, 'command', side_effect=self.command):
            with self.assertRaisesRegex(RuntimeError, 'refusing ad-hoc fallback'):
                m.prepare(self.home, self.job, self.built)
        self.assertFalse(any('--sign' in call for call in self.calls))

    def test_team_requires_explicit_identity(self):
        m.TEAM = 'EXAMPLE123'
        with patch.object(m, 'command', side_effect=self.command):
            with self.assertRaisesRegex(RuntimeError, 'explicit signing identity'):
                m.resolve_identity()
        self.assertEqual(self.calls, [])

    def test_configured_identity_team_and_certificate_are_verified(self):
        m.CERTIFICATE = CERT
        m.TEAM = 'EXAMPLE123'
        def output(args):
            if 'find-certificate' in args:
                return '-----BEGIN CERTIFICATE-----\nZXhhbXBsZQ==\n-----END CERTIFICATE-----'
            return self.command(args)
        with patch.object(m, 'command', side_effect=output), patch.object(m.ssl, 'PEM_cert_to_DER_cert', return_value=DER):
            _, identity, _ = m.prepare(self.home, self.job, self.built)
        self.assertEqual(identity['certificate'], CERT)
        self.assertTrue(identity['persistent_identity'])
        self.assertTrue(all(call[call.index('--sign') + 1] == CERT for call in self.calls if '--sign' in call))

    def test_staged_artifact_verification_needs_no_signing_private_key(self):
        app = self.job / 'prepared.app'
        metadata = app / 'Contents/Resources/deploy-payload.json'
        metadata.parent.mkdir(parents=True)
        metadata.write_text(json.dumps({'certificate': CERT, 'team': 'EXAMPLE123',
                                        'identifier': 'com.example.smalltalk'}))
        argv = ['install-macos', '--identity', CERT, '--team-id', 'EXAMPLE123',
                '--identifier', 'com.example.smalltalk', '--verify-app', str(app)]
        with patch.object(sys, 'argv', argv), patch.object(Path, 'home', return_value=self.home), \
                patch.object(m, 'command', side_effect=self.command), \
                patch.object(m, 'resolve_identity', side_effect=AssertionError('must not ask for a private key')), \
                contextlib.redirect_stdout(io.StringIO()) as output:
            m.main()
        identity = json.loads(output.getvalue())
        self.assertEqual(identity['certificate'], CERT)
        self.assertTrue(identity['persistent_identity'])

    def test_wrong_team_fails_before_signing(self):
        m.CERTIFICATE = CERT
        m.TEAM = 'WRONGTEAM1'
        def output(args):
            if 'find-certificate' in args:
                return '-----BEGIN CERTIFICATE-----\nZXhhbXBsZQ==\n-----END CERTIFICATE-----'
            return self.command(args)
        with patch.object(m, 'command', side_effect=output), patch.object(m.ssl, 'PEM_cert_to_DER_cert', return_value=DER):
            with self.assertRaisesRegex(RuntimeError, 'configured signing team'):
                m.prepare(self.home, self.job, self.built)
        self.assertFalse(any('--sign' in call for call in self.calls))

    def test_named_instance_still_refuses_foreign_destination(self):
        with patch.object(m, 'INSTANCE', 'try'):
            destination = m.bin_dir(self.home)
            destination.mkdir(parents=True)
            canonical = destination / 'fractal'
            canonical.write_bytes(b'foreign instance command')
            identity = (canonical.stat().st_dev, canonical.stat().st_ino)
            with self.assertRaisesRegex(RuntimeError, 'foreign fractal'):
                m.install(self.source, self.home, self.job)
            self.assertEqual(canonical.read_bytes(), b'foreign instance command')
            self.assertEqual((canonical.stat().st_dev, canonical.stat().st_ino), identity)
            self.assertFalse((destination / 'st').exists())
            self.assertFalse((destination / 'st3').exists())

    def test_fractal_collisions_and_rollback(self):
        for kind in ['free', 'owned-relative', 'owned-absolute', 'owned-app',
                     'file', 'link', 'dangling', 'directory', 'path']:
            with self.subTest(kind=kind):
                home = self.home / kind
                job = home / 'job'
                job.mkdir(parents=True)
                destination = m.bin_dir(home)
                destination.mkdir(parents=True)
                alias = destination / 'fractal'
                path_dir = home / 'foreign-path'
                path_dir.mkdir()
                if kind == 'owned-relative':
                    alias.symlink_to('st3')
                elif kind == 'owned-absolute':
                    alias.symlink_to(destination / 'st3')
                elif kind == 'owned-app':
                    alias.symlink_to(m.binaries(m.fixed(home))['fractal'])
                elif kind == 'file':
                    alias.write_text('foreign')
                elif kind == 'link':
                    alias.symlink_to(self.built['fractal'])
                elif kind == 'dangling':
                    alias.symlink_to('/missing/fractal')
                elif kind == 'directory':
                    alias.mkdir()
                elif kind == 'path':
                    (path_dir / 'fractal').write_text('foreign')
                previous = os.readlink(alias) if alias.is_symlink() else None
                with patch.dict(os.environ, PATH=str(path_dir)), \
                        patch.object(m, 'command', side_effect=self.command), \
                        patch.object(m, 'exchange', side_effect=self.exchange):
                    app, _, _ = m.prepare(home, job, self.built)
                    had_app = m.backup(home, job)
                    if kind in ['free', 'owned-relative', 'owned-absolute', 'owned-app']:
                        m.install(app, home, job)
                        self.assertEqual(os.readlink(alias), str(m.binaries(m.fixed(home))['fractal']))
                        for name in ['st', 'st3']:
                            self.assertEqual(os.readlink(destination / name), 'fractal')
                            self.assertEqual((destination / name).read_bytes(), b'fractal-one')
                        m.restore(home, job, had_app)
                    else:
                        with self.assertRaisesRegex(RuntimeError, 'foreign fractal'):
                            m.install(app, home, job)
                        self.assertFalse(m.fixed(home).exists())
                        self.assertFalse((destination / 'st').exists())
                        self.assertFalse((destination / 'st3').exists())
                if previous is not None:
                    self.assertEqual(os.readlink(alias), previous)
                elif kind == 'file':
                    self.assertEqual(alias.read_text(), 'foreign')
                elif kind == 'directory':
                    self.assertEqual(list(alias.iterdir()), [])
                else:
                    self.assertFalse(alias.exists() or alias.is_symlink())
                if kind == 'path':
                    self.assertEqual((path_dir / 'fractal').read_text(), 'foreign')

    def test_fractal_rollback_does_not_overwrite_new_foreign_command(self):
        with patch.dict(os.environ, PATH=''), \
                patch.object(m, 'command', side_effect=self.command), \
                patch.object(m, 'exchange', side_effect=self.exchange):
            app, _, _ = m.prepare(self.home, self.job, self.built)
            had_app = m.backup(self.home, self.job)
            m.install(app, self.home, self.job)
            alias = m.bin_dir(self.home) / 'fractal'
            alias.unlink()
            alias.write_text('new foreign owner')
            m.restore(self.home, self.job, had_app)
        self.assertEqual(alias.read_text(), 'new foreign owner')

    def test_fractal_staging_preserves_legacy_and_never_bootstraps(self):
        service = self.home / 'Library/LaunchAgents' / (m.SERVICES[0] + '.plist')
        service.parent.mkdir(parents=True)
        original = plistlib.dumps({'ProgramArguments': ['legacy-st3', 'up']})
        service.write_bytes(original)
        with patch.object(m, 'command', side_effect=self.command), \
                patch.object(m, 'exchange', side_effect=self.exchange):
            app, _, _ = m.prepare(self.home, self.job, self.built)
            m.backup(self.home, self.job, stage_fractal=True)
            m.install(app, self.home, self.job, stage_fractal=True)
        self.assertEqual(service.read_bytes(), original)
        self.assertFalse((self.job / 'previous-launchd' / service.name).exists())
        self.assertTrue(any(call[-3:] == ['service', 'install', '--stage-fractal'] for call in self.calls))
        self.assertFalse(any('bootstrap' in call or 'kickstart' in call or 'bootout' in call for call in self.calls))

    def test_loaded_target_refuses_staging_before_app_or_definition_change(self):
        service = self.home / 'Library/LaunchAgents' / (m.FRACTAL_SERVICES[0] + '.plist')
        service.parent.mkdir(parents=True)
        service.write_bytes(b'unchanged definition')
        with patch.object(m, 'command', return_value='loaded'):
            with self.assertRaisesRegex(RuntimeError, 'loaded launchd service'):
                m.install(self.source, self.home, self.job, stage_fractal=True)
        self.assertEqual(service.read_bytes(), b'unchanged definition')
        self.assertFalse(m.fixed(self.home).exists())

    def test_normal_install_rejects_rewriting_a_loaded_definition(self):
        service = self.home / 'Library/LaunchAgents' / (m.SERVICES[0] + '.plist')
        service.parent.mkdir(parents=True)
        original = plistlib.dumps({'ProgramArguments': ['legacy-st3', 'up']})
        service.write_bytes(original)
        with patch.object(m, 'command', return_value='loaded'):
            with self.assertRaisesRegex(RuntimeError, 'loaded launchd service'):
                m.install(self.source, self.home, self.job)
        self.assertEqual(service.read_bytes(), original)
        self.assertFalse(m.fixed(self.home).exists())

    def test_normal_install_preserves_hm_staged_and_completed_wrappers(self):
        for phase in ('stage', 'completed'):
            with self.subTest(phase=phase):
                home = self.home / phase
                job = home / 'job'
                job.mkdir(parents=True)
                definitions = {}
                for label in m.FRACTAL_SERVICES:
                    path = home / 'Library/LaunchAgents' / (label + '.plist')
                    path.parent.mkdir(parents=True, exist_ok=True)
                    path.write_bytes(plistlib.dumps({
                        'Label': label,
                        'ProgramArguments': ['/nix/store/example/bin/' +
                                             ('fractal-replication' if label.endswith('.replication') else 'fractal-daemon')],
                        'RunAtLoad': True,
                        'KeepAlive': {'SuccessfulExit': False},
                        'EnvironmentVariables': {'HM_PHASE': phase},
                    }))
                    definitions[path] = path.read_bytes()
                def output(args):
                    if list(args)[:2] == ['launchctl', 'print']:
                        if phase == 'completed':
                            return 'loaded wrapper'
                        raise subprocess.CalledProcessError(113, args)
                    return self.command(args)
                with patch.dict(os.environ, PATH=''), \
                        patch.object(m, 'command', side_effect=output), \
                        patch.object(m, 'exchange', side_effect=self.exchange):
                    app, _, _ = m.prepare(home, job, self.built)
                    m.backup(home, job)
                    m.install(app, home, job)
                for path, original in definitions.items():
                    self.assertEqual(path.read_bytes(), original)

    def test_normal_install_repoints_direct_native_daemon_and_replication(self):
        agents = self.home / 'Library/LaunchAgents'
        agents.mkdir(parents=True)
        definitions = {}
        for label, subcommand in zip(m.FRACTAL_SERVICES, ('up', 'replication-worker')):
            path = agents / (label + '.plist')
            definition = {'Label': label, 'ProgramArguments': [
                '/previous/st3', subcommand, '--state-dir', '/state/fractal',
                '--config', '/config/fractal/config.kdl']}
            # launchd may specify both Program and ProgramArguments.
            if subcommand == 'replication-worker':
                definition['Program'] = '/previous/st3'
            path.write_bytes(plistlib.dumps(definition))
            definitions[path] = definition
        with patch.dict(os.environ, PATH=''), \
                patch.object(m, 'command', side_effect=self.command), \
                patch.object(m, 'exchange', side_effect=self.exchange):
            app, _, _ = m.prepare(self.home, self.job, self.built)
            m.install(app, self.home, self.job)
        executable = str(m.binaries(m.fixed(self.home))['fractal'])
        for path, definition in definitions.items():
            definition['ProgramArguments'][0] = executable
            if 'Program' in definition:
                definition['Program'] = executable
            self.assertEqual(plistlib.loads(path.read_bytes()), definition)

    def test_failed_staging_restores_absent_or_existing_targets_and_enablement(self):
        for prior in ('absent', 'enabled', 'disabled'):
            with self.subTest(prior=prior):
                home = self.home / prior
                job = home / 'job'
                job.mkdir(parents=True)
                agents = home / 'Library/LaunchAgents'
                agents.mkdir(parents=True)
                unrelated = agents / 'com.example.other.plist'
                unrelated.write_bytes(b'unrelated definition')
                legacy = agents / (m.SERVICES[0] + '.plist')
                legacy.write_bytes(b'legacy definition')
                originals = {}
                overrides = {'com.example.other': True, m.SERVICES[0]: False}
                for label in m.FRACTAL_SERVICES:
                    if prior != 'absent':
                        path = agents / (label + '.plist')
                        path.write_bytes(plistlib.dumps({'ProgramArguments': ['/old/wrapper/' + label]}))
                        originals[path] = path.read_bytes()
                        # Cover both explicit override values in each transaction.
                        overrides[label] = (prior == 'disabled') != label.endswith('.replication')
                previous_overrides = dict(overrides)
                def output(args):
                    args = list(map(str, args))
                    if args[:2] == ['launchctl', 'print-disabled']:
                        self.calls.append(args)
                        return 'disabled services = {\n' + ''.join(
                            '    "' + label + '" => ' + str(value).lower() + '\n'
                            for label, value in overrides.items()) + '}\n'
                    if args[:2] in (['launchctl', 'disable'], ['launchctl', 'enable']):
                        self.calls.append(args)
                        overrides[args[2].split('/', 2)[2]] = args[1] == 'disable'
                        return ''
                    if args[-3:] == ['service', 'install', '--stage-fractal']:
                        self.calls.append(args)
                        for label in m.FRACTAL_SERVICES:
                            overrides[label] = True
                            (agents / (label + '.plist')).write_bytes(plistlib.dumps({
                                'Label': label, 'ProgramArguments': [args[-4], 'up']}))
                        raise subprocess.CalledProcessError(1, args, 'injected staging failure')
                    return self.command(args)
                argv = ['install-macos', '--from', str(self.source), '--home', str(home),
                        '--job', str(job), '--stage-fractal']
                with patch.dict(os.environ, PATH=''), \
                        patch.object(sys, 'argv', argv), \
                        patch.object(m, 'command', side_effect=output), \
                        patch.object(m, 'exchange', side_effect=self.exchange):
                    with self.assertRaisesRegex(subprocess.CalledProcessError, 'non-zero exit status'):
                        m.main()
                recorded = json.loads((job / 'previous-launchd.json').read_text())
                self.assertEqual(set(recorded), set(m.FRACTAL_SERVICES))
                for label in m.FRACTAL_SERVICES:
                    path = agents / (label + '.plist')
                    self.assertEqual(recorded[label]['present'], prior != 'absent')
                    self.assertEqual(recorded[label]['disabled'], previous_overrides.get(label))
                    if prior == 'absent':
                        self.assertFalse(path.exists())
                    else:
                        self.assertEqual(path.read_bytes(), originals[path])
                    self.assertEqual(overrides[label], previous_overrides.get(label, False))
                self.assertFalse(m.fixed(home).exists())
                self.assertEqual(unrelated.read_bytes(), b'unrelated definition')
                self.assertEqual(legacy.read_bytes(), b'legacy definition')
                self.assertEqual(overrides['com.example.other'], True)
                self.assertEqual(overrides[m.SERVICES[0]], False)
                self.assertFalse(any('bootstrap' in call or 'kickstart' in call or 'bootout' in call
                                     for call in self.calls))
                changed = [call[2].split('/', 2)[2] for call in self.calls
                           if call[:2] in (['launchctl', 'enable'], ['launchctl', 'disable'])]
                self.assertTrue(set(changed).issubset(m.FRACTAL_SERVICES))

    def test_hm_launchagent_symlink_rollback_preserves_the_link_object(self):
        for mode in ('failed-install', 'restore-app', 'stage-refusal'):
            for kind in ('absolute', 'relative', 'dangling'):
                with self.subTest(mode=mode, kind=kind):
                    home = self.home / (mode + '-' + kind)
                    job = home / 'job'
                    job.mkdir(parents=True)
                    label = m.FRACTAL_SERVICES[0]
                    service = home / 'Library/LaunchAgents' / (label + '.plist')
                    service.parent.mkdir(parents=True)
                    target = home / 'hm-generation' / service.name
                    original = plistlib.dumps({
                        'Label': label,
                        'ProgramArguments': ['/nix/store/example/bin/fractal-daemon'],
                        'RunAtLoad': True,
                    })
                    if kind != 'dangling':
                        target.parent.mkdir()
                        target.write_bytes(original)
                    link = (str(target) if kind == 'absolute' else
                            '../../hm-generation/' + service.name)
                    service.symlink_to(link)
                    replacements = []
                    replace = os.replace
                    def replace_object(source, destination):
                        if Path(destination) == service:
                            self.assertTrue(Path(source).is_symlink())
                            self.assertEqual(os.readlink(source), link)
                            replacements.append(Path(source))
                        return replace(source, destination)
                    def output(args):
                        args = list(map(str, args))
                        if args[:2] == ['launchctl', 'print-disabled']:
                            self.calls.append(args)
                            return 'disabled services = {\n    "' + label + '" => true\n}\n'
                        if mode == 'failed-install' and args[0] == m.LSREGISTER:
                            self.calls.append(args)
                            raise subprocess.CalledProcessError(1, args, 'injected registration failure')
                        if mode == 'stage-refusal' and args[-3:] == ['service', 'install', '--stage-fractal']:
                            self.calls.append(args)
                            self.assertTrue(service.is_symlink())
                            raise subprocess.CalledProcessError(1, args, 'refusing Home Manager definition')
                        return self.command(args)
                    argv = ['install-macos', '--from', str(self.source), '--home', str(home),
                            '--job', str(job)]
                    if mode == 'stage-refusal':
                        argv.append('--stage-fractal')
                    with patch.dict(os.environ, PATH=''), \
                            patch.object(m, 'command', side_effect=output), \
                            patch.object(m, 'exchange', side_effect=self.exchange), \
                            patch.object(m.os, 'replace', side_effect=replace_object), \
                            contextlib.redirect_stdout(io.StringIO()):
                        if mode == 'restore-app':
                            with patch.object(sys, 'argv', argv + ['--backup-only']):
                                m.main()
                            # Restore must replace a changed definition, not follow
                            # the old link or recreate its referent as a regular file.
                            service.unlink()
                            service.write_bytes(b'replacement definition')
                            with patch.object(sys, 'argv', [
                                    'install-macos', '--home', str(home), '--job', str(job),
                                    '--restore-app']):
                                m.main()
                        else:
                            with patch.object(sys, 'argv', argv):
                                with self.assertRaises(subprocess.CalledProcessError):
                                    m.main()
                    recorded = json.loads((job / 'previous-launchd.json').read_text())[label]
                    self.assertTrue(recorded['present'])
                    self.assertEqual(recorded['link'], link)
                    self.assertFalse((job / 'previous-launchd' / service.name).exists())
                    self.assertTrue(service.is_symlink())
                    self.assertEqual(os.readlink(service), link)
                    self.assertEqual(service.exists(), kind != 'dangling')
                    self.assertEqual(len(replacements), 1)
                    self.assertFalse(replacements[0].is_symlink())
                    if kind != 'dangling':
                        self.assertEqual(target.read_bytes(), original)
                    else:
                        self.assertFalse(target.exists())
                    self.assertFalse(m.fixed(home).exists())
                    if mode == 'stage-refusal':
                        self.assertTrue(recorded['disabled'])
                        self.assertIn(['launchctl', 'disable',
                                       'gui/' + str(os.getuid()) + '/' + label], self.calls)
                    self.assertFalse(any('bootstrap' in call or 'kickstart' in call or 'bootout' in call
                                         for call in self.calls))

    def test_hm_symlink_stage_restore_refuses_loaded_target_before_restoring(self):
        label = m.FRACTAL_SERVICES[0]
        service = self.home / 'Library/LaunchAgents' / (label + '.plist')
        service.parent.mkdir(parents=True)
        service.symlink_to('../../missing-hm-generation/definition.plist')
        with patch.object(m, 'command', side_effect=self.command):
            had_app = m.backup(self.home, self.job, stage_fractal=True)
        service.unlink()
        service.write_bytes(b'new definition')
        self.calls.clear()
        with patch.object(m, 'command', return_value='loaded') as command:
            with self.assertRaisesRegex(RuntimeError, 'loaded launchd service'):
                m.restore(self.home, self.job, had_app)
        self.assertFalse(service.is_symlink())
        self.assertEqual(service.read_bytes(), b'new definition')
        self.assertEqual(command.call_count, 1)
        self.assertEqual(command.call_args.args[0][:2], ['launchctl', 'print'])

    def test_full_bundle_plists_cli_restore_and_unchanged_payload(self):
        bin_dir = m.bin_dir(self.home)
        bin_dir.mkdir(parents=True)
        (bin_dir / 'st3').write_bytes(b'previous executable')
        (bin_dir / 'st3').chmod(0o755)
        (bin_dir / 'st').symlink_to('st3')
        (bin_dir / 'stui').symlink_to('/previous/SmallTalk.app/Contents/MacOS/stui')
        service = self.home / 'Library/LaunchAgents' / (m.SERVICES[0] + '.plist')
        service.parent.mkdir(parents=True)
        original = plistlib.dumps({'ProgramArguments': [str(bin_dir / 'st3'), 'daemon', '--socket', 'keep.sock']})
        service.write_bytes(original)
        with patch.object(m, 'command', side_effect=self.command), patch.object(m, 'exchange', side_effect=self.exchange):
            app, _, _ = m.prepare(self.home, self.job, self.built)
            had_app = m.backup(self.home, self.job)
            m.install(app, self.home, self.job)
            self.assertFalse((bin_dir / 'stui').exists())
            self.assertFalse((bin_dir / 'stui').is_symlink())
            self.assertEqual(set(p.name for p in (m.fixed(self.home) / 'Contents/MacOS').iterdir()), {'fractal'})
            self.assertEqual(os.readlink(bin_dir / 'fractal'), str(m.binaries(m.fixed(self.home))['fractal']))
            self.assertEqual(os.readlink(bin_dir / 'st'), 'fractal')
            self.assertEqual(os.readlink(bin_dir / 'st3'), 'fractal')
            info = plistlib.loads((m.fixed(self.home) / 'Contents/Info.plist').read_bytes())
            self.assertEqual(info['CFBundleExecutable'], 'fractal')
            self.assertEqual(info['CFBundleName'], 'Fractal')
            self.assertEqual(info['CFBundleIdentifier'], m.IDENTIFIER)
            args = plistlib.loads(service.read_bytes())['ProgramArguments']
            self.assertEqual(args, [str(m.binaries(m.fixed(self.home))['fractal']), 'daemon', '--socket', 'keep.sock'])
            self.calls.clear()
            _, identity, _ = m.prepare(self.home, self.job, self.built)
            self.assertTrue(identity['payload_unchanged'])
            self.assertFalse(any('--sign' in call for call in self.calls))
            m.restore(self.home, self.job, had_app)
            self.assertEqual((bin_dir / 'st3').read_bytes(), b'previous executable')
            self.assertEqual(os.readlink(bin_dir / 'st'), 'st3')
            self.assertEqual(os.readlink(bin_dir / 'stui'), '/previous/SmallTalk.app/Contents/MacOS/stui')
            self.assertEqual(service.read_bytes(), original)

    def test_speech_helper_is_nested_signed_before_the_app_and_hashed(self):
        helper = self.source / m.HELPER
        executable = m.helper_executable(helper)
        executable.parent.mkdir(parents=True)
        executable.write_bytes(b'listen-one')
        executable.chmod(0o755)
        (helper / 'Contents/Info.plist').write_bytes(plistlib.dumps({'CFBundleIdentifier': 'x'}))
        built = dict(self.built, **{m.HELPER: helper})
        with patch.object(m, 'command', side_effect=self.command):
            app, _, payload = m.prepare(self.home, self.job, built)
        nested = app / 'Contents/Helpers' / m.HELPER
        self.assertEqual(m.helper_executable(nested).read_bytes(), b'listen-one')
        self.assertEqual(payload['st-listen'], m.sha(executable))
        signs = [call for call in self.calls if '--sign' in call]
        helper_sign = next(index for index, call in enumerate(signs) if 'com.example.smalltalk.listen' in call)
        app_sign = next(index for index, call in enumerate(signs) if call[-1] == str(app))
        self.assertLess(helper_sign, app_sign)
        # macOS asks for the outermost app, so SmallTalk.app carries the usage strings.
        info = plistlib.loads((app / 'Contents/Info.plist').read_bytes())
        self.assertIn('NSMicrophoneUsageDescription', info)

    def test_historical_signed_st3_bundle_restores_without_rewriting_bytes(self):
        historical = m.fixed(self.home)
        executable = historical / 'Contents/MacOS/st3'
        executable.parent.mkdir(parents=True)
        executable.write_bytes(b'historical signed st3')
        executable.chmod(0o755)
        info = historical / 'Contents/Info.plist'
        info.write_bytes(plistlib.dumps({
            'CFBundleExecutable': 'st3', 'CFBundleName': 'St3',
            'CFBundleIdentifier': m.IDENTIFIER}))
        resources = historical / 'Contents/Resources'
        resources.mkdir()
        metadata = resources / 'deploy-payload.json'
        metadata.write_text(json.dumps({
            'hashes': {'st3': m.sha(executable)}, 'certificate': CERT,
            'team': 'EXAMPLE123', 'identifier': m.IDENTIFIER}) + '\n')
        signature = historical / 'Contents/_CodeSignature/CodeResources'
        signature.parent.mkdir()
        signature.write_bytes(b'historical sealed resource bytes')
        original = {p.relative_to(historical): p.read_bytes()
                    for p in historical.rglob('*') if p.is_file()}
        commands = m.bin_dir(self.home)
        commands.mkdir(parents=True)
        (commands / 'st3').symlink_to(executable)
        (commands / 'st').symlink_to('st3')
        (commands / 'fractal').symlink_to('st3')
        with patch.object(m, 'command', side_effect=self.command), \
                patch.object(m, 'exchange', side_effect=self.exchange):
            app, identity, payload = m.prepare(self.home, self.job, self.built)
            self.assertFalse(identity['payload_unchanged'])
            self.assertEqual(set(payload), {'fractal'})
            had_app = m.backup(self.home, self.job)
            self.assertEqual((self.job / 'previous-app/Contents/Resources/deploy-payload.json').read_bytes(),
                             original[Path('Contents/Resources/deploy-payload.json')])
            m.install(app, self.home, self.job)
            self.assertFalse((historical / 'Contents/MacOS/st3').exists())
            self.calls.clear()
            m.restore(self.home, self.job, had_app)
        self.assertEqual({p.relative_to(historical): p.read_bytes()
                          for p in historical.rglob('*') if p.is_file()}, original)
        self.assertEqual(os.readlink(commands / 'st3'), str(executable))
        self.assertEqual(os.readlink(commands / 'st'), 'st3')
        self.assertEqual(os.readlink(commands / 'fractal'), 'st3')
        self.assertFalse(any('--sign' in call for call in self.calls))
        self.assertTrue(any('--extract-certificates=' in arg
                            for call in self.calls for arg in call))

    def test_upgrade_restores_previous_whole_app(self):
        web = self.built['fractal'].parent.parent / 'share/fractal-web'
        web.mkdir(parents=True)
        (web / 'index.html').write_text('embedded web')
        with patch.object(m, 'command', side_effect=self.command), patch.object(m, 'exchange', side_effect=self.exchange):
            app, _, _ = m.prepare(self.home, self.job, self.built)
            m.install(app, self.home, self.job)
            installed_web = m.fixed(self.home) / 'Contents/share/fractal-web'
            (installed_web / 'index.html').chmod(0o444)
            installed_web.chmod(0o555)
            first = {name: m.sha(path) for name, path in m.binaries(m.fixed(self.home)).items()}
            second_job = self.home / 'second'; second_job.mkdir()
            had_app = m.backup(self.home, second_job)
            self.built['fractal'].write_bytes(b'fractal-two')
            app, _, _ = m.prepare(self.home, second_job, self.built)
            m.install(app, self.home, second_job)
            self.assertNotEqual(m.sha(m.binaries(m.fixed(self.home))['fractal']), first['fractal'])
            m.restore(self.home, second_job, had_app)
            self.assertEqual({name: m.sha(path) for name, path in m.binaries(m.fixed(self.home)).items()}, first)
            self.assertTrue(installed_web.stat().st_mode & 0o200)
            self.assertTrue((installed_web / 'index.html').stat().st_mode & 0o200)

    def test_explicit_installation_home_isolates_plists_and_locks(self):
        service = self.home / 'Library/LaunchAgents' / (m.SERVICES[0] + '.plist')
        service.parent.mkdir(parents=True)
        service.write_bytes(plistlib.dumps({'ProgramArguments': ['previous-st3', 'daemon', '--socket', 'keep.sock']}))
        argv = ['install-macos', '--from', str(self.source), '--home', str(self.home), '--job', str(self.job)]
        with patch.object(sys, 'argv', argv), \
                patch.object(Path, 'home', side_effect=AssertionError('must not use real user home')), \
                patch.object(m, 'command', side_effect=self.command), \
                patch.object(m, 'exchange', side_effect=self.exchange), \
                contextlib.redirect_stdout(io.StringIO()):
            m.main()
        self.assertTrue(m.fixed(self.home).is_dir())
        self.assertEqual(plistlib.loads(service.read_bytes())['ProgramArguments'],
                         [str(m.binaries(m.fixed(self.home))['fractal']), 'daemon', '--socket', 'keep.sock'])
        self.assertTrue(list((self.home / '.local/state/st3/macos-installs').glob('*.lock')))

    def test_a_named_instance_installs_beside_the_default_without_touching_it(self):
        agents = self.home / 'Library/LaunchAgents'
        agents.mkdir(parents=True)
        default_service = agents / 'com.compoundingtech.st3.plist'
        default_replication = agents / 'com.compoundingtech.st3.replication.plist'
        for path in (default_service, default_replication):
            path.write_bytes(plistlib.dumps({'ProgramArguments': ['default-st3', 'up', '--socket', 'keep.sock']}))
        default_bin = self.home / '.local/bin'
        default_bin.mkdir(parents=True)
        (default_bin / 'fractal').write_bytes(b'default executable')
        for name in ('st', 'st3'):
            (default_bin / name).symlink_to('fractal')
        before = {p: p.read_bytes() for p in (default_service, default_replication, default_bin / 'fractal')}
        identities = {p: (p.lstat().st_dev, p.lstat().st_ino) for p in default_bin.iterdir()}
        instance = self.home / '.st-instance/try'
        labels = ['com.compoundingtech.st3.instance.try', 'com.compoundingtech.st3.instance.try.replication']
        for label in labels:
            (agents / (label + '.plist')).write_bytes(plistlib.dumps({'ProgramArguments': ['old', 'up']}))
        argv = ['install-macos', '--from', str(self.source), '--home', str(self.home), '--job', str(self.job),
                '--identifier', 'com.compoundingtech.smalltalk.instance.try']
        with patch.object(m, 'INSTANCE', 'try'), patch.object(m, 'SERVICES', labels), \
                patch.dict(os.environ, {'PATH': str(default_bin) + os.pathsep + os.environ.get('PATH', '')}), \
                patch.object(sys, 'argv', argv), \
                patch.object(Path, 'home', side_effect=AssertionError('must not use real user home')), \
                patch.object(m, 'command', side_effect=self.command), \
                patch.object(m, 'exchange', side_effect=self.exchange), \
                contextlib.redirect_stdout(io.StringIO()):
            m.main()
            app, commands, state = m.fixed(self.home), m.bin_dir(self.home), m.state_root(self.home)
        self.assertEqual(app, instance / 'app/SmallTalk.app')
        self.assertEqual(commands, instance / 'bin')
        self.assertEqual(state, instance / 'state/st3/macos-installs')
        self.assertTrue(app.is_dir())
        self.assertTrue(list(state.glob('*.lock')))
        self.assertFalse((self.home / 'Applications').exists())
        self.assertFalse((self.home / '.local/state').exists())
        for label in labels:
            program = plistlib.loads((agents / (label + '.plist')).read_bytes())['ProgramArguments'][0]
            self.assertEqual(program, str(app / 'Contents/MacOS/fractal'))
        for path, content in before.items():
            self.assertEqual(path.read_bytes(), content, path)
        self.assertEqual(sorted(p.name for p in default_bin.iterdir()), ['fractal', 'st', 'st3'])
        for path, identity in identities.items():
            self.assertEqual((path.lstat().st_dev, path.lstat().st_ino), identity)
        for name in ('st', 'st3'):
            self.assertEqual(os.readlink(default_bin / name), 'fractal')

    def test_an_invalid_instance_name_is_refused_before_anything_is_chosen(self):
        for bad in ['Try', 'a b', '../x', '-a', 'a--b', 'x' * 25]:
            result = subprocess.run([sys.executable, str(Path(__file__).with_name('install-macos.py')), '--help'],
                                    env={**os.environ, 'ST_INSTANCE': bad}, capture_output=True, text=True)
            self.assertNotEqual(result.returncode, 0, bad)
            self.assertIn('invalid instance name', result.stderr + result.stdout)

    def test_both_wrappers_delegate_macos_tools_without_replacing_the_links(self):
        repo = Path(__file__).resolve().parent.parent
        fakebin = self.home / 'fakebin'; fakebin.mkdir()
        (fakebin / 'uname').write_text('#!/bin/sh\necho Darwin\n')
        helper = fakebin / 'python3'
        helper.write_text('#!' + sys.executable + '\n' +
            'import os,pathlib,shutil,sys\n' +
            'if sys.argv[1] == "-": os.execv(sys.executable, [sys.executable] + sys.argv[1:])\n' +
            'source=pathlib.Path(sys.argv[sys.argv.index("--from")+1])\n' +
            'destination=pathlib.Path(sys.argv[sys.argv.index("--bin-dir")+1])\n' +
            'instance=os.environ.get("FRACTAL_INSTANCE")\n' +
            'if instance:\n' +
            '    app=pathlib.Path(os.environ["ST_MACOS_INSTALL_HOME"])/".st-instance"/instance/"app/SmallTalk.app/Contents/MacOS"\n' +
            '    app.mkdir(parents=True,exist_ok=True)\n' +
            '    shutil.copy2(source/"fractal",app/"fractal")\n' +
            '    source=app\n' +
            'for name in ["fractal"]:\n' +
            '    (destination/name).unlink(missing_ok=True)\n' +
            '    (destination/name).symlink_to(source/name)\n' +
            'for name in ["st", "st3"]:\n' +
            '    (destination/name).unlink(missing_ok=True)\n' +
            '    (destination/name).symlink_to("fractal")\n')
        for path in fakebin.iterdir():
            path.chmod(0o755)
        for name in ('bash', 'dirname', 'basename', 'readlink', 'mkdir', 'mktemp',
                     'ln', 'cp', 'chmod', 'mv', 'rm', 'rmdir', 'stat', 'tr'):
            (fakebin / name).symlink_to(shutil.which(name, path=self.original_path))
        for name in ['fractal', 'st3-migrate', 'pty']:
            path = self.source / name
            path.write_text('#!/bin/sh\nexit 0\n'); path.chmod(0o755)
        env = dict(os.environ, PATH=str(fakebin),
                   ST_MACOS_INSTALL_HOME=str(self.home))
        first = self.home / 'source-bin'
        subprocess.run([str(repo / 'scripts/install'), '--from', str(self.source), '--bin-dir', str(first)],
                       env=env, check=True, stdout=subprocess.PIPE)
        package = self.home / 'package'; package.mkdir()
        shutil.copy2(repo / 'scripts/install-release', package / 'install.sh')
        shutil.copytree(self.source, package / 'bin')
        (package / 'share/fractal-web').mkdir(parents=True)
        (package / 'share/fractal-web/index.html').write_text('<!doctype html><title>Fractal</title>')
        second = self.home / 'release-bin'
        subprocess.run([str(package / 'install.sh'), '--bin-dir', str(second)],
                       env=env, check=True, stdout=subprocess.PIPE)
        for destination in [first, second]:
            self.assertTrue((destination / 'fractal').is_symlink())
            self.assertEqual(os.readlink(destination / 'fractal'), str(self.source / 'fractal')
                             if destination == first else str(package / 'bin/fractal'))
            self.assertEqual(os.readlink(destination / 'st3'), 'fractal')
            self.assertFalse((destination / 'stui').exists())
            self.assertFalse((destination / 'stui').is_symlink())
            self.assertEqual(os.readlink(destination / 'st'), 'fractal')
            self.assertFalse((destination / 'st3-migrate').is_symlink())
        # A second source install must accept its own instance app link, not
        # mistake it for the archive wrapper's shared-app --app override.
        instance_bin = self.home / 'source-instance-bin'
        command = [str(repo / 'scripts/install'), '--instance', 'upgrade',
                   '--from', str(self.source), '--bin-dir', str(instance_bin)]
        for _ in range(2):
            subprocess.run(command, env=env, check=True, stdout=subprocess.PIPE)
        self.assertEqual(os.readlink(instance_bin / 'fractal'),
                         str(self.home / '.st-instance/upgrade/app/SmallTalk.app/Contents/MacOS/fractal'))

    @unittest.skipUnless(sys.platform == 'darwin', 'native macOS signing and atomic directory exchange')
    def test_native_ad_hoc_install_upgrade_and_rollback(self):
        shutil.copyfile('/usr/bin/true', self.built['fractal'])
        app, _, _ = m.prepare(self.home, self.job, self.built)
        m.install(app, self.home, self.job)
        first = m.sha(m.binaries(m.fixed(self.home))['fractal'])
        second_job = self.home / 'native-second'; second_job.mkdir()
        had_app = m.backup(self.home, second_job)
        shutil.copyfile('/bin/echo', self.built['fractal'])
        app, _, _ = m.prepare(self.home, second_job, self.built)
        m.install(app, self.home, second_job)
        self.assertNotEqual(m.sha(m.binaries(m.fixed(self.home))['fractal']), first)
        m.restore(self.home, second_job, had_app)
        self.assertEqual(m.sha(m.binaries(m.fixed(self.home))['fractal']), first)
        m.verify(m.fixed(self.home))


if __name__ == '__main__':
    unittest.main()
