#!/usr/bin/env python3
"""Regression proofs for isolated test process ownership; never uses fleet daemons."""
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from types import SimpleNamespace
import unittest
from unittest.mock import patch

sys.dont_write_bytecode = True
HERE = Path(__file__).resolve().parent
from script_process import signal_private


def canary_module():
    loader = SourceFileLoader("boot_canary", str(HERE / "fractal-boot-canaries/run"))
    module = module_from_spec(spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


def boot_fixture(binary, evidence, mode):
    """Use the actual boot-canary Node, then deliberately omit its cleanup.

    A detached stand-in covers the PTY server's double-fork/new-session behavior.
    Normal exit deletes the daemon's binary directory before guardian cleanup,
    reproducing the observed deleted-/tmp/bc-*/bin/st3 leak.
    """
    canary = canary_module()
    root = canary.private_root()
    try:
        node = canary.Node(root, Path(binary).resolve(), "claude")
        node.start()
        detached = subprocess.Popen([sys.executable, "-c", """
import os, time
if os.fork(): os._exit(0)
os.setsid()
if os.fork(): os._exit(0)
print(os.getpid(), flush=True)
time.sleep(600)
"""], stdout=subprocess.PIPE, text=True)
        escaped = int(detached.stdout.readline())
        detached.wait()
        exited = None
        if mode == "reap":
            short_lived = subprocess.Popen([sys.executable, "-c", """
import os, time
if os.fork(): os._exit(0)
os.setsid()
if os.fork(): os._exit(0)
print(os.getpid(), flush=True)
time.sleep(0.1)
"""], stdout=subprocess.PIPE, text=True)
            exited = int(short_lived.stdout.readline())
            short_lived.wait()
        evidence = Path(evidence)
        evidence.mkdir(parents=True, exist_ok=True)
        (evidence / "ready.json").write_text(json.dumps({
            "daemon": node.daemon.pid, "escaped": escaped, "root": str(root),
            "fixture": os.getpid(), "guardian": int(os.environ["FRACTAL_TEST_SUPERVISOR"]),
            "exited": exited,
        }))
        if mode == "exit":
            return
        if mode == "failure":
            raise AssertionError("injected failure before cleanup")
        while True:
            time.sleep(1)
    finally:
        shutil.rmtree(root, ignore_errors=True)


def wait_for(predicate, message, timeout=10):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        value = predicate()
        if value:
            return value
        time.sleep(0.02)
    raise AssertionError(message)


class OwnershipTests(unittest.TestCase):
    def test_direct_entrypoint_preserves_consumed_arguments(self):
        with tempfile.TemporaryDirectory(prefix="guardian-argv-") as directory:
            script = Path(directory) / "fixture.py"
            script.write_text(f"""
import os, sys
sys.path.insert(0, {str(HERE)!r})
from fractal_test_process import supervised_main
argument = sys.argv.pop()
def check():
    assert 'ST_AGENT' not in os.environ
    print(argument)
    return 0
if __name__ == '__main__':
    raise SystemExit(supervised_main(check))
""")
            env = dict(os.environ)
            env.pop("FRACTAL_TEST_SUPERVISOR", None)
            env["ST_AGENT"] = "agent/fixture/host"
            result = subprocess.run([sys.executable, str(script), "preserved-fixture-argument"],
                                    env=env, capture_output=True, text=True, timeout=5)
            self.assertEqual(result.returncode, 0, result.stderr)
            self.assertEqual(result.stdout.strip(), "preserved-fixture-argument")

    def fixture(self, mode, signal_to_test=None, signal_to_fixture=None):
        with tempfile.TemporaryDirectory(prefix="cleanup-proof-") as directory:
            evidence = Path(directory)
            # These read the fixture's PIDs from this namespace, so its guardian stays here.
            # NamespaceTests cover the guardian in its own PID namespace.
            env = {**os.environ, "ST3_CLEANUP_FIXTURE": directory,
                   "ST3_CLEANUP_FIXTURE_MODE": mode, "PYTHONDONTWRITEBYTECODE": "1",
                   "FRACTAL_TEST_PID_NAMESPACE": "off"}
            # This is the real Rust test process, including supervise_test(),
            # rather than a Python approximation of nextest's kill behavior.
            with (evidence / "rust.log").open("wb") as log:
                runner = subprocess.Popen([RUST_TEST, "--exact", "boot_canaries::cleanup_fixture",
                                           "--ignored", "--nocapture"], env=env, stdout=log, stderr=log)
                rows = None
                fixture_fds = []
                try:
                    def ready():
                        path = evidence / "ready.json"
                        if not path.exists():
                            self.assertIsNone(runner.poll(), (evidence / "rust.log").read_text())
                            return None
                        try:
                            return json.loads(path.read_text())
                        except json.JSONDecodeError:
                            return None
                    rows = wait_for(ready, "boot-canary daemon did not become ready", timeout=90)
                    for kind in ("daemon", "escaped", "fixture"):
                        try:
                            fixture_fds.append(os.pidfd_open(rows[kind]))
                        except ProcessLookupError:
                            pass
                    if mode == "reap":
                        wait_for(lambda: not Path(f"/proc/{rows['exited']}").exists(),
                                 "exited adopted PTY remained a zombie during the test", timeout=2)
                        self.assertIsNone(runner.poll(), "guardian ended the running test")
                        self.assertTrue(Path(f"/proc/{rows['daemon']}").exists())
                        self.assertTrue(Path(f"/proc/{rows['escaped']}").exists())
                    if signal_to_test:
                        runner.send_signal(signal_to_test)
                    if signal_to_fixture:
                        signal_private(rows["fixture"], signal_to_fixture,
                                       environment={"ST3_CLEANUP_FIXTURE": directory})
                    runner.wait(timeout=10)
                    if mode == "exit":
                        self.assertEqual(runner.returncode, 0, (evidence / "rust.log").read_text())
                    else:
                        self.assertNotEqual(runner.returncode, 0)
                    for kind in ("daemon", "escaped"):
                        wait_for(lambda: not Path(f"/proc/{rows[kind]}").exists(),
                                 f"{kind} {rows[kind]} outlived its test", timeout=5)
                finally:
                    if runner.poll() is None:
                        runner.kill()
                        runner.wait()
                    if rows:
                        # Only these explicitly recorded private fixture processes.
                        # Keep regression failures from becoming another leak.
                        for fd in fixture_fds:
                            try:
                                signal.pidfd_send_signal(fd, signal.SIGKILL)
                            except ProcessLookupError:
                                pass
                            finally:
                                os.close(fd)
                        shutil.rmtree(rows["root"], ignore_errors=True)

    def test_success_reaps_daemon_and_detached_descendant(self):
        self.fixture("exit")

    def test_assertion_failure_reaps_daemon_and_detached_descendant(self):
        self.fixture("failure")

    def test_rust_panic_reaps_daemon_and_detached_descendant(self):
        self.fixture("panic")

    def test_sigkill_of_rust_test_reaps_daemon_and_detached_descendant(self):
        self.fixture("hold", signal_to_test=signal.SIGKILL)

    def test_sigterm_of_rust_test_reaps_daemon_and_detached_descendant(self):
        self.fixture("hold", signal_to_test=signal.SIGTERM)

    def test_sigkill_of_python_fixture_reaps_daemon_and_detached_descendant(self):
        self.fixture("hold", signal_to_fixture=signal.SIGKILL)

    def test_exited_adopted_pty_is_reaped_while_test_is_running(self):
        self.fixture("reap", signal_to_test=signal.SIGTERM)

    def test_evidence_failure_cannot_skip_node_stop(self):
        canary = canary_module()
        node = SimpleNamespace(root=Path("/unused-private-canary"), daemon=None)
        node.start = lambda: canary.fail("injected startup failure")
        node.pty = lambda *args: (_ for _ in ()).throw(OSError("injected evidence failure"))
        args = SimpleNamespace(binary=Path(BINARY), harness="claude", scenario="fresh", bound=180)
        with patch.object(canary, "register"), patch.object(canary, "capture", return_value=[]), \
             patch.object(canary, "Node", return_value=node), patch.object(node, "stop", create=True) as stop:
            with self.assertRaisesRegex(OSError, "evidence failure"):
                canary.run(args, node.root, Path("/unused-evidence"))
            stop.assert_called_once()


ANCESTRY = """
import json, os
def readable(pid):
    try:
        open(f"/proc/{pid}/environ", "rb").read(1)
        return True
    except OSError:
        return False
pid, chain = os.getpid(), []
while pid > 1:
    status = dict(line.split(":", 1) for line in open(f"/proc/{pid}/status").read().splitlines() if ":" in line)
    parent = int(status["PPid"])
    chain.append([pid, parent, readable(pid)])
    pid = parent
print(json.dumps({"namespace": os.readlink("/proc/self/ns/pid"), "chain": chain,
                  "supervisor": os.environ.get("FRACTAL_TEST_SUPERVISOR")}))
"""


def supervised(command, namespace=True, **env):
    """Run a command under the guardian from a caller without seat ancestry, asking for a PID
    namespace as supervise_test does."""
    environment = {key: value for key, value in os.environ.items() if key not in ("ST_AGENT", "ST3_SUBJECT")}
    environment.update(env)
    flags = ["--pid-namespace"] if namespace else []
    return subprocess.run([sys.executable, str(HERE / "fractal_test_process.py"), *flags, "--", *command],
                          env=environment, capture_output=True, text=True, timeout=30)


class NamespaceTests(unittest.TestCase):
    def setUp(self):
        sys.path.insert(0, str(HERE))
        from fractal_test_process import pid_namespace_available
        if not pid_namespace_available():
            self.skipTest("unprivileged user and PID namespaces are unavailable here")

    def test_the_walk_from_a_test_ends_at_the_namespace_init_through_readable_ancestors(self):
        result = supervised([sys.executable, "-c", ANCESTRY])
        self.assertEqual(result.returncode, 0, result.stderr)
        seen = json.loads(result.stdout)
        self.assertNotEqual(seen["namespace"], os.readlink("/proc/self/ns/pid"))
        # The guardian is PID 2 under a minimal PID 1, and the caller-ancestry walk can read
        # every process it climbs; no seat subreaper (systemd --user) is in the chain.
        self.assertEqual(seen["supervisor"], "2")
        self.assertEqual(seen["chain"][-1][:2], [2, 1])
        self.assertTrue(all(readable for _, _, readable in seen["chain"]), seen["chain"])

    def test_a_detached_leftover_ends_with_its_namespace(self):
        leftover = """
import os, time
print(os.readlink("/proc/self/ns/pid"), flush=True)
if os.fork() == 0:
    os.setsid()
    if os.fork() == 0:
        time.sleep(600)
    os._exit(0)
"""
        result = supervised([sys.executable, "-c", leftover])
        self.assertEqual(result.returncode, 0, result.stderr)
        namespace = result.stdout.split()[0]
        from fractal_test_process import namespace_holders
        # Exiting processes leave /proc a moment after the supervisor reports.
        wait_for(lambda: not namespace_holders(namespace), f"processes outlived {namespace}", timeout=2)

    def test_the_exit_status_passes_through(self):
        self.assertEqual(supervised(["sh", "-c", "exit 7"]).returncode, 7)

    def test_without_the_flag_the_guardian_stays_in_this_namespace(self):
        # Stages and scripts may run cargo, whose host-wide queue judges tickets by PID.
        result = supervised([sys.executable, "-c", ANCESTRY], namespace=False)
        self.assertEqual(result.returncode, 0, result.stderr)
        seen = json.loads(result.stdout)
        self.assertEqual(seen["namespace"], os.readlink("/proc/self/ns/pid"))
        self.assertNotEqual(seen["supervisor"], "2")

    def test_off_keeps_the_guardian_in_this_namespace(self):
        result = supervised([sys.executable, "-c", ANCESTRY], FRACTAL_TEST_PID_NAMESPACE="off")
        self.assertEqual(result.returncode, 0, result.stderr)
        seen = json.loads(result.stdout)
        self.assertEqual(seen["namespace"], os.readlink("/proc/self/ns/pid"))
        self.assertNotEqual(seen["supervisor"], "2")


if __name__ == "__main__":
    if sys.argv[1:2] == ["--boot-fixture"]:
        boot_fixture(*sys.argv[2:])
    else:
        BINARY, RUST_TEST = sys.argv[1:3]
        del sys.argv[1:3]
        unittest.main()
