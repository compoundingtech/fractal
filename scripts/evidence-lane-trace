#!/usr/bin/env python3
"""Check a lane's declared definition against what its command really touches.

  scripts/evidence-lane-trace --lane NAME --lanes-file FILE --root DIR --analyze RAW_STRACE
  scripts/evidence-lane-trace --lane NAME --lanes-file FILE --root DIR --raw OUT -- COMMAND...   (runs COMMAND under strace -f -y)

`.st/required-lanes.json` lists, per lane, the files whose bytes decide what the lane runs (`definition_paths`), the sources it
tests (`tree_inputs`) and the paths it looks for and does not find (`absent_paths`). Those lists are written by hand, and a file the
lane reads but the list omits would let a change alter the lane while keeping a valid digest. This tool is the closure control:
it reads an `strace -f` log of one real run of the lane's command and reports

  uncovered_reads            repository files the run opened or stat'ed successfully that are in none of the three lists
  uncovered_absence_probes   repository paths the run looked for and did not find (ENOENT/ENOTDIR) that are in none of the three lists

A path is covered by an entry equal to it or below a directory entry; a lane whose `tree_inputs` is `.` (its input is the whole tree) has
nothing under the root left uncovered, and the trace then only shows how many paths were touched and whether any call could not be placed. Ancestor directories of a declared path are not reported,
and neither is anything inside `node_modules` or `.git` (installed or object storage, not tree content); a MISSING `node_modules`
directory is still reported, because a tracked file appearing under it would change module resolution. Relative paths are resolved
with the process's working directory (tracked through chdir and clone, starting at --root) or with the directory an `strace -y`
log prints for the dirfd; `unresolved_calls` counts the calls that could not be placed (an unannotated dirfd), and a lane with any is
not closed by this trace.

Exit 0 when both uncovered lists are empty, 1 otherwise, 2 for a usage error. It needs only Python for --analyze; --run needs strace
and runs the command from --root with the caller's environment (take the trace in the same dev shell the lane uses).
"""
import argparse
import json
import os
import re
import subprocess
import sys

sys.dont_write_bytecode = True

OPENING = {'open', 'openat', 'openat2', 'stat', 'lstat', 'statx', 'newfstatat', 'fstatat64', 'access', 'faccessat', 'faccessat2',
           'readlink', 'readlinkat', 'execve'}
WITH_DIRFD = {'openat', 'openat2', 'statx', 'newfstatat', 'fstatat64', 'faccessat', 'faccessat2', 'readlinkat'}
FORKS = {'clone', 'clone3', 'fork', 'vfork'}
TRACE = ','.join(sorted(OPENING | FORKS | {'chdir', 'getdents64'}))
DIRFD = re.compile(r'^\s*(AT_FDCWD|-?\d+)(?:<([^>]*)>)?\s*,')
COMPLETE = re.compile(r'^(?:\[pid\s+)?(\d+)\]?\s+(\w+)\((.*)\)\s+=\s+(-?\d+|\?)(.*)$')
UNFINISHED = re.compile(r'^(?:\[pid\s+)?(\d+)\]?\s+(\w+)\((.*?)\s*<unfinished \.\.\.>\s*$')
RESUMED = re.compile(r'^(?:\[pid\s+)?(\d+)\]?\s+<\.\.\.\s+(\w+)\s+resumed>.*\)\s+=\s+(-?\d+|\?)(.*)$')
FIRST_STRING = re.compile(r'"((?:[^"\\]|\\.)*)"')
WRITE_FLAGS = ('O_WRONLY', 'O_RDWR', 'O_CREAT', 'O_TRUNC')


def unquote(text):
    return bytes(text, 'utf-8').decode('unicode_escape', errors='replace') if '\\' in text else text


def analyze(lines, root):
    """(opened, missing, unresolved) of repository-relative paths under `root` from strace -f -y lines."""
    root = os.path.realpath(root).rstrip('/') + '/'
    start = root.rstrip('/')
    opened, missing, unresolved = set(), set(), 0
    cwd = {}
    pending = {}

    def cwd_of(pid):
        return cwd.setdefault(pid, start)

    for line in lines:
        line = line.rstrip('\n')
        started = UNFINISHED.match(line)
        if started:
            pending[started.group(1)] = (started.group(2), started.group(3))
            continue
        resumed = RESUMED.match(line)
        if resumed and resumed.group(1) in pending:
            pid = resumed.group(1)
            call, args = pending.pop(pid)
            ret, tail = resumed.group(3), resumed.group(4)
            if call != resumed.group(2):
                continue
        else:
            done = COMPLETE.match(line)
            if not done:
                continue
            pid, call, args, ret, tail = done.group(1), done.group(2), done.group(3), done.group(4), done.group(5)
        if ret == '?':
            continue
        code = int(ret)
        if call in FORKS:
            if code > 0:
                cwd[str(code)] = cwd_of(pid)
            continue
        strings = FIRST_STRING.findall(args)
        if call == 'chdir':
            if code == 0 and strings:
                target = unquote(strings[0])
                cwd[pid] = os.path.normpath(target if target.startswith('/') else os.path.join(cwd_of(pid), target))
            continue
        if call not in OPENING or not strings:
            continue
        path = unquote(strings[0])
        if path == '':
            continue  # an fstat of an fd the run already opened
        if not path.startswith('/'):
            base = cwd_of(pid)
            if call in WITH_DIRFD:
                fd = DIRFD.match(args)
                if fd is None:
                    unresolved += 1
                    continue
                if fd.group(2):
                    base = fd.group(2)  # strace -y prints the directory (the working directory for AT_FDCWD)
                elif fd.group(1) != 'AT_FDCWD':
                    unresolved += 1
                    continue
            path = os.path.normpath(os.path.join(base, path))
        else:
            path = os.path.normpath(path)
        if not (path + '/').startswith(root):
            continue
        relative_path = path[len(root):].rstrip('/')
        if not relative_path:
            continue
        if code >= 0:
            if call in ('open', 'openat', 'openat2') and any(flag in args for flag in WRITE_FLAGS):
                continue  # something the run wrote, not an input
            opened.add(relative_path)
        elif 'ENOENT' in tail or 'ENOTDIR' in tail:
            missing.add(relative_path)
    return opened, missing, unresolved


def under(path, entry):
    return path == entry or path.startswith(entry + '/')


def is_ancestor(path, entries):
    return any(entry.startswith(path + '/') for entry in entries)


def ignorable_read(path):
    parts = path.split('/')
    return 'node_modules' in parts or parts[0] == '.git'


def report(rules, opened, missing, unresolved):
    declared = list(rules['definition_paths']) + list(rules['tree_inputs'])
    absent = list(rules.get('absent_paths', ()))
    if '.' in rules['tree_inputs']:
        # A lane whose input is the whole tree (genie-freshness regenerates and checks every file): nothing under the root is uncovered.
        return {'uncovered_reads': [], 'uncovered_absence_probes': [], 'unresolved_calls': unresolved,
                'opened': len(opened), 'missing': len(missing), 'whole_tree_lane': True}
    reads = sorted(p for p in opened if not ignorable_read(p) and not any(under(p, e) for e in declared)
                   and not is_ancestor(p, declared + absent))
    probes = sorted(p for p in missing
                    if not (p.split('/')[0] == '.git' or 'node_modules' in p.split('/')[:-1])  # inside installed packages: not tree content
                    and not any(under(p, e) for e in declared + absent) and not is_ancestor(p, declared + absent))
    return {'uncovered_reads': reads, 'uncovered_absence_probes': probes, 'unresolved_calls': unresolved,
            'opened': len(opened), 'missing': len(missing)}


def load_rules(args):
    here = os.path.dirname(os.path.abspath(__file__))
    from importlib.machinery import SourceFileLoader
    from importlib.util import module_from_spec, spec_from_loader
    loader = SourceFileLoader('evidence_verify_for_trace', os.path.join(here, 'evidence-verify'))
    verifier = module_from_spec(spec_from_loader(loader.name, loader))
    loader.exec_module(verifier)
    with open(args.lanes_file) as handle:
        return verifier.lane_rules(handle.read(), args.lane)


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('--lane', required=True)
    parser.add_argument('--lanes-file', required=True, help='the lane file (take it from the accepted base)')
    parser.add_argument('--root', required=True, help='the checkout the lane ran in')
    parser.add_argument('--analyze', metavar='RAW', help='an strace -f log to analyze instead of running a command')
    parser.add_argument('--raw', metavar='OUT', help='with a command: where to write the strace log')
    parser.add_argument('command', nargs=argparse.REMAINDER)
    try:
        args = parser.parse_args(argv)
    except SystemExit as error:
        return 2 if error.code else 0
    command = args.command[1:] if args.command[:1] == ['--'] else args.command
    if bool(args.analyze) == bool(command):
        print('give either --analyze RAW or a command after --', file=sys.stderr)
        return 2
    try:
        rules = load_rules(args)
    except Exception as error:  # a missing or broken lane file is a usage-level refusal here, never a pass
        print(f'lane file: {error}', file=sys.stderr)
        return 2
    raw = args.analyze
    if command:
        raw = args.raw or os.path.join(os.environ.get('TMPDIR', '/tmp'), f'evidence-lane-trace-{os.getpid()}.raw')
        run = subprocess.run(['strace', '-f', '-y', '-qq', '-s', '400', '-e', f'trace={TRACE}', '-o', raw, *command], cwd=args.root,
                             stdout=sys.stderr)  # the traced command's own output must not mix into the JSON report
        if run.returncode != 0:
            print(f'the traced command exited {run.returncode}; a failing run is not a valid trace', file=sys.stderr)
            return 1
    with open(raw, errors='replace') as handle:
        result = report(rules, *analyze(handle, args.root))
    result['lane'] = args.lane
    print(json.dumps(result, indent=2))
    return 1 if result['uncovered_reads'] or result['uncovered_absence_probes'] else 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
