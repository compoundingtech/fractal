#!/usr/bin/env python3
"""Prepare an exact-cache archive; a claimed hit may never fall back to the network."""
import argparse
import json
import os
from pathlib import Path
import re
import subprocess
import tempfile


def identity(kind, target, *, root=None):
    root = root or Path(__file__).resolve().parent.parent
    manifest = json.loads((root / f".github/{kind}-compat-baseline.json").read_text())
    sha = manifest["bundles"][target]["sha256"]
    if not isinstance(sha, str) or not re.fullmatch(r"[a-f0-9]{64}", sha):
        raise ValueError(f"Invalid pinned SHA256 for {kind}/{target}")
    relative = Path("tmp/compat-archives") / target / f"{sha}.tar.gz"
    # Cache version paths must be identical across hosted and Namespace runners.
    return {"sha256": sha, "key": f"compat-archive-v1-{target}-{sha}",
            "cache-path": str(relative), "path": str(root / relative)}


def prepare(kind, target, archive, *, cache_hit, root=None, run=subprocess.run):
    root = root or Path(__file__).resolve().parent.parent
    archive = Path(archive).resolve()
    archive.parent.mkdir(parents=True, exist_ok=True)
    env = os.environ.copy()
    # Never inherit an unrelated local override on a producer cache miss.
    env.pop("COMPAT_BASELINE_ARCHIVE", None)
    if cache_hit:
        # Missing/corrupt restored bytes fail closed in compat-baseline, even on an installed hit.
        env["COMPAT_BASELINE_ARCHIVE"] = str(archive)
    with tempfile.TemporaryDirectory(prefix="compat-verify-") as extraction:
        run(["python3", str(root / "scripts/compat-baseline"), kind, extraction,
             "--target", target, "--save-archive", str(archive)],
            env=env, check=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("identity", "prepare"))
    parser.add_argument("kind", choices=("fleet", "messaging"))
    parser.add_argument("target", choices=("x86_64-unknown-linux-gnu", "aarch64-apple-darwin"))
    parser.add_argument("archive", type=Path, nargs="?")
    args = parser.parse_args()
    if args.action == "identity":
        if args.archive is not None:
            parser.error("identity does not accept an archive path")
        values = identity(args.kind, args.target)
        with open(os.environ["GITHUB_OUTPUT"], "a") as output:
            for key, value in values.items():
                output.write(f"{key}={value}\n")
        with open(os.environ["GITHUB_ENV"], "a") as environment:
            environment.write(f"COMPAT_BASELINE_ARCHIVE={values['path']}\n")
    else:
        if args.archive is None:
            parser.error("prepare requires an archive path")
        prepare(args.kind, args.target, args.archive,
                cache_hit=os.environ.get("COMPAT_ARCHIVE_CACHE_HIT") == "true")


if __name__ == "__main__":
    main()
