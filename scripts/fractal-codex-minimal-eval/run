#!/usr/bin/env bash
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
# Run the paid codex-minimal-access eval once in an isolated daemon whose config selects
# access_mode = "auto". The eval declares its Codex seat with only a model, so the seat can reach
# the managed st-managed profile only through the driver's defaults.
#
# Usage: run BIN_DIR OUT [MODEL]
#
# BIN_DIR holds the st3 binary under test. OUT receives start.json, status.json, history.jsonl,
# the seat's transcript, its provider argv (codex-argv.txt) and verdict.txt.
set -Eeuo pipefail

here="$(cd "$(dirname "$0")" && pwd)"
repo="$(cd "$here/../.." && pwd)"
source "$repo/scripts/fractal-seat-queue-perf/daemon.sh"
bin_dir="$(readlink -f "$1")"
mkdir -p "$2"
out="$(cd "$2" && pwd)"
model="${3:-gpt-6-luna}"

now() { date -u +%Y-%m-%dT%H:%M:%SZ; }

stage="$(mktemp -d)"
cp -r "$repo/evals/fractal/codex-minimal-access/." "$stage/"
rm -f "$stage/README.md"
sed -i "s|model \"gpt-6-luna\"|model \"$model\"|" "$stage/eval.kdl"
(
  cd "$stage"
  mapfile -t files < <(find . -type f | sed 's|^\./||' | sort)
  tar --format=ustar --owner=0 --group=0 --numeric-owner --mtime=@0 -cf "$out/bundle.tar" "${files[@]}"
  cp eval.kdl "$out/eval.kdl"
)
rm -rf "$stage"
python3 - "$out/bundle.tar" >"$out/request.json" <<'PY'
import hashlib, json, sys
data = open(sys.argv[1], "rb").read()
print(json.dumps({"name": "codex-minimal-access", "bundle_hash": hashlib.sha256(data).hexdigest(),
                  "bundle": list(data), "inputs": {}}))
PY
{
  git -C "$repo" rev-parse HEAD
  git -C "$repo" status --short
  sha256sum "$bin_dir/st3"
  codex --version
} >"$out/candidate.txt"

root="$(mktemp -d /tmp/cma.XXXXXX)"
# shellcheck disable=SC2064
trap "perf_stop_daemon '$root' >/dev/null 2>&1 || true; rm -rf '$root'" EXIT
mkdir -p "$root/bin" "$root/state" "$root/pty"
cp "$bin_dir/st3" "$root/bin/"
cat >"$root/config.toml" <<TOML
node = "evalnode"
person = "person/eval-operator"
state_dir = "$root/state"
socket = "$root/st3.sock"
client_gateway_socket = "$root/client.sock"
access_mode = "auto"
TOML
env -i HOME="$HOME" USER="$USER" LOGNAME="$USER" SHELL="$SHELL" LANG="${LANG:-C.UTF-8}" \
  PATH="$root/bin:$(perf_login_path)" \
  setsid "$root/bin/st3" up --config "$root/config.toml" --pty-root "$root/pty" \
  >"$root/daemon.log" 2>&1 </dev/null &
echo $! >"$root/daemon.pid"
for _ in $(seq 1 150); do
  [[ -S "$root/st3.sock" ]] && break
  sleep 0.2
done
[[ -S "$root/st3.sock" ]] || { echo "the eval daemon did not open its socket" >&2; exit 1; }

# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
export FRACTAL_ENDPOINT="$root/st3.sock" ST3_ENDPOINT="$root/st3.sock"
"$root/bin/st3" doctor --json >"$out/doctor.json" 2>/dev/null || true
now >"$out/posted-at"
curl -sS --fail-with-body --unix-socket "$root/st3.sock" -H 'content-type: application/json' \
  --data-binary @"$out/request.json" http://localhost/v1/evals >"$out/start.json"
run="$(jq -er .value.mission_run "$out/start.json")"
deadline=$((SECONDS + 1500))
: >"$out/codex-argv.txt"
while ((SECONDS < deadline)); do
  # The provider's own command line is the record of the permissions it started with.
  if [[ ! -s $out/codex-argv.txt ]]; then
    for proc in /proc/[0-9]*; do
      [[ -r $proc/cmdline ]] || continue
      if tr '\0' ' ' <"$proc/cmdline" 2>/dev/null | grep -q 'default_permissions='; then
        tr '\0' '\n' <"$proc/cmdline" >"$out/codex-argv.txt" 2>/dev/null
        break
      fi
    done
  fi
  curl -sS --unix-socket "$root/st3.sock" "http://localhost/v1/evals/$(jq -rn --arg r "$run" '$r|@uri')" \
    >"$out/status.json" 2>/dev/null || true
  jq -e '.value.verdict != null and .value.cleanup == "complete"' "$out/status.json" >/dev/null 2>&1 && break
  sleep 5
done
now >"$out/finished-at"

after=0
: >"$out/history.jsonl"
while :; do
  page="$("$root/bin/st3" trace show --json --after-index "$after" --limit 500)" || break
  [[ -n $page ]] || break
  printf '%s\n' "$page" >>"$out/history.jsonl"
  last="$(jq -s 'map(.store_index) | max' <<<"$page")"
  ((last > after)) || break
  after=$last
done
"$root/bin/st3" missions show "$run" --json >"$out/eval-run.json" 2>/dev/null || true
# The seat's native session names its workspace, which lives under this daemon's state.
file="$(grep -l -r -F "$root/state/evals" "$HOME/.codex/sessions" 2>/dev/null | xargs -r ls -t | head -1)"
[[ -n $file ]] && cp "$file" "$out/transcript.jsonl"
cp "$root/daemon.log" "$out/"

{
  echo "verdict: $(jq -r '.value.verdict // "none"' "$out/status.json" 2>/dev/null)"
  echo "cleanup: $(jq -r '.value.cleanup // "none"' "$out/status.json" 2>/dev/null)"
  grep -q 'default_permissions="st-managed"' "$out/codex-argv.txt" && echo "profile: st-managed" || echo "profile: MISSING"
  grep -q -e '--dangerously-bypass-approvals-and-sandbox' "$out/codex-argv.txt" && echo "bypass: PRESENT" || echo "bypass: absent"
  grep -q 'tools.web__run\|"web_search_call"' "$out/transcript.jsonl" 2>/dev/null && echo "web search call: yes" || echo "web search call: NO"
  grep -q 'Read-only file system' "$out/transcript.jsonl" 2>/dev/null && echo "refusal observed: yes" || echo "refusal observed: NO"
  echo "escalations requested: $(grep -o 'sandbox_permissions[^,]*require_escalated' "$out/transcript.jsonl" 2>/dev/null | wc -l)"
  grep -q 'st-minimal-outside' "$out/transcript.jsonl" 2>/dev/null && ! grep 'st-minimal-outside' "$out/transcript.jsonl" | grep -q require_escalated && echo "outside write escalated: no" || echo "outside write escalated: CHECK"
  jq -r '.checks[]? | select(.name=="harness-access-mode") | "doctor: " + .message' "$out/doctor.json" 2>/dev/null | cut -c1-120
} | tee "$out/verdict.txt"
