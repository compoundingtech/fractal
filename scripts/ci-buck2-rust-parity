#!/usr/bin/env python3
"""Compare complete native Buck2 and nextest inventories (Python 3.11+).

Run from the repository root in its declared development environment:
    scripts/ci-buck2-rust-parity
Or reuse an unfiltered inventory produced with the same revision/toolchain:
    cargo nextest list --locked -p fractal-storage-version --message-format json > inventory.json
    scripts/ci-buck2-rust-parity --nextest-json inventory.json

Only the two native test targets below are built. Their DefaultInfo executable
outputs are discovered with Buck2's JSON output, never guessed from buck-out.
Every harness is listed, not executed, including the zero-test library harness.
An additional --ignored listing verifies ignored status, not just test names.
Identity is (Cargo target kind, binary name, testcase), not testcase alone.
No case names are maintained here. Unknown/duplicate binaries, malformed output,
skipped suites, subprocess failures, and unequal inventories fail closed.
A reused JSON document may contain other workspace packages; those are excluded
by package-name, while every suite of this crate is required to match.

Focused parser/comparison tests: python3 scripts/ci-buck2-rust-parity-test
This proves inventory equality, NOT successful test execution or remote caching.
"""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys
import tomllib

PACKAGE = "fractal-storage-version"
TARGETS = {
    "//crates/fractal-storage-version:unit-tests": ("lib", "fractal_storage_version"),
    "//crates/fractal-storage-version:integration-tests": ("test", "integration"),
}


def require(condition, message):
    if not condition:
        raise ValueError(message)


def unique_object(pairs):
    result = {}
    for key, value in pairs:
        require(key not in result, f"duplicate JSON key: {key!r}")
        result[key] = value
    return result


def document(text):
    value = json.loads(text, object_pairs_hook=unique_object)
    require(isinstance(value, dict), "expected a JSON object")
    return value


def buck_binaries(text):
    outputs = document(text)
    binaries = {}
    paths = set()
    for label, output in outputs.items():
        # Buck prints canonical cell-qualified labels for // input patterns.
        require("//" in label, f"invalid Buck label: {label!r}")
        normalized = "//" + label.split("//", 1)[1]
        require(normalized in TARGETS, f"unknown Buck target: {label!r}")
        identity = TARGETS[normalized]
        require(identity not in binaries, f"duplicate Buck target: {label!r}")
        require(isinstance(output, str) and Path(output).is_absolute(),
                f"expected one absolute executable output for {label!r}: {output!r}")
        require(output not in paths, f"duplicate Buck executable: {output!r}")
        paths.add(output)
        binaries[identity] = Path(output)
    require(set(binaries) == set(TARGETS.values()),
            f"missing Buck targets: {sorted(set(TARGETS.values()) - set(binaries))}")
    return binaries


def libtest_cases(text):
    cases = set()
    for line in text.splitlines():
        if not line:
            continue
        name, separator, kind = line.rpartition(": ")
        require(separator and name and kind == "test", f"invalid libtest listing line: {line!r}")
        require(name not in cases, f"duplicate libtest testcase: {name!r}")
        cases.add(name)
    return cases


def harness_inventory(all_output, ignored_output):
    cases = libtest_cases(all_output)
    ignored = libtest_cases(ignored_output)
    require(ignored <= cases, f"ignored tests absent from full listing: {sorted(ignored - cases)}")
    return {name: name in ignored for name in cases}


def nextest_inventory(text):
    data = document(text)
    suites = data.get("rust-suites")
    require(isinstance(suites, dict), "nextest JSON requires rust-suites object")
    inventory = {}
    total = 0
    for binary_id, suite in suites.items():
        require(isinstance(suite, dict), f"invalid nextest suite: {binary_id!r}")
        cases = suite.get("testcases")
        require(isinstance(cases, dict), f"missing testcases for {binary_id!r}")
        total += len(cases)
        require(isinstance(suite.get("package-name"), str), f"missing package-name for {binary_id!r}")
        if suite["package-name"] != PACKAGE:
            continue
        require(suite.get("binary-id") == binary_id, f"inconsistent nextest binary-id: {binary_id!r}")
        kind, name = suite.get("kind"), suite.get("binary-name")
        require(isinstance(kind, str) and isinstance(name, str), f"invalid nextest target: {binary_id!r}")
        identity = (kind, name)
        require(identity in TARGETS.values(), f"unknown nextest target: {identity!r}")
        require(identity not in inventory, f"duplicate nextest target: {identity!r}")
        require(suite.get("status", "listed") == "listed", f"nextest suite was not listed: {binary_id!r}")
        parsed = {}
        for case, details in cases.items():
            require(bool(case) and isinstance(details, dict), f"invalid nextest testcase: {case!r}")
            require(type(details.get("ignored")) is bool, f"missing ignored flag: {case!r}")
            require(details.get("kind") in (None, "test"), f"unsupported nextest testcase kind: {case!r}")
            parsed[case] = details["ignored"]
        inventory[identity] = parsed
    require(type(data.get("test-count")) is int and data["test-count"] == total,
            "nextest test-count does not match complete testcase inventory")
    require(set(inventory) == set(TARGETS.values()),
            f"missing nextest targets: {sorted(set(TARGETS.values()) - set(inventory))}")
    return inventory


def compare(buck, nextest):
    require(set(buck) == set(nextest),
            f"binary inventory mismatch: missing={sorted(set(nextest) - set(buck))}; "
            f"extra={sorted(set(buck) - set(nextest))}")
    buck_cases = {(kind, binary, case) for (kind, binary), cases in buck.items() for case in cases}
    nextest_cases = {(kind, binary, case) for (kind, binary), cases in nextest.items() for case in cases}
    missing = sorted(nextest_cases - buck_cases)
    extra = sorted(buck_cases - nextest_cases)
    ignored = sorted(key for key in buck_cases & nextest_cases
                     if buck[key[:2]][key[2]] != nextest[key[:2]][key[2]])
    require(not (missing or extra or ignored),
            f"test inventory mismatch:\n  missing from Buck: {missing}\n"
            f"  extra in Buck: {extra}\n  ignored-status mismatch: {ignored}")


def check_manifest(crate):
    manifest = tomllib.loads((crate / "Cargo.toml").read_text())
    package = manifest.get("package", {})
    require(package.get("name") == PACKAGE and package.get("edition") == "2024",
            "Buck step1 requires fractal-storage-version edition 2024")
    require(package.get("build", False) is False and not (crate / "build.rs").exists(),
            "Buck step1 does not support build scripts")
    sections = [manifest, *manifest.get("target", {}).values()]
    for section in sections:
        for key in ("dependencies", "dev-dependencies", "build-dependencies"):
            require(not section.get(key), f"Buck step1 requires a dependency-free crate ({key})")


def command(args, root):
    return subprocess.check_output(args, cwd=root, text=True)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--nextest-json", type=Path, help="reuse complete nextest list JSON (no Cargo invocation)")
    args = parser.parse_args()
    root = Path(__file__).resolve().parent.parent
    check_manifest(root / "crates" / PACKAGE)
    nextest_text = (args.nextest_json.read_text() if args.nextest_json else command(
        ["cargo", "nextest", "list", "--locked", "-p", PACKAGE, "--message-format", "json"], root))
    nextest = nextest_inventory(nextest_text)
    binaries = buck_binaries(command(
        ["buck2", "build", "--show-full-json-output", "--materializations", "all", *TARGETS], root))
    buck = {}
    for identity, binary in sorted(binaries.items()):
        require(binary.is_file() and os.access(binary, os.X_OK), f"Buck output is not executable: {binary}")
        buck[identity] = harness_inventory(
            command([str(binary), "--list", "--format", "terse"], root),
            command([str(binary), "--list", "--format", "terse", "--ignored"], root))
    compare(buck, nextest)
    count = sum(len(cases) for cases in buck.values())
    ignored = sum(sum(cases.values()) for cases in buck.values())
    print(f"Buck2/nextest inventory parity: {len(buck)} binaries, {count} tests ({ignored} ignored); exact match.")
    for (kind, binary), cases in sorted(buck.items()):
        print(f"  {kind}:{binary}: {len(cases)} tests")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (ValueError, OSError, subprocess.CalledProcessError) as error:
        print(f"Buck2/nextest parity failed: {error}", file=sys.stderr)
        sys.exit(1)
