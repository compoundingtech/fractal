#!/usr/bin/env python3
"""The input key of each workspace crate's tests: what a per-crate signature is bound to (docs/per-crate-test-signing.md).

  scripts/rust-test-keys [--repo DIR] [--tree TREEISH] [--inputs-from TREEISH] [--crate NAME]... [--paths] [--json]

A crate's key is `source_inputs` (the git tree of exactly the declared paths, scripts/evidence-verify `project`) over

  1. the directory of the crate and of every crate in its dependency closure: every `path` dependency, normal, dev, build and target
     specific, `workspace = true` resolved through [workspace.dependencies], and the [patch] paths (they replace registry crates for the
     whole workspace); read from the manifests of the tree being keyed, so no toolchain is needed and an edge that appears changes the key;
  2. the global paths of `.st/rust-test-inputs.json` (the root manifest, lock, toolchain, test runner configuration and stage scripts) and
     the manifest of EVERY workspace member: the tests run on one workspace build, so a member that turns on a feature of a shared
     dependency changes that dependency's build for every crate;
  3. the crate's own `extra` paths from the same file: what its tests read outside the closure.

The same file lists under `no_tests` the crates that have no test to run (reviewed): the verifier refuses a note whose run ran no test
unless the crate is listed there. The list is not part of any key.

A crate the file does not list has the extra `.`, whose key is the whole tree: it is run on every change (it fails closed), so an
unreviewed crate or a new one is never reused by accident. The file is read from --inputs-from (the accepted base, for a verifier) or else
from the tree being keyed. Nothing here runs cargo.

Prints `crate<TAB>key` per crate (--json: an object; --paths adds the declared paths). Exit 2 on an unreadable tree or manifest.
"""
import argparse
import importlib.machinery
import importlib.util
import json
import posixpath
import subprocess
import sys
import tomllib
from pathlib import Path

sys.dont_write_bytecode = True

INPUTS_PATH = '.st/rust-test-inputs.json'
DEP_TABLES = ('dependencies', 'dev-dependencies', 'build-dependencies')
# The sources of the package whose manifest is the repository root: its directory is `.`, which must never stand for the whole tree.
ROOT_PACKAGE_PATHS = ('src', 'tests', 'benches', 'build.rs')


class Failure(Exception):
    pass


def verifier_module(path):
    loader = importlib.machinery.SourceFileLoader('evidence_verify_for_rust_test_keys', str(path))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


def show(repo, tree, path):
    done = subprocess.run(['git', '-C', str(repo), 'cat-file', 'blob', f'{tree}:{path}'], capture_output=True)
    return done.stdout if done.returncode == 0 else None


def manifest(repo, tree, directory):
    path = posixpath.normpath(posixpath.join(directory, 'Cargo.toml'))
    data = show(repo, tree, path)
    if data is None:
        raise Failure(f'{tree}:{path} is not readable')
    try:
        return tomllib.loads(data.decode())
    except (UnicodeDecodeError, tomllib.TOMLDecodeError) as error:
        raise Failure(f'{path}: {error}')


def expand_members(repo, tree, members):
    out = []
    for member in members:
        if '*' not in member:
            out.append(posixpath.normpath(member))
            continue
        if not member.endswith('/*') or '*' in member[:-2]:
            raise Failure(f'workspace member glob {member!r} is not supported')
        listing = subprocess.run(['git', '-C', str(repo), 'ls-tree', '-d', '--name-only', f'{tree}', member[:-1]],
                                 capture_output=True, text=True)
        out += sorted(line for line in listing.stdout.splitlines() if line)
    return out


def dependency_paths(table, directory, workspace_deps):
    """The directories (relative to the repository root) of the path dependencies a manifest table names."""
    found = []
    for name, spec in (table or {}).items():
        if not isinstance(spec, dict):
            continue
        if spec.get('workspace') is True:
            inherited = workspace_deps.get(name)
            if isinstance(inherited, dict) and 'path' in inherited:
                found.append(posixpath.normpath(inherited['path']))
        elif 'path' in spec:
            found.append(posixpath.normpath(posixpath.join(directory, spec['path'])))
    return found


def layout(repo, tree):
    """(members, patched): member crate name -> directory, and the [patch] / [replace] path directories."""
    root = manifest(repo, tree, '.')
    workspace = root.get('workspace') or {}
    directories = expand_members(repo, tree, workspace.get('members') or [])
    if 'package' in root:
        directories.insert(0, '.')
    patched = []
    for table in (root.get('patch') or {}).values():
        for spec in table.values():
            if isinstance(spec, dict) and 'path' in spec:
                patched.append(posixpath.normpath(spec['path']))
    members = {}
    for directory in directories:
        name = manifest(repo, tree, directory).get('package', {}).get('name')
        if name:
            members[name] = directory
    return members, sorted(set(patched)), root


def closure(repo, tree, directory, workspace_deps, cache):
    """`directory` and the directory of every path dependency below it, transitively (dev and build dependencies included)."""
    if directory in cache:
        return cache[directory]
    cache[directory] = seen = {directory}  # set before the walk: a dependency cycle through dev-dependencies ends here
    parsed = manifest(repo, tree, directory)
    tables = [parsed.get(kind) for kind in DEP_TABLES]
    for target in (parsed.get('target') or {}).values():
        tables += [target.get(kind) for kind in DEP_TABLES]
    for table in tables:
        for child in dependency_paths(table, directory, workspace_deps):
            seen |= closure(repo, tree, child, workspace_deps, cache)
    return seen


def source_paths(directory):
    return list(ROOT_PACKAGE_PATHS) if directory == '.' else [directory]


def declared_paths(repo, tree, inputs):
    """crate name -> sorted declared paths, for every workspace member of `tree`."""
    members, patched, root = layout(repo, tree)
    workspace_deps = (root.get('workspace') or {}).get('dependencies') or {}
    manifests = [posixpath.normpath(posixpath.join(directory, 'Cargo.toml')) for directory in members.values()]
    global_paths = list(inputs.get('global') or []) + patched + manifests
    crates = inputs.get('crates') or {}
    cache = {}
    result = {}
    for name, directory in members.items():
        paths = set(global_paths)
        for member_dir in closure(repo, tree, directory, workspace_deps, cache):
            paths.update(source_paths(member_dir))
        extra = (crates.get(name) or {}).get('extra')
        paths.update(['.'] if extra is None else extra)  # a crate nobody reviewed keys the whole tree
        result[name] = sorted(paths)
    return result


def read_inputs(repo, treeish):
    data = show(repo, treeish, INPUTS_PATH)
    if data is None:
        raise Failure(f'{treeish}:{INPUTS_PATH} is not readable')
    try:
        inputs = json.loads(data.decode())
    except (UnicodeDecodeError, ValueError) as error:
        raise Failure(f'{INPUTS_PATH}: {error}')
    if not isinstance(inputs, dict) or not isinstance(inputs.get('global', []), list) or not isinstance(inputs.get('crates', {}), dict):
        raise Failure(f'{INPUTS_PATH}: expected {{"global": [...], "crates": {{name: {{"extra": [...]}}}}}}')
    no_tests = inputs.get('no_tests', [])
    if not isinstance(no_tests, list) or not all(isinstance(name, str) for name in no_tests):
        raise Failure(f'{INPUTS_PATH}: no_tests must be an array of crate names')
    return inputs


def keys(repo, tree, inputs, project, only=()):
    """crate name -> (key, paths). The key is None when no declared path exists in the tree (nothing can match by it)."""
    resolved = subprocess.run(['git', '-C', str(repo), 'rev-parse', '--verify', '--end-of-options', f'{tree}^{{tree}}'], capture_output=True, text=True)
    if resolved.returncode != 0:
        raise Failure(f'{tree} is not a tree')
    tree = resolved.stdout.strip()
    paths = declared_paths(repo, tree, inputs)
    unknown = [name for name in only if name not in paths]
    if unknown:
        raise Failure(f'not a workspace crate of this tree: {", ".join(unknown)}')
    return {name: (project(str(repo), tree, declared), declared) for name, declared in paths.items() if not only or name in only}


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('--repo', default='.')
    parser.add_argument('--tree', default='HEAD', help='the tree to key (default HEAD)')
    parser.add_argument('--inputs-from', metavar='TREEISH', help=f'read {INPUTS_PATH} from here (the accepted base) instead of the tree')
    parser.add_argument('--crate', action='append', default=[], metavar='NAME', help='only this crate (repeatable)')
    parser.add_argument('--paths', action='store_true', help='also print the declared paths')
    parser.add_argument('--json', action='store_true')
    parser.add_argument('--verifier', default=str(Path(__file__).resolve().parent / 'evidence-verify'),
                        help='the evidence-verify whose projection computes the key (default: the one next to this script)')
    args = parser.parse_args(argv)
    try:
        tree = subprocess.run(['git', '-C', args.repo, 'rev-parse', '--verify', '--end-of-options', args.tree + '^{tree}'],
                              capture_output=True, text=True)
        if tree.returncode != 0:
            raise Failure(f'{args.tree} is not a tree')
        tree = tree.stdout.strip()
        inputs = read_inputs(args.repo, args.inputs_from or tree)
        result = keys(args.repo, tree, inputs, verifier_module(args.verifier).project, args.crate)
    except Failure as error:
        print(f'rust-test-keys: {error}', file=sys.stderr)
        return 2
    if args.json:
        print(json.dumps({name: ({'key': key, 'paths': paths} if args.paths else key) for name, (key, paths) in sorted(result.items())}, indent=1))
    else:
        for name, (key, paths) in sorted(result.items()):
            print(f'{name}\t{key}' + (f'\t{",".join(paths)}' if args.paths else ''))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
