[Unit]
Description=Evidence GC: delete the dead evidence trees of scripts/evidence-gc's plan
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/run/current-system/sw/bin:/usr/bin:/bin
ExecStart=/usr/bin/env bash %h/.local/bin/evidence-gc-timer
TimeoutStartSec=1h
Nice=10
