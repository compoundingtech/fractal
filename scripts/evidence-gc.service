[Unit]
Description=Evidence GC: plan collection of dead evidence trees (dry-run by default)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/run/current-system/sw/bin:/usr/bin:/bin
ExecStart=/usr/bin/env bash %h/.local/bin/evidence-gc-timer
TimeoutStartSec=1h
Nice=10
