#!/usr/bin/env python3
"""Retain the actual CI checkout for a later protected evidence observer; never sign."""
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess


def git(repo, *args, **kwargs):
    return subprocess.check_output(
        ['git', '-C', str(repo), *args],
        env={**os.environ, 'GIT_NO_REPLACE_OBJECTS': '1'}, **kwargs)


def oid(value, object_format):
    if object_format not in ('sha1', 'sha256') or not re.fullmatch(
            r'[0-9a-f]{' + str(40 if object_format == 'sha1' else 64) + '}', value):
        raise ValueError('expected a full Git object ID in the repository object format')
    return value


def positive(value):
    if not re.fullmatch(r'[1-9][0-9]*', value):
        raise ValueError('expected a positive decimal run/attempt identifier')
    return value


def change_identity(repository, event_name, event, source):
    if not re.fullmatch(r'[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+', repository):
        raise ValueError('invalid repository')
    if event.get('repository', {}).get('full_name') != repository:
        raise ValueError('event repository mismatch')
    if event_name == 'pull_request':
        number = event.get('number')
        if type(number) is not int or number <= 0 or event.get('pull_request', {}).get('number') != number:
            raise ValueError('invalid pull request identity')
        return f'github:{repository}#{number}'
    if event_name == 'merge_group':
        group = event.get('merge_group', {})
        match = re.fullmatch(r'refs/heads/gh-readonly-queue/main/pr-([1-9][0-9]*)-[0-9a-f]{40}',
                             group.get('head_ref', ''))
        if not match or group.get('head_sha') != source:
            raise ValueError('unsupported or mismatched merge group identity')
        # Queue batches can contain other changes. This is the entry identity; the source
        # and tree always name the complete effective checkout, never its author's head.
        return f'github:{repository}#{match[1]}'
    if event_name == 'workflow_dispatch':
        return f'github:{repository}@{source}'
    raise ValueError('unsupported workflow event')


def produce(repo, destination, environment, recipe):
    object_format = git(repo, 'rev-parse', '--show-object-format', text=True).strip()
    source = oid(git(repo, 'rev-parse', '--verify', 'HEAD', text=True).strip(), object_format)
    if source != environment['GITHUB_SHA']:
        raise ValueError('checkout does not match the effective tested GITHUB_SHA')
    tree = oid(git(repo, 'rev-parse', 'HEAD^{tree}', text=True).strip(), object_format)
    repository = environment['GITHUB_REPOSITORY']
    event_name = environment['GITHUB_EVENT_NAME']
    event = json.loads(Path(environment['GITHUB_EVENT_PATH']).read_bytes())
    change_id = change_identity(repository, event_name, event, source)
    run_id = positive(environment['GITHUB_RUN_ID'])
    run_attempt = positive(environment['GITHUB_RUN_ATTEMPT'])
    # Commit + complete tree/blobs, without history, refs or Git config. This works in a
    # depth-one checkout and retains obsolete synthetic merge objects for later observers.
    objects = git(repo, 'rev-list', '--objects', '--no-object-names', tree)
    destination.mkdir(mode=0o700, exist_ok=False)
    pack = destination / 'source.pack'
    with pack.open('xb') as stream:
        subprocess.run(['git', '-C', str(repo), 'pack-objects', '--stdout'],
                       env={**os.environ, 'GIT_NO_REPLACE_OBJECTS': '1'},
                       input=source.encode() + b'\n' + objects, stdout=stream, check=True)
    receipt = {
        'version': 1, 'repository': repository, 'event': event_name,
        'run_id': run_id, 'run_attempt': run_attempt,
        'source': source, 'tree': tree, 'object_format': object_format,
        'change_id': change_id, 'producer_sha256': hashlib.sha256(recipe).hexdigest(),
        'pack_sha256': '',
        'pack_bytes': pack.stat().st_size,
    }
    with pack.open('rb') as stream:
        receipt['pack_sha256'] = hashlib.file_digest(stream, 'sha256').hexdigest()
    (destination / 'receipt.json').write_text(json.dumps(receipt, sort_keys=True) + '\n')
    return receipt


def main():
    destination = Path(os.environ['RUNNER_TEMP']) / 'ci-evidence-source'
    receipt = produce(Path.cwd(), destination, os.environ, Path(__file__).read_bytes())
    print(json.dumps(receipt, sort_keys=True))
    with open(os.environ['GITHUB_STEP_SUMMARY'], 'a') as summary:
        summary.write(f"Evidence source retained: {receipt['source']}, tree {receipt['tree']}. "
                      'This is provenance only; it asserts neither check success nor signing trust.\n')


if __name__ == '__main__':
    main()
