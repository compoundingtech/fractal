#!/usr/bin/env python3
"""Reject retired product names in every tracked or unignored file.

It reads the whole tree, so it runs in genie-freshness (whose evidence key is the whole tree) and not in the Linux
gate, whose skip rests on a declared subset of paths: a pull request that touches only a page under `apps` must still
be checked. Formerly `tests/native_only.rs::tracked_product_surface_contains_only_native_names`.
"""

import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
# Split so this file does not name what it forbids.
FORBIDDEN = (
    "con" + "voy", ".con" + "voy", "render" + "-agent", "build" + "-agent",
    "st2 " + "render", "st2 " + "add", "st2 " + "remove", "st2 " + "compile ", "`st2 " + "compile`",
)


def violations(root):
    listed = subprocess.check_output(
        ["git", "ls-files", "--cached", "--others", "--exclude-standard", "-z"], cwd=root
    )
    found = []
    for raw in listed.split(b"\0"):
        if not raw:
            continue
        path = root / raw.decode("utf-8")
        try:
            data = path.read_bytes()
            data.decode("utf-8")
        except (OSError, UnicodeDecodeError):
            continue  # binary, unreadable or not a regular file: the Rust test skipped these too
        lower = data.lower()  # ASCII-only, as the Rust test's to_ascii_lowercase
        found += [f"{raw.decode()} contains {needle!r}" for needle in FORBIDDEN if needle.encode() in lower]
    return found


def main():
    root = Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else ROOT
    found = violations(root)
    if found:
        print("retired product surface returned:\n" + "\n".join(found), file=sys.stderr)
        return 1
    print("check-native-names: no retired product names")
    return 0


if __name__ == "__main__":
    sys.exit(main())
