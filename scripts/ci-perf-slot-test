#!/usr/bin/env python3
"""Two runs take turns, a killed run frees the slot at once, a run past its timeout is stopped."""
import contextlib
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import tempfile
import time

slot = str(Path(__file__).resolve().parent / "ci-perf-slot")


def start(env, *args, command):
    return subprocess.Popen([sys.executable, slot, *args, "--", *command], env=env,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)


def until(condition, what, seconds=10):
    deadline = time.time() + seconds
    while time.time() < deadline:
        if condition():
            return
        time.sleep(0.02)
    raise AssertionError("timed out: " + what)


def alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    try:
        stat = Path("/proc/%d/stat" % pid).read_text()
    except (FileNotFoundError, ProcessLookupError):
        return False  # it exited and was reaped after the kill above: gone, so not running
    return stat.rsplit(")", 1)[1].split()[0] != "Z"

def cgroup_path(text):
    return next((line[3:] for line in text.splitlines() if line.startswith("0::")), "")


def caller_slice(text):
    parent = cgroup_path(text).rsplit("/", 1)[0]
    assert any(re.fullmatch(r"user@\d+\.service", part) for part in parent.split("/")), "caller has no user manager cgroup"
    assert parent.endswith(".slice"), f"caller cgroup parent is not a slice: {parent}"
    return parent

def starttime(text):
    return int(text.rsplit(")", 1)[1].split()[19])  # /proc/PID/stat field 22


def runtime_usec(value):
    assert re.fullmatch(r"\d+(?:min|us|s)(?: \d+(?:min|us|s))*", value), value
    return sum(int(n) * {"min": 60000000, "s": 1000000, "us": 1}[unit]
               for n, unit in re.findall(r"(\d+)(min|us|s)", value))


def kernel_limits(group):
    limits = {name: int((group / name).read_text()) for name in ("memory.max", "memory.swap.max", "pids.max")}
    assert limits == {"memory.max": 67108864, "memory.swap.max": 0, "pids.max": 16}, limits
    return limits


# Fake cgroup lines exercise hierarchy-preserving leaf slice selection without a user bus.
manager = "/user.slice/user-1000.slice/user@1000.service"
for leaf in ("app.slice", "app.slice/app-capped.slice/app-capped-heavy.slice"):
    assert caller_slice(f"0::{manager}/{leaf}/gate-slot-heavy-1.scope\n") == f"{manager}/{leaf}"
try:
    caller_slice(f"0::{manager}/app.slice/outer.scope/child\n")
except AssertionError:
    pass
else:
    raise AssertionError("a non-slice parent must fail, not default to app.slice")
assert starttime("1 (name with ) spaces) " + " ".join(["S"] + ["0"] * 18 + ["12345"])) == 12345
assert runtime_usec("1min 30s") == runtime_usec("90s") == runtime_usec("90000000us") == 90000000
with tempfile.TemporaryDirectory() as helper_tmp:
    group = Path(helper_tmp)
    for name, value in {"memory.max": 67108864, "memory.swap.max": 0, "pids.max": 16}.items():
        (group / name).write_text(str(value))
    assert kernel_limits(group)["pids.max"] == 16
if sys.argv[1:] == ["--helpers-only"]:
    print("passed: ci-perf-slot helpers")
    sys.exit(0)



with tempfile.TemporaryDirectory() as tmp:
    root = Path(tmp)
    env = {**os.environ, "PERF_SLOT_DIR": str(root / "slot"), "PERF_SLOT_POLL": "0.05", "PERF_SLOT_GRACE": "1"}
    holder = root / "slot/holder.json"

    def status():
        return subprocess.check_output([sys.executable, slot, "--status"], env=env, text=True)

    # The acquired slot overrides both inherited aliases, so an empty preferred
    # marker cannot mask the held slot and make the child acquire it again.
    for preferred in ("inherited-stale", ""):
        inherited = {**env, "FRACTAL_PERF_SLOT_HELD": preferred,
                     "ST_PERF_SLOT_HELD": "legacy-stale"}
        marked = start(inherited, command=[sys.executable, "-c",
            "import os; "
            "assert os.environ['FRACTAL_PERF_SLOT_HELD'] == open('/proc/%d/stat' % os.getppid()).read().rsplit(')', 1)[1].split()[1]; "
            "assert os.environ['ST_PERF_SLOT_HELD'] == open('/proc/%d/stat' % os.getppid()).read().rsplit(')', 1)[1].split()[1]"])
        assert marked.wait(10) == 0, marked.stderr.read()
        assert "perf slot free" in status() and not holder.exists()

    # A run that holds the slot until the test releases it: a fixed sleep ends on a loaded host before
    # the runs meant to queue behind it have joined the line (each is a process start and status polls).
    # It gives up after 30 s, so a failed assertion leaves no run behind.
    release = root / "release"

    def held(then):
        return 'n=0; until [ -e %s ] || [ $n -ge 1500 ]; do sleep 0.02; n=$((n + 1)); done; %s' % (release, then)

    # Two runs started at once take turns: the second starts only after the first ends, and the
    # waiting one is told who holds the slot and for what.
    log = root / "turns"
    script = 'echo "start $1" >> %s; %s' % (log, held('echo "end $1" >> %s' % log))
    first = start(env, "--for", "branch-one", command=["bash", "-c", script, "x", "one"])
    until(holder.exists, "first run holds the slot")
    second = start(env, "--for", "branch-two", command=["bash", "-c", script, "x", "two"])
    until(lambda: "waiting since" in status(), "second run waits in line")
    shown = status()
    assert "held by" in shown and "branch-one" in shown, shown
    assert "waiting since" in shown, shown
    release.touch()
    assert first.wait(20) == 0 and second.wait(20) == 0
    assert log.read_text().split("\n")[:-1] == ["start one", "end one", "start two", "end two"], log.read_text()
    assert "busy: held by" in second.stderr.read(), "the waiting run says who holds the slot"
    assert "perf slot free" in status() and not holder.exists()

    # Waiters go in the order they asked.
    order = root / "order"
    release.unlink()
    blocker = start(env, command=["bash", "-c", held("true")])
    until(holder.exists, "blocker holds the slot")
    waiters = []
    for name in ("a", "b", "c"):
        waiters.append(start(env, command=["bash", "-c", "echo %s >> %s" % (name, order)]))
        until(lambda: status().count("waiting since") == len(waiters), "%s in line" % name)
    release.touch()
    for process in [blocker, *waiters]:
        assert process.wait(20) == 0
    assert order.read_text().split() == ["a", "b", "c"]

    # A run killed mid-way (SIGKILL, so it cannot clean up) frees the slot at once and takes its
    # command with it, even a grandchild that ignores SIGTERM.
    pids = root / "pids"
    victim = start(env, command=["bash", "-c", "(trap '' TERM; sleep 60) & echo $! > %s; wait" % pids])
    until(lambda: pids.exists() and pids.read_text().strip(), "victim running")
    grandchild = int(pids.read_text())
    until(holder.exists, "victim holds the slot")
    waiting = start(env, command=["true"])
    until(lambda: "waiting since" in status(), "next run waits")
    victim.kill()
    assert waiting.wait(5) == 0, "the next run must get the slot as soon as the victim dies"
    until(lambda: not alive(grandchild), "the killed run's whole process group is gone")
    victim.wait()
    assert not holder.exists()

    # A scope move keeps the process group, so killing or timing out the group must kill it too.
    # Keep the moved fixture in the caller's enclosing slice and give it its own small hard limits.
    runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    systemd_run = next((Path(d) / "systemd-run" for d in os.environ["PATH"].split(":") + ["/run/current-system/sw/bin", "/usr/bin"]
                        if (Path(d) / "systemd-run").exists()), None)
    if systemd_run and runtime and Path(runtime, "bus").exists():
        slice_path = caller_slice(Path("/proc/self/cgroup").read_text())
        units, wrappers, scoped_pids, evidence = [], [], [], {}
        systemctl = str(systemd_run.with_name("systemctl"))
        scoped = root / "scoped"
        script = "echo $BASHPID > %s; exec sleep 60" % scoped
        cleaned = False
        previous_signals = {sig: signal.getsignal(sig) for sig in (signal.SIGINT, signal.SIGTERM)}

        def finish_fixtures():
            global cleaned
            if cleaned:
                return
            for sig in previous_signals:
                signal.signal(sig, signal.SIG_IGN)
            try:
                for unit in units:
                    record = evidence.setdefault(unit, {"unit": unit})
                    group = record.get("cgroup", f"{slice_path}/{unit}")
                    with contextlib.suppress(OSError):
                        record["memory.peak"] = int(Path("/sys/fs/cgroup", group.lstrip("/"), "memory.peak").read_text())
                    subprocess.run([systemctl, "--user", "stop", unit], capture_output=True)
                for wrapper in wrappers:
                    if wrapper.poll() is None:
                        wrapper.kill()
                    wrapper.wait(10)
                def no_fixtures():
                    listed = subprocess.check_output([systemctl, "--user", "list-units", "ci-perf-slot-fixture-*",
                                                      "--all", "--no-legend", "--plain"], text=True)
                    return not listed.strip() and not any(alive(pid) for pid in scoped_pids)
                until(no_fixtures, "all fixture scopes and processes are gone")
                cleaned = True
            finally:
                for record in evidence.values():
                    record["drain"] = "empty and collected" if cleaned else "not confirmed"
                    print("ci-perf-slot fixture: " + json.dumps(record, sort_keys=True), flush=True)
                for sig, handler in previous_signals.items():
                    signal.signal(sig, handler)

        def cancelled(signum, frame):
            finish_fixtures()
            raise SystemExit(128 + signum)

        for sig in previous_signals:
            signal.signal(sig, cancelled)
        try:
            for n, mode in enumerate(("kill", "timeout")):
                unit = f"ci-perf-slot-fixture-{os.getpid()}-{n}.scope"
                units.append(unit)
                scoped.unlink(missing_ok=True)
                command = [str(systemd_run), "--user", "--scope", "--quiet", "--collect",
                           f"--slice={Path(slice_path).name}", f"--unit={unit}",
                           "-p", "MemoryMax=64M", "-p", "MemorySwapMax=0", "-p", "TasksMax=16",
                           "-p", "RuntimeMaxSec=90", "--", "bash", "-c", script]
                victim = start(env, *(("--timeout", "1s") if mode == "timeout" else ()), command=command)
                wrappers.append(victim)
                until(lambda: scoped.exists() and scoped.read_text().strip(), "scoped run started")
                scoped_pid = int(scoped.read_text())
                scoped_pids.append(scoped_pid)
                group = cgroup_path(Path(f"/proc/{scoped_pid}/cgroup").read_text())
                record = evidence.setdefault(unit, {"unit": unit})
                record.update(pid=scoped_pid, starttime=starttime(Path(f"/proc/{scoped_pid}/stat").read_text()), cgroup=group)
                assert group == f"{slice_path}/{unit}", f"fixture left caller slice: {group}"
                properties = dict(line.split("=", 1) for line in subprocess.check_output(
                    [systemctl, "--user", "show", unit, "-p", "MemoryMax", "-p", "MemorySwapMax",
                     "-p", "TasksMax", "-p", "RuntimeMaxUSec", "-p", "ControlGroup", "-p", "Slice"], text=True).splitlines())
                assert properties["MemoryMax"] == "67108864", properties
                assert properties["MemorySwapMax"] == "0" and properties["TasksMax"] == "16", properties
                assert properties["ControlGroup"] == group and properties["Slice"] == Path(slice_path).name, properties
                usec = runtime_usec(properties["RuntimeMaxUSec"])
                assert usec == 90000000, properties
                record.update(slice=properties["Slice"], limits=kernel_limits(Path("/sys/fs/cgroup", group.lstrip("/"))),
                              RuntimeMaxUSec=usec, manager=properties)
                with contextlib.suppress(OSError):
                    record["memory.peak"] = int(Path("/sys/fs/cgroup", group.lstrip("/"), "memory.peak").read_text())
                if mode == "kill":
                    victim.kill()
                assert victim.wait(20) == (124 if mode == "timeout" else -signal.SIGKILL)
                until(lambda: not alive(scoped_pid), f"{mode} stops the scope process")
        finally:
            finish_fixtures()
    else:
        print("skipped: no systemd user bus for the scope case")

    # Ctrl-C and SIGTERM on the wrapper stop the run and free the slot too.
    for number in (signal.SIGINT, signal.SIGTERM):
        stopped = start(env, command=["sleep", "60"])
        until(holder.exists, "run holds the slot")
        pid = json.loads(holder.read_text())["pid"]
        stopped.send_signal(number)
        assert stopped.wait(10) == 128 + number
        assert not alive(pid) and not holder.exists()

    # The watchdog is protected from TERM itself, but must not pass SIG_IGN
    # through exec to its command. A shell cannot install a TERM cleanup trap
    # when that signal was ignored at shell entry. Check the actual receipt,
    # not just eventual death/KILL and slot release.
    for mode, expected in (("timeout", 124), ("wrapper-term", 143)):
        ready = root / (mode + ".ready")
        cleanup = root / (mode + ".cleanup")
        script = ('trap \'printf cleaned > "$2"; exit 0\' TERM; '
                  'printf ready > "$1"; while :; do sleep 0.05; done')
        options = ("--timeout", "1s") if mode == "timeout" else ()
        stopped = start(env, *options,
                        command=["bash", "-c", script, "fixture", str(ready), str(cleanup)])
        until(ready.exists, mode + " command installed its TERM trap")
        if mode == "wrapper-term":
            stopped.send_signal(signal.SIGTERM)
        assert stopped.wait(10) == expected, stopped.stderr.read()
        assert cleanup.read_text() == "cleaned", mode + " must allow graceful TERM cleanup"
        assert "perf slot free" in status() and not holder.exists()

    # A run past its timeout is stopped, even one that ignores SIGTERM, and the slot frees.
    started = time.time()
    hung = start(env, "--timeout", "1s", command=["bash", "-c", "trap '' TERM; while :; do sleep 0.1; done"])
    assert hung.wait(20) == 124, "a timeout exits 124"
    assert time.time() - started < 10
    assert "timeout" in hung.stderr.read()
    assert "perf slot free" in status()

    # The command's own status passes through, and a timeout cannot be asked for beyond two hours.
    assert start(env, command=["bash", "-c", "exit 7"]).wait(10) == 7
    refused = start(env, "--timeout", "3h", command=["true"])
    assert refused.wait(10) == 2 and "at most 2h" in refused.stderr.read()
    assert start(env, "--timeout", "90m", command=["true"]).wait(10) == 0

    # --help tells a builder how to measure, which budgets apply and what evidence to post.
    helped = subprocess.check_output([sys.executable, slot, "--help"], env=env, text=True)
    for phrase in ("ci-perf load", "budget", "Evidence for the PR", "2h", "--timeout"):
        assert phrase in helped, phrase

print("passed: ci-perf-slot")
