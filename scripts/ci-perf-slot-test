#!/usr/bin/env python3
"""Two runs take turns, a killed run frees the slot at once, a run past its timeout is stopped."""
import json
import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile
import time

slot = str(Path(__file__).resolve().parent / "ci-perf-slot")


def start(env, *args, command):
    return subprocess.Popen([sys.executable, slot, *args, "--", *command], env=env,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)


def until(condition, what, seconds=10):
    deadline = time.time() + seconds
    while time.time() < deadline:
        if condition():
            return
        time.sleep(0.02)
    raise AssertionError("timed out: " + what)


def alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    stat = Path("/proc/%d/stat" % pid)
    return stat.exists() and stat.read_text().rsplit(")", 1)[1].split()[0] != "Z"


with tempfile.TemporaryDirectory() as tmp:
    root = Path(tmp)
    env = {**os.environ, "PERF_SLOT_DIR": str(root / "slot"), "PERF_SLOT_POLL": "0.05", "PERF_SLOT_GRACE": "1"}
    holder = root / "slot/holder.json"

    def status():
        return subprocess.check_output([sys.executable, slot, "--status"], env=env, text=True)

    # Two runs started at once take turns: the second starts only after the first ends, and the
    # waiting one is told who holds the slot and for what.
    log = root / "turns"
    script = 'echo "start $1" >> %s; sleep 1; echo "end $1" >> %s' % (log, log)
    first = start(env, "--for", "branch-one", command=["bash", "-c", script, "x", "one"])
    until(holder.exists, "first run holds the slot")
    second = start(env, "--for", "branch-two", command=["bash", "-c", script, "x", "two"])
    until(lambda: "waiting since" in status(), "second run waits in line")
    shown = status()
    assert "held by" in shown and "branch-one" in shown, shown
    assert "waiting since" in shown, shown
    assert first.wait(20) == 0 and second.wait(20) == 0
    assert log.read_text().split("\n")[:-1] == ["start one", "end one", "start two", "end two"], log.read_text()
    assert "busy: held by" in second.stderr.read(), "the waiting run says who holds the slot"
    assert "perf slot free" in status() and not holder.exists()

    # Waiters go in the order they asked.
    order = root / "order"
    blocker = start(env, command=["sleep", "1.5"])
    until(holder.exists, "blocker holds the slot")
    waiters = []
    for name in ("a", "b", "c"):
        waiters.append(start(env, command=["bash", "-c", "echo %s >> %s" % (name, order)]))
        until(lambda: status().count("waiting since") == len(waiters), "%s in line" % name)
    for process in [blocker, *waiters]:
        assert process.wait(20) == 0
    assert order.read_text().split() == ["a", "b", "c"]

    # A run killed mid-way (SIGKILL, so it cannot clean up) frees the slot at once and takes its
    # command with it, even a grandchild that ignores SIGTERM.
    pids = root / "pids"
    victim = start(env, command=["bash", "-c", "(trap '' TERM; sleep 60) & echo $! > %s; wait" % pids])
    until(lambda: pids.exists() and pids.read_text().strip(), "victim running")
    grandchild = int(pids.read_text())
    until(holder.exists, "victim holds the slot")
    waiting = start(env, command=["true"])
    until(lambda: "waiting since" in status(), "next run waits")
    victim.kill()
    assert waiting.wait(5) == 0, "the next run must get the slot as soon as the victim dies"
    until(lambda: not alive(grandchild), "the killed run's whole process group is gone")
    victim.wait()
    assert not holder.exists()

    # hetz2's cargo test runner starts the test binary with `systemd-run --user --scope`. A scope
    # moves the process into a transient unit but keeps it in this process group, so killing the
    # group kills it. Skipped where there is no user bus.
    runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    systemd_run = next((Path(d) / "systemd-run" for d in os.environ["PATH"].split(":") + ["/run/current-system/sw/bin", "/usr/bin"]
                        if (Path(d) / "systemd-run").exists()), None)
    if systemd_run and runtime and Path(runtime, "bus").exists():
        scoped = root / "scoped"
        script = "echo $BASHPID > %s; exec sleep 60" % scoped
        victim = start(env, command=[str(systemd_run), "--user", "--scope", "--quiet", "--collect", "--",
                                     "bash", "-c", script])
        until(lambda: scoped.exists() and scoped.read_text().strip(), "scoped run started")
        scoped_pid = int(scoped.read_text())
        assert "scope" in Path("/proc/%d/cgroup" % scoped_pid).read_text(), "the run is in a transient scope unit"
        victim.kill()
        until(lambda: not alive(scoped_pid), "a killed run takes its systemd scope process with it")
        victim.wait()
        stopped = start(env, "--timeout", "1s", command=[str(systemd_run), "--user", "--scope", "--quiet", "--collect",
                                                         "--", "bash", "-c", script])
        assert stopped.wait(20) == 124
        until(lambda: not alive(int(scoped.read_text())), "a timeout stops the scope process too")
    else:
        print("skipped: no systemd user bus for the scope case")

    # Ctrl-C and SIGTERM on the wrapper stop the run and free the slot too.
    for number in (signal.SIGINT, signal.SIGTERM):
        stopped = start(env, command=["sleep", "60"])
        until(holder.exists, "run holds the slot")
        pid = json.loads(holder.read_text())["pid"]
        stopped.send_signal(number)
        assert stopped.wait(10) == 128 + number
        assert not alive(pid) and not holder.exists()

    # A run past its timeout is stopped, even one that ignores SIGTERM, and the slot frees.
    started = time.time()
    hung = start(env, "--timeout", "1s", command=["bash", "-c", "trap '' TERM; while :; do sleep 0.1; done"])
    assert hung.wait(20) == 124, "a timeout exits 124"
    assert time.time() - started < 10
    assert "timeout" in hung.stderr.read()
    assert "perf slot free" in status()

    # The command's own status passes through, and a timeout cannot be asked for beyond two hours.
    assert start(env, command=["bash", "-c", "exit 7"]).wait(10) == 7
    refused = start(env, "--timeout", "3h", command=["true"])
    assert refused.wait(10) == 2 and "at most 2h" in refused.stderr.read()
    assert start(env, "--timeout", "90m", command=["true"]).wait(10) == 0

    # --help tells a builder how to measure, which budgets apply and what evidence to post.
    helped = subprocess.check_output([sys.executable, slot, "--help"], env=env, text=True)
    for phrase in ("ci-perf load", "budget", "Evidence for the PR", "2h", "--timeout"):
        assert phrase in helped, phrase

print("passed: ci-perf-slot")
