#!/usr/bin/env python3
"""Two runs take turns, a killed run frees the slot at once, a run past its timeout is stopped."""
import contextlib
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import tempfile
import time
from unittest.mock import patch
import hashlib
import socket
import stat
from unittest import TestCase
import base64


def utc():
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


def peak(record, group, final=False):
    key = "peak_final_lifecycle" if final else "peak_sampled_before_termination"
    try:
        record[key] = int((group / "memory.peak").read_text())
    except OSError as error:
        record[key] = f"unavailable ({'collected' if final and isinstance(error, FileNotFoundError) else error})"
        if not final or not isinstance(error, FileNotFoundError):
            raise


def require(condition, detail="invalid perf-slot receipt"):
    if not condition:
        raise ValueError(detail)


def validate_origin(identity):
    require(identity["source_head"] == identity["sparse_head"], "inconsistent sparse_head")
    messages = {}
    for kind in ("origin", "sparse"):
        head, tree = identity[kind + "_head"], identity[kind + "_tree"]
        require(all(isinstance(value, str) and re.fullmatch(r"[0-9a-f]{40}", value) for value in (head, tree)))
        raw = base64.b64decode(identity[kind + "_commit"], validate=True)
        require(hashlib.sha1(b"commit " + str(len(raw)).encode() + b"\0" + raw).hexdigest() == head, "commit hash mismatch")
        require(raw.split(b"\n", 1)[0] == b"tree " + tree.encode(), "commit/tree mismatch")
        messages[kind] = raw.split(b"\n\n", 1)[1].decode("utf-8", errors="replace").splitlines()
    if "paths" in identity:
        paths = identity["paths"]
        require(isinstance(paths, list) and paths and all(isinstance(path, str) for path in paths))
        require(paths == sorted(set(paths)) and all(not Path(path).is_absolute() and ".." not in Path(path).parts for path in paths))
        digest = hashlib.sha256(json.dumps(paths, separators=(",", ":")).encode()).hexdigest()
        require(digest == identity["paths_sha256"], "sparse paths digest mismatch")
        for label, value in (("Origin-Head", identity["origin_head"]), ("Origin-Tree", identity["origin_tree"]), ("Sparse-Paths-SHA256", digest)):
            require(f"{label}: {value}" in messages["sparse"], "sparse derivation mismatch")
    else:
        require(identity["sparse_head"] == identity["origin_head"], "missing sparse derivation")
        require(not any(line.startswith("Sparse-Paths-SHA256: ") for line in messages["sparse"]), "missing sparse derivation")


def source_identity(git):
    head = git("rev-parse", "HEAD")
    metadata = Path(git("rev-parse", "--absolute-git-dir")) / "ci-sparse-origin.json"
    try:
        fd = os.open(metadata, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    except FileNotFoundError:
        tree = git("rev-parse", f"{head}^{{tree}}")
        commit = base64.b64encode(git("cat-file", "commit", head, raw=True)).decode()
        origin = dict(origin_head=head, sparse_head=head, origin_tree=tree, sparse_tree=tree, origin_commit=commit, sparse_commit=commit)
    else:
        with os.fdopen(fd) as stream:
            info = os.fstat(stream.fileno())
            require(stat.S_ISREG(info.st_mode) and info.st_uid == os.geteuid() and not info.st_mode & 0o022, "unsafe sparse origin metadata")
            origin = json.load(stream)
        require(origin.pop("version") == 2 and origin["sparse_head"] == head, "stale sparse origin metadata")
        require(origin["sparse_tree"] == git("rev-parse", f"{head}^{{tree}}"), "sparse tree mismatch")
    origin["source_head"] = head
    validate_origin(origin)
    return origin


def validate_receipt(receipt, require_origin=False):
    require(receipt["status"] == "final" and receipt["outcome"] == "success")
    for field in ("caller_pid", "caller_starttime", "gate_slot", "invocation", "source_head", "source_sha256",
                  "hostname", "started_utc", "ended_utc"):
        require(receipt[field], f"missing attribution: {field}")
    require(not require_origin or "origin_head" in receipt, "origin attribution required")
    if "origin_head" in receipt:
        validate_origin(receipt)
    require({"unit", "cgroup"} <= receipt["gate_slot"].keys())
    require(receipt["remaining_units"] == receipt["remaining_cgroups"] == 0)
    if receipt.get("skip") == "no-user-manager":
        require(not re.search(r"/user@\d+\.service(?:/|$)", receipt["caller_cgroup"]))
        require(receipt["gate_slot"] == {"unit": None, "cgroup": None} and not receipt["fixtures"])
        return
    admission = receipt["gate_slot"]
    require(all(isinstance(admission[key], str) and admission[key] for key in ("unit", "cgroup")))
    admitted = Path(os.path.normpath(admission["cgroup"]))
    require(admitted.is_absolute() and admitted.name == admission["unit"])
    require(Path(os.path.normpath(receipt["caller_cgroup"])).is_relative_to(admitted))
    manager = next((parent for parent in admitted.parents if re.fullmatch(r"user@\d+\.service", parent.name)), None)
    require(manager is not None and all(str(manager / lane) in receipt["scanned_roots"] for lane in ("app.slice", "builds.slice")))
    fixtures = receipt["fixtures"]
    require(len(fixtures) == 2 and len({r["unit"] for r in fixtures}) == 2)
    for record in fixtures:
        require(os.path.normpath(record["caller_slice"]) == os.path.dirname(os.path.normpath(receipt["gate_slot"]["cgroup"])))
        parent = os.path.dirname(os.path.normpath(record["cgroup"]))
        require(os.path.normpath(record["parent_slice"]) == parent == os.path.normpath(record["caller_slice"]))
        require(parent in receipt["scanned_roots"])
        require(record["drain"] == "empty and collected")
        require(type(record["peak_sampled_before_termination"]) is int and record["peak_sampled_before_termination"] >= 0)
        final = record["peak_final_lifecycle"]
        require((type(final) is int and final >= 0) or final == "unavailable (collected)")
        require(record["limits"] == {"memory.max": 67108864, "memory.swap.max": 0, "pids.max": 16})
        require(record["RuntimeMaxUSec"] == 90000000)
        require(record["manager"]["MemoryMax"] == "67108864")
        require(record["manager"]["MemorySwapMax"] == "0" and record["manager"]["TasksMax"] == "16")
        require(record["manager"]["ControlGroup"] == record["cgroup"])
        require(record["manager"]["Slice"] == record["slice"] == Path(record["parent_slice"]).name)
        require(record["cgroup"] == f"{record['caller_slice']}/{record['unit']}")
        require(runtime_usec(record["manager"]["RuntimeMaxUSec"]) == record["RuntimeMaxUSec"])
        require(all(record[field] for field in ("pid", "starttime", "cgroup", "slice", "caller_slice", "parent_slice")))
        require(record["unit"].startswith(f"ci-perf-slot-fixture-{receipt['invocation']}-"))


def fixture_cgroups(lane, prefix):
    def failed(error):
        if not (isinstance(error, FileNotFoundError) and Path(error.filename) == lane):
            raise error
    return sum(Path(directory).name.startswith(prefix) for directory, children, files in os.walk(lane, onerror=failed))


def receipt_directory(path, roots):
    require(stat.S_ISDIR(os.lstat(path).st_mode), "receipt sink must be a real directory")
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW)
    try:
        info = os.fstat(fd)
        require(info.st_uid == os.geteuid() and not info.st_mode & 0o022, "unsafe receipt directory owner or mode")
        resolved = Path(os.path.realpath(f"/proc/self/fd/{fd}"))
        require(not any(resolved.is_relative_to(Path(root).resolve()) for root in roots), "receipt sink is disposable")
        return fd
    except BaseException:
        os.close(fd)
        raise


def write_receipt(fd, name, data):
    with os.fdopen(os.open(name, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600, dir_fd=fd), "w") as stream:
        json.dump(data, stream, sort_keys=True)
        stream.write("\n")
        stream.flush()
        os.fsync(stream.fileno())


class EvidenceTee:
    def __init__(self, stream, lines):
        self.stream, self.lines, self.pending = stream, lines, ""

    def write(self, text):
        self.stream.write(text)
        self.pending += text
        while "\n" in self.pending:
            line, self.pending = self.pending.split("\n", 1)
            self.lines.append(line)
        return len(text)

    def flush(self):
        self.stream.flush()


@contextlib.contextmanager
def receipt_sink(path):
    receipt = {"invocation": os.urandom(12).hex(), "fixtures": [], "scanned_roots": []}
    if not path:
        yield receipt
        return
    source = Path(__file__).resolve()
    git_env = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}
    def git(*args, raw=False):
        value = subprocess.check_output(["git", "-C", str(source.parent), *args], env=git_env, text=not raw, timeout=15)
        return value if raw else value.strip()
    # Mirror st-test's default roots; st-test supplies its resolved configured roots before scrubbing ST_*.
    roots = [git("rev-parse", "--show-toplevel"), os.getcwd(), str(Path.home() / ".cache/st-test"),
             os.environ.get("ST_TEST_POOL", str(Path.home() / ".cache/st-test")),
             os.environ.get("ST_TEST_TMP", "/var/tmp"), tempfile.gettempdir()]
    roots += json.loads(os.environ.get("CI_PERF_SLOT_DISPOSABLE_ROOTS", "[]"))
    roots.append(subprocess.check_output(["git", "-C", os.getcwd(), "rev-parse", "--show-toplevel"],
                                         env=git_env, text=True, timeout=15).strip())
    fd = receipt_directory(path, roots)
    name = f"ci-perf-slot-{time.strftime('%Y%m%dT%H%M%SZ', time.gmtime())}-{os.getpid()}.json"
    previous = {sig: signal.getsignal(sig) for sig in (signal.SIGINT, signal.SIGTERM)}
    try:
        group = cgroup_path(Path("/proc/self/cgroup").read_text())
        admitted = os.environ.get("GATE_SLOT_SCOPE_UNIT")
        require(not admitted or admitted in group.split("/"), "admission marker does not match kernel cgroup")
        receipt.update(status="started", outcome="failure", caller_pid=os.getpid(),
                       caller_starttime=starttime(Path("/proc/self/stat").read_text()),
                       caller_cgroup=group,
                       gate_slot={"unit": admitted, "cgroup": group.split(admitted)[0] + admitted if admitted else None},
                       **source_identity(git), source_sha256=hashlib.sha256(source.read_bytes()).hexdigest(),
                       hostname=socket.gethostname(), started_utc=utc(), stdout=[])
        write_receipt(fd, name, receipt)
        os.fsync(fd)
        def interrupted(signum, frame):
            receipt["signal"] = signal.Signals(signum).name
            raise SystemExit(128 + signum)
        for sig in previous:
            signal.signal(sig, interrupted)
        try:
            with contextlib.redirect_stdout(EvidenceTee(sys.stdout, receipt["stdout"])):
                yield receipt
            receipt["outcome"] = "success"
        except BaseException as error:
            receipt["outcome"] = "interrupted" if isinstance(error, (KeyboardInterrupt, SystemExit)) else "failure"
            receipt["error"] = repr(error)
            raise
        finally:
            receipt["fixtures"] = list(receipt["fixtures"])
            receipt.update(status="final", ended_utc=utc())
            temporary = name + "." + receipt["invocation"]
            write_receipt(fd, temporary, receipt)
            os.replace(temporary, name, src_dir_fd=fd, dst_dir_fd=fd)
            os.fsync(fd)
    finally:
        for sig, handler in previous.items():
            signal.signal(sig, handler)
        os.close(fd)

slot = str(Path(__file__).resolve().parent / "ci-perf-slot")


def start(env, *args, command, signal_mask=None):
    # The test is single-threaded; restore the child's mask before exec, not the parent's protected registration window.
    restore_mask = (lambda: signal.pthread_sigmask(signal.SIG_SETMASK, signal_mask)) if signal_mask is not None else None
    return subprocess.Popen([sys.executable, slot, *args, "--", *command], env=env, preexec_fn=restore_mask,
                            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)


def signal_on_publication(env, number):
    # Inject cancellation at the first instant holder.json is visible, before
    # run() can continue to fork. This makes the startup race deterministic.
    script = '''import os, pathlib, runpy, sys
number = int(sys.argv.pop(1))
replace = pathlib.Path.replace
def publish(self, target):
    result = replace(self, target)
    if pathlib.Path(target).name == "holder.json":
        os.kill(os.getpid(), number)
    return result
pathlib.Path.replace = publish
sys.argv = sys.argv[1:]
sys.path.insert(0, str(pathlib.Path(sys.argv[0]).parent))
runpy.run_path(sys.argv[0], run_name="__main__")
'''
    return subprocess.Popen([sys.executable, "-c", script, str(number), slot, "--", "sleep", "60"],
                            env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)


def launch_fixture(unit, units, wrappers, env, *args, command):
    previous = signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGINT, signal.SIGTERM})
    try:
        units.append(unit)
        victim = start(env, *args, command=command, signal_mask=previous)
        wrappers.append(victim)
        return victim
    finally:
        signal.pthread_sigmask(signal.SIG_SETMASK, previous)


def fixture_listing(systemctl, pid):
    try:
        return subprocess.check_output([systemctl, "--user", "list-units", f"ci-perf-slot-fixture-{pid}-*",
                                        "--all", "--no-legend", "--plain"], text=True, timeout=15)
    except subprocess.TimeoutExpired as error:
        raise AssertionError("fixture drain unconfirmed: systemctl list-units timed out after 15s") from error


def stop_fixture(systemctl, unit):
    try:
        subprocess.run([systemctl, "--user", "stop", unit], capture_output=True, timeout=15)
    except subprocess.TimeoutExpired as error:
        raise AssertionError(f"fixture drain unconfirmed: systemctl stop {unit} timed out after 15s") from error


def until(condition, what, seconds=10):
    deadline = time.time() + seconds
    while time.time() < deadline:
        if condition():
            return
        time.sleep(0.02)
    raise AssertionError("timed out: " + what)


def alive(pid):
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    try:
        stat = Path("/proc/%d/stat" % pid).read_text()
    except (FileNotFoundError, ProcessLookupError):
        return False  # it exited and was reaped after the kill above: gone, so not running
    return stat.rsplit(")", 1)[1].split()[0] != "Z"

def cgroup_path(text):
    lines = text.splitlines()
    require(lines and all(re.fullmatch(r"\d+:[^:]*:/.*", line) for line in lines), "malformed cgroup metadata")
    paths = [line[3:] for line in lines if line.startswith("0::")]
    require(len(paths) == 1, "missing or duplicate unified cgroup metadata")
    path = paths[0]
    require(path == "/" or all(part not in ("", ".", "..") for part in path[1:].split("/")), "malformed cgroup path")
    return path


def caller_slice(text):
    path = cgroup_path(text)
    parent = path.rsplit("/", 1)[0]
    parts = path.strip("/").split("/")
    manager_depth = next((i for i, part in enumerate(parts) if re.fullmatch(r"user@\d+\.service", part)), None)
    if manager_depth is None:
        return None  # A --user scope would leave this caller's cgroup tree.
    assert manager_depth < len(parts) - 2, "caller parent is not strictly below its user manager"
    assert parent.endswith(".slice"), f"caller cgroup parent is not a slice: {parent}"
    return parent


def read_caller_slice(cgroup_file="/proc/self/cgroup"):
    return caller_slice(Path(cgroup_file).read_text())

def starttime(text):
    return int(text.rsplit(")", 1)[1].split()[19])  # /proc/PID/stat field 22


def runtime_usec(value):
    require(re.fullmatch(r"\d+(?:min|us|s)(?: \d+(?:min|us|s))*", value), "invalid runtime duration")
    return sum(int(n) * {"min": 60000000, "s": 1000000, "us": 1}[unit]
               for n, unit in re.findall(r"(\d+)(min|us|s)", value))


def kernel_limits(group):
    limits = {name: int((group / name).read_text()) for name in ("memory.max", "memory.swap.max", "pids.max")}
    assert limits == {"memory.max": 67108864, "memory.swap.max": 0, "pids.max": 16}, limits
    return limits


if sys.argv[1:2] == ["--validate-receipt"]:
    require(len(sys.argv) == 3 or (len(sys.argv) == 4 and sys.argv[3] == "--require-origin"), "expected --validate-receipt PATH [--require-origin]")
    validate_receipt(json.loads(Path(sys.argv[2]).read_text()), require_origin=len(sys.argv) == 4)
    print("passed: ci-perf-slot receipt")
    sys.exit(0)


# Fake cgroup lines exercise hierarchy-preserving leaf slice selection without a user bus.
manager = "/user.slice/user-1000.slice/user@1000.service"
for leaf in ("app.slice", "app.slice/app-capped.slice/app-capped-heavy.slice"):
    assert caller_slice(f"0::{manager}/{leaf}/gate-slot-heavy-1.scope\n") == f"{manager}/{leaf}"
assert caller_slice("0::/system.slice/ci-runner.service\n") is None
for invalid in (f"{manager}/app.slice/outer.scope/child", manager, f"{manager}/init.scope"):
    with patch.object(subprocess, "Popen") as launched:
        try:
            caller_slice(f"0::{invalid}\n")
        except AssertionError:
            pass
        else:
            raise AssertionError("a parent outside the user manager or not a slice must fail")
        launched.assert_not_called()
for metadata in ("", "not cgroup metadata", "0::relative", "0::/a\n0::/b\n", "0::/a/../b\n"):
    try:
        caller_slice(metadata)
    except ValueError:
        pass
    else:
        raise AssertionError("malformed cgroup metadata must fail, not skip")
assert starttime("1 (name with ) spaces) " + " ".join(["S"] + ["0"] * 18 + ["12345"])) == 12345
assert runtime_usec("1min 30s") == runtime_usec("90s") == runtime_usec("90000000us") == 90000000
with tempfile.TemporaryDirectory() as helper_tmp:
    group = Path(helper_tmp)
    for name, value in {"memory.max": 67108864, "memory.swap.max": 0, "pids.max": 16}.items():
        (group / name).write_text(str(value))
    assert kernel_limits(group)["pids.max"] == 16
    try:
        read_caller_slice(group / "unreadable")
    except OSError:
        pass
    else:
        raise AssertionError("unreadable cgroup metadata must fail, not skip")
    (group / "pids.max").unlink()
    try:
        kernel_limits(group)
    except OSError:
        pass
    else:
        raise AssertionError("missing kernel limit readback must fail")
test_units, test_wrappers, test_child, events = [], [], object(), []
def fake_mask(how, mask):
    if how == signal.SIG_BLOCK:
        assert mask == {signal.SIGINT, signal.SIGTERM}
        events.append("blocked")
        return set()
    assert test_units == ["fixture.scope"] and test_wrappers == [test_child]
    events.append("pending signal delivered after registration")
def fake_start(*args, **kwargs):
    assert test_units == ["fixture.scope"] and kwargs["signal_mask"] == set()
    events.append("launch")
    return test_child
with patch.object(signal, "pthread_sigmask", side_effect=fake_mask), patch.dict(globals(), start=fake_start):
    assert launch_fixture("fixture.scope", test_units, test_wrappers, {}, command=["true"]) is test_child
assert events == ["blocked", "launch", "pending signal delivered after registration"]
with patch.object(subprocess, "check_output", return_value="") as listing:
    fixture_listing("systemctl", 123)
    assert listing.call_args.args[0][3] == "ci-perf-slot-fixture-123-*"
    assert listing.call_args.kwargs["timeout"] == 15
with patch.object(subprocess, "run", return_value=None) as stopped_unit:
    stop_fixture("systemctl", "fixture.scope")
    assert stopped_unit.call_args.kwargs["timeout"] == 15
for helper, call in ((fixture_listing, "check_output"), (stop_fixture, "run")):
    with patch.object(subprocess, call, side_effect=subprocess.TimeoutExpired("systemctl", 15)):
        try:
            helper("systemctl", 123)
        except AssertionError as error:
            assert "drain unconfirmed" in str(error) and "timed out after 15s" in str(error)
        else:
            raise AssertionError("manager timeout must fail the drain")
with tempfile.TemporaryDirectory() as receipt_tmp:
    sink = Path(receipt_tmp)
    assert fixture_cgroups(sink / "missing", "fixture-") == 0
    for error in (PermissionError(13, "denied", str(sink)), FileNotFoundError(2, "gone", str(sink / "child"))):
        with patch.object(os, "walk", side_effect=lambda lane, onerror: onerror(error)), TestCase().assertRaises(type(error)):
            fixture_cgroups(sink, "fixture-")
    record = {}
    with TestCase().assertRaises(FileNotFoundError):
        peak(record, sink)
    assert record["peak_sampled_before_termination"].startswith("unavailable")
    peak(record, sink, final=True)
    assert record["peak_final_lifecycle"] == "unavailable (collected)"
    real_directory = receipt_directory
    for refusal in ("symlink", "mode", "owner", "disposable", "missing"):
        link = sink / "link"
        link.symlink_to(sink)
        sink.chmod(0o777 if refusal == "mode" else 0o700)
        with patch.object(subprocess, "Popen") as launched, contextlib.ExitStack() as stack:
            if refusal == "owner":
                stack.enter_context(patch.object(os, "geteuid", return_value=-1))
            with TestCase().assertRaises((ValueError, OSError)):
                receipt_directory(link if refusal == "symlink" else sink / "missing" if refusal == "missing" else sink,
                                  [sink] if refusal == "disposable" else [])
            launched.assert_not_called()
        link.unlink()
    sink.chmod(0o700)
    raw_commit = b"tree " + b"f" * 40 + b"\n\nfixture\n"
    fixture_head = hashlib.sha1(b"commit " + str(len(raw_commit)).encode() + b"\0" + raw_commit).hexdigest()
    encoded = base64.b64encode(raw_commit).decode()
    fixture_origin = dict(source_head=fixture_head, origin_head=fixture_head, sparse_head=fixture_head,
                          origin_tree="f" * 40, sparse_tree="f" * 40, origin_commit=encoded, sparse_commit=encoded)
    for outcome in ("success", "failure", "interrupted", "write-error"):
        for existing in sink.iterdir():
            existing.unlink()
        with patch.dict(os.environ, {"GATE_SLOT_SCOPE_UNIT": ""}), patch.object(
                sys.modules[__name__], "receipt_directory", side_effect=lambda path, roots: real_directory(path, [])), \
                patch.object(sys.modules[__name__], "source_identity", return_value=fixture_origin), \
                patch.object(subprocess, "check_output", return_value="f" * 40), contextlib.ExitStack() as stack:
            try:
                with receipt_sink(sink) as saved:
                    assert json.loads(next(sink.iterdir()).read_text())["status"] == "started"
                    if outcome == "failure":
                        raise ValueError("fixture failure")
                    if outcome == "interrupted":
                        signal.raise_signal(signal.SIGTERM)
                    if outcome == "write-error":
                        stack.enter_context(patch.object(os, "replace", side_effect=OSError("rename failed")))
            except (ValueError, SystemExit, OSError):
                assert outcome != "success"
            else:
                assert outcome == "success"
            data = json.loads(next(p for p in sink.iterdir() if p.name.endswith(".json")).read_text())
            assert data["status"] == ("started" if outcome == "write-error" else "final")
            assert outcome == "write-error" or data["outcome"] == outcome
            assert outcome != "interrupted" or data["signal"] == "SIGTERM"
    code = "import ast,sys; t=ast.parse(open(sys.argv[1]).read()); exec(compile(ast.Module([n for n in t.body if isinstance(n,(ast.Import,ast.ImportFrom,ast.FunctionDef))],[]),sys.argv[1],'exec')); receipt_directory(sys.argv[2],[sys.argv[2]])"
    refused = subprocess.run([sys.executable, "-O", "-c", code, str(Path(__file__).resolve()), str(sink)], capture_output=True)
    assert refused.returncode != 0 and b"receipt sink is disposable" in refused.stderr
    good = dict(data, outcome="success", status="final", ended_utc=utc(), remaining_units=0, remaining_cgroups=0,
                skip="no-user-manager", caller_cgroup="/system.slice/runner.service", fixtures=[], gate_slot={"unit": None, "cgroup": None})
    validate_receipt(good)
    parent = f"{manager}/ci.slice"
    fixture = dict(unit=f"ci-perf-slot-fixture-{good['invocation']}-0.scope", pid=1, starttime=1,
                   slice="ci.slice", caller_slice=parent, parent_slice=parent,
                   limits={"memory.max": 67108864, "memory.swap.max": 0, "pids.max": 16}, RuntimeMaxUSec=90000000,
                   manager={"MemoryMax": "67108864", "MemorySwapMax": "0", "TasksMax": "16", "RuntimeMaxUSec": "90s", "Slice": "ci.slice"},
                   peak_sampled_before_termination=1, peak_final_lifecycle="unavailable (collected)", drain="empty and collected")
    fixtures = [dict(fixture, unit=fixture["unit"].replace("-0.scope", f"-{n}.scope")) for n in range(2)]
    for record in fixtures:
        record["cgroup"] = f"{parent}/{record['unit']}"
        record["manager"] = dict(record["manager"], ControlGroup=record["cgroup"])
    complete = dict(good, skip=None, fixtures=fixtures, gate_slot={"unit": "gate.scope", "cgroup": f"{parent}/gate.scope"},
                    caller_cgroup=f"{parent}/gate.scope/child", scanned_roots=[parent, f"{manager}/app.slice", f"{manager}/builds.slice"])
    validate_receipt(complete)
    legacy = {key: value for key, value in complete.items() if key not in fixture_origin or key == "source_head"}
    validate_receipt(legacy)
    wrong = dict(complete, gate_slot={"unit": "gate.scope", "cgroup": "/other.slice/gate.scope"})
    for candidate, accepted in ((complete, True), (legacy, True), (wrong, False), (dict(complete, outcome="failure"), False),
                                (dict(complete, origin_head="short"), False), (dict(complete, origin_head=None), False),
                                (dict(complete, origin_tree="invalid"), False), (dict(complete, sparse_head="different"), False),
                                (dict(complete, gate_slot={"unit": None, "cgroup": None}), False),
                                (dict(complete, caller_cgroup="/system.slice/runner.service"), False),
                                (dict(complete, scanned_roots=[parent, f"{manager}/app.slice"]), False),
                                (dict(complete, fixtures=[dict(record, parent_slice="/other/ci.slice") for record in fixtures],
                                      scanned_roots=["/other/ci.slice"]), False),
                                (dict(complete, scanned_roots=[]), False)):
        (sink / "cli.json").write_text(json.dumps(candidate))
        for flags in ([], ["--require-origin"]):
            result = subprocess.run([sys.executable, "-O", str(Path(__file__).resolve()), "--validate-receipt", str(sink / "cli.json"), *flags], capture_output=True)
            assert (result.returncode == 0) == (accepted and (not flags or "origin_head" in candidate)), result.stderr.decode()
    for change in ({"drain": "not confirmed"}, *({"peak_final_lifecycle": value} for value in (None, -1, "unknown")),
                   *({"manager": dict(fixtures[1]["manager"], **{field: value})}
                     for field, value in (("ControlGroup", "/wrong"), ("Slice", "wrong.slice"), ("RuntimeMaxUSec", "1s")))):
        with TestCase().assertRaises(ValueError):
            validate_receipt(dict(complete, fixtures=[fixtures[0], dict(fixtures[1], **change)]))
    for bad in (dict(good, status="started"), dict(good, outcome="failure"), dict(good, remaining_units=1),
                dict(good, remaining_cgroups=1), dict(good, hostname=""), dict(good, ended_utc=""),
                dict(good, skip=None, fixtures=[]), dict(good, skip=None, fixtures=[{"drain": "not confirmed"}] * 2)):
        with TestCase().assertRaises((ValueError, KeyError)):
            validate_receipt(bad)
# A zombie is exited, not a live load. Leave it unreaped long enough to test
# the real /proc state rather than assuming kill(pid, 0) means running.
zombie = subprocess.Popen([sys.executable, "-c", "pass"])
try:
    os.waitid(os.P_PID, zombie.pid, os.WEXITED | os.WNOWAIT)
    assert not alive(zombie.pid)
finally:
    zombie.wait()

if sys.argv[1:] == ["--helpers-only"]:
    print("passed: ci-perf-slot helpers")
    sys.exit(0)



with receipt_sink(os.environ.get("CI_PERF_SLOT_RECEIPT_DIR")) as receipt, tempfile.TemporaryDirectory() as tmp:
    root = Path(tmp)
    env = {**os.environ, "PERF_SLOT_DIR": str(root / "slot"), "PERF_SLOT_POLL": "0.05", "PERF_SLOT_GRACE": "1"}
    holder = root / "slot/holder.json"

    def status():
        return subprocess.check_output([sys.executable, slot, "--status"], env=env, text=True)

    # The acquired slot overrides both inherited aliases, so an empty preferred
    # marker cannot mask the held slot and make the child acquire it again.
    for preferred in ("inherited-stale", ""):
        inherited = {**env, "FRACTAL_PERF_SLOT_HELD": preferred,
                     "ST_PERF_SLOT_HELD": "legacy-stale"}
        marked = start(inherited, command=[sys.executable, "-c",
            "import os; "
            "assert os.environ['FRACTAL_PERF_SLOT_HELD'] == open('/proc/%d/stat' % os.getppid()).read().rsplit(')', 1)[1].split()[1]; "
            "assert os.environ['ST_PERF_SLOT_HELD'] == open('/proc/%d/stat' % os.getppid()).read().rsplit(')', 1)[1].split()[1]"])
        assert marked.wait(10) == 0, marked.stderr.read()
        assert "perf slot free" in status() and not holder.exists()

    # A run that holds the slot until the test releases it: a fixed sleep ends on a loaded host before
    # the runs meant to queue behind it have joined the line (each is a process start and status polls).
    # It gives up after 30 s, so a failed assertion leaves no run behind.
    release = root / "release"

    def held(then):
        return 'n=0; until [ -e %s ] || [ $n -ge 1500 ]; do sleep 0.02; n=$((n + 1)); done; %s' % (release, then)

    # Two runs started at once take turns: the second starts only after the first ends, and the
    # waiting one is told who holds the slot and for what.
    log = root / "turns"
    script = 'echo "start $1" >> %s; %s' % (log, held('echo "end $1" >> %s' % log))
    first = start(env, "--for", "branch-one", command=["bash", "-c", script, "x", "one"])
    until(holder.exists, "first run holds the slot")
    second = start(env, "--for", "branch-two", command=["bash", "-c", script, "x", "two"])
    until(lambda: "waiting since" in status(), "second run waits in line")
    shown = status()
    assert "held by" in shown and "branch-one" in shown, shown
    assert "waiting since" in shown, shown
    release.touch()
    assert first.wait(20) == 0 and second.wait(20) == 0
    assert log.read_text().split("\n")[:-1] == ["start one", "end one", "start two", "end two"], log.read_text()
    assert "busy: held by" in second.stderr.read(), "the waiting run says who holds the slot"
    assert "perf slot free" in status() and not holder.exists()

    # Waiters go in the order they asked.
    order = root / "order"
    release.unlink()
    blocker = start(env, command=["bash", "-c", held("true")])
    until(holder.exists, "blocker holds the slot")
    waiters = []
    for name in ("a", "b", "c"):
        waiters.append(start(env, command=["bash", "-c", "echo %s >> %s" % (name, order)]))
        until(lambda: status().count("waiting since") == len(waiters), "%s in line" % name)
    release.touch()
    for process in [blocker, *waiters]:
        assert process.wait(20) == 0
    assert order.read_text().split() == ["a", "b", "c"]

    # A run killed mid-way (SIGKILL, so it cannot clean up) frees the slot at once and takes its
    # command with it, even a grandchild that ignores SIGTERM.
    pids = root / "pids"
    victim = start(env, command=["bash", "-c", "(trap '' TERM; sleep 60) & echo $! > %s; wait" % pids])
    until(lambda: pids.exists() and pids.read_text().strip(), "victim running")
    grandchild = int(pids.read_text())
    until(holder.exists, "victim holds the slot")
    waiting = start(env, command=["true"])
    until(lambda: "waiting since" in status(), "next run waits")
    victim.kill()
    assert waiting.wait(5) == 0, "the next run must get the slot as soon as the victim dies"
    until(lambda: not alive(grandchild), "the killed run's whole process group is gone")
    victim.wait()
    assert not holder.exists()

    # A scope move keeps the process group, so killing or timing out the group must kill it too.
    # Keep the moved fixture in the caller's enclosing slice and give it its own small hard limits.
    runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    systemd_run = next((Path(d) / "systemd-run" for d in os.environ["PATH"].split(":") + ["/run/current-system/sw/bin", "/usr/bin"]
                        if (Path(d) / "systemd-run").exists()), None)
    scope_available = systemd_run and runtime and Path(runtime, "bus").exists()
    slice_path = read_caller_slice() if scope_available else None
    if scope_available and slice_path:
        units, wrappers, scoped_pids, evidence = [], [], [], {}
        receipt["fixtures"] = evidence.values()
        systemctl = str(systemd_run.with_name("systemctl"))
        scoped = root / "scoped"
        script = "echo $BASHPID > %s; exec sleep 60" % scoped
        cleaned = False
        previous_signals = {sig: signal.getsignal(sig) for sig in (signal.SIGINT, signal.SIGTERM)}

        def finish_fixtures():
            global cleaned
            if cleaned:
                return
            for sig in previous_signals:
                signal.signal(sig, signal.SIG_IGN)
            try:
                for wrapper in wrappers:
                    if wrapper.poll() is None:
                        wrapper.terminate()
                    try:
                        wrapper.wait(10)
                    except subprocess.TimeoutExpired:
                        wrapper.kill()
                        wrapper.wait(10)
                # Stop after wrapper exit: a launch already in flight must not register a scope after our stop.
                for unit in units:
                    stop_fixture(systemctl, unit)
                for unit in units:
                    record = evidence.setdefault(unit, {"unit": unit})
                    peak(record, Path("/sys/fs/cgroup", record.get("cgroup", f"{slice_path}/{unit}").lstrip("/")), final=True)
                def no_fixtures():
                    listed = fixture_listing(systemctl, receipt["invocation"])
                    return not listed.strip() and not any(alive(pid) for pid in scoped_pids)
                until(no_fixtures, "all fixture scopes and processes are gone")
                receipt["remaining_units"] = len(fixture_listing(systemctl, receipt["invocation"]).splitlines())
                manager_root = Path("/sys/fs/cgroup", slice_path.lstrip("/").split(".service/", 1)[0] + ".service")
                receipt["scanned_roots"] = sorted({str(manager_root / lane).removeprefix("/sys/fs/cgroup") for lane in ("app.slice", "builds.slice")} |
                                                 {record.get("parent_slice", slice_path) for record in evidence.values()})
                receipt["remaining_cgroups"] = sum(fixture_cgroups(Path("/sys/fs/cgroup", lane.lstrip("/")), f"ci-perf-slot-fixture-{receipt['invocation']}-")
                                                  for lane in receipt["scanned_roots"])
                require(receipt["remaining_units"] == receipt["remaining_cgroups"] == 0, "fixture cgroups remain")
                cleaned = True
            except subprocess.TimeoutExpired as error:
                raise AssertionError("fixture drain unconfirmed: wrapper did not exit after TERM/KILL deadlines") from error
            finally:
                for record in evidence.values():
                    record["drain"] = "empty and collected" if cleaned else "not confirmed"
                    print("ci-perf-slot fixture: " + json.dumps(record, sort_keys=True), flush=True)
                for sig, handler in previous_signals.items():
                    signal.signal(sig, handler)

        def cancelled(signum, frame):
            finish_fixtures()
            receipt["signal"] = signal.Signals(signum).name
            raise SystemExit(128 + signum)

        for sig in previous_signals:
            signal.signal(sig, cancelled)
        try:
            for n, mode in enumerate(("kill", "timeout")):
                unit = f"ci-perf-slot-fixture-{receipt['invocation']}-{n}.scope"
                scoped.unlink(missing_ok=True)
                command = [str(systemd_run), "--user", "--scope", "--quiet", "--collect",
                           f"--slice={Path(slice_path).name}", f"--unit={unit}",
                           "-p", "MemoryMax=64M", "-p", "MemorySwapMax=0", "-p", "TasksMax=16",
                           "-p", "RuntimeMaxSec=90", "--", "bash", "-c", script]
                victim = launch_fixture(unit, units, wrappers, env, *(("--timeout", "1s") if mode == "timeout" else ()), command=command)
                until(lambda: scoped.exists() and scoped.read_text().strip(), "scoped run started")
                scoped_pid = int(scoped.read_text())
                scoped_pids.append(scoped_pid)
                group = cgroup_path(Path(f"/proc/{scoped_pid}/cgroup").read_text())
                record = evidence.setdefault(unit, {"unit": unit, "caller_slice": slice_path, "parent_slice": slice_path})
                record.update(pid=scoped_pid, starttime=starttime(Path(f"/proc/{scoped_pid}/stat").read_text()), cgroup=group)
                assert group == f"{slice_path}/{unit}", f"fixture left caller slice: {group}"
                properties = dict(line.split("=", 1) for line in subprocess.check_output(
                    [systemctl, "--user", "show", unit, "-p", "MemoryMax", "-p", "MemorySwapMax",
                     "-p", "TasksMax", "-p", "RuntimeMaxUSec", "-p", "ControlGroup", "-p", "Slice"], text=True).splitlines())
                assert properties["MemoryMax"] == "67108864", properties
                assert properties["MemorySwapMax"] == "0" and properties["TasksMax"] == "16", properties
                assert properties["ControlGroup"] == group and properties["Slice"] == Path(slice_path).name, properties
                usec = runtime_usec(properties["RuntimeMaxUSec"])
                assert usec == 90000000, properties
                record.update(slice=properties["Slice"], limits=kernel_limits(Path("/sys/fs/cgroup", group.lstrip("/"))),
                              RuntimeMaxUSec=usec, manager=properties)
                peak(record, Path("/sys/fs/cgroup", group.lstrip("/")))
                if mode == "kill":
                    victim.kill()
                assert victim.wait(20) == (124 if mode == "timeout" else -signal.SIGKILL)
                until(lambda: not alive(scoped_pid), f"{mode} stops the scope process")
        finally:
            finish_fixtures()
    elif scope_available:
        receipt.update(skip="no-user-manager", remaining_units=0, remaining_cgroups=0)
        print("skipped: caller is not under a user manager; a --user scope would leave the caller's cgroup tree (scope-move case)")
    else:
        receipt["skip"] = "no-user-bus"
        print("skipped: no systemd user bus for the scope case")

    # Ctrl-C and SIGTERM on the wrapper stop the run and free the slot too.
    for number in (signal.SIGINT, signal.SIGTERM):
        stopped = start(env, command=["sleep", "60"])
        # No pause between looks, and nothing read first: the signal comes as soon as the record shows the slot held, which is
        # where a wrapper that installed its handlers after publishing the record exited without dropping it (2026-11-01, two
        # merge groups). The record names the wrapper itself.
        deadline = time.time() + 10
        while not holder.exists():
            assert time.time() < deadline, "timed out: run holds the slot"
        stopped.send_signal(number)
        pid = stopped.pid
        assert stopped.wait(10) == 128 + number
        assert not alive(pid) and not holder.exists()

    # The publication itself is the readiness boundary: even a signal before
    # the watchdog forks must return only after cleanup, not leave a record.
    for number in (signal.SIGINT, signal.SIGTERM):
        stopped = signal_on_publication(env, number)
        assert stopped.wait(10) == 128 + number, stopped.stderr.read()
        assert not holder.exists() and "perf slot free" in status()

    # The watchdog is protected from TERM itself, but must not pass SIG_IGN
    # through exec to its command. A shell cannot install a TERM cleanup trap
    # when that signal was ignored at shell entry. Check the actual receipt,
    # not just eventual death/KILL and slot release.
    for mode, expected in (("timeout", 124), ("wrapper-term", 143)):
        ready = root / (mode + ".ready")
        cleanup = root / (mode + ".cleanup")
        script = ('trap \'printf cleaned > "$2"; exit 0\' TERM; '
                  'printf ready > "$1"; while :; do sleep 0.05; done')
        options = ("--timeout", "1s") if mode == "timeout" else ()
        stopped = start(env, *options,
                        command=["bash", "-c", script, "fixture", str(ready), str(cleanup)])
        until(ready.exists, mode + " command installed its TERM trap")
        if mode == "wrapper-term":
            stopped.send_signal(signal.SIGTERM)
        assert stopped.wait(10) == expected, stopped.stderr.read()
        assert cleanup.read_text() == "cleaned", mode + " must allow graceful TERM cleanup"
        assert "perf slot free" in status() and not holder.exists()

    # A run past its timeout is stopped, even one that ignores SIGTERM, and the slot frees.
    started = time.time()
    hung = start(env, "--timeout", "1s", command=["bash", "-c", "trap '' TERM; while :; do sleep 0.1; done"])
    assert hung.wait(20) == 124, "a timeout exits 124"
    assert time.time() - started < 10
    assert "timeout" in hung.stderr.read()
    assert "perf slot free" in status()

    # The command's own status passes through, and a timeout cannot be asked for beyond two hours.
    assert start(env, command=["bash", "-c", "exit 7"]).wait(10) == 7
    refused = start(env, "--timeout", "3h", command=["true"])
    assert refused.wait(10) == 2 and "at most 2h" in refused.stderr.read()
    assert start(env, "--timeout", "90m", command=["true"]).wait(10) == 0

    # --help tells a builder how to measure, which budgets apply and what evidence to post.
    helped = subprocess.check_output([sys.executable, slot, "--help"], env=env, text=True)
    for phrase in ("ci-perf load", "budget", "Evidence for the PR", "2h", "--timeout"):
        assert phrase in helped, phrase

    print("passed: ci-perf-slot")
