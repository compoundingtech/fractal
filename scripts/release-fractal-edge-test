#!/usr/bin/env python3
"""Exercise the rolling edge release against a fake gh: first create, replace, rerun, stale commit, stale assets."""
import hashlib
import io
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tarfile
import tempfile

repo = Path(__file__).resolve().parent.parent
TARGETS = ('x86_64-unknown-linux-gnu', 'aarch64-apple-darwin')

FAKE_GH = r'''#!/usr/bin/env python3
import json, os, pathlib, sys
state_path = pathlib.Path(os.environ['FAKE_GH_STATE'])
state = json.loads(state_path.read_text())
args = sys.argv[1:]
def save():
    state_path.write_text(json.dumps(state))
def fail(message):
    print(message, file=sys.stderr); sys.exit(1)
def option(name, default=None):
    return args[args.index(name) + 1] if name in args else default
state['calls'].append(args)
# Scripted GitHub failures: each matches the start of a call, fails it `times` times, and fails
# either before the call takes effect or after, as a 504 that GitHub answers once it did the work.
late = None
for failure in state.get('fail', []):
    if args[:len(failure['match'])] == failure['match'] and failure['times'] > 0:
        failure['times'] -= 1
        if not failure['after']:
            save(); fail(failure['message'])
        late = failure['message']
        break
if args[:2] == ['release', 'view']:
    if state['release'] is None: fail('release not found')
    print(json.dumps({'assets': [{'name': n} for n in state['release']['assets']]}))
elif args[:2] == ['release', 'create']:
    if state['release'] is not None: fail('release already exists')
    files = [a for a in args[args.index('--notes-file') + 2:] if not a.startswith('--')]
    state['release'] = {'assets': {pathlib.Path(f).name: pathlib.Path(f).read_text(errors='replace')[:20] for f in files},
                        'prerelease': '--prerelease' in args, 'latest': option('--latest=false') is None and '--latest=false' not in args,
                        'notes': pathlib.Path(option('--notes-file')).read_text(), 'title': option('--title')}
    state['tag'] = option('--target')
elif args[:2] == ['release', 'upload']:
    files = [a for a in args[args.index('--clobber') + 1:]]
    for f in files: state['release']['assets'][pathlib.Path(f).name] = pathlib.Path(f).read_text(errors='replace')[:20]
elif args[:2] == ['release', 'delete-asset']:
    del state['release']['assets'][args[3]]
elif args[:2] == ['release', 'edit']:
    state['release']['notes'] = pathlib.Path(option('--notes-file')).read_text()
    state['release']['title'] = option('--title')
    state['release']['prerelease'] = '--prerelease' in args
    state['release']['latest'] = '--latest=false' not in args
elif args[0] == 'api' and 'PATCH' in args:
    assert any(a == 'force=true' for a in args), args
    state['tag'] = [a for a in args if a.startswith('sha=')][0][4:]
elif args[0] == 'api':
    if state['tag'] is None: fail('Not Found')
    print(json.dumps({'object': {'type': 'commit', 'sha': state['tag']}}))
else:
    fail('unexpected gh call: %r' % args)
save()
if late:
    fail(late)
'''


def sh(*cmd, cwd, env=None):
    print('fixture git stage: ' + json.dumps(cmd), file=sys.stderr, flush=True)
    try:
        return subprocess.run(cmd, cwd=cwd, check=True, text=True, capture_output=True, env=env).stdout.strip()
    except subprocess.CalledProcessError as error:
        error.add_note(f'fixture command stdout:\n{error.stdout}\nstderr:\n{error.stderr}')
        raise


def build_dist(dist, source, marker):
    dist.mkdir()
    sums = []
    for target in TARGETS:
        for prefix in ('fractal', 'smalltalk'):
            package = f'{prefix}-{target}'
            with tarfile.open(dist / f'{package}.tar.gz', 'w:gz') as archive:
                def add(name, data=b'', mode=0o755, link=None):
                    info = tarfile.TarInfo(f'{package}/{name}')
                    info.mode = mode
                    if link:
                        info.type, info.linkname = tarfile.SYMTYPE, link
                        archive.addfile(info)
                    else:
                        info.size = len(data)
                        archive.addfile(info, io.BytesIO(data))
                add('BUILD.json', json.dumps({'source': source, 'target': target, 'pty_revision': 'pty', 'tag': ''}).encode(), 0o644)
                add('bin/fractal', marker.encode())
                add('bin/pty', b'pty')
                add('share/fractal-web/index.html', b'web', 0o644)
                add('bin/st', link='fractal')
                add('bin/st3', link='fractal')
                add('install.sh'); add('install-macos.py'); add('macos-installation.md', b'', 0o644)
            digest = hashlib.sha256((dist / f'{package}.tar.gz').read_bytes()).hexdigest()
            line = f'{digest}  {package}.tar.gz\n'
            (dist / f'{package}.tar.gz.sha256').write_text(line)
            sums.append(line)
    (dist / 'SHA256SUMS').write_text(''.join(sums))
    (dist / 'RELEASE.json').write_text('{}')
    (dist / 'RELEASE-NOTES.md').write_text('the long guide is not an edge asset')


with tempfile.TemporaryDirectory() as temporary:
    root = Path(temporary)
    checkout = root / 'checkout'
    (checkout / 'scripts').mkdir(parents=True)
    for name in ('release-fractal-edge', 'release-fractal-manifest.py', 'release_gh.py'):
        shutil.copy(repo / 'scripts' / name, checkout / 'scripts' / name)
    sh('git', 'init', '-q', '-b', 'main', cwd=checkout)
    # Fixture history must not depend on the account's interactive signing agent.
    sh('git', 'config', '--local', 'commit.gpgsign', 'false', cwd=checkout)
    sh('git', 'config', '--local', 'tag.gpgsign', 'false', cwd=checkout)
    sh('git', 'config', 'user.name', 'Fixture', cwd=checkout)
    sh('git', 'config', 'user.email', 'fixture@example.invalid', cwd=checkout)
    commits = []
    for index, subject in enumerate(['first change', 'second change', 'third change']):
        (checkout / 'file').write_text(str(index))
        sh('git', 'add', '.', cwd=checkout)
        sh('git', 'commit', '-q', '-m', subject, cwd=checkout)
        commits.append(sh('git', 'rev-parse', 'HEAD', cwd=checkout))
    tools = root / 'tools'
    tools.mkdir()
    (tools / 'gh').write_text(FAKE_GH)
    (tools / 'gh').chmod(0o755)
    state = root / 'state.json'
    state.write_text(json.dumps({'release': None, 'tag': None, 'calls': []}))
    env = dict(os.environ, PATH=f'{tools}:{os.environ["PATH"]}', FAKE_GH_STATE=str(state), GH_REPO='example/project',
               RELEASE_GH_RETRY_DELAYS='0,0,0')

    def publish(source, marker, *extra):
        dist = root / f'dist-{marker}'
        build_dist(dist, source, marker)
        return subprocess.run(['python3', 'scripts/release-fractal-edge', '--source', source, '--dist', str(dist),
                               '--run-url', 'https://example.invalid/run/1', *extra],
                              cwd=checkout, env=env, text=True, capture_output=True)

    def current():
        return json.loads(state.read_text())

    def checkout_tags():
        # A fresh Actions checkout carries the remote tag.
        tag = current()['tag']
        if tag:
            sh('git', 'tag', '-f', 'edge', tag, cwd=checkout)

    # The first run creates one pre-release at the newest commit, with the newest commits listed.
    done = publish(commits[0], 'one')
    assert done.returncode == 0, done
    first = current()
    assert first['tag'] == commits[0] and first['release']['prerelease'] and not first['release']['latest'], first
    assert 'First edge release' in first['release']['notes'] and 'first change' in first['release']['notes']
    assert f'`{commits[0]}`' in first['release']['notes'] and 'example.invalid/run/1' in first['release']['notes']
    assert sorted(first['release']['assets']) == sorted(
        [f'{p}-{t}.tar.gz{s}' for p in ('fractal', 'smalltalk') for t in TARGETS for s in ('', '.sha256')] + ['SHA256SUMS', 'RELEASE.json']), first
    assert 'RELEASE-NOTES.md' not in first['release']['assets']

    # A later commit replaces the assets in place, moves the tag and lists only the new commits.
    checkout_tags()
    done = publish(commits[2], 'three')
    assert done.returncode == 0, done
    second = current()
    assert second['tag'] == commits[2] and len(second['release']['assets']) == 10, second
    notes = second['release']['notes']
    assert 'second change' in notes and 'third change' in notes and 'first change' not in notes, notes
    assert sum(1 for call in second['calls'] if call[:2] == ['release', 'create']) == 1, 'one release, not one per commit'

    # Rerunning the same commit is harmless; a run for an older commit changes nothing at all.
    checkout_tags()
    assert publish(commits[2], 'three-again').returncode == 0
    before = current()
    checkout_tags()
    done = publish(commits[1], 'two')
    assert done.returncode == 0 and 'newer' in done.stdout, done
    after = current()
    assert after['tag'] == commits[2] and after['release']['notes'] == before['release']['notes'], after
    assert after['calls'] == before['calls'], 'an older commit must not touch the release'

    # An asset from an older layout is removed, so the release matches this run exactly.
    stale = current()
    stale['release']['assets']['smalltalk-old-target.tar.gz'] = 'old'
    state.write_text(json.dumps(stale))
    checkout_tags()
    assert publish(commits[2], 'three-stale').returncode == 0
    assert 'smalltalk-old-target.tar.gz' not in current()['release']['assets']

    # Corrupt or mismatched archives are refused before gh is called.
    calls = len(current()['calls'])
    dist = root / 'dist-bad'
    build_dist(dist, commits[2], 'bad')
    (dist / 'SHA256SUMS').write_text('0' * 64 + f'  smalltalk-{TARGETS[0]}.tar.gz\n' + (dist / 'SHA256SUMS').read_text().splitlines()[1] + '\n')
    done = subprocess.run(['python3', 'scripts/release-fractal-edge', '--source', commits[2], '--dist', str(dist)],
                          cwd=checkout, env=env, text=True, capture_output=True)
    assert done.returncode != 0 and len(current()['calls']) == calls, done
    build_dist(root / 'dist-wrong-source', commits[0], 'wrong')
    done = subprocess.run(['python3', 'scripts/release-fractal-edge', '--source', commits[2], '--dist', str(root / 'dist-wrong-source')],
                          cwd=checkout, env=env, text=True, capture_output=True)
    assert done.returncode != 0 and len(current()['calls']) == calls, done

    # A checksummed compatibility copy with different payload bytes is not publishable.
    mismatch = root / 'dist-legacy-mismatch'
    build_dist(mismatch, commits[2], 'canonical')
    other = root / 'dist-other'
    build_dist(other, commits[2], 'different')
    name = f'smalltalk-{TARGETS[0]}.tar.gz'
    shutil.copy(other / name, mismatch / name)
    lines = (mismatch / 'SHA256SUMS').read_text().splitlines()
    digest = hashlib.sha256((mismatch / name).read_bytes()).hexdigest()
    (mismatch / 'SHA256SUMS').write_text('\n'.join(
        f'{digest}  {name}' if line.endswith('  ' + name) else line for line in lines) + '\n')
    done = subprocess.run(['python3', 'scripts/release-fractal-edge', '--source', commits[2], '--dist', str(mismatch)],
                          cwd=checkout, env=env, text=True, capture_output=True)
    assert done.returncode != 0 and len(current()['calls']) == calls, done

    # A dry run prints the notes and publishes nothing.
    checkout_tags()
    done = publish(commits[2], 'dry', '--dry-run')
    assert done.returncode == 0 and 'dry run' in done.stdout and len(current()['calls']) == calls, done

    # GitHub answers 504 or times out now and then (#4606). Each case starts from no edge release.
    timeout = 'HTTP 504: We couldn\'t respond to your request in time. (https://api.github.com/repos/example/project/releases)'
    def from_scratch(*failures, release=None, tag=None):
        state.write_text(json.dumps({'release': release, 'tag': tag, 'calls': [], 'fail': [
            {'match': match, 'after': after, 'times': times, 'message': message}
            for match, after, times, message in failures]}))
        return publish(commits[2], f'retry-{len(list(root.glob("dist-retry-*")))}')
    def calls(prefix):
        return sum(1 for call in current()['calls'] if call[:len(prefix)] == prefix)
    def complete():
        release = current()
        return release['tag'] == commits[2] and len(release['release']['assets']) == 10

    # A create that made the release and then timed out continues from it, never "already exists".
    done = from_scratch((['release', 'create'], True, 1, timeout))
    assert done.returncode == 0 and complete() and calls(['release', 'create']) == 1, (done, current())
    assert 'took effect before it failed' in done.stderr, done.stderr
    # A create that timed out before it took effect is made again.
    done = from_scratch((['release', 'create'], False, 1, timeout))
    assert done.returncode == 0 and complete() and calls(['release', 'create']) == 2, (done, current())
    # A read that times out is read again, not taken for "no release".
    done = from_scratch((['release', 'view'], False, 1, 'Get "https://api.github.com/...": net/http: TLS handshake timeout'))
    assert done.returncode == 0 and complete(), (done, current())
    # A tag move that took effect and then timed out is not repeated.
    older = {'assets': {}, 'prerelease': True, 'latest': False, 'notes': '', 'title': 'older'}
    done = from_scratch((['api', '--method', 'PATCH'], True, 1, timeout), release=older, tag=commits[1])
    assert done.returncode == 0 and complete() and calls(['api', '--method', 'PATCH']) == 1, (done, current())
    # Anything but a 5xx or a timeout fails at once.
    done = from_scratch((['release', 'edit'], False, 1, 'HTTP 422: Validation Failed'))
    assert done.returncode != 0 and calls(['release', 'edit']) == 1 and '422' in done.stderr, (done, current())
    # A 504 that does not clear fails after the retries: one call and three more.
    done = from_scratch((['release', 'edit'], False, 99, timeout))
    assert done.returncode != 0 and calls(['release', 'edit']) == 4 and '504' in done.stderr, (done, current())
print('Edge release creation, replacement, ordering, stale assets, retries and verification passed')
