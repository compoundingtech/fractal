#!/usr/bin/env python3
"""Exercise the rolling edge release against a fake gh: first create, replace, rerun, stale commit, stale assets."""
import hashlib
import io
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tarfile
import tempfile

repo = Path(__file__).resolve().parent.parent
TARGETS = ('x86_64-unknown-linux-gnu', 'aarch64-apple-darwin')

FAKE_GH = r'''#!/usr/bin/env python3
import base64, json, os, pathlib, sys
state_path = pathlib.Path(os.environ['FAKE_GH_STATE'])
state = json.loads(state_path.read_text())
args = sys.argv[1:]
def save():
    state_path.write_text(json.dumps(state))
def fail(message):
    print(message, file=sys.stderr); sys.exit(1)
def option(name, default=None):
    return args[args.index(name) + 1] if name in args else default
state['calls'].append(args)
if args[:2] == ['release', 'upload'] and state.get('interrupt_alias'):
    target = state['interrupt_alias']
    if any(pathlib.Path(value).name == target for value in args[args.index('--clobber') + 1:]):
        state['release']['assets'].pop(target, None)
        del state['interrupt_alias']
        save(); fail('HTTP 422: interrupted after clobber deletion')
# Scripted GitHub failures: each matches the start of a call, fails it `times` times, and fails
# either before the call takes effect or after, as a 504 that GitHub answers once it did the work.
late = None
for failure in state.get('fail', []):
    if args[:len(failure['match'])] == failure['match'] and failure['times'] > 0:
        failure['times'] -= 1
        if not failure['after']:
            save(); fail(failure['message'])
        late = failure['message']
        break
if args[:2] == ['release', 'view']:
    if state['release'] is None: fail('release not found')
    print(json.dumps({'assets': [{'name': n} for n in state['release']['assets']],
                      'body': state['release']['notes'], 'name': state['release']['title'],
                      'isPrerelease': state['release']['prerelease']}))
elif args[:2] == ['release', 'download']:
    value = state['release']['assets'][option('--pattern')]
    if option('--output') == '-':
        print(value)
    else:
        pathlib.Path(option('--output')).write_bytes(value.encode('latin1'))
elif args[:2] == ['release', 'create']:
    if state['release'] is not None: fail('release already exists')
    assert '--verify-tag' in args and state['tag'] == option('--target'), args
    files = [a for a in args[args.index('--notes-file') + 2:] if not a.startswith('--')]
    state['release'] = {'assets': {pathlib.Path(f).name: pathlib.Path(f).read_bytes().decode('latin1') for f in files},
                        'prerelease': '--prerelease' in args, 'latest': option('--latest=false') is None and '--latest=false' not in args,
                        'notes': pathlib.Path(option('--notes-file')).read_text(), 'title': option('--title')}
    # A release create must use the tag already pushed through Git.
elif args[:2] == ['release', 'upload']:
    files = [a for a in args[args.index('--clobber') + 1:]]
    if 'assets_before_first_alias' not in state and any(
            pathlib.Path(f).name.startswith(('fractal-', 'smalltalk-'))
            or pathlib.Path(f).name in ('SHA256SUMS', 'RELEASE.json') for f in files):
        state['assets_before_first_alias'] = dict(state['release']['assets'])
    for f in files: state['release']['assets'][pathlib.Path(f).name] = pathlib.Path(f).read_bytes().decode('latin1')
elif args[:2] == ['release', 'delete-asset']:
    del state['release']['assets'][args[3]]
elif args[:2] == ['release', 'edit']:
    state['release']['notes'] = pathlib.Path(option('--notes-file')).read_text()
    state['release']['title'] = option('--title')
    state['release']['prerelease'] = '--prerelease' in args
    state['release']['latest'] = '--latest=false' not in args
elif args[:2] == ['git', 'push']:
    expected = state.get('tag_object', state['tag']) or ''
    lease = f'--force-with-lease=refs/tags/edge:{expected}'
    if args[2] != lease:
        save(); fail('stale info: lease rejected')
    assert args[3] == 'https://github.com/example/project.git', args
    assert args[4].endswith(':refs/tags/edge'), args
    index = int(os.environ['GIT_CONFIG_COUNT']) - 1
    assert os.environ[f'GIT_CONFIG_KEY_{index}'] == 'http.https://github.com/.extraheader'
    assert os.environ[f'GIT_CONFIG_VALUE_{index}'] == 'AUTHORIZATION: basic ' + base64.b64encode(
        b'x-access-token:test-token').decode()
    state['tag'] = args[4].split(':')[0]
    state.pop('tag_object', None)
elif args[0] == 'api':
    if state['tag'] is None: fail('Not Found')
    if '/git/tags/' in args[1]:
        print(json.dumps({'object': {'type': 'commit', 'sha': state['tag']}}))
    else:
        print(json.dumps({'object': {'type': 'tag' if 'tag_object' in state else 'commit',
                                    'sha': state.get('tag_object', state['tag'])}}))
else:
    fail('unexpected gh call: %r' % args)
save()
if late:
    fail(late)
'''


FAKE_GIT = r'''#!/usr/bin/env python3
import os, pathlib, sys
if os.environ.get('FAKE_ANCESTRY_ERROR') and sys.argv[1:2] == ['merge-base']:
    sys.exit(128)
if sys.argv[1:2] == ['push']:
    gh = str(pathlib.Path(__file__).with_name('gh'))
    os.execv(gh, [gh, 'git', *sys.argv[1:]])
os.execv(os.environ['REAL_GIT'], ['git', *sys.argv[1:]])
'''


def sh(*cmd, cwd, env=None):
    print('fixture git stage: ' + json.dumps(cmd), file=sys.stderr, flush=True)
    try:
        return subprocess.run(cmd, cwd=cwd, check=True, text=True, capture_output=True, env=env).stdout.strip()
    except subprocess.CalledProcessError as error:
        error.add_note(f'fixture command stdout:\n{error.stdout}\nstderr:\n{error.stderr}')
        raise


def build_dist(dist, source, marker):
    dist.mkdir()
    sums = []
    for target in TARGETS:
        for prefix in ('fractal', 'smalltalk'):
            package = f'{prefix}-{target}'
            with tarfile.open(dist / f'{package}.tar.gz', 'w:gz') as archive:
                def add(name, data=b'', mode=0o755, link=None):
                    info = tarfile.TarInfo(f'{package}/{name}')
                    info.mode = mode
                    if link:
                        info.type, info.linkname = tarfile.SYMTYPE, link
                        archive.addfile(info)
                    else:
                        info.size = len(data)
                        archive.addfile(info, io.BytesIO(data))
                add('BUILD.json', json.dumps({'source': source, 'target': target, 'pty_revision': 'pty', 'tag': ''}).encode(), 0o644)
                add('bin/fractal', marker.encode())
                add('bin/pty', b'pty')
                add('share/fractal-web/index.html', b'web', 0o644)
                add('bin/st', link='fractal')
                add('bin/st3', link='fractal')
                add('install.sh'); add('install-macos.py'); add('macos-installation.md', b'', 0o644)
            digest = hashlib.sha256((dist / f'{package}.tar.gz').read_bytes()).hexdigest()
            line = f'{digest}  {package}.tar.gz\n'
            (dist / f'{package}.tar.gz.sha256').write_text(line)
            sums.append(line)
    (dist / 'SHA256SUMS').write_text(''.join(sums))
    (dist / 'RELEASE.json').write_text('{}')
    (dist / 'RELEASE-NOTES.md').write_text('the long guide is not an edge asset')


with tempfile.TemporaryDirectory() as temporary:
    root = Path(temporary)
    checkout = root / 'checkout'
    (checkout / 'scripts').mkdir(parents=True)
    for name in ('release-fractal-edge', 'release-fractal-manifest.py', 'release_gh.py'):
        shutil.copy(repo / 'scripts' / name, checkout / 'scripts' / name)
    sh('git', 'init', '-q', '-b', 'main', cwd=checkout)
    # Fixture history must not depend on account signing or identity hooks.
    sh('git', 'config', '--local', 'commit.gpgsign', 'false', cwd=checkout)
    sh('git', 'config', '--local', 'tag.gpgsign', 'false', cwd=checkout)
    sh('git', 'config', '--local', 'core.hooksPath', '/dev/null', cwd=checkout)
    sh('git', 'config', 'user.name', 'Fixture', cwd=checkout)
    sh('git', 'config', 'user.email', 'fixture@example.invalid', cwd=checkout)
    commits = []
    for index, subject in enumerate(['first change', 'second change', 'third change']):
        (checkout / 'file').write_text(str(index))
        sh('git', 'add', '.', cwd=checkout)
        sh('git', 'commit', '-q', '-m', subject, cwd=checkout)
        commits.append(sh('git', 'rev-parse', 'HEAD', cwd=checkout))
    sh('git', 'remote', 'add', 'origin', str(checkout), cwd=checkout)
    tree = sh('git', 'rev-parse', 'HEAD^{tree}', cwd=checkout)
    divergent = sh('git', 'commit-tree', tree, '-m', 'divergent root', cwd=checkout)
    tools = root / 'tools'
    tools.mkdir()
    (tools / 'gh').write_text(FAKE_GH)
    (tools / 'gh').chmod(0o755)
    (tools / 'git').write_text(FAKE_GIT)
    (tools / 'git').chmod(0o755)
    state = root / 'state.json'
    state.write_text(json.dumps({'release': None, 'tag': None, 'calls': []}))
    env = dict(os.environ, PATH=f'{tools}:{os.environ["PATH"]}', FAKE_GH_STATE=str(state), GH_REPO='example/project',
               RELEASE_GH_RETRY_DELAYS='0,0,0', REAL_GIT=shutil.which('git'), GH_TOKEN='test-token')

    def publish(source, marker, *extra):
        dist = root / f'dist-{marker}'
        build_dist(dist, source, marker)
        return subprocess.run(['python3', 'scripts/release-fractal-edge', '--source', source, '--dist', str(dist),
                               '--run-url', 'https://example.invalid/run/1', *extra],
                              cwd=checkout, env=env, text=True, capture_output=True)

    def current():
        return json.loads(state.read_text())

    def checkout_tags():
        # A fresh Actions checkout carries the remote tag.
        tag = current()['tag']
        if tag:
            sh('git', 'tag', '-f', 'edge', tag, cwd=checkout)

    # The first run creates one pre-release at the newest commit, with the newest commits listed.
    done = publish(commits[0], 'one')
    assert done.returncode == 0, done
    first = current()
    assert first['tag'] == commits[0] and first['release']['prerelease'] and not first['release']['latest'], first
    assert 'First edge release' in first['release']['notes'] and 'first change' in first['release']['notes']
    assert f'`{commits[0]}`' in first['release']['notes'] and 'example.invalid/run/1' in first['release']['notes']
    assert sorted(first['release']['assets']) == sorted(
        [f'{p}-{t}.tar.gz{s}' for p in ('fractal', 'smalltalk') for t in TARGETS for s in ('', '.sha256')] + ['SHA256SUMS', 'RELEASE.json']), first
    assert 'RELEASE-NOTES.md' not in first['release']['assets']

    # A later commit replaces the assets in place, moves the tag and lists only the new commits.
    checkout_tags()
    done = publish(commits[2], 'three')
    assert done.returncode == 0, done
    second = current()
    assert second['tag'] == commits[2] and len(second['release']['assets']) == 10, second
    notes = second['release']['notes']
    assert 'second change' in notes and 'third change' in notes and 'first change' not in notes, notes
    assert sum(1 for call in second['calls'] if call[:2] == ['release', 'create']) == 1, 'one release, not one per commit'
    updates = second['calls'][len(first['calls']):]
    uploads = [(index, [Path(path).name for path in call[call.index('--clobber') + 1:]])
               for index, call in enumerate(updates) if call[:2] == ['release', 'upload']]
    moved = next(index for index, call in enumerate(updates) if call[:2] == ['git', 'push'])
    assert len(uploads) == 12 and moved < uploads[0][0] < uploads[1][0] < uploads[2][0], uploads
    assert uploads[1][1] == [commits[2] + '-STAGING-LEDGER.sha256'], uploads
    assert uploads[-2][1] == ['SHA256SUMS'] and uploads[-1][1] == ['RELEASE.json'], uploads
    assert all(len(files) == 1 for _, files in uploads[1:]), uploads
    assert {files[0] for _, files in uploads[2:-2]} == set(first['release']['assets']) - {'SHA256SUMS', 'RELEASE.json'}, uploads
    print('passed: test_staging_ledger_uploaded_alone_after_complete_set_after_tag')
    print('passed: test_manifest_uploaded_alone_after_all_aliases_and_checksums')
    pushes = [call for call in second['calls'] if call[:2] == ['git', 'push']]
    assert pushes[0][2] == '--force-with-lease=refs/tags/edge:'
    assert pushes[-1][2] == f'--force-with-lease=refs/tags/edge:{commits[0]}'

    # Rerunning the same commit is harmless; a run for an older commit changes nothing at all.
    checkout_tags()
    assert publish(commits[2], 'three-again').returncode == 0
    assert sum(call[:2] == ['git', 'push'] for call in current()['calls']) == len(pushes), 'same source skips push'
    before = current()
    checkout_tags()
    done = publish(commits[1], 'two')
    assert done.returncode == 0 and 'newer' in done.stdout, done
    after = current()
    assert after['tag'] == commits[2] and after['release']['notes'] == before['release']['notes'], after
    assert all(call[:2] in (['release', 'view'], ['release', 'download']) or
               (call[0] == 'api' and 'PATCH' not in call)
               for call in after['calls'][len(before['calls']):]), 'an older commit must not mutate the release'

    # The refused stale run leaves release bytes and notes untouched.
    assert before['release'] == after['release']

    # Corrupt or mismatched archives are refused before gh is called.
    calls = len(current()['calls'])
    dist = root / 'dist-bad'
    build_dist(dist, commits[2], 'bad')
    (dist / 'SHA256SUMS').write_text('0' * 64 + f'  smalltalk-{TARGETS[0]}.tar.gz\n' + (dist / 'SHA256SUMS').read_text().splitlines()[1] + '\n')
    done = subprocess.run(['python3', 'scripts/release-fractal-edge', '--source', commits[2], '--dist', str(dist)],
                          cwd=checkout, env=env, text=True, capture_output=True)
    assert done.returncode != 0 and len(current()['calls']) == calls, done
    build_dist(root / 'dist-wrong-source', commits[0], 'wrong')
    done = subprocess.run(['python3', 'scripts/release-fractal-edge', '--source', commits[2], '--dist', str(root / 'dist-wrong-source')],
                          cwd=checkout, env=env, text=True, capture_output=True)
    assert done.returncode != 0 and len(current()['calls']) == calls, done

    # A checksummed compatibility copy with different payload bytes is not publishable.
    mismatch = root / 'dist-legacy-mismatch'
    build_dist(mismatch, commits[2], 'canonical')
    other = root / 'dist-other'
    build_dist(other, commits[2], 'different')
    name = f'smalltalk-{TARGETS[0]}.tar.gz'
    shutil.copy(other / name, mismatch / name)
    lines = (mismatch / 'SHA256SUMS').read_text().splitlines()
    digest = hashlib.sha256((mismatch / name).read_bytes()).hexdigest()
    (mismatch / 'SHA256SUMS').write_text('\n'.join(
        f'{digest}  {name}' if line.endswith('  ' + name) else line for line in lines) + '\n')
    done = subprocess.run(['python3', 'scripts/release-fractal-edge', '--source', commits[2], '--dist', str(mismatch)],
                          cwd=checkout, env=env, text=True, capture_output=True)
    assert done.returncode != 0 and len(current()['calls']) == calls, done

    # A dry run for a newer source prints the notes but performs only reads.
    dry_state = current()
    dry_state['tag'] = commits[0]
    dry_state['release']['assets']['RELEASE.json'] = json.dumps({'source': commits[0]})
    state.write_text(json.dumps(dry_state))
    checkout_tags()
    done = publish(commits[2], 'dry', '--dry-run')
    assert done.returncode == 0 and 'dry run' in done.stdout, done
    assert current()['release'] == dry_state['release'] and current()['tag'] == commits[0]

    # GitHub answers 504 or times out now and then (#4606). Each case starts from no edge release.
    timeout = 'HTTP 504: We couldn\'t respond to your request in time. (https://api.github.com/repos/example/project/releases)'
    def from_scratch(*failures, release=None, tag=None):
        state.write_text(json.dumps({'release': release, 'tag': tag, 'calls': [], 'fail': [
            {'match': match, 'after': after, 'times': times, 'message': message}
            for match, after, times, message in failures]}))
        return publish(commits[2], f'retry-{len(list(root.glob("dist-retry-*")))}')
    def calls(prefix):
        return sum(1 for call in current()['calls'] if call[:len(prefix)] == prefix)
    def complete():
        release = current()
        return release['tag'] == commits[2] and len(release['release']['assets']) == 10

    done = from_scratch(tag=commits[0])
    assert done.returncode == 0 and complete(), (done, current())
    assert calls(['git', 'push']) == 1
    recorded = current()['calls']
    moved = next(index for index, call in enumerate(recorded) if call[:2] == ['git', 'push'])
    staged = [index for index, call in enumerate(recorded)
              if call[:2] == ['release', 'upload'] and call[-1].endswith('STAGING-LEDGER.sha256')]
    fixed = [index for index, call in enumerate(recorded)
             if call[:2] == ['release', 'upload'] and Path(call[-1]).name in first['release']['assets']]
    assert staged and fixed and moved < staged[0] < min(fixed), recorded
    assert json.loads(current()['release']['assets']['RELEASE.json'])['source'] == commits[2]
    staged_assets = current()['assets_before_first_alias']
    ledger_name = commits[2] + '-STAGING-LEDGER.sha256'
    expected_names = {commits[2] + '-' + name for name in first['release']['assets']}
    assert set(staged_assets) == expected_names | {ledger_name}, staged_assets
    ledger_entries = [line.split('  ', 1) for line in staged_assets[ledger_name].splitlines()]
    assert len(ledger_entries) == len(expected_names)
    assert {commits[2] + '-' + name for _, name in ledger_entries} == expected_names
    for digest, name in ledger_entries:
        assert hashlib.sha256(staged_assets[commits[2] + '-' + name].encode('latin1')).hexdigest() == digest
    print('passed: test_complete_staged_set_and_ledger_digests_before_first_fixed_alias')
    manifest_writes = [index for index in fixed if Path(recorded[index][-1]).name == 'RELEASE.json']
    assert manifest_writes == [max(fixed)], recorded
    final_ref_reads = [index for index, call in enumerate(recorded)
                       if call == ['api', 'repos/example/project/git/ref/tags/edge']]
    assert moved < manifest_writes[0] < final_ref_reads[-1], recorded
    print('passed: test_missing_release_with_retained_older_tag_converges')
    for retained, candidate, label in ((divergent, commits[2], 'divergent'),
                                       (commits[2], commits[1], 'newer')):
        state.write_text(json.dumps({'release': None, 'tag': retained, 'calls': []}))
        done = publish(candidate, 'retained-' + label)
        assert done.returncode == 0 and current()['release'] is None and current()['tag'] == retained, (done, current())
        assert calls(['release', 'create']) == 0 and calls(['git', 'push']) == 0
        print('passed: test_missing_release_with_retained_' + label + '_tag_refused')
    state.write_text(json.dumps({'release': None, 'tag': commits[0], 'calls': []}))
    env['FAKE_ANCESTRY_ERROR'] = '1'
    done = publish(commits[2], 'retained-lookup-error')
    del env['FAKE_ANCESTRY_ERROR']
    assert done.returncode != 0 and current()['release'] is None and current()['tag'] == commits[0]
    assert calls(['release', 'create']) == 0
    print('passed: test_missing_release_with_retained_tag_lookup_error_refused')

    # A create that made the release and then timed out continues from it, never "already exists".
    done = from_scratch((['release', 'create'], True, 1, timeout))
    assert done.returncode == 0 and complete() and calls(['release', 'create']) == 1, (done, current())
    assert 'took effect before it failed' in done.stderr, done.stderr
    # A create that timed out before it took effect is made again.
    done = from_scratch((['release', 'create'], False, 1, timeout))
    assert done.returncode == 0 and complete() and calls(['release', 'create']) == 2, (done, current())
    # A read that times out is read again, not taken for "no release".
    done = from_scratch((['release', 'view'], False, 1, 'Get "https://api.github.com/...": net/http: TLS handshake timeout'))
    assert done.returncode == 0 and complete(), (done, current())
    # Existing assets with an old annotated tag converge using the raw ref's lease.
    older = {'assets': {}, 'prerelease': True, 'latest': False, 'notes': '', 'title': 'older'}
    # A newer manifest fences out a stale run even when the edge tag is older.
    split = json.loads(json.dumps(first['release']))
    split['assets']['RELEASE.json'] = json.dumps({'source': commits[2]})
    done = from_scratch(release=split, tag=commits[0])
    assert done.returncode == 0 and complete(), (done, current())
    print('passed: test_split_state_converges_at_equal_manifest_source')
    state.write_text(json.dumps({'release': split, 'tag': commits[0], 'calls': []}))
    done = publish(commits[1], 'split-stale')
    assert done.returncode == 0 and current()['release'] == split and current()['tag'] == commits[0], (done, current())
    assert not any(call[:2] in (['git', 'push'], ['release', 'upload']) for call in current()['calls'])
    print('passed: test_stale_rerun_refused_by_newer_manifest')

    # A failed leased push never changes release assets or manifest.
    done = from_scratch((['git', 'push'], False, 1, 'stale info: lease rejected'),
                        release=first['release'], tag=commits[0])
    assert done.returncode != 0 and current()['tag'] == commits[0], (done, current())
    for name, value in first['release']['assets'].items():
        assert current()['release']['assets'][name] == value, name
    assert json.loads(current()['release']['assets']['RELEASE.json'])['source'] == current()['tag']
    print('passed: test_tag_move_failure_preserves_manifest_and_aliases')
    # A real interruption after the tag moves leaves the old manifest, then repairs.
    done = from_scratch((['release', 'upload'], False, 1, 'HTTP 422: interrupted upload after tag move'),
                        release=first['release'], tag=commits[0])
    assert done.returncode != 0 and current()['tag'] == commits[2], (done, current())
    assert current()['release']['assets']['RELEASE.json'] == first['release']['assets']['RELEASE.json']
    done = publish(commits[2], 'tag-ahead-repair')
    assert done.returncode == 0 and complete(), (done, current())
    print('passed: test_tag_moved_upload_interrupted_same_source_repairs_complete_set')

    for operation, label in (('delete-asset', 'after_manifest_before_cleanup'),
                             ('edit', 'after_cleanup_before_notes')):
        done = from_scratch((['release', operation], False, 1, 'HTTP 422: interrupted finalization'),
                            release=first['release'], tag=commits[0])
        assert done.returncode != 0 and current()['tag'] == commits[2], (done, current())
        assert json.loads(current()['release']['assets']['RELEASE.json'])['source'] == commits[2]
        done = publish(commits[2], label)
        assert done.returncode == 0 and complete(), (done, current())
        assert f'Exact source: `{commits[2]}`.' in current()['release']['notes']
        verified = current()['release']
        done = publish(commits[2], label + '-verified')
        assert done.returncode == 0 and complete() and current()['release']['notes'] == verified['notes']
        print('passed: test_equal_source_repairs_' + label)

    for suffix, label in (('', 'alias'), ('.sha256', 'sidecar')):
        # Keep a complete staging unit, then interrupt an alias clobber on a same-source retry.
        done = from_scratch((['release', 'delete-asset'], False, 1, 'HTTP 422: interrupted cleanup'),
                            release=first['release'], tag=commits[0])
        assert done.returncode != 0
        split = current()
        split['fail'] = []
        split['release']['assets'][f'fractal-{TARGETS[0]}.tar.gz{suffix}'] = 'wrong'
        name = f'fractal-{TARGETS[0]}.tar.gz{suffix}'
        split['interrupt_alias'] = name
        state.write_text(json.dumps(split))
        done = publish(commits[2], 'split-interrupt-' + label)
        assert done.returncode != 0 and current()['tag'] == commits[2], (done, current())
        assert name not in current()['release']['assets']
        expected = {asset: value for asset, value in current()['release']['assets'].items()
                    if asset.startswith(commits[2] + '-') and not asset.endswith('STAGING-LEDGER.sha256')}
        done = publish(commits[2], 'split-repair-' + label)
        assert done.returncode == 0 and complete(), (done, current())
        for staged_name, value in expected.items():
            assert current()['release']['assets'][staged_name[len(commits[2]) + 1:]] == value
        print('passed: test_split_repair_restores_missing_' + label)

    # With no staged copy left, equal-source validation must restage validated dist
    # and fix a present-but-corrupt alias rather than trusting the source markers.
    damaged = current()
    damaged['release']['assets'][f'fractal-{TARGETS[0]}.tar.gz'] = 'corrupt'
    damaged['release']['assets']['SHA256SUMS'] = 'corrupt'
    state.write_text(json.dumps(damaged))
    done = publish(commits[2], 'restage-corrupt')
    assert done.returncode == 0 and complete(), (done, current())
    assert current()['release']['assets'][f'fractal-{TARGETS[0]}.tar.gz'] != 'corrupt'
    assert current()['release']['assets']['SHA256SUMS'] != 'corrupt'
    print('passed: test_equal_source_restages_and_repairs_wrong_digest')

    for damage in ('missing-file', 'wrong-digest', 'missing-ledger', 'invalid-ledger'):
        # Build A staged successfully, but its unit is now partial or corrupt.
        # Build B has the same source and deliberately different archive bytes.
        done = from_scratch((['release', 'delete-asset'], False, 1, 'HTTP 422: interrupted cleanup'),
                            release=first['release'], tag=commits[0])
        assert done.returncode != 0
        partial = current()
        partial['fail'] = []
        assets = partial['release']['assets']
        staged_archive = commits[2] + f'-fractal-{TARGETS[0]}.tar.gz'
        ledger = commits[2] + '-STAGING-LEDGER.sha256'
        if damage == 'missing-file':
            del assets[staged_archive]
        elif damage == 'wrong-digest':
            assets[staged_archive] = 'corrupt A'
        elif damage == 'missing-ledger':
            del assets[ledger]
        else:
            assets[ledger] = 'invalid ledger'
        state.write_text(json.dumps(partial))
        marker = 'whole-build-b-' + damage
        done = publish(commits[2], marker)
        assert done.returncode == 0 and complete(), (done, current())
        for name, value in current()['release']['assets'].items():
            assert value.encode('latin1') == (root / f'dist-{marker}' / name).read_bytes(), name
        for line in current()['release']['assets']['SHA256SUMS'].splitlines():
            digest, name = line.split('  ', 1)
            assert hashlib.sha256(current()['release']['assets'][name].encode('latin1')).hexdigest() == digest
        print('passed: test_same_source_build_b_replaces_whole_' + damage + '_staging')

    state.write_text(json.dumps({'release': first['release'], 'tag': commits[0], 'calls': []}))
    done = publish(divergent, 'divergent')
    assert done.returncode == 0 and 'divergent' in done.stdout
    assert current()['release'] == first['release'] and current()['tag'] == commits[0]
    print('passed: test_divergent_source_refused')
    env['FAKE_ANCESTRY_ERROR'] = '1'
    done = publish(commits[2], 'lookup-error')
    del env['FAKE_ANCESTRY_ERROR']
    assert done.returncode != 0 and 'ancestry lookup failed' in done.stderr, done
    assert current()['release'] == first['release'] and current()['tag'] == commits[0]
    print('passed: test_ancestry_lookup_error_refused')
    absent = json.loads(json.dumps(first['release']))
    absent['assets']['RELEASE.json'] = json.dumps({'source': 'a' * 40})
    state.write_text(json.dumps({'release': absent, 'tag': commits[0], 'calls': []}))
    done = publish(commits[2], 'fetch-error')
    assert done.returncode != 0 and 'fetch' in done.stderr, done
    assert current()['release'] == absent and current()['tag'] == commits[0]
    print('passed: test_missing_history_fetch_failure_refused')
    state.write_text(json.dumps({'release': older, 'tag': commits[1],
                                'tag_object': 'a' * 40, 'calls': []}))
    done = publish(commits[2], 'annotated')
    assert done.returncode == 0 and complete() and calls(['git', 'push']) == 1, (done, current())
    push = next(call for call in current()['calls'] if call[:2] == ['git', 'push'])
    assert push[2] == '--force-with-lease=refs/tags/edge:' + 'a' * 40, push
    # A rejected lease stops before renaming; never force over a concurrent tag update.
    done = from_scratch((['git', 'push'], False, 1, 'stale info: lease rejected'),
                        release=older, tag=commits[1])
    assert done.returncode != 0 and calls(['git', 'push']) == 1, (done, current())
    assert current()['tag'] == commits[1] and calls(['release', 'edit']) == 0, current()
    assert calls(['release', 'upload']) == 0 and calls(['release', 'create']) == 0, current()
    # Anything but a 5xx or a timeout fails at once.
    done = from_scratch((['release', 'edit'], False, 1, 'HTTP 422: Validation Failed'))
    assert done.returncode != 0 and calls(['release', 'edit']) == 1 and '422' in done.stderr, (done, current())
    # A 504 that does not clear fails after the retries: one call and three more.
    done = from_scratch((['release', 'edit'], False, 99, timeout))
    assert done.returncode != 0 and calls(['release', 'edit']) == 4 and '504' in done.stderr, (done, current())
print('Edge release creation, replacement, ordering, stale assets, retries and verification passed')
