#!/usr/bin/env bash
# One pull of the evidence log, as main has it (scripts/evidence-log.service, every 2 minutes from scripts/evidence-log.timer).
# The script and the verifier it loads are read from origin/main in the bare repository this host keeps, never a checkout's copy.
# The signer (~/.config/evidence-log/signer.json, a JSON argv that signs stdin; `st sekrets` once the log key has a profile) and
# the log key list (~/.config/evidence-log/log-keys, until main pins .st/evidence-log-key) are this host's configuration.
# EVIDENCE_LOG_FLAGS adds --publish and, once GC writes its lines first, --restore.
set -euo pipefail
state=${EVIDENCE_LOG_STATE:-$HOME/.local/state/evidence-log}
remote=${EVIDENCE_LOG_REMOTE:-https://github.com/compoundingtech/fractal.git}
config=${EVIDENCE_LOG_CONFIG:-$HOME/.config/evidence-log}
repo=$state/repo.git
mkdir -p "$state"
if [ ! -d "$repo" ]; then
  git init -q --bare "$repo"
  git -C "$repo" config gc.auto 0
  git -C "$repo" remote add origin "$remote"
fi
# Apply to existing repositories too. The default fsync method persists objects before their references.
git -C "$repo" config core.fsync objects,reference
tools=$(mktemp -d)
trap 'rm -rf "$tools"' EXIT
# Fetch the tools using only main's refs. Git's fetch connectivity check otherwise reads even an unrelated damaged log ref,
# failing before the tool can repair it. Share the object directory and seed main so this remains an incremental fetch.
repo=$(cd "$repo" && pwd)
git init -q --bare "$tools/main.git"
bootstrap_git() {
  GIT_OBJECT_DIRECTORY="$repo/objects" git -C "$repo" --git-dir="$tools/main.git" -c core.hooksPath=/dev/null -c core.fsync=objects,reference \
    -c maintenance.auto=false -c gc.auto=0 "$@"
}
if main=$(git -C "$repo" rev-parse --verify refs/remotes/origin/main 2>/dev/null); then
  bootstrap_git update-ref refs/remotes/origin/main "$main"
fi
bootstrap_git fetch -q --no-tags "$(git -C "$repo" remote get-url origin)" +refs/heads/main:refs/remotes/origin/main
git -C "$repo" update-ref refs/remotes/origin/main "$(bootstrap_git rev-parse refs/remotes/origin/main)"
for tool in evidence-log evidence-verify; do
  git -C "$repo" show "origin/main:scripts/$tool" > "$tools/$tool"
done
keys=$config/log-keys
# arn:lmig:smalltalk:2026-10-27-dot-fractal-config — only genuine absence permits the host-local key fallback.
key_path=.fractal/evidence-log-key
entry=$(git -C "$repo" ls-tree --full-tree -z origin/main -- "$key_path" | tr '\0' '\n')
if [ -z "$entry" ]; then
  key_path=.st/evidence-log-key
  entry=$(git -C "$repo" ls-tree --full-tree -z origin/main -- "$key_path" | tr '\0' '\n')
fi
if [ -n "$entry" ]; then
  git -C "$repo" show "origin/main:$key_path" > "$tools/log-keys"
  keys=$tools/log-keys
fi
# shellcheck disable=SC2086
python3 -I "$tools/evidence-log" "${1:-pull}" --repo "$repo" --remote origin --main origin/main \
  --signer "$(cat "$config/signer.json")" --log-keys "$keys" ${EVIDENCE_LOG_FLAGS:-} "${@:2}"
