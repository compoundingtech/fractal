#!/usr/bin/env bash
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
fractal_sccache_port=${FRACTAL_SCCACHE_READ_SERVER_PORT-${ST_SCCACHE_READ_SERVER_PORT-}}
# Source in a devShell. Only an owner-provisioned, read-only remote route can opt in.
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
if [[ -n "${FRACTAL_SCCACHE_READ_ENDPOINT-${ST_SCCACHE_READ_ENDPOINT:-}}" ]]; then
  if [[ -n "${SCCACHE_CONF:-}${SCCACHE_WEBDAV_ENDPOINT:-}${SCCACHE_MULTILEVEL_CHAIN:-}${SCCACHE_SERVER_UDS:-}" ]]; then
    echo 'shared cache opt-in conflicts with an existing cache configuration' >&2
    return 2
  fi
  if [[ ! "${SCCACHE_SERVER_PORT:-4226}" =~ ^[0-9]+$ ]]; then
    echo 'existing server port must be numeric' >&2
    return 2
  fi
  # arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
  if [[ ! "$fractal_sccache_port" =~ ^[0-9]+$ ]] ||
      [[ ${#fractal_sccache_port} -gt 5 ]] ||
      (( 10#$fractal_sccache_port < 1024 || 10#$fractal_sccache_port > 65535 ||
         10#$fractal_sccache_port == 10#${SCCACHE_SERVER_PORT:-4226} )); then
    echo 'shared cache opt-in needs a separate unprivileged server port' >&2
    return 2
  fi
  # Client mode is defense in depth; the service credential must also deny writes.
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
  export SCCACHE_WEBDAV_ENDPOINT="${FRACTAL_SCCACHE_READ_ENDPOINT-${ST_SCCACHE_READ_ENDPOINT-}}"
  export SCCACHE_WEBDAV_RW_MODE=READ_ONLY
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
  export SCCACHE_SERVER_PORT="${FRACTAL_SCCACHE_READ_SERVER_PORT-${ST_SCCACHE_READ_SERVER_PORT-}}"
fi
