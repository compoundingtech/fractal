#!/usr/bin/env python3
"""scripts/ci-sparse-tree: only the declared inputs are copied, as one commit; a bad declaration is an error."""
import json
import os
from pathlib import Path
import re
import subprocess
import tempfile
import unittest

ROOT = Path(__file__).resolve().parent.parent
TOOL = ROOT / 'scripts/ci-sparse-tree'
GIT_ENV = dict(os.environ, GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_SYSTEM='/dev/null', GIT_AUTHOR_NAME='t', GIT_AUTHOR_EMAIL='t@example.invalid',
               GIT_COMMITTER_NAME='t', GIT_COMMITTER_EMAIL='t@example.invalid')


class SparseTree(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        self.repo = Path(self.tmp.name) / 'repo'
        self.repo.mkdir()
        files = {'scripts/tool': '#!/bin/sh\n', 'scripts/sub/data': 'x', 'docs/a.md': 'a', 'docs/b.md': 'b', 'crates/c/src/lib.rs': 'fn main() {}', 'top.txt': 't'}
        for name, content in files.items():
            path = self.repo / name
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(content)
        (self.repo / 'scripts/tool').chmod(0o755)
        os.symlink('tool', self.repo / 'scripts/alias')
        self.policy(['scripts', 'docs/a.md', 'top.txt'])
        subprocess.run(['git', '-C', str(self.repo), 'init', '-q', '-b', 'main'], check=True, env=GIT_ENV)
        subprocess.run(['git', '-C', str(self.repo), 'add', '-A'], check=True, env=GIT_ENV)
        subprocess.run(['git', '-C', str(self.repo), 'commit', '-q', '-m', 'all'], check=True, env=GIT_ENV)

    def policy(self, inputs):
        (self.repo / '.st').mkdir(exist_ok=True)
        (self.repo / '.st/evidence-skip-policy.json').write_text(json.dumps({'version': 1, 'checks': {'demo': {'inputs': inputs}, 'bare': {}}}))

    def run_tool(self, check='demo', into='sparse'):
        return subprocess.run([str(TOOL), '--repo', str(self.repo), '--check', check, '--into', str(Path(self.tmp.name) / into)],
                              capture_output=True, text=True, env=GIT_ENV)

    def test_only_the_declared_inputs_are_copied_with_their_modes_as_one_commit(self):
        subprocess.run(['git', '-C', str(self.repo), 'add', '-A', '-f'], check=True, env=GIT_ENV)
        done = self.run_tool()
        self.assertEqual(done.returncode, 0, done.stderr)
        sparse = Path(self.tmp.name) / 'sparse'
        listing = subprocess.run(['git', '-C', str(sparse), 'ls-files'], capture_output=True, text=True, check=True).stdout.split()
        self.assertEqual(sorted(listing), ['docs/a.md', 'scripts/alias', 'scripts/sub/data', 'scripts/tool', 'top.txt'])
        self.assertTrue(os.access(sparse / 'scripts/tool', os.X_OK))
        self.assertTrue((sparse / 'scripts/alias').is_symlink())
        self.assertFalse((sparse / 'docs/b.md').exists())
        self.assertFalse((sparse / 'crates').exists())
        count = subprocess.run(['git', '-C', str(sparse), 'rev-list', '--count', 'HEAD'], capture_output=True, text=True, check=True).stdout.strip()
        self.assertEqual(count, '1')
        status = subprocess.run(['git', '-C', str(sparse), 'status', '--porcelain'], capture_output=True, text=True, check=True).stdout
        self.assertEqual(status, '')

    def test_an_untracked_file_is_never_copied(self):
        (self.repo / 'scripts/untracked').write_text('x')
        self.assertEqual(self.run_tool().returncode, 0)
        self.assertFalse((Path(self.tmp.name) / 'sparse/scripts/untracked').exists())

    def test_an_input_that_matches_no_tracked_file_is_an_error(self):
        self.policy(['scripts', 'docs/gone.md'])
        done = self.run_tool()
        self.assertNotEqual(done.returncode, 0)
        self.assertIn('docs/gone.md', done.stderr)

    def test_a_check_without_inputs_or_policy_entry_is_an_error(self):
        self.assertIn('declares no inputs', self.run_tool('bare').stderr)
        self.assertIn("no check 'nope'", self.run_tool('nope').stderr)

    def test_a_directory_that_is_not_empty_is_refused(self):
        target = Path(self.tmp.name) / 'full'
        target.mkdir()
        (target / 'x').write_text('x')
        self.assertIn('is not empty', self.run_tool(into='full').stderr)

    def test_the_real_policy_names_inputs_that_exist_for_ci_script_tests(self):
        done = subprocess.run([str(TOOL), '--repo', str(ROOT), '--check', 'ci-script-tests', '--into', str(Path(self.tmp.name) / 'real')],
                              capture_output=True, text=True, env=GIT_ENV)
        self.assertEqual(done.returncode, 0, done.stderr)

    def test_each_self_test_runs_in_exactly_one_of_the_two_checks_and_exists(self):
        def listed(script):
            text = (ROOT / 'scripts' / script).read_text()
            block = text[text.index('parallel_tests \\\n'):]
            names = []
            for line in block.splitlines()[1:]:
                if not line.startswith('  '):
                    break
                names += line.replace('\\', ' ').split()
            return names
        narrow, wide = listed('ci-script-tests'), listed('ci-genie-freshness')
        self.assertEqual(len(narrow), len(set(narrow)), 'a test is listed twice in ci-script-tests')
        self.assertEqual(len(wide), len(set(wide)), 'a test is listed twice in ci-genie-freshness')
        self.assertEqual(sorted(set(narrow) & set(wide)), [], 'a test runs in both checks')
        for name in narrow + wide:
            self.assertTrue((ROOT / 'scripts' / name).is_file(), name)
        # The tests that read crates/, apps/ or the whole tree cannot run in the sparse copy: they stay with the whole-tree key.
        for name in ('evidence-verify-test', 'check-ci-test-paths', 'ci-fractal-web-test', 'rust-test-keys-test'):
            self.assertIn(name, wide)
            self.assertNotIn(name, narrow)

    def test_a_linked_untracked_directory_is_available_but_not_committed(self):
        (self.repo / 'repos/member').mkdir(parents=True)
        (self.repo / 'repos/member/lib.ts').write_text('export {}')
        target = Path(self.tmp.name) / 'linked'
        done = subprocess.run([str(TOOL), '--repo', str(self.repo), '--check', 'demo', '--into', str(target), '--link', 'repos', '--link', 'absent'],
                              capture_output=True, text=True, env=GIT_ENV)
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertTrue((target / 'repos/member/lib.ts').is_file())
        self.assertTrue((target / 'repos').is_symlink())
        tracked = subprocess.run(['git', '-C', str(target), 'ls-files'], capture_output=True, text=True, check=True).stdout
        self.assertNotIn('repos', tracked)
        self.assertFalse((target / 'absent').exists())


if __name__ == '__main__':
    unittest.main()
