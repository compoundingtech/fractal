#!/usr/bin/env bash
# Run Linux gate stages on this machine the way their CI jobs run them, for a note signed here (scripts/st-test, a lane in
# .st/required-lanes.json). Run inside the pinned dev shell: `nix develop -c bash scripts/ci-local STAGE...`.
#
#   scripts/ci-local mail-redelivery-canaries
#   scripts/ci-local tests clippy fleet-compat mail-redelivery-canaries      (what a linux-gate skip covers)
#   scripts/ci-local isolation-vm                                            (the VM tests: scripts/ci-local-isolation-vm)
#
# Each STAGE is a scripts/ci-linux stage, run in order; every stage runs even after one fails, and the exit status is the
# first failure's (0 when all passed). Before the stages it builds and installs the rendered hooks, as the CI job's
# test-archive setup does.
#
# The stages start daemons and harnesses, so they run with a home of their own: HOME and the XDG state, config, data and cache
# directories are a scratch directory that is removed afterwards, and no st, GitHub or SSH agent variable reaches them, so
# nothing they start can read or write this account's st state, harness configuration or credentials, and no PATH entry
# inside the account's st state (a seat's command recorder) stays. Two things are kept:
# the account's cargo and rustup homes (the dependency cache), and XDG_RUNTIME_DIR with the session bus, because the build
# admission shim queues there. RUNNER_TEMP and GITHUB_STEP_SUMMARY, which CI provides, are scratch files too.
set -euo pipefail
if [ "$#" -eq 0 ]; then
  echo "usage: scripts/ci-local STAGE..." >&2
  exit 2
fi
for stage in "$@"; do
  case "$stage" in
    tests|clippy|fleet-compat|mail-redelivery-canaries|isolation-vm) ;;
    *) echo "ci-local: stage $stage has no local lane" >&2; exit 2 ;;
  esac
done
# The scratch, and the stages' TMPDIR inside it, are on the account's disk as a CI runner's temporary directory is, never the
# caller's TMPDIR: a dev shell puts that under /tmp, which on some build hosts is a small tmpfs (tests that need tens of GB of
# scratch are refused there) or holds a stray /tmp/.git (tests that look for the enclosing repository find it).
# A CI runner's umask is 022: a host whose umask is 002 would make the stages' directories group-writable, and tests that
# refuse a directory others can change (the secrets gateway's) fail there.
umask 022
scratch_root=${CI_LOCAL_SCRATCH_ROOT:-$HOME/.cache/ci-local}
mkdir -p "$scratch_root"
chmod go-w "$scratch_root"
scratch=$(mktemp -d "$scratch_root/run.XXXXXX")
# The stages' TMPDIR is short and on disk: tests put Unix sockets several levels below it, a socket path is limited to 108 bytes, and
# under the scratch above (~/.cache/ci-local/run.XXXXXX/tmp) the daemons' sockets in the delivery-probe and seat tests no longer fit.
# /var/tmp is on disk on the build hosts (/tmp may be a small tmpfs); CI_LOCAL_TMP_ROOT names another root.
tmp=$(mktemp -d "${CI_LOCAL_TMP_ROOT:-/var/tmp}/cl.XXXXXX")
trap 'rm -rf "$scratch" "$tmp"' EXIT
cargo_home=${CARGO_HOME:-$HOME/.cargo}
rustup_home=${RUSTUP_HOME:-$HOME/.rustup}
# The cargo the stages build with is the dev shell's own, handed to the build admission shim as CARGO_REAL: CI_LOCAL_CARGO
# when set, otherwise the first cargo on PATH outside the account's home that is not the shim itself (the shim exports
# CARGO_SHIM_DEPTH). A build host's default real cargo may source a saved dev shell environment from another day, whose tools
# (an older pty) are not the tree's, and the stages would test those.
cargo_real=${CI_LOCAL_CARGO:-}
if [ -z "$cargo_real" ]; then
  IFS=':' read -r -a entries <<< "$PATH"
  for entry in "${entries[@]}"; do
    case "$entry" in ''|"$HOME"|"$HOME"/*) continue ;; esac
    [ -f "$entry/cargo" ] && [ -x "$entry/cargo" ] || continue
    if ! grep -q -a CARGO_SHIM_DEPTH "$entry/cargo"; then cargo_real="$entry/cargo"; break; fi
  done
fi
if [ -z "$cargo_real" ]; then
  echo "ci-local: no cargo executable of the dev shell on PATH (run it inside nix develop, or set CI_LOCAL_CARGO)" >&2
  exit 2
fi
while IFS='=' read -r -d '' name value; do
  case "$name" in
    # The dev shell's own test settings (flake.nix): the collector CI's OTLP export tests run against. Kept when they name a store
    # path, so a seat's own setting of the same name still leaves.
    ST2_OTELITE_BIN|ST3_OTELITE_BIN|FRACTAL_OTELITE_BIN) [[ "$value" == /nix/store/* && "$value" != *..* ]] || unset "$name" ;;
    ST_*|ST2_*|ST3_*|FRACTAL_*|GH_*|GITHUB_*|SSH_AUTH_SOCK|SSH_AGENT_PID|EVIDENCE_*|SEKRETS_*) unset "$name" ;;
  esac
done < <(env -0)
# A seat's PATH can start with directories inside the account's st state (a command recorder); those leave it too.
st_state=${XDG_STATE_HOME:-$HOME/.local/state}/st3
kept=()
IFS=':' read -r -a entries <<< "$PATH"
for entry in "${entries[@]}"; do
  case "$entry" in "$st_state"|"$st_state"/*) ;; *) kept+=("$entry") ;; esac
done
PATH=$(IFS=':'; printf '%s' "${kept[*]}")
export HOME="$scratch/home" CARGO_HOME="$cargo_home" RUSTUP_HOME="$rustup_home" CARGO_REAL="$cargo_real"
export XDG_STATE_HOME="$HOME/.local/state" XDG_CONFIG_HOME="$HOME/.config" XDG_DATA_HOME="$HOME/.local/share" XDG_CACHE_HOME="$HOME/.cache"
export RUNNER_TEMP="$scratch/runner" GITHUB_STEP_SUMMARY="$scratch/summary.md" TMPDIR="$tmp"
mkdir -p "$XDG_STATE_HOME" "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" "$RUNNER_TEMP" "$TMPDIR"
# A host may preload an allocator into every process (jemalloc); a CI runner preloads nothing, and tests that measure the allocator
# (malloc_trim) fail under one.
unset LD_PRELOAD
# The stages compile without sccache, as CI does when its cache is unavailable. A server started from here keeps this run's HOME and
# TMPDIR, which are removed at exit, and the account's builds share one server (127.0.0.1:4226): every compile through it then failed
# ("sccache: error: Failed to create temp dir") until it was stopped. The kept build directory (CARGO_TARGET_DIR) is the local cache.
unset RUSTC_WRAPPER CARGO_BUILD_RUSTC_WRAPPER
# Each test process gets a TMPDIR of its own under this run's (scripts/ci-test-tmpdir, as the cargo target runner nextest honours): on a
# shared TMPDIR, one test that left an empty `.git` at its top made every later test there see a repository that is not one (2026-10-23,
# 21 failures in one local run; the stray /tmp/.git on the build hosts came the same way). A CI runner is fresh for every job.
triple=${CI_LOCAL_TARGET_TRIPLE:-$( { rustc -vV 2>/dev/null || true; } | sed -n 's/^host: //p')}
if [ -n "$triple" ]; then
  export CI_TEST_TMPDIR_ROOT="$TMPDIR"
  export "CARGO_TARGET_$(printf '%s' "$triple" | tr '[:lower:]-' '[:upper:]_')_RUNNER=$(cd "$(dirname "$0")" && pwd)/ci-test-tmpdir"
else
  echo "ci-local: no rustc to name the host target; the tests share one TMPDIR" >&2
fi
touch "$GITHUB_STEP_SUMMARY"
# clippy's ratchet compares with the base, as CI compares with the event's base: CLIPPY_BASE_SHA when given (scripts/st-test
# gives the base it just fetched and records it in the note), otherwise main as fetched now, never a local ref that may be old.
if [[ " $* " == *" clippy "* && -z "${CLIPPY_BASE_SHA:-}" ]]; then
  if ! git fetch -q --no-tags origin main || ! CLIPPY_BASE_SHA=$(git rev-parse --verify --quiet 'FETCH_HEAD^{commit}'); then
    echo "ci-local: could not fetch main for clippy's base; set CLIPPY_BASE_SHA" >&2
    exit 2
  fi
fi
if [[ -n "${CLIPPY_BASE_SHA:-}" ]] && ! [[ "$CLIPPY_BASE_SHA" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]]; then
  echo "ci-local: CLIPPY_BASE_SHA must be a full commit id" >&2
  exit 2
fi
export CLIPPY_BASE_SHA
# The tests stage needs what CI's test-build job prepares for it: the provider components the resource-provider tests load,
# and the previous release the messaging compatibility tests run against.
if [[ " $* " == *" tests "* ]]; then
  system=$(nix eval --impure --raw --expr builtins.currentSystem)
  components=$(nix build ".#checks.$system.provider-components" --no-link --print-out-paths)
  for provider in GITHUB_ISSUE GITHUB_PR PTY_STATS VISTA; do
    wasm=$(printf '%s' "$provider" | tr '[:upper:]' '[:lower:]')
    export "ST2_${provider}_COMPONENT=$components/share/st2/providers/st2_${wasm}_component.component.wasm"
  done
  compat=$(timeout 10m bash scripts/messaging-compat-binary)
  export FRACTAL_MESSAGING_COMPAT_BIN="$compat" ST3_MESSAGING_COMPAT_BIN="$compat"
fi
cargo build --locked -p fractal-drivers --bin ci-hooks-install
bash scripts/ci-install-built-hooks
# A build host is shared and test binaries run outside the build admission gate: the stages' tests run 6 at a time unless
# CI_TEST_THREADS says otherwise (CI's runners use 8 on a machine of their own), at low CPU and IO priority.
export CI_TEST_THREADS=${CI_TEST_THREADS:-6}
low=()
if command -v ionice >/dev/null 2>&1; then low+=(ionice -c 3); fi
if command -v nice >/dev/null 2>&1; then low+=(nice -n 10); fi
status=0
for stage in "$@"; do
  code=0
  if [ "$stage" = isolation-vm ]; then
    "${low[@]}" bash scripts/ci-local-isolation-vm || code=$?
  else
    "${low[@]}" bash scripts/ci-linux "$stage" || code=$?
  fi
  echo "ci-local: $stage exit $code"
  if [ "$status" -eq 0 ]; then status=$code; fi
done
exit "$status"
