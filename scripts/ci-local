#!/usr/bin/env bash
# Run Linux gate stages on this machine the way their CI jobs run them, for a note signed here (scripts/fractal-test, a lane in
# .st/required-lanes.json). Run inside the pinned dev shell: `nix develop -c bash scripts/ci-local STAGE...`.
#
#   scripts/ci-local mail-redelivery-canaries
#   scripts/ci-local tests clippy fleet-compat mail-redelivery-canaries      (what a linux-gate skip covers)
#   scripts/ci-local isolation-vm                                            (the VM tests: scripts/ci-local-isolation-vm)
#
# Each STAGE is a scripts/ci-linux stage, run in order; every stage runs even after one fails, and the exit status is the
# first failure's (0 when all passed). Before the stages it builds and installs the rendered hooks, as the CI job's
# test-archive setup does.
#
# The stages start daemons and harnesses, so they run with a home of their own: HOME and the XDG state, config, data and cache
# directories are a scratch directory that is removed afterwards, and no st, GitHub or SSH agent variable reaches them, so
# nothing they start can read or write this account's st state, harness configuration or credentials, and no PATH entry
# inside the account's st state (a seat's command recorder) stays. Two things are kept:
# the account's cargo and rustup homes (the dependency cache), and XDG_RUNTIME_DIR with the session bus, because the build
# admission shim queues there. RUNNER_TEMP and GITHUB_STEP_SUMMARY, which CI provides, are scratch files too.
#
# Every time is measured and printed: the setup before the stages, each stage's start, end and seconds, and the time each stage spent
# waiting in the build admission queue (the shim's "cargo: waiting in order" ... "cargo: got build slot" lines, which also get a UTC
# stamp of their own), in a table at the end. Each stage's output is also kept in CI_LOCAL_LOG_DIR (default
# ~/.cache/ci-local-logs/run-TIME-PID/STAGE.log; the latest 10 runs stay), after the scratch above is gone.
set -euo pipefail
real_home=$HOME  # the account's own, before the stages get a home of their own
if [ "$#" -eq 0 ]; then
  echo "usage: scripts/ci-local STAGE..." >&2
  exit 2
fi
for stage in "$@"; do
  case "$stage" in
    tests|clippy|fleet-compat|mail-redelivery-canaries|isolation-vm) ;;
    *) echo "ci-local: stage $stage has no local lane" >&2; exit 2 ;;
  esac
done
# A host-local load limit, as scripts/fractal-test has: the 1-minute load average above which no heavy work starts. The limit is a number in
# ~/.config/st-test/max-load (or ST_TEST_MAX_LOAD); none means no limit. While the load is above it this WAITS, says why every minute, and
# after ST_TEST_LOAD_WAIT_MINUTES (default 30) exits non-zero with that reason: never silently. Whoever runs the host sets it, not the repo.
load_limit=${ST_TEST_MAX_LOAD:-}
if [ -z "$load_limit" ] && [ -r "$real_home/.config/st-test/max-load" ]; then
  read -r load_limit _ < "$real_home/.config/st-test/max-load" || true
fi
if [ -n "$load_limit" ]; then
  if ! awk -v v="$load_limit" 'BEGIN { exit !(v ~ /^[0-9]+(\.[0-9]+)?$/) }'; then
    echo "ci-local: the host load limit '$load_limit' must be a number (a load average)" >&2
    exit 2
  fi
  load_deadline=$(( $(date +%s) + $(awk -v m="${ST_TEST_LOAD_WAIT_MINUTES:-30}" 'BEGIN { printf "%d", m * 60 }') ))
  load_announced=0
  while :; do
    load_now=$(awk '{ print $1 }' "${CI_LOCAL_LOADAVG_FILE:-/proc/loadavg}")
    awk -v l="$load_now" -v m="$load_limit" 'BEGIN { exit !(l <= m) }' && break
    now=$(date +%s)
    if [ $(( now - load_announced )) -ge 60 ]; then
      echo "ci-local: waiting: load1 $load_now > $load_limit (host limit)" >&2
      load_announced=$now
    fi
    if [ "$now" -ge "$load_deadline" ]; then
      echo "ci-local: the host stayed above its load limit: load1 $load_now > $load_limit (host limit) for ${ST_TEST_LOAD_WAIT_MINUTES:-30} min; nothing was started" >&2
      exit 3
    fi
    sleep "${CI_LOCAL_LOAD_POLL:-10}"
  done
fi
# The scratch, and the stages' TMPDIR inside it, are on the account's disk as a CI runner's temporary directory is, never the
# caller's TMPDIR: a dev shell puts that under /tmp, which on some build hosts is a small tmpfs (tests that need tens of GB of
# scratch are refused there) or holds a stray /tmp/.git (tests that look for the enclosing repository find it).
# A CI runner's umask is 022: a host whose umask is 002 would make the stages' directories group-writable, and tests that
# refuse a directory others can change (the secrets gateway's) fail there.
umask 022
scratch_root=${CI_LOCAL_SCRATCH_ROOT:-$HOME/.cache/ci-local}
mkdir -p "$scratch_root"
chmod go-w "$scratch_root"
scratch=$(mktemp -d "$scratch_root/run.XXXXXX")
# The stages' TMPDIR is short: tests put Unix sockets several levels below it, a socket path is limited to 108 bytes, and under the
# scratch above (~/.cache/ci-local/run.XXXXXX/tmp) the daemons' sockets in the delivery-probe and seat tests no longer fit. It is in
# RAM (/dev/shm) when that has 20 GiB free, else on disk (/var/tmp; /tmp may be a small tmpfs); CI_LOCAL_TMP_ROOT names another root.
# The tests' SQLite stores sync every commit, and that wait, not CPU, is most of their time: on a build host the linux-gate tests took
# 849 s on /dev/shm against 1518 s on disk at 6 threads, using about 3.3 GB of it at 12 threads (2026-10-23). 20 GiB leaves room
# for the checkpoint tests, which refuse a filesystem with less than about 17 GB free, and for a second run.
tmp_root=${CI_LOCAL_TMP_ROOT:-}
if [ -z "$tmp_root" ]; then
  tmp_root=/var/tmp
  if [ -d /dev/shm ] && [ -w /dev/shm ] && [ "$(df -Pk /dev/shm | awk 'NR==2 {print $4}')" -ge $((20 * 1024 * 1024)) ]; then tmp_root=/dev/shm; fi
fi
tmp=$(mktemp -d "$tmp_root/cl.XXXXXX")
trap 'rm -rf "$scratch" "$tmp"' EXIT
cargo_home=${CARGO_HOME:-$HOME/.cargo}
rustup_home=${RUSTUP_HOME:-$HOME/.rustup}
# The cargo the stages build with is the dev shell's own, handed to the build admission shim as CARGO_REAL: CI_LOCAL_CARGO
# when set, otherwise the first cargo on PATH outside the account's home that is not the shim itself (the shim exports
# CARGO_SHIM_DEPTH). A build host's default real cargo may source a saved dev shell environment from another day, whose tools
# (an older pty) are not the tree's, and the stages would test those.
cargo_real=${CI_LOCAL_CARGO:-}
if [ -z "$cargo_real" ]; then
  IFS=':' read -r -a entries <<< "$PATH"
  for entry in "${entries[@]}"; do
    case "$entry" in ''|"$HOME"|"$HOME"/*) continue ;; esac
    [ -f "$entry/cargo" ] && [ -x "$entry/cargo" ] || continue
    if ! grep -q -a CARGO_SHIM_DEPTH "$entry/cargo"; then cargo_real="$entry/cargo"; break; fi
  done
fi
if [ -z "$cargo_real" ]; then
  echo "ci-local: no cargo executable of the dev shell on PATH (run it inside nix develop, or set CI_LOCAL_CARGO)" >&2
  exit 2
fi
while IFS='=' read -r -d '' name value; do
  case "$name" in
    # The dev shell's own test settings (flake.nix): the collector CI's OTLP export tests run against. Kept when they name a store
    # path, so a seat's own setting of the same name still leaves.
    ST3_OTELITE_BIN|FRACTAL_OTELITE_BIN) [[ "$value" == /nix/store/* && "$value" != *..* ]] || unset "$name" ;;
    ST_*|ST2_*|ST3_*|FRACTAL_*|GH_*|GITHUB_*|SSH_AUTH_SOCK|SSH_AGENT_PID|EVIDENCE_*|SEKRETS_*) unset "$name" ;;
  esac
done < <(env -0)
# A seat's PATH can start with directories inside the account's st state (a command recorder); those leave it too.
st_state=${XDG_STATE_HOME:-$HOME/.local/state}/st3
kept=()
IFS=':' read -r -a entries <<< "$PATH"
for entry in "${entries[@]}"; do
  case "$entry" in "$st_state"|"$st_state"/*) ;; *) kept+=("$entry") ;; esac
done
PATH=$(IFS=':'; printf '%s' "${kept[*]}")
# Cargo looks for a subcommand (clippy, fmt) in $CARGO_HOME/bin before PATH unless PATH names that directory, and an account's
# ~/.cargo/bin holds rustup's proxies: `cargo clippy` would then run rustup's toolchain, not the dev shell's. Named last, the
# directory comes after the dev shell's.
case ":$PATH:" in *":$cargo_home/bin:"*) ;; *) PATH="$PATH:$cargo_home/bin" ;; esac
# The host's build admission (the nix and cargo shims in ~/.local/bin and the build-admission program) finds its program, limits,
# priorities and queue state under the account's home. The stages' HOME below would hide them: every nix and cargo command inside
# a stage then found no admission program and took the shims' fallback cap, under a lock of its own per run, so a stage was admitted
# by nothing the host's other builds wait in. They are named here, from the account's home, by the variables the shims read; a
# value the caller set is kept, and a host without them is unchanged.
account_home=$HOME
if [ -x "$account_home/.local/bin/build-admission" ]; then
  export BUILD_ADMISSION_BIN="${BUILD_ADMISSION_BIN:-$account_home/.local/bin/build-admission}"
  export BUILD_ADMISSION_CONFIG="${BUILD_ADMISSION_CONFIG:-$account_home/.config/build-admission}"
  export BUILD_ADMISSION_STATE="${BUILD_ADMISSION_STATE:-$account_home/.local/state/st3/operations}"
  # The cargo shim writes its slot waits to the admission log, which it finds under $HOME unless this names it: under the stages' HOME
  # every write failed (No such file or directory), and a day's waits inside ci-local went unrecorded (2026-10-27).
  export BUILD_ADMISSION_LOG="${BUILD_ADMISSION_LOG:-$BUILD_ADMISSION_STATE/build-admission.log}"
  export BUILD_ADMISSION_FALLBACK_LOCK="${BUILD_ADMISSION_FALLBACK_LOCK:-$account_home/.local/state/st3/operations/build-admission-fallback.lock}"
fi
[ -r "$account_home/.config/cargo-priority" ] && export CARGO_PRIORITY_FILE="${CARGO_PRIORITY_FILE:-$account_home/.config/cargo-priority}"
if [ -z "${CARGO_HEAVY_SLOTS:-}" ] && [ -r "$account_home/.config/cargo-heavy-slots" ]; then
  CARGO_HEAVY_SLOTS=$(tr -d '[:space:]' < "$account_home/.config/cargo-heavy-slots")
  export CARGO_HEAVY_SLOTS
fi
export HOME="$scratch/home" CARGO_HOME="$cargo_home" RUSTUP_HOME="$rustup_home" CARGO_REAL="$cargo_real"
export XDG_STATE_HOME="$HOME/.local/state" XDG_CONFIG_HOME="$HOME/.config" XDG_DATA_HOME="$HOME/.local/share" XDG_CACHE_HOME="$HOME/.cache"
export RUNNER_TEMP="$scratch/runner" GITHUB_STEP_SUMMARY="$scratch/summary.md" TMPDIR="$tmp"
mkdir -p "$XDG_STATE_HOME" "$XDG_CONFIG_HOME" "$XDG_DATA_HOME" "$XDG_CACHE_HOME" "$RUNNER_TEMP" "$TMPDIR"
# The few tests about durability or disk cost keep a disk (disk_tempdir in the tests' support code): the scratch is on one.
if [ "$(stat -f -c %T "$tmp" 2>/dev/null)" = tmpfs ]; then
  export CI_TEST_DISK_TMPDIR="$scratch/disk"
  mkdir -p "$CI_TEST_DISK_TMPDIR"
fi
# A host may preload an allocator into every process (jemalloc); a CI runner preloads nothing, and tests that measure the allocator
# (malloc_trim) fail under one.
unset LD_PRELOAD
# The stages compile without sccache, as CI does when its cache is unavailable. A server started from here keeps this run's HOME and
# TMPDIR, which are removed at exit, and the account's builds share one server (127.0.0.1:4226): every compile through it then failed
# ("sccache: error: Failed to create temp dir") until it was stopped. The kept build directory (CARGO_TARGET_DIR) is the local cache.
unset RUSTC_WRAPPER CARGO_BUILD_RUSTC_WRAPPER
# The workspace crates build without debug info, as CI builds them (buildEnv in .github/workflows/workspace-ci.ts): a dev box never
# builds more than CI does. Cargo.toml's dev and test profiles keep debug = 1 for a plain `cargo build` or `cargo test`.
export CARGO_PROFILE_DEV_DEBUG=0 CARGO_PROFILE_TEST_DEBUG=0
# Each test process gets a TMPDIR of its own under this run's (scripts/ci-test-tmpdir, as the cargo target runner nextest honours): on a
# shared TMPDIR, one test that left an empty `.git` at its top made every later test there see a repository that is not one (2026-10-23,
# 21 failures in one local run; the stray /tmp/.git on the build hosts came the same way). A CI runner is fresh for every job.
triple=${CI_LOCAL_TARGET_TRIPLE:-$( { rustc -vV 2>/dev/null || true; } | sed -n 's/^host: //p')}
if [ -n "$triple" ]; then
  export CI_TEST_TMPDIR_ROOT="$TMPDIR"
  export "CARGO_TARGET_$(printf '%s' "$triple" | tr '[:lower:]-' '[:upper:]_')_RUNNER=$(cd "$(dirname "$0")" && pwd)/ci-test-tmpdir"
else
  echo "ci-local: no rustc to name the host target; the tests share one TMPDIR" >&2
fi
touch "$GITHUB_STEP_SUMMARY"
stamp() { date -u +%FT%TZ; }
log_root=${CI_LOCAL_LOG_DIR:-$real_home/.cache/ci-local-logs}
log_dir=$log_root/run-$(date -u +%Y%m%dT%H%M%SZ)-$$
mkdir -p "$log_dir"
echo "ci-local: stage logs in $log_dir"
# Keep the latest 10 runs' logs, and those of every run still going: a run that waits hours for build slots on a busy
# host is older than ten later runs, and it still writes to its directory (CI_LOCAL_LOG_DIR itself, when given, is the
# caller's and is not pruned).
if [ -z "${CI_LOCAL_LOG_DIR:-}" ]; then
  # shellcheck disable=SC2012
  ls -1dt "$log_root"/run-* 2>/dev/null | tail -n +11 | while IFS= read -r old; do
    kill -0 "${old##*-}" 2>/dev/null || rm -rf "$old"
  done
fi
# One line per build-slot wait as it starts and ends, `wait|slot EPOCH STAGE`, to CI_LOCAL_QUEUE_LOG when the caller names one: scripts/fractal-test
# reads it while the run goes on, so its time limit counts only the time the stages run, not the time they wait for a slot.
queue_event() {
  [ -n "${CI_LOCAL_QUEUE_LOG:-}" ] || return 0
  printf '%s %s %s\n' "$1" "$(date +%s)" "$2" >> "$CI_LOCAL_QUEUE_LOG" 2>/dev/null || true
}
# Passes a stage's output through, stamping the build admission queue's lines and adding up the time spent in the queue.
queue_times() {
  local stage=$1 line waiting=-1 count=0 total=0
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      'cargo: waiting in order'*) if [ "$waiting" -lt 0 ]; then queue_event wait "$stage"; fi; waiting=$SECONDS; count=$((count + 1)); printf 'ci-local: [%s] %s: waiting for a build slot\n' "$(stamp)" "$stage" ;;
      'cargo: got build slot'*) if [ "$waiting" -ge 0 ]; then total=$((total + SECONDS - waiting)); waiting=-1; queue_event slot "$stage"; fi; printf 'ci-local: [%s] %s: got a build slot\n' "$(stamp)" "$stage" ;;
    esac
    printf '%s\n' "$line"
  done
  # A stage that ended while it waited (stopped, or its cargo gave up) waits no longer.
  if [ "$waiting" -ge 0 ]; then queue_event slot "$stage"; fi
  echo "$count $total" > "$log_dir/$stage.queue"
}
setup_started=$(stamp); setup_began=$SECONDS
# clippy's ratchet compares with the base, as CI compares with the event's base: CLIPPY_BASE_SHA when given (scripts/fractal-test
# gives the base it just fetched and records it in the note), otherwise main as fetched now, never a local ref that may be old.
if [[ " $* " == *" clippy "* && -z "${CLIPPY_BASE_SHA:-}" ]]; then
  if ! git fetch -q --no-tags origin main || ! CLIPPY_BASE_SHA=$(git rev-parse --verify --quiet 'FETCH_HEAD^{commit}'); then
    echo "ci-local: could not fetch main for clippy's base; set CLIPPY_BASE_SHA" >&2
    exit 2
  fi
fi
if [[ -n "${CLIPPY_BASE_SHA:-}" ]] && ! [[ "$CLIPPY_BASE_SHA" =~ ^[0-9a-f]{40}([0-9a-f]{24})?$ ]]; then
  echo "ci-local: CLIPPY_BASE_SHA must be a full commit id" >&2
  exit 2
fi
export CLIPPY_BASE_SHA
# The tests stage needs what CI's test-build job prepares for it: the provider components the resource-provider tests load,
# and the previous release the messaging compatibility tests run against.
if [[ " $* " == *" tests "* ]]; then
  system=$(nix eval --impure --raw --expr builtins.currentSystem)
  components=$(nix build ".#checks.$system.provider-components" --no-link --print-out-paths)
  for provider in GITHUB_ISSUE GITHUB_PR PTY_STATS VISTA; do
    wasm=$(printf '%s' "$provider" | tr '[:upper:]' '[:lower:]')
    export "ST2_${provider}_COMPONENT=$components/share/st2/providers/st2_${wasm}_component.component.wasm"
  done
  compat=$(timeout 10m bash scripts/messaging-compat-binary)
  export FRACTAL_MESSAGING_COMPAT_BIN="$compat" ST3_MESSAGING_COMPAT_BIN="$compat"
fi
cargo build --locked -p fractal-drivers --bin ci-hooks-install
bash scripts/ci-install-built-hooks
setup_ended=$(stamp); setup_seconds=$((SECONDS - setup_began))
# A build host is shared and test binaries run outside the build admission gate: the stages' tests run 12 at a time unless
# CI_TEST_THREADS says otherwise (CI's runners use 8 on a machine of their own), at low CPU and IO priority. On a 16-core build host
# with the TMPDIR in RAM, 12 threads took the linux-gate tests from 849 s to 519 s at a peak of 18 GB used (2026-10-23); on disk,
# 12 threads made six timing-sensitive tests retry, so the two go together.
export CI_TEST_THREADS=${CI_TEST_THREADS:-12}
# A proptest that fails (on its first try, under load, before nextest retries it) writes proptest-regressions/ into the tree it runs in: an
# untracked file the evidence signer then sees as a changed checkout ("the checkout changed while the command ran; nothing was signed"), so one
# flaky property test voided a whole signing run. The stages persist no failures.
export PROPTEST_DISABLE_FAILURE_PERSISTENCE=1
low=()
if command -v ionice >/dev/null 2>&1; then low+=(ionice -c 3); fi
if command -v nice >/dev/null 2>&1; then low+=(nice -n 10); fi
# One stage: its output stamped and tallied (queue_times), kept in its log and, for a stage in the foreground, passed on to this terminal.
# Its exit code and its row of the closing table go to files, so a stage run in the background lane reports the same way.
run_stage() {
  local n=$1 stage=$2 shown=$3 started began code seconds queued waited
  started=$(stamp); began=$SECONDS
  # Both streams into one pipe. PIPESTATUS[0] is the stage's own status.
  set +e
  if [ "$stage" = isolation-vm ]; then
    { "${low[@]}" bash scripts/ci-local-isolation-vm; } 2>&1 | queue_times "$stage" | if [ "$shown" = shown ]; then tee "$log_dir/$stage.log"; else cat > "$log_dir/$stage.log"; fi
  else
    { "${low[@]}" bash scripts/ci-linux "$stage"; } 2>&1 | queue_times "$stage" | if [ "$shown" = shown ]; then tee "$log_dir/$stage.log"; else cat > "$log_dir/$stage.log"; fi
  fi
  code=${PIPESTATUS[0]}
  set -e
  seconds=$((SECONDS - began))
  read -r queued waited < "$log_dir/$stage.queue" 2>/dev/null || { queued=0; waited=0; }
  # By position: a stage may be given twice.
  echo "$code" > "$log_dir/.$n.code"
  printf '%-26s %s  %s  %6ss  exit %-3s queue: %s waits, %ss\n' "$stage" "$started" "$(stamp)" "$seconds" "$code" "${queued:-0}" "${waited:-0}" \
    > "$log_dir/.$n.row"
  if [ "$shown" = shown ]; then echo "ci-local: $stage exit $code"; fi
}
# clippy and fleet compatibility run alongside the tests stage, one after the other in a lane of their own, as their CI jobs run on runners
# of their own: the tests stage builds first (cargo's lock on the build directory holds the lane's build until then) and then spends most
# of its time running tests, which is when the lane compiles and runs. Their output is kept and printed once the foreground stages are
# done, so the two never interleave. CI_LOCAL_SERIAL=1 runs every stage one after another, as before.
stages=("$@")
lane=()  # positions
if [ "${CI_LOCAL_SERIAL:-}" != 1 ] && [[ " $* " == *" tests "* ]]; then
  for n in "${!stages[@]}"; do
    case "${stages[$n]}" in clippy|fleet-compat) lane+=("$n") ;; esac
  done
fi
in_lane() { local n; for n in "${lane[@]}"; do [ "$n" = "$1" ] && return 0; done; return 1; }
# A process and everything under it, children first (read from /proc: a parent's PPid line), so a stage the lane started does not
# outlive it. What detaches on purpose (the test guardian's setsid) is not under it and is not reached, as before.
stop_tree() {
  local pid=$1 status child
  for status in /proc/[0-9]*/status; do
    if [ "$(sed -n 's/^PPid:[[:space:]]*//p' "$status" 2>/dev/null)" = "$pid" ]; then
      child=${status#/proc/}; child=${child%/status}
      stop_tree "$child"
    fi
  done
  kill "$pid" 2>/dev/null || true
}
lane_pid=
if [ "${#lane[@]}" -gt 0 ]; then
  echo "ci-local: $(for n in "${lane[@]}"; do printf '%s ' "${stages[$n]}"; done)run alongside the other stages; their output follows when they are done"
  ( for n in "${lane[@]}"; do run_stage "$n" "${stages[$n]}" quiet; done ) &
  lane_pid=$!
  # Stopped, the run takes its lane with it, the stage the lane is running included, before the scratch they use is removed.
  # (|| true: under set -e a lane that already ended would make the trap's own exit status the run's.)
  trap 'stop_tree "$lane_pid"; wait "$lane_pid" 2>/dev/null || true; rm -rf "$scratch" "$tmp"' EXIT
fi
for n in "${!stages[@]}"; do
  in_lane "$n" || run_stage "$n" "${stages[$n]}" shown
done
if [ -n "$lane_pid" ]; then
  wait "$lane_pid" || true
  for n in "${lane[@]}"; do
    echo "----- ci-local: ${stages[$n]} output -----"
    cat "$log_dir/${stages[$n]}.log" 2>/dev/null || echo "(no output)"
    echo "ci-local: ${stages[$n]} exit $(cat "$log_dir/.$n.code" 2>/dev/null || echo 1)"
  done
fi
# The exit status is the first failure's in the order the stages were given; a stage that left no code failed.
status=0
table=()
for n in "${!stages[@]}"; do
  code=$(cat "$log_dir/.$n.code" 2>/dev/null || echo 1)
  table+=("$(cat "$log_dir/.$n.row" 2>/dev/null || printf '%-26s (no result)' "${stages[$n]}")")
  if [ "$status" -eq 0 ]; then status=$code; fi
done
echo "ci-local: timing (UTC)"
printf 'ci-local:   %s\n' "$(printf '%-26s %s  %s  %6ss' setup "$setup_started" "$setup_ended" "$setup_seconds")"
for row in "${table[@]}"; do printf 'ci-local:   %s\n' "$row"; done
exit "$status"
