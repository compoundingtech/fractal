#!/usr/bin/env python3
"""A sparse copy of the tree: only the files a skip-policy check declares as its inputs, as a fresh one-commit git repository.

  scripts/ci-sparse-tree --repo DIR --check NAME --into EMPTY_DIR [--policy FILE] [--link PATH]...

The check's `inputs` (evidence-skip-policy.json, checks.NAME.inputs) are the paths its evidence key covers: a pull request that
changes none of them reuses an earlier signature. A check that runs in this copy can read nothing else, so one that reads outside its
inputs fails instead of passing on a stale signature, and the declared list cannot drift from what the check reads. Each input is a
tracked file or a directory; one that matches no tracked file is an error (the list names what exists).
During arn:lmig:smalltalk:2026-10-27-dot-fractal-config, a declared pair `.st`, `.fractal` requires at least one layout, not both.
--link PATH symlinks an untracked directory of the repository into the copy when it exists (the megarepo members under repos/, which the
tests that run genie import): environment the inputs pin (megarepo.lock, flake.lock), not an input of its own.
"""
import argparse
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys


# arn:lmig:smalltalk:2026-10-27-dot-fractal-config
def config_path(root, name):
    new = root / '.fractal' / name
    try:
        new.lstat()
    except FileNotFoundError:
        return root / '.st' / name
    return new


def tracked(repo):
    done = subprocess.run(['git', '-C', str(repo), 'ls-files', '-z', '--cached'], capture_output=True, check=True)
    return [name for name in done.stdout.decode().split('\0') if name]


def declared_inputs(policy, check):
    entry = json.loads(Path(policy).read_text())['checks'].get(check)
    if entry is None:
        raise SystemExit(f'ci-sparse-tree: {policy} has no check {check!r}')
    inputs = entry.get('inputs')
    if not inputs:
        raise SystemExit(f'ci-sparse-tree: check {check!r} declares no inputs')
    return inputs


def select(files, inputs):
    """(selected files, inputs that matched nothing)."""
    chosen, unmatched = set(), []
    for item in inputs:
        item = item.rstrip('/')
        hits = [name for name in files if name == item or name.startswith(item + '/')]
        if not hits:
            unmatched.append(item)
        chosen.update(hits)
    # arn:lmig:smalltalk:2026-10-27-dot-fractal-config — a declared pair needs one layout.
    pair = {'.st', '.fractal'}
    if pair <= {item.rstrip('/') for item in inputs} and any(
            name.startswith(('.st/', '.fractal/')) for name in chosen):
        unmatched = [item for item in unmatched if item not in pair]
    return sorted(chosen), unmatched


def copy(repo, into, names):
    for name in names:
        source, target = repo / name, into / name
        if source.is_dir() and not source.is_symlink():
            continue  # a gitlink: nothing to copy
        target.parent.mkdir(parents=True, exist_ok=True)
        if source.is_symlink():
            os.symlink(os.readlink(source), target)
        else:
            shutil.copy2(source, target)


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('--repo', required=True, type=Path)
    parser.add_argument('--check', required=True)
    parser.add_argument('--into', required=True, type=Path)
    parser.add_argument('--policy', type=Path, help='default: .fractal/evidence-skip-policy.json, then .st only if absent')
    parser.add_argument('--link', action='append', default=[], metavar='PATH', help='an untracked directory to symlink into the copy when it exists')
    args = parser.parse_args(argv)
    if args.into.exists() and any(args.into.iterdir()):
        raise SystemExit(f'ci-sparse-tree: {args.into} is not empty')
    names, unmatched = select(tracked(args.repo), declared_inputs(args.policy or config_path(args.repo, 'evidence-skip-policy.json'), args.check))
    if unmatched:
        raise SystemExit(f'ci-sparse-tree: inputs of {args.check} that match no tracked file: {", ".join(unmatched)}')
    args.into.mkdir(parents=True, exist_ok=True)
    copy(args.repo, args.into, names)
    for link in args.link:
        source = (args.repo / link).resolve()
        if source.is_dir() and not (args.into / link).exists():
            os.symlink(source, args.into / link)
    identity = {'GIT_AUTHOR_NAME': 'sparse', 'GIT_AUTHOR_EMAIL': 'sparse@example.invalid', 'GIT_COMMITTER_NAME': 'sparse',
                'GIT_COMMITTER_EMAIL': 'sparse@example.invalid', 'GIT_CONFIG_GLOBAL': '/dev/null', 'GIT_CONFIG_SYSTEM': '/dev/null'}
    env = dict(os.environ, **identity)
    subprocess.run(['git', '-C', str(args.into), 'init', '-q', '-b', 'main'], check=True, env=env, capture_output=True)
    if args.link:
        exclude = args.into / '.git' / 'info' / 'exclude'
        exclude.parent.mkdir(parents=True, exist_ok=True)
        exclude.write_text(''.join(f'/{link.rstrip("/")}\n' for link in args.link))
    # Exactly the selected files (forced: a copied .gitignore must not drop a tracked one), never a linked directory.
    subprocess.run(['git', '--literal-pathspecs', '-C', str(args.into), 'add', '-f', '--pathspec-from-file=-', '--pathspec-file-nul'], check=True, env=env, capture_output=True,
                   input='\0'.join(names).encode())
    subprocess.run(['git', '-C', str(args.into), 'commit', '-q', '-m', f'sparse tree of {args.check}'], check=True, env=env, capture_output=True)
    print(f'ci-sparse-tree: {len(names)} files of {args.check} in {args.into}')
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
