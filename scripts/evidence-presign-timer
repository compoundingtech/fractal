#!/usr/bin/env bash
# One tick of the pre-sign worker, as main has it (scripts/evidence-presign-{light,heavy}.service from their timers).
# The worker is read from origin/main of the clone it owns, never a checkout's copy; st-test, which it runs, is read the same way.
#   evidence-presign-timer light|heavy [--dry-run]
set -euo pipefail
state=${EVIDENCE_PRESIGN_STATE:-$HOME/.local/state/evidence-presign}
repository=${EVIDENCE_PRESIGN_REPOSITORY:-compoundingtech/fractal}
kind=${1:?light or heavy}
# A clone per class: a light tick checks out another head while a heavy run is under way, and they must not share a checkout.
repo=$state/repo-$kind
mkdir -p "$state"
if [ ! -d "$repo/.git" ]; then
  git clone -q --no-tags "${EVIDENCE_PRESIGN_REMOTE:-https://github.com/$repository.git}" "$repo"
  git -C "$repo" config gc.auto 0
fi
git -C "$repo" -c core.hooksPath=/dev/null fetch -q --no-tags origin +refs/heads/main:refs/remotes/origin/main
tools=$(mktemp -d)
trap 'rm -rf "$tools"' EXIT
git -C "$repo" show origin/main:scripts/evidence-presign-worker > "$tools/evidence-presign-worker"
python3 -I "$tools/evidence-presign-worker" tick --class "$kind" --repo "$repo" --repository "$repository" "${@:2}"
