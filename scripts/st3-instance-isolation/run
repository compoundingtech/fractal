#!/usr/bin/env bash
# Prove that a named st instance cannot touch the default install, and that its uninstall is
# complete. Everything happens in a throwaway HOME with a scrubbed environment and without a
# service manager, so it never reads or changes the machine's real st install or daemon.
#
# 1. Start the default st in the throwaway HOME and install its skill, so it has state, a node
#    identity, a database and skill copies. Stop it.
# 2. Snapshot the whole HOME: every path, mode, size, symlink target and file hash.
# 3. Start an instance, install its skill, stop it, and uninstall it.
# 4. Snapshot again. The two snapshots must be identical, and the instance directory gone.
# 5. Uninstall the default install: no file may be left in HOME.
#
# Usage: run ST3_BINARY PTY_BINARY [OUT_DIR]
#
# The daemon refuses a process that descends from another seat, so run this outside a seat's
# process tree, for example with `systemd-run --user --wait --pipe --collect`.
#
# Writes before.snapshot, after.snapshot, the transcript and result.txt to OUT_DIR (default: a
# temporary directory that is kept). Exits 0 only when the snapshots match and nothing remains.
set -Eeuo pipefail

st3="$(readlink -f "$1")"
pty="$(readlink -f "$2")"
out="${3:-$(mktemp -d)}"
mkdir -p "$out"
out="$(cd "$out" && pwd)"
home="$(mktemp -d "${TMPDIR:-/var/tmp}/st-instance-home.XXXXXX")"
tools="$(dirname "$home")/$(basename "$home").tools"
mkdir -p "$tools"
# st3 finds pty beside itself, so use a copy of st3 that has one beside it.
cp --reflink=auto "$pty" "$tools/pty"
cp --reflink=auto "$st3" "$tools/st3"
st3="$tools/st3"
# st reads its seats' environment from the account's login shell, which can reset PATH. A profile
# in the throwaway HOME keeps the tools beside st3 on it, whichever shell the account uses.
for profile in .bash_profile .zprofile; do
  printf 'export PATH="%s:$PATH"\n' "$tools" >"$home/$profile"
done
trap 'pkill -u "$(id -u)" -f "$home" 2>/dev/null || true; rm -rf "$home" "$tools"' EXIT

# The only environment st sees: no XDG variables, no ST_* variables, no real HOME. The PATH has
# the tools beside st3 and the directory that holds the system utilities.
system="$(dirname "$(command -v ls)")"
path="$tools:$system:/usr/bin:/bin"
snapshot() {
  (cd "$home" && find . -mindepth 1 \( -type f -o -type l -o -type d \) -printf '%y %m %s %p %l\n' | sort
   find . -type f -print0 | sort -z | xargs -0 -r sha256sum) >"$1"
}
# Start a daemon in the background with its log outside HOME; wait until it answers.
start_daemon() {
  "$@" up >"$out/$daemon_log" 2>&1 &
  for _ in $(seq 1 60); do
    "$@" --daemon-wait 0 agents ls >/dev/null 2>&1 && return 0
    sleep 0.5
  done
  echo "FAIL: the daemon did not start"; tail -20 "$out/$daemon_log"; exit 1
}
stop_daemons() {
  pkill -u "$(id -u)" -f "$home" 2>/dev/null || true
  sleep 1
}

{
  echo "== default install"
  default=(env -i HOME="$home" PATH="$path" USER="$(id -un)" LANG=C.UTF-8 SHELL=/bin/sh
    HOSTNAME=proofhost "$st3")
  daemon_log=default-daemon.log
  start_daemon "${default[@]}"
  "${default[@]}" skill install >/dev/null
  stop_daemons
  snapshot "$out/before.snapshot"
  echo "snapshot: $(wc -l <"$out/before.snapshot") entries"
  test -d "$home/.local/state/st3" || { echo "FAIL: the default install has no state"; exit 1; }

  echo "== instance"
  inst=(env -i HOME="$home" PATH="$path" USER="$(id -un)" LANG=C.UTF-8 SHELL=/bin/sh
    HOSTNAME=proofhost "$st3" --instance proof)
  daemon_log=instance-daemon.log
  start_daemon "${inst[@]}"
  test -d "$home/.st-instance/proof/state" && echo "instance state: ok"
  # First-run setup for the instance: its binaries go below the instance, never into ~/.local/bin.
  "${inst[@]}" setup --person avery --yes --service false >"$out/instance-setup.txt" 2>&1 \
    || { echo "FAIL: instance setup"; cat "$out/instance-setup.txt"; exit 1; }
  for name in st3 st pty; do
    test -e "$home/.st-instance/proof/bin/$name" || { echo "FAIL: instance bin/$name is missing"; exit 1; }
  done
  test ! -e "$home/.local/bin" || { echo "FAIL: setup touched the default bin directory"; exit 1; }
  echo "instance setup: binaries are in the instance"
  "${inst[@]}" skill install >/dev/null
  "${inst[@]}" agents ls || true
  "${inst[@]}" uninstall --dry-run
  # Stop the daemon the way a person would, then remove everything.
  stop_daemons
  "${inst[@]}" uninstall --yes --erase-local-graph

  echo "== after"
  snapshot "$out/after.snapshot"
  if [ -e "$home/.st-instance/proof" ]; then
    echo "FAIL: the instance directory remains"
    find "$home/.st-instance" | head -20
    exit 1
  fi
  if diff -u "$out/before.snapshot" "$out/after.snapshot" >"$out/diff.txt"; then
    echo "PASS: the default install is byte-identical after the instance ran and was uninstalled"
  else
    echo "FAIL: the default install changed"
    head -40 "$out/diff.txt"
    exit 1
  fi
  # The default install is still there and removes itself completely, with nothing left in HOME.
  "${default[@]}" uninstall --yes --erase-local-graph
  # The login profiles are the proof's own fixture. Empty directories such as ~/.config or ~/.local/bin are shared parents, not st's files.
  leftovers="$(cd "$home" && find . -mindepth 1 -not -type d \
    -not -path ./.bash_profile -not -path ./.zprofile -print)"
  if [ -n "$leftovers" ]; then
    echo "FAIL: the default uninstall left files behind:"
    echo "$leftovers"
    exit 1
  fi
  echo "PASS: the default uninstall leaves no file behind"
} 2>&1 | tee "$out/transcript.txt"
status=${PIPESTATUS[0]}
echo "$status" >"$out/result.txt"
exit "$status"
