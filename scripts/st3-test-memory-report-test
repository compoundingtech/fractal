#!/usr/bin/env python3
"""Proofs that the test guardian reports each owned process's peak resident memory.

Uses only Python children that allocate and hold a known amount; no daemon, no fleet.
"""
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest

sys.dont_write_bytecode = True
GUARDIAN = Path(__file__).resolve().parent / "st3_test_process.py"
MB = 1024 * 1024

# The test allocates 100 MB, starts a child holding 300 MB, a detached grandchild (the shape of a
# PTY server or a double-forked daemon) holding 200 MB for the rest of the test, and one that
# allocates 150 MB and exits at once, before most polls.
FIXTURE = """
import os, subprocess, sys, time
hold = bytearray(100 * 1024 * 1024)
for i in range(0, len(hold), 4096): hold[i] = 1
child = "import time; b = bytearray(300 * 1024 * 1024)\\nfor i in range(0, len(b), 4096): b[i] = 1\\ntime.sleep(60)"
subprocess.Popen([sys.executable, "-c", child, "child-marker"])
detached = (
    "import os, time\\n"
    "if os.fork(): os._exit(0)\\n"
    "os.setsid()\\n"
    "b = bytearray(200 * 1024 * 1024)\\n"
    "for i in range(0, len(b), 4096): b[i] = 1\\n"
    "time.sleep(60)")
subprocess.run([sys.executable, "-c", detached, "detached-marker"])
quick = (
    "import os\\n"
    "if os.fork(): os._exit(0)\\n"
    "os.setsid()\\n"
    "b = bytearray(150 * 1024 * 1024)\\n"
    "for i in range(0, len(b), 4096): b[i] = 1\\n"
    "os._exit(0)")
subprocess.run([sys.executable, "-c", quick, "quick-marker"])
time.sleep(1.5)
"""


def guard(report, *extra_env):
    env = {**os.environ, "PYTHONDONTWRITEBYTECODE": "1"}
    env.pop("SMALLTALK_TEST_SUPERVISOR", None)
    env.pop("SMALLTALK_TEST_MEMORY_REPORT", None)
    if report:
        env["SMALLTALK_TEST_MEMORY_REPORT"] = str(report)
    return subprocess.run([sys.executable, str(GUARDIAN), "--", sys.executable, "-c", FIXTURE,
                           "--exact", "memory::fixture"], env=env, capture_output=True, text=True, timeout=60)


class MemoryReportTests(unittest.TestCase):
    def test_each_owned_process_reports_its_peak(self):
        with tempfile.TemporaryDirectory(prefix="memory-report-") as directory:
            report = Path(directory) / "rss.jsonl"
            result = guard(report)
            self.assertEqual(result.returncode, 0, result.stderr)
            records = [json.loads(line) for line in report.read_text().splitlines()]
            self.assertEqual(len(records), 1)
            record = records[0]
            self.assertEqual((record["test"], record["exit"]), ("memory::fixture", 0))
            peaks = {}
            for process in record["processes"]:
                marker = next((a for a in process["argv"] if a.endswith("-marker")), process["name"])
                peaks[marker] = max(peaks.get(marker, 0), process["peak_kb"])
            self.assertGreaterEqual(peaks["test"] * 1024, 100 * MB)
            self.assertGreaterEqual(peaks["child-marker"] * 1024, 300 * MB)
            self.assertGreaterEqual(peaks["detached-marker"] * 1024, 200 * MB)
            # Seen by a poll, or reaped by wait4 and then unnamed: the peak is there either way.
            self.assertTrue(
                peaks.get("quick-marker", 0) * 1024 >= 150 * MB or peaks.get("?", 0) * 1024 >= 150 * MB,
                record["processes"])
            self.assertLess(peaks["test"] * 1024, 250 * MB, "the test's own row holds a child's memory")

    def test_an_empty_variable_leaves_the_guardian_unchanged(self):
        env = {**os.environ, "SMALLTALK_TEST_MEMORY_REPORT": ""}
        env.pop("SMALLTALK_TEST_SUPERVISOR", None)
        result = subprocess.run([sys.executable, str(GUARDIAN), "--", sys.executable, "-c", "print('ran')"],
                                env=env, capture_output=True, text=True, timeout=30)
        self.assertEqual((result.returncode, result.stdout.strip()), (0, "ran"), result.stderr)

    def test_parallel_tests_append_whole_lines(self):
        with tempfile.TemporaryDirectory(prefix="memory-report-") as directory:
            report = Path(directory) / "rss.jsonl"
            code = "import time; time.sleep(0.3)"
            env = {**os.environ, "SMALLTALK_TEST_MEMORY_REPORT": str(report)}
            env.pop("SMALLTALK_TEST_SUPERVISOR", None)
            runs = [subprocess.Popen([sys.executable, str(GUARDIAN), "--", sys.executable, "-c", code,
                                      "--exact", f"memory::parallel_{n}"], env=env) for n in range(8)]
            self.assertEqual([run.wait(timeout=30) for run in runs], [0] * 8)
            records = [json.loads(line) for line in report.read_text().splitlines()]
            self.assertEqual(sorted(r["test"] for r in records), sorted(f"memory::parallel_{n}" for n in range(8)))


if __name__ == "__main__":
    unittest.main()
