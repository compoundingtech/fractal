#!/usr/bin/env python3
"""Tests for scripts/ci-parallel-tests: a failing test's last lines are printed and its whole log is kept, at a path the output names."""
import os
from pathlib import Path
import shutil
import subprocess
import tempfile
import unittest

ROOT = Path(__file__).resolve().parent.parent
FAILS = 'import sys\nfor i in range(1, 301):\n    print(f"line {i}")\nsys.exit(1)\n'


class ParallelTests(unittest.TestCase):
    def setUp(self):
        self.tmp = Path(tempfile.mkdtemp())
        self.addCleanup(shutil.rmtree, self.tmp)
        (self.tmp / 'scripts').mkdir()
        shutil.copy(ROOT / 'scripts/ci-parallel-tests', self.tmp / 'scripts/ci-parallel-tests')
        (self.tmp / 'scripts/passes-test').write_text('print("fine")\n')
        (self.tmp / 'scripts/fails-test').write_text(FAILS)
        self.keep = self.tmp / 'keep'

    def run_tests(self, *names):
        return subprocess.run(['bash', '-c', '. scripts/ci-parallel-tests; parallel_tests "$@"', '_', *names], cwd=self.tmp,
                              capture_output=True, text=True, env=dict(os.environ, CI_PARALLEL_TESTS_KEEP=str(self.keep)))

    def test_a_failing_test_prints_its_last_200_lines_and_keeps_its_whole_log_at_the_path_it_names(self):
        done = self.run_tests('passes-test', 'fails-test')
        self.assertEqual(done.returncode, 1, done.stderr)
        lines = done.stdout.splitlines()
        self.assertEqual(lines[0], '::group::FAILED scripts/fails-test')
        self.assertTrue(lines[1].startswith(f'whole log: {self.keep}/run-'), lines[1])
        self.assertEqual(lines[2:-1], [f'line {i}' for i in range(101, 301)])
        self.assertEqual(lines[-1], '::endgroup::')
        kept = Path(lines[1].removeprefix('whole log: '))
        self.assertEqual(kept.name, 'fails-test.log')
        self.assertEqual(kept.read_text().splitlines(), [f'line {i}' for i in range(1, 301)])
        self.assertEqual(sorted(p.name for p in kept.parent.iterdir()), ['fails-test.log'])  # a test that passed keeps nothing

    def test_a_run_that_passes_keeps_nothing(self):
        done = self.run_tests('passes-test')
        self.assertEqual((done.returncode, done.stdout), (0, ''), done.stderr)
        self.assertFalse(self.keep.exists())

    def test_the_latest_10_runs_stay(self):
        for i in range(12):
            old = self.keep / f'run-20260101T0000{i:02d}Z-1'
            old.mkdir(parents=True)
            os.utime(old, (1_700_000_000 + i, 1_700_000_000 + i))
        done = self.run_tests('fails-test')
        self.assertEqual(done.returncode, 1, done.stderr)
        runs = sorted(p.name for p in self.keep.iterdir())
        self.assertEqual(len(runs), 10)
        self.assertNotIn('run-20260101T000002Z-1', runs)  # the oldest went
        self.assertIn('run-20260101T000011Z-1', runs)
        self.assertTrue(any(p.name == 'fails-test.log' for p in self.keep.glob('*/fails-test.log')))

    def test_a_keep_directory_that_cannot_be_made_still_prints_the_last_lines(self):
        self.keep.write_text('a file, not a directory')
        done = self.run_tests('fails-test')
        self.assertEqual(done.returncode, 1, done.stderr)
        self.assertNotIn('whole log:', done.stdout)
        self.assertIn('line 300', done.stdout)


if __name__ == '__main__':
    unittest.main()
