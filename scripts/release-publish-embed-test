#!/usr/bin/env python3
"""Exercise the web embed publish step against a fake gh that times out: a draft is continued, never
replaced, and a published embed is never touched (#4606)."""
import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile

repo = Path(__file__).resolve().parent.parent
SOURCE = 'a' * 40
TAG = f'embed-{SOURCE}'
TIMEOUT = "HTTP 504: We couldn't respond to your request in time. (https://api.github.com/repos/example/project/releases)"

FAKE_GH = r'''#!/usr/bin/env python3
import json, os, pathlib, sys
state_path = pathlib.Path(os.environ['FAKE_GH_STATE'])
state = json.loads(state_path.read_text())
args = sys.argv[1:]
def save():
    state_path.write_text(json.dumps(state))
def fail(message):
    print(message, file=sys.stderr); sys.exit(1)
state['calls'].append(args)
save()
# Scripted failures: each matches the start of a call and fails it `times` times, before the call
# takes effect, after it ("after"), or after it left its files unfinished ("partial").
late = None
for failure in state['fail']:
    if args[:len(failure['match'])] == failure['match'] and failure['times'] > 0:
        failure['times'] -= 1
        save()
        if failure['when'] == 'before':
            fail(failure['message'])
        late = failure
        break
release = state['release']
def put(path):
    size = pathlib.Path(path).stat().st_size
    unfinished = late is not None and late['when'] == 'partial'
    release['assets'][pathlib.Path(path).name] = {'size': size // 2 if unfinished else size,
                                                  'state': 'starter' if unfinished else 'uploaded'}
if args[:2] == ['release', 'view']:
    if release is None or args[2] != state['tag']: fail('release not found')
    print(json.dumps({'isDraft': release['draft'], 'assets': [
        {'name': name, 'size': asset['size'], 'state': asset['state']} for name, asset in release['assets'].items()]}))
elif args[:2] == ['release', 'create']:
    if release is not None: fail('HTTP 422: Validation Failed: tag_name already_exists')
    assert '--draft' in args and '--clobber' not in args, args
    state['tag'] = args[2]
    release = state['release'] = {'draft': True, 'assets': {}}
    files = [a for a in args if a.startswith('/')]
    for f in files[:1] if late is not None and late['when'] == 'partial' else files:
        put(f)
elif args[:2] == ['release', 'upload']:
    assert '--clobber' not in args, args
    name = pathlib.Path(args[3]).name
    if name in release['assets']: fail('HTTP 422: Validation Failed: already_exists')
    put(args[3])
elif args[:2] == ['release', 'delete-asset']:
    if args[3] not in release['assets']: fail('asset not found')
    if not release['draft']: state['touched_published'] = True
    del release['assets'][args[3]]
elif args[:2] == ['release', 'edit']:
    assert args[3:] == ['--draft=false'], args
    release['draft'] = False
else:
    fail('unexpected gh call: %r' % args)
save()
if late is not None:
    fail(late['message'])
'''


def main():
    with tempfile.TemporaryDirectory() as temporary:
        root = Path(temporary)
        scripts = root / 'scripts'
        scripts.mkdir()
        for name in ('release-publish-embed', 'release_gh.py'):
            shutil.copy(repo / 'scripts' / name, scripts / name)
        tools = root / 'tools'
        tools.mkdir()
        (tools / 'gh').write_text(FAKE_GH)
        (tools / 'gh').chmod(0o755)
        dist = root / 'dist'
        dist.mkdir()
        archive = dist / 'fractal-web-embed.tar.gz'
        archive.write_bytes(b'embed archive bytes' * 40)
        digest = subprocess.run(['sha256sum', archive.name], cwd=dist, check=True, text=True, capture_output=True).stdout
        (dist / 'fractal-web-embed.tar.gz.sha256').write_text(digest)
        sizes = {f.name: f.stat().st_size for f in dist.iterdir()}
        state = root / 'state.json'
        env = dict(os.environ, PATH=f'{tools}:{os.environ["PATH"]}', FAKE_GH_STATE=str(state),
                   GH_REPO='example/project', RELEASE_GH_RETRY_DELAYS='0,0,0')

        def publish(release=None, *failures):
            state.write_text(json.dumps({'release': release, 'tag': TAG if release else None, 'calls': [], 'fail': [
                {'match': match, 'when': when, 'times': times, 'message': message}
                for match, when, times, message in failures]}))
            return subprocess.run(['python3', 'scripts/release-publish-embed', '--source', SOURCE, '--dist', str(dist)],
                                  cwd=root, env=env, text=True, capture_output=True)

        def current():
            return json.loads(state.read_text())

        def calls(prefix):
            return sum(1 for call in current()['calls'] if call[:len(prefix)] == prefix)

        def published():
            release = current()['release']
            return (release is not None and not release['draft'] and not current().get('touched_published')
                    and {n: (a['size'], a['state']) for n, a in release['assets'].items()}
                    == {n: (s, 'uploaded') for n, s in sizes.items()})

        # A first run makes a draft with both files and publishes it.
        done = publish()
        assert done.returncode == 0 and published() and calls(['release', 'create']) == 1, (done, current())

        # A create that made the draft and then timed out is continued: no "already exists".
        done = publish(None, (['release', 'create'], 'after', 1, TIMEOUT))
        assert done.returncode == 0 and published() and calls(['release', 'create']) == 1, (done, current())
        # A create that timed out before it took effect is made again.
        done = publish(None, (['release', 'create'], 'before', 1, TIMEOUT))
        assert done.returncode == 0 and published() and calls(['release', 'create']) == 2, (done, current())
        # A create that timed out with one file unfinished and one never sent: the unfinished one
        # goes, then both upload, and nothing readable is replaced.
        done = publish(None, (['release', 'create'], 'partial', 1, TIMEOUT))
        assert done.returncode == 0 and published(), (done, current())
        assert calls(['release', 'delete-asset']) == 1 and calls(['release', 'upload']) == 2, current()['calls']
        # An upload that timed out unfinished is removed and sent again.
        draft = {'draft': True, 'assets': {'fractal-web-embed.tar.gz': {'size': sizes['fractal-web-embed.tar.gz'], 'state': 'uploaded'}}}
        done = publish(draft, (['release', 'upload'], 'partial', 1, TIMEOUT))
        assert done.returncode == 0 and published() and calls(['release', 'upload']) == 2, (done, current())
        # Publishing that took effect and then timed out is not repeated.
        done = publish(None, (['release', 'edit'], 'after', 1, TIMEOUT))
        assert done.returncode == 0 and published() and calls(['release', 'edit']) == 1, (done, current())

        # A rerun after publishing checks the pin and changes nothing.
        pin = {'draft': False, 'assets': {n: {'size': s, 'state': 'uploaded'} for n, s in sizes.items()}}
        done = publish(pin)
        assert done.returncode == 0 and 'already published' in done.stdout, done
        assert [call[:2] for call in current()['calls']] == [['release', 'view']], current()['calls']
        # A published embed that differs is refused, never replaced.
        other = {'draft': False, 'assets': {'fractal-web-embed.tar.gz': {'size': 3, 'state': 'uploaded'}}}
        done = publish(other)
        assert done.returncode != 0 and 'never replaced' in done.stderr, done
        assert [call[:2] for call in current()['calls']] == [['release', 'view']], current()['calls']
        # A draft file at another size is refused rather than replaced.
        odd = {'draft': True, 'assets': {'fractal-web-embed.tar.gz': {'size': 3, 'state': 'uploaded'}}}
        done = publish(odd)
        assert done.returncode != 0 and 'never replaced' in done.stderr and calls(['release', 'upload']) == 0, (done, current())

        # Anything but a 5xx or a timeout fails at once; a 504 that does not clear fails after the retries.
        done = publish(None, (['release', 'create'], 'before', 1, 'HTTP 403: Resource not accessible by integration'))
        assert done.returncode != 0 and calls(['release', 'create']) == 1 and '403' in done.stderr, (done, current())
        done = publish(None, (['release', 'create'], 'before', 99, TIMEOUT))
        assert done.returncode != 0 and calls(['release', 'create']) == 4 and '504' in done.stderr, (done, current())
        # Publishing that took effect on the last attempt still counts as done.
        done = publish(None, (['release', 'edit'], 'before', 3, TIMEOUT), (['release', 'edit'], 'after', 1, TIMEOUT))
        assert done.returncode == 0 and published() and calls(['release', 'edit']) == 4, (done, current())

        # An archive without its sidecar is refused before gh is called.
        sidecar = dist / 'fractal-web-embed.tar.gz.sha256'
        kept = sidecar.read_text()
        sidecar.unlink()
        done = publish()
        assert done.returncode != 0 and 'no SHA-256 sidecar' in done.stderr and current()['calls'] == [], (done, current())
        sidecar.write_text(kept)
        # Archives that do not match their sidecars are refused before gh is called.
        (dist / 'fractal-web-embed.tar.gz').write_bytes(b'changed')
        done = publish()
        assert done.returncode != 0 and current()['calls'] == [], (done, current())
    print('Web embed publishing: drafts continued, pins kept, retries bounded')


if __name__ == '__main__':
    main()
