#!/usr/bin/env python3
"""Old installed entry points exec their canonical sibling without changing the call."""
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tempfile
import unittest

HERE = Path(__file__).resolve().parent
BRIDGES = {
    "idle-soak": ("bash", 0o755),
    "message-soak": ("bash", 0o644),
    "delivery-probe": ("python3", 0o755),
    "discord-bridge": ("python3", 0o755),
    "discord-probe": ("python3", 0o644),
}


class ScriptPathBridges(unittest.TestCase):
    def test_direct_and_interpreter_invocations(self):
        for name, (interpreter, mode) in BRIDGES.items():
            # Preserve non-executable installed scripts: their callers use an interpreter.
            for direct in ((True, False) if mode & 0o111 else (False,)):
                with self.subTest(bridge=name, direct=direct), tempfile.TemporaryDirectory() as tmp:
                    directory = Path(tmp)
                    old = directory / ("st3-" + name)
                    canonical = directory / ("fractal-" + name)
                    shutil.copy2(HERE / old.name, old)
                    self.assertEqual(old.stat().st_mode & 0o777, mode)
                    self.assertIn("arn:lmig:smalltalk:2026-10-27-script-paths", old.read_text())
                    # Relocate only the copied fixture's absent FHS interpreter on NixOS.
                    # Keep the source shebang and its isolated-Python behavior unchanged.
                    source = old.read_text()
                    shebang = source.splitlines()[0]
                    if direct and shebang == "#!/usr/bin/python3 -I" and not Path("/usr/bin/python3").exists():
                        old.write_text(source.replace(shebang, f"#!{sys.executable} -I", 1))
                    # A real executable sibling records the observable process contract.
                    if interpreter == "bash":
                        canonical.write_text(
                            '#!/usr/bin/env bash\n'
                            'printf "%s\\n" "$BRIDGE_VALUE" "$@"\n'
                            'cat\n'
                            'printf "bridge stderr\\n" >&2\n'
                            'exit 37\n'
                        )
                        expected = "unchanged environment\nargument with spaces\n--flag=value\nstdin payload\n"
                    else:
                        canonical.write_text(
                            '#!/usr/bin/env python3\n'
                            'import json, os, sys\n'
                            'print(json.dumps([os.environ["BRIDGE_VALUE"], sys.argv[1:], sys.stdin.read(), sys.flags.isolated]))\n'
                            'print("bridge stderr", file=sys.stderr)\n'
                            'sys.exit(37)\n'
                        )
                        isolated = int(direct and name == "discord-bridge")
                        expected = json.dumps(["unchanged environment", ["argument with spaces", "--flag=value"], "stdin payload\n", isolated]) + "\n"
                    canonical.chmod(mode)
                    command = [str(old)] if direct else [interpreter, str(old)]
                    result = subprocess.run(
                        command + ["argument with spaces", "--flag=value"],
                        input="stdin payload\n", text=True, capture_output=True,
                        env={**os.environ, "BRIDGE_VALUE": "unchanged environment"},
                    )
                    self.assertEqual(result.returncode, 37, result.stderr)
                    self.assertEqual(result.stdout, expected)
                    self.assertEqual(result.stderr, "bridge stderr\n")


if __name__ == "__main__":
    unittest.main()
