#!/usr/bin/env python3
"""The deterministic risk floor of a review (docs/review.md, evidence configuration).

  review-risk BASE HEAD     the risk of git diff BASE...HEAD by named rules, no model involved

Prints JSON: {"level": "low"|"medium"|"high", "reasons": [{"rule", "level", "paths": [...], "lines": [...]}], "changed_files": N,
"changed_lines": N, "factory_read": [{"area", "paths", "lines"}], "needs_factory_read": bool}. The level is the highest of the reasons'
levels. A review's final risk is the higher of this and the reviewing model's own score: the model may raise the risk above this floor
and never lower it. `factory_read` lists the areas (rules "factory_read") that the change touches; it never changes the level.
`needs_factory_read` is true when the level is medium and an area is touched: such a change is read by Factory before it is queued.

The rules (review-risk.json), risky classes (risky-classes.json) and engine (scripts/classify-risk)
are read from BASE, never from the head under review, so a change cannot lower its own floor by editing them. If BASE does not hold
them yet (the change that introduces them), the review fails; --rules-from-checkout reads them from the checkout instead, for that
one bootstrap case only.
Configuration resolves .fractal first, then .st only when absent at that same base (or explicitly trusted checkout).
"""
import argparse
import importlib.machinery
import importlib.util
import json
from pathlib import Path
import re
import subprocess
import sys
import tempfile
sys.dont_write_bytecode = True

RULES = ".st/review-risk.json"
ORDER = {"low": 0, "medium": 1, "high": 2}
HERE = Path(__file__).resolve().parent


def load_engine(path):
    """scripts/classify-risk, the risky-class engine this floor builds on, loaded from PATH."""
    loader = importlib.machinery.SourceFileLoader("classify_risk", str(path))
    spec = importlib.util.spec_from_loader("classify_risk", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


# arn:lmig:smalltalk:2026-10-27-dot-fractal-config — missing-only, same-authority bridge.
def config_path(repo, path, base=None):
    new = path.replace(".st/", ".fractal/", 1)
    if base is not None:
        probe = subprocess.run(["git", "ls-tree", "--full-tree", "-z", base, "--", new], cwd=repo, capture_output=True, check=True)
        return new if probe.stdout else path
    try:
        (repo / new).lstat()
    except FileNotFoundError:
        return path
    return new


def rule_files(repo, base, from_checkout, folder):
    """(rules text, risky classes text, engine module): from BASE's tree, or the checkout's when asked to."""
    wanted = {"rules": RULES, "classes": ".st/risky-classes.json", "engine": "scripts/classify-risk"}
    texts = {}
    for key, path in wanted.items():
        if path.startswith(".st/"):
            path = config_path(repo, path, None if from_checkout else base)
        if from_checkout:
            if subprocess.run(["git", "cat-file", "-e", f"{base}:{path}"], cwd=repo, capture_output=True).returncode == 0:
                raise SystemExit(f"review-risk: {base} holds {path}; it is read from there, --rules-from-checkout is only for a base that has none")
            texts[key] = (repo / path).read_text()
            continue
        shown = subprocess.run(["git", "show", f"{base}:{path}"], cwd=repo, capture_output=True, text=True)
        if shown.returncode:
            raise SystemExit(f"review-risk: {base} holds no {path}; the rules are read from the base, never from the head "
                             f"(--rules-from-checkout is for the change that introduces them)")
        texts[key] = shown.stdout
    engine_path = Path(folder) / "classify-risk"
    engine_path.write_text(texts["engine"])
    return json.loads(texts["rules"]), json.loads(texts["classes"]), load_engine(engine_path)


def unquote(name):
    """A path as git prints it in a diff header: plain, or C-quoted with octal escapes."""
    if not (name.startswith('"') and name.endswith('"')):
        return name
    out, body, index = bytearray(), name[1:-1], 0
    escapes = {"n": 10, "t": 9, "r": 13, "a": 7, "b": 8, "f": 12, "v": 11, '"': 34, "\\": 92}
    while index < len(body):
        char = body[index]
        if char != "\\":
            out += char.encode()
            index += 1
        elif body[index + 1] in escapes:
            out.append(escapes[body[index + 1]])
            index += 2
        else:
            out.append(int(body[index + 1:index + 4], 8))
            index += 4
    return out.decode(errors="replace")


TEST_MODULE = re.compile(r"^#\[cfg\(test\)\]\n(?:pub(?:\([a-z]+\))? )?mod tests \{\n", re.M)
RAW_STRING = re.compile(r'[bc]?r(#*)"')
CHAR_LITERAL = re.compile(r"'(?:\\(?:u\{[0-9a-fA-F_]+\}|x[0-9a-fA-F]{2}|.)|[^'\\\n])'")
HUNK = re.compile(r"^@@ -(\d+)(?:,\d+)? \+(\d+)(?:,\d+)? @@")


def test_block_start(text):
    """The 1-based line of the `#[cfg(test)]` that opens a trailing `mod tests { ... }` in a Rust file's TEXT, or None.

    Trailing means rustfmt-shaped and last: after the module's opening line every line is blank or indented, except the module's own
    closing brace as the file's last line. Anything else (code after the module, a raw string at column 0) is not read as a test
    block, so the lines stay scored.
    """
    found = None
    for found in TEST_MODULE.finditer(text):
        pass
    if found is None:
        return None
    rest = text[found.end():].split("\n")
    while rest and not rest[-1].strip():
        rest.pop()
    if not rest or rest[-1] != "}" or any(line and not line[0].isspace() for line in rest[:-1]):
        return None
    if not closes_only_at_the_end("\n".join(rest)):
        return None
    return text.count("\n", 0, found.start()) + 1


def closes_only_at_the_end(body):
    """True when BODY, the text after `mod tests {`, holds balanced braces that bring the module's depth to zero only at the very last
    character. Indentation is not syntax: without this, an indented `}` could close the module early and production code after it
    would pass for test code. Braces in comments, strings and char literals are not counted; anything the scan cannot tell (an
    unterminated string or comment) is not a test block, so it fails closed."""
    depth, index, size = 1, 0, len(body)
    while index < size:
        char = body[index]
        if body.startswith("//", index):
            index = body.find("\n", index)
            if index < 0:
                return False
        elif body.startswith("/*", index):
            nesting = 1
            index += 2
            while nesting:
                opens, closes = body.find("/*", index), body.find("*/", index)
                if closes < 0:
                    return False
                if 0 <= opens < closes:
                    nesting, index = nesting + 1, opens + 2
                else:
                    nesting, index = nesting - 1, closes + 2
        elif char in "brc" and RAW_STRING.match(body, index) and not (index and (body[index - 1].isalnum() or body[index - 1] == "_")):
            raw = RAW_STRING.match(body, index)
            end = body.find('"' + raw.group(1), raw.end())
            if end < 0:
                return False
            index = end + 1 + len(raw.group(1))
        elif char == '"':
            index += 1
            while index < size and body[index] != '"':
                index += 2 if body[index] == "\\" else 1
            if index >= size:
                return False
            index += 1
        elif char == "'":
            literal = CHAR_LITERAL.match(body, index)
            index = literal.end() if literal else index + 1
        elif char == "{":
            depth, index = depth + 1, index + 1
        elif char == "}":
            depth, index = depth - 1, index + 1
            if depth == 0:
                return not body[index:].strip()
        else:
            index += 1
    return False


def read_diff(repo, base, head):
    """(paths, lines): the changed paths, and per path its (marker, line) pairs, marker '+' or '-'.

    Renames are not followed: a moved file shows as a deletion of the old path and an addition of the new one, so the old path
    still counts. Paths come NUL-separated and unquoted, so a path with a non-ASCII character or a space is read as it is.

    Lines inside a trailing `#[cfg(test)] mod tests` block of a Rust file (added lines by their place in the head, removed lines by
    their place in the merge base) are test code: they are left out of the returned lines, so no content rule reads them, and counted
    only in the third value, the total of changed lines. The file still counts as changed.
    """
    names = subprocess.check_output(["git", "diff", "--name-only", "--no-renames", "-z", f"{base}...{head}"], cwd=repo, text=True, errors="replace").split("\0")
    text = subprocess.check_output(["git", "-c", "core.quotePath=false", "diff", "-U0", "--no-color", "--no-renames", f"{base}...{head}"],
                                   cwd=repo, text=True, errors="replace")
    merge_base = subprocess.run(["git", "merge-base", base, head], cwd=repo, text=True, capture_output=True).stdout.strip() or base
    starts = {}

    def block_start(revision, path):
        if not path.endswith(".rs"):
            return None
        if (revision, path) not in starts:
            shown = subprocess.run(["git", "show", f"{revision}:{path}"], cwd=repo, capture_output=True)
            starts[(revision, path)] = test_block_start(shown.stdout.decode(errors="replace")) if shown.returncode == 0 else None
        return starts[(revision, path)]

    lines, current, header, total, old_no, new_no = {}, None, False, 0, 0, 0
    for line in text.split("\n"):
        if line.startswith("diff --git"):
            current, header = None, True
        elif header and line.startswith("--- "):
            source = unquote(line[4:].rstrip("\t"))
            current = source[2:] if source.startswith("a/") else None
        elif header and line.startswith("+++ "):
            target = unquote(line[4:].rstrip("\t"))
            current = target[2:] if target.startswith("b/") else current
        elif line.startswith("@@"):
            header = False
            hunk = HUNK.match(line)
            old_no, new_no = (int(hunk.group(1)), int(hunk.group(2))) if hunk else (0, 0)
        elif not header and current and line[:1] in ("+", "-"):
            total += 1
            added = line[0] == "+"
            start = block_start(head if added else merge_base, current)
            if start is None or (new_no if added else old_no) < start:
                lines.setdefault(current, []).append((line[0], line[1:]))
            if added:
                new_no += 1
            else:
                old_no += 1
    return [name for name in names if name], lines, total


def higher(left, right):
    return left if ORDER[left] >= ORDER[right] else right


def score(rules, paths, lines, risky_classes, engine):
    """The reasons that fire, each with its level."""
    reasons = []
    plain = {path: [text for _, text in pairs] for path, pairs in lines.items()}
    for hit in engine.classify(risky_classes, paths, plain):
        setting = rules["classes"].get(hit["name"])
        if setting is None:
            # A risky class the rules do not map fails closed: the floor does not know what it is worth, so it is high.
            reasons.append({"rule": hit["name"], "level": "high", "paths": hit["paths"], "lines": hit["lines"] + ["no level for this class in " + RULES]})
            continue
        if isinstance(setting, str):
            setting = {"level": setting}
        level = setting["level"]
        # Some paths of a class may carry a lower level: the class counts at the highest level of what actually hit.
        overrides = setting.get("paths", [])
        if overrides and not hit["lines"]:
            levels = []
            for path in hit["paths"]:
                lowered = [override["level"] for override in overrides if engine.matches(override["globs"], path)]
                levels.append(lowered[0] if lowered else level)
            level = max(levels, key=ORDER.get) if levels else level
        reasons.append({"rule": hit["name"], "level": level, "paths": hit["paths"], "lines": hit["lines"]})
    for rule in rules.get("rules", []):
        by_path = sorted(path for path in paths if engine.matches(rule.get("globs", []), path)) if rule.get("globs") else []
        by_line = []
        for content in rule.get("content", []):
            pattern = re.compile(content["pattern"])
            only = content.get("only")
            for path in sorted(paths):
                if not engine.matches(content["globs"], path) or engine.matches(content.get("exclude", []), path):
                    continue
                for marker, text in lines.get(path, []):
                    if only == "added" and marker != "+" or only == "removed" and marker != "-":
                        continue
                    if pattern.search(text):
                        by_line.append(f"{path}: {marker}{text.strip()}")
        if by_path or by_line:
            reasons.append({"rule": rule["name"], "level": rule["level"], "paths": by_path, "lines": by_line[:20]})
    return reasons


def factory_read_areas(rules, paths, lines, engine):
    """The areas of RULES["factory_read"] that the change touches, each with the paths and added lines that put it there. They never
    change the level: a MEDIUM change in one of them is queued only after Factory has read it."""
    areas = []
    for area in rules.get("factory_read", []):
        exclude = area.get("exclude", [])
        by_path = sorted(path for path in paths if engine.matches(area.get("globs", []), path) and not engine.matches(exclude, path))
        by_line = []
        for content in area.get("content", []):
            pattern = re.compile(content["pattern"])
            only = content.get("only")
            for path in sorted(paths):
                if not engine.matches(content["globs"], path) or engine.matches(content.get("exclude", []), path):
                    continue
                for marker, text in lines.get(path, []):
                    if only == "added" and marker != "+" or only == "removed" and marker != "-":
                        continue
                    if pattern.search(text):
                        by_line.append(f"{path}: {marker}{text.strip()}")
        if by_path or by_line:
            areas.append({"area": area["name"], "paths": sorted(set(by_path) | {line.split(": ", 1)[0] for line in by_line}), "lines": by_line[:20]})
    return areas


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("base")
    parser.add_argument("head")
    parser.add_argument("--repo", type=Path, default=HERE.parent)
    parser.add_argument("--rules-from-checkout", action="store_true", help="read the rules and the engine from the checkout, not from BASE (bootstrap only)")
    args = parser.parse_args()
    with tempfile.TemporaryDirectory(prefix="review-risk-") as folder:
        rules, risky, engine = rule_files(args.repo, args.base, args.rules_from_checkout, folder)
        if rules.get("version") != 1:
            raise SystemExit(f"{RULES}: unsupported version")
        paths, lines, changed = read_diff(args.repo, args.base, args.head)
        reasons = score(rules, paths, lines, risky, engine)
        areas = factory_read_areas(rules, paths, lines, engine)
    large = rules.get("large")
    if large and changed >= large["changed_lines"]:
        reasons.append({"rule": "large-change", "level": large["level"], "paths": [], "lines": [f"{changed} changed lines (at least {large['changed_lines']})"]})
    level = "low"
    for reason in reasons:
        level = higher(level, reason["level"])
    print(json.dumps({"level": level, "reasons": reasons, "factory_read": areas, "needs_factory_read": level == "medium" and bool(areas),
                      "changed_files": len(paths), "changed_lines": changed}, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
