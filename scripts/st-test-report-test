#!/usr/bin/env python3
"""scripts/st-test-report on written run records: nearest-rank percentiles, the runs left out and why, the breach rules, hosts, markdown."""
import contextlib
import datetime
import importlib.machinery
import importlib.util
import io
import json
import os
from pathlib import Path
import sys
import tempfile
import unittest
from unittest import mock

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
loader = importlib.machinery.SourceFileLoader('st_test_report', str(ROOT / 'scripts/st-test-report'))
st_report = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
loader.exec_module(st_report)
NOW = datetime.datetime(2026, 10, 24, 12, 0, tzinfo=datetime.timezone.utc)


def record(total, hours_ago=1, host='box-a', full=True, warm=True, code=0, stages=None, rows=None, tree='t' * 40):
    ended = (NOW - datetime.timedelta(hours=hours_ago)).strftime('%Y-%m-%dT%H:%M:%SZ')
    return {'v': 1, 'started': ended, 'ended': ended, 'total_s': total, 'host': host, 'tree': tree, 'commit': 'c' * 40, 'base': 'b' * 40,
            'behind': 0, 'full': full, 'checks': ['linux-gate'], 'pool_tree': 0, 'warm': warm, 'parallel': True,
            'rows': rows if rows is not None else [{'name': 'linux-gate', 'result': 'passed', 'seconds': total}], 'exit': code,
            'stages': stages or []}


class StTestReport(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)

    def write(self, records, name='runs.jsonl', extra=''):
        path = Path(self.tmp.name) / name
        path.write_text(''.join(json.dumps(r) + '\n' for r in records) + extra)
        return path

    def run_report(self, *args, env=None):
        out, err = io.StringIO(), io.StringIO()
        with mock.patch.dict(os.environ, env or {}), contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
            code = st_report.main(list(args), now=NOW)
        return code, out.getvalue(), err.getvalue()

    def result(self, *records, args=()):
        code, out, err = self.run_report(str(self.write(records)), *args)
        self.assertEqual(code, 0, err)
        return json.loads(out)

    def test_percentiles_are_nearest_rank(self):
        values = list(range(10, 110, 10))  # 10 .. 100
        self.assertEqual((st_report.percentile(values, 0.5), st_report.percentile(values, 0.9)), (50, 90))
        self.assertEqual(st_report.percentile([7], 0.9), 7)
        self.assertEqual(st_report.percentile([300, 100, 200], 0.9), 300)  # ceil(2.7) - 1 = 2
        self.assertEqual(st_report.percentile([1, 2, 3, 4], 0.5), 2)
        self.assertIsNone(st_report.percentile([], 0.5))
        result = self.result(*(record(total) for total in (600, 500, 700, 400, 650)))
        self.assertEqual((result['count'], result['p50_s'], result['p90_s'], result['max_s'], result['within_slo']), (5, 600, 700, 700, 1.0))
        self.assertFalse(result['breach'])
        self.assertEqual(result['breach_reasons'], [])

    def test_only_full_warm_completed_runs_in_the_window_count_and_the_rest_are_counted_by_reason(self):
        # exit 4: a lane edit ran nothing for some check (a real one took 89 s), so it is not a run of the suite
        result = self.result(record(600), record(610), record(89, code=4), record(100, full=False), record(2000, warm=False),
                             record(2000, warm=None), record(300, code=1), record(5000, hours_ago=30))
        self.assertEqual(result['count'], 2)
        self.assertEqual(result['excluded'], {'not_full': 1, 'cold': 2, 'partial': 1, 'failed': 1})
        self.assertEqual([run['total_s'] for run in result['runs']], [600, 610])
        self.assertEqual(sorted(result['runs'][0]), ['ended', 'host', 'total_s', 'tree'])
        # A wider window takes the old run in; --since sets the start itself.
        self.assertEqual(self.result(record(600), record(650, hours_ago=30), args=('--hours', '48'))['count'], 2)
        self.assertEqual(self.result(record(600, hours_ago=3), record(650), args=('--since', '2026-10-24T10:00:00Z'))['runs'][0]['total_s'], 650)

    def test_breach_is_a_p90_over_the_objective_or_any_run_over_the_maximum(self):
        within = self.result(*(record(700) for _ in range(9)), record(890))
        self.assertEqual((within['p90_s'], within['breach']), (700, False), 'one slow run under the maximum is within: p90 is the ninth')
        self.assertEqual(within['within_slo'], 0.9)
        slow = self.result(*(record(700) for _ in range(8)), record(800), record(800))
        self.assertTrue(slow['breach'])
        self.assertEqual(slow['breach_reasons'], ['p90 800s is over the 720s objective'])
        spike = self.result(*(record(600) for _ in range(19)), record(901))
        self.assertEqual((spike['p90_s'], spike['breach']), (600, True))
        self.assertEqual(spike['breach_reasons'], ['1 full warm run(s) over 900s (slowest 901s)'])
        self.assertFalse(self.result(record(800), args=('--slo-s', '900'))['breach'])
        empty = self.result(record(5000, warm=False))
        self.assertEqual((empty['count'], empty['p50_s'], empty['p90_s'], empty['max_s'], empty['within_slo'], empty['breach']),
                         (0, None, None, None, None, False))

    def test_by_host_and_the_slowest_use_the_stages_when_a_run_has_them(self):
        stage = lambda name, seconds: {'name': name, 'start': 's', 'end': 'e', 'seconds': seconds, 'exit': 0, 'queue_waits': 0, 'queue_s': 0}
        rows = [{'name': 'linux-gate', 'result': 'passed', 'seconds': 500}, {'name': 'typescript-client', 'result': 'passed', 'seconds': 200}]
        result = self.result(record(600, host='box-a', stages=[stage('setup', 60), stage('tests', 400), stage('clippy', 100)]),
                             record(700, host='box-a', stages=[stage('setup', 80), stage('tests', 500)]),
                             record(650, host='box-b', rows=rows))
        self.assertEqual(result['by_host'], {'box-a': {'count': 2, 'p50_s': 600, 'p90_s': 700, 'max_s': 700},
                                             'box-b': {'count': 1, 'p50_s': 650, 'p90_s': 650, 'max_s': 650}})
        self.assertEqual([(row['name'], row['kind'], row['mean_s'], row['p90_s']) for row in result['slowest']],
                         [('linux-gate', 'check', 500.0, 500), ('tests', 'stage', 450.0, 500), ('typescript-client', 'check', 200.0, 200),
                          ('clippy', 'stage', 100.0, 100), ('setup', 'stage', 70.0, 80)])

    def test_lines_that_are_not_records_are_counted_and_an_unreadable_file_is_an_error(self):
        path = self.write([record(600)], extra='not json\n{"v": 2, "total_s": 1, "ended": "2026-10-24T11:00:00Z"}\n\n')
        code, out, err = self.run_report(str(path))
        self.assertEqual(code, 0, err)
        self.assertEqual((json.loads(out)['count'], json.loads(out)['unreadable']), (1, 2))
        code, out, err = self.run_report(str(Path(self.tmp.name) / 'missing.jsonl'))
        self.assertEqual((code, out), (1, ''))
        self.assertIn('cannot read the runs', err)
        self.assertEqual(self.run_report(str(path), '--hours', '0')[0], 2)

    def test_several_files_are_read_together_and_the_default_is_st_test_s_own_file(self):
        first, second = self.write([record(600, host='box-a')], 'a.jsonl'), self.write([record(700, host='box-b')], 'b.jsonl')
        code, out, err = self.run_report(str(first), str(second))
        self.assertEqual((code, sorted(json.loads(out)['by_host'])), (0, ['box-a', 'box-b']), err)
        state = Path(self.tmp.name) / 'state'
        (state / 'st-test').mkdir(parents=True)
        (state / 'st-test/runs.jsonl').write_text(json.dumps(record(640)) + '\n')
        code, out, err = self.run_report(env={'XDG_STATE_HOME': str(state), 'ST_TEST_RUNS': ''})
        self.assertEqual((code, json.loads(out)['max_s']), (0, 640), err)
        code, out, err = self.run_report(env={'XDG_STATE_HOME': str(state), 'ST_TEST_RUNS': str(second)})
        self.assertEqual((code, json.loads(out)['max_s']), (0, 700), err)

    def test_markdown_prints_the_table_and_the_breach_line(self):
        path = self.write([record(600, host='box-a'), record(1000, host='box-b'), record(50, full=False)])
        code, out, err = self.run_report(str(path), '--markdown')
        self.assertEqual(code, 0, err)
        self.assertIn('2 counted (left out: 1 not_full)', out)
        self.assertIn('| all | 2 | 600s | 1000s | 1000s |', out)
        self.assertIn('| box-b | 1 | 1000s | 1000s | 1000s |', out)
        self.assertIn('| linux-gate (check) | 800.0s | 1000s |', out)
        self.assertIn('**Breach**: p90 1000s is over the 720s objective; 1 full warm run(s) over 900s (slowest 1000s)', out)
        code, out, err = self.run_report(str(self.write([], 'empty.jsonl')), '--markdown')
        self.assertEqual(code, 0, err)
        self.assertIn('| all | 0 | - | - | - |', out)
        self.assertIn('No full warm run in the window', out)
        self.assertIn('**Within the objective.**', self.run_report(str(self.write([record(600)], 'ok.jsonl')), '--markdown')[1])

    def test_a_record_st_test_writes_is_one_the_report_reads(self):
        """The two scripts agree on the record: st-test's own writer, read back here."""
        st_loader = importlib.machinery.SourceFileLoader('st_test_for_report', str(ROOT / 'scripts/st-test'))
        st_test = importlib.util.module_from_spec(importlib.util.spec_from_loader(st_loader.name, st_loader))
        st_loader.exec_module(st_test)
        path = Path(self.tmp.name) / 'written/runs.jsonl'
        with mock.patch.dict(st_test.POOL_SETTINGS, {'ST_TEST_RUNS': str(path)}):
            st_test.record_run(record(610))
        records, unreadable = st_report.read_records([path])
        self.assertEqual((len(records), unreadable, records[0]['total_s']), (1, 0, 610))


if __name__ == '__main__':
    unittest.main()
