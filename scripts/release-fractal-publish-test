#!/usr/bin/env python3
"""Exercise exact-SHA GO gating without GitHub writes or artifact builds."""
import json
from pathlib import Path
import runpy
import subprocess
import unittest
from unittest.mock import patch
import zipfile

module = runpy.run_path(str(Path(__file__).with_name('release-fractal-publish')))
publish = module['publish']
SHA = 'a' * 40


class PublishTest(unittest.TestCase):
    def attempt(self, *, sha=SHA, go='https://example.invalid/comment/123', draft=True,
                prerelease=False, target=SHA, tag_source=None, artifact_source=SHA, missing=False,
                newer=False, allow_superseded='', build_fields=None, build_source=SHA,
                build_sums='verified sums', proof_source=SHA, proof_run=7, workflow_id=42,
                proof_attempt=1, run_attempt=1, expired_artifact=False, proof_artifact=701,
                artifact_id=701, artifact_name=None, duplicate_artifact=False,
                attempt_after_verification=None):
        calls = []
        verified_build = False
        summary = '## Operator impact summary\n\nOperator-approved wording: preserve exactly.\n\nCandidate notes'

        def run(*args, **kwargs):
            nonlocal verified_build
            calls.append(args)
            if args[:3] == ('gh', 'release', 'view'):
                return json.dumps(dict(isDraft=draft, isPrerelease=prerelease,
                                       targetCommitish=target, body=summary))
            if args[:2] == ('gh', 'api'):
                if args[2].endswith('/actions/workflows/release-fractal.yml'):
                    return json.dumps({'id': 42})
                if args[2].endswith('/artifacts'):
                    artifact = dict(id=artifact_id,
                                    name=artifact_name or f'fractal-release-attempt-{proof_attempt}',
                                    expired=expired_artifact)
                    return json.dumps([{'artifacts': [dict(id=700, name='fractal-release', expired=False),
                                                       dict(id=699, name='fractal-release-attempt-99', expired=False)]},
                                       {'artifacts': [artifact] * (2 if duplicate_artifact else 1)}])
                if '/attempts/' in args[2]:
                    self.assertEqual(args[2], f'repos/example/project/actions/runs/7/attempts/{proof_attempt}')
                    fields = dict(id=7, status='completed', conclusion='success', workflow_id=workflow_id,
                                  run_attempt=proof_attempt, event='push', head_branch='main',
                                  head_sha=SHA, display_title='Main build')
                    fields.update(build_fields or {})
                    return json.dumps(fields)
                if '/actions/runs/' in args[2]:
                    current = (attempt_after_verification if verified_build
                               and attempt_after_verification is not None else run_attempt)
                    return json.dumps({'workflow_id': workflow_id, 'run_attempt': current})
                return json.dumps([[dict(tag_name='v1.2.4', draft=True, prerelease=False)]] if newer else [[]])
            if args[:2] == ('git', 'ls-remote'):
                return f'{tag_source}\trefs/tags/v1.2.3' if tag_source else ''
            if args[:3] == ('gh', 'release', 'download'):
                dist = Path(args[-1])
                (dist / 'RELEASE.json').write_text(json.dumps({'source': artifact_source}))
                (dist / 'RELEASE-NOTES.md').write_text('Complete notes')
                (dist / 'CANDIDATE.json').write_text(json.dumps({
                    'source': proof_source, 'build_run': proof_run, 'build_attempt': proof_attempt,
                    'build_artifact': proof_artifact}))
                (dist / 'SHA256SUMS').write_text('verified sums')
                if not missing:
                    (dist / 'UPGRADE-IMPACT.json').write_text('{}')
            if args[0] == 'python3' and Path(kwargs['cwd']).name == 'build-proof':
                verified_build = True
            if args[:3] == ('gh', 'release', 'edit'):
                notes = Path(args[args.index('--notes-file') + 1]).read_text()
                self.assertTrue(notes.startswith(summary + '\n\n## Product release GO\n'))
                self.assertEqual(args[args.index('--target') + 1], SHA)
                self.assertIn('https://github.com/example/project/actions/runs/123', notes)
                self.assertEqual((Path(args[args.index('--notes-file') + 1]).parent / 'RELEASE-NOTES.md').read_text(), 'Complete notes')
                self.assertIn(SHA, notes)
                self.assertIn(go, notes)
                self.assertIn('--draft=false', args)
            return ''

        def download(args, *, check, stdout):
            calls.append(tuple(args))
            self.assertTrue(check)
            self.assertEqual(args, ['gh', 'api', f'repos/example/project/actions/artifacts/{artifact_id}/zip'])
            with zipfile.ZipFile(stdout, 'w') as archive:
                archive.writestr('RELEASE.json', json.dumps({'source': build_source}))
                archive.writestr('SHA256SUMS', build_sums)
            return subprocess.CompletedProcess(args, 0)

        with patch.dict(publish.__globals__, run=run), \
                patch('release_artifact.subprocess.run', side_effect=download), \
                patch.dict(module['os'].environ, GH_REPO='example/project', GITHUB_RUN_ID='123',
                           GITHUB_SERVER_URL='https://github.com', GITHUB_ACTOR='release-operator'):
            try:
                publish('v1.2.3', sha, go, allow_superseded)
                error = None
            except (ValueError, subprocess.CalledProcessError) as caught:
                error = caught
        return error, calls

    def test_publish(self):
        error, calls = self.attempt()
        self.assertIsNone(error)
        self.assertEqual(calls[-2], ('gh', 'api', 'repos/example/project/actions/runs/7'))
        self.assertEqual(calls[-1][:3], ('gh', 'release', 'edit'))
        self.assertTrue(any(call[0] == 'sha256sum' for call in calls))
        self.assertTrue(any(call[0] == 'python3' for call in calls))
        self.assertFalse(any('release_notes.py' in str(call) for call in calls))

    def test_explicit_supersession_override(self):
        error, calls = self.attempt(newer=True, allow_superseded='v1.2.3')
        self.assertIsNone(error)
        self.assertTrue(any(call[:3] == ('gh', 'release', 'edit') for call in calls))

    def test_exact_dispatch_build(self):
        error, calls = self.attempt(build_fields=dict(event='workflow_dispatch', head_sha='b' * 40,
                                                      display_title=f'Fractal candidate {SHA} request'))
        self.assertIsNone(error)
        self.assertTrue(any(call[:3] == ('gh', 'release', 'edit') for call in calls))

    def test_failed_or_mismatched_build_never_publishes(self):
        for changes in (
                {'build_fields': {'conclusion': 'failure'}}, {'build_fields': {'status': 'in_progress'}},
                {'build_fields': {'head_sha': 'b' * 40}}, {'build_fields': {'head_branch': 'feature'}},
                {'workflow_id': 99},
                {'build_fields': {'id': 8}}, {'build_fields': {'run_attempt': 2}},
                {'build_fields': {'event': 'workflow_dispatch', 'display_title': 'unrelated build'}},
                {'build_source': 'b' * 40}, {'build_sums': 'different sums'},
                {'proof_source': 'b' * 40}, {'proof_run': 0}):
            with self.subTest(changes=changes):
                error, calls = self.attempt(**changes)
                self.assertIsNotNone(error)
                self.assertFalse(any(call[:3] == ('gh', 'release', 'edit') for call in calls))

    def test_other_workflow_with_identical_display_name_is_refused(self):
        error, calls = self.attempt(workflow_id=99)
        self.assertIn('different workflow ID', str(error))
        self.assertFalse(any(call[:3] == ('gh', 'release', 'edit') for call in calls))

    def test_display_name_is_not_the_workflow_identity(self):
        error, calls = self.attempt(build_fields={'workflowName': 'Renamed tag release'})
        self.assertIsNone(error)
        self.assertTrue(any(call[:3] == ('gh', 'release', 'edit') for call in calls))

    def test_expired_build_artifact_is_refused(self):
        error, calls = self.attempt(expired_artifact=True)
        self.assertIn('exactly one unexpired release artifact', str(error))
        self.assertFalse(any(call[:3] == ('gh', 'release', 'edit') for call in calls))

    def test_rerun_requires_a_candidate_for_that_attempt(self):
        error, calls = self.attempt(run_attempt=2)
        self.assertIn('rerun', str(error))
        self.assertFalse(any(call[:3] == ('gh', 'release', 'edit') for call in calls))
        error, calls = self.attempt(run_attempt=2, proof_attempt=2)
        self.assertIsNone(error)
        self.assertTrue(any(call[:3] == ('gh', 'release', 'edit') for call in calls))

    def test_attempt_flip_after_verification_never_publishes(self):
        error, calls = self.attempt(attempt_after_verification=2)
        self.assertIn('rerun', str(error))
        self.assertTrue(any(call[0] == 'python3' and 'manifest' in str(call) for call in calls))
        self.assertIn(('gh', 'api', 'repos/example/project/actions/artifacts/701/zip'), calls)
        self.assertEqual(calls[-1], ('gh', 'api', 'repos/example/project/actions/runs/7'))
        self.assertFalse(any(call[:3] == ('gh', 'release', 'edit') for call in calls))

    def test_attempt_artifact_binding(self):
        for changes in ({'proof_artifact': 702}, {'proof_artifact': 0},
                        {'proof_artifact': True}, {'proof_artifact': '701'},
                        {'artifact_id': '701'}, {'artifact_name': 'fractal-release'},
                        {'artifact_name': 'fractal-release-attempt-2'}, {'duplicate_artifact': True}):
            with self.subTest(changes=changes):
                error, calls = self.attempt(**changes)
                self.assertIsNotNone(error)
                self.assertFalse(any('/zip' in str(call) for call in calls))
                self.assertFalse(any(call[:3] == ('gh', 'release', 'edit') for call in calls))

    def test_refusals_never_publish(self):
        for changes in ({'sha': 'abc'}, {'go': ''}, {'go': ' \n '}, {'draft': False},
                        {'prerelease': True}, {'target': 'b' * 40},
                        {'tag_source': 'b' * 40}, {'artifact_source': 'b' * 40}, {'missing': True},
                        {'newer': True}, {'newer': True, 'allow_superseded': 'v1.2.2'}):
            with self.subTest(changes=changes):
                error, calls = self.attempt(**changes)
                self.assertIsNotNone(error)
                self.assertFalse(any(call[:3] == ('gh', 'release', 'edit') for call in calls))


if __name__ == '__main__':
    unittest.main()
