#!/usr/bin/env python3
"""Which checks our pull request runs skipped, and why the others ran: a daily count for the per-PR suite.

  scripts/evidence-skip-report [--repo OWNER/NAME] [--hours 24] [--actor LOGIN]... [--receipts FILE]... [--cache DIR] [--markdown]

It reads the `Workspace CI` (fleet.yml) pull_request runs that ended in the window (by creation, as scripts/evidence-flip-ready does), keeps
those started by one of the --actor accounts (all when none is given), and reads each `evidence-gate-<check>` job's decision line. Each
check of each run is counted once, as:

  skipped     the gate skipped the check (decision=skip)
  lane_edit   the pull request changes a file of the check's lane (definition_paths in .st/required-lanes.json at the run's base): a local
              run cannot sign such a tree, so CI runs it
  merge_tree  the gate asked about the merge tree instead of the head (tree_of=merge: a protected file changed since the branch point,
              an author is not listed, the branch is too far behind) and no note covered it: a pushed head's note could not count
  not_signed  no note covered the tree (outcome no_note; for rust-tests, a crate without a note) although the pull request leaves the lane
              alone: it was pushed unsigned
  failed      a note covered the tree but recorded a failure (reason check_failed)
  protected   a trusted note covered it but the pull request changes a file that decides skipping (the gate, verifier, policy, keys...)
  sampled     a trusted note covered it and the run was sampled to run anyway (one in five)
  shadow      a trusted note covered it but the check's skip is not turned on (enforce false)
  other       any other reason (the outcome and reason are kept)

The not_signed pull requests are listed with their branch and, when a pre-push receipts file (--receipts, JSON lines with `branch` and
`agent`, as scripts/evidence-prepush writes) names the branch, the seat that pushed it. Prints JSON, or a short table with --markdown.
Read only; exit 2 when GitHub cannot be read.
"""
import argparse
import collections
import datetime
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import sys

sys.dont_write_bytecode = True

ROOT = Path(__file__).resolve().parent.parent
LANES = '.st/required-lanes.json'
_loader = importlib.machinery.SourceFileLoader('evidence_flip_ready', str(Path(__file__).resolve().parent / 'evidence-flip-ready'))
flip = importlib.util.module_from_spec(importlib.util.spec_from_loader(_loader.name, _loader))
_loader.exec_module(flip)
CATEGORIES = ('skipped', 'lane_edit', 'merge_tree', 'not_signed', 'failed', 'protected', 'sampled', 'shadow', 'other')


def lanes_at(root, base, runner, cache):
    """{check: definition_paths} from the selected revision only; retry fetching an unavailable base."""
    if base in cache:
        return cache[base]
    revision = base or 'origin/main'
    try:
        path = flip.config_path(root, LANES, revision, runner)
        text = flip.git(root, 'show', f'{revision}:{path}', runner=runner)
    except RuntimeError:
        if not base:
            raise
        flip.git(root, 'fetch', '-q', 'origin', base, runner=runner)
        path = flip.config_path(root, LANES, revision, runner)
        text = flip.git(root, 'show', f'{revision}:{path}', runner=runner)
    data = json.loads(text)
    lanes = {name: list(lane.get('definition_paths') or []) for name, lane in (data.get('lanes') or data).items()}
    cache[base] = lanes
    return cache[base]


def touches(files, paths):
    """Whether a changed file is one of `paths` or under one of them."""
    return any(name == path or name.startswith(path.rstrip('/') + '/') for name in files for path in paths)


def pr_of(github, run):
    """(number, branch) of the run's pull request."""
    listed = run.get('pull_requests') or []
    if listed and listed[0].get('number'):
        return listed[0]['number'], run.get('head_branch')
    pulls = json.loads(github.gh('api', f'repos/{github.repo}/commits/{run.get("head_sha")}/pulls'))
    return (pulls[0]['number'] if pulls else None), run.get('head_branch')


def pr_files(github, number, cache):
    if number not in cache:
        pages = json.loads(github.gh('api', '--paginate', '--slurp', f'repos/{github.repo}/pulls/{number}/files?per_page=100'))
        cache[number] = [item['filename'] for page in pages for item in page]
    return cache[number]


def classify(fields, lane_edit):
    if fields.get('decision') == 'skip':
        return 'skipped'
    if lane_edit:
        return 'lane_edit'
    outcome, reason = fields.get('outcome'), fields.get('reason') or ''
    uncovered = outcome == 'no_note' or reason == 'crate_uncovered'
    if uncovered and fields.get('tree_of') == 'merge':
        return 'merge_tree'
    if uncovered:  # crate_uncovered read `rejected` before the gate called it no_note
        return 'not_signed'
    if reason == 'check_failed':
        return 'failed'
    if outcome == 'satisfied' and 'a_file_that_decides' in reason:
        return 'protected'
    if outcome == 'satisfied' and 'sampled' in reason:
        return 'sampled'
    if outcome == 'satisfied' and 'shadow' in reason:
        return 'shadow'
    return 'other'


def seats(receipts):
    """{branch: seat} from pre-push receipts (the last receipt for a branch wins)."""
    found = {}
    for path in receipts:
        try:
            lines = Path(path).read_text(errors='replace').splitlines()
        except OSError:
            continue
        for line in lines:
            try:
                record = json.loads(line)
            except ValueError:
                continue
            if isinstance(record, dict) and record.get('branch') and record.get('agent'):
                found[record['branch']] = record['agent']
    return found


def report(github, root, runner, since, until, actors, receipts):
    runs = [run for run in flip.pr_runs(github, since, until) if run.get('status') == 'completed'
            and (not actors or ((run.get('actor') or {}).get('login') in actors))]
    counts = collections.defaultdict(collections.Counter)
    others = collections.defaultdict(collections.Counter)
    unsigned = {}
    lane_cache, file_cache = {}, {}
    for run in runs:
        jobs = github.items(f'repos/{github.repo}/actions/runs/{run["id"]}/jobs?per_page=100&filter=latest', 'jobs')
        number, branch = None, run.get('head_branch')
        for job in jobs:
            check = (job.get('name') or '').removeprefix('evidence-gate-')
            if check == job.get('name') or job.get('status') != 'completed' or job.get('conclusion') == 'skipped':
                continue
            lines = [flip.fields_of(text) for text in flip.lines_of(github, job)]
            fields = next((line for line in lines if line.get('check') == check), None)
            if fields is None:
                continue
            lane_edit = False
            if fields.get('decision') != 'skip':
                if number is None:
                    number, branch = pr_of(github, run)
                lanes = lanes_at(root, fields.get('base'), runner, lane_cache)
                lane_edit = bool(number) and check in lanes and touches(pr_files(github, number, file_cache), lanes[check])
            category = classify(fields, lane_edit)
            counts[check][category] += 1
            if category == 'other':
                others[check][f'{fields.get("outcome")}:{(fields.get("reason") or "")[:40]}'] += 1
            if category == 'not_signed' and number:
                entry = unsigned.setdefault(number, {'pr': number, 'branch': branch, 'checks': set(), 'runs': set()})
                entry['checks'].add(check)
                entry['runs'].add(run['id'])
    by_branch = seats(receipts)
    listed = [{'pr': entry['pr'], 'branch': entry['branch'], 'seat': by_branch.get(entry['branch'], 'unknown'),
               'checks': sorted(entry['checks']), 'runs': len(entry['runs'])} for entry in sorted(unsigned.values(), key=lambda e: e['pr'])]
    return {'window': {'since': flip.iso(since), 'until': flip.iso(until)}, 'actors': sorted(actors), 'runs': len(runs),
            'checks': {check: {category: counts[check][category] for category in CATEGORIES} for check in sorted(counts)},
            'other_reasons': {check: dict(others[check]) for check in sorted(others)}, 'not_signed': listed}


def markdown(result):
    lines = [f"**Our pull request runs**, {result['window']['since']} .. {result['window']['until']}: {result['runs']} runs"
             + (f" (accounts: {', '.join(result['actors'])})" if result['actors'] else ''), '',
             '| check | skipped | ran: lane edit | ran: merge tree | ran: not signed | ran: failed | ran: protected file | ran: sampled | ran: shadow | ran: other |',
             '|---|---:|---:|---:|---:|---:|---:|---:|---:|---:|']
    for check, row in result['checks'].items():
        lines.append(f"| {check} | " + ' | '.join(str(row[category]) for category in CATEGORIES) + ' |')
    if result['not_signed']:
        lines += ['', 'Not signed (pushed without a covering note, lane untouched):', '']
        lines += [f"- #{entry['pr']} `{entry['branch']}`, seat {entry['seat']}: {', '.join(entry['checks'])} ({entry['runs']} run(s))"
                  for entry in result['not_signed']]
    return '\n'.join(lines) + '\n'


def main(argv, runner=flip.default_runner, now=None, root=ROOT):
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('--repo', default='compoundingtech/fractal')
    parser.add_argument('--hours', type=float, default=24)
    parser.add_argument('--actor', action='append', default=[], help='keep runs started by this account (repeatable; default all)')
    parser.add_argument('--receipts', action='append', default=[], help='pre-push receipts (JSON lines with branch and agent)')
    parser.add_argument('--cache', default=os.path.join(os.environ.get('XDG_CACHE_HOME') or os.path.expanduser('~/.cache'), 'evidence-flip-ready'))
    parser.add_argument('--markdown', action='store_true')
    args = parser.parse_args(argv)
    now = now or datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0)
    github = flip.GitHub(args.repo, runner, args.cache)
    try:
        result = report(github, root, runner, now - datetime.timedelta(hours=args.hours), now, set(args.actor), args.receipts)
    except (flip.Unreadable, RuntimeError, ValueError, KeyError) as error:
        print(f'could not read GitHub or selected base: {error}', file=sys.stderr)
        return 2
    print(markdown(result) if args.markdown else json.dumps(result, indent=2))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
