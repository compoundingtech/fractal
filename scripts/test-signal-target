#!/usr/bin/env python3
"""Run an installer fixture whose helpers may request TERM over a private pipe.

Only this launcher signals its own unreaped child. A delayed or orphaned helper
can write a request, but cannot discover and signal a new parent/user manager.
"""
import os
import selectors
import signal
import subprocess
import sys


def main(command):
    reader, writer = os.pipe()
    try:
        child = subprocess.Popen(command, pass_fds=(writer,),
            env={**os.environ, "INSTALL_TEST_SIGNAL_FD": str(writer)})
    finally:
        os.close(writer)
    try:
        requested = False
        with selectors.DefaultSelector() as ready:
            ready.register(reader, selectors.EVENT_READ)
            while child.poll() is None:
                if ready.select(0.05):
                    request = os.read(reader, 1)
                    if request == b"T" and not requested:
                        requested = True
                        child.send_signal(signal.SIGTERM)
                    elif not request:
                        ready.unregister(reader)
            code = child.wait()
            return code if code >= 0 else 128 - code
    finally:
        if child.poll() is None:
            child.kill()
            child.wait()
        os.close(reader)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
