#!/usr/bin/env python3
"""Exercise web-skip-proof against a scratch repository with the real detector, verifier and policy."""

import json
import os
from pathlib import Path
import shutil
import subprocess
import tempfile

root = Path(__file__).resolve().parent.parent
tool = root / "scripts/web-skip-proof"
clean = {key: value for key, value in os.environ.items() if not key.startswith("GIT_")}


def git(repo, *args):
    command = ["git", "-c", "commit.gpgsign=false", "-c", "core.hooksPath=/dev/null", "-c", "user.name=t", "-c", "user.email=t@t", "-C", str(repo), *args]
    return subprocess.run(command, check=True, capture_output=True, text=True, env=clean).stdout.strip()


def commit(repo, message, files):
    for path, content in files.items():
        (repo / path).parent.mkdir(parents=True, exist_ok=True)
        (repo / path).write_text(content)
    git(repo, "add", "-A")
    git(repo, "commit", "-q", "-m", message)
    return git(repo, "rev-parse", "HEAD")


def run(repo, *args):
    done = subprocess.run([str(tool), *args], cwd=repo, capture_output=True, text=True, env=clean)
    assert done.returncode == 0, done.stderr
    return done.stdout


def decisions(repo, base, head):
    lines = [line for line in run(repo, "--base", base, "--head", head).splitlines() if not line.startswith("#")]
    return {fields["check"]: fields for fields in (dict(part.split("=", 1) for part in line.split()) for line in lines)}


with tempfile.TemporaryDirectory() as scratch:
    repo = Path(scratch)
    git(repo, "init", "-q")
    for path in ("scripts/ci-fractal-web-changes", "scripts/evidence-verify", ".st/evidence-skip-policy.json"):
        (repo / path).parent.mkdir(parents=True, exist_ok=True)
        source = root / path
        if path.startswith(".st/"):
            # arn:lmig:smalltalk:2026-10-27-dot-fractal-config — live source, historical destination.
            source = root / path.replace(".st/", ".fractal/", 1)
            try:
                source.lstat()
            except FileNotFoundError:
                source = root / path
        shutil.copy(source, repo / path)
    base = commit(repo, "base", {
        "packages/fractal-ui/src/Kit.tsx": "kit\n", "apps/fractal-web/src/App.tsx": "app\n",
        "apps/fractal-web/src/changelog/seen.ts": "seen\n", "crates/fractal/src/lib.rs": "rust\n",
        "pnpm-lock.yaml": "lock\n", "package.json": "{}\n",
    })
    at_base = decisions(repo, base, base)
    assert set(at_base) == {"fractal-web", "fractal-web-kit"}
    for line in at_base.values():
        # The real policy declares fractal-web in shadow and no fractal-web-kit: a key, no trusted record, so both run.
        assert line["decision"] == "run" and line["reason"] == "no-record" and line["proof"] == "none", line
        assert len(line["key"]) == 40 and len(line["inputs_sha256"]) == 64, line

    rust = commit(repo, "rust only", {"crates/fractal/src/lib.rs": "rust 2\n"})
    assert {name: line["key"] for name, line in decisions(repo, base, rust).items()} == {name: line["key"] for name, line in at_base.items()}
    app = commit(repo, "app only", {"apps/fractal-web/src/App.tsx": "app 2\n"})
    after_app = decisions(repo, base, app)
    assert after_app["fractal-web"]["key"] != at_base["fractal-web"]["key"]
    assert after_app["fractal-web-kit"]["key"] == at_base["fractal-web-kit"]["key"], "an app-only change keeps the kit key"
    kit = commit(repo, "kit", {"packages/fractal-ui/src/Kit.tsx": "kit 2\n"})
    after_kit = decisions(repo, base, kit)
    assert all(after_kit[name]["key"] != after_app[name]["key"] for name in after_kit)
    print("passed: input keys hold across changes outside a check's inputs and move with changes inside them")

    claims = dict(line.split("\t") for line in run(repo, "--base", base, "claims", "crates/fractal/src/lib.rs", "apps/fractal-web/src/App.tsx", "pnpm-lock.yaml").splitlines())
    assert claims == {"crates/fractal/src/lib.rs": "not-mine", "apps/fractal-web/src/App.tsx": "owned:fractal-web", "pnpm-lock.yaml": "owned:fractal-web,fractal-web-kit"}, claims
    kit_inputs = run(repo, "--base", base, "inputs", "fractal-web-kit").split()
    assert "packages/fractal-ui" in kit_inputs and "pnpm-lock.yaml" in kit_inputs and "apps/fractal-web" not in kit_inputs, kit_inputs
    assert not any(path.startswith("packages/fractal-ui/") for path in kit_inputs), "a declared directory stands for its files"
    print("passed: claims and directory-level inputs follow the base detector")

    # A change cannot narrow its own inputs: the detector is read from the base.
    detector = (repo / "scripts/ci-fractal-web-changes").read_text()
    narrowed = commit(repo, "narrow the detector", {"scripts/ci-fractal-web-changes": detector.replace('    "packages/fractal-ui/**",\n', "", 2)})
    assert "packages/fractal-ui" in run(repo, "--base", base, "--head", narrowed, "inputs", "fractal-web-kit").split()
    print("passed: inputs and rules come from the base, not from the change")

    # With a declared policy, the verifier's answer decides; a stub verifier at the base stands in for a signed record.
    policy = json.loads((repo / ".st/evidence-skip-policy.json").read_text())
    policy["checks"]["fractal-web-kit"] = {"trust_levels": ["fleet"], "enforce": False, "inputs": ["packages/fractal-ui", "pnpm-lock.yaml"]}
    stub = '#!/usr/bin/env python3\nimport json, sys\nargs = sys.argv[1:]\n' \
           'if "--project" in args: print(json.dumps({"source_inputs": "a" * 40}))\n' \
           'elif "fractal-web-kit" in args: print(json.dumps({"satisfied": True, "record": "b" * 40, "enforce": True}))\n' \
           'else: print(json.dumps({"satisfied": False, "reason": "stale_tree"})); sys.exit(1)\n'
    declared = commit(repo, "declare the kit check", {".st/evidence-skip-policy.json": json.dumps(policy), "scripts/evidence-verify": stub})
    os.chmod(repo / "scripts/evidence-verify", 0o755)
    lines = decisions(repo, declared, declared)
    assert lines["fractal-web-kit"]["decision"] == "skip" and lines["fractal-web-kit"]["proof"] == "b" * 40 and lines["fractal-web-kit"]["reason"] == "match", lines
    assert lines["fractal-web"]["decision"] == "run" and lines["fractal-web"]["reason"] == "no-record", lines
    print("passed: a declared check skips only on the verifier's signed record; an undeclared one runs")

    # A shadow policy (enforce not true): the same record is named, but the check still runs.
    shadow = commit(repo, "the kit check in shadow", {"scripts/evidence-verify": stub.replace(', "enforce": True', '')})
    os.chmod(repo / "scripts/evidence-verify", 0o755)
    lines = decisions(repo, shadow, shadow)
    assert lines["fractal-web-kit"]["decision"] == "run" and lines["fractal-web-kit"]["proof"] == "b" * 40 and lines["fractal-web-kit"]["reason"] == "shadow", lines
    print("passed: a matching record under a shadow policy is reported, never a skip")

    # --fetch brings the head tree's records and each keyed check's input-indexed records from origin, as tags or notes, and nothing else.
    clone = Path(scratch) / "clone"
    subprocess.run(["git", "clone", "-q", "--no-tags", str(repo), str(clone)], check=True, capture_output=True, env=clean)
    tree = git(repo, "rev-parse", f"{declared}^{{tree}}")
    wanted = [f"refs/tags/evidence/{tree}/{declared}", f"refs/notes/evidence/{tree}/{base}", f"refs/tags/evidence/input/fractal-web-kit/{'a' * 40}/{rust}"]
    for ref, target in zip(wanted, (declared, base, rust)):
        git(repo, "update-ref", ref, target)
    git(repo, "update-ref", f"refs/tags/evidence/{'c' * 40}/{base}", base)  # another tree's record
    git(repo, "update-ref", "refs/tags/v1", base)
    run(clone, "--fetch", "--base", declared, "--head", declared)
    fetched = git(clone, "for-each-ref", "--format=%(refname)", "refs/tags/", "refs/notes/").split()
    assert sorted(fetched) == sorted(wanted), fetched
    print("passed: --fetch brings this tree's records and the keyed input records, as tags or notes, and no other ref")

    # arn:lmig:smalltalk:2026-10-27-dot-fractal-config — copy ONLY the entry point, no sibling resolver.
    copied = Path(scratch) / "copied-proof"
    shutil.copy(tool, copied)
    tool = copied
    old_policy = repo / ".st/evidence-skip-policy.json"
    new_policy = repo / ".fractal/evidence-skip-policy.json"
    new_policy.parent.mkdir()
    shutil.copy(old_policy, new_policy)
    old_policy.write_text("{")  # valid new must win even when old is malformed
    both = commit(repo, "new layout shadows old", {})
    lines = decisions(repo, both, both)
    assert lines["fractal-web-kit"]["reason"] == "shadow", lines
    nested = repo / "nested"
    nested.mkdir()
    subdir = subprocess.run([str(tool), "--base", both, "--head", both], cwd=nested,
                           capture_output=True, text=True, env=clean)
    assert subdir.returncode == 0, subdir.stderr
    assert "reason=shadow" in subdir.stdout, "subdirectory lookup must select the root's new policy"
    old_policy.unlink()
    moved = commit(repo, "new layout only", {})
    assert decisions(repo, moved, moved)["fractal-web-kit"]["reason"] == "shadow"
    new_policy.write_text("{")
    malformed = commit(repo, "malformed new", {".st/evidence-skip-policy.json": json.dumps(policy)})
    failed = subprocess.run([str(tool), "--base", malformed, "--head", malformed], cwd=repo,
                            capture_output=True, text=True, env=clean)
    assert failed.returncode != 0, "malformed new policy must not fall back to old"
    failed = subprocess.run([str(tool), "--base", "f" * 40, "--head", moved], cwd=repo,
                            capture_output=True, text=True, env=clean)
    assert failed.returncode != 0, "missing revision must fail closed"
    # The selected revision stays old-layout even though the checkout is new-layout/malformed.
    assert decisions(repo, base, base)["fractal-web"]["reason"] == "no-record"
    unique_policy = dict(policy, bridge_missing_blob=True)
    missing_blob = commit(repo, "selected new blob to remove", {".fractal/evidence-skip-policy.json": json.dumps(unique_policy)})
    oid = git(repo, "rev-parse", f"{missing_blob}:.fractal/evidence-skip-policy.json")
    (repo / ".git/objects" / oid[:2] / oid[2:]).unlink()
    failed = subprocess.run([str(tool), "--base", missing_blob, "--head", moved], cwd=repo,
                            capture_output=True, text=True, env=clean)
    assert failed.returncode != 0, "an existing new entry whose blob is missing must not fall back"
