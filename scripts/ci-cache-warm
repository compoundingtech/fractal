#!/usr/bin/env bash
# Fill Namespace's main-scope caches without rerunning the queue's workspace tests.
set -euo pipefail
case "${1:?usage: scripts/ci-cache-warm tests|clippy|fleet-compat|genie|isolation-vm}" in
  # workspacePreparationSteps already builds the selected nextest targets.
  tests) cargo test -p fractal-conversation-ui --no-default-features --locked --no-run ;;
  clippy)
    cargo clippy --workspace --all-targets --locked
    cargo clippy -p fractal-conversation-ui --no-default-features --all-targets --locked
    cargo build --locked -p fractal-client-codegen
    ;;
  fleet-compat)
    python3 scripts/compat-baseline fleet "$RUNNER_TEMP/baseline"
    cargo test -p fractal --locked --test integration --no-run
    cargo test -p fractal-daemon --locked --lib --no-run
    ;;
  genie) true ;; # nix develop .#genie has already populated the shell.
  isolation-vm)
    cargo nextest archive --workspace --locked -E 'all()' --archive-file "$RUNNER_TEMP/isolation.tar.zst"
    nix build --print-build-logs --out-link "$RUNNER_TEMP/vm-driver" .#legacyPackages.x86_64-linux.transport-isolation-vm.driver
    ;;
  *) exit 2 ;;
esac
