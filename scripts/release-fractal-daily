#!/usr/bin/env python3
"""Prepare a draft candidate from the archives main already built.

Every main commit runs "Fractal tag release", which builds, tests and verifies both archives and
uploads them as the `fractal-release` artifact. This takes the newest commit whose run succeeded (or
the successful main push run selected by --run),
re-verifies its checksums and sources and drafts the same bytes at that exact commit. Nothing
is rebuilt. The tag is created only at publication after an exact-SHA product release GO.

Usage: scripts/release-fractal-daily [--dry-run] [--tag TAG] [--run ID]
Environment: GH_TOKEN and GH_REPO (as for gh). Run from a full-history checkout with tags.
Needs contents: write and actions: read to publish verified artifacts. Baseline PRs use a separate job.
"""
import argparse
import json
import os
import pathlib
import re
import subprocess
import sys
import tempfile
import time
import uuid

from release_artifact import assert_current_attempt, download_release, get_attempt
from release_gh import gh as gh_call, transient
from release_notes import FIELDS, ImpactError, render
from release_draft_recovery import create_verified_draft

WORKFLOW = 'release-fractal.yml'
SEMVER = re.compile(r'v(\d+)\.(\d+)\.(\d+)')
# Keep create/publish metadata small. Complete notes travel as an asset.
RELEASE_BODY_BYTES = 24 * 1024
DRAFT_MARKER = '\n\n<!-- fractal-daily-candidate -->\n'
FULL_NOTES_POINTER = ('The complete notes and upgrade guide are attached as the `RELEASE-NOTES.md` asset; '
                      'complete classifications are attached as `UPGRADE-IMPACT.json`.')


DIAGNOSTIC_LIMIT = 2000
# GitHub token shapes, authorization headers and bearer credentials. Ordinary words such as "token"
# stay readable, because the cause is often a permission message. The actual token in the
# environment is also removed by value, whatever shape it has.
SECRET = re.compile(r'(?i)\b(?:gh[pousr]_|github_pat_)[A-Za-z0-9_]{20,}|'
                    r'\bauthorization\s*[:=][^\n]*|'
                    r'\b(?:bearer|basic)\s+[A-Za-z0-9._~+/=-]{16,}')


class CommandFailed(Exception):
    """A command failed; the message names the command and the cause it printed."""


def diagnostic(text):
    """The end of a command's output, credential-safe and bounded; the cause is printed last."""
    for name in ('GH_TOKEN', 'GITHUB_TOKEN'):
        value = os.environ.get(name)
        if value and len(value) >= 8:
            text = text.replace(value, '***')
    text = SECRET.sub('***', text).strip()
    if len(text) > DIAGNOSTIC_LIMIT:
        text = '...' + text[-DIAGNOSTIC_LIMIT:]
    return text


def run(*cmd, cwd=None):
    done = subprocess.run(cmd, check=False, text=True, capture_output=True, cwd=cwd)
    if done.returncode != 0:
        # Name the command by its program and subcommands, never its other arguments.
        words = [word for word in cmd[:3] if re.fullmatch(r'[a-z][a-z0-9-]*', word)]
        cause = diagnostic(done.stderr) or diagnostic(done.stdout) or 'no output'
        raise CommandFailed(f'{" ".join(words)} exited {done.returncode}: {cause}')
    return done.stdout.strip()


def say(message):
    print(f'release-fractal-daily: {message}', flush=True)


def newest_verified_main_run():
    rows = json.loads(run('gh', 'run', 'list', '--workflow', WORKFLOW, '--branch', 'main', '--event', 'push',
                          '--status', 'success', '--limit', '1', '--json', 'databaseId,headSha'))
    return (rows[0]['databaseId'], rows[0]['headSha']) if rows else (None, None)


def verified_main_run(run_id, candidate_sha=''):
    row = json.loads(run('gh', 'run', 'view', str(run_id), '--json',
                         'databaseId,headSha,headBranch,event,status,conclusion,workflowName,displayTitle'))
    exact_dispatch = (candidate_sha and row['event'] == 'workflow_dispatch'
                      and row['displayTitle'].startswith(f'Fractal candidate {candidate_sha} '))
    if (row['databaseId'] != run_id or row['headBranch'] != 'main'
            or (row['event'] != 'push' and not exact_dispatch)
            or row['status'] != 'completed' or row['conclusion'] != 'success'
            or row['workflowName'] != 'Fractal tag release'):
        raise CommandFailed(f'run {run_id} is not a successful Fractal tag release push run on main or exact candidate build')
    source = candidate_sha if exact_dispatch else row['headSha']
    if candidate_sha and source != candidate_sha:
        raise CommandFailed('selected build run differs from requested candidate SHA')
    return row['databaseId'], source


def require_main_first_parent(sha, repo):
    if not re.fullmatch(r'[0-9a-f]{40}', sha):
        raise CommandFailed('candidate SHA must be a full lowercase 40-character SHA')
    run('git', 'fetch', 'origin', 'main', cwd=repo)
    if sha not in run('git', 'rev-list', '--first-parent', 'FETCH_HEAD', cwd=repo).splitlines():
        raise CommandFailed('candidate SHA must be on main first-parent history')


def build_exact_candidate(sha):
    request_id = uuid.uuid4().hex
    title = f'Fractal candidate {sha} {request_id}'
    run('gh', 'workflow', 'run', WORKFLOW, '--ref', 'main',
        '-f', f'sha={sha}', '-f', f'request_id={request_id}')
    # Dispatch returns no run ID. Correlate only this unique request, never another main build.
    for _ in range(60):
        rows = json.loads(run('gh', 'run', 'list', '--workflow', WORKFLOW, '--event', 'workflow_dispatch',
                             '--branch', 'main', '--limit', '100', '--json', 'databaseId,displayTitle'))
        selected = [row for row in rows if row['displayTitle'] == title]
        if selected:
            run_id = selected[0]['databaseId']
            run('gh', 'run', 'watch', str(run_id), '--exit-status', '--interval', '15')
            row = json.loads(run('gh', 'run', 'view', str(run_id), '--json',
                                 'status,conclusion,displayTitle'))
            if row['status'] != 'completed' or row['conclusion'] != 'success' or row['displayTitle'] != title:
                raise CommandFailed('exact candidate build did not succeed')
            return run_id, sha
        time.sleep(5)
    raise CommandFailed('exact candidate build dispatch did not appear within five minutes')


def gh(*args, **options):
    result = gh_call(*args, step='release-fractal-daily', check=False, **options)
    if result.returncode != 0:
        cause = diagnostic(result.stderr) or diagnostic(result.stdout) or 'no output'
        raise CommandFailed(f'gh {" ".join(args[:2])} exited {result.returncode}: {cause}')
    return result




def latest_release_tag():
    return run('python3', str(pathlib.Path(__file__).resolve().parent / 'compat-baseline-release'), 'latest')


def stable_drafts():
    repository = os.environ.get('GH_REPO', 'compoundingtech/fractal')
    pages = json.loads(run('gh', 'api', '--paginate', '--slurp',
                           f'repos/{repository}/releases?per_page=100'))
    return [row for page in pages for row in page
            if row['draft'] and not row['prerelease'] and SEMVER.fullmatch(row['tag_name'])]


def next_tag(drafts):
    tags = run('git', 'tag', '--list', 'v*').split() + [row['tag_name'] for row in drafts]
    versions = [tuple(map(int, m.groups())) for t in tags if (m := SEMVER.fullmatch(t))]
    major, minor, patch = max(versions)
    return f'v{major}.{minor}.{patch + 1}'


def cleanup_superseded_drafts(tag, drafts):
    version = tuple(map(int, SEMVER.fullmatch(tag).groups()))
    for row in drafts:
        if ('<!-- fractal-daily-candidate -->' in (row.get('body') or '')
                and tuple(map(int, SEMVER.fullmatch(row['tag_name']).groups())) < version):
            repository = os.environ.get('GH_REPO', 'compoundingtech/fractal')
            endpoint = f'repos/{repository}/releases/{row["id"]}'
            # Re-read immediately before deleting this ID, never resolve the tag a second time.
            state = json.loads(run('gh', 'api', endpoint))
            if (state['draft'] and state['tag_name'] == row['tag_name']
                    and '<!-- fractal-daily-candidate -->' in (state.get('body') or '')):
                gh('api', '--method', 'DELETE', endpoint)


def release_body(rendered, impact):
    """Summarize oversized intervals from classifications, never from sliced Markdown."""
    limit = RELEASE_BODY_BYTES - len(DRAFT_MARKER.encode())
    if len(rendered.encode()) <= limit:
        return rendered
    headline, marker, _ = rendered.partition('\n## Upgrade impact\n')
    if not marker:
        raise ImpactError('cannot build bounded release body: missing release headline')
    fragments = impact['fragments']
    lines = [headline.rstrip(), '', '## Upgrade impact', '',
             'Summary only: review the attached complete notes before upgrading.', '']
    for field, label in FIELDS.items():
        counts = {status: sum(f[field]['status'] == status for f in fragments)
                  for status in ('changed', 'unknown', 'none')}
        lines.append(f'- **{label}:** {counts["changed"]} changed, {counts["unknown"]} unknown, '
                     f'{counts["none"]} none.')
    lines.extend(['', '## Priority upgrade items', '',
                  'Action-required and breaking changes first; details and the full upgrade guide are attached.', ''])

    def priority(fragment):
        if fragment['manual']['status'] != 'none':
            return 0
        if (any(fragment[field].get('transitions') for field in ('schema', 'rules'))
                or any(re.search(r'\bbreaking\b', fragment[field]['detail'], re.I) for field in FIELDS)):
            return 1
        return 2

    def plain(text, limit):
        text = ' '.join(text.split())
        if len(text) > limit:
            text = text[:limit].rstrip() + '…'
        return re.sub(r'([\\`*_{}\[\]()<>])', r'\\\1', text)

    items = []
    for fragment in sorted(fragments, key=priority):
        active = [field for field in FIELDS if fragment[field]['status'] != 'none']
        if not active:
            continue
        active.sort(key=lambda field: field != 'manual')
        classification = '; '.join(f'{FIELDS[field]}: {fragment[field]["status"]}' for field in active)
        detail = fragment[active[0]]['detail']
        link = impact['change_links'][fragment['path']]
        items.append(f'- **{classification}.** {plain(fragment["summary"], 240)} — '
                     f'{plain(detail, 360)} ([PR/source]({link}))\n')
    body = '\n'.join(lines)
    # Reserve the largest possible omission count before accepting any complete entry.
    reserve = f'\n{len(items)} more upgrade items; see the attached complete notes.\n\n{FULL_NOTES_POINTER}\n'
    if len((body + reserve).encode()) > limit:
        raise ImpactError('cannot build bounded release body: headline and classification counts exceed limit')
    included = 0
    for item in items:
        if len((body + item + reserve).encode()) > limit:
            break
        body += item
        included += 1
    omitted = len(items) - included
    if omitted:
        body += f'\n{omitted} more upgrade items; see the attached complete notes.\n'
    return body + '\n' + FULL_NOTES_POINTER + '\n'


def main():
    parser = argparse.ArgumentParser(description=__doc__.split('\n')[0])
    parser.add_argument('--dry-run', action='store_true', help='verify and print the notes; publish nothing')
    parser.add_argument('--tag', help='release tag; default is the next patch after the highest v tag')
    parser.add_argument('--run', type=int, help='successful main tag-release run ID; default is the newest')
    parser.add_argument('--summary', default='', help='operator-impact summary preserved in candidate and published notes')
    parser.add_argument('--sha', default='', help='build an exact main first-parent source in an isolated run')
    parser.add_argument('--build-only', action='store_true', help='build exact source and emit build_run, without release mutations')
    parser.add_argument('--recover-draft', action='store_true',
                        help='one minimal draft POST with read-only reconciliation; requires tag, SHA and run')
    args = parser.parse_args()
    repo = pathlib.Path(__file__).resolve().parent.parent
    if args.recover_draft and (not args.tag or not args.sha or args.run is None or args.build_only):
        raise CommandFailed('--recover-draft requires explicit --tag, --sha and --run')

    if args.build_only:
        if not args.sha or args.dry_run or args.run is not None:
            raise CommandFailed('--build-only requires --sha and cannot use --run or --dry-run')
        require_main_first_parent(args.sha, repo)
        run_id, sha = build_exact_candidate(args.sha)
        if output := os.environ.get('GITHUB_OUTPUT'):
            with open(output, 'a') as stream:
                stream.write(f'build_run={run_id}\n')
        say(f'verified build {run_id} at {sha}; no release was mutated')
        return 0
    if args.sha:
        require_main_first_parent(args.sha, repo)
        if args.run is None:
            raise CommandFailed('--sha requires an already successful --run; use the isolated build job first')
        run_id, sha = verified_main_run(args.run, args.sha)
    else:
        run_id, sha = verified_main_run(args.run) if args.run is not None else newest_verified_main_run()
    if sha is None:
        say('no successful main run to release')
        return 1
    previous = latest_release_tag()
    since = run('git', 'rev-parse', f'{previous}^{{commit}}', cwd=repo)
    if since == sha or subprocess.run(['git', 'merge-base', '--is-ancestor', sha, since], cwd=repo).returncode == 0:
        say(f'main has not changed since {previous} ({since}); nothing to release')
        return 0
    changed = run('git', 'diff', '--name-only', since, sha, cwd=repo).splitlines()
    if changed and all(path in ('.github/fleet-compat-baseline.json', '.github/messaging-compat-baseline.json')
                       or re.fullmatch(r'release-notes/compat-baselines-v\d+\.\d+\.\d+\.json', path)
                       for path in changed):
        say('only postpublish baseline maintenance changed; nothing to release')
        return 0
    # The previous release must have reached main before cutting its successor.
    run('python3', str(repo / 'scripts/compat-baseline-release'), 'check', '--source', sha, '--require-latest')
    # Validate the interval before any release listing, download or mutation. Only
    # the generated version labels depend on drafts; classify this source once.
    provisional_tag = args.tag or next_tag([])
    if not SEMVER.fullmatch(provisional_tag):
        raise CommandFailed('candidate tag must be vMAJOR.MINOR.PATCH')
    try:
        rendered, impact = render(repo, previous, sha, provisional_tag,
                                  os.environ.get('GH_REPO', 'compoundingtech/fractal'), since)
    except ImpactError as error:
        say(str(error))
        return 1
    drafts = stable_drafts()
    tag = args.tag or next_tag(drafts)
    if not SEMVER.fullmatch(tag):
        raise CommandFailed('candidate tag must be vMAJOR.MINOR.PATCH')
    if subprocess.run(['git', 'rev-parse', '-q', '--verify', f'refs/tags/{tag}'], cwd=repo,
                      capture_output=True).returncode == 0:
        say(f'{tag} already exists; refusing to reuse a tag')
        return 1
    try:
        if tag != provisional_tag:
            # Retag only the two generated labels, not classification prose or
            # operator summaries that may themselves mention another version.
            rendered = rendered.replace(f'Fractal {provisional_tag} at `{sha}`.',
                                        f'Fractal {tag} at `{sha}`.', 1)
            rendered = rendered.replace(
                f'From **{previous}** (`{since}`) to **{provisional_tag}** (`{sha}`).',
                f'From **{previous}** (`{since}`) to **{tag}** (`{sha}`).', 1)
        if args.summary:
            rendered = f'## Operator impact summary\n\n{args.summary}\n\n' + rendered
        body = release_body(rendered, impact)
    except ImpactError as error:
        say(str(error))
        return 1
    say(f'releasing {tag} from {sha} (run {run_id}), previous release {previous} at {since}')

    dist = pathlib.Path(tempfile.mkdtemp(prefix='fractal-release-'))
    repository = os.environ.get('GH_REPO', 'compoundingtech/fractal')
    build = json.loads(run('gh', 'api', f'repos/{repository}/actions/runs/{run_id}'))
    if (build['status'] != 'completed' or build['conclusion'] != 'success'
            or type(build['run_attempt']) is not int or build['run_attempt'] <= 0):
        raise CommandFailed('selected build attempt is not successful')
    attempt = build['run_attempt']
    verified = get_attempt(run_id, repository, attempt, run)
    exact_source = (verified['head_sha'] == sha if verified['event'] == 'push'
                    else verified['event'] == 'workflow_dispatch'
                    and verified['display_title'].startswith(f'Fractal candidate {sha} '))
    if (verified['workflow_id'] != build['workflow_id']
            or verified['head_sha'] != build['head_sha']
            or verified['head_branch'] != 'main' or not exact_source):
        raise CommandFailed('selected build attempt differs from the selected source or workflow')
    artifact_id = download_release(run_id, repository, attempt, dist, run)
    # The same checks the tag workflow makes, so the bytes are proven before they are published.
    run('sha256sum', '--check', 'SHA256SUMS', cwd=dist)
    say(run('python3', str(repo / 'scripts/release-fractal-manifest.py'), sha, cwd=dist))

    notes = dist / 'RELEASE-NOTES.md'
    notes.write_text(rendered)
    body_notes = dist / 'RELEASE-BODY.md'
    body_notes.write_text(body + DRAFT_MARKER, encoding='utf-8')
    (dist / 'UPGRADE-IMPACT.json').write_text(json.dumps(impact, indent=2) + '\n')
    (dist / 'CANDIDATE.json').write_text(json.dumps({
        'source': sha, 'build_run': run_id, 'build_attempt': attempt,
        'build_artifact': artifact_id}) + '\n')
    assets = sorted(str(p) for pattern in ('*.tar.gz', '*.sha256') for p in dist.glob(pattern))
    assets += [str(dist / 'SHA256SUMS'), str(dist / 'RELEASE.json'), str(dist / 'UPGRADE-IMPACT.json'),
               str(dist / 'CANDIDATE.json'), str(notes)]
    if args.dry_run:
        print(body)
        shortened = 'shortened' if body != rendered else 'unchanged'
        say(f'dry run: release body {shortened}: {len(body)} characters '
            f'(full notes: {len(rendered)} characters; draft body limit: {RELEASE_BODY_BYTES} bytes)')
        say(f'dry run: would draft {tag} at {sha} with {len(assets)} assets, including RELEASE-NOTES.md')
        return 0

    assert_current_attempt(run_id, repository, attempt, run)
    say(f'draft create metadata: {body_notes.stat().st_size} UTF-8 bytes; {len(assets)} assets verified locally')
    def recovery_call(*arguments, **options):
        return subprocess.run(['gh', *arguments], text=True, capture_output=True, check=False, **options)

    existing = any(row['tag_name'] == tag for row in drafts)
    if args.recover_draft or existing:
        create_verified_draft(repository, tag, sha, f'run-{run_id}-{sha}', body_notes,
                              [pathlib.Path(asset) for asset in assets],
                              call=recovery_call, say=say, create=args.recover_draft)
    else:
        # A failed POST may already have committed. Never delete or repeat it.
        result = recovery_call('release', 'create', tag, '--target', sha, '--draft',
                               '--title', f'Fractal {tag}', '--notes-file', str(body_notes), *assets)
        if result.returncode:
            say(f'gh release create exited {result.returncode}: {diagnostic(result.stderr)}')
            if not transient(result):
                raise CommandFailed('draft create rejected; preserving state without retry or deletion')
            create_verified_draft(repository, tag, sha, f'run-{run_id}-{sha}', body_notes,
                                  [pathlib.Path(asset) for asset in assets],
                                  call=recovery_call, say=say, create=False)
    if not args.recover_draft:
        cleanup_superseded_drafts(tag, drafts)
    say(f'drafted {tag} at {sha}; publication requires an exact-SHA product release GO')
    return 0


def entry():
    try:
        return main()
    except (CommandFailed, ValueError, OSError, KeyError, subprocess.CalledProcessError) as error:
        say(str(error))
        return 1


if __name__ == '__main__':
    sys.exit(entry())
