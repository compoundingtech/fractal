        code, out, _ = self.run_st_test('--check', 'demo', '--push', 'broken')
        self.assertEqual(code, 1)
        self.assertRegex(out, r'demo +push failed')

    def test_nothing_is_fetched_or_materialized_when_every_check_is_already_signed(self):
        self.commit('.gitignore', '/repos/\n')
        self.commit('megarepo.lock', '{"version":1,"members":{}}\n')
        fill = ['sh', '-c', 'mkdir -p repos/effect-utils']
        calls = []

        def members(directory):
            calls.append(directory)
            return fill
        with mock.patch.object(st_test, 'members_command', members):
            self.assertEqual(self.run_st_test('--check', 'demo')[0], 0)
            self.assertEqual(self.run_st_test('--check', 'demo')[0], 0)
        self.assertEqual(len(calls), 1)

    def test_the_checks_see_one_fixed_path_whatever_the_callers_is(self):
        self.commit('b.txt', 'two')
        seen = Path(self.tmp.name) / 'seen'
        command = ['sh', '-c', f'echo "$PATH" >> {seen}']
        callers = os.environ.get('PATH', '') + ':/seat-one/state/bin'
        self.assertEqual(self.run_st_test('--check', 'demo', command=command, extra_env={'PATH': callers})[0], 0)
        self.assertEqual(self.run_st_test('--check', 'demo', '--rerun', command=command, extra_env={'PATH': '/seat-two/bin:' + callers})[0], 0)
        first, second = seen.read_text().splitlines()
        self.assertEqual(first, second)
        self.assertNotIn('/seat-', first)
        self.assertTrue(all(os.path.isdir(entry) for entry in first.split(':')))
        self.assertIn('/usr/bin', first.split(':'))
        self.assertEqual(len(set(first.split(':'))), len(first.split(':')))

    def test_the_host_load_limit_comes_from_the_environment_or_a_file_outside_the_repo_and_no_limit_means_none(self):
        with mock.patch.dict(os.environ, {'HOME': str(self.home)}, clear=True), mock.patch.dict(st_test.POOL_SETTINGS, {}, clear=True):
            self.assertIsNone(st_test.load_limit())  # no file, no variable
            (self.home / '.config/st-test').mkdir(parents=True, exist_ok=True)
            (self.home / '.config/st-test/max-load').write_text('20\n')
            self.assertEqual(st_test.load_limit(), 20.0)
            with mock.patch.dict(st_test.POOL_SETTINGS, {'ST_TEST_MAX_LOAD': '12.5'}):
                self.assertEqual(st_test.load_limit(), 12.5)  # the variable wins
            (self.home / '.config/st-test/max-load').write_text('0\n')
            self.assertIsNone(st_test.load_limit())  # 0 is no limit
            (self.home / '.config/st-test/max-load').write_text('lots\n')
            with self.assertRaises(st_test.Failure):
                st_test.load_limit()

    def test_a_run_waits_while_the_load_is_above_the_limit_says_why_and_proceeds_when_it_drops(self):
        loads, now, slept = iter([34.0, 34.0, 30.0, 19.0]), [0.0], []

        def sleep(seconds):
            slept.append(seconds)
            now[0] += 30.0
        err = io.StringIO()
        with mock.patch.dict(st_test.POOL_SETTINGS, {}, clear=True), contextlib.redirect_stderr(err):
            st_test.wait_for_load(20.0, read_load=lambda: next(loads), sleep=sleep, clock=lambda: now[0])
        self.assertEqual(len(slept), 3)
        said = err.getvalue().splitlines()
        self.assertEqual(said[0], 'fractal-test: waiting: load1 34 > 20 (host limit)')
        self.assertEqual(len(said), 2)  # once at the start, again after a minute: not every poll
        err = io.StringIO()
        with contextlib.redirect_stderr(err):
            st_test.wait_for_load(20.0, read_load=lambda: 5.0, sleep=sleep, clock=lambda: now[0])
        self.assertEqual(err.getvalue(), '')  # under the limit: no wait, nothing said

    def test_a_run_that_waits_past_the_deadline_fails_with_the_reason(self):
        now = [0.0]

        def sleep(seconds):
            now[0] += 600.0
        with mock.patch.dict(st_test.POOL_SETTINGS, {}, clear=True), contextlib.redirect_stderr(io.StringIO()):
            with self.assertRaisesRegex(st_test.Failure, r'load1 40 > 20 \(host limit\) for 30 min; nothing was started'):
                st_test.wait_for_load(20.0, read_load=lambda: 40.0, sleep=sleep, clock=lambda: now[0])
            with mock.patch.dict(st_test.POOL_SETTINGS, {'ST_TEST_LOAD_WAIT_MINUTES': '5'}):
                now[0] = 0.0
                with self.assertRaisesRegex(st_test.Failure, 'for 5 min'):
                    st_test.wait_for_load(20.0, read_load=lambda: 40.0, sleep=sleep, clock=lambda: now[0])

    def test_a_whole_run_on_an_overloaded_host_refuses_loudly_before_it_starts_anything(self):
        self.commit('b.txt', 'two')
