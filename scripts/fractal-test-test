import unittest
from unittest import mock

# The agent git guard needs a private enclosing TMPDIR for pushes to local bare fixtures.
PRIVATE_TMPDIR = tempfile.mkdtemp()
os.environ['TMPDIR'] = PRIVATE_TMPDIR
tempfile.tempdir = None
atexit.register(shutil.rmtree, PRIVATE_TMPDIR, ignore_errors=True)

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
from evidence_test_support import tool_path  # noqa: E402

ROOT = Path(__file__).resolve().parent.parent
loader = importlib.machinery.SourceFileLoader('st_test', str(ROOT / 'scripts/st-test'))
spec = importlib.util.spec_from_loader(loader.name, loader)
st_test = importlib.util.module_from_spec(spec)
loader.exec_module(st_test)
LOCAL = dict(st_test.LOCAL)  # the real commands, before a test replaces them

DATE = '2026-10-14T12:00:00Z'
# Without the caller's state home or runs file: a run records its times under the test's own home, never the developer's.
# XDG_RUNTIME_DIR is a private one: a run takes a tree only when a build slot is free, and the host's own cargo slots (busy while this
# suite runs as a check on a build host) are no test's business; a test that wants slots makes its own.
GIT_ENV = dict({k: v for k, v in os.environ.items() if k not in ('GITHUB_ACTIONS', 'CI', 'XDG_STATE_HOME', 'ST_TEST_RUNS', 'CARGO_HEAVY_SLOTS', 'BUILD_ADMISSION_BIN')},
               XDG_RUNTIME_DIR=PRIVATE_TMPDIR, GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_SYSTEM='/dev/null', LC_ALL='C',
               GIT_CONFIG_COUNT='2', GIT_CONFIG_KEY_0='gc.auto', GIT_CONFIG_VALUE_0='0', GIT_CONFIG_KEY_1='maintenance.auto', GIT_CONFIG_VALUE_1='false',
               GIT_AUTHOR_NAME='t', GIT_AUTHOR_EMAIL='t@example.invalid', GIT_COMMITTER_NAME='t',
               GIT_COMMITTER_EMAIL='t@example.invalid', GIT_AUTHOR_DATE=DATE, GIT_COMMITTER_DATE=DATE)
POLICY = {'version': 1, 'checks': {'demo': {'trust_levels': ['host'], 'kinds': {'wrapper': {
    'command': ['sh', '-c', 'echo ran'],
    'required_inputs': ['flake_lock_sha256', 'toolchain_sha256', 'wrapper_sha256', 'system', 'attempt'],
    'bind_inputs': {'flake_lock_sha256': 'flake.lock'}}}}}}


def git(repo, *args, stdin=None):
    done = subprocess.run(['git', '-C', str(repo), *args], input=stdin, capture_output=True, env=GIT_ENV)
    assert done.returncode == 0, (args, done.stderr.decode())
    return done.stdout.decode().strip()


def apparent_gb(path):
    """Pool-cap policy fixtures count file lengths, independently of filesystem allocation and compression."""
    return sum(file.stat().st_size for file in path.rglob('*') if file.is_file()) / 1e9


NEEDS_TREE = st_test.needs_tree


class PoolTreeTest(unittest.TestCase):
    """Pool reuse without a signer or remote: only disposable local worktrees are involved."""

    def test_forced_checkout_replaces_dirty_index_and_files_without_hard_reset(self):
        with tempfile.TemporaryDirectory() as scratch:
            root = Path(scratch)
            repo = root / 'repo'
            repo.mkdir()
            git(repo, 'init', '-q')
            (repo / '.gitignore').write_text('ignored\n')
            (repo / 'tracked').write_text('first')
            git(repo, 'add', '.')
            git(repo, 'commit', '-q', '-m', 'first')
            real_git = st_test.git
            def no_hard_reset(*args, **kwargs):
                self.assertFalse(args and args[0] == 'reset' and '--hard' in args)
                return real_git(*args, **kwargs)
            with contextlib.chdir(repo), mock.patch.dict(os.environ, GIT_ENV, clear=True), \
                    mock.patch.object(st_test, 'git', side_effect=no_hard_reset):
                tree = st_test.prepare_tree(root / 'pool', 0, git(repo, 'rev-parse', 'HEAD'))
                (tree / 'tracked').write_text('staged')
                git(tree, 'add', 'tracked')
                (tree / 'tracked').write_text('unstaged')
                (tree / 'ignored').write_text('ignored')
                (tree / 'nested').mkdir()
                git(tree / 'nested', 'init', '-q')
                (repo / 'tracked').write_text('second')
                (repo / 'added').write_text('new')
                git(repo, 'add', '.')
                git(repo, 'commit', '-q', '-m', 'second')
                commit = git(repo, 'rev-parse', 'HEAD')
                reused = st_test.prepare_tree(root / 'pool', 0, commit)
                self.assertEqual(reused, tree)
                self.assertEqual(git(tree, 'rev-parse', 'HEAD'), commit)
                self.assertEqual(git(tree, 'status', '--porcelain'), '')
                self.assertEqual((tree / 'tracked').read_text(), 'second')
                self.assertEqual((tree / 'added').read_text(), 'new')
                self.assertFalse((tree / 'ignored').exists())
                self.assertFalse((tree / 'nested').exists())
                git(repo, 'worktree', 'remove', '--force', str(tree))

    def pool_repo(self, scratch):
        repo = Path(scratch) / 'repo'
        repo.mkdir()
        git(repo, 'init', '-q')
        (repo / 'tracked').write_text('first')
        git(repo, 'add', '.')
        git(repo, 'commit', '-q', '-m', 'first')
        return repo

    def test_an_index_lock_is_cleared_only_when_no_process_is_left_in_the_tree(self):
        with tempfile.TemporaryDirectory() as scratch, mock.patch.dict(os.environ, GIT_ENV, clear=True):
            repo = self.pool_repo(scratch)
            pool = Path(scratch) / 'pool'
            with contextlib.chdir(repo):
                tree = st_test.prepare_tree(pool, 0, git(repo, 'rev-parse', 'HEAD'))
                lock = Path(git(tree, 'rev-parse', '--path-format=absolute', '--git-path', 'index.lock'))
                lock.write_text('')
                # Something is still at work in the tree: the lock may be live, so it stays and the run fails.
                busy = subprocess.Popen(['sleep', '60'], cwd=tree)
                self.addCleanup(busy.wait)
                self.addCleanup(busy.kill)
                with self.assertRaisesRegex(st_test.Failure, rf'index.lock and processes {busy.pid} still in it'):
                    st_test.prepare_tree(pool, 0, git(repo, 'rev-parse', 'HEAD'))
                self.assertTrue(lock.exists())
                busy.kill()
                busy.wait()
                # Nothing is left in the tree: the lock is stale, removed, and said so; the checkout goes ahead.
                said = io.StringIO()
                with contextlib.redirect_stderr(said):
                    self.assertEqual(st_test.prepare_tree(pool, 0, git(repo, 'rev-parse', 'HEAD')), tree)
                self.assertFalse(lock.exists())
                self.assertIn('removed a stale', said.getvalue())

    def test_a_holder_killed_in_its_checkout_leaves_the_tree_to_the_next_holder(self):
        with tempfile.TemporaryDirectory() as scratch, mock.patch.dict(os.environ, GIT_ENV, clear=True):
            repo = self.pool_repo(scratch)
            pool = Path(scratch) / 'pool'
            with contextlib.chdir(repo):
                tree = st_test.prepare_tree(pool, 0, git(repo, 'rev-parse', 'HEAD'))
                lock = git(tree, 'rev-parse', '--path-format=absolute', '--git-path', 'index.lock')
                (repo / 'tracked').write_text('second')
                git(repo, 'commit', '-q', '-am', 'second')
                commit = git(repo, 'rev-parse', 'HEAD')
                # The holder takes the lease and, in the tree, starts writing the index as git's checkout does; then it is killed (SIGKILL,
                # as a stopped scope's leftovers are). Its lease ends with it; the lock git was writing stays behind.
                holder = subprocess.Popen([sys.executable, '-c', textwrap.dedent('''
                    import fcntl, os, sys, time
                    lease = open(sys.argv[1], 'w')
                    fcntl.flock(lease, fcntl.LOCK_EX)
                    open(sys.argv[2], 'w').close()
                    print('writing', flush=True)
                    time.sleep(60)
                    '''), str(pool / 'tree-0.lock'), lock], cwd=tree, stdout=subprocess.PIPE, text=True)
                self.addCleanup(holder.wait)
                self.addCleanup(holder.kill)
                self.assertEqual(holder.stdout.readline().strip(), 'writing')
                holder.kill()
                holder.wait()
                holder.stdout.close()
                self.assertTrue(Path(lock).exists())
                with mock.patch.object(st_test, 'POOL_WAIT_SECONDS', 0.05), contextlib.redirect_stderr(io.StringIO()) as said:
                    n, lease = st_test.acquire_tree(pool, 1, rank=50)
                    self.addCleanup(lease.close)
                    self.assertEqual(st_test.prepare_tree(pool, n, commit), tree)
                self.assertEqual((n, git(tree, 'rev-parse', 'HEAD'), (tree / 'tracked').read_text()), (0, commit, 'second'))
                self.assertFalse(Path(lock).exists())
                self.assertIn('removed a stale', said.getvalue())


class StTest(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        tmp = Path(self.tmp.name)
        key = tmp / 'key'
        subprocess.run(['ssh-keygen', '-q', '-t', 'ed25519', '-N', '', '-C', 'host/box-1', '-f', str(key)], check=True)
        pub = key.with_suffix('.pub').read_text().split()
        self.home = tmp / 'home'
        (self.home / '.config/st').mkdir(parents=True)
        (self.home / '.config/st/evidence-sign.json').write_text(json.dumps(
            {'signer': 'host/box-1', 'ssh_key': str(key), 'scratch_repo': str(tmp / 'scratch.git'),
             'test_clock': True, 'path': tool_path()}))
        git(tmp, 'init', '-q', '--bare', '-b', 'main', str(tmp / 'origin.git'))
        self.work = tmp / 'work'
        git(tmp, 'clone', '-q', str(tmp / 'origin.git'), str(self.work))
        git(self.work, 'checkout', '-q', '-b', 'main')
        git(self.work, 'config', 'user.name', 't')  # st-test drops the GIT_* identity variables: a merge it makes takes the checkout's
        git(self.work, 'config', 'user.email', 't@example.invalid')
        (self.work / 'scripts').mkdir()
        for name in st_test.BASE_SCRIPTS:
            shutil.copy(ROOT / 'scripts' / name, self.work / 'scripts' / name)
        (self.work / '.st').mkdir()
        (self.work / '.st/evidence-keys').write_text(f'host/box-1 namespaces="git" {pub[0]} {pub[1]}\n')
        (self.work / '.st/evidence-skip-policy.json').write_text(json.dumps(POLICY))
        (self.work / 'flake.lock').write_text('{"nodes":{}}\n')
        (self.work / 'a.txt').write_text('one\n')
        git(self.work, 'add', '.')
        git(self.work, 'commit', '-q', '-m', 'base')
        git(self.work, 'push', '-q', 'origin', 'main')
        git(self.work, 'checkout', '-q', '-b', 'feature')
        patcher = mock.patch.dict(st_test.LOCAL, {'demo': ['sh', '-c', 'echo ran']}, clear=True)
        patcher.start()
        self.addCleanup(patcher.stop)
        trees = mock.patch.object(st_test, 'needs_tree', return_value=True)  # demo stands in for a check that builds, so the pool is exercised
        trees.start()
        self.addCleanup(trees.stop)

    def commit(self, name, content, branch=None):
        if branch:
            git(self.work, 'checkout', '-q', branch)
        (self.work / name).write_text(content)
        git(self.work, 'add', '.')
        git(self.work, 'commit', '-q', '-m', f'{name} {content}')

    def run_st_test(self, *args, command=None, extra_env=None):
        if command is not None:
            st_test.LOCAL['demo'] = command
        out, err = io.StringIO(), io.StringIO()
        env = dict(GIT_ENV, HOME=str(self.home), EVIDENCE_SIGN_NOW=DATE, **(extra_env or {}))
        cwd = os.getcwd()
        os.chdir(self.work)
        try:
            with mock.patch.dict(os.environ, env, clear=True), contextlib.redirect_stdout(out), contextlib.redirect_stderr(err):
                try:
                    code = st_test.main(['--base', 'origin/main', '--repository', 'org/repo', '--toolchain-sha256', hashlib.sha256(b'drv').hexdigest(), *args])
                except st_test.Failure as error:
                    code = f'failure: {error}'
        finally:
            os.chdir(cwd)
        return code, out.getvalue(), err.getvalue()

    def statements(self):
        found = []
        for ref in git(self.work, 'for-each-ref', '--format=%(refname)', 'refs/notes/evidence/').splitlines():
            blob = git(self.work, 'ls-tree', '-r', ref).split()[2]
            found.append(json.loads(git(self.work, 'cat-file', 'blob', blob)))
        return found

    def exports(self, directory, checks):
        summaries = [json.loads(path.read_text()) for path in directory.glob('*.json')]
        self.assertCountEqual([summary['check'] for summary in summaries], checks)
        self.assertEqual({path.stem for path in directory.glob('*.pack')}, {summary['record'] for summary in summaries})
        for summary in summaries:
            self.assertGreater((directory / f'{summary["record"]}.pack').stat().st_size, 0)
        return summaries

    def fetches_with_lock_errors(self, errors):
        """fetch_base in the clone, where the first fetches fail with these stderr texts and the next one fetches."""
        real_git, calls = st_test.git, []
        def git(*args, **kwargs):
            if args[0] == 'fetch':
                calls.append(args)
                if len(calls) <= len(errors):
                    return subprocess.CompletedProcess(['git', *args], 1, b'', errors[len(calls) - 1].encode())
            return real_git(*args, **kwargs)
        cwd = os.getcwd()
        os.chdir(self.work)
        try:
            with mock.patch.object(st_test, 'git', side_effect=git), mock.patch.object(st_test.time, 'sleep'), \
                    mock.patch.dict(os.environ, dict(GIT_ENV, HOME=str(self.home)), clear=True), contextlib.redirect_stderr(io.StringIO()) as err:
                try:
                    result = st_test.fetch_base('origin/main')
                except st_test.Failure as error:
                    result = f'failure: {error}'
        finally:
            os.chdir(cwd)
        return result, len(calls), err.getvalue()

    def test_a_fetch_another_fetch_raced_is_tried_again_and_any_other_fetch_error_fails_at_once(self):
        lock = "error: cannot lock ref 'refs/remotes/origin/main': is at 1111 but expected 2222"
        tip = git(self.work, 'rev-parse', 'origin/main')
        result, calls, err = self.fetches_with_lock_errors([lock, lock])
        self.assertEqual((result, calls), (tip, 3))  # two lost races, then the fetch: the run goes on
        self.assertIn('another fetch moved origin/main at the same moment; fetching again (2 of 3)', err)
        result, calls, _ = self.fetches_with_lock_errors([lock, lock, lock])
        self.assertEqual((calls, result), (3, 'failure: git fetch failed: ' + lock))  # three is the limit
        result, calls, _ = self.fetches_with_lock_errors(['fatal: unable to access the remote'])
        self.assertEqual((calls, result), (1, 'failure: git fetch failed: fatal: unable to access the remote'))

    def test_a_runs_checks_carry_an_admission_run_of_the_accepted_form_a_new_one_per_run_replacing_the_callers(self):
        seen = Path(self.tmp.name) / 'admission-run'
        self.assertEqual(self.run_st_test(command=['sh', '-c', f'printf "%s\\n" "$ADMISSION_RUN" >> {seen}'], extra_env={'ADMISSION_RUN': 'stale@1'})[0], 0)
        self.commit('b.txt', 'two')
        self.assertEqual(self.run_st_test(command=['sh', '-c', f'printf "%s\\n" "$ADMISSION_RUN" >> {seen}'])[0], 0)
        first, second = seen.read_text().split()
        for value in (first, second):
            self.assertRegex(value, r'^st-test-[0-9]+@[0-9]{19}$')        # the form build admission accepts: [A-Za-z0-9._-]{1,64}@<start-ns>
        self.assertNotEqual(first, second)                                 # a caller's stale value is replaced, and each run has its own start

    def test_out_resolves_a_nested_relative_directory_and_does_not_import_or_claim_coverage(self):
        self.commit('b.txt', 'two')
        destination = Path(self.tmp.name) / 'exports/nested'
        with mock.patch.object(st_test, 'covered', side_effect=AssertionError('exported notes are not imported')):
            code, out, err = self.run_st_test('--check', 'demo', '--out', '../exports/nested')
        self.assertEqual(code, 0, out + err)
        summaries = self.exports(destination, ['demo'])
        self.assertEqual(summaries[0]['exit_code'], 0)
        self.assertIn('packs exported, not imported or verified', out)
        self.assertEqual(self.statements(), [])
        self.assertEqual(self.run_st_test('--check', 'demo', '--status')[0], 3)
        self.assertEqual(git(Path(self.tmp.name) / 'origin.git', 'for-each-ref', 'refs/tags/evidence'), '')

    def test_out_reruns_an_already_signed_check_for_a_complete_export(self):
        self.commit('b.txt', 'two')
        self.assertEqual(self.run_st_test('--check', 'demo')[0], 0)
        before = self.statements()
        destination = Path(self.tmp.name) / 'exports'
        code, out, err = self.run_st_test('--check', 'demo', '--out', str(destination))
        self.assertEqual(code, 0, out + err)
        self.assertNotIn('already signed', out)
        self.exports(destination, ['demo'])
        self.assertEqual(self.statements(), before)

    def test_out_preserves_a_failing_checks_exit_and_exports_its_failure(self):
        self.commit('b.txt', 'two')
        destination = Path(self.tmp.name) / 'exports'
        code, out, err = self.run_st_test('--check', 'demo', '--out', str(destination), command=['sh', '-c', 'exit 3'])
        self.assertEqual(code, 1, out + err)
        self.assertEqual(self.exports(destination, ['demo'])[0]['exit_code'], 3)
        self.assertEqual(self.statements(), [])

    def test_out_and_push_are_mutually_exclusive_before_starting(self):
        with self.assertRaises(SystemExit) as raised:
            self.run_st_test('--out', '../exports', '--push', 'origin')
        self.assertEqual(raised.exception.code, 2)

    def nudge_recorder(self, exit_code=0):
        calls = Path(self.tmp.name) / f'nudge-calls-{exit_code}'
        argv = [sys.executable, '-c', f'import sys; open({str(calls)!r}, "a").write(" ".join(sys.argv[1:]) + "\\n"); sys.exit({exit_code})', 'pull-now']
        return calls, json.dumps(argv)

    def test_a_push_asks_this_host_s_evidence_log_to_pull_once_and_a_run_without_push_does_not(self):
        self.commit('b.txt', 'two')
        calls, argv = self.nudge_recorder()
        code, out, err = self.run_st_test('--check', 'demo', extra_env={'ST_EVIDENCE_LOG_NUDGE': argv})
        self.assertEqual(code, 0, err)
        self.assertFalse(calls.exists(), 'nothing was pushed, so the log has nothing new')
        code, out, err = self.run_st_test('--check', 'demo', '--push', 'origin', extra_env={'ST_EVIDENCE_LOG_NUDGE': argv})
        self.assertEqual(code, 0, err)
        self.assertEqual(calls.read_text(), 'pull-now\n')
        self.assertIn("asked this host's log to pull now", out)
        pushed = subprocess.run(['git', '-C', str(Path(self.tmp.name) / 'origin.git'), 'for-each-ref', '--format=%(refname)', 'refs/tags/evidence/'],
                                capture_output=True, text=True).stdout.split()
        self.assertEqual(len(pushed), 1, 'the record reached the remote before the log was asked')

    def test_a_failing_or_malformed_nudge_never_changes_the_result(self):
        self.commit('b.txt', 'two')
        calls, argv = self.nudge_recorder(exit_code=5)
        code, out, err = self.run_st_test('--check', 'demo', '--push', 'origin', extra_env={'ST_EVIDENCE_LOG_NUDGE': argv})
        self.assertEqual(code, 0, err)
        self.assertIn('its timer will', out)
        self.commit('c.txt', 'three')
        code, out, err = self.run_st_test('--check', 'demo', '--push', 'origin', extra_env={'ST_EVIDENCE_LOG_NUDGE': '"systemctl"'})
        self.assertEqual(code, 0, err)
        self.assertIn('not asked', out)

    def test_without_a_configured_command_the_log_is_asked_only_where_its_unit_is_installed(self):
        with mock.patch.dict(os.environ, {'HOME': str(self.home)}, clear=True), mock.patch.object(st_test.shutil, 'which', return_value='/bin/systemctl'):
            self.assertIsNone(st_test.log_nudge_argv())
            unit = self.home / '.config/systemd/user/evidence-log.service'
            unit.parent.mkdir(parents=True)
            unit.write_text('[Service]\n')
            self.assertEqual(st_test.log_nudge_argv(), ['systemctl', '--user', 'start', '--no-block', 'evidence-log.service'])

    def test_a_branch_that_holds_the_base_tip_is_signed_in_place_and_reported_covered(self):
        self.commit('b.txt', 'two')
        code, out, err = self.run_st_test('--check', 'demo')
        self.assertEqual(code, 0, err)
        statement, = self.statements()
        self.assertEqual(statement['subject'][0]['digest']['gitTree'], git(self.work, 'rev-parse', 'HEAD^{tree}'))
        check = statement['predicate']['observed']['checks']['demo']
        self.assertEqual((check['command'], check['exit_code']), (['sh', '-c', 'echo ran'], 0))
        self.assertEqual(statement['predicate']['signer'], 'host/box-1')
        self.assertIn('demo', out)
        self.assertIn('covered by wrapper', out)
        self.assertIn('(HEAD)', out)
        self.assertNotIn('behind', out)  # the branch holds the base's tip: nothing to report
        self.assertIn('clean worktree', out)

    def test_a_host_that_preloads_a_library_into_every_process_still_signs(self):
        """hetz2 sets LD_PRELOAD (jemalloc) for every process; the signer refuses it, so the launcher must not pass it on."""
        self.commit('b.txt', 'two')
        empty = Path(self.tmp.name) / 'empty'
        empty.mkdir()
        hostile = {'LD_PRELOAD': '/nonexistent/libpreload.so', 'LD_AUDIT': '/nonexistent/libaudit.so', 'LD_LIBRARY_PATH': str(empty),
                   'GLIBC_TUNABLES': 'glibc.malloc.check=3', 'PYTHONPATH': str(empty), 'PYTHONSTARTUP': '/nonexistent/startup.py'}
        code, out, err = self.run_st_test('--check', 'demo', extra_env=hostile)
        self.assertEqual(code, 0, err + out)
        statement, = self.statements()
        self.assertEqual((statement['predicate']['signer'], statement['predicate']['tier']), ('host/box-1', 'full'))
        self.assertIn('covered by wrapper', out)

    def lane_file(self, definition=('scripts/lane.sh',)):
        lanes = {'version': 1, 'lanes': {'demo': {'argv': ['sh', '-c', 'echo ran'], 'definition_paths': list(definition)}}}
        (self.work / 'scripts/lane.sh').write_text('lane\n')
        (self.work / '.st/required-lanes.json').write_text(json.dumps(lanes))
        git(self.work, 'add', '.')
        git(self.work, 'commit', '-q', '-m', 'lane file')
        git(self.work, 'push', '-q', 'origin', 'HEAD:main')
        git(self.work, 'fetch', '-q', 'origin')

    def test_a_lane_defined_at_the_base_puts_its_definition_digest_in_the_note(self):
        self.lane_file()
        self.commit('b.txt', 'two')  # the change touches no definition path
        code, out, err = self.run_st_test('--check', 'demo')
        self.assertEqual(code, 0, err)
        statement, = self.statements()
        digest = statement['predicate']['observed']['inputs']['lane_definition_sha256']
        verifier = importlib.machinery.SourceFileLoader('ev', str(ROOT / 'scripts/evidence-verify')).load_module()
        rules = verifier.lane_rules(git(self.work, 'show', 'origin/main:.st/required-lanes.json'), 'demo')
        base_tree = git(self.work, 'rev-parse', 'origin/main^{tree}')
        self.assertEqual(digest, verifier.lane_definition(str(self.work), base_tree, git(self.work, 'rev-parse', 'HEAD^{tree}'), rules)['sha256'])

    def test_a_tree_that_edits_its_own_lane_is_signed_with_the_edited_definition_and_covered(self):
        self.lane_file()
        self.commit('scripts/lane.sh', 'lane, but fewer tests\n')
        code, out, err = self.run_st_test('--check', 'demo')
        self.assertEqual(code, 0, out + err)
        self.assertNotIn('not signed', out)
        statement, = self.statements()
        verifier = importlib.machinery.SourceFileLoader('ev', str(ROOT / 'scripts/evidence-verify')).load_module()
        rules = verifier.lane_rules(git(self.work, 'show', 'origin/main:.st/required-lanes.json'), 'demo')
        definition = verifier.lane_definition(str(self.work), git(self.work, 'rev-parse', 'origin/main^{tree}'),
                                              git(self.work, 'rev-parse', 'HEAD^{tree}'), rules)
        self.assertEqual(definition['changed'], ['scripts/lane.sh'])
        self.assertEqual(statement['predicate']['observed']['inputs']['lane_definition_sha256'], definition['tree_sha256'])
        code, out, err = self.run_st_test('--check', 'demo', '--status')
        self.assertEqual(code, 0, out + err)
        self.assertRegex(out, r'demo +covered ')

    def test_against_a_base_whose_wrapper_refuses_lane_edits_the_check_is_left_to_ci(self):
        wrap = self.work / 'scripts/evidence-wrap'
        wrap.write_text(wrap.read_text().replace('\nSIGNS_LANE_EDITS = True\n', '\n'))  # the base's wrapper from before 2026-10-26
        self.lane_file()
        self.commit('scripts/lane.sh', 'lane, but fewer tests\n')
        code, out, err = self.run_st_test('--check', 'demo')
        # Not a failure: nothing failed, the check is not signed and CI runs it (exit 4).
        self.assertEqual(code, 4, err)
        self.assertEqual(self.statements(), [])
        self.assertRegex(out, r'demo +not signed +0s +this tree edits its lane \(scripts/lane\.sh\); CI runs it')
        self.assertNotIn('FAILED', out)
        code, out, err = self.run_st_test('--check', 'demo', '--status')
        self.assertEqual(code, 0, out + err)  # fractal-test still reports it so; the pre-push hook refuses it (evidence-prepush)
        self.assertRegex(out, r'demo +lane edit: CI runs it +this tree edits its lane \(scripts/lane\.sh\)')

    def main_moves(self, name, content):
        """main gains a commit the feature branch does not have."""
        git(self.work, 'checkout', '-q', '--detach', 'origin/main')
        self.commit(name, content)
        git(self.work, 'push', '-q', 'origin', 'HEAD:main')
        git(self.work, 'checkout', '-q', 'feature')
        git(self.work, 'fetch', '-q', 'origin')

    def test_a_branch_that_only_lags_a_lane_change_on_main_is_signed_for_its_branch_point_and_covered(self):
        policy = json.loads(json.dumps(POLICY))
        wrapper = policy['checks']['demo']['kinds']['wrapper']
        wrapper['by_level'] = {'host': {'command': wrapper['command'], 'events': ['pull_request'], 'lane': True}}
        (self.work / '.st/evidence-skip-policy.json').write_text(json.dumps(policy))
        self.lane_file()
        point = git(self.work, 'rev-parse', 'HEAD')
        self.commit('b.txt', 'two')
        self.main_moves('scripts/lane.sh', 'lane, and more, on main\n')
        code, out, err = self.run_st_test('--check', 'demo')
        self.assertEqual(code, 0, out + err)
        self.assertIn('covered by wrapper', out)
        statement, = self.statements()
        verifier = importlib.machinery.SourceFileLoader('ev', str(ROOT / 'scripts/evidence-verify')).load_module()
        rules = verifier.lane_rules(git(self.work, 'show', f'{point}:.st/required-lanes.json'), 'demo')
        at_point = verifier.lane_definition(str(self.work), git(self.work, 'rev-parse', f'{point}^{{tree}}'),
                                            git(self.work, 'rev-parse', 'HEAD^{tree}'), rules)['sha256']
        self.assertEqual(statement['predicate']['observed']['inputs']['lane_definition_sha256'], at_point)
        code, out, err = self.run_st_test('--check', 'demo', '--status')
        self.assertEqual(code, 0, out + err)
        self.assertRegex(out, r'demo +covered ')

    def test_the_branch_point_is_the_base_when_main_changed_the_lane_file_itself(self):
        self.lane_file()
        point = git(self.work, 'rev-parse', 'HEAD')
        self.commit('b.txt', 'two')
        cwd = os.getcwd()
        os.chdir(self.work)
        try:
            with mock.patch.dict(os.environ, GIT_ENV):
                self.assertEqual(st_test.branch_point('HEAD', 'origin/main'), point)
                self.main_moves('a.txt', 'main moved\n')
                self.assertEqual(st_test.branch_point('HEAD', 'origin/main'), point)  # main moved, the lane file did not
                lanes = json.loads((self.work / '.st/required-lanes.json').read_text())
                lanes['lanes']['demo']['argv'] = ['sh', '-c', 'echo ran more']
                self.main_moves('.st/required-lanes.json', json.dumps(lanes))
                self.assertEqual(st_test.branch_point('HEAD', 'origin/main'), 'origin/main')
        finally:
            os.chdir(cwd)

    def test_status_does_not_count_an_unsigned_lane_edit_as_covered(self):
