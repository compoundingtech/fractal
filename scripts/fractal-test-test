    def test_a_check_that_builds_runs_in_a_builds_slice_scope_without_holding_a_stage_slot(self):
        self.commit('b.txt', 'two')
        tmp = Path(self.tmp.name)
        calls = tmp / 'calls'
        bin_dir, runtime = tmp / 'bin', tmp / 'runtime'
        bin_dir.mkdir()
        runtime.mkdir()
        (runtime / 'bus').touch()
        (self.home / '.local/bin').mkdir(parents=True)
        # A shim that supports --stage-slot and a systemd-run: each records its arguments and runs what follows its `--`.
        recorder = '#!/bin/sh\n# --stage-slot\nprintf "%s\\n" "$(basename "$0") $*" >> {calls}\nwhile [ "$1" != -- ]; do shift; done; shift; exec "$@"\n'
        for path in (self.home / '.local/bin/cargo', bin_dir / 'systemd-run'):
            path.write_text(recorder.format(calls=calls))
            path.chmod(0o755)
        env = {'PATH': f'{bin_dir}:{os.environ["PATH"]}', 'XDG_RUNTIME_DIR': str(runtime), 'ST_EVIDENCE_GOVERN': 'on'}
        with mock.patch.object(st_test, 'BUILDS', frozenset({'demo'})):
            code, out, err = self.run_st_test('--check', 'demo', extra_env=env)
            self.assertEqual(code, 0, err)
            # The scope alone: no stage ticket, whose holder the test guardian's cargo commands would queue behind (they detach).
            only, = calls.read_text().splitlines()
            self.assertTrue(only.startswith('systemd-run --user --scope --quiet --collect --slice=builds.slice -- '), only)
            self.assertIn('evidence-wrap --check demo', only)
            statement, = self.statements()
            self.assertEqual(statement['predicate']['observed']['checks']['demo']['command'], ['sh', '-c', 'echo ran'])  # what is signed is unchanged
            calls.unlink()
            self.commit('c.txt', 'three')
            self.assertEqual(self.run_st_test('--check', 'demo', extra_env=dict(env, ST_EVIDENCE_GOVERN='off'))[0], 0)
            self.assertFalse(calls.exists())
            self.commit('d.txt', 'four')
            (tmp / 'no-bus').mkdir()
            code, out, err = self.run_st_test('--check', 'demo', extra_env=dict(env, XDG_RUNTIME_DIR=str(tmp / 'no-bus')))  # no user bus: runs anyway, and says so
            self.assertEqual(code, 0, err)
            self.assertIn('fractal-test: demo runs without the host build cap (no user systemd bus for a builds.slice scope)', err)
            self.assertFalse(calls.exists())  # neither a scope nor a ticket
        self.commit('e.txt', 'five')
        self.assertEqual(self.run_st_test('--check', 'demo', extra_env=env)[0], 0)
        self.assertFalse(calls.exists())  # a check that builds nothing is not wrapped

    def test_fractal_web_is_not_relevant_when_no_web_input_changed_by_the_base_s_own_rules(self):
        (self.work / 'scripts').mkdir(exist_ok=True)
        shutil.copy(ROOT / 'scripts/ci-fractal-web-changes', self.work / 'scripts/ci-fractal-web-changes')
        git(self.work, 'checkout', '-q', 'main')
        git(self.work, 'add', '.')
        git(self.work, 'commit', '-q', '-m', 'the base decides web relevance')
        git(self.work, 'push', '-q', 'origin', 'main')
        git(self.work, 'checkout', '-q', 'feature')
        git(self.work, 'merge', '-q', 'main')
        self.commit('crates.txt', 'a change no web lane reads')
        st_test.LOCAL['fractal-web'] = ['sh', '-c', 'echo web']
        code, out, err = self.run_st_test('--check', 'fractal-web', '--status')
        self.assertEqual(code, 0, out + err)
        self.assertRegex(out, r'fractal-web +not relevant +no web input changed since [0-9a-f]{12}: CI does not run the lane')
        code, out, err = self.run_st_test('--check', 'fractal-web')
        self.assertEqual(code, 0, out + err)  # nothing to run or sign: not a failure
        self.assertRegex(out, r'fractal-web +not relevant +0s ')
        self.assertEqual(self.statements(), [])
        (self.work / 'apps/fractal-web').mkdir(parents=True)
        self.commit('apps/fractal-web/page.ts', 'export const page = 1\n')
        code, out, err = self.run_st_test('--check', 'fractal-web', '--status')
        self.assertEqual(code, 3, out + err)  # a web change: the lane runs, and nothing covers it yet
        self.assertRegex(out, r'fractal-web +not covered ')

    def web_base(self):
        """The base decides web relevance (the real change-detection script) and the policy requires and orders kit_inputs, as the committed one."""
        (self.work / 'scripts').mkdir(exist_ok=True)
        shutil.copy(ROOT / 'scripts/ci-fractal-web-changes', self.work / 'scripts/ci-fractal-web-changes')
        policy = json.loads(json.dumps(POLICY))
        demo = policy['checks']['demo']
        web = json.loads(json.dumps(demo))
        wrapper = web['kinds']['wrapper']
        wrapper['required_inputs'] = sorted(set(wrapper['required_inputs']) | set(st_test.WEB_INPUTS))
        wrapper['input_order'] = {'kit_inputs': ['true', 'false']}
        policy['checks']['fractal-web'] = web
        git(self.work, 'checkout', '-q', 'main')
        (self.work / '.st/evidence-skip-policy.json').write_text(json.dumps(policy))
        git(self.work, 'add', '.')
        git(self.work, 'commit', '-q', '-m', 'the base requires and orders kit_inputs for fractal-web')
        git(self.work, 'push', '-q', 'origin', 'main')
        git(self.work, 'checkout', '-q', 'feature')
        git(self.work, 'merge', '-q', 'main')
        st_test.LOCAL['fractal-web'] = ['sh', '-c', 'echo ran']

    def test_a_signed_fractal_web_tree_reads_as_covered_through_status_with_the_run_input_the_gate_passes(self):
        self.web_base()
        (self.work / 'apps/fractal-web/src/web').mkdir(parents=True)
        self.commit('apps/fractal-web/src/web/AgentActions.tsx', 'export const kit = 1\n')  # a kit input: kit_inputs=true
        code, out, err = self.run_st_test('--check', 'fractal-web', '--status')
        self.assertEqual(code, 3, out + err)
        self.assertRegex(out, r'fractal-web +not covered ')
        code, out, err = self.run_st_test('--check', 'fractal-web')
        self.assertEqual(code, 0, out + err)
        self.assertRegex(out, r'fractal-web +passed')
        code, out, err = self.run_st_test('--check', 'fractal-web', '--status')
        self.assertEqual(code, 0, out + err)  # was 'not covered: no_run_input' while the verifier was never told the run's kit_inputs
        self.assertRegex(out, r'fractal-web +covered ')
        code, out, err = self.run_st_test('--check', 'fractal-web')
        self.assertEqual(code, 0, out + err)
        self.assertRegex(out, r'fractal-web +already signed')

    def test_the_kit_inputs_a_status_passes_follow_the_diff_not_a_constant(self):
        self.web_base()
        self.commit('crates.txt', 'no web input')
        self.assertEqual(st_test.run_input_arguments('demo', 'origin/main'), [])  # other checks have none
        cwd = os.getcwd()
        os.chdir(self.work)
        try:
            self.assertEqual(st_test.run_input_arguments('fractal-web', 'origin/main'), ['--run-input', 'kit_inputs=false'])
            (self.work / 'apps/fractal-web').mkdir(parents=True, exist_ok=True)
            self.commit('apps/fractal-web/page.ts', 'export const page = 1\n')  # web-relevant but not a kit input
            self.assertEqual(st_test.run_input_arguments('fractal-web', 'origin/main'), ['--run-input', 'kit_inputs=false'])
            (self.work / 'apps/fractal-web/src/web').mkdir(parents=True)
            self.commit('apps/fractal-web/src/web/AgentActions.tsx', 'export const kit = 1\n')
            self.assertEqual(st_test.run_input_arguments('fractal-web', 'origin/main'), ['--run-input', 'kit_inputs=true'])
        finally:
            os.chdir(cwd)

    def test_the_web_inputs_a_local_run_records_pass_the_committed_policy_s_value_rules(self):
        loader = importlib.machinery.SourceFileLoader('evidence_verify_for_web', str(ROOT / 'scripts/evidence-verify'))
        verify = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
        loader.exec_module(verify)
        rules = verify.policy_rules((ROOT / '.st/evidence-skip-policy.json').read_text(), 'fractal-web', 'org/repo')
        wrapper = rules['kinds']['wrapper']
        for detected in ('true', 'false'):  # covers a run whatever its own change detection said about the kit
            verify.value_checks(wrapper, st_test.WEB_INPUTS, {'kit_inputs': detected}, None)
        host = wrapper['by_level']['host']
        self.assertEqual(list(host['command']), LOCAL['fractal-web'])
        standard = {'flake_lock_sha256', 'toolchain_sha256', 'wrapper_sha256', 'system', 'attempt'}  # evidence-wrap's own
        self.assertEqual(set(host['required_inputs']), standard | set(st_test.WEB_INPUTS))

    def test_every_check_of_the_per_pr_suite_runs_by_default_and_all_means_the_same(self):
        # No subset for signing: with no flag fractal-test runs the whole per-PR suite; --all is an accepted alias; --check selects.
        # The VM tests and the mail redelivery canaries run daily, not here.
        suite = ['typescript-client', 'genie-freshness', 'ci-script-tests', 'linux-gate', 'fractal-web', 'rust-tests']
        for args, names in (([], suite), (['--all'], suite), (['--check', 'linux-gate'], ['linux-gate'])):
            done = subprocess.run([sys.executable, str(ROOT / 'scripts/fractal-test'), '--list', *args], capture_output=True, text=True)
            self.assertEqual(done.returncode, 0, done.stderr)
            self.assertEqual([line.split(':')[0] for line in done.stdout.splitlines()], names, args)

    def runs(self, path=None):
        path = path or self.home / '.local/state/st-test/runs.jsonl'
        return [json.loads(line) for line in path.read_text().splitlines()] if path.exists() else []

    def test_every_run_appends_one_json_line_with_its_times_and_a_named_check_is_not_a_full_run(self):
        self.commit('b.txt', 'two')
        code, out, err = self.run_st_test()
        self.assertEqual(code, 0, out + err)
        record, = self.runs()
        self.assertEqual(sorted(record), sorted(['v', 'started', 'ended', 'total_s', 'host', 'tree', 'commit', 'base', 'behind', 'full', 'checks',
                                                 'pool_tree', 'warm', 'parallel', 'rows', 'exit', 'stages', 'tree_wait_s', 'tree_slot_wait_s',
                                                 'tree_held_s', 'tree_blocked_s', 'tree_pre_start_s', 'tree_slot_blocked_s']))
        # Its tree: free at once, and nothing that waited in it (no check here runs scripts/ci-local).
        self.assertEqual((record['tree_wait_s'], record['tree_slot_wait_s'], record['tree_blocked_s']), (0, 0, 0))
        self.assertLessEqual(record['tree_held_s'], record['total_s'])
        for field in ('started', 'ended'):
            self.assertRegex(record[field], r'^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ$')
        self.assertLessEqual(record['started'], record['ended'])
        self.assertIsInstance(record['total_s'], int)
        self.assertEqual((record['v'], record['host'], record['tree'], record['commit'], record['base'], record['behind']),
                         (1, socket.gethostname().split('.')[0], git(self.work, 'rev-parse', 'HEAD^{tree}'), git(self.work, 'rev-parse', 'HEAD'),
                          git(self.work, 'rev-parse', 'origin/main'), 0))
        # The whole (here one-check) suite, on pool tree 0; nothing builds, so warmth does not apply; nothing ran alongside.
        self.assertEqual((record['full'], record['checks'], record['pool_tree'], record['warm'], record['parallel'], record['exit'], record['stages']),
                         (True, ['demo'], 0, None, False, 0, []))
        # One row per check, after the setup row (the time before any check: fetch, the clean tree, the members).
        setup, row = record['rows']
        self.assertEqual((setup['name'], setup['result'], type(setup['seconds'])), ('setup', 'done', int))
        self.assertEqual((sorted(row), row['name'], row['result'], type(row['seconds'])), (['name', 'result', 'seconds'], 'demo', 'passed', int))
        self.assertLessEqual(row['seconds'] + setup['seconds'], record['total_s'])
        self.commit('c.txt', 'three')
        code, out, err = self.run_st_test('--check', 'demo', command=['sh', '-c', 'exit 3'])
        self.assertEqual(code, 1, out + err)
        first, second = self.runs()
        self.assertEqual(first, record, 'appended, never rewritten')
        by_name = {row['name']: row for row in second['rows']}
        self.assertEqual((second['full'], second['exit'], by_name['demo']['result']), (False, 1, 'FAILED (3)'))
        self.run_st_test('--status')
        self.assertEqual(len(self.runs()), 2, 'a status question runs nothing and records nothing')

    def test_the_runs_file_follows_xdg_state_home_and_st_test_runs_and_off_records_nothing(self):
        self.commit('b.txt', 'two')
        state = Path(self.tmp.name) / 'state'
        self.assertEqual(self.run_st_test(extra_env={'XDG_STATE_HOME': str(state)})[0], 0)
        self.assertEqual(len(self.runs(state / 'st-test/runs.jsonl')), 1)
        chosen = Path(self.tmp.name) / 'elsewhere/runs.jsonl'
        self.assertEqual(self.run_st_test(extra_env={'ST_TEST_RUNS': str(chosen), 'XDG_STATE_HOME': str(state)})[0], 0)
        self.assertEqual(len(self.runs(chosen)), 1)
        self.assertEqual(len(self.runs(state / 'st-test/runs.jsonl')), 1)
        code, out, err = self.run_st_test(extra_env={'ST_TEST_RUNS': 'off', 'XDG_STATE_HOME': str(state)})
        self.assertEqual(code, 0, out + err)
        self.assertEqual((len(self.runs(chosen)), len(self.runs(state / 'st-test/runs.jsonl')), self.runs()), (1, 1, []))
        self.assertNotIn('record', err)

    def test_a_runs_file_that_cannot_be_written_is_one_line_on_stderr_and_never_changes_the_exit_code(self):
        self.commit('b.txt', 'two')
        blocked = Path(self.tmp.name) / 'a-file'
        blocked.write_text('not a directory\n')
        for command, expected in ((['sh', '-c', 'echo ran'], 0), (['sh', '-c', 'exit 3'], 1)):
            self.commit('c.txt', str(expected))
            code, out, err = self.run_st_test('--check', 'demo', command=command, extra_env={'ST_TEST_RUNS': str(blocked / 'runs.jsonl')})
            self.assertEqual(code, expected, out + err)
            self.assertEqual(err.count("fractal-test: could not record this run's times: "), 1, err)

    def test_scripts_ci_local_s_stage_table_is_read_from_its_output_and_lines_that_are_not_rows_are_not(self):
        log = Path(self.tmp.name) / 'gate.log'
        log.write_text('\n'.join([
            'ci-local: running tests',
            'ci-local:   stage                      start                 end                   seconds',
            'ci-local:   setup                      2026-10-23T10:00:00Z  2026-10-23T10:01:10Z      70s',
            'ci-local:   tests                      2026-10-23T10:01:10Z  2026-10-23T10:09:30Z     500s  exit 0   queue: 2 waits, 31s',
            'ci-local:   clippy                     2026-10-23T10:09:30Z  2026-10-23T10:11:00Z      90s  exit 101 queue: 0 waits, 0s\r',
            'test result: ok. 2026-10-23T10:00:00Z  2026-10-23T10:01:10Z 70s',
        ]) + '\n')
        self.assertEqual(st_test.ci_local_stages(log), [
            {'name': 'setup', 'start': '2026-10-23T10:00:00Z', 'end': '2026-10-23T10:01:10Z', 'seconds': 70, 'exit': None, 'queue_waits': None, 'queue_s': None},
            {'name': 'tests', 'start': '2026-10-23T10:01:10Z', 'end': '2026-10-23T10:09:30Z', 'seconds': 500, 'exit': 0, 'queue_waits': 2, 'queue_s': 31},
            {'name': 'clippy', 'start': '2026-10-23T10:09:30Z', 'end': '2026-10-23T10:11:00Z', 'seconds': 90, 'exit': 101, 'queue_waits': 0, 'queue_s': 0}])
        # The printf the table comes from, as #3718 writes it, reads back the same.
        row = subprocess.run(['printf', 'ci-local:   %-26s %s  %s  %6ss  exit %-3s queue: %s waits, %ss\n', 'fleet-compat', '2026-10-23T10:11:00Z',
                              '2026-10-23T10:12:00Z', '60', '1', '3', '12'], capture_output=True, text=True).stdout
        log.write_text('noise\n' + row)
        self.assertEqual(st_test.ci_local_stages(log), [{'name': 'fleet-compat', 'start': '2026-10-23T10:11:00Z', 'end': '2026-10-23T10:12:00Z',
                                                         'seconds': 60, 'exit': 1, 'queue_waits': 3, 'queue_s': 12}])
        self.assertEqual(st_test.ci_local_stages(Path(self.tmp.name) / 'missing.log'), [])

    def test_a_check_that_runs_ci_local_still_prints_as_it_goes_and_its_stages_and_warmth_are_recorded(self):
        self.commit('b.txt', 'two')
        table = ('echo gate output; echo "ci-local:   setup                      2026-10-23T10:00:00Z  2026-10-23T10:01:10Z      70s"; '
                 'echo "ci-local:   tests                      2026-10-23T10:01:10Z  2026-10-23T10:09:30Z     500s  exit 0   queue: 2 waits, 31s" >&2')
        command = ['sh', '-c', table, 'scripts/ci-local']  # its LOCAL command runs scripts/ci-local, as linux-gate's does
        env = {'ST_EVIDENCE_GOVERN': 'off'}
        with mock.patch.object(st_test, 'BUILDS', frozenset({'demo'})):
            code, out, err = self.run_st_test(command=command, extra_env=env)
            self.assertEqual(code, 0, out + err)
            self.assertLess(out.index('gate output'), out.index('fractal-test: tree'))  # streamed to the terminal, before the summary
            self.assertIn('queue: 2 waits, 31s', out)  # stderr too, as one stream
            record, = self.runs()
            self.assertEqual([(stage['name'], stage['seconds'], stage['exit']) for stage in record['stages']], [('setup', 70, None), ('tests', 500, 0)])
            self.assertIs(record['warm'], False, 'a fresh target')
            (self.pool() / 'target-0/debug').mkdir(parents=True)
            self.commit('c.txt', 'three')
            self.assertEqual(self.run_st_test(command=command, extra_env=env)[0], 0)
            self.assertIs(self.runs()[-1]['warm'], True, 'the kept target held a build')
        self.commit('d.txt', 'four')
        code, out, err = self.run_st_test(command=['sh', '-c', 'echo no table'], extra_env=env)  # a check that is not scripts/ci-local's
        self.assertEqual(code, 0, out + err)
        self.assertEqual(self.runs()[-1]['stages'], [])

    def test_a_run_that_builds_takes_its_tree_only_with_a_build_slot_free_and_records_what_it_waited_in_it(self):
        self.commit('b.txt', 'two')
        run = Path(self.tmp.name) / 'run'
        (run / 'cargo-slots/queue').mkdir(parents=True)
        holder = open(run / 'cargo-slots/heavy0', 'w')                         # another build holds the host's one heavy slot
        fcntl.flock(holder, fcntl.LOCK_EX)
        self.addCleanup(holder.close)
        # ci-local's queue log: its tests stage waited 30 s for a slot with nothing else running, and its table.
        script = ('printf "wait 1792749670 tests\\nslot 1792749700 tests\\n" >> "$CI_LOCAL_QUEUE_LOG"; echo "ci-local: stage logs in x"; '
                  'echo "ci-local:   tests                      2026-10-23T10:01:10Z  2026-10-23T10:09:30Z     500s  exit 0   queue: 1 waits, 30s"')
        command = ['sh', '-c', script, 'scripts/ci-local']
        with mock.patch.object(st_test, 'BUILDS', frozenset({'demo'})), mock.patch.object(st_test, 'TREE_SLOT_WAIT_LIMIT', 1), \
                mock.patch.object(st_test, 'POOL_WAIT_SECONDS', 0.05):
            code, out, err = self.run_st_test(command=command, extra_env={'ST_EVIDENCE_GOVERN': 'off', 'XDG_RUNTIME_DIR': str(run)})
        self.assertEqual(code, 0, out + err)
        self.assertIn('tree-0 is free, but a build started now would wait for a slot (1 of 1 heavy slots busy', err)
        self.assertIn('taking tree-0 after', err)                               # the slot never came free: the limit, then the tree
        record = self.runs()[-1]
        self.assertGreaterEqual(record['tree_slot_wait_s'], 1)
        self.assertGreaterEqual(record['tree_wait_s'], record['tree_slot_wait_s'])
        self.assertEqual((record['tree_slot_blocked_s'], record['tree_blocked_s'] - record['tree_pre_start_s']), (30, 30))
        self.assertRegex(out, r'tree-0: waited \d+s for it \(\d+s of that free, waiting for a build slot\), held it \d+s, blocked in it \d+s')

    def test_a_streamed_check_keeps_the_time_limit_and_is_not_held_by_what_it_left_behind(self):
        self.commit('b.txt', 'two')
        code, out, err = self.run_st_test('--check', 'demo', '--time-limit', '1', command=['sh', '-c', 'echo "ci-local: stage logs in x"; sleep 30', 'scripts/ci-local'])
        self.assertEqual(code, 1, out + err)
        self.assertRegex(out, r'demo +timed out')
        self.assertEqual(self.runs()[-1]['exit'], 1)
        log = Path(self.tmp.name) / 'left.log'
        started = time.monotonic()
        with mock.patch.object(st_test, 'STREAM_GRACE', 0.5), contextlib.redirect_stdout(io.StringIO()) as seen:
            self.assertEqual(st_test.streamed(['sh', '-c', '(sleep 5) & echo done; exit 7'], log, 60), 7)
        self.assertLess(time.monotonic() - started, 4, 'a process left holding the pipe does not hold the run')
        self.assertEqual((seen.getvalue(), log.read_text()), ('done\n', 'done\n'))



FAKE_RUN = """import os, sys
from xml.sax.saxutils import quoteattr
open(os.environ['FAKE_CALLS'], 'a').write(os.environ['CI_TEST_PACKAGES'] + '\\n')
code = int(os.environ.get('FAKE_EXIT', '0'))
if os.environ.get('FAKE_NO_REPORT') != '1':
    out = ['<testsuites name="nextest-run">']
    for package in os.environ['CI_TEST_PACKAGES'].split(','):
        if package == os.environ.get('FAKE_EMPTY'):
            continue  # the selection matched no test of this crate
        out.append('<testsuite name=%s>' % quoteattr(package))
        retried = '<flakyFailure message="x"/>' if package == os.environ.get('FAKE_FLAKY') else ''  # passed on a retry
        out.append('<testcase name="unit_one" classname=%s>%s</testcase>' % (quoteattr(package), retried))
        failing = package == os.environ.get('FAKE_FAIL')
        out.append('<testcase name="unit_two" classname=%s>%s</testcase>' % (quoteattr(package), '<failure message="x"/>' if failing else ''))
        out.append('</testsuite>')
        if failing:
            code = 100
    out.append('</testsuites>')
    open(os.environ['CI_TEST_JUNIT'], 'w').write('\\n'.join(out))
sys.exit(code)
"""


FAKE_GATE = """import os, sys
open(os.environ['FAKE_CALLS'], 'a').write('gate\\n')
if os.environ.get('FAKE_GATE_SKIP'):
    # A test this host cannot run reports itself, as fractal-runtime's user-namespace regression does.
    open(os.environ['CI_TEST_ENV_SKIPS'], 'a').write(os.environ['FAKE_GATE_SKIP'] + '\\n')
if os.environ.get('FAKE_GATE_NO_REPORT') != '1':
    out = ['<testsuites name="nextest-run">']
    for package in ('base', 'top'):
        retried = '<flakyFailure message="x"/>' if package == os.environ.get('FAKE_GATE_FLAKY') else ''
        out.append('<testsuite name="%s"><testcase name="unit_one" classname="%s">%s</testcase></testsuite>' % (package, package, retried))
    out.append('</testsuites>')
    open(os.environ['CI_TEST_JUNIT'], 'w').write('\\n'.join(out))
if os.environ.get('CI_TEST_FLAKY'):
    # As scripts/ci-nextest-flaky after the tests stage: the tests that passed only on a retry, one per line.
    open(os.environ['CI_TEST_FLAKY'], 'w').write(os.environ['FAKE_GATE_FLAKY'] + ' unit_one\\n' if os.environ.get('FAKE_GATE_FLAKY') else '')
"""


class PoolQueue(unittest.TestCase):
    """Pool trees go to waiters in the build host's order (cargo-priority rank by ST_AGENT or CARGO_PRIORITY_CALLER, aged as the shim ages it, then arrival), not by a race."""
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        self.root = Path(self.tmp.name) / 'pool'
        speed = mock.patch.object(st_test, 'POOL_WAIT_SECONDS', 0.05)
        speed.start()
        self.addCleanup(speed.stop)

    def test_a_rank_3_waiter_gets_the_next_free_tree_before_an_earlier_rank_50_waiter(self):
        self.root.mkdir(parents=True)
        holder = open(self.root / 'tree-0.lock', 'w')
        fcntl.flock(holder, fcntl.LOCK_EX)
        served, locks = [], []

        def waiter(tag, rank):
            n, lock = st_test.acquire_tree(self.root, 1, rank=rank)
            served.append(tag)
            locks.append(lock)
            time.sleep(0.3)
            lock.close()

        with contextlib.redirect_stderr(io.StringIO()):
            ordinary = threading.Thread(target=waiter, args=('rank-50, first to wait', 50))
            ordinary.start()
            time.sleep(0.5)                                                         # both are waiting before the tree comes free
            p0 = threading.Thread(target=waiter, args=('rank-3, later', 3))
            p0.start()
            time.sleep(0.5)
            holder.close()
            ordinary.join(10)
            p0.join(10)
        self.assertEqual(served, ['rank-3, later', 'rank-50, first to wait'])
        self.assertEqual(os.listdir(self.root / 'queue'), [])                      # both tickets are gone

    def test_a_worse_waiter_leaves_a_free_tree_alone_while_a_better_ticket_waits(self):
        queue = self.root / 'queue'
        queue.mkdir(parents=True)
        better = queue / f'003.{time.time_ns():019d}.{os.getpid()}'          # a rank-3 waiter between two of its looks at the trees
        better.touch()
        got = []
        with contextlib.redirect_stderr(io.StringIO()):
            worse = threading.Thread(target=lambda: got.append(st_test.acquire_tree(self.root, 1, rank=50)))
            worse.start()
            time.sleep(0.5)
            self.assertEqual(got, [])                                           # tree-0 is free, but it is the rank-3 ticket's
            better.unlink()
            worse.join(5)
        self.assertEqual(got[0][0], 0)
        got[0][1].close()

    def test_a_waiter_sees_a_tree_the_pool_gains_while_it_waits(self):
        self.root.mkdir(parents=True)
        holder = open(self.root / 'tree-0.lock', 'w')
        fcntl.flock(holder, fcntl.LOCK_EX)
        self.addCleanup(holder.close)
        size, got = [1], []                                                     # the host's heavy slots go from 1 to 2 while it waits
        with contextlib.redirect_stderr(io.StringIO()):
            waiter = threading.Thread(target=lambda: got.append(st_test.acquire_tree(self.root, lambda: size[0], rank=50)))
            waiter.start()
            time.sleep(0.5)
            self.assertEqual(got, [])                                           # tree-0 is held, and the pool has no other
            size[0] = 2
            waiter.join(5)
        self.assertEqual(got[0][0], 1)                                          # the new tree, while tree-0 is still held
        got[0][1].close()

    def test_the_queue_orders_by_aged_rank_then_arrival_and_drops_dead_tickets(self):
        queue = Path(self.tmp.name) / 'queue'
        queue.mkdir()
        now = 10_000 * 10**9
        live = os.getpid()
        names = {'old-50': f'050.{now - 200 * 60 * 10**9:019d}.{live}',   # 200 minutes: aged to the floor, 5
                 'p0': f'003.{now - 10**9:019d}.{live}',                  # under the floor: never aged, always first
                 'new-12': f'012.{now - 10**9:019d}.{live}',
                 'young-50': f'050.{now - 5 * 60 * 10**9:019d}.{live}',  # 5 minutes: 48
                 'dead': f'001.{now:019d}.999999999'}
        for name in names.values():
            (queue / name).touch()
        with mock.patch.object(st_test, 'process_started_ns', return_value=None):  # tickets from 1970 for a live pid: only the order is asked
            order = [name for _, _, name in st_test.tree_queue(queue, now)]
        self.assertEqual(order, [names['p0'], names['old-50'], names['new-12'], names['young-50']])
        self.assertFalse((queue / names['dead']).exists())

    def test_a_ticket_whose_pid_was_reused_by_a_younger_process_is_dropped(self):
        queue = self.root / 'queue'
        queue.mkdir(parents=True)
        started = st_test.process_started_ns(os.getpid())
        self.assertIsNotNone(started)
        self.assertLess(abs(started - time.time_ns()), 3600 * 10**9)              # this test process started within the hour
        stale = queue / f'050.{started - 60 * 10**9:019d}.{os.getpid()}'        # taken a minute before this pid's process existed
        own = queue / f'050.{started + 10**9:019d}.{os.getpid()}'
        stale.touch()
        own.touch()
        self.assertEqual([name for _, _, name in st_test.tree_queue(queue, time.time_ns())], [own.name])
        self.assertFalse(stale.exists())

    def test_the_rank_is_the_first_matching_line_of_the_priority_file_and_50_otherwise(self):
        priority = Path(self.tmp.name) / 'cargo-priority'
        priority.write_text('# rank glob\n3 agent/crew/hot/*/hot-builder*\n4 agent/crew/leads/*\n12 agent/*\n')
        rank = lambda agent: st_test.priority_rank({'ST_AGENT': agent, 'CARGO_PRIORITY_FILE': str(priority)})
        self.assertEqual(rank('agent/crew/hot/2026-10-26/hot-builder'), 3)
        self.assertEqual(rank('agent/crew/leads/lead-2'), 4)
        self.assertEqual(rank('agent/other'), 12)
        self.assertEqual(rank(''), 50)
        # The shim's caller: ST_AGENT, else CARGO_PRIORITY_CALLER (fractal-test and ci-local stages run without ST_* variables).
        by = lambda environment: st_test.priority_rank(dict(environment, CARGO_PRIORITY_FILE=str(priority)))
        self.assertEqual(by({'CARGO_PRIORITY_CALLER': 'agent/crew/hot/2026-10-26/hot-builder'}), 3)
        self.assertEqual(by({'ST_AGENT': 'agent/crew/leads/lead-2', 'CARGO_PRIORITY_CALLER': 'agent/crew/hot/x/hot-builder'}), 4)
        self.assertEqual(by({'ST_AGENT': '', 'CARGO_PRIORITY_CALLER': 'agent/crew/leads/lead-2'}), 4)
        self.assertEqual(st_test.priority_rank({'ST_AGENT': 'agent/x', 'CARGO_PRIORITY_FILE': str(priority) + '.missing'}), 50)

    def test_a_free_tree_with_a_process_still_in_it_is_skipped_until_the_process_ends(self):
        (self.root / 'tree-0').mkdir(parents=True)
        left = subprocess.Popen(['sleep', '60'], cwd=self.root / 'tree-0')  # what a run that lost tree-0 left at work in it
        self.addCleanup(left.wait)
        self.addCleanup(left.kill)
        said = io.StringIO()
        with contextlib.redirect_stderr(said):
            n, lock = st_test.acquire_tree(self.root, 2, rank=50)              # another tree is free: that one, at once
            self.assertEqual(n, 1)
            got = []
            waiter = threading.Thread(target=lambda: got.append(st_test.acquire_tree(self.root, 2, rank=50)))
            waiter.start()
            time.sleep(0.5)
            self.assertEqual(got, [])                                           # tree-0's lease is free, but the tree is not
            left.kill()
            left.wait()
            waiter.join(5)
            lock.close()
        self.assertEqual(got[0][0], 0)
        got[0][1].close()
        self.assertEqual(said.getvalue().count(f'processes {left.pid} still work in it'), 2)  # once per waiter, not on every look

    def test_a_free_tree_is_left_while_no_build_slot_is_free_and_taken_once_one_is(self):
        self.root.mkdir(parents=True)
        free, asked, waits, got = [False], [], {}, []

        def slot_ready():
            asked.append(time.monotonic())
            return free[0], 'test: 1 of 1 heavy slots busy'

        said = io.StringIO()
        with contextlib.redirect_stderr(said):
            waiter = threading.Thread(target=lambda: got.append(st_test.acquire_tree(self.root, 2, rank=50, slot_ready=slot_ready, waits=waits)))
            waiter.start()
            time.sleep(0.6)
            self.assertEqual(got, [])                                           # both trees are free, but its build would wait for a slot
            for n in range(2):                                                  # and it holds neither while it waits (only for its look)
                with open(self.root / f'tree-{n}.lock', 'w') as probe:
                    for _ in range(100):
                        try:
                            fcntl.flock(probe, fcntl.LOCK_EX | fcntl.LOCK_NB)
                            break
                        except BlockingIOError:
                            time.sleep(0.01)
                    else:
                        self.fail(f'tree-{n} stayed held while its waiter waited for a slot')
                    fcntl.flock(probe, fcntl.LOCK_UN)
            self.assertGreater(len(asked), 2, 'it looks again on every pass')
            free[0] = True
            waiter.join(5)
        n, lock = got[0]
        lock.close()
        self.assertEqual(n, 0)
        self.assertGreaterEqual(waits['slot_wait_s'], 0)
        self.assertLessEqual(waits['slot_wait_s'], waits['tree_wait_s'] + 1)
        self.assertEqual(said.getvalue().count('waiting for one without holding a tree'), 1)  # said once, not on every look
        self.assertIn('a build slot is free', said.getvalue())

    def test_a_free_tree_is_taken_anyway_once_it_has_waited_the_slot_limit_and_a_tree_in_use_does_not_count(self):
        self.root.mkdir(parents=True)
        holder = open(self.root / 'tree-0.lock', 'w')
        fcntl.flock(holder, fcntl.LOCK_EX)
        got, waits, said = [], {}, io.StringIO()
        with mock.patch.object(st_test, 'TREE_SLOT_WAIT_LIMIT', 0.5), contextlib.redirect_stderr(said):
            waiter = threading.Thread(target=lambda: got.append(st_test.acquire_tree(self.root, 1, rank=50, waits=waits,
                                                                                     slot_ready=lambda: (False, 'test: never'))))
            waiter.start()
            time.sleep(1.0)                                                     # twice the limit, but its only tree was in use
            self.assertEqual(got, [])
            holder.close()
            waiter.join(5)
        n, lock = got[0]
        lock.close()
        self.assertEqual(n, 0)
        self.assertIn('taking tree-0 after', said.getvalue())                   # slow, never starved
        self.assertGreaterEqual(waits['tree_wait_s'], 1)
        self.assertLess(waits['slot_wait_s'], waits['tree_wait_s'])             # only the time the free tree waited counts

    def test_a_build_slot_is_ready_only_while_more_heavy_slots_are_free_than_heavy_tickets_wait_and_the_gate_admits(self):
        run = Path(self.tmp.name) / 'run'
        slots = run / 'cargo-slots'
        home = Path(self.tmp.name) / 'home'
        (home / '.config').mkdir(parents=True)
        (home / '.config/cargo-heavy-slots').write_text('1\n')
        environment = {'HOME': str(home), 'XDG_RUNTIME_DIR': str(run), 'PATH': os.environ['PATH']}
        with mock.patch.dict(os.environ, environment, clear=True):
            self.assertEqual(st_test.build_slot_ready()[0], True)               # no shim on this host: nothing to wait for
            (slots / 'queue').mkdir(parents=True)
            self.assertEqual(st_test.build_slot_ready(), (True, '1 of 1 heavy slots free'))
            holder = open(slots / 'heavy0', 'w')                               # a build holds the one heavy slot
            fcntl.flock(holder, fcntl.LOCK_EX)
            ready, why = st_test.build_slot_ready()
            self.assertEqual((ready, why), (False, '1 of 1 heavy slots busy, 0 heavy build(s) waiting for one'))
            holder.close()
            sleeper = subprocess.Popen(['sleep', '60'])
            self.addCleanup(sleeper.wait)
            self.addCleanup(sleeper.kill)
            ticket = slots / 'queue' / f'heavy.050.{time.time_ns():019d}.{sleeper.pid}'
            ticket.touch()                                                      # a heavy build waits there: the free slot is its
            self.assertEqual(st_test.build_slot_ready(), (False, '0 of 1 heavy slots busy, 1 heavy build(s) waiting for one'))
            with mock.patch.dict(os.environ, {'CARGO_HEAVY_SLOTS': '2'}):
                self.assertEqual(st_test.build_slot_ready()[0], True)           # two free, one waiting
            (slots / 'queue' / f'heavy.050.{time.time_ns():019d}.999999999').touch()  # a dead waiter is skipped
            (slots / 'queue' / f'general.050.{time.time_ns():019d}.{sleeper.pid}').touch()  # and a light one does not count
            sleeper.kill()
            sleeper.wait()
            self.assertEqual(st_test.build_slot_ready()[0], True)
            self.assertEqual(len(os.listdir(slots / 'queue')), 3, "the shim's tickets are read, never removed")
            gate = Path(self.tmp.name) / 'build-admission'
            gate.write_text('#!/bin/sh\n[ "$1 $2" = "check heavy" ] || exit 9\nexit "$GATE_EXIT"\n')
            gate.chmod(0o755)
            with mock.patch.dict(os.environ, {'BUILD_ADMISSION_BIN': str(gate), 'GATE_EXIT': '1'}):
                self.assertEqual(st_test.build_slot_ready(), (False, 'the build admission gate would not admit a heavy build now (load or memory)'))
            with mock.patch.dict(os.environ, {'BUILD_ADMISSION_BIN': str(gate), 'GATE_EXIT': '2'}):
                self.assertEqual(st_test.build_slot_ready()[0], True)           # a gate that cannot read the host stops nothing, as in the shim
            with mock.patch.dict(os.environ, {'BUILD_ADMISSION_BIN': str(gate), 'GATE_EXIT': '0'}):
                self.assertEqual(st_test.build_slot_ready()[0], True)

    def test_blocked_is_the_time_a_stage_waited_for_a_slot_while_no_stage_ran(self):
        log = Path(self.tmp.name) / 'linux-gate.queue'
        t0 = calendar.timegm(time.strptime('2026-10-28T10:00:00Z', '%Y-%m-%dT%H:%M:%SZ'))
        at = lambda seconds: time.strftime('%Y-%m-%dT%H:%M:%SZ', time.gmtime(t0 + seconds))
        stages = [{'name': 'setup', 'start': at(-60), 'end': at(0)},
                  {'name': 'tests', 'start': at(0), 'end': at(400)},
                  {'name': 'clippy', 'start': at(0), 'end': at(200)},
                  {'name': 'odd', 'start': None, 'end': None}]
        # Both wait 0-40 (blocked); clippy waits on to 100 while tests runs (not blocked); tests waits 300-360 after clippy ended (blocked).
        log.write_text(''.join(f'{kind} {t0 + seconds} {stage}\n' for kind, seconds, stage in
                               (('wait', 0, 'clippy'), ('wait', 0, 'tests'), ('slot', 40, 'tests'), ('slot', 100, 'clippy'),
                                ('wait', 300, 'tests'), ('slot', 360, 'tests'))))
        self.assertEqual(st_test.blocked_seconds(log, stages), 100)
        self.assertEqual(st_test.queued_seconds(log), 160)                      # the union of the waits, as before
        self.assertEqual(st_test.blocked_seconds(log, []), 160)                 # no stage times: every wait counts
        self.assertEqual(st_test.blocked_seconds(Path(self.tmp.name) / 'missing', stages), 0)

    def test_an_interrupted_waiter_leaves_no_ticket(self):
        self.root.mkdir(parents=True)
        holder = open(self.root / 'tree-0.lock', 'w')
        fcntl.flock(holder, fcntl.LOCK_EX)
        self.addCleanup(holder.close)
        with mock.patch.object(st_test.time, 'sleep', side_effect=KeyboardInterrupt), contextlib.redirect_stderr(io.StringIO()):
            with self.assertRaises(KeyboardInterrupt):
                st_test.acquire_tree(self.root, 1, rank=50)
        self.assertEqual(os.listdir(self.root / 'queue'), [])


class PerCrate(StTest):
    """scripts/fractal-test --check rust-tests: one signature per crate, and only the crates without a passing note for their key run."""

    def setUp(self):
        super().setUp()
        self.calls = Path(self.tmp.name) / 'fake-calls'
        fake = Path(self.tmp.name) / 'fake-run.py'
        fake.write_text(FAKE_RUN)
        st_test.LOCAL['rust-tests'] = ['python3', 'scripts/ci-rust-test-result']  # StTest's patcher restores the table
        patcher = mock.patch.object(st_test, 'RUN_TESTS', [sys.executable, str(fake)])
        patcher.start()
        self.addCleanup(patcher.stop)
        git(self.work, 'checkout', '-q', 'main')
        (self.work / 'Cargo.toml').write_text('[workspace]\nmembers = ["crates/base", "crates/top"]\n')
        (self.work / 'Cargo.lock').write_text('lock\n')
        for name, deps in (('base', ''), ('top', '[dependencies]\nbase = { path = "../base" }\n')):
            (self.work / f'crates/{name}/src').mkdir(parents=True)
            (self.work / f'crates/{name}/Cargo.toml').write_text(f'[package]\nname = "{name}"\nversion = "0.1.0"\n{deps}')
            (self.work / f'crates/{name}/src/lib.rs').write_text(f'// {name}\n')
        (self.work / '.st/rust-test-inputs.json').write_text(json.dumps({'global': ['Cargo.toml', 'Cargo.lock'],
                                                                         'crates': {'base': {'extra': []}, 'top': {'extra': []}}}))
        for script in ('rust-test-keys', 'ci-rust-test-result'):
            shutil.copy(ROOT / 'scripts' / script, self.work / 'scripts' / script)
        # The real rust-tests policy entry and a lane for it: the verifier then judges every note by the repository's rules.
        policy = json.loads(json.dumps(POLICY))
        policy['checks']['rust-tests'] = json.loads((ROOT / '.st/evidence-skip-policy.json').read_text())['checks']['rust-tests']
        (self.work / '.st/evidence-skip-policy.json').write_text(json.dumps(policy))
        (self.work / '.st/required-lanes.json').write_text(json.dumps({'version': 1, 'lanes': {'rust-tests': {
            'argv': ['python3', 'scripts/ci-rust-test-result'], 'definition_paths': ['.st', 'scripts'], 'tree_inputs': ['.']}}}))
        git(self.work, 'add', '.')
        git(self.work, 'commit', '-q', '-m', 'workspace')
        git(self.work, 'push', '-q', 'origin', 'main')
        git(self.work, 'checkout', '-q', 'feature')
        git(self.work, 'merge', '-q', '--ff-only', 'main')

    def run_crates(self, *args, **env):
        extra = dict({'FAKE_CALLS': str(self.calls), 'ST_EVIDENCE_GOVERN': 'off', 'ST_EVIDENCE_TARGET': 'off'}, **env)
        return self.run_st_test('--check', 'rust-tests', *args, extra_env=extra)

    def ran(self):
        return self.calls.read_text().split() if self.calls.exists() else []

    def crate_records(self):
        return sorted((s['predicate']['observed']['inputs']['crate'], s['predicate']['observed']['checks']['rust-tests']['exit_code'])
                      for s in self.statements() if 'rust-tests' in s['predicate']['observed']['checks'])

    def test_out_exports_every_crate_even_when_its_key_is_already_covered(self):
        self.assertEqual(self.run_crates()[0], 0)
        before = self.statements()
        destination = Path(self.tmp.name) / 'exports/crates/nested'
        code, out, err = self.run_crates('--out', '../exports/crates/nested')
        self.assertEqual(code, 0, out + err)
        self.assertEqual(self.ran(), ['base,top', 'base,top'])
        self.exports(destination, ['rust-tests', 'rust-tests'])
        self.assertEqual(self.statements(), before)
        self.assertIn('packs exported, not imported or verified', out)
        code, out, err = self.run_crates('--out', '../exports/only-top', '--crate', 'top')
        self.assertEqual(code, 0, out + err)
        self.exports(Path(self.tmp.name) / 'exports/only-top', ['rust-tests'])
        self.assertEqual(self.ran()[-1], 'top')

    def test_out_exports_successful_crates_without_an_imported_verification_verdict(self):
        destination = Path(self.tmp.name) / 'exports'
        code, out, err = self.run_crates('--out', str(destination))
        self.assertEqual(code, 0, out + err)
        self.exports(destination, ['rust-tests', 'rust-tests'])
        self.assertEqual(self.crate_records(), [])

    def test_out_still_fails_when_one_crates_tests_fail(self):
        destination = Path(self.tmp.name) / 'exports'
        code, out, err = self.run_crates('--out', str(destination), FAKE_FAIL='base')
        self.assertEqual(code, 1, out + err)
        self.assertEqual(sorted(s['exit_code'] for s in self.exports(destination, ['rust-tests', 'rust-tests'])), [0, 1])
        self.assertIn('rust-tests:base', out)

    def test_seed_out_exports_the_base_without_implicitly_pushing(self):
        base_tree = git(self.work, 'rev-parse', 'origin/main^{tree}')
        self.commit('crates/top/src/lib.rs', '// branch change\n')
        destination = Path(self.tmp.name) / 'exports/seed'
        code, out, err = self.run_seed('--out', '../exports/seed')
        self.assertEqual(code, 0, out + err)
        summaries = self.exports(destination, ['rust-tests', 'rust-tests'])
        self.assertEqual({s['tree'] for s in summaries}, {base_tree})
        self.assertEqual(self.crate_records(), [])
        self.assertEqual(git(Path(self.tmp.name) / 'origin.git', 'for-each-ref', 'refs/tags/evidence'), '')

    def test_the_first_run_tests_every_crate_once_and_signs_each_separately(self):
        code, out, err = self.run_crates()
        self.assertEqual(code, 0, out + err)
        self.assertEqual(self.ran(), ['base,top'], 'one nextest run for both crates')
        self.assertEqual(self.crate_records(), [('base', 0), ('top', 0)])
        record = next(s for s in self.statements() if s['predicate']['observed']['inputs'].get('crate') == 'top')['predicate']['observed']['inputs']
        self.assertEqual(record['tests_run'], '2')
        self.assertEqual(record['tests_ignored'], '0')
        self.assertEqual(record['filterset'], 'package(=base) or package(=top)')
        self.assertRegex(record['source_inputs'], r'^[0-9a-f]{40}$')
        self.assertRegex(record['test_list_sha256'], r'^[0-9a-f]{64}$')
        self.assertRegex(record['ignored_list_sha256'], r'^[0-9a-f]{64}$')
        self.assertIn('2 of 2 crates run and signed', out)

    def test_an_unchanged_tree_runs_nothing_and_a_change_runs_the_crate_and_its_dependents_only(self):
        self.run_crates()
        code, out, err = self.run_crates()
        self.assertEqual(code, 0, out + err)
        self.assertEqual(self.ran(), ['base,top'], 'nothing ran the second time')
        self.assertIn('all 2 crates already have a passing note', out)
        self.commit('crates/top/src/lib.rs', '// changed\n')
        code, out, err = self.run_crates()
        self.assertEqual(code, 0, out + err)
        self.assertEqual(self.ran(), ['base,top', 'top'], 'base is below top: its key did not move')
        self.commit('crates/base/src/lib.rs', '// changed\n')
        self.run_crates()
        self.assertEqual(self.ran()[-1], 'base,top')

    def test_a_change_outside_every_crate_runs_nothing(self):
        self.run_crates()
        self.commit('notes.md', 'x')
        code, out, err = self.run_crates()
        self.assertEqual(code, 0, out + err)
        self.assertEqual(self.ran(), ['base,top'])

    def test_a_note_signed_on_another_tree_with_the_same_key_covers_this_one(self):
        self.run_crates()
        self.commit('notes.md', 'x')
        code, out, err = self.run_st_test('--status', '--check', 'rust-tests')
        self.assertEqual(code, 0, out + err)
        self.assertIn('2 of 2 crates covered', out)

    def test_a_failing_crate_is_recorded_as_a_failure_and_does_not_cover_itself_while_the_other_is_signed(self):
        code, out, err = self.run_crates(FAKE_FAIL='top')
        self.assertEqual(code, 1, out + err)
        self.assertEqual(self.crate_records(), [('base', 0), ('top', 1)])
        code, out, err = self.run_st_test('--status', '--check', 'rust-tests')
        self.assertEqual(code, 3, out + err)
        self.assertIn('to run: top', out)

    def test_a_run_that_did_not_complete_signs_nothing(self):
        code, out, err = self.run_crates(FAKE_EXIT='101', FAKE_NO_REPORT='1')
        self.assertEqual(code, 1, out + err)
        self.assertEqual(self.crate_records(), [])
        self.assertIn('no crate was signed', out)

    def test_crate_narrows_the_run_to_the_named_crates_and_refuses_a_name_that_is_not_one(self):
        code, out, err = self.run_crates('--crate', 'base')
        self.assertEqual(code, 0, out + err)
        self.assertEqual(self.ran(), ['base'])
        self.assertEqual(self.crate_records(), [('base', 0)])
        code, out, err = self.run_crates('--crate', 'nope')
        self.assertEqual(code, 1, out + err)
        self.assertIn('not a workspace crate of this tree: nope', out)

    def test_the_filterset_input_stays_within_what_the_signer_takes_and_still_pins_the_crate_list(self):
        small = st_test.filterset_input(['base', 'top'])
        self.assertEqual(small, 'package(=base) or package(=top)')
        crates = [f'fractal-crate-number-{n}' for n in range(52)]
        big = st_test.filterset_input(crates)
        self.assertLessEqual(len(big), 500)
        self.assertRegex(big, r'^52 packages sha256:[0-9a-f]{64}$')
        self.assertNotEqual(big, st_test.filterset_input(crates[:-1] + ['other']))
        self.assertEqual(big, st_test.filterset_input(list(crates)))

    def test_signing_jobs_come_from_the_environment_and_a_bad_value_is_the_default(self):
        for value, expected in (('3', 3), ('0', 1), ('-2', 1), ('x', 8), ('', 8)):
            with mock.patch.dict(st_test.POOL_SETTINGS, {'ST_TEST_SIGN_JOBS': value}):
                self.assertEqual(st_test.sign_jobs(), expected, value)
        with mock.patch.dict(st_test.POOL_SETTINGS, clear=True):
            self.assertEqual(st_test.sign_jobs(), 8)

    def test_the_shared_toolchain_digest_is_none_when_it_cannot_be_named_so_each_wrap_reports_for_itself(self):
        self.assertIsNone(st_test.shared_toolchain('/nonexistent/evidence-wrap'))

    def test_every_crate_is_signed_when_the_signatures_run_side_by_side(self):
        for jobs in ('1', '8'):
            git(self.work, 'checkout', '-q', '-B', f'jobs{jobs}', 'main')
            code, out, err = self.run_crates(ST_TEST_SIGN_JOBS=jobs)
            self.assertEqual(code, 0, out + err)
            self.assertEqual(self.crate_records(), [('base', 0), ('top', 0)], jobs)
            git(self.work, 'checkout', '-q', 'feature')
            for ref in git(self.work, 'for-each-ref', '--format=%(refname)', 'refs/notes/evidence', 'refs/tags/evidence', 'refs/notes/evidence-input').split():
                git(self.work, 'update-ref', '-d', ref)

    def test_the_records_of_a_run_are_pushed_together_with_their_input_index_refs(self):
        origin = Path(self.tmp.name) / 'origin.git'
        def remote_refs():
            return subprocess.run(['git', '-C', str(origin), 'for-each-ref', '--format=%(refname)', 'refs/tags/evidence/', 'refs/notes/evidence', 'refs/notes/evidence-input/'],
                                  capture_output=True, text=True, check=True).stdout.split()
        before = len(remote_refs())
        code, out, err = self.run_crates('--push', 'origin')
        self.assertEqual(code, 0, out + err)
        refs = remote_refs()[:]
        self.assertEqual(len(refs) - before, 8, 'four refs for each of the two records: tag, note and both input index refs')
        self.assertEqual(sum('evidence/input/rust-tests/' in ref for ref in refs), 2)
        self.assertEqual(sum('evidence-input/rust-tests/' in ref for ref in refs), 2)

    def test_a_push_that_fails_is_a_failed_row_not_a_silent_success(self):
        git(self.work, 'remote', 'set-url', '--push', 'origin', '/nonexistent/origin.git')
        with mock.patch.object(st_test.time, 'sleep'):
            code, out, err = self.run_crates('--push', 'origin')
        self.assertEqual(code, 1, out + err)
        self.assertIn('rust-tests:push', out)
        self.assertIn('push of 8 of 8 refs failed after 3 tries', out)

    def members(self, *extra):
        verifier = ROOT / 'scripts/evidence-verify'
        # The gate copies the accepted base's verifier and scripts/rust-test-keys side by side; so does this.
        side = Path(self.tmp.name) / 'side'
        side.mkdir(exist_ok=True)
        for name in ('evidence-verify', 'rust-test-keys'):
            shutil.copy(ROOT / 'scripts' / name, side / name)
        keys = Path(self.tmp.name) / 'keys'
        keys.write_text(git(self.work, 'show', 'origin/main:.st/evidence-keys') + '\n')
        done = subprocess.run([sys.executable, str(side / 'evidence-verify'), '--repo', str(self.work), '--revision', 'HEAD', '--check', 'rust-tests',
                               '--members', '--policy-from', 'origin/main', '--repository', 'org/repo', '--keys', str(keys), *extra],
                              capture_output=True, text=True, env=GIT_ENV)
        return done.returncode, json.loads(done.stdout)

    def gate(self, event='merge_group'):
        """scripts/ci-evidence-gate for rust-tests as a CI job runs it: a depth-1 clone of the feature head, the base's own verifier
        and scripts/rust-test-keys, the notes on the remote."""
        tmp = Path(self.tmp.name)
        git(self.work, 'push', '-q', '--force', 'origin', 'feature')
        clone = tmp / 'gate-clone'
        shutil.rmtree(clone, ignore_errors=True)
        subprocess.run(['git', 'clone', '-q', '--depth=1', '--branch', 'feature', f'file://{tmp / "origin.git"}', str(clone)],
                       check=True, capture_output=True, env=GIT_ENV)
        (tmp / 'gate-output').write_text('')
        (tmp / 'gate-summary').write_text('')
        env = dict(GIT_ENV, CHECK='rust-tests', REPOSITORY='org/repo', HEAD_REPOSITORY='org/repo', EVENT_NAME=event, PR_NUMBER='',
                   BASE_SHA=git(self.work, 'rev-parse', 'origin/main').strip(), HEAD_SHA=git(self.work, 'rev-parse', 'feature').strip(),
                   RUN_ID='42', RUN_ATTEMPT='1', GITHUB_OUTPUT=str(tmp / 'gate-output'), GITHUB_STEP_SUMMARY=str(tmp / 'gate-summary'))
        done = subprocess.run([sys.executable, str(ROOT / 'scripts/ci-evidence-gate')], cwd=clone, env=env, capture_output=True, text=True)
        lines = [line for line in done.stdout.splitlines() if line.startswith('evidence-decision v1 ')]
        self.assertEqual(len(lines), 1, done.stdout + done.stderr)
        return dict(part.split('=', 1) for part in lines[0].split(' ')[2:])

    def test_the_gate_asks_whether_every_member_has_a_note_for_its_own_key(self):
        fields = self.gate()
        self.assertEqual((fields['outcome'], fields['reason'], fields['members'], fields['missing']), ('no_note', 'crate_uncovered', '2', '2'), fields)
        self.assertEqual(self.run_crates('--push', 'origin')[0], 0)
        fields = self.gate()
        # Satisfied; the committed rust-tests entry enforces only on pull requests, and this run is not one, so it still runs.
        self.assertEqual((fields['outcome'], fields['members'], fields['missing'], fields['decision']), ('satisfied', '2', '0', 'run'), fields)
        self.assertIn(fields['members_fetch'], ('ok', 'none'))
        self.commit('crates/top/src/lib.rs', '// changed\n')
        fields = self.gate()
        self.assertEqual((fields['outcome'], fields['reason'], fields['missing']), ('no_note', 'crate_uncovered', '1'), fields)

    def test_the_verifier_is_satisfied_only_when_every_member_has_a_note_for_its_own_key(self):
        code, result = self.members()
        self.assertEqual((code, result['reason']), (1, 'crate_uncovered'), result)
        self.assertEqual(sorted(result['missing']), ['base', 'top'])
        self.run_crates()
        code, result = self.members()
        self.assertEqual(code, 0, result)
        self.assertEqual((result['satisfied'], result['members'], sorted(result['crates'])), (True, 2, ['base', 'top']))
        self.assertEqual(result['trust_level'], 'host')
        self.assertTrue(result['enforce'] is True and result['policy'] is True)  # the committed entry enforces since 2026-10-28
        self.commit('crates/top/src/lib.rs', '// changed\n')
        code, result = self.members()
        self.assertEqual((code, sorted(result['missing'])), (1, ['top']), 'base is below top and keeps its note')
        self.run_crates()
        self.assertEqual(self.members()[0], 0)

    def on_main(self, message, change):
        git(self.work, 'checkout', '-q', 'main')
        change()
        git(self.work, 'commit', '-qam', message)
        git(self.work, 'push', '-q', 'origin', 'main')
        git(self.work, 'checkout', '-q', 'feature')

    def test_the_ran_no_test_note_names_only_the_crates_the_base_does_not_list(self):
        inputs = json.loads((self.work / '.st/rust-test-inputs.json').read_text())
        self.on_main('list base as having no test', lambda: (self.work / '.st/rust-test-inputs.json').write_text(json.dumps(dict(inputs, no_tests=['base']))))
        git(self.work, 'fetch', '-q', 'origin')
        git(self.work, 'merge', '-q', '--ff-only', 'origin/main')
        code, out, err = self.run_crates(FAKE_EMPTY='base')
        self.assertEqual(code, 0, out + err)
        self.assertNotIn('ran no test', out, 'base is listed: nothing to review')
        with contextlib.chdir(self.work):
            self.assertEqual(st_test.listed_no_tests('origin/main'), ['base'])
            self.assertEqual(st_test.listed_no_tests('origin/nope'), [])

    def test_a_note_that_ran_no_test_covers_a_crate_only_when_the_base_lists_it_as_having_none(self):
        code, out, err = self.run_crates(FAKE_EMPTY='base')
        self.assertEqual(code, 0, out + err)
        self.assertIn('1 ran no test (list under no_tests if they have none): base', out)
        code, result = self.members()
        self.assertEqual((code, sorted(result['missing'])), (1, ['base']), 'top ran tests; base ran none')
        # The same judgement on the local skip decision: base is still to run, top is covered.
        code, out, err = self.run_st_test('--status', '--check', 'rust-tests')
        self.assertEqual(code, 3, out + err)
        self.assertIn('to run: base', out)
        # A tree cannot list its own crate: only the accepted base's list counts.
        inputs = json.loads((self.work / '.st/rust-test-inputs.json').read_text())
        self.commit('.st/rust-test-inputs.json', json.dumps(dict(inputs, no_tests=['base'])))
        self.assertEqual(self.members()[0], 1)
        git(self.work, 'checkout', '-q', '-B', 'feature', 'HEAD~1')
        branch_point = git(self.work, 'rev-parse', 'origin/main').strip()
        self.on_main('list base as having no test', lambda: (self.work / '.st/rust-test-inputs.json').write_text(json.dumps(dict(inputs, no_tests=['base']))))
        git(self.work, 'fetch', '-q', 'origin')
        # The notes were signed at the branch point; the list is a change of the lane's definition on main, so they are judged there.
        code, result = self.members('--lane-base', branch_point)
        self.assertEqual((code, result['satisfied']), (0, True), result)

    def test_a_malformed_no_tests_list_is_an_error_never_an_empty_allowance(self):
        self.run_crates()
        branch_point = git(self.work, 'rev-parse', 'origin/main').strip()
        inputs = json.loads((self.work / '.st/rust-test-inputs.json').read_text())
        self.on_main('break the list', lambda: (self.work / '.st/rust-test-inputs.json').write_text(json.dumps(dict(inputs, no_tests='base'))))
        git(self.work, 'fetch', '-q', 'origin')
        code, result = self.members('--lane-base', branch_point)
        self.assertEqual((code, result['reason']), (1, 'error'), result)

    def test_a_base_that_judges_rust_tests_without_the_key_tool_is_an_error_never_a_fallback_to_the_trees_own(self):
        self.on_main('drop the tool', lambda: git(self.work, 'rm', '-q', 'scripts/rust-test-keys'))
        git(self.work, 'fetch', '-q', 'origin')
        code, out, err = self.run_crates()
        self.assertEqual(code, 1, out + err)
        self.assertIn('only the base\'s tool and inputs may key a note', out)
        self.assertEqual(self.crate_records(), [])
        self.assertEqual(self.ran(), [], 'nothing was tested or signed')

    def test_a_failed_crate_note_keeps_the_members_check_unsatisfied(self):
        self.run_crates(FAKE_FAIL='top')
        code, result = self.members()
        self.assertEqual((code, result['missing']), (1, {'top': 'check_failed'}))

    def test_members_project_prints_every_crates_key_for_the_gate_to_fetch(self):
        code, result = self.members('--project')
        self.assertEqual(code, 0)
        self.assertEqual((sorted(result['crates']), result['members']), (['base', 'top'], 2))
        for crate in result['crates'].values():
            self.assertEqual(len(crate['key']), 40)
            self.assertEqual(crate['refspecs'][1], f"+refs/notes/evidence-input/rust-tests/{crate['key']}/*:refs/notes/evidence-input/rust-tests/{crate['key']}/*")

    def test_a_tree_without_a_manifest_the_verifier_can_read_is_an_error_never_a_pass(self):
        git(self.work, 'rm', '-q', 'crates/top/Cargo.toml')
        git(self.work, 'commit', '-q', '-m', 'break')
        code, result = self.members()
        self.assertEqual((code, result['reason']), (1, 'error'), result)
        git(self.work, 'rm', '-q', '-r', 'crates', 'Cargo.toml')
        git(self.work, 'commit', '-q', '-m', 'no workspace')
        code, result = self.members()
        self.assertEqual((code, result['reason']), (1, 'error'), result)

    def run_seed(self, *args, **env):
        extra = dict({'FAKE_CALLS': str(self.calls), 'ST_EVIDENCE_GOVERN': 'off', 'ST_EVIDENCE_TARGET': 'off'}, **env)
        return self.run_st_test('--seed', *args, extra_env=extra)

    def test_seed_signs_the_per_crate_notes_of_the_base_not_of_head_and_pushes_them(self):
        main_tree = git(self.work, 'rev-parse', 'origin/main^{tree}')
        self.commit('crates/top/src/lib.rs', '// a branch change\n')
        self.assertNotEqual(git(self.work, 'rev-parse', 'HEAD^{tree}'), main_tree)
        code, out, err = self.run_seed()
        self.assertEqual(code, 0, out + err)
        self.assertEqual(self.ran(), ['base,top'])
        trees = {s['subject'][0]['digest']['gitTree'] for s in self.statements()}
        self.assertEqual(trees, {main_tree}, "the base's tree was signed, not HEAD's")
        self.assertEqual(self.crate_records(), [('base', 0), ('top', 0)])
        pushed = subprocess.run(['git', '-C', str(Path(self.tmp.name) / 'origin.git'), 'for-each-ref', '--format=%(refname)', 'refs/tags/evidence/input/'],
                                capture_output=True, text=True).stdout.split()
        self.assertEqual(len(pushed), 2, 'seed pushes to origin without being asked')
        code, out, err = self.run_seed()
        self.assertEqual(code, 0, out + err)
        self.assertIn('all 2 crates already have a passing note', out)
        self.assertEqual(self.ran(), ['base,top'])

    def test_seed_takes_a_ref_and_refuses_other_checks_and_a_ref_that_is_not_a_commit(self):
        code, out, err = self.run_seed('--check', 'demo')
        self.assertIn('--seed signs rust-tests only', str(code) + out + err)
        code, out, err = self.run_seed('nope-ref')
        self.assertIn('is not a commit', str(code) + out + err)
        code, out, err = self.run_seed('main', '--crate', 'base')
        self.assertEqual(code, 0, out + err)
        self.assertEqual(self.ran(), ['base'])

    def hook(self, body):
        path = Path(self.tmp.name) / 'origin.git/hooks/pre-receive'
        path.write_text('#!/usr/bin/env bash\n' + body)
        path.chmod(0o755)

    def push_refs(self, count):
        head = git(self.work, 'rev-parse', 'HEAD')
        refs = [f'refs/notes/pushtest/r{n}' for n in range(count)]
        for ref in refs:
            git(self.work, 'update-ref', ref, head)
        return refs

    def remote_refs(self):
        return subprocess.run(['git', '-C', str(Path(self.tmp.name) / 'origin.git'), 'for-each-ref', '--format=%(refname)', 'refs/notes/pushtest/'],
                              capture_output=True, text=True).stdout.split()

    def test_records_are_pushed_in_chunks_and_a_ref_that_fails_once_is_retried_on_its_own(self):
        calls = Path(self.tmp.name) / 'pushes'
        refs = self.push_refs(85)
        self.hook(f'echo x >> {calls}\nif [ ! -e {calls}.rejected ]; then touch {calls}.rejected; echo "transient" >&2; exit 1; fi\nexit 0\n')
        with mock.patch.dict(os.environ, GIT_ENV, clear=True), mock.patch.object(st_test.time, 'sleep'), contextlib.chdir(self.work):
            self.assertIsNone(st_test.push_records(self.work, 'origin', refs))
        self.assertEqual(sorted(self.remote_refs()), sorted(refs))
        self.assertEqual(len(calls.read_text().split()), 4, 'three chunks of at most 40, and the one that failed once again')

    def test_batched_publication_only_sends_selected_refs_not_the_cached_namespace(self):
        refs = self.push_refs(85)
        head = git(self.work, 'rev-parse', 'HEAD')
        git(self.work, 'update-ref', '--stdin', stdin=''.join(
            f'update refs/notes/pushtest/cached-{n} {head}\n' for n in range(2000)).encode())
        calls = Path(self.tmp.name) / 'batch-sizes'
        self.hook(f'count=0\nwhile read -r old new ref; do count=$((count + 1)); done\n'
                  f'echo "$count" >> {calls}\n[ "$count" -le {st_test.PUSH_CHUNK} ]\n')
        with mock.patch.dict(os.environ, GIT_ENV, clear=True), contextlib.chdir(self.work):
            self.assertIsNone(st_test.push_records(self.work, 'origin', refs))
        self.assertEqual(sorted(self.remote_refs()), sorted(refs))
        self.assertEqual(calls.read_text().split(), ['40', '40', '5'])

    def test_a_ref_the_remote_keeps_rejecting_is_named_with_its_reason_after_the_tries(self):
        refs = self.push_refs(3)
        self.hook('echo "no such thing" >&2\nexit 1\n')
        with mock.patch.dict(os.environ, GIT_ENV, clear=True), mock.patch.object(st_test.time, 'sleep') as slept, contextlib.chdir(self.work):
            error = st_test.push_records(self.work, 'origin', refs)
        self.assertIn('push of 3 of 3 refs failed after 3 tries', error)
        self.assertIn('refs/notes/pushtest/r0', error)
        self.assertEqual(slept.call_count, 2)
        self.assertEqual(self.remote_refs(), [])

    def test_coverage_is_asked_of_the_verifier_once_for_all_the_crates(self):
        self.run_crates()
        with mock.patch.object(st_test, 'covered', side_effect=AssertionError('asked crate by crate')):
            code, out, err = self.run_st_test('--status', '--check', 'rust-tests')
        self.assertEqual(code, 0, out + err)
        self.assertIn('2 of 2 crates covered', out)
        self.commit('crates/top/src/lib.rs', '// changed\n')
        with mock.patch.object(st_test, 'covered', side_effect=AssertionError('asked crate by crate')):
            code, out, err = self.run_st_test('--status', '--check', 'rust-tests')
        self.assertEqual(code, 3, out + err)
        self.assertIn('to run: top', out)

    def test_one_crate_with_a_failed_test_does_not_make_the_other_crates_records_unverified(self):
        # evidence-wrap's check after signing used to ask for the tree's newest rust-tests record whatever its crate: with a failed crate's record
        # on the tree (signed first, here), every crate signed after it came back "did not verify locally" (50 of 52 on hetz2 at feefaa9c95).
        code, out, err = self.run_crates('--push', 'origin', FAKE_FAIL='base')
        self.assertEqual(code, 1, out + err)
        self.assertNotIn('did not verify locally', out)
        self.assertNotIn('FAILED (record)', out)
        self.assertEqual(self.crate_records(), [('base', 1), ('top', 0)])
        self.assertIn('rust-tests:base', out)
        self.assertIn('1 of 2 crates run and signed', out)
        pushed = subprocess.run(['git', '-C', str(Path(self.tmp.name) / 'origin.git'), 'for-each-ref', '--format=%(refname)', 'refs/tags/evidence/input/'],
                                capture_output=True, text=True).stdout.split()
        self.assertEqual(len(pushed), 1, 'top (which passed) was pushed; base (which failed) was not')

    def test_the_table_shows_the_setup_time_and_where_the_rust_tests_time_went(self):
        code, out, err = self.run_crates()
        self.assertEqual(code, 0, out + err)
        rows = {line.split()[0]: line for line in out.splitlines() if line.startswith('  ')}
        self.assertIn('setup', rows)
        self.assertRegex(rows['rust-tests'], r'\[keys \d+s, verify \d+s, tests \d+s, sign \d+s, push \d+s\]')

    def test_status_names_the_crates_to_run(self):
        code, out, err = self.run_st_test('--status', '--check', 'rust-tests')
        self.assertEqual(code, 3, out + err)
        self.assertIn('2 crates to run', out)
        self.assertIn('to run: base, top', out)

    def test_rust_tests_is_in_the_default_suite_after_linux_gate(self):
        self.assertEqual(st_test.OPT_IN, frozenset())
        self.assertIn('rust-tests', st_test.BUILDS)
        for flags in ((), ('--all',)):
            code, out, err = self.run_st_test('--list', *flags)
            names = [line.split(':')[0] for line in out.splitlines()]
            self.assertIn('rust-tests', names, flags)
            self.assertLess(names.index('linux-gate') if 'linux-gate' in names else -1, names.index('rust-tests'), flags)
        code, out, err = self.run_st_test('--list', '--check', 'rust-tests')
        self.assertIn('rust-tests: python3 scripts/ci-rust-test-result', out)

    def run_with_gate(self, *args, **env):
        stub = Path(self.tmp.name) / 'fake-gate.py'
        stub.write_text(FAKE_GATE)
        st_test.LOCAL['linux-gate'] = [sys.executable, str(stub), 'tests']
        return self.run_st_test('--check', 'linux-gate', '--check', 'rust-tests', *args,
                                extra_env=dict({'FAKE_CALLS': str(self.calls), 'ST_EVIDENCE_GOVERN': 'off', 'ST_EVIDENCE_TARGET': 'off'}, **env))

    def test_out_exports_the_aggregate_and_per_crate_records_from_the_same_gate_run(self):
        destination = Path(self.tmp.name) / 'exports/gate/nested'
        code, out, err = self.run_with_gate('--out', '../exports/gate/nested')
        self.assertEqual(code, 0, out + err)
        self.assertEqual(self.ran(), ['gate'], 'export still reuses the aggregate nextest report')
        self.exports(destination, ['linux-gate', 'rust-tests', 'rust-tests'])
        self.assertEqual(self.statements(), [])
        self.assertIn("2 of 2 crates signed from linux-gate's own nextest run", out)

    def test_rust_tests_signs_the_crates_from_linux_gates_own_nextest_run_and_runs_none_of_its_own(self):
        code, out, err = self.run_with_gate()
        self.assertEqual(code, 0, out + err)
        self.assertEqual(self.ran(), ['gate'], 'linux-gate ran the tests once; rust-tests ran none')
        self.assertEqual(self.crate_records(), [('base', 0), ('top', 0)])
        record = next(s for s in self.statements() if s['predicate']['observed']['inputs'].get('crate') == 'top')['predicate']['observed']['inputs']
        self.assertEqual((record['filterset'], record['tests_run']), ('workspace', '1'))
        self.assertIn("2 of 2 crates signed from linux-gate's own nextest run", out)
        gate = next(s for s in self.statements() if 'linux-gate' in s['predicate']['observed']['checks'])['predicate']['observed']['inputs']
        self.assertEqual(gate['flaky_tests'], 'none')
        code, out, err = self.run_with_gate()
        self.assertEqual(code, 0, out + err)
        self.assertIn('all 2 crates already have a passing note', out)

    def test_a_test_that_skipped_on_this_host_is_named_in_its_crates_record_and_in_linux_gates(self):
        code, out, err = self.run_with_gate(FAKE_GATE_SKIP='top unit_one')
        self.assertEqual(code, 0, out + err)
        inputs = {s['predicate']['observed']['inputs'].get('crate'): s['predicate']['observed']['inputs'] for s in self.statements()}
        self.assertEqual((inputs['top']['env_skips'], inputs['base']['env_skips']), ('top unit_one', 'none'))
        gate = next(s for s in self.statements() if 'linux-gate' in s['predicate']['observed']['checks'])['predicate']['observed']['inputs']
        self.assertEqual(gate['env_skips'], 'top unit_one')

    def test_a_crate_with_a_test_that_passed_only_on_a_retry_is_left_for_ci_and_linux_gate_names_it(self):
        code, out, err = self.run_with_gate(FAKE_GATE_FLAKY='top')
        self.assertEqual(code, 4, out + err)  # nothing failed; a crate is left unsigned, so CI runs it
        self.assertEqual(self.crate_records(), [('base', 0)], 'top is not signed')
        self.assertIn('rust-tests:top', out)
        self.assertIn('1 test(s) passed only on a retry, CI runs it: unit_one', out)
        self.assertIn('1 left for CI, a test passed only on a retry: top', out)
        gate = next(s for s in self.statements() if 'linux-gate' in s['predicate']['observed']['checks'])['predicate']['observed']
        self.assertEqual((gate['checks']['linux-gate']['exit_code'], gate['inputs']['flaky_tests']), (0, 'top unit_one'))

    def test_a_crate_with_a_test_that_failed_every_try_fails_even_when_another_passed_only_on_a_retry(self):
        # nextest: '2 tests run: 1 passed (1 flaky), 1 failed', ci-local's tests exit 100. The retried pass must not hide the failure.
        code, out, err = self.run_crates(FAKE_FAIL='top', FAKE_FLAKY='top')
        self.assertEqual(code, 1, out + err)
        self.assertEqual(self.crate_records(), [('base', 0), ('top', 1)], 'top is recorded as a failure, as any failing crate')
        self.assertRegex(out, r'rust-tests\s+FAILED')
        self.assertRegex(out, r'rust-tests:top\s+FAILED .*unit_two')
        self.assertNotIn('left for CI', out)

    def test_without_a_report_from_linux_gate_rust_tests_runs_the_crates_it_lacks_itself(self):
        code, out, err = self.run_with_gate(FAKE_GATE_NO_REPORT='1')
        self.assertEqual(code, 0, out + err)
        self.assertEqual(self.ran(), ['gate', 'base,top'])
        self.assertIn('2 of 2 crates run and signed', out)


# PerCrate reuses StTest's repository, signer and helpers, not its tests.
for _name in [name for name in dir(StTest) if name.startswith('test_') and name not in PerCrate.__dict__]:
    setattr(PerCrate, _name, None)

if __name__ == '__main__':
    unittest.main()
