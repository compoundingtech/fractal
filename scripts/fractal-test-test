    def test_status_runs_nothing_and_says_whether_the_head_tree_is_covered(self):
        self.commit('b.txt', 'two')
        code, out, err = self.run_st_test('--check', 'demo', '--status')
        self.assertEqual((code, self.statements()), (3, []))
        self.assertIn('not covered', out)
        self.assertEqual(self.run_st_test('--check', 'demo')[0], 0)
        code, out, err = self.run_st_test('--check', 'demo', '--status')
        self.assertEqual(code, 0, out + err)
        self.assertIn('covered by wrapper', out)
        # The base moving does not change the head's own tree, so the note still covers it; a new commit does not.
        self.commit('c.txt', 'main moved', branch='main')
        git(self.work, 'push', '-q', 'origin', 'main')
        git(self.work, 'checkout', '-q', 'feature')
        self.assertEqual(self.run_st_test('--check', 'demo', '--status')[0], 0)
        self.commit('d.txt', 'another change')
        self.assertEqual(self.run_st_test('--check', 'demo', '--status')[0], 3)

    def pool(self):
        return next((self.home / '.cache/st-test/pools').iterdir())

    def test_the_light_checks_run_alongside_the_one_that_builds_and_their_output_follows_it(self):
        self.commit('b.txt', 'two')
        marks = Path(self.tmp.name) / 'marks'
        stamp = 'import sys, time; open(sys.argv[1], "a").write(f"{sys.argv[2]} {time.time()}\\n")'
        build = ['sh', '-c', f'{sys.executable} -c \'{stamp}\' {marks} build-start; sleep 2; echo BUILD-OUTPUT; '
                             f'{sys.executable} -c \'{stamp}\' {marks} build-end']
        light = ['sh', '-c', f'{sys.executable} -c \'{stamp}\' {marks} light-start; echo LIGHT-OUTPUT']
        with mock.patch.dict(st_test.LOCAL, {'demo': build, 'light': light}, clear=True), \
                mock.patch.object(st_test, 'BUILDS', frozenset({'demo'})):
            code, out, err = self.run_st_test('--check', 'demo', '--check', 'light')
            self.assertEqual(code, 0, out + err)
            times = dict(line.split() for line in marks.read_text().splitlines())
            self.assertLess(float(times['light-start']), float(times['build-end']))  # it ran during the build, not after it
            # Its output is kept and printed after the build lane under its own header, never interleaved with the build's.
            self.assertLess(out.index('----- fractal-test: light output -----'), out.index('LIGHT-OUTPUT'))
            self.assertLess(out.index('LIGHT-OUTPUT'), out.index('fractal-test: tree'))
            self.assertRegex(out, r'demo +passed')
            self.assertRegex(out, r'light +passed')
            marks.unlink()
            self.commit('c.txt', 'three')
            code, out, err = self.run_st_test('--check', 'demo', '--check', 'light', extra_env={'ST_EVIDENCE_SERIAL': '1'})
            self.assertEqual(code, 0, out + err)
            times = dict(line.split() for line in marks.read_text().splitlines())
            self.assertGreater(float(times['light-start']), float(times['build-end']))  # one after another, in the listed order
            self.assertNotIn('----- fractal-test:', out)

    def test_a_check_that_builds_uses_its_trees_kept_target_and_another_does_not(self):
        self.commit('b.txt', 'two')
        seen = Path(self.tmp.name) / 'seen'
        command = ['sh', '-c', f'echo "${{CARGO_TARGET_DIR:-none}}" >> {seen}']
        with mock.patch.object(st_test, 'BUILDS', frozenset({'demo'})):
            self.assertEqual(self.run_st_test('--check', 'demo', command=command)[0], 0)
            target = self.pool() / 'target-0'
            (target / 'junk').write_bytes(b'x' * 4096)
            with mock.patch.object(st_test, 'TARGET_MAX_GB', 1e-9):
                self.assertEqual(self.run_st_test('--check', 'demo', command=command)[0], 0)
                self.assertTrue((target / 'junk').exists())  # not a directory cargo made: never emptied
                (target / 'CACHEDIR.TAG').write_text('Signature: 8a477f597d28d172789f06886806bc55\n')
                self.assertEqual(self.run_st_test('--check', 'demo', command=command)[0], 0)  # cargo's, past the cap: emptied
            self.assertFalse((target / 'junk').exists())
            self.assertEqual(self.run_st_test('--check', 'demo', command=command, extra_env={'ST_EVIDENCE_TARGET': 'off'})[0], 0)
            self.assertEqual(self.run_st_test('--check', 'demo', command=command, extra_env={'CARGO_TARGET_DIR': '/elsewhere'})[0], 0)
            shared = self.home / 'shared-target'
            self.assertEqual(self.run_st_test('--check', 'demo', command=command, extra_env={'ST_EVIDENCE_TARGET': str(shared)})[0], 0)
        self.assertEqual(self.run_st_test('--check', 'demo', command=command)[0], 0)  # builds nothing: no kept target
        self.assertEqual(seen.read_text().split(), [str(target)] * 3 + ['none', '/elsewhere', str(shared), 'none'])

    def test_every_run_reuses_the_same_tree_path_and_finds_it_clean(self):
        self.commit('b.txt', 'two')
        seen = Path(self.tmp.name) / 'seen'
        command = ['sh', '-c', f'pwd -P >> {seen}; cat a.txt >> {seen}; ls stray 2>/dev/null >> {seen}; true']
        self.assertEqual(self.run_st_test('--check', 'demo', command=command)[0], 0)
        self.commit('c.txt', 'three')
        tree = (self.pool() / 'tree-0').resolve()
        (tree / 'a.txt').write_text('left by a killed run\n')  # a tracked change an earlier run left
        git(tree, 'add', 'a.txt')  # discard index changes as well as working-tree changes
        (tree / 'b.txt').unlink()
        (tree / 'stray').write_text('untracked')
        (tree / 'nested').mkdir()
        git(tree / 'nested', 'init', '-q')
        (tree / 'target').mkdir()
        (tree / 'target/ignored.o').write_text('x')
        (self.pool() / 'target-0').mkdir(exist_ok=True)
        (self.pool() / 'target-0/kept').write_text('build output')
        real_git = st_test.git
        def no_hard_reset(*args, **kwargs):
            self.assertFalse(args and args[0] == 'reset' and '--hard' in args,
                             'pool reuse must not require a destructive reset policy exception')
            return real_git(*args, **kwargs)
        with mock.patch.object(st_test, 'git', side_effect=no_hard_reset):
            self.assertEqual(self.run_st_test('--check', 'demo', command=command)[0], 0)
        self.assertEqual(seen.read_text().split(), [str(tree), 'one', str(tree), 'one'])  # a.txt reset, stray removed
        self.assertFalse((tree / 'target').exists())
        self.assertFalse((tree / 'nested').exists())
        self.assertEqual((tree / 'b.txt').read_text(), 'two')
        self.assertEqual((tree / 'c.txt').read_text(), 'three')
        self.assertEqual((self.pool() / 'target-0/kept').read_text(), 'build output')  # build output is outside the tree
        self.assertTrue(tree.is_dir())
        self.assertIn(str(tree), git(self.work, 'worktree', 'list'))
        self.assertEqual(git(tree, 'rev-parse', 'HEAD'), git(self.work, 'rev-parse', 'HEAD'))

    def test_a_target_trees_share_is_held_by_one_run_at_a_time(self):
        """ST_EVIDENCE_TARGET names one target for every tree: two runs on different trees once relinked binaries under each other's
        tests, so the lock is exclusive for the whole run."""
        target = Path(self.tmp.name) / 'shared-target'
        target.mkdir()
        holder = subprocess.Popen([sys.executable, '-c', 'import fcntl, sys, time; f = open(sys.argv[1], "w"); fcntl.flock(f, fcntl.LOCK_SH); '
                                   'print("held", flush=True); time.sleep(1.5)', str(target.parent / 'shared-target.lock')],
                                  stdout=subprocess.PIPE, text=True)
        self.addCleanup(holder.wait)
        self.assertEqual(holder.stdout.readline().strip(), 'held')
        err = io.StringIO()
        started = time.monotonic()
        with mock.patch.dict(os.environ, {'HOME': str(self.home), 'ST_EVIDENCE_TARGET': str(target)}, clear=True), \
                contextlib.redirect_stderr(err):
            got, lock = st_test.shared_target(tree_target=self.home / 'pool-target')
        self.addCleanup(lock.close)
        self.assertGreater(time.monotonic() - started, 1.0)  # it waited for the other run
        self.assertEqual(got, target)
        self.assertIn('another run is using', err.getvalue())
        with open(target.parent / 'shared-target.lock', 'w') as other:
            with self.assertRaises(BlockingIOError):  # and holds it exclusively, so a third run waits too
                fcntl.flock(other, fcntl.LOCK_SH | fcntl.LOCK_NB)

    def test_a_pool_tree_in_use_is_never_shared_with_a_concurrent_run(self):
        self.commit('b.txt', 'two')
        seen = Path(self.tmp.name) / 'seen'
        command = ['sh', '-c', f'pwd -P >> {seen}']
        self.assertEqual(self.run_st_test('--check', 'demo', command=command)[0], 0)
        held = open(self.pool() / 'tree-0.lock', 'w')
        self.addCleanup(held.close)
        fcntl.flock(held, fcntl.LOCK_EX)
        self.assertEqual(self.run_st_test('--check', 'demo', command=command)[0], 0)
        paths = seen.read_text().split()
        self.assertEqual([Path(p).name for p in paths], ['tree-0', 'tree-1'])

    def test_a_run_waits_for_a_tree_when_every_tree_is_in_use(self):
        self.commit('b.txt', 'two')
        self.assertEqual(self.run_st_test('--check', 'demo')[0], 0)
        held = open(self.pool() / 'tree-0.lock', 'w')
        self.addCleanup(held.close)
        fcntl.flock(held, fcntl.LOCK_EX)
        with mock.patch.object(st_test.time, 'sleep', side_effect=lambda seconds: held.close()):  # the other run ends while this one waits
            code, _, err = self.run_st_test('--check', 'demo', extra_env={'ST_TEST_TREES': '1'})
        self.assertEqual(code, 0)
        self.assertIn('all 1 pool trees are in use', err)

    def test_a_run_of_checks_that_build_nothing_takes_no_pool_tree_and_never_waits_for_one(self):
        self.commit('b.txt', 'two')
        self.assertTrue(NEEDS_TREE(['ci-script-tests', 'linux-gate']))
        self.assertFalse(NEEDS_TREE(['ci-script-tests', 'typescript-client', 'genie-freshness']))
        with mock.patch.object(st_test, 'needs_tree', NEEDS_TREE), \
                mock.patch.object(st_test, 'acquire_tree', side_effect=AssertionError('a light run waits for no tree')):
            code, out, err = self.run_st_test('--check', 'demo')
        self.assertEqual(code, 0, out + err)
        self.assertFalse((self.home / '.cache/st-test/pools').exists(), 'no pool tree was made')
        statement, = self.statements()
        self.assertIn(git(self.work, 'rev-parse', 'HEAD^{tree}'), json.dumps(statement))

    def test_the_pool_holds_the_heavy_slots_plus_one_trees_unless_told_otherwise(self):
        with mock.patch.dict(os.environ, {'HOME': str(self.home)}, clear=True), mock.patch.dict(st_test.POOL_SETTINGS, {}, clear=True):
            self.assertEqual(st_test.pool_size(), 2)
            (self.home / '.config/cargo-heavy-slots').write_text('3\n')
            self.assertEqual(st_test.pool_size(), 4)
            # The cargo shim's own formula, on every box: CARGO_HEAVY_SLOTS first, and a file that is not one number is 1, as the shim reads it.
            with mock.patch.dict(os.environ, {'CARGO_HEAVY_SLOTS': '5'}):
                self.assertEqual((st_test.heavy_slots(), st_test.pool_size()), (5, 6))
            (self.home / '.config/cargo-heavy-slots').write_text('2 # the guard\n')
            self.assertEqual((st_test.heavy_slots(), st_test.pool_size()), (1, 2))
        with mock.patch.dict(os.environ, {'HOME': str(self.home)}, clear=True), mock.patch.dict(st_test.POOL_SETTINGS, {'ST_TEST_TREES': '7'}, clear=True):
            self.assertEqual(st_test.pool_size(), 7)
        with mock.patch.dict(os.environ, {'HOME': str(self.home)}, clear=True), mock.patch.dict(st_test.POOL_SETTINGS, {'ST_TEST_TREES': 'off'}, clear=True):
            self.assertIsNone(st_test.pool_size())
        with mock.patch.dict(os.environ, {'HOME': str(self.home)}, clear=True), mock.patch.dict(st_test.POOL_SETTINGS, {'ST_TEST_TREES': '0'}, clear=True):
            with self.assertRaises(st_test.Failure):
                st_test.pool_size()

    def test_a_tree_that_cannot_be_made_clean_is_a_refusal(self):
        self.commit('b.txt', 'two')
        self.assertEqual(self.run_st_test('--check', 'demo')[0], 0)
        tree = self.pool() / 'tree-0'
        real = st_test.git
        with mock.patch.object(st_test, 'git', wraps=real) as spy:
            def fake(*args, **kwargs):
                if args[:1] == ('status',) and kwargs.get('cwd') == tree:
                    return subprocess.CompletedProcess(args, 0, b' M scripts/x\n', b'')
                return real(*args, **kwargs)
            spy.side_effect = fake
            code, _, _ = self.run_st_test('--check', 'demo')
        self.assertIn('is not clean', str(code))

    def test_read_only_directories_a_check_left_in_the_tree_do_not_stop_the_cleaning(self):
        self.commit('b.txt', 'two')
        self.assertEqual(self.run_st_test('--check', 'demo')[0], 0)
        tree = self.pool() / 'tree-0'
        (tree / '.devenv/store/deep').mkdir(parents=True)
        (tree / '.devenv/store/deep/file').write_text('copied from the store')
        for path in ((tree / '.devenv/store/deep'), (tree / '.devenv/store')):
            path.chmod(0o555)
        self.addCleanup(subprocess.run, ['chmod', '-R', 'u+rwX', str(tree)])
        self.assertEqual(self.run_st_test('--check', 'demo')[0], 0)
        self.assertFalse((tree / '.devenv/store').exists())

    def test_the_inputs_that_cost_minutes_to_fetch_survive_the_cleaning_and_everything_else_goes(self):
        self.commit('b.txt', 'two')
        self.assertEqual(self.run_st_test('--check', 'demo')[0], 0)
        tree = self.pool() / 'tree-0'
        kept = ['repos/effect-utils/src.ts', 'apps/web/node_modules/pkg/index.js', 'node_modules/.pnpm/x', 'target/compat-baselines/abc/bin']
        gone = ['stray.txt', 'target/debug/junk', 'repos-not/file', 'cache/other/node_modules_not']
        for name in kept + gone:
            (tree / name).parent.mkdir(parents=True, exist_ok=True)
            (tree / name).write_text('x')
        (tree / 'a.txt').write_text('edited')  # tracked: reset
        self.assertEqual(self.run_st_test('--check', 'demo')[0], 0)
        self.assertEqual([name for name in kept if not (tree / name).exists()], [])
        self.assertEqual([name for name in gone if (tree / name).exists()], [])
        self.assertEqual((tree / 'a.txt').read_text(), 'one\n')

    def fake_unit(self, base, repo, n, kilobytes, used):
        directory = base / repo
        (directory / f'tree-{n}').mkdir(parents=True, exist_ok=True)
        (directory / f'tree-{n}' / 'blob').write_bytes(b'x' * kilobytes * 1024)
        (directory / f'target-{n}').mkdir(parents=True, exist_ok=True)
        (directory / f'target-{n}' / 'blob').write_bytes(b'y' * kilobytes * 1024)
        lock = directory / f'tree-{n}.lock'
        lock.write_text('')
        os.utime(lock, (used, used))

    @mock.patch.object(st_test, 'du_gb', apparent_gb)
    def test_the_pool_is_kept_under_a_total_cap_by_evicting_the_least_recently_used_unlocked_units(self):
        base = Path(self.tmp.name) / 'pool'
        self.fake_unit(base, 'repo-a', 0, 200, 1_000)   # oldest
        self.fake_unit(base, 'repo-a', 1, 200, 3_000)
        self.fake_unit(base, 'repo-b', 0, 200, 2_000)
        self.fake_unit(base, 'repo-b', 1, 200, 4_000)   # newest
        held = open(base / 'repo-a/tree-0.lock', 'a')   # the oldest is in use
        self.addCleanup(held.close)
        fcntl.flock(held, fcntl.LOCK_EX)
        err = io.StringIO()
        limit = 0.0009  # GB: room for about two units of 400 KB
        with contextlib.redirect_stderr(err):
            st_test.evict_to_cap(base, limit, keep=(base / 'repo-b', 1))
        left = sorted(str(path.relative_to(base)) for path in base.glob('*/t*-[0-9]'))
        # repo-a/0 is locked, repo-b/1 is kept; repo-b/0 (used 2000) goes first, then repo-a/1 (3000)
        self.assertEqual(left, ['repo-a/target-0', 'repo-a/tree-0', 'repo-b/target-1', 'repo-b/tree-1'])
        self.assertRegex(err.getvalue(), r'evicted repo-b/tree-0 and target-0 \(0\.\d GB, idle \d+ min\)')
        self.assertIn('evicted repo-a/tree-1', err.getvalue())

    @mock.patch.object(st_test, 'du_gb', apparent_gb)
    def test_the_cap_evicts_old_layout_units_and_origin_pool_units_alike_oldest_first(self):
        base = Path(self.tmp.name) / 'pool2'
        self.fake_unit(base, 'old-clone-key', 0, 200, 1_000)        # the layout before origin pools
        self.fake_unit(base / 'pools', 'o-shared', 0, 200, 2_000)   # an origin pool
        self.fake_unit(base / 'pools', 'o-shared', 1, 200, 4_000)
        err = io.StringIO()
        with contextlib.redirect_stderr(err):
            st_test.evict_to_cap(base, 0.0007, keep=(base / 'pools' / 'o-shared', 1))  # room for about one unit of 400 KB
        self.assertFalse((base / 'old-clone-key/tree-0').exists())
        self.assertFalse((base / 'pools/o-shared/tree-0').exists())
        self.assertTrue((base / 'pools/o-shared/tree-1').exists())
        self.assertRegex(err.getvalue(), r'evicted old-clone-key/tree-0 and target-0')
        self.assertRegex(err.getvalue(), r'evicted o-shared/tree-0 and target-0')

    def test_a_pool_under_its_cap_loses_nothing_and_the_cap_can_be_turned_off(self):
        base = Path(self.tmp.name) / 'pool'
        self.fake_unit(base, 'repo-a', 0, 100, 1_000)
        with contextlib.redirect_stderr(io.StringIO()):
            st_test.evict_to_cap(base, 1.0)
        self.assertTrue((base / 'repo-a/tree-0').exists())
        with mock.patch.dict(st_test.POOL_SETTINGS, {}, clear=True):
            self.assertEqual(st_test.pool_max_gb(), 60.0)
        for value, expected in (('off', None), ('0', None), ('12.5', 12.5)):
            with mock.patch.dict(st_test.POOL_SETTINGS, {'ST_TEST_POOL_MAX_GB': value}, clear=True):
                self.assertEqual(st_test.pool_max_gb(), expected)
        for bad in ('lots', '-3'):
            with mock.patch.dict(st_test.POOL_SETTINGS, {'ST_TEST_POOL_MAX_GB': bad}, clear=True):
                with self.assertRaises(st_test.Failure):
                    st_test.pool_max_gb()

    @mock.patch.object(st_test, 'du_gb', apparent_gb)
    def test_a_run_enforces_the_cap_before_it_starts_and_never_evicts_its_own_tree(self):
        self.commit('b.txt', 'two')
        base = self.home / '.cache/st-test'
        self.fake_unit(base, 'other-repo', 0, 300, 1_000)
        code, out, err = self.run_st_test('--check', 'demo', extra_env={'ST_TEST_POOL_MAX_GB': '0.0001'})
        self.assertEqual(code, 0, err)
        self.assertFalse((base / 'other-repo/tree-0').exists())
        self.assertFalse((base / 'other-repo/target-0').exists())
        self.assertIn('evicted other-repo/tree-0', err)
        own = self.pool()
        self.assertTrue((own / 'tree-0').is_dir())  # this run's own tree stays, whatever its size
        self.assertEqual(self.run_st_test('--check', 'demo', extra_env={'ST_TEST_POOL_MAX_GB': '0.0001'})[0], 0)

    def clone_of_origin(self, name, remote=None):
        clone = Path(self.tmp.name) / name
        git(Path(self.tmp.name), 'clone', '-q', remote or str(Path(self.tmp.name) / 'origin.git'), str(clone))
        return clone

    def run_in(self, clone, *args, command=None, extra_env=None):
        saved = self.work
        self.work = clone
        try:
            return self.run_st_test(*args, command=command, extra_env=extra_env)
        finally:
            self.work = saved

    def test_origins_are_normalised_so_every_way_of_cloning_one_repository_names_one_pool(self):
        same = ['https://github.com/Org/Repo.git', 'https://user@github.com/org/repo', 'git@github.com:org/repo.git', 'ssh://git@github.com:22/org/repo.git',
                'https://GitHub.com/org/repo/']
        self.assertEqual({st_test.normalise_origin(url) for url in same}, {'github.com/org/repo'})
        self.assertNotEqual(st_test.normalise_origin('https://github.com/org/other'), 'github.com/org/repo')
        self.assertEqual(st_test.normalise_origin('/srv/git/repo.git'), '/srv/git/repo')  # a local path stays a path

    def test_a_clone_of_the_same_origin_takes_the_warm_slot_at_the_same_path_with_the_kept_inputs(self):
        ignored = '/repos/\nnode_modules/\n/target/\nstray.txt\n'  # as the repository's .gitignore: the kept inputs are not untracked files
        self.commit('.gitignore', ignored)
        self.commit('b.txt', 'two')
        seen = Path(self.tmp.name) / 'seen'
        command = ['sh', '-c', f'pwd -P >> {seen}']
        self.assertEqual(self.run_st_test('--check', 'demo', command=command)[0], 0)
        tree = (self.pool() / 'tree-0').resolve()
        for name in ('repos/member/lib.ts', 'apps/web/node_modules/pkg/index.js', 'node_modules/.pnpm/x', 'target/compat-baselines/abc/bin', 'stray.txt'):
            (tree / name).parent.mkdir(parents=True, exist_ok=True)
            (tree / name).write_text('x')
        (self.pool() / 'target-0').mkdir(exist_ok=True)
        (self.pool() / 'target-0/dep').write_text('warm registry dependency')
        other = self.clone_of_origin('second-clone')
        git(other, 'checkout', '-q', '-b', 'topic', 'origin/main')
        (other / 'c.txt').write_text('three')
        (other / '.gitignore').write_text(ignored)
        git(other, 'add', '.')
        git(other, 'commit', '-q', '-m', 'topic')
        code, out, err = self.run_in(other, '--check', 'demo', command=command)
        self.assertEqual(code, 0, out + err)
        pools = list((self.home / '.cache/st-test/pools').iterdir())
        self.assertEqual(len(pools), 1, 'the second clone shares the first one\'s pool, it does not start another')
        self.assertEqual(seen.read_text().split(), [str(tree)] * 2)  # the same path: the workspace crates stay warm
        self.assertEqual((tree / 'c.txt').read_text(), 'three')  # the second clone's commit
        self.assertEqual(git(tree, 'rev-parse', '--git-common-dir'), str((other / '.git').resolve()))  # a worktree of THIS clone now
        for kept in ('repos/member/lib.ts', 'apps/web/node_modules/pkg/index.js', 'node_modules/.pnpm/x', 'target/compat-baselines/abc/bin'):
            self.assertTrue((tree / kept).exists(), kept)
        self.assertFalse((tree / 'stray.txt').exists())
        self.assertEqual((self.pool() / 'target-0/dep').read_text(), 'warm registry dependency')  # the target is shared too
        self.assertFalse((tree.parent / 'tree-0.adopting').exists())
        # and back again: the first clone takes it over once more
        code, out, err = self.run_st_test('--check', 'demo', command=command)
        self.assertEqual(code, 0, err)
        self.assertEqual(git(tree, 'rev-parse', '--git-common-dir'), str((self.work / '.git').resolve()))
        self.assertTrue((tree / 'repos/member/lib.ts').exists())

    def test_two_clones_at_once_take_different_slots_of_the_one_pool(self):
        self.commit('b.txt', 'two')
        seen = Path(self.tmp.name) / 'seen'
        command = ['sh', '-c', f'pwd -P >> {seen}']
        self.assertEqual(self.run_st_test('--check', 'demo', command=command)[0], 0)
        held = open(self.pool() / 'tree-0.lock', 'a')  # a run of the first clone holds slot 0
        self.addCleanup(held.close)
        fcntl.flock(held, fcntl.LOCK_EX)
        other = self.clone_of_origin('third-clone')
        git(other, 'checkout', '-q', '-b', 'topic2', 'origin/main')
        self.assertEqual(self.run_in(other, '--check', 'demo', command=command)[0], 0)
        self.assertEqual([Path(line).name for line in seen.read_text().split()], ['tree-0', 'tree-1'])
        self.assertEqual(len(list((self.home / '.cache/st-test/pools').iterdir())), 1)

    def test_a_clone_with_another_origin_or_none_does_not_share_the_pool(self):
        self.commit('b.txt', 'two')
        self.assertEqual(self.run_st_test('--check', 'demo')[0], 0)
        lonely = Path(self.tmp.name) / 'lonely'
        git(Path(self.tmp.name), 'clone', '-q', str(self.work), str(lonely))  # its origin is the first clone, a different repository
        git(lonely, 'checkout', '-q', 'feature')
        self.assertEqual(self.run_in(lonely, '--check', 'demo')[0], 0)
        self.assertEqual(len(list((self.home / '.cache/st-test/pools').iterdir())), 2)
        git(lonely, 'remote', 'remove', 'origin')
        before = os.getcwd()
        os.chdir(lonely)
        try:
            with mock.patch.dict(st_test.POOL_SETTINGS, {}, clear=True), mock.patch.dict(os.environ, {'HOME': str(self.home)}):
                self.assertTrue(st_test.pool_root().name.startswith('c-'))  # no origin: its own git common dir
        finally:
            os.chdir(before)
    def main_commits(self, name, content):
        """A commit on main after the branch left it (pushed), then back on the feature branch."""
        git(self.work, 'checkout', '-q', 'main')
        (self.work / name).parent.mkdir(parents=True, exist_ok=True)
        (self.work / name).write_text(content)
        git(self.work, 'add', '.')
        git(self.work, 'commit', '-q', '-m', f'main: {name}')
        git(self.work, 'push', '-q', 'origin', 'main')
        git(self.work, 'checkout', '-q', 'feature')

    def branch_from_a_base_with_the_gate(self):
        """main gets the real gate (the rule the CI gate runs), the feature branch leaves it and commits."""
        git(self.work, 'checkout', '-q', 'main')
        shutil.copy(ROOT / 'scripts/ci-evidence-gate', self.work / 'scripts/ci-evidence-gate')
        git(self.work, 'add', '.')
        git(self.work, 'commit', '-q', '-m', 'main: the gate')
        git(self.work, 'push', '-q', 'origin', 'main')
        git(self.work, 'checkout', '-q', '-B', 'feature')
        self.commit('b.txt', 'two')

    def test_when_protected_files_moved_on_main_status_asks_about_the_merge_and_a_run_merges_main_into_the_branch(self):
        self.branch_from_a_base_with_the_gate()
        head = git(self.work, 'rev-parse', 'HEAD')
        self.main_commits('.st/evidence-skip-policy.json', json.dumps(POLICY, indent=1))  # a protected file, after the branch point
        git(self.work, 'fetch', '-q', 'origin')
        expected = git(self.work, 'merge-tree', '--write-tree', '--no-messages', 'HEAD', 'origin/main').split()[0]
        self.assertNotEqual(expected, git(self.work, 'rev-parse', 'HEAD^{tree}'))
        code, out, err = self.run_st_test('--status')
        self.assertEqual(code, 3, out + err)  # not covered: the head tree is not what CI will judge
        self.assertIn('protected files differ from the branch point', out)
        self.assertEqual(git(self.work, 'rev-parse', 'HEAD'), head)  # --status changes nothing
        code, out, err = self.run_st_test('--check', 'demo')
        self.assertEqual(code, 0, out + err)
        merge = git(self.work, 'rev-parse', 'HEAD')
        self.assertIn(f'fractal-test: protected files differ from the branch point: merged origin/main', out)
        self.assertIn(f'as {merge}; the head tree is what is signed', out)
        self.assertNotIn('CI will judge the merge', out)
        self.assertEqual(git(self.work, 'rev-list', '--parents', '-n1', 'HEAD').split(), [merge, head, git(self.work, 'rev-parse', 'origin/main')])
        self.assertEqual(git(self.work, 'rev-parse', 'HEAD^{tree}'), expected)  # the branch's head is now the merge
        self.assertIn('not pushed', out)  # no --push: the merge stays here
        statement, = self.statements()
        self.assertIn(expected, json.dumps(statement))
        code, out, err = self.run_st_test('--status', '--check', 'demo')
        self.assertEqual(code, 0, out + err)  # the head tree, which CI now judges, is covered
        self.assertNotIn('CI will judge the merge', out)

    def test_a_base_that_moves_while_the_run_waits_for_a_tree_is_merged_at_its_new_tip(self):
        self.branch_from_a_base_with_the_gate()
        self.main_commits('.st/evidence-skip-policy.json', json.dumps(POLICY, indent=1))  # a protected file: main is merged in
        real_acquire = st_test.acquire_tree
        def main_moves_while_waiting(*args, **kwargs):
            self.main_commits('later.txt', 'merged while the run waited')
            return real_acquire(*args, **kwargs)
        with mock.patch.object(st_test, 'acquire_tree', side_effect=main_moves_while_waiting):
            code, out, err = self.run_st_test('--check', 'demo')
        self.assertEqual(code, 0, out + err)
        git(self.work, 'cat-file', '-e', 'HEAD:later.txt')  # the merge holds the tip that landed during the wait
        statement, = self.statements()
        self.assertIn(git(self.work, 'rev-parse', 'HEAD^{tree}'), json.dumps(statement))
        self.assertEqual(self.run_st_test('--status', '--check', 'demo')[0], 0, 'the tree CI judges now is the one signed')

    def branch_behind(self, count):
        self.branch_from_a_base_with_the_gate()
        for i in range(count):
            self.main_commits(f'main-{i}.txt', str(i))
        return git(self.work, 'rev-parse', 'HEAD')

    def test_a_branch_past_the_head_tree_bound_merges_main_signs_its_head_tree_and_pushes_the_branch(self):
        head = self.branch_behind(30)
        git(self.work, 'push', '-q', 'origin', 'feature')
        code, out, err = self.run_st_test('--check', 'demo', '--push', 'origin')
        self.assertEqual(code, 0, out + err)
        merge = git(self.work, 'rev-parse', 'HEAD')
        self.assertNotEqual(merge, head)
        self.assertIn('fractal-test: the branch is 30 commits behind main, more than 24: merged origin/main', out)
        self.assertEqual(git(self.work, 'rev-parse', 'HEAD^2'), git(self.work, 'rev-parse', 'origin/main'))
        statement, = self.statements()
        self.assertIn(git(self.work, 'rev-parse', 'HEAD^{tree}'), json.dumps(statement))  # the head tree, not an st-test merge-tree commit
        self.assertNotIn('st-test@example.invalid', git(self.work, 'log', '-1', '--format=%ae %ce'))
        self.assertEqual(git(self.work, 'ls-remote', 'origin', 'refs/heads/feature').split()[0], merge)
        self.assertIn(f'pushed feature at the merge {merge[:12]} to origin', out)

    def test_a_branch_within_the_bound_is_not_merged(self):
        head = self.branch_behind(20)
        code, out, err = self.run_st_test('--check', 'demo', '--push', 'origin')
        self.assertEqual(code, 0, out + err)
        self.assertEqual(git(self.work, 'rev-parse', 'HEAD'), head)
        self.assertNotIn('merged origin/main', out)
        self.assertEqual(git(self.work, 'ls-remote', 'origin', 'refs/heads/feature'), '')  # st-test pushes a branch only when it merged

    def test_main_moving_a_protected_file_outside_the_check_s_ci_inputs_does_not_merge_main_in(self):
        def lanes(ci_inputs):
            return json.dumps({'version': 1, 'lanes': {'demo': {'argv': ['sh', '-c', 'echo ran'], 'definition_paths': ['a.txt'],
                                                                'ci_inputs': ci_inputs}}})
        for ci_inputs, merges in ((['a.txt'], False), (['a.txt', '.st/evidence-skip-policy.json::checks.demo'], True)):
            with self.subTest(ci_inputs):
                self.setUp()
                git(self.work, 'checkout', '-q', 'main')
                (self.work / '.st/required-lanes.json').write_text(lanes(ci_inputs))
                git(self.work, 'add', '.')
                git(self.work, 'commit', '-q', '-m', 'main: the lanes')
                git(self.work, 'push', '-q', 'origin', 'main')
                head = self.branch_behind(0)
                policy = json.loads(json.dumps(POLICY))
                policy['checks']['demo']['max_age_s'] = 86400  # a protected file moves on main, in demo's own policy entry
                self.main_commits('.st/evidence-skip-policy.json', json.dumps(policy, indent=1))
                code, out, err = self.run_st_test('--check', 'demo', '--push', 'origin')
                self.assertEqual(code, 0, out + err)
                self.assertEqual(git(self.work, 'rev-parse', 'HEAD') != head, merges, out + err)
                self.assertEqual('merged origin/main' in out, merges, out)

    def test_a_merge_that_conflicts_stops_the_run_with_the_branch_as_it_was(self):
        head = self.branch_behind(0)
        self.main_commits('b.txt', 'main wrote it too')
        self.main_commits('.st/evidence-skip-policy.json', json.dumps(POLICY, indent=1))
        ran = Path(self.tmp.name) / 'ran'
        with mock.patch.object(st_test, 'target_commit', return_value=head):  # past the early merge check, as when main moves during the wait
            code, out, err = self.run_st_test('--check', 'demo', command=['sh', '-c', f'touch {ran}'])
        self.assertIn('failure: protected files differ from the branch point, so fractal-test merges origin/main into the branch before it signs, '
                      'and it does not merge cleanly (b.txt)', str(code))
        self.assertEqual(git(self.work, 'rev-parse', 'HEAD'), head)
        self.assertEqual(git(self.work, 'status', '--porcelain', '--untracked-files=no'), '')
        self.assertFalse((self.work / '.git/MERGE_HEAD').exists())
        self.assertFalse(ran.exists())

    def test_a_checkout_changed_during_the_wait_is_not_merged(self):
        head = self.branch_behind(0)
        self.main_commits('.st/evidence-skip-policy.json', json.dumps(POLICY, indent=1))
        real_acquire = st_test.acquire_tree
        def edits_while_waiting(*args, **kwargs):
            (self.work / 'a.txt').write_text('edited during the wait\n')
            return real_acquire(*args, **kwargs)
        with mock.patch.object(st_test, 'acquire_tree', side_effect=edits_while_waiting):
            code, out, err = self.run_st_test('--check', 'demo')
        self.assertIn('the checkout now has uncommitted changes to tracked files', str(code))
        self.assertEqual(git(self.work, 'rev-parse', 'HEAD'), head)

    def test_a_remote_branch_with_commits_the_branch_lacks_is_not_pushed(self):
        self.branch_behind(25)
        git(self.work, 'push', '-q', 'origin', 'feature')
        git(self.work, 'commit', '-q', '--allow-empty', '-m', 'only on the remote')
        theirs = git(self.work, 'rev-parse', 'HEAD')
        git(self.work, 'push', '-q', 'origin', 'feature')
        git(self.work, 'reset', '-q', '--hard', 'HEAD^')
        code, out, err = self.run_st_test('--check', 'demo', '--push', 'origin')
        self.assertIn(f'origin/feature has commits this branch lacks ({theirs[:12]})', str(code))
        self.assertEqual(git(self.work, 'ls-remote', 'origin', 'refs/heads/feature').split()[0], theirs)  # never forced

    def test_a_detached_head_is_merged_and_signed_but_not_pushed(self):
        self.branch_behind(25)
        git(self.work, 'checkout', '-q', '--detach')
        code, out, err = self.run_st_test('--check', 'demo', '--push', 'origin')
        self.assertEqual(code, 0, out + err)
        self.assertIn('is not pushed (a detached HEAD); push it yourself', out)
        self.assertEqual(git(self.work, 'ls-remote', 'origin', 'refs/heads/feature'), '')

    def test_a_branch_runs_the_self_contained_base_copy_once(self):
        stub = ('import json, os, sys\n'
                'print(json.dumps({"copy": "base", "argv": sys.argv[1:], "guard": os.environ.get("ST_TEST_REEXEC")}))\n')
        self.main_commits('scripts/st-test', stub)
        base = git(self.work, 'rev-parse', 'origin/main')
        run = lambda **extra_env: subprocess.run([sys.executable, str(ROOT / 'scripts/fractal-test'), '--list', '--base', 'origin/main'], cwd=self.work,
                                                capture_output=True, text=True, timeout=60, env=dict(GIT_ENV, HOME=str(self.home), **extra_env))
        done = run()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(json.loads(done.stdout), {'copy': 'base', 'argv': ['--list', '--base', 'origin/main'], 'guard': base})
        self.assertIn("running the base's st-test (origin/main at", done.stderr)
        done = run(ST_TEST_REEXEC=base)  # already the base's copy: it runs itself, never re-executes again
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertNotIn('"copy": "base"', done.stdout)
        self.assertIn('linux-gate:', done.stdout)  # this copy's own --list
        # The self-contained implementation runs with no adjacent shim and cleans up its copy.
        self.main_commits('scripts/st-test', (ROOT / 'scripts/st-test').read_text() + '# newer\n')
        scratch = Path(self.tmp.name) / 'tmp'
        scratch.mkdir()
        done = run(TMPDIR=str(scratch))
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn("running the base's st-test", done.stderr)
        self.assertIn('linux-gate:', done.stdout)
        self.assertEqual(list(scratch.iterdir()), [])

    def test_base_readers_copy_st_test_even_when_the_human_shim_exists(self):
        implementation = 'import json, sys\nprint(json.dumps({"copy": "implementation", "argv": sys.argv[1:]}))\n'
        self.main_commits('scripts/st-test', implementation)
        command = [sys.executable, str(ROOT / 'scripts/fractal-test'), '--list', '--base', 'origin/main']
        def run():
            return subprocess.run(command, cwd=self.work, capture_output=True, text=True, timeout=60,
                                  env=dict(GIT_ENV, HOME=str(self.home)))
        for shim in (None, 'raise RuntimeError("a copy-only reader must never select the shim")\n'):
            if shim is not None:
                self.main_commits('scripts/fractal-test', shim)
            done = run()
            self.assertEqual(done.returncode, 0, done.stderr)
            self.assertEqual(json.loads(done.stdout), {'copy': 'implementation', 'argv': ['--list', '--base', 'origin/main']})
            self.assertIn("running the base's st-test", done.stderr)
        self.main_commits('scripts/st-test', (ROOT / 'scripts/st-test').read_text())
        done = run()
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn('linux-gate:', done.stdout)
        self.assertNotIn("running the base's", done.stderr)

    def test_old_copy_only_readers_can_execute_the_implementation_without_its_neighbor(self):
        copied = Path(self.tmp.name) / 'copied-st-test'
        copied.write_bytes((ROOT / 'scripts/st-test').read_bytes())
        done = subprocess.run([sys.executable, str(copied), '--list'], cwd=self.work,
                              capture_output=True, text=True, timeout=60,
                              env=dict(GIT_ENV, ST_TEST_REEXEC='copy-only-proof', HOME=str(self.home)))
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn('linux-gate:', done.stdout)

    def test_both_runner_paths_support_direct_and_python_invocations_with_identical_arguments_and_exit_status(self):
        for arguments, code in ((['--list'], 0), (['--does-not-exist'], 2)):
            with self.subTest(arguments=arguments):
                invocations = [
                    [str(ROOT / 'scripts/fractal-test')],
                    [sys.executable, str(ROOT / 'scripts/fractal-test')],
                    [str(ROOT / 'scripts/st-test')],
                    [sys.executable, str(ROOT / 'scripts/st-test')],
                ]
                results = [
                    subprocess.run([*invocation, *arguments], cwd=self.work,
                                   capture_output=True, text=True, env=dict(GIT_ENV, ST_TEST_REEXEC='shim-proof'))
                    for invocation in invocations
                ]
                self.assertEqual([done.returncode for done in results], [code] * len(invocations))
                for done in results[1:]:
                    self.assertEqual(results[0].stdout, done.stdout)
                    self.assertEqual(results[0].stderr, done.stderr)

    def test_when_main_moved_only_unprotected_files_the_head_tree_is_signed_as_before(self):
        self.branch_from_a_base_with_the_gate()
        head_tree = git(self.work, 'rev-parse', 'HEAD^{tree}')
        self.main_commits('elsewhere.txt', 'main moved')
        code, out, err = self.run_st_test('--check', 'demo')
        self.assertEqual(code, 0, out + err)
        self.assertNotIn('CI will judge the merge', out)
        statement, = self.statements()
        self.assertIn(head_tree, json.dumps(statement))

    def test_a_branch_that_cannot_be_merged_with_main_is_told_to_merge_it_first(self):
        self.branch_from_a_base_with_the_gate()
        (self.work / '.st/evidence-skip-policy.json').write_text(json.dumps(POLICY, indent=3))
        git(self.work, 'add', '.')
        git(self.work, 'commit', '-q', '-m', 'branch edits the policy too')
        self.main_commits('.st/evidence-skip-policy.json', json.dumps(POLICY, indent=1))
        code, out, err = self.run_st_test('--check', 'demo')
        self.assertRegex(str(code), r'does not merge cleanly: merge origin/main into the branch first')
        self.assertEqual(self.statements(), [])

    def test_a_base_without_the_shared_rule_signs_the_head_as_before(self):
        self.commit('b.txt', 'two')  # the base of this fixture has no gate script at all
        self.main_commits('.st/evidence-skip-policy.json', json.dumps(POLICY, indent=1))
        code, out, err = self.run_st_test('--check', 'demo')
        self.assertEqual(code, 0, out + err)
        self.assertNotIn('CI will judge the merge', out)

    def test_a_pool_tree_that_is_not_a_worktree_of_this_repository_is_replaced(self):
        self.commit('b.txt', 'two')
        self.assertEqual(self.run_st_test('--check', 'demo')[0], 0)
        tree = self.pool() / 'tree-0'
        shutil.rmtree(tree)
        tree.mkdir()
        (tree / 'junk').write_text('not a worktree')
        self.assertEqual(self.run_st_test('--check', 'demo')[0], 0)
        self.assertFalse((tree / 'junk').exists())
        self.assertEqual(git(tree, 'rev-parse', 'HEAD'), git(self.work, 'rev-parse', 'HEAD'))

    def test_with_the_pool_off_a_run_uses_a_fresh_worktree_that_is_removed_after(self):
        self.commit('b.txt', 'two')
        seen = Path(self.tmp.name) / 'seen'
        command = ['sh', '-c', f'pwd -P >> {seen}']
        self.assertEqual(self.run_st_test('--check', 'demo', command=command, extra_env={'ST_TEST_TREES': 'off'})[0], 0)
        path = Path(seen.read_text().strip())
        self.assertTrue(path.parent.name.startswith('st-test-'))
        self.assertFalse(path.exists())
        self.assertFalse((self.home / '.cache/st-test').exists())

    def test_a_check_already_signed_for_this_tree_is_not_run_again(self):
        self.commit('b.txt', 'two')
        self.assertEqual(self.run_st_test('--check', 'demo')[0], 0)
        code, out, err = self.run_st_test('--check', 'demo')
        self.assertEqual(code, 0, err)
        self.assertRegex(out, r'demo +already signed +0s +covered by wrapper')
        self.assertEqual(len(self.statements()), 1)  # no second note: it did not run
        self.commit('c.txt', 'three')  # another tree: signed anew
        self.assertEqual(self.run_st_test('--check', 'demo')[0], 0)
        self.assertEqual(len(self.statements()), 2)

    def test_rerun_runs_a_check_that_is_already_signed(self):
        self.commit('b.txt', 'two')
        self.assertEqual(self.run_st_test('--check', 'demo')[0], 0)
        code, out, _ = self.run_st_test('--check', 'demo', '--rerun')
        self.assertEqual(code, 0)
        self.assertRegex(out, r'demo +passed +\d+s')  # it ran: the same note again, or a new one
        self.assertNotIn('already signed', out)

    def test_a_failed_signature_is_not_already_signed(self):
        self.commit('b.txt', 'two')
        failing = ['sh', '-c', 'exit 3']
        self.assertEqual(self.run_st_test('--check', 'demo', command=failing)[0], 1)
        code, out, _ = self.run_st_test('--check', 'demo', command=failing)
        self.assertEqual(code, 1)
        self.assertIn('FAILED (3)', out)  # it ran again; it was not taken for signed
        self.assertNotIn('already signed', out)

    def test_with_push_an_already_signed_note_is_pushed_as_it_is_without_running_the_check(self):
        self.commit('b.txt', 'two')
        origin = Path(self.tmp.name) / 'origin.git'

        def pushed(kind):
            return subprocess.run(['git', '-C', str(origin), 'for-each-ref', '--format=%(refname)', f'refs/{kind}/evidence/'],
                                  capture_output=True, text=True).stdout.split()
        self.assertEqual(self.run_st_test('--check', 'demo')[0], 0)  # signed here, never pushed
        self.assertEqual(pushed('tags'), [])
        code, out, err = self.run_st_test('--check', 'demo', '--push', 'origin')
        self.assertEqual(code, 0, err)
        self.assertRegex(out, r'demo +already signed')
        self.assertEqual(len(self.statements()), 1)  # not run again
        self.assertEqual(len(pushed('tags')), 1)
        self.assertEqual(len(pushed('notes')), 1)
        code, out, err = self.run_st_test('--check', 'demo', '--push', 'origin')  # idempotent
        self.assertEqual(code, 0, err)
        self.assertEqual(len(pushed('tags')), 1)

    def test_https_publication_keeps_transport_config_and_only_pushes_the_heads_records(self):
        self.commit('b.txt', 'old head')
        self.assertEqual(self.run_st_test('--check', 'demo')[0], 0)
        old_tree = git(self.work, 'rev-parse', 'HEAD^{tree}')
        old_record = git(self.work, 'for-each-ref', '--format=%(objectname)', f'refs/tags/evidence/{old_tree}/')
        git(self.work, 'update-ref', '--stdin', stdin=''.join(
            f'update refs/tags/evidence/{old_tree}/cached-{n} {old_record}\n' for n in range(2000)).encode())
        self.commit('c.txt', 'published head')
        tree = git(self.work, 'rev-parse', 'HEAD^{tree}')
        origin = Path(self.tmp.name) / 'origin.git'
        url = 'https://evidence.invalid/org/repo.git'
        git(self.work, 'remote', 'set-url', 'origin', url)
        env = {
            'GIT_CONFIG_COUNT': '3',
            'GIT_CONFIG_KEY_0': f'url.{origin.as_uri()}.insteadOf', 'GIT_CONFIG_VALUE_0': url,
            'GIT_CONFIG_KEY_1': 'protocol.file.allow', 'GIT_CONFIG_VALUE_1': 'always',
            'GIT_CONFIG_KEY_2': 'gc.auto', 'GIT_CONFIG_VALUE_2': '0',
            'EVIDENCE_PUSH_TOKEN': 'test-https-token',
        }
        for already_signed in (False, True):
            code, out, err = self.run_st_test('--check', 'demo', '--push', 'origin', extra_env=env)
            self.assertEqual(code, 0, out + err)
            if already_signed:
                self.assertIn('already signed', out)
            else:
                self.assertIn('fractal-test: evidence-wrap argv:', err)
                self.assertIn('--push origin', err)
                self.assertIn("-- sh -c 'echo ran'", err)
                self.assertNotIn('test-https-token', err)
            refs = git(origin, 'for-each-ref', '--format=%(refname)', 'refs/tags/evidence/', 'refs/notes/evidence/').splitlines()
            self.assertEqual(len(refs), 2, refs)
            self.assertTrue(all(f'/{tree}/' in ref for ref in refs), refs)

    def test_an_already_signed_note_that_cannot_be_pushed_is_a_failure(self):
        self.commit('b.txt', 'two')
        self.assertEqual(self.run_st_test('--check', 'demo')[0], 0)
