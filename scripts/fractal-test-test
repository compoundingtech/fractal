        self.assertRegex(str(code), r'host stayed above its load limit: load1 .* > 0.0001 \(host limit\)')
        self.assertIn('waiting: load1', err)
        self.assertEqual(self.statements(), [])  # nothing ran, nothing signed
        self.assertFalse((self.home / '.cache/st-test').exists())  # no pool tree was taken

