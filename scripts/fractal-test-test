        self.assertEqual(code, 0, out + err)

    def test_the_members_command_is_the_one_ci_runs_before_the_lanes(self):
        directory = Path(self.tmp.name) / 'pin'
        directory.mkdir()
        rev = 'a' * 40
        (directory / 'flake.lock').write_text(json.dumps({'nodes': {'effect-utils': {'locked': {'rev': rev}}}}))
        command = st_test.members_command(directory)
        step = (ROOT / '.github/workflows/workspace-ci.ts').read_text().split('export const megarepoApplyStep', 1)[1].split('} as const', 1)[0]
        ci = step.replace('$(jq -r \'.nodes["effect-utils"].locked.rev\' flake.lock)', rev)
        self.assertIn(f'nix run "{command[2]}" {" ".join(command[3:])}', ci)
        (directory / 'flake.lock').write_text(json.dumps({'nodes': {'effect-utils': {'locked': {'rev': 'main; rm -rf /'}}}}))
        with self.assertRaises(ValueError):
            st_test.members_command(directory)

    def test_a_time_limit_is_a_failure_not_a_hang(self):
        self.commit('b.txt', 'two')
        code, out, err = self.run_st_test('--check', 'demo', '--time-limit', '1', command=['sleep', '30'])
        self.assertEqual(code, 1)
        self.assertIn('timed out', out)

    def test_queued_seconds_is_the_union_of_the_waits_and_an_open_wait_runs_to_now(self):
        log = Path(self.tmp.name) / 'queue'
        self.assertEqual(st_test.queued_seconds(log, now=100), 0.0)  # no file yet
        log.write_text('wait 10 tests\nwait 15 clippy\nslot 20 tests\nslot 30 clippy\njunk\nslot 40 nobody\nwait x tests\nwait 50 tests\n')
        # tests 10-20 and clippy 15-30 overlap and count once (20 s); tests waits again from 50 and still does at 60 (10 s).
        self.assertEqual(st_test.queued_seconds(log, now=60), 30.0)

    def test_a_check_s_waits_for_a_build_slot_do_not_count_against_its_time_limit(self):
        self.commit('b.txt', 'two')
        wait = 'echo "wait $(date +%s) tests" >> "$CI_LOCAL_QUEUE_LOG"; sleep 3; echo "slot $(date +%s) tests" >> "$CI_LOCAL_QUEUE_LOG"'
        code, out, err = self.run_st_test('--check', 'demo', '--time-limit', '2', command=['sh', '-c', wait])
        self.assertEqual(code, 0, out + err)
        self.assertRegex(out, r'waited [2-4]s for build slots')
        # The same, streamed as scripts/ci-local's output is.
        code, out, err = self.run_st_test('--check', 'demo', '--time-limit', '2', '--rerun', command=['sh', '-c', wait, 'scripts/ci-local'])
        self.assertEqual(code, 0, out + err)
        # Three seconds spent running, not waiting, are over the limit.
        code, out, err = self.run_st_test('--check', 'demo', '--time-limit', '2', '--rerun', command=['sh', '-c', 'sleep 3'])
        self.assertEqual(code, 1, out + err)
        self.assertRegex(out, r'demo +timed out')

    def test_a_ci_local_check_s_time_limit_counts_from_when_ci_local_starts(self):
        self.commit('b.txt', 'two')
        # 100 s of waiting (its dev shell's admission, say) before ci-local starts, then almost nothing: within a 50 s limit. The wait is
        # simulated (the Limit hears the start line as if it came 100 s after the check began), so no wall clock decides the outcome. And
        # this process takes 2 s to handle that line, as a loaded host may: the wrapper, which reads pre_start_s once the check ended, must
        # still find the wait (2026-10-28: with a plain file it read before this process had written it, and the note said 'none').
        hear = st_test.Limit.output

        def late(limit, chunk):
            if limit.begins_at and limit.begins_at in limit.tail + chunk:
                time.sleep(2)
                limit.started -= 100
            hear(limit, chunk)

        with mock.patch.object(st_test.Limit, 'output', late):
            code, out, err = self.run_st_test('--check', 'demo', '--time-limit', '50',
                                              command=['sh', '-c', 'echo "ci-local: stage logs in /x"', 'scripts/ci-local'])
        self.assertEqual(code, 0, out + err)
        waited = re.search(r'waited (\d+)s before ci-local started \(admission, dev shell\) \(not counted against --time-limit\)', out)
        self.assertIsNotNone(waited, out)
        self.assertGreaterEqual(int(waited.group(1)), 100)
        statement, = self.statements()
        self.assertEqual(statement['predicate']['observed']['inputs']['pre_start_s'], waited.group(1))  # the note records the same wait
        # Once ci-local has started the limit holds as before: 3 s of running is over it.
        code, out, err = self.run_st_test('--check', 'demo', '--time-limit', '2', '--rerun',
                                          command=['sh', '-c', 'echo "ci-local: stage logs in /x"; sleep 3', 'scripts/ci-local'])
        self.assertEqual(code, 1, out + err)
        self.assertRegex(out, r'demo +timed out')

    def test_a_ci_local_check_silent_before_it_starts_is_stopped(self):
        self.commit('b.txt', 'two')
        started = time.monotonic()
        with mock.patch.object(st_test, 'SILENCE_LIMIT', 1):
            code, out, err = self.run_st_test('--check', 'demo', '--time-limit', '60', command=['sh', '-c', 'sleep 30', 'scripts/ci-local'])
        self.assertEqual(code, 1, out + err)
        self.assertRegex(out, r'demo +timed out .*stopped after 1s without output before ci-local started')
        self.assertLess(time.monotonic() - started, 25)

    def test_a_ci_local_check_that_waits_past_its_queue_limit_before_it_starts_is_stopped_even_while_it_prints(self):
        self.commit('b.txt', 'two')
        chatty = 'while true; do echo still waiting for admission; sleep 0.2; done'  # never silent, never starts
        started = time.monotonic()
        with mock.patch.object(st_test, 'SILENCE_LIMIT', 600):
            code, out, err = self.run_st_test('--check', 'demo', '--time-limit', '60', '--queue-limit', '1',
                                              command=['sh', '-c', chatty, 'scripts/ci-local'])
        self.assertEqual(code, 1, out + err)
        self.assertRegex(out, r'demo +timed out .*stopped after waiting 1s \(--queue-limit\) before ci-local started')
        self.assertNotIn('without output', out)
        self.assertLess(time.monotonic() - started, 25)

    def test_ci_local_still_prints_the_line_its_time_limit_starts_at_after_its_load_gate(self):
        source = (ROOT / 'scripts/ci-local').read_text()
        marker = 'echo "' + st_test.CI_LOCAL_STARTED.decode()
        self.assertIn(marker, source)
        self.assertLess(source.index('waiting: load1'), source.index(marker))  # ci-local's own load wait comes before it: waiting, not running

    def test_the_waits_for_a_build_slot_have_a_limit_of_their_own(self):
