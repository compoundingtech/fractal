#!/usr/bin/env python3
"""The `signed-tree` shadow job: would this pull request be rejected for lacking a trusted signed note?

Runs from the BASE branch's checkout (a `pull_request_target` workflow always uses the workflow file of the base branch, so the
pull request cannot edit or delete it). The pull request's code is never checked out or executed: its head commit is fetched as
git objects only and read as data (`git rev-parse`, `git ls-tree`, notes). The verifier (`scripts/evidence-verify`), the key list,
the skip policy and the lane file all come from the base checkout this script runs in.

It asks `evidence-verify --require-all` about the head tree and prints ONE decision line, also written to the step summary:

  signed-tree v1 decision=ok|would-reject|reject|skipped|error mode=shadow pr=N head=SHA tree=SHA base=SHA reason=... lanes=name:state,...

`decision` mirrors the verifier (`reject` only if a check whose policy says `require: reject` is unsatisfied) but this job is SHADOW
ONLY: it exits 0 whatever it finds, is not a required check, and reads no secret (read-only token, no credentials in the checkout).
It is a no-op (no notes fetched) when no check in the base policy says `require`, and for forks and drafts.

Environment: REPOSITORY, PR_NUMBER, PR_HEAD_SHA, PR_HEAD_REPOSITORY, PR_DRAFT, optionally GITHUB_OUTPUT / GITHUB_STEP_SUMMARY.
"""
import json
import os
import re
import subprocess
import sys
import time

sys.dont_write_bytecode = True

VERIFIER = 'scripts/evidence-verify'
POLICY = '.st/evidence-skip-policy.json'
KEYS = '.st/evidence-keys'
LANES = '.st/required-lanes.json'
NOTES = 'refs/notes/evidence'  # records live under refs/notes/evidence/<tree>/: one prefix per tree
INPUT_NOTES = 'refs/notes/evidence-input'
TAGS = 'refs/tags/evidence'  # and, protected by a ruleset, under refs/tags/evidence/<tree>/ and refs/tags/evidence/input/<check>/<key>/
OID = re.compile(r'^(?:[0-9a-f]{40}|[0-9a-f]{64})$')
REPOSITORY = re.compile(r'^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$')
VERIFIER_TIMEOUT = int(os.environ.get('SIGNED_TREE_VERIFIER_TIMEOUT', '60'))


def run(*command, timeout=120):
    try:
        done = subprocess.run(command, capture_output=True, timeout=timeout)
        return done.returncode, done.stdout
    except (OSError, subprocess.TimeoutExpired):
        return 124, b''


def field(value):
    text = re.sub(r'[^A-Za-z0-9._:/@+=,-]', '_', str(value if value not in (None, '') else '-'))
    return text[:200]


def emit(context, decision, reason, tree='-', base='-', lanes=None, seconds=0.0):
    names = ','.join(f'{name}:{state}' for name, state in sorted((lanes or {}).items())) or '-'
    text = (f"signed-tree v1 decision={decision} mode=shadow pr={field(context.get('pr'))} head={field(context.get('head'))} "
            f"tree={field(tree)} base={field(base)} reason={field(reason)} lanes={field(names)} seconds={seconds:.1f}")
    print(text)
    for variable, body in (('GITHUB_STEP_SUMMARY', text + '\n'), ('GITHUB_OUTPUT', f'decision={decision}\n')):
        target = os.environ.get(variable)
        if target:
            with open(target, 'a') as handle:
                handle.write(body)
    return 0


def main():
    started = time.monotonic()
    env = os.environ
    context = {'pr': env.get('PR_NUMBER', ''), 'head': env.get('PR_HEAD_SHA', '')}
    elapsed = lambda: time.monotonic() - started
    try:
        repository = env.get('REPOSITORY', '')
        if not REPOSITORY.match(repository) or not OID.match(context['head']) or not context['pr'].isdigit():
            return emit(context, 'error', 'bad-context', seconds=elapsed())
        if env.get('PR_HEAD_REPOSITORY', '') != repository:
            return emit(context, 'skipped', 'not-a-same-repository-pull-request', seconds=elapsed())
        if env.get('PR_DRAFT', 'false') == 'true':
            return emit(context, 'skipped', 'draft', seconds=elapsed())
        code, base = run('git', 'rev-parse', '--verify', 'HEAD')
        base = base.decode().strip()
        if code != 0 or not OID.match(base):
            return emit(context, 'error', 'no-base-checkout', seconds=elapsed())
        # Everything that decides comes from this checkout (the base branch tip). Read the policy first: a no-op when nothing requires a note.
        code, policy = run('git', 'show', f'{base}:{POLICY}')
        try:
            checks = json.loads(policy)['checks'] if code == 0 else None
        except (ValueError, KeyError, TypeError):
            checks = None
        if not isinstance(checks, dict):
            return emit(context, 'error', 'no-readable-policy-at-base', base=base, seconds=elapsed())
        if not any(isinstance(entry, dict) and entry.get('require', 'off') != 'off' for entry in checks.values()):  # a malformed value goes to the verifier, which refuses it
            return emit(context, 'ok', 'nothing-requires-a-signed-note', base=base, seconds=elapsed())
        # The pull request head is fetched as DATA: objects only, nothing checked out, nothing run.
        code, _ = run('git', 'fetch', '--no-tags', '--depth=1', '-q', 'origin', f'refs/pull/{context["pr"]}/head')
        if code != 0:
            return emit(context, 'error', 'could-not-fetch-the-head', base=base, seconds=elapsed())
        code, fetched = run('git', 'rev-parse', '--verify', 'FETCH_HEAD^{commit}')
        if code != 0 or fetched.decode().strip() != context['head']:
            return emit(context, 'error', 'fetched-head-differs-from-the-event', base=base, seconds=elapsed())
        code, tree = run('git', 'rev-parse', '--verify', 'FETCH_HEAD^{tree}')
        tree = tree.decode().strip()
        if code != 0 or not OID.match(tree):
            return emit(context, 'error', 'no-head-tree', base=base, seconds=elapsed())
        # Only this tree's records (one prefix), plus the input-keyed records of each required check that declares inputs: never the namespace.
        code, _ = run('git', 'fetch', '--no-tags', '--depth=1', '--no-filter', '-q', 'origin', f'+{TAGS}/{tree}/*:{TAGS}/{tree}/*',
                      f'+{NOTES}/{tree}/*:{NOTES}/{tree}/*')
        notes = 'ok' if code == 0 else 'failed'
        for check, entry in sorted(checks.items()):
            if isinstance(entry, dict) and entry.get('require', 'off') != 'off' and entry.get('inputs') is not None and re.fullmatch(r'[A-Za-z0-9._-]+', check):
                code, out = run(sys.executable, VERIFIER, '--repo', '.', '--revision', context['head'], '--check', check, '--project', '--policy-from', base,
                                '--repository', repository, timeout=VERIFIER_TIMEOUT)
                try:
                    key = json.loads(out).get('source_inputs') if code == 0 else None
                except ValueError:
                    key = None
                if isinstance(key, str) and OID.match(key):
                    prefix, tags = f'{INPUT_NOTES}/{check}/{key}', f'{TAGS}/input/{check}/{key}'
                    if run('git', 'fetch', '--no-tags', '--depth=1', '--no-filter', '-q', 'origin', f'+{tags}/*:{tags}/*', f'+{prefix}/*:{prefix}/*')[0] != 0:
                        notes = 'failed'
        command = [sys.executable, VERIFIER, '--repo', '.', '--tree', tree, '--require-all', '--keys-from', base,
                   '--policy-from', base, '--repository', repository]
        if run('git', 'cat-file', '-e', f'{base}:{LANES}')[0] == 0:
            command += ['--lanes-from', base]
        code, out = run(*command, timeout=VERIFIER_TIMEOUT)
        try:
            result = json.loads(out)
        except ValueError:
            return emit(context, 'error', f'verifier-exit-{code}-without-json', tree=tree, base=base, seconds=elapsed())
        if result.get('decision') == 'error':
            return emit(context, 'error', f'verifier:{result.get("reason", "error")}', tree=tree, base=base, seconds=elapsed())
        lanes = {name: ('ok' if lane.get('satisfied') else lane.get('reason', 'unsatisfied')) for name, lane in result.get('lanes', {}).items()}
        reason = 'satisfied' if result.get('satisfied') else 'unsatisfied'
        if notes != 'ok':
            reason += ',notes-fetch-failed'
        return emit(context, result.get('decision', 'error'), reason, tree=tree, base=base, lanes=lanes, seconds=elapsed())
    except Exception as error:  # a shadow job never fails
        return emit(context, 'error', f'{type(error).__name__}', seconds=elapsed())


if __name__ == '__main__':
    sys.exit(main())
