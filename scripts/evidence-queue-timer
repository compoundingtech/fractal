#!/usr/bin/env bash
# One tick of the shadow merge-queue signer, as main has it (scripts/evidence-queue-{observe,sign}.service from their timers).
# The signer, and the pre-sign worker whose host rules it uses, are read from origin/main of the clone it owns, never a checkout's
# copy; st-test, which it runs, is read the same way.
#   evidence-queue-timer observe|sign [--dry-run]
set -euo pipefail
state=${EVIDENCE_QUEUE_STATE:-$HOME/.local/state/evidence-queue-signer}
repository=${EVIDENCE_QUEUE_REPOSITORY:-compoundingtech/fractal}
command=${1:?observe or sign}
case "$command" in observe|sign) ;; *) echo "evidence-queue-timer: observe or sign, not $command" >&2; exit 2 ;; esac
# A clone per command: observe fetches and merges while a sign run has its checkout under test.
repo=$state/repo-$command
mkdir -p "$state"
if [ ! -d "$repo/.git" ]; then
  git clone -q --no-tags "${EVIDENCE_PRESIGN_REMOTE:-https://github.com/$repository.git}" "$repo"
  git -C "$repo" config gc.auto 0
fi
git -C "$repo" -c core.hooksPath=/dev/null fetch -q --no-tags origin +refs/heads/main:refs/remotes/origin/main
tools=$(mktemp -d)
trap 'rm -rf "$tools"' EXIT
for name in evidence-queue-signer evidence-presign-worker; do
  git -C "$repo" show "origin/main:scripts/$name" > "$tools/$name"
done
python3 -I "$tools/evidence-queue-signer" "$command" --repo "$repo" --repository "$repository" "${@:2}"
