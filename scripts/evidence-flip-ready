#!/usr/bin/env python3
"""Is a check ready to have its evidence skip turned on? The flip trigger, read from the gate's own decision lines.

  scripts/evidence-flip-ready [--repo OWNER/NAME] [--cache DIR] [--propose [--dry-run]]

For every check in `.st/evidence-skip-policy.json` at origin/main it reads the `evidence-decision v1` line of each
`evidence-gate-<check>` job of the `Workspace CI` (fleet.yml) pull_request runs created in the last 24 hours, and says
whether the flip trigger holds (docs/st3/gate-evidence.md, "When a check is ready to flip"):
  - 24 h of fresh published log: no line in the window says log=stale, absent, unsigned or `-` (the base did not pin
    .st/evidence-log-key yet), and the first line with a log value after the last `-` is at least 24 h old;
  - at least 30 lines with outcome=satisfied and log=ok;
  - no line with log=missing;
  - no unexplained log=unlogged_pass: one is explained when the record was observed at most 240 s before the run was
    created (log latency: two 2-minute pulls), or after it;
  - no hidden red: no satisfied line beside the check's own real job (the job named exactly the check, same attempt)
    that concluded `failure`. A real job the gate skipped is evidence neither way. For the aggregate `linux-gate` the red
    is hidden only when a member the skip would skip failed or was cancelled; a red from a member that always runs
    (upgrade-impact) would show under enforce too, and is reported as `visible_red`, which does not block.
Prints JSON; exit 0, or 2 when GitHub could not be read. Read only, except `--propose`: for each ready check that is not
enforced and has no open pull request from `evidence-flip/<check>`, it makes the flip in a temporary worktree of
origin/main, pushes that branch and opens the pull request (`--dry-run`: prints the diff instead). Exit 1 when a
proposal could not be made. Finished job logs never change, so their decision lines are cached by job id.
"""
import argparse
import ast
import concurrent.futures
import datetime
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile
import time

sys.dont_write_bytecode = True

ROOT = Path(__file__).resolve().parent.parent
POLICY = '.st/evidence-skip-policy.json'
DOC = 'docs/st3/gate-evidence.md'
DOC_SECTION = '### Which checks skip today'
# The test lists that name the enforced checks, written out in each test so a flip is a deliberate change to them.
TEST_LISTS = (('scripts/ci-evidence-gate-test', 'enforced'), ('scripts/evidence-verify-test', 'ENFORCED'))
WINDOW_S = 24 * 3600
LOOKBACK_S = 2 * 3600  # also read a little before the window, to see whether the log was already live when it began
MIN_SATISFIED_LOG_OK = 30
LATENCY_S = 240  # two pulls of the log timer (every 2 minutes)
NOT_FRESH = ('stale', 'absent', 'unsigned', '-')  # '-': the base did not pin the log key, so the window has not started
# The members of the aggregate `linux-gate` that a skip decision skips at job level: the jobs whose `if` reads
# needs.evidence-gate-linux-gate.outputs.skip (generated from .github/workflows/fleet.yml.genie.ts; the test checks this
# list against fleet.yml). Every other member, upgrade-impact first, always runs, so its red is never hidden by a skip.
SKIPPED_MEMBERS = {'linux-gate': ('linux-test-build', 'linux-tests', 'linux-tests-shard-2', 'linux-tests-shard-3',
                                  'linux-tests-shard-4', 'linux-clippy', 'linux-fleet-compat')}
ANSI = re.compile(r'\x1b\[[0-9;]*[A-Za-z]')
# The gate prints its line on its own, after the runner's timestamp; the step's shell text (echoed before it) has the
# line too, as a template with `$CHECK`, behind other text.
DECISION = re.compile(r'^(?:\S+Z )?evidence-decision v1 (check=\S+ .*)$')


class Unreadable(Exception):
    """GitHub could not be read: no answer is better than one built on missing lines."""


def default_runner(command, **kwargs):
    return subprocess.run(command, capture_output=True, timeout=300, check=False, **kwargs)


def parse_time(text):
    try:
        moment = datetime.datetime.fromisoformat(str(text).replace('Z', '+00:00'))
    except ValueError:
        return None
    return moment if moment.tzinfo else None


def iso(moment):
    return moment.strftime('%Y-%m-%dT%H:%M:%SZ') if moment else None


class GitHub:
    """`gh api`, read only, three tries per call; decision lines cached by job id."""

    def __init__(self, repo, runner, cache):
        self.repo, self.runner, self.cache = repo, runner, Path(cache)

    def gh(self, *args):
        error = ''
        for attempt in range(3):
            done = self.runner(['gh', *args])
            if done.returncode == 0:
                return done.stdout
            error = (done.stderr or b'').decode(errors='replace').strip()[-200:]
            if attempt < 2:
                time.sleep(2 ** attempt)
        raise Unreadable(f'gh {" ".join(args[:2])}: {error}')

    def items(self, path, key):
        pages = json.loads(self.gh('api', '--paginate', '--slurp', path))
        return [item for page in pages for item in page.get(key, [])]

    def decision_lines(self, job_id):
        """Every real decision line of one finished job (normally one)."""
        cached = self.cache / f'{int(job_id)}.lines'
        if cached.exists():
            return [text for text in cached.read_text().split('\n') if text]
        log = ANSI.sub('', self.gh('api', '--allow-escape-sequences', f'repos/{self.repo}/actions/jobs/{job_id}/logs')
                       .decode(errors='replace'))
        lines = [found.group(1) for found in map(DECISION.match, log.splitlines()) if found and '$CHECK' not in found.group(1)]
        self.cache.mkdir(parents=True, exist_ok=True)
        partial = cached.with_suffix(f'.{os.getpid()}.tmp')
        partial.write_text(''.join(f'{text}\n' for text in lines))
        partial.replace(cached)
        return lines


def fields_of(text):
    return dict(part.split('=', 1) for part in text.split(' ') if '=' in part)


def collect(github, checks, since, until):
    """One row per gate job that printed a line for a known check: the run, its creation time, the line's fields and
    the conclusion of the check's own job in the same attempt."""
    runs = github.items(f'repos/{github.repo}/actions/workflows/fleet.yml/runs?event=pull_request&per_page=100'
                        f'&created={iso(since)}..{iso(until)}', 'workflow_runs')
    finished = [run for run in runs if run.get('status') == 'completed']  # a run still going is counted next time
    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:
        job_lists = list(pool.map(
            lambda run: github.items(f'repos/{github.repo}/actions/runs/{run["id"]}/jobs?per_page=100&filter=all', 'jobs'), finished))
    wanted = []
    for run, jobs in zip(finished, job_lists):
        real = {(job.get('name'), job.get('run_attempt')): job.get('conclusion') for job in jobs}
        for job in jobs:
            check = (job.get('name') or '').removeprefix('evidence-gate-')
            if check == job.get('name') or check not in checks or job.get('status') != 'completed' or job.get('conclusion') == 'skipped':
                continue
            attempt = job.get('run_attempt')
            wanted.append((run, job, check, real.get((check, attempt)),
                           [name for name in SKIPPED_MEMBERS.get(check, ()) if real.get((name, attempt)) in ('failure', 'cancelled')]))
    with concurrent.futures.ThreadPoolExecutor(max_workers=6) as pool:
        logs = list(pool.map(lambda item: github.decision_lines(item[1]['id']), wanted))
    rows = []
    for (run, job, check, conclusion, members_red), lines in zip(wanted, logs):
        for text in lines:
            fields = fields_of(text)
            if fields.get('check') == check:
                rows.append({'check': check, 'run': run['id'], 'created_at': parse_time(run.get('created_at')),
                             'fields': fields, 'real': conclusion, 'members_red': members_red})
    return rows


def evaluate(rows, enforce, now):
    """The trigger for one check, from its rows (window and lookback)."""
    start = now - datetime.timedelta(seconds=WINDOW_S)
    rows = sorted((row for row in rows if row['created_at']), key=lambda row: row['created_at'])
    window = [row for row in rows if start <= row['created_at'] <= now]
    log = [row['fields'].get('log', '-') for row in window]  # a gate older than the log view prints no log field
    unexplained = 0
    for row, value in zip(window, log):
        if value == 'unlogged_pass':
            observed = parse_time(row['fields'].get('observed_at'))
            if observed is None or (row['created_at'] - observed).total_seconds() > LATENCY_S:
                unexplained += 1
    red = [row for row in window if row['fields'].get('outcome') == 'satisfied' and row['real'] == 'failure']
    # A single job's failure is hidden by its skip; an aggregate's only when a member the skip would skip went red.
    hidden = sorted({row['run'] for row in red if row['check'] not in SKIPPED_MEMBERS or row['members_red']})
    visible = sorted({row['run'] for row in red} - set(hidden))
    # The log window began with the first line that has a log value after the last line without one.
    unset = [i for i, row in enumerate(rows) if row['fields'].get('log', '-') == '-']
    began = rows[unset[-1] + 1:] if unset else rows
    window_start = began[0]['created_at'] if began else None
    result = {
        'enforce': enforce, 'lines': len(window),
        'satisfied_log_ok': sum(1 for row, value in zip(window, log) if value == 'ok' and row['fields'].get('outcome') == 'satisfied'),
        'log_missing': log.count('missing'), 'unlogged_pass_unexplained': unexplained, 'hidden_red': hidden,
        'visible_red': visible, 'log_window_start': iso(window_start),
    }
    why = [f'{log.count(value)} lines with log={value}' for value in NOT_FRESH if value in log]
    if window_start is None:
        why.append('no line with a log value')
    elif window_start > start:
        why.append(f'log window started {iso(window_start)}, less than 24 h ago')
    if result['satisfied_log_ok'] < MIN_SATISFIED_LOG_OK:
        why.append(f'{result["satisfied_log_ok"]} satisfied lines with log=ok, fewer than {MIN_SATISFIED_LOG_OK}')
    if result['log_missing']:
        why.append(f'{result["log_missing"]} lines with log=missing')
    if unexplained:
        why.append(f'{unexplained} unexplained log=unlogged_pass')
    if hidden:
        why.append(f'{len(hidden)} runs with a hidden red')
    result.update(ready=not why, why_not=why)
    return result


def clippy_base_pinned(entry):
    """linux-gate's clippy stage ratchets against a base: a host or agent note must say which one it measured against."""
    levels = ((entry.get('kinds') or {}).get('wrapper') or {}).get('by_level') or {}
    missing = [level for level in ('host', 'agent')
               if 'clippy_base_sha' not in ((levels.get(level) or {}).get('required_inputs') or ())]
    return [f'the policy does not require clippy_base_sha of {" and ".join(missing)} linux-gate notes'] if missing else []


# Conditions a check's policy entry must meet before its flip is proposed, whatever the decision lines say.
PRECONDITIONS = {'linux-gate': clippy_base_pinned}


def preconditions(result, check, entry):
    """Fold a check's preconditions, read from the policy at origin/main, into its trigger result."""
    why = [*result['why_not'], *PRECONDITIONS.get(check, lambda entry: [])(entry)]
    return {**result, 'ready': not why, 'why_not': why}


def git(root, *args, runner=default_runner):
    done = runner(['git', '-C', str(root), *args])
    if done.returncode != 0:
        raise RuntimeError(f'git {args[0]}: {(done.stderr or b"").decode(errors="replace").strip()[-300:]}')
    return done.stdout.decode(errors='replace')


# --- The flip: exactly the change that turned typescript-client on, for one more check ---------------------------------

def flipped_entry(entry):
    """The check's policy entry with enforce true, then events and sample_one_in (only if absent), in the file's order."""
    out = {}
    for key, value in entry.items():
        out[key] = True if key == 'enforce' else value
        if key == 'enforce':
            out.setdefault('events', entry.get('events', ['pull_request']))
            out.setdefault('sample_one_in', entry.get('sample_one_in', 5))
    return out


def flip_policy(text, check):
    doc = json.loads(text)
    entry = doc['checks'].get(check)
    if not isinstance(entry, dict) or entry.get('enforce') is not False:
        raise ValueError(f'{POLICY}: {check} has no "enforce": false')
    expected = json.loads(text)
    expected['checks'][check] = flipped_entry(entry)
    if json.dumps(doc, indent=2) + '\n' == text:
        return json.dumps(expected, indent=2) + '\n', expected['checks'][check]
    # The file is not in json.dumps form: edit only the enforce line of this check, and add the two keys under it.
    block = re.search(r'^( *)"' + re.escape(check) + r'": \{\n', text, re.M)
    line = block and re.compile(r'^' + block.group(1) + r'  "enforce": false(,?)\n', re.M).search(text, block.end())
    if not line:
        raise ValueError(f'{POLICY}: cannot find the enforce line of {check}')
    pad = block.group(1) + '  '
    extra = ''.join(f'{pad}"{key}": {json.dumps(expected["checks"][check][key])},\n'
                    for key in ('events', 'sample_one_in') if key not in entry)
    new = text[:line.start()] + f'{pad}"enforce": true,\n' + extra + text[line.end():] if line.group(1) else None
    if new is None or json.loads(new) != expected:
        raise ValueError(f'{POLICY}: a textual edit of {check} would not give the expected policy')
    return new, expected['checks'][check]


def flip_doc(text, check, entry, today):
    """Move the check out of the shared `false` row of the table into its own `true` row."""
    head = text.find(DOC_SECTION + '\n')
    if head < 0:
        raise ValueError(f'{DOC}: no "{DOC_SECTION}" section')
    lines = text[head:].split('\n')
    table = [i for i, line in enumerate(lines[:20]) if line.startswith('|')]
    if len(table) < 3 or table != list(range(table[0], table[-1] + 1)):
        raise ValueError(f'{DOC}: no table under "{DOC_SECTION}"')
    name = f'`{check}`'
    row = None
    for i in table[2:]:
        cells = [cell.strip() for cell in lines[i].strip('|').split('|')]
        names = [part.strip() for part in cells[0].split(',')]
        if name in names and len(cells) == 5 and cells[1] == 'false':
            row, rest = i, [part for part in names if part != name]
    if row is None:
        raise ValueError(f'{DOC}: {check} is not in a row of the table with enforce false')
    cells = [cell.strip() for cell in lines[row].strip('|').split('|')]
    events = ', '.join(f'`{event}`' for event in entry['events'])
    new_row = f'| {name} | true | {events} | {entry["sample_one_in"]} | {today} |'
    after = max([i for i in table[2:] if lines[i].split('|')[2].strip() == 'true'] or [table[1]])
    lines[row] = '| ' + ' | '.join([', '.join(rest), *cells[1:]]) + ' |' if rest else None
    lines.insert(after + 1, new_row)
    return text[:head] + '\n'.join(line for line in lines if line is not None)


def flip_test_list(text, path, name, check):
    found = list(re.finditer(r'^( *)' + name + r' = (\(.*\))$', text, re.M))
    if len(found) != 1:
        raise ValueError(f'{path}: expected one `{name} = (...)` line, found {len(found)}')
    listed = ast.literal_eval(found[0].group(2))
    if not isinstance(listed, tuple) or check in listed:
        raise ValueError(f'{path}: {name} is not a tuple without {check}')
    return text[:found[0].start(2)] + repr(listed + (check,)) + text[found[0].end(2):]


def release_note(check):
    return json.dumps({
        'version': 1,
        'summary': f'Pull requests now skip the {check} check when a trusted signed note already covers the tree (one run in five still '
                   'runs it to compare); the merge queue keeps running it',
        'replay': {'status': 'none', 'detail': 'No graph, claim or storage change.'},
        'schema': {'status': 'none', 'detail': 'No schema change.'},
        'rules': {'status': 'none', 'detail': f'No checkpoint rule change. {check} is enforced in the skip policy for pull_request only.'},
        'compatibility': {'status': 'none', 'detail': f'Required check names and results are unchanged: a skipped {check} job still ends in success. Merge-group runs are unchanged.'},
        'downtime': {'status': 'none', 'detail': 'No restart.'},
        'manual': {'status': 'none', 'detail': 'No manual step.'},
        'recovery': {'status': 'none', 'detail': f'Set enforce back to false for {check} in {POLICY} (the policy is read from the base, so it takes effect for runs after the revert merges).'},
    }, indent=2) + '\n'


def flip(tree, check, today):
    """Make the flip in a checkout; raises ValueError naming what could not be edited mechanically."""
    note = tree / f'release-notes/evidence-enforce-{check}.json'
    if note.exists():
        raise ValueError(f'{note.relative_to(tree)} already exists')
    policy, entry = flip_policy((tree / POLICY).read_text(), check)
    edits = {POLICY: policy, DOC: flip_doc((tree / DOC).read_text(), check, entry, today)}
    for path, name in TEST_LISTS:
        edits[path] = flip_test_list((tree / path).read_text(), path, name, check)
    for path, text in edits.items():
        (tree / path).write_text(text)
    note.parent.mkdir(exist_ok=True)
    note.write_text(release_note(check))


def propose(report, root, github, runner, dry_run, today):
    failed = False
    for check, entry in report['checks'].items():
        if not entry['ready'] or entry['enforce']:
            continue
        branch = f'evidence-flip/{check}'
        try:
            open_prs = json.loads(github.gh('pr', 'list', '--repo', github.repo, '--head', branch, '--state', 'open', '--json', 'number'))
        except (Unreadable, ValueError) as error:
            print(f'{check}: not proposed: could not list pull requests: {error}', file=sys.stderr)
            failed = True
            continue
        if open_prs:
            print(f'{check}: #{open_prs[0]["number"]} is already open from {branch}', file=sys.stderr)
            continue
        with tempfile.TemporaryDirectory(prefix='evidence-flip-') as scratch:
            tree = Path(scratch) / 'tree'
            git(root, 'worktree', 'add', '-q', '--detach', str(tree), 'origin/main', runner=runner)
            try:
                try:
                    flip(tree, check, today)
                except (ValueError, KeyError, SyntaxError) as error:
                    print(f'{check}: not proposed, the flip cannot be made mechanically: {error}', file=sys.stderr)
                    failed = True
                    continue
                git(tree, 'add', '-A', runner=runner)
                if dry_run:
                    print(git(tree, 'diff', '--cached', runner=runner), end='')
                    continue
                trigger = json.dumps({'as_of': report['as_of'], 'window_s': report['window_s'], 'check': check, **entry}, indent=2)
                git(tree, 'commit', '-q', '-m', f'Enforce the {check} evidence skip on pull requests\n\n'
                    f'The flip trigger held (scripts/evidence-flip-ready, docs/st3/gate-evidence.md):\n\n{trigger}\n', runner=runner)
                git(tree, 'push', '-q', 'origin', f'HEAD:refs/heads/{branch}', runner=runner)
                body = (f'Turns on skipping for `{check}` on pull requests (`"enforce": true`, `"events": ["pull_request"]`, one run in '
                        f'{entry.get("sample_one_in", 5)} still sampled); the merge queue keeps running it.\n\nOpened by '
                        f'`scripts/evidence-flip-ready --propose` because the flip trigger held over the last 24 hours:\n\n```json\n{trigger}\n```\n')
                created = github.gh('pr', 'create', '--repo', github.repo, '--base', 'main', '--head', branch,
                                    '--title', f'Enforce the {check} evidence skip on pull requests', '--body', body)
                print(f'{check}: {created.decode(errors="replace").strip()}')
            except (RuntimeError, Unreadable) as error:
                print(f'{check}: not proposed: {error}', file=sys.stderr)
                failed = True
            finally:
                runner(['git', '-C', str(root), 'worktree', 'remove', '--force', str(tree)])
    return 1 if failed else 0


def main(argv, runner=default_runner, now=None, root=ROOT):
    parser = argparse.ArgumentParser(description=__doc__.split('\n\n')[0])
    parser.add_argument('--repo', default='compoundingtech/fractal')
    parser.add_argument('--cache', default=os.path.join(os.environ.get('XDG_CACHE_HOME') or os.path.expanduser('~/.cache'), 'evidence-flip-ready'))
    parser.add_argument('--propose', action='store_true', help='open a flip pull request for each ready check')
    parser.add_argument('--dry-run', action='store_true', help='with --propose: print the diff, change nothing')
    args = parser.parse_args(argv)
    if not re.fullmatch(r'[A-Za-z0-9._-]+/[A-Za-z0-9._-]+', args.repo) or (args.dry_run and not args.propose):
        parser.error('bad --repo, or --dry-run without --propose')
    now = now or datetime.datetime.now(datetime.timezone.utc).replace(microsecond=0)
    github = GitHub(args.repo, runner, args.cache)
    try:
        git(root, 'fetch', '-q', 'origin', 'main', runner=runner)
        policy = json.loads(git(root, 'show', f'origin/main:{POLICY}', runner=runner))['checks']
        since = now - datetime.timedelta(seconds=WINDOW_S + LOOKBACK_S)
        rows = collect(github, set(policy), since, now)
    except (Unreadable, RuntimeError, ValueError) as error:
        print(f'could not read GitHub or origin/main: {error}', file=sys.stderr)
        return 2
    report = {'as_of': iso(now), 'window_s': WINDOW_S, 'checks': {
        check: preconditions(evaluate([row for row in rows if row['check'] == check], entry.get('enforce') is True, now), check, entry)
        for check, entry in policy.items()}}
    print(json.dumps(report, indent=2))
    if args.propose:
        return propose(report, root, github, runner, args.dry_run, now.date().isoformat())
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
