#!/usr/bin/env python3
"""scripts/ci-local: the stages run in a home of their own, with no st, GitHub or SSH agent variable, in order, and the
exit status is the first failure's. cargo and the stage scripts are stubs that record what they saw; nothing compiles."""
import json
import os
from pathlib import Path
import re
import shutil
import signal
import subprocess
import time
import tempfile
import unittest

ROOT = Path(__file__).resolve().parent.parent
RECORD = '''#!/usr/bin/env bash
# a stand-in for the build admission shim, which exports CARGO_SHIM_DEPTH
python3 -I -c 'import json, os, sys; u = os.umask(0); print(json.dumps({"argv": sys.argv[1:], "env": dict(os.environ), "umask": u}))' "$@" >> "$CI_LOCAL_TEST_LOG"
'''


class CiLocal(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        root = Path(self.tmp.name)
        self.work = root / 'work'
        (self.work / 'scripts').mkdir(parents=True)
        shutil.copy(ROOT / 'scripts/ci-local', self.work / 'scripts/ci-local')
        self.log = root / 'log.jsonl'
        self.bin = root / 'bin'
        self.bin.mkdir()
        (self.bin / 'cargo').write_text(RECORD)
        (self.bin / 'cargo').chmod(0o755)
        (self.work / 'scripts/ci-install-built-hooks').write_text(RECORD)
        # nix and the compat-binary script stand in for CI's test-build preparation (they record that they ran).
        (self.bin / 'nix').write_text('#!/usr/bin/env bash\necho "nix $*" >> "$CI_LOCAL_TEST_LOG.prep"\n'
                                      'case "$1" in eval) printf x86_64-linux ;; build) echo /nix/store/components ;; esac\n')
        (self.bin / 'nix').chmod(0o755)
        (self.work / 'scripts/messaging-compat-binary').write_text('echo compat >> "$CI_LOCAL_TEST_LOG.prep"; echo /compat/fractal\n')
        self.home = root / 'account home'
        (self.home / '.local/bin').mkdir(parents=True)
        # The dev shell's real cargo: a wrapper script outside the account's home (never run here).
        self.devshell = root / 'devshell bin'
        self.devshell.mkdir()
        (self.devshell / 'cargo').write_text('#!/bin/sh\nexec cargo-wrapped "$@"\n')
        (self.devshell / 'cargo').chmod(0o755)
        # The recording stand-in first on PATH is the shim, and a cargo in the account's home: neither is the dev shell's.
        (self.home / '.local/bin/cargo').write_text('#!/bin/sh\n')
        (self.home / '.local/bin/cargo').chmod(0o755)
        self.stage_exits = []
        self.umask = 0o022
        self.tmp_root = root / 'short-tmp'
        self.tmp_root.mkdir()

    def run_local(self, *stages, ci_linux=None, entry='ci-local', **extra):
        # The stage stub exits with the next code of stage_exits on each call (0 when they run out).
        counter = Path(self.tmp.name) / 'calls'
        counter.write_text('0')
        codes = ' '.join(str(code) for code in self.stage_exits)
        (self.work / 'scripts/ci-linux').write_text(ci_linux or RECORD + f'n=$(cat {counter}); echo $((n + 1)) > {counter}\n'
                                                    f'codes=({codes}); exit "${{codes[$n]:-0}}"\n')
        recorder = self.home / '.local/state/st3/recorder/bin'
        env = {'PATH': f'{recorder}:{self.bin}:{self.home}/.local/bin:{self.devshell}:{os.environ["PATH"]}:{self.home}/.local/state/st3', 'HOME': str(self.home), 'CI_LOCAL_TEST_LOG': str(self.log),
               'TMPDIR': self.tmp.name, 'XDG_RUNTIME_DIR': '/run/user/test', 'ST_AGENT': 'agent/x', 'ST3_ENDPOINT': 'unix:/x',
               # The names a seat carries since the rename: the live daemon's endpoint and the seat's identity.
               'FRACTAL_ENDPOINT': '/run/user/test/live.sock', 'FRACTAL_AGENT': 'agent/x', 'ST2_HOME': '/x',
               'GH_TOKEN': 'secret', 'GITHUB_TOKEN': 'secret', 'SSH_AUTH_SOCK': '/x', 'EVIDENCE_PUSH_TOKEN': 'secret',
               'SEKRETS_PROFILE': 'p', 'XDG_STATE_HOME': str(self.home / '.local/state'),
               'ST2_OTELITE_BIN': '/nix/store/x-otelite/bin/otelite', 'FRACTAL_OTELITE_BIN': '/nix/store/x-otelite/bin/otelite',
               'ST3_OTELITE_BIN': '/nix/store/../escape/bin/otelite', 'CI_LOCAL_TMP_ROOT': str(self.tmp_root), **extra}
        self.last_env = env
        done = subprocess.run(['bash', f'scripts/{entry}', *stages], cwd=self.work, env=env, capture_output=True, text=True,
                              preexec_fn=lambda: os.umask(self.umask))
        calls = [json.loads(line) for line in self.log.read_text().splitlines()] if self.log.exists() else []
        return done, calls

    def test_the_host_build_admission_is_named_from_the_account_s_home(self):
        # Without the account's admission program the stages' HOME hides nothing to name: no variable is set.
        done, calls = self.run_local('mail-redelivery-canaries')
        self.assertEqual(done.returncode, 0, done.stderr)
        for name in ('BUILD_ADMISSION_BIN', 'BUILD_ADMISSION_CONFIG', 'BUILD_ADMISSION_STATE', 'BUILD_ADMISSION_LOG', 'BUILD_ADMISSION_FALLBACK_LOCK',
                     'CARGO_PRIORITY_FILE', 'CARGO_HEAVY_SLOTS'):
            self.assertNotIn(name, calls[-1]['env'])
        program = self.home / '.local/bin/build-admission'
        program.write_text('#!/bin/sh\n')
        program.chmod(0o755)
        (self.home / '.config').mkdir(exist_ok=True)
        (self.home / '.config/cargo-priority').write_text('010 agent/*\n')
        (self.home / '.config/cargo-heavy-slots').write_text('2\n')
        self.log.unlink(missing_ok=True)
        done, calls = self.run_local('mail-redelivery-canaries')
        self.assertEqual(done.returncode, 0, done.stderr)
        env = calls[-1]['env']
        self.assertNotEqual(env['HOME'], str(self.home))  # the stages still run in a home of their own
        self.assertEqual({name: env.get(name) for name in ('BUILD_ADMISSION_BIN', 'BUILD_ADMISSION_CONFIG', 'BUILD_ADMISSION_STATE', 'BUILD_ADMISSION_LOG',
                                                         'BUILD_ADMISSION_FALLBACK_LOCK', 'CARGO_PRIORITY_FILE', 'CARGO_HEAVY_SLOTS')},
                         {'BUILD_ADMISSION_BIN': str(program),
                          'BUILD_ADMISSION_CONFIG': f'{self.home}/.config/build-admission',
                          'BUILD_ADMISSION_STATE': f'{self.home}/.local/state/st3/operations',
                          'BUILD_ADMISSION_LOG': f'{self.home}/.local/state/st3/operations/build-admission.log',  # the cargo shim's slot waits
                          'BUILD_ADMISSION_FALLBACK_LOCK': f'{self.home}/.local/state/st3/operations/build-admission-fallback.lock',
                          'CARGO_PRIORITY_FILE': f'{self.home}/.config/cargo-priority',
                          'CARGO_HEAVY_SLOTS': '2'})
        self.log.unlink(missing_ok=True)
        done, calls = self.run_local('mail-redelivery-canaries', CARGO_HEAVY_SLOTS='1', BUILD_ADMISSION_STATE='/elsewhere')
        self.assertEqual((calls[-1]['env']['CARGO_HEAVY_SLOTS'], calls[-1]['env']['BUILD_ADMISSION_STATE']), ('1', '/elsewhere'))  # the caller's
        self.assertEqual(calls[-1]['env']['BUILD_ADMISSION_LOG'], '/elsewhere/build-admission.log')  # beside the state it names

    def test_the_stages_build_without_debug_info_as_ci_does(self):
        done, calls = self.run_local('mail-redelivery-canaries', CARGO_PROFILE_TEST_DEBUG='1')
        self.assertEqual(done.returncode, 0, done.stderr)
        for call in calls:
            self.assertEqual((call['env'].get('CARGO_PROFILE_DEV_DEBUG'), call['env'].get('CARGO_PROFILE_TEST_DEBUG')), ('0', '0'))

    def test_the_stages_run_in_a_home_of_their_own_without_the_account_s_variables(self):
        done, calls = self.run_local('mail-redelivery-canaries', LD_PRELOAD='/nix/store/x-jemalloc/lib/libjemalloc.so.2',
                                     RUSTC_WRAPPER='/nix/store/x-sccache/bin/sccache', CARGO_BUILD_RUSTC_WRAPPER='sccache')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual([call['argv'] for call in calls],
                         [['build', '--locked', '-p', 'fractal-drivers', '--bin', 'ci-hooks-install'], [], ['mail-redelivery-canaries']])
        for call in calls:
            env = call['env']
            scratch = Path(env['HOME'])
            self.assertNotEqual(scratch, self.home)
            self.assertTrue(str(scratch).startswith(self.tmp.name), scratch)
            for name in ('XDG_STATE_HOME', 'XDG_CONFIG_HOME', 'XDG_DATA_HOME', 'XDG_CACHE_HOME', 'RUNNER_TEMP', 'GITHUB_STEP_SUMMARY'):
                self.assertTrue(env[name].startswith(str(scratch.parent)), (name, env[name]))
            # The scratch is on the account's disk, never the caller's TMPDIR (a dev shell's, under /tmp).
            self.assertTrue(str(scratch).startswith(f'{self.home}/.cache/ci-local/run.'), scratch)
            # The TMPDIR is short and on disk (Unix socket paths below it are limited to 108 bytes): under CI_LOCAL_TMP_ROOT.
            self.assertEqual(Path(env['TMPDIR']).parent, self.tmp_root)
            self.assertTrue(Path(env['TMPDIR']).name.startswith('cl.'), env['TMPDIR'])
            self.assertNotIn('LD_PRELOAD', env)  # a host's preloaded allocator: CI preloads nothing
            # no compiler cache server: one started here would keep this run's HOME and TMPDIR, removed at exit, for every build
            self.assertNotIn('RUSTC_WRAPPER', env)
            self.assertNotIn('CARGO_BUILD_RUSTC_WRAPPER', env)
            for name in ('ST_AGENT', 'ST3_ENDPOINT', 'FRACTAL_ENDPOINT', 'FRACTAL_AGENT', 'ST2_HOME', 'GH_TOKEN', 'GITHUB_TOKEN',
                         'SSH_AUTH_SOCK', 'EVIDENCE_PUSH_TOKEN', 'SEKRETS_PROFILE', 'ST3_OTELITE_BIN'):
                self.assertNotIn(name, env)
            # The dev shell's collector for the OTLP export tests stays, as in CI; the same name pointing anywhere else does not.
            self.assertEqual((env.get('ST2_OTELITE_BIN'), env.get('FRACTAL_OTELITE_BIN')), ('/nix/store/x-otelite/bin/otelite',) * 2)
            # Kept: the dependency cache, the build admission's runtime directory, and the saved dev shell environment.
            # CARGO_REAL is the dev shell's cargo: not the shim first on PATH, not the cargo in the account's home.
            self.assertEqual((env['CARGO_HOME'], env['RUSTUP_HOME'], env['CARGO_REAL'], env['XDG_RUNTIME_DIR']),
                             (f'{self.home}/.cargo', f'{self.home}/.rustup', str(self.devshell / 'cargo'), '/run/user/test'))
            self.assertFalse([entry for entry in env['PATH'].split(':') if entry.startswith(f'{self.home}/.local/state/st3')], env['PATH'])
            self.assertEqual(env['PATH'].split(':')[0], str(self.bin), 'the other entries keep their order')
            # Last, so cargo finds the dev shell's clippy before the rustup proxy there.
            self.assertEqual(env['PATH'].split(':')[-1], f'{self.home}/.cargo/bin')
        self.assertEqual(calls[-1]['env']['CI_TEST_THREADS'], '12', 'a shared host: twelve test threads, not nproc')
        self.assertEqual(list((self.home / '.cache/ci-local').glob('run.*')), [], 'the scratch home is removed afterwards')

    def test_every_time_is_printed_and_each_stage_s_output_is_kept(self):
        logs = Path(self.tmp.name) / 'logs'
        said = '#!/usr/bin/env bash\necho "out of $1"; echo "err of $1" >&2; [ "$1" = tests ] || exit 3\n'
        done, calls = self.run_local('tests', 'fleet-compat', ci_linux=said, CI_LOCAL_LOG_DIR=str(logs))
        self.assertEqual(done.returncode, 3, done.stderr)
        self.assertIn(f'ci-local: stage logs in {logs}/run-', done.stdout)
        table = [line for line in done.stdout.splitlines() if line.startswith('ci-local:   ')]
        self.assertEqual([line.split()[1] for line in table], ['setup', 'tests', 'fleet-compat'])
        stamp = r'\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ'
        self.assertRegex(table[0], rf'setup +{stamp} +{stamp} +\d+s')
        self.assertRegex(table[1], rf'tests +{stamp} +{stamp} +\d+s +exit 0 +queue: 0 waits, 0s')
        self.assertRegex(table[2], rf'fleet-compat +{stamp} +{stamp} +\d+s +exit 3 +queue: 0 waits, 0s')
        run, = logs.glob('run-*')
        self.assertEqual(sorted(path.name for path in run.glob('*.log')), ['fleet-compat.log', 'tests.log'])
        self.assertEqual(sorted((run / 'tests.log').read_text().split('\n')[:2]), ['err of tests', 'out of tests'])
        self.assertEqual(done.stdout.count('out of tests'), 1)  # passed on as before, once
        self.assertEqual(done.stdout.count('err of fleet-compat'), 1)

    def test_the_time_a_stage_waits_in_the_build_admission_queue_is_stamped_and_added_up(self):
        logs = Path(self.tmp.name) / 'logs'
        queue = ('#!/usr/bin/env bash\necho "cargo: waiting in order for a host build slot (all 6 busy)"\nsleep 1.2\n'
                 'echo "cargo: got build slot 0 and a heavy slot"\necho compiling\n'
                 'echo "cargo: waiting in order for a host build slot (all 6 busy)" >&2\nsleep 1.1\necho "cargo: got build slot 1" >&2\n')
        done, _ = self.run_local('tests', ci_linux=queue, CI_LOCAL_LOG_DIR=str(logs))
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(len(re.findall(r'ci-local: \[\d{4}-\S+Z\] tests: waiting for a build slot', done.stdout)), 2)
        self.assertEqual(len(re.findall(r'ci-local: \[\d{4}-\S+Z\] tests: got a build slot', done.stdout)), 2)
        row, = [line for line in done.stdout.splitlines() if line.startswith('ci-local:   tests')]
        waits, seconds = re.search(r'queue: (\d+) waits, (\d+)s', row).groups()
        self.assertEqual(waits, '2')
        self.assertGreaterEqual(int(seconds), 2)
        run, = logs.glob('run-*')
        self.assertIn('compiling', (run / 'tests.log').read_text())

    def test_each_wait_for_a_build_slot_is_written_as_it_starts_and_ends_to_the_queue_log(self):
        events = Path(self.tmp.name) / 'queue-events'
        # Two waits that end with a slot, then one the stage never leaves (its cargo gave up): the run's end closes it.
        queue = ('#!/usr/bin/env bash\necho "cargo: waiting in order for a host build slot (all 6 busy)"\nsleep 1.1\n'
                 'echo "cargo: next in order; waiting for the build admission gate (load/memory), holding no slot"\n'
                 'echo "cargo: got build slot 0 and a heavy slot"\n'
                 'echo "cargo: waiting in order for a host build slot (all 6 busy)" >&2\necho "cargo: got build slot 1" >&2\n'
                 'echo "cargo: waiting in order for a host build slot (all 6 busy)"\nexit 0\n')
        done, _ = self.run_local('tests', ci_linux=queue, CI_LOCAL_QUEUE_LOG=str(events))
        self.assertEqual(done.returncode, 0, done.stderr)
        lines = [line.split(' ') for line in events.read_text().splitlines()]
        self.assertEqual([(kind, stage) for kind, _, stage in lines],
                         [('wait', 'tests'), ('slot', 'tests'), ('wait', 'tests'), ('slot', 'tests'), ('wait', 'tests'), ('slot', 'tests')])
        at = [int(seconds) for _, seconds, _ in lines]
        self.assertEqual(at, sorted(at))
        self.assertGreaterEqual(at[1] - at[0], 1)  # the first wait lasted its second

    def dead_pid(self):
        child = subprocess.Popen(['true'])
        child.wait()
        return child.pid

    def test_only_the_latest_ten_runs_keep_their_logs(self):
        home_logs = self.home / '.cache/ci-local-logs'
        dead = self.dead_pid()
        for n in range(12):
            old = home_logs / f'run-2020010{n % 10}T00000{n // 10}Z-{dead}'
            old.mkdir(parents=True)
            os.utime(old, (1_000_000 + n, 1_000_000 + n))
        done, _ = self.run_local('tests')
        self.assertEqual(done.returncode, 0, done.stderr)
        kept = sorted(path.name for path in home_logs.glob('run-*'))
        self.assertEqual(len(kept), 10)
        self.assertNotIn(f'run-20200100T000000Z-{dead}', kept)  # the oldest went
        self.assertTrue(any(not name.startswith('run-2020') for name in kept))  # this run's

    def test_a_run_still_going_keeps_its_logs_however_many_runs_started_after_it(self):
        # A run waiting hours for build slots on a busy host is older than ten later runs and still writes its exit codes.
        home_logs = self.home / '.cache/ci-local-logs'
        live, dead = home_logs / f'run-20200100T000000Z-{os.getpid()}', home_logs / f'run-20200100T000001Z-{self.dead_pid()}'
        for n, path in enumerate([live, dead] + [home_logs / f'run-2020020{n}T000000Z-{self.dead_pid()}' for n in range(10)]):
            path.mkdir(parents=True)
            os.utime(path, (1_000_000 + n, 1_000_000 + n))
        done, _ = self.run_local('tests')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertTrue(live.is_dir())
        self.assertFalse(dead.exists())

    def test_the_tmpdir_is_in_ram_when_dev_shm_has_room_and_on_disk_otherwise(self):
        if not (os.path.isdir('/dev/shm') and os.access('/dev/shm', os.W_OK)):
            self.skipTest('no writable /dev/shm here')
        for free_kb, root in ((30 * 1024 * 1024, '/dev/shm'), (19 * 1024 * 1024, '/var/tmp')):
            with self.subTest(free_kb=free_kb):
                (self.bin / 'df').write_text(f'#!/bin/sh\necho "Filesystem 1024-blocks Used Available Capacity Mounted"\necho "tmpfs 1 1 {free_kb} 1% /dev/shm"\n')
                (self.bin / 'df').chmod(0o755)
                self.log.unlink(missing_ok=True)
                done, calls = self.run_local('mail-redelivery-canaries', CI_LOCAL_TMP_ROOT='')
                self.assertEqual(done.returncode, 0, done.stderr)
                tmpdir = Path(calls[-1]['env']['TMPDIR'])
                self.assertEqual((str(tmpdir.parent), tmpdir.name[:3]), (root, 'cl.'))
                self.assertFalse(tmpdir.exists(), 'removed when the run ends')

    def test_the_host_load_limit_is_waited_out_said_every_minute_and_never_silent(self):
        loadavg = Path(self.tmp.name) / 'loadavg'
        loadavg.write_text('34.00 20.00 10.00 1/100 1234\n')
        for name, extra, expected in (('no limit', {}, 0),
                                      ('under the limit', {'ST_TEST_MAX_LOAD': '40'}, 0)):
            with self.subTest(name):
                self.log.unlink(missing_ok=True)
                done, calls = self.run_local('mail-redelivery-canaries', CI_LOCAL_LOADAVG_FILE=str(loadavg), **extra)
                self.assertEqual(done.returncode, expected, done.stderr)
                self.assertNotIn('waiting: load1', done.stderr)
                self.assertTrue(calls)
        self.log.unlink(missing_ok=True)
        done, calls = self.run_local('mail-redelivery-canaries', CI_LOCAL_LOADAVG_FILE=str(loadavg), ST_TEST_MAX_LOAD='20',
                                     ST_TEST_LOAD_WAIT_MINUTES='0.01', CI_LOCAL_LOAD_POLL='0.1')
        self.assertEqual(done.returncode, 3)
        self.assertIn('ci-local: waiting: load1 34.00 > 20 (host limit)', done.stderr)
        self.assertIn('the host stayed above its load limit: load1 34.00 > 20 (host limit)', done.stderr)
        self.assertEqual(calls, [], 'nothing was started')
        self.assertEqual(list((self.home / '.cache/ci-local').glob('run.*')), [])
        # the limit may be a file in the account's config, and a load that drops during the wait lets the run through
        (self.home / '.config/st-test').mkdir(parents=True)
        (self.home / '.config/st-test/max-load').write_text('20\n')
        dropper = subprocess.Popen(['bash', '-c', f'sleep 0.6; echo "5.00 5.00 5.00 1/100 1" > {loadavg}'])
        self.addCleanup(dropper.wait)
        done, calls = self.run_local('mail-redelivery-canaries', CI_LOCAL_LOADAVG_FILE=str(loadavg), ST_TEST_LOAD_WAIT_MINUTES='1',
                                     CI_LOCAL_LOAD_POLL='0.1')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertIn('waiting: load1 34.00 > 20 (host limit)', done.stderr)
        self.assertTrue(calls)
        done, _ = self.run_local('mail-redelivery-canaries', ST_TEST_MAX_LOAD='lots')
        self.assertEqual(done.returncode, 2)
        self.assertIn('must be a number', done.stderr)

    def test_a_failing_property_test_cannot_leave_a_regressions_file_in_the_tree_the_signer_checks(self):
        done, calls = self.run_local('mail-redelivery-canaries')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(calls[-1]['env'].get('PROPTEST_DISABLE_FAILURE_PERSISTENCE'), '1')

    def test_each_test_process_gets_a_tmpdir_of_its_own_through_the_cargo_target_runner(self):
        done, calls = self.run_local('mail-redelivery-canaries', CI_LOCAL_TARGET_TRIPLE='x86_64-unknown-linux-gnu')
        self.assertEqual(done.returncode, 0, done.stderr)
        for call in calls:
            env = call['env']
            self.assertEqual(env['CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUNNER'], str(self.work / 'scripts/ci-test-tmpdir'))
            self.assertEqual(env['CI_TEST_TMPDIR_ROOT'], env['TMPDIR'])  # the run's own short TMPDIR, removed with it

    def test_the_runner_gives_every_start_a_fresh_tmpdir_and_runs_the_command_in_its_place(self):
        root = Path(self.tmp.name) / 'root'
        root.mkdir()
        runner = ROOT / 'scripts/ci-test-tmpdir'
        seen = []
        for _ in range(2):
            child = subprocess.Popen([str(runner), 'sh', '-c', 'echo "$TMPDIR $$"; mkdir "$TMPDIR/.git"'], stdout=subprocess.PIPE, text=True,
                                     env={'PATH': os.environ['PATH'], 'CI_TEST_TMPDIR_ROOT': str(root), 'TMPDIR': '/elsewhere'})
            out, _ = child.communicate()
            self.assertEqual(child.returncode, 0)
            directory, pid = out.split()
            self.assertEqual(int(pid), child.pid)  # exec: no extra process between the caller and the test
            self.assertEqual(Path(directory).parent, root)
            seen.append(directory)
        self.assertNotEqual(seen[0], seen[1])
        self.assertFalse((root / '.git').exists())  # what one start leaves at the top of its TMPDIR stays there
        done = subprocess.run([str(runner), 'true'], env={'PATH': os.environ['PATH']}, capture_output=True, text=True)
        self.assertNotEqual(done.returncode, 0)  # outside scripts/ci-local it refuses rather than guess a directory

    def test_on_a_host_whose_umask_is_002_the_stages_get_ci_s_022_and_no_group_writable_scratch(self):
        self.umask = 0o002
        root = self.home / '.cache/ci-local'
        root.mkdir(parents=True)
        root.chmod(0o775)  # left group-writable by an earlier run under umask 002
        done, calls = self.run_local('mail-redelivery-canaries')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual({call['umask'] for call in calls}, {0o022})
        self.assertEqual(root.stat().st_mode & 0o022, 0)

    def test_ci_local_cargo_names_the_cargo_and_without_a_dev_shell_cargo_nothing_runs(self):
        done, calls = self.run_local('mail-redelivery-canaries', CI_LOCAL_CARGO='/chosen/cargo')
        self.assertEqual((done.returncode, calls[-1]['env']['CARGO_REAL']), (0, '/chosen/cargo'), done.stderr)
        (self.devshell / 'cargo').unlink()
        self.log.unlink()
        # The tools the script needs, from directories that hold no cargo.
        tools = {str(Path(shutil.which(tool)).parent) for tool in ('bash', 'mktemp', 'rm', 'mkdir', 'chmod', 'grep', 'touch', 'env', 'python3')}
        tools = [entry for entry in sorted(tools) if not (Path(entry) / 'cargo').exists()]
        done, calls = self.run_local('mail-redelivery-canaries', PATH=':'.join([str(self.bin), f'{self.home}/.local/bin', *tools]))
        self.assertEqual((done.returncode, calls), (2, []), done.stderr)
        self.assertIn('no cargo executable of the dev shell', done.stderr)

    def test_clippy_runs_alongside_the_tests_and_fleet_compat_after_them_reporting_in_the_given_order(self):
        logs = Path(self.tmp.name) / 'logs'
        # The tests stage waits until clippy has started: it really runs alongside it. Fleet compatibility relinks the fractal
        # binaries the tests exec (#4128), so it must not start until the tests stage is done: the tests stage fails if it has.
        said = ('#!/usr/bin/env bash\necho "out of $1"\n'
                '[ "$1" = fleet-compat ] && touch "$CI_LOCAL_TEST_LOG.fleet"\n'
                'if [ "$1" = tests ]; then for i in $(seq 100); do [ -e "$CI_LOCAL_TEST_LOG.clippy" ] && break; sleep 0.05; done; '
                '[ -e "$CI_LOCAL_TEST_LOG.clippy" ] || exit 9; sleep 0.5; [ -e "$CI_LOCAL_TEST_LOG.fleet" ] && exit 8; '
                'touch "$CI_LOCAL_TEST_LOG.tests"; fi\n'
                '[ "$1" = clippy ] && touch "$CI_LOCAL_TEST_LOG.clippy"\n'
                '[ "$1" = fleet-compat ] && { [ -e "$CI_LOCAL_TEST_LOG.tests" ] || exit 7; exit 4; }\n[ "$1" = clippy ] && exit 6\nexit 0\n')
        done, calls = self.run_local('tests', 'clippy', 'fleet-compat', ci_linux=said, CI_LOCAL_LOG_DIR=str(logs), CLIPPY_BASE_SHA='f' * 40)
        self.assertEqual(done.returncode, 6, done.stdout + done.stderr)  # the first failure in the given order: clippy's, not fleet-compat's
        self.assertIn('ci-local: clippy run alongside the other stages', done.stdout)
        # The lane's output follows the foreground's, whole, never interleaved.
        out = done.stdout
        self.assertLess(out.index('ci-local: tests exit 0'), out.index('ci-local: fleet-compat exit 4'))
        self.assertLess(out.index('ci-local: fleet-compat exit 4'), out.index('----- ci-local: clippy output -----'))
        self.assertLess(out.index('----- ci-local: clippy output -----'), out.index('out of clippy'))
        self.assertIn('ci-local: clippy exit 6', out)
        table = [line.split()[1] for line in out.splitlines() if line.startswith('ci-local:   ')]
        self.assertEqual(table, ['setup', 'tests', 'clippy', 'fleet-compat'])
        run, = logs.glob('run-*')
        self.assertEqual(sorted(path.name for path in run.glob('*.log')), ['clippy.log', 'fleet-compat.log', 'tests.log'])

    def test_a_stopped_run_stops_the_stage_its_lane_is_running(self):
        # clippy (in the lane) records its pid and keeps running; the tests stage ends at once, so the run waits for its lane.
        said = ('#!/usr/bin/env bash\n'
                'if [ "$1" = clippy ]; then echo $$ > "$CI_LOCAL_TEST_LOG.clippy"; sleep 60; fi\n'
                'if [ "$1" = tests ]; then for i in $(seq 100); do [ -s "$CI_LOCAL_TEST_LOG.clippy" ] && break; sleep 0.05; done; fi\n')
        (self.work / 'scripts/ci-linux').write_text(said)
        # Every sed the run starts is counted. Stopping the lane once ran one per process on the host for each process of the
        # lane's tree, which on a loaded host took longer than the 20 s this test waits for the run to exit.
        (self.bin / 'sed').write_text(f'#!/bin/sh\necho sed >> "$CI_LOCAL_TEST_LOG.sed"\nexec {shutil.which("sed")} "$@"\n')
        (self.bin / 'sed').chmod(0o755)
        env = {'PATH': f'{self.bin}:{self.devshell}:{os.environ["PATH"]}', 'HOME': str(self.home), 'CI_LOCAL_TEST_LOG': str(self.log),
               'TMPDIR': self.tmp.name, 'CI_LOCAL_TMP_ROOT': str(self.tmp_root), 'CLIPPY_BASE_SHA': 'f' * 40}
        run = subprocess.Popen(['bash', 'scripts/ci-local', 'tests', 'clippy'], cwd=self.work, env=env, stdout=subprocess.PIPE,
                               stderr=subprocess.STDOUT, text=True)
        self.addCleanup(lambda: run.poll() is None and run.kill())
        marker = Path(f'{self.log}.clippy')
        for _ in range(200):
            if marker.exists() and marker.read_text().strip():
                break
            time.sleep(0.05)
        clippy = int(marker.read_text())
        time.sleep(0.5)  # the tests stage is done; the run is waiting for its lane
        run.terminate()
        run.wait(timeout=20)
        for _ in range(100):
            if not Path(f'/proc/{clippy}').exists():
                break
            time.sleep(0.05)
        self.assertFalse(Path(f'/proc/{clippy}').exists(), 'the lane\'s running stage outlived the run')
        seds = Path(f'{self.log}.sed')
        self.assertLess(len(seds.read_text().splitlines()) if seds.exists() else 0, 10, 'stopping the lane reads /proc without a sed per process')
        self.assertEqual(list((self.home / '.cache/ci-local').glob('run.*')), [], 'the scratch home is removed afterwards')

    def test_a_worker_a_stage_starts_after_the_stop_has_listed_proc_is_stopped_too(self):
        # clippy (in the lane) starts a worker when told to, and records it. The test tells it to once the stopped run has
        # listed /proc (its first status file is open), with the run itself frozen, so the worker is new to that listing.
        said = ('#!/usr/bin/env bash\n'
                'if [ "$1" = clippy ]; then echo $$ > "$CI_LOCAL_TEST_LOG.clippy"\n'
                '  until [ -e "$CI_LOCAL_TEST_LOG.go" ]; do sleep 0.01; done\n'
                '  sleep 300 & echo $! >> "$CI_LOCAL_TEST_LOG.workers"; wait; fi\n'
                'if [ "$1" = tests ]; then for i in $(seq 100); do [ -s "$CI_LOCAL_TEST_LOG.clippy" ] && break; sleep 0.05; done; fi\n')
        (self.work / 'scripts/ci-linux').write_text(said)
        env = {'PATH': f'{self.bin}:{self.devshell}:{os.environ["PATH"]}', 'HOME': str(self.home), 'CI_LOCAL_TEST_LOG': str(self.log),
               'TMPDIR': self.tmp.name, 'CI_LOCAL_TMP_ROOT': str(self.tmp_root), 'CLIPPY_BASE_SHA': 'f' * 40}
        run = subprocess.Popen(['bash', 'scripts/ci-local', 'tests', 'clippy'], cwd=self.work, env=env, stdout=subprocess.PIPE,
                               stderr=subprocess.STDOUT, text=True)
        self.addCleanup(lambda: run.poll() is None and (os.kill(run.pid, signal.SIGCONT), run.kill()))
        workers = Path(f'{self.log}.workers')

        def alive():
            # This test's own workers only: each carries its CI_LOCAL_TEST_LOG.
            pids = [int(line) for line in workers.read_text().split()] if workers.exists() else []
            def ours(pid):
                try:
                    return f'CI_LOCAL_TEST_LOG={self.log}\0'.encode() in Path(f'/proc/{pid}/environ').read_bytes()
                except OSError:
                    return False
            return [pid for pid in pids if ours(pid)]
        self.addCleanup(lambda: [os.kill(pid, signal.SIGKILL) for pid in alive()])

        def state(pid):
            try:
                return Path(f'/proc/{pid}/stat').read_text().rsplit(')', 1)[1].split()[0]
            except (OSError, IndexError):
                return None
        marker = Path(f'{self.log}.clippy')
        for _ in range(200):
            if marker.exists() and marker.read_text().strip():
                break
            time.sleep(0.05)
        clippy = int(marker.read_text())
        time.sleep(0.5)  # the tests stage is done; the run is waiting for its lane
        run.terminate()
        listed = False
        deadline = time.monotonic() + 20
        while not listed and run.poll() is None and time.monotonic() < deadline:
            try:
                names = os.listdir(f'/proc/{run.pid}/fd')
            except OSError:
                continue
            for name in names:
                try:
                    target = os.readlink(f'/proc/{run.pid}/fd/{name}')
                except OSError:
                    continue
                if re.fullmatch(r'/proc/\d+/status', target):
                    os.kill(run.pid, signal.SIGSTOP)
                    listed = True
                    break
        self.assertTrue(listed, 'the test did not catch the stopped run reading /proc')
        for _ in range(500):
            if state(run.pid) == 'T':
                break
            time.sleep(0.01)
        self.assertEqual(state(run.pid), 'T', 'the stopped run is frozen while its /proc listing is open')
        # Frozen with that listing open, the run has not yet stopped clippy (it stops a process only after listing /proc).
        self.assertNotIn(state(clippy), (None, 'Z'), 'the run was frozen before it stopped clippy')
        Path(f'{self.log}.go').touch()
        # Now clippy starts its worker, after the listing, unless the stop has already frozen clippy: only freezing does that.
        for _ in range(500):
            if alive() or state(clippy) == 'T':
                break
            time.sleep(0.01)
        late, frozen = alive(), state(clippy) == 'T'
        self.assertTrue(late or frozen, 'clippy neither started its worker nor was frozen by the stop')
        os.kill(run.pid, signal.SIGCONT)
        run.wait(timeout=20)
        for _ in range(100):
            if not alive():
                break
            time.sleep(0.05)
        self.assertEqual(alive(), [], 'a worker the lane started after the stop listed /proc outlived the run')
        self.assertEqual(list((self.home / '.cache/ci-local').glob('run.*')), [], 'the scratch home is removed afterwards')

    def test_every_stage_runs_and_the_first_failure_is_the_exit_status(self):
        self.stage_exits = [0, 3, 5]
        done, calls = self.run_local('mail-redelivery-canaries', 'mail-redelivery-canaries', 'mail-redelivery-canaries')
        self.assertEqual(done.returncode, 3, done.stderr)
        self.assertEqual([call['argv'] for call in calls][2:], [['mail-redelivery-canaries']] * 3)
        self.assertIn('ci-local: mail-redelivery-canaries exit 3', done.stdout)
        self.assertIn('ci-local: mail-redelivery-canaries exit 5', done.stdout)

    def test_the_test_threads_can_be_named_and_the_stages_run_at_low_priority(self):
        done, calls = self.run_local('mail-redelivery-canaries', CI_TEST_THREADS='2')
        self.assertEqual((done.returncode, calls[-1]['env']['CI_TEST_THREADS']), (0, '2'), done.stderr)
        # The stage stub reports its own niceness: ten above the caller's (19 at most).
        (self.work / 'scripts/ci-linux').write_text('#!/usr/bin/env bash\npython3 -I -c "import os; print(os.nice(0))" > "$CI_LOCAL_TEST_LOG.nice"\n')
        done = subprocess.run(['bash', 'scripts/ci-local', 'mail-redelivery-canaries'], cwd=self.work, capture_output=True, text=True,
                              env={'PATH': f'{self.bin}:{self.devshell}:{os.environ["PATH"]}', 'HOME': str(self.home),
                                   'CI_LOCAL_TEST_LOG': str(self.log), 'TMPDIR': self.tmp.name})
        self.assertEqual(done.returncode, 0, done.stderr)
        if shutil.which('nice'):
            self.assertEqual(int(Path(f"{self.log}.nice").read_text()), min(os.nice(0) + 10, 19))

    def test_keyed_defaults_and_explicit_values_pass_through_ci_local(self):
        # linux-clippy's local run no longer has an entry of its own: scripts/st-test runs `ci-local clippy` unkeyed and
        # scripts/ci-clippy-result checks the policy after the stage (docs/keyed-clippy.md, PR 2).
        for entry, stage, variable in (('ci-fleet-compat-keyed', 'fleet-compat', 'CI_KEYED_FLEET_COMPAT_POLICY'),):
            shutil.copy(ROOT / 'scripts' / entry, self.work / 'scripts' / entry)
            for explicit in (None, '', '.st/evidence-skip-policy.json', '/custom/policy.json'):
                with self.subTest(entry=entry, explicit=explicit):
                    extra = {} if explicit is None else {variable: explicit}
                    done, calls = self.run_local(entry=entry, CLIPPY_BASE_SHA='f' * 40, **extra)
                    self.assertEqual(done.returncode, 0, done.stderr)
                    self.assertEqual(calls[-1]['env'][variable], 'auto:.st/evidence-skip-policy.json' if explicit is None else explicit)
                    self.assertEqual(calls[-1]['argv'], [stage])
                    self.log.unlink()
            done, calls = self.run_local(stage, CLIPPY_BASE_SHA='f' * 40)
            self.assertEqual(done.returncode, 0, done.stderr)
            self.assertNotIn(variable, calls[-1]['env'], 'ordinary linux-gate stages stay unkeyed')
            self.log.unlink()

    def test_keyed_consumer_selects_missing_only_without_running_compiles(self):
        source = (ROOT / 'scripts/ci-linux').read_text()
        function = 'keyed_policy() {' + source.split('keyed_policy() {', 1)[1].split('\n}\n', 1)[0] + '\n}\n'
        def resolve(value='auto:.st/evidence-skip-policy.json'):
            return subprocess.run(['bash', '-euc', function + '\nkeyed_policy "$CI_KEYED_CLIPPY_POLICY"'], cwd=self.work,
                                  env=dict(os.environ, CI_KEYED_CLIPPY_POLICY=value), capture_output=True, text=True)
        old = self.work / '.st/evidence-skip-policy.json'
        new = self.work / '.fractal/evidence-skip-policy.json'
        old.parent.mkdir()
        new.parent.mkdir()
        old.write_text('{}')
        self.assertEqual(resolve().stdout.strip(), '.st/evidence-skip-policy.json')
        new.write_text('{}')
        self.assertEqual(resolve().stdout.strip(), '.fractal/evidence-skip-policy.json')
        old.unlink()
        self.assertEqual(resolve().stdout.strip(), '.fractal/evidence-skip-policy.json')
        old.write_text('{}')
        new.write_text('{')
        self.assertEqual(resolve().stdout.strip(), '.fractal/evidence-skip-policy.json', 'malformed selected file is not bypassed')
        new.unlink()
        new.symlink_to('missing')
        self.assertEqual(resolve().stdout.strip(), '.fractal/evidence-skip-policy.json', 'dangling selected file is not bypassed')
        new.unlink()
        new.parent.rmdir()
        new.parent.symlink_to('.fractal')
        self.assertNotEqual(resolve().returncode, 0, 'lookup errors must not select legacy')
        for explicit in ('', '.st/evidence-skip-policy.json', '/custom/policy.json'):
            done = resolve(explicit)
            self.assertEqual((done.returncode, done.stdout.rstrip('\n')), (0, explicit))

    def test_the_linux_gate_stages_run_in_order_and_clippy_s_base_is_given_or_fetched_never_a_local_ref(self):
        def git(*args, cwd=None):
            return subprocess.run(['git', '-C', str(cwd or self.work), '-c', 'user.name=t', '-c', 'user.email=t@example.invalid', *args],
                                  capture_output=True, text=True, check=True).stdout.strip()
        origin = Path(self.tmp.name) / 'origin.git'
        subprocess.run(['git', 'init', '-q', '--bare', str(origin)], check=True)
        subprocess.run(['git', 'init', '-q', '-b', 'main', str(self.work)], check=True)
        git('commit', '-q', '--allow-empty', '-m', 'base')
        git('push', '-q', str(origin), 'main')
        fetched_tip = git('rev-parse', 'HEAD')
        git('remote', 'add', 'origin', str(origin))
        git('commit', '-q', '--allow-empty', '-m', 'local only')
        git('update-ref', 'refs/remotes/origin/main', git('rev-parse', 'HEAD'))  # a local ref that is not the remote's main
        done, calls = self.run_local('tests', 'clippy', 'fleet-compat', 'mail-redelivery-canaries', CI_LOCAL_SERIAL='1')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual([call['argv'] for call in calls][2:], [['tests'], ['clippy'], ['fleet-compat'], ['mail-redelivery-canaries']])
        self.assertEqual(calls[-1]['env']['CLIPPY_BASE_SHA'], fetched_tip, 'main as fetched now, not the local origin/main')
        # By default clippy runs alongside the others and fleet compatibility after the tests: every stage once.
        self.log.unlink()
        done, calls = self.run_local('tests', 'clippy', 'fleet-compat', 'mail-redelivery-canaries')
        self.assertEqual(done.returncode, 0, done.stderr)
        ran = [' '.join(call['argv']) for call in calls][2:]
        self.assertEqual(sorted(ran), ['clippy', 'fleet-compat', 'mail-redelivery-canaries', 'tests'])
        self.assertLess(ran.index('tests'), ran.index('fleet-compat'))
        self.assertEqual({call['env']['CLIPPY_BASE_SHA'] for call in calls[2:]}, {fetched_tip})
        self.log.unlink()
        done, calls = self.run_local('clippy', CLIPPY_BASE_SHA='f' * 40)
        self.assertEqual(calls[-1]['env']['CLIPPY_BASE_SHA'], 'f' * 40, 'a given base wins and nothing is fetched')
        self.log.unlink()
        for bad in ('main', 'f' * 39, 'F' * 40):
            done, calls = self.run_local('clippy', CLIPPY_BASE_SHA=bad)
            self.assertEqual((done.returncode, calls), (2, []), bad)
        git('remote', 'set-url', 'origin', str(Path(self.tmp.name) / 'gone.git'))
        done, calls = self.run_local('clippy')
        self.assertEqual((done.returncode, calls), (2, []), done.stderr)
        self.assertIn("could not fetch main for clippy's base", done.stderr)
        done, calls = self.run_local('mail-redelivery-canaries')
        self.assertEqual(done.returncode, 0, 'a run without clippy needs no base')

    def test_the_tests_stage_gets_ci_s_provider_components_and_compat_binary_and_others_build_nothing(self):
        done, calls = self.run_local('tests', CLIPPY_BASE_SHA='f' * 40)
        self.assertEqual(done.returncode, 0, done.stderr)
        env = calls[-1]['env']
        for provider, wasm in (('GITHUB_ISSUE', 'github_issue'), ('GITHUB_PR', 'github_pr'), ('PTY_STATS', 'pty_stats'), ('VISTA', 'vista')):
            self.assertEqual(env[f'ST2_{provider}_COMPONENT'], f'/nix/store/components/share/st2/providers/st2_{wasm}_component.component.wasm')
        self.assertEqual((env['FRACTAL_MESSAGING_COMPAT_BIN'], env['ST3_MESSAGING_COMPAT_BIN']), ('/compat/fractal', '/compat/fractal'))
        prep = Path(f'{self.log}.prep')
        self.assertIn('nix build .#checks.x86_64-linux.provider-components --no-link --print-out-paths', prep.read_text())
        prep.unlink()
        self.log.unlink()
        done, calls = self.run_local('mail-redelivery-canaries')
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertFalse(prep.exists(), 'no tests stage: nothing is prepared')
        self.assertNotIn('ST2_GITHUB_PR_COMPONENT', calls[-1]['env'])

    def test_a_failed_hook_install_runs_no_stage(self):
        (self.work / 'scripts/ci-install-built-hooks').write_text('exit 9\n')
        done, calls = self.run_local('mail-redelivery-canaries')
        self.assertEqual(done.returncode, 9)
        self.assertEqual([call['argv'] for call in calls], [['build', '--locked', '-p', 'fractal-drivers', '--bin', 'ci-hooks-install']])

    def test_the_isolation_vm_stage_runs_its_own_script_in_the_stage_s_home_and_scratch(self):
        (self.work / 'scripts/ci-local-isolation-vm').write_text(RECORD)
        done, calls = self.run_local('mail-redelivery-canaries', 'isolation-vm')
        self.assertEqual(done.returncode, 0, done.stderr)
        stage_calls = calls[-2:]  # after cargo's hook build and the hook install: ci-linux, then the VM script
        self.assertEqual([call['argv'] for call in stage_calls], [['mail-redelivery-canaries'], []])
        vm = stage_calls[-1]
        self.assertNotEqual(vm['env']['HOME'], str(self.home))
        self.assertTrue(vm['env']['RUNNER_TEMP'].startswith(self.tmp.name))
        self.assertIn('ci-local: isolation-vm exit 0', done.stdout)

    def test_the_isolation_vm_script_runs_only_under_ci_local(self):
        done = subprocess.run(['bash', str(ROOT / 'scripts/ci-local-isolation-vm')], capture_output=True, text=True,
                              env={k: v for k, v in os.environ.items() if k != 'RUNNER_TEMP'})
        self.assertNotEqual(done.returncode, 0)
        self.assertIn('ci-local-isolation-vm runs under scripts/ci-local', done.stderr)

    def test_no_stage_or_a_stage_without_a_local_lane_is_refused_before_anything_runs(self):
        for stages in ((), ('conversation-model',), ('mail-redelivery-canaries', 'nonesuch')):
            with self.subTest(stages):
                done, calls = self.run_local(*stages)
                self.assertEqual((done.returncode, calls), (2, []), done.stderr)


