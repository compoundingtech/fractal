#!/usr/bin/env python3
"""Sign a wrapper's measurement as an evidence note. Runs where the signing key lives.

Install it root-owned and hash-pinned behind a narrow sekrets grant; the unprivileged
`evidence-wrap` pipes one JSON request to it. It signs nothing it can recompute wrongly:

  * the commit, its tree and `flake.lock` are read from the caller's checkout (the current
    directory, read-only), never taken from the request;
  * the observation time and the producer digest are its own;
  * the request may carry exactly the top-level keys below; `inputs` must include the required
    environment fingerprint and may carry more short string entries.

What it cannot check is that the command really ran and printed what the request says; the
record states that this machine's wrapper reported it. That is the cooperative v1 boundary
(doc/fleet/factory/gate-evidence/known-defects): an agent with the key's account can lie.

Configuration, outside any checkout: $HOME/.config/st/evidence-sign.json
  {"signer": "fleet/dev", "ssh_key": "/abs/key", "scratch_repo": "/abs/bare.git"}

stdout: {"record": ID, "tier": "full", "object_pack_base64": ...} (the notes commit, the
source commit and its tree, as `git pack-objects` made them).
"""
import base64
import hashlib
import json
import os
from pathlib import Path
import re
import subprocess
import sys
from datetime import datetime, timezone

sys.dont_write_bytecode = True

OID = re.compile(r'^(?:[0-9a-f]{40}|[0-9a-f]{64})$')
SHA256 = re.compile(r'^[0-9a-f]{64}$')
CHECK = re.compile(r'^[a-z0-9][a-z0-9._-]{0,63}$')
REQUEST_KEYS = {'commit', 'check', 'command', 'exit_code', 'output_sha256', 'change_id', 'inputs'}
INPUT_KEYS = {'flake_lock_sha256', 'toolchain_sha256', 'wrapper_sha256', 'system', 'attempt'}
# The record's inputs grow over time (the repository policy names the ones a check must carry).
EXTRA_INPUT = re.compile(r'^[a-z][a-z0-9_]{0,39}$')


class Refused(Exception):
    pass


def git(repo, *args, stdin=None, env=None):
    done = subprocess.run(['git', '-C', str(repo), *args], input=stdin, capture_output=True, timeout=300,
                          env=dict(os.environ, GIT_NO_REPLACE_OBJECTS='1', GIT_TERMINAL_PROMPT='0', LC_ALL='C', **(env or {})))
    if done.returncode != 0:
        raise Refused(f'git {args[0]} failed: {done.stderr.decode(errors="replace").strip()[-500:]}')
    return done.stdout


def validate(request):
    if not isinstance(request, dict) or set(request) != REQUEST_KEYS:
        raise Refused('request must have exactly: ' + ', '.join(sorted(REQUEST_KEYS)))
    if not OID.match(str(request['commit'])):
        raise Refused('commit must be a full object id')
    if not CHECK.match(str(request['check'])):
        raise Refused('check name must be lowercase letters, digits, dot, dash or underscore')
    command = request['command']
    if not (isinstance(command, list) and command and all(isinstance(a, str) for a in command) and command[0]):
        raise Refused('command must be a nonempty argument vector')
    if type(request['exit_code']) is not int:
        raise Refused('exit_code must be an integer')
    if not SHA256.match(str(request['output_sha256'])):
        raise Refused('output_sha256 must be 64 lowercase hex digits')
    if not (isinstance(request['change_id'], str) and request['change_id'].strip() and len(request['change_id']) < 200):
        raise Refused('change_id must be a short nonempty string')
    inputs = request['inputs']
    if not (isinstance(inputs, dict) and INPUT_KEYS <= set(inputs) and len(inputs) <= 40
            and all(isinstance(v, str) and 0 < len(v) <= 500 for v in inputs.values())):
        raise Refused('inputs must be short nonempty strings and include: ' + ', '.join(sorted(INPUT_KEYS)))
    for name in set(inputs) - INPUT_KEYS:
        if not EXTRA_INPUT.match(name):
            raise Refused(f'input name {name!r} must be lowercase letters, digits and underscore')
    for key in ('flake_lock_sha256', 'toolchain_sha256', 'wrapper_sha256'):
        if not SHA256.match(inputs[key]):
            raise Refused(f'{key} must be 64 lowercase hex digits')
    if not re.fullmatch(r'[1-9][0-9]{0,3}', inputs['attempt']):
        raise Refused('attempt must be a small positive integer')


def main():
    config = json.loads((Path.home() / '.config/st/evidence-sign.json').read_text())
    if set(config) != {'signer', 'ssh_key', 'scratch_repo'}:
        raise Refused('configuration must have exactly signer, ssh_key, scratch_repo')
    signer, key, scratch = config['signer'], Path(config['ssh_key']), Path(config['scratch_repo'])
    if not (re.fullmatch(r'\S+', signer) and key.is_absolute() and scratch.is_absolute()):
        raise Refused('invalid signer configuration')
    request = json.load(sys.stdin)
    validate(request)

    checkout = Path.cwd()
    commit = request['commit']
    if git(checkout, 'cat-file', '-t', commit).decode().strip() != 'commit':
        raise Refused('commit is not a commit in the caller\'s checkout')
    tree = git(checkout, 'rev-parse', f'{commit}^{{tree}}').decode().strip()
    lock = git(checkout, 'show', f'{commit}:flake.lock')
    if hashlib.sha256(lock).hexdigest() != request['inputs']['flake_lock_sha256']:
        raise Refused('flake_lock_sha256 does not match flake.lock in the commit')

    if not scratch.exists():
        subprocess.run(['git', 'init', '--quiet', '--bare', str(scratch)], check=True)
    git(scratch, 'fetch', '--quiet', '--no-tags', str(checkout), commit)

    body = {
        '_type': 'https://in-toto.io/Statement/v1',
        'subject': [{'name': commit, 'digest': {'gitTree': tree}}],
        'predicateType': 'https://smalltalk.dev/evidence/gate/v1',
        'predicate': {
            'schema_version': 1, 'change_id': request['change_id'], 'signer': signer, 'tier': 'full',
            're_attests': None,
            'producer_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
            'observed_at': os.environ.get('EVIDENCE_SIGN_NOW') or datetime.now(timezone.utc).strftime('%Y-%m-%dT%H:%M:%SZ'),
            'observed': {
                'kind': 'tests', 'runner': 'wrapper',
                'checks': {request['check']: {'command': request['command'], 'exit_code': request['exit_code'],
                                              'output_sha256': request['output_sha256']}},
                'inputs': dict(sorted(request['inputs'].items())),
            },
        },
    }
    blob = git(scratch, 'hash-object', '-w', '--stdin', stdin=json.dumps(body).encode()).decode().strip()
    notes = git(scratch, 'mktree', stdin=f'100644 blob {blob}\t{tree}\n'.encode()).decode().strip()
    record = git(scratch, '-c', 'user.name=Evidence signer', '-c', 'user.email=signer@example.invalid',
                 '-c', 'gpg.format=ssh', '-c', f'user.signingKey={key}',
                 'commit-tree', '-S', notes, '-p', commit, stdin=b'st gate observation v1\n').decode().strip()
    objects = f'{commit}\n'.encode() + git(scratch, 'rev-list', '--objects', '--no-object-names', tree)
    objects += f'{record}\n'.encode() + git(scratch, 'rev-list', '--objects', '--no-object-names', f'{record}^{{tree}}')
    pack = git(scratch, 'pack-objects', '--stdout', stdin=objects)
    print(json.dumps({'record': record, 'tier': 'full', 'tree': tree, 'commit': commit,
                      'object_pack_base64': base64.b64encode(pack).decode()}))


if __name__ == '__main__':
    try:
        main()
    except (Refused, OSError, ValueError, subprocess.SubprocessError) as error:
        print(f'evidence-sign refused: {error}', file=sys.stderr)
        sys.exit(1)
