#!/usr/bin/env python3
"""Check every generated PR job refuses drafts, including failure collectors."""
import ast
from pathlib import Path
import re

ROOT = Path(__file__).resolve().parent.parent
GUARD = "(github.event_name != 'pull_request' || github.event.pull_request.draft == false)"
count = 0
for path in sorted((ROOT / '.github/workflows').glob('*.yml')):
    workflow = path.read_text()
    triggers = workflow.split('\njobs:', 1)[0]
    if not re.search(r'^  pull_request:', triggers, re.M):
        continue
    for event in ('ready_for_review', 'converted_to_draft'):
        assert event in triggers, (path.name, event)
    blocks = re.findall(r'(?ms)^  ([\w-]+):\n(.*?)(?=^  [\w-]+:\n|\Z)', workflow.split('\njobs:\n', 1)[1])
    for name, block in blocks:
        match = re.search(r'^    if: (.+)$', block, re.M)
        assert match, (path.name, name, 'unguarded job allocates draft runner')
        raw = match[1]
        condition = ast.literal_eval(raw) if raw.startswith(('"', "'")) else raw
        expression = condition.removeprefix('${{ ').removesuffix(' }}')
        prefix = GUARD + ' && ('
        assert expression.startswith(prefix) and expression.endswith(')'), (path.name, name, condition)
        # Evaluate the generated guard with both outcomes of the existing condition.
        # This includes always() collectors, failed scope admission and labelled workloads.
        actual = expression[:len(prefix)] + 'prior_condition)'
        actual = actual.replace('github.event_name', 'event').replace('github.event.pull_request.draft', 'draft').replace('false', 'False').replace('&&', ' and ').replace('||', ' or ')
        for event in ('pull_request', 'merge_group', 'workflow_dispatch', 'push', 'schedule'):
            for draft in (True, False, None):
                for prior_condition in (True, False):
                    result = eval(actual, {'__builtins__': {}}, locals())
                    assert result == (prior_condition and (event != 'pull_request' or draft is False)), (path.name, name, event, draft)
        if path.name == 'fleet.yml' and name == 'linux-gate':
            assert '(always())' in expression, 'dependency failures must still reach the gate on ready PRs'
        count += 1
    print('passed:', path.name, len(blocks), 'draft jobs suppressed; ready and converted-to-draft events included')
assert count >= 20, count
print('passed:', count, 'generated PR job conditions; absent draft identity fails closed')
