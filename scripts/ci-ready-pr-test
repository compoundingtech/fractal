#!/usr/bin/env python3
"""Check every generated job's origin admission, ready-PR guard and status predicates."""
import ast
from pathlib import Path
import re

ROOT = Path(__file__).resolve().parent.parent
GUARD = "(github.event_name != 'pull_request' || github.event.pull_request.draft == false)"
FORK_GUARD = "((github.event_name != 'pull_request' && github.event_name != 'pull_request_target') || github.event.pull_request.head.repo.full_name == github.repository)"
ORIGIN_GUARD = "(github.event_name != 'workflow_run' || github.event.workflow_run.head_repository.full_name == github.repository)"
OUTER_PREFIX = FORK_GUARD + ' && ' + ORIGIN_GUARD + ' && '
EVENTS = ('pull_request', 'pull_request_target', 'workflow_run', 'merge_group', 'workflow_dispatch', 'push', 'schedule')
REPOSITORY = 'compoundingtech/fractal'
IDENTITIES = (REPOSITORY, 'outside/fork', '', None)


def evaluate(expression, event, draft, pr_repository, run_repository, prior_condition):
    actual = expression
    for source, target in (
        ('github.event.pull_request.head.repo.full_name', 'pr_repository'),
        ('github.event.workflow_run.head_repository.full_name', 'run_repository'),
        ('github.event.pull_request.draft', 'draft'),
        ('github.event_name', 'event'),
        ('github.repository', 'repository'),
    ):
        actual = actual.replace(source, target)
    actual = actual.replace('false', 'False').replace('&&', ' and ').replace('||', ' or ')
    return eval(actual, {'__builtins__': {}}, {
        'event': event, 'draft': draft, 'pr_repository': pr_repository,
        'run_repository': run_repository, 'repository': REPOSITORY,
        'prior_condition': prior_condition,
    })


count = ready_count = always_count = cancellation_count = 0
self_hosted_pr_count = 0
for path in sorted((ROOT / '.github/workflows').glob('*.yml')):
    workflow = path.read_text()
    triggers, jobs = workflow.split('\njobs:\n', 1)
    has_pr = bool(re.search(r'^  pull_request:', triggers, re.M))
    if path.name == 'storybook-deploy.yml':
        assert triggers.split('\non:\n', 1)[1].split('\npermissions:', 1)[0] == '  push:\n    branches: [main]\n', 'Storybook must only trigger on pushes to main'
        assert 'pull_request' not in triggers and 'ready_for_review' not in workflow
        assert 'destroy' not in workflow and 'pr-' not in workflow
        assert "(github.event_name == 'push') && (github.ref == 'refs/heads/main')" in workflow
        assert 'ref: ${{ github.sha }}' in workflow and 'STAGE: main' in workflow
        assert '  cancel-in-progress: false\n' in workflow
        print('passed: Storybook deploy has only the main push trigger and no PR lifecycle or credentials path')
    if has_pr:
        for event in ('ready_for_review', 'converted_to_draft'):
            assert event in triggers, (path.name, event)
    blocks = re.findall(r'(?ms)^  ([\w-]+):\n(.*?)(?=^  [\w-]+:\n|\Z)', jobs)
    assert blocks, (path.name, 'no generated jobs checked')
    for name, block in blocks:
        match = re.search(r'^    if: (.+)$', block, re.M)
        assert match, (path.name, name, 'unguarded job allocates an untrusted runner')
        raw = match[1]
        condition = ast.literal_eval(raw) if raw.startswith(('"', "'")) else raw
        expression = condition.removeprefix('${{ ').removesuffix(' }}')
        assert expression.startswith(OUTER_PREFIX) and expression.endswith(')'), (path.name, name, condition)
        if has_pr:
            route = re.search(r'^    runs-on:(.*(?:\n      .*)*)', block, re.M)
            assert route, (path.name, name, 'missing runner route')
            # Only a literal hosted label is exempt. Expressions, matrices and
            # label arrays may select self-hosted capacity and must fail closed.
            hosted_only = re.fullmatch(r"\s*['\"]?(?:ubuntu|windows|macos)-[\w.-]+['\"]?\s*", route[1])
            if not hosted_only:
                assert expression.startswith(FORK_GUARD + ' && '), (
                    path.name, name, 'self-hosted pull_request job lacks same-repository guard',
                )
                self_hosted_pr_count += 1
        predicate = expression[len(OUTER_PREFIX):]
        # Substitute only the original predicate: exercise the actual generated
        # admission envelope on every job, even workflows without PR triggers.
        admission = expression[:len(OUTER_PREFIX)] + 'prior_condition'
        for event in EVENTS:
            for pr_repository in IDENTITIES:
                for run_repository in IDENTITIES:
                    for prior_condition in (True, False):
                        expected = (
                            prior_condition
                            and (event not in ('pull_request', 'pull_request_target') or pr_repository == REPOSITORY)
                            and (event != 'workflow_run' or run_repository == REPOSITORY)
                        )
                        result = evaluate(admission, event, None, pr_repository, run_repository, prior_condition)
                        assert result == expected, (path.name, name, event, pr_repository, run_repository, prior_condition)
        count += 1
        main_push = "(github.event_name == 'push') && (github.ref == 'refs/heads/main')"
        if has_pr and predicate.startswith(main_push):
            # Positively main-push-only jobs cannot allocate any PR runner.
            assert predicate == main_push or predicate.startswith(main_push + ' && '), (path.name, name, predicate)
            assert '||' not in predicate and '?' not in predicate, (path.name, name, predicate)
        elif has_pr:
            prefix = GUARD + ' && ('
            assert predicate.startswith(prefix) and predicate.endswith(')'), (path.name, name, predicate)
            ready = expression[:len(OUTER_PREFIX) + len(prefix)] + 'prior_condition)'
            for event in EVENTS:
                for draft in (True, False, None):
                    for pr_repository in IDENTITIES:
                        for prior_condition in (True, False):
                            expected = (
                                prior_condition
                                and (event not in ('pull_request', 'pull_request_target') or pr_repository == REPOSITORY)
                                and (event != 'pull_request' or draft is False)
                            )
                            result = evaluate(ready, event, draft, pr_repository, REPOSITORY, prior_condition)
                            assert result == expected, (path.name, name, event, draft, pr_repository, prior_condition)
            ready_count += 1
        always_count += int('always()' in predicate)
        cancellation_count += int('!cancelled()' in predicate)
        if path.name == 'fleet.yml' and name == 'linux-gate':
            assert '(always())' in predicate, 'dependency failures must still reach the gate on ready PRs'
        if path.name == 'macos.yml' and name == 'fractal-mac-execution':
            assert '!cancelled()' in predicate, 'failed dependencies must not implicitly skip the Mac consumer'
        if (path.name, name) in (('fleet.yml', 'linux-gate'), ('macos.yml', 'fractal-mac-execution')):
            # Evaluate the real generated status predicates, not just an abstract
            # prior-condition value. These must still run after dependency failure.
            for status in ('success', 'failure', 'cancelled'):
                for draft in (True, False, None):
                    for pr_repository in IDENTITIES:
                        for original_allows in (True, False):
                            actual = expression.replace('always()', 'True')
                            actual = actual.replace('!cancelled()', repr(status != 'cancelled'))
                            actual = actual.replace("needs.fractal-mac-changes.result == 'success'", repr(original_allows))
                            actual = actual.replace("needs.fractal-mac-changes.outputs.relevant == 'true'", 'True')
                            expected = pr_repository == REPOSITORY and draft is False
                            if name == 'fractal-mac-execution':
                                expected = expected and status != 'cancelled' and original_allows
                            result = evaluate(actual, 'pull_request', draft, pr_repository, REPOSITORY, original_allows)
                            assert result == expected, (path.name, name, status, draft, pr_repository, original_allows)
    print('passed:', path.name, len(blocks), 'jobs enforce same-repository PR and workflow-run admission')
assert ready_count >= 20, ready_count
assert count >= ready_count, (count, ready_count)
assert always_count and cancellation_count, (always_count, cancellation_count)
assert self_hosted_pr_count > 0, 'no self-hosted pull_request jobs checked'
print('passed:', self_hosted_pr_count, 'potentially self-hosted pull_request jobs require the same-repository guard')
print('passed:', count, 'generated job origin guards;', ready_count, 'ready-PR guards; missing identities fail closed')
