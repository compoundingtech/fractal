#!/usr/bin/env bash
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
set -Eeuo pipefail

# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
: "${FRACTAL_SOAK_TEST_REAL_ST3_BIN-${ST3_SOAK_TEST_REAL_ST3_BIN:?set the real installed st3 executable for this test}}"
if [[ ${1:-} == conversations && ${2:-} == send ]]; then
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
  "${FRACTAL_SOAK_TEST_REAL_ST3_BIN-${ST3_SOAK_TEST_REAL_ST3_BIN-}}" "$@" >/dev/null
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
  if [[ ${FRACTAL_SOAK_TEST_RESPONSE_MODE-${ST3_SOAK_TEST_RESPONSE_MODE:-lost}} == malformed ]]; then
    /usr/bin/printf '{incomplete-response\n'
    exit 0
  fi
  # Simulate a local client losing its response after an exact durable send.
  exit 124
fi
# arn:lmig:smalltalk:2026-10-16-env-fractal-dual-read
exec "${FRACTAL_SOAK_TEST_REAL_ST3_BIN-${ST3_SOAK_TEST_REAL_ST3_BIN-}}" "$@"
