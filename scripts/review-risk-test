#!/usr/bin/env python3
"""The deterministic risk floor of a review: each named rule fires on what it names, stays quiet on an ordinary change, and the level
is the highest of what fired."""
import json
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest
sys.dont_write_bytecode = True

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent


class ReviewRisk(unittest.TestCase):
    def setUp(self):
        self.temporary = tempfile.TemporaryDirectory(prefix="review-risk-")
        self.addCleanup(self.temporary.cleanup)
        self.repo = Path(self.temporary.name)
        self.git("init", "-q", "-b", "main")
        self.git("config", "user.email", "t@example.com")
        self.git("config", "user.name", "t")
        (self.repo / ".st").mkdir()
        for name in ("risky-classes.json", "review-risk.json"):
            (self.repo / ".st" / name).write_text((ROOT / ".st" / name).read_text())
        self.write("scripts/classify-risk", (ROOT / "scripts" / "classify-risk").read_text())
        self.write("crates/fractal-store/src/store/plain.rs", "fn a() {}\n")
        self.write("crates/fractal-api-core/src/api/routes.rs", "pub fn route() {}\npub struct Reply;\n")
        self.write("docs/readme.md", "x\n")
        self.git("add", "-A")
        self.git("commit", "-q", "-m", "start")
        self.git("checkout", "-q", "-b", "change")

    def git(self, *args):
        return subprocess.run(["git", *args], cwd=self.repo, text=True, capture_output=True, check=True).stdout

    def write(self, path, text):
        (self.repo / path).parent.mkdir(parents=True, exist_ok=True)
        (self.repo / path).write_text(text)

    def risk(self):
        self.git("add", "-A")
        self.git("commit", "-q", "-m", "change")
        done = subprocess.run([sys.executable, str(HERE / "review-risk"), "main", "change", "--repo", str(self.repo)],
                              text=True, capture_output=True, check=True)
        return json.loads(done.stdout)

    def rules(self, result):
        return {reason["rule"]: reason["level"] for reason in result["reasons"]}

    def test_documentation_and_release_notes_only_are_low(self):
        self.write("docs/readme.md", "y\n")
        self.write("release-notes/x.json", "{}\n")
        result = self.risk()
        self.assertEqual(result["level"], "low")
        self.assertEqual(self.rules(result), {"release-notes": "low"})

    def test_an_ordinary_change_to_a_store_file_is_low_and_a_table_in_it_is_high(self):
        self.write("crates/fractal-store/src/store/plain.rs", "fn a() { let x = 1; }\n")
        self.assertEqual(self.risk()["level"], "low")
        self.write("crates/fractal-store/src/store/plain.rs", 'fn a() { exec("CREATE TABLE t (id)"); }\n')
        result = self.risk()
        self.assertEqual(result["level"], "high")
        self.assertEqual(self.rules(result)["schema"], "high")

    def test_deleting_data_is_high_in_source_and_ignored_in_tests(self):
        self.write("crates/fractal-store/src/store/plain_tests.rs", 'fn t() { exec("DELETE FROM t"); }\n')
        self.assertEqual(self.risk()["level"], "low")
        self.write("crates/fractal-store/src/store/plain.rs", 'fn a() { exec("DELETE FROM claims"); }\n')
        result = self.risk()
        self.assertEqual(self.rules(result)["data-deletion"], "high")
        self.assertEqual(result["level"], "high")

    def test_removing_a_public_item_of_a_contract_is_high_and_adding_one_is_medium(self):
        self.write("crates/fractal-api-core/src/api/routes.rs", "pub fn route() {}\npub struct Reply;\npub fn another() {}\n")
        result = self.risk()
        self.assertEqual(result["level"], "medium")
        self.assertEqual(self.rules(result), {"protocol": "medium"})
        self.write("crates/fractal-api-core/src/api/routes.rs", "pub fn route() {}\n")
        result = self.risk()
        self.assertEqual(result["level"], "high")
        self.assertEqual(self.rules(result)["breaking-public-contract"], "high")

    def test_the_signing_and_skip_machinery_and_workflows_are_medium(self):
        self.write("scripts/st-test", "#!/bin/sh\n")
        self.write(".github/workflows/x.yml", "name: x\n")
        result = self.risk()
        self.assertEqual(result["level"], "medium")
        self.assertEqual(self.rules(result)["skip-and-signing-machinery"], "medium")
        self.assertEqual(self.rules(result)["workflows"], "medium")

    def test_the_canonical_runner_keeps_the_signing_machinery_risk_floor(self):
        self.write("scripts/fractal-test", "#!/bin/sh\n")
        result = self.risk()
        self.assertEqual(result["level"], "medium")
        self.assertEqual(self.rules(result)["skip-and-signing-machinery"], "medium")

    def test_a_policy_file_under_st_is_medium_but_trusted_keys_in_source_are_high(self):
        self.write(".st/crate-cut.json", "{}\n")
        result = self.risk()
        self.assertEqual(result["level"], "medium")
        self.assertEqual(self.rules(result)["authorization"], "medium")
        self.write("crates/fractal-api-core/src/api/client_v0_x.rs", "fn a() { let trusted_keys = 1; }\n")
        result = self.risk()
        self.assertEqual(self.rules(result)["authorization"], "high")
        self.assertEqual(result["level"], "high")

    def test_private_key_material_is_high_outside_tests_and_docs(self):
        self.write("config/leaked", "-----BEGIN OPENSSH PRIVATE KEY-----\n")
        self.assertEqual(self.rules(self.risk())["private-key-material"], "high")

    def test_a_large_change_is_at_least_medium(self):
        self.write("docs/big.md", "line\n" * 1600)
        result = self.risk()
        self.assertEqual(result["level"], "medium")
        self.assertEqual(self.rules(result), {"large-change": "medium"})

    def test_the_level_is_the_highest_reason(self):
        self.write("scripts/st-test", "#!/bin/sh\n")
        self.write("crates/fractal-store/src/store/plain.rs", 'fn a() { exec("DROP TABLE t"); }\n')
        self.assertEqual(self.risk()["level"], "high")

    def test_trust_files_in_st_are_high_and_the_other_st_files_stay_medium(self):
        for name in (".st/evidence-keys", ".st/evidence-log-key", ".st/evidence-authors.json", ".st/evidence-skip-policy.json",
                     ".st/evidence-policy.json", ".st/required-lanes.json", ".st/review-risk.json", ".st/risky-classes.json",
                     ".st/review-verdict.schema.json", ".st/review-harness.json",
                     "scripts/review-risk", "scripts/review-validate", "scripts/classify-risk", "scripts/review"):
            with self.subTest(name):
                self.git("checkout", "-q", "-B", "change", "main")
                self.write(name, "x\n")
                result = self.risk()
                self.assertEqual(result["level"], "high", result)
                self.assertEqual(self.rules(result)["trust-files"], "high")
        for name in (".st/crate-cut.json", ".st/module-layers.json", ".st/rust-test-inputs.json", ".st/evidence-retention.json"):
            with self.subTest(name):
                self.git("checkout", "-q", "-B", "change", "main")
                self.write(name, "x\n")
                result = self.risk()
                self.assertEqual(result["level"], "medium", result)
                self.assertNotIn("trust-files", self.rules(result))

    def test_the_rules_come_from_the_base_so_a_head_cannot_lower_its_own_floor(self):
        rules = json.loads((self.repo / ".st/review-risk.json").read_text())
        for rule in rules["rules"]:
            if rule["name"] == "data-deletion":
                rule["level"] = "low"
        rules["classes"]["schema"] = "low"
        self.write(".st/review-risk.json", json.dumps(rules))
        self.write("crates/fractal-store/src/store/plain.rs", 'fn a() { exec("DROP TABLE t"); }\n')
        result = self.risk()
        self.assertEqual(self.rules(result)["data-deletion"], "high")
        self.assertEqual(self.rules(result)["trust-files"], "high")
        self.assertEqual(result["level"], "high")

    def test_the_engine_comes_from_the_base_too(self):
        self.write("scripts/classify-risk", "RULES = '.st/risky-classes.json'\ndef classify(*a):\n    return []\ndef matches(*a):\n    return False\n")
        self.write("crates/fractal-store/src/store/plain.rs", 'fn a() { exec("DROP TABLE t"); }\n')
        self.assertEqual(self.rules(self.risk())["data-deletion"], "high")

    def test_a_base_without_the_rules_fails_unless_the_checkout_is_trusted(self):
        scratch = tempfile.TemporaryDirectory(prefix="review-risk-bootstrap-")
        self.addCleanup(scratch.cleanup)
        other = Path(scratch.name)
        run = lambda *args: subprocess.run(["git", *args], cwd=other, text=True, capture_output=True, check=True)
        run("init", "-q", "-b", "main")
        run("config", "user.email", "t@example.com")
        run("config", "user.name", "t")
        (other / "readme").write_text("x\n")
        run("add", "-A")
        run("commit", "-q", "-m", "start")
        run("checkout", "-q", "-b", "change")
        for path in (".st/review-risk.json", ".st/risky-classes.json", "scripts/classify-risk"):
            (other / path).parent.mkdir(parents=True, exist_ok=True)
            (other / path).write_text((ROOT / path).read_text())
        run("add", "-A")
        run("commit", "-q", "-m", "introduce the rules")
        command = [sys.executable, str(HERE / "review-risk"), "main", "change", "--repo", str(other)]
        done = subprocess.run(command, text=True, capture_output=True)
        self.assertNotEqual(done.returncode, 0)
        self.assertIn("holds no", done.stderr)
        done = subprocess.run([*command, "--rules-from-checkout"], text=True, capture_output=True)
        self.assertEqual(done.returncode, 0, done.stderr)
        self.assertEqual(json.loads(done.stdout)["level"], "high")

    def test_a_changed_line_that_starts_like_a_file_header_is_still_read(self):
        self.write("crates/fractal-store/src/store/plain.rs", "fn a() {}\n++ DROP TABLE t\n")
        self.assertEqual(self.rules(self.risk())["data-deletion"], "high")

    def on_main(self, files):
        """Commit FILES on main and start a fresh change branch from it."""
        self.git("checkout", "-q", "main")
        for path, text in files.items():
            self.write(path, text)
        self.git("add", "-A")
        self.git("commit", "-q", "-m", "main moves")
        self.git("checkout", "-q", "-B", "change", "main")

    def test_a_rename_scores_the_old_path_too(self):
        self.on_main({".st/evidence-keys": "key\n"})
        self.git("mv", ".st/evidence-keys", "docs/moved-keys")
        result = self.risk()
        self.assertEqual(self.rules(result)["trust-files"], "high")
        self.assertEqual(result["level"], "high")

    def test_non_ascii_and_spaced_paths_are_scored_by_path_and_by_content(self):
        self.on_main({"crates/fractal-wire/src/caf\u00e9.rs": "pub fn f() {}\n"})
        self.write("crates/fractal-store/src/store/\u00e9t\u00e9 plain.rs", 'fn a() { exec("DROP TABLE t"); }\n')
        (self.repo / "crates/fractal-wire/src/caf\u00e9.rs").write_text("")
        result = self.risk()
        self.assertEqual(self.rules(result)["data-deletion"], "high")
        self.assertEqual(self.rules(result)["breaking-public-contract"], "high")

    def test_a_risky_class_the_rules_do_not_map_scores_high(self):
        rules = json.loads((self.repo / ".st/review-risk.json").read_text())
        del rules["classes"]["release-notes"]
        self.on_main({".st/review-risk.json": json.dumps(rules)})
        self.write("release-notes/x.json", "{}\n")
        result = self.risk()
        self.assertEqual(self.rules(result)["release-notes"], "high")
        self.assertEqual(result["level"], "high")
        self.assertTrue(any("no level for this class" in line for reason in result["reasons"] for line in reason["lines"]))

    def test_the_checkout_rules_flag_is_refused_when_the_base_holds_the_rules(self):
        self.write("docs/readme.md", "z\n")
        self.git("add", "-A")
        self.git("commit", "-q", "-m", "z")
        done = subprocess.run([sys.executable, str(HERE / "review-risk"), "main", "change", "--repo", str(self.repo), "--rules-from-checkout"],
                              text=True, capture_output=True)
        self.assertNotEqual(done.returncode, 0)
        self.assertIn("holds .st/review-risk.json", done.stderr)


if __name__ == "__main__":
    unittest.main()
