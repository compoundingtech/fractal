#!/usr/bin/env python3
"""Exercise cancellation scope and readiness races without GitHub or PR execution."""
import copy
import importlib.machinery
import importlib.util
from pathlib import Path
import re
import sys

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
loader = importlib.machinery.SourceFileLoader('admission', str(ROOT / 'scripts/ci-draft-admission'))
spec = importlib.util.spec_from_loader(loader.name, loader)
m = importlib.util.module_from_spec(spec)
loader.exec_module(m)
REPO, ID = 'example/project', 123
RUN = {'id': ID, 'repository': {'full_name': REPO}, 'name': 'Workspace CI',
       'event': 'pull_request', 'status': 'queued', 'head_sha': 'a' * 40,
       'head_branch': 'old-stacked-branch', 'pull_requests': [{'number': 7}],
       'head_repository': {'full_name': REPO, 'owner': {'login': 'example'}}}
PR = {'number': 7, 'state': 'open', 'draft': True,
      'base': {'repo': {'full_name': REPO}},
      'head': {'ref': RUN['head_branch'], 'sha': RUN['head_sha'], 'repo': {'full_name': REPO}}}


class API:
    def __init__(self, run=None, prs=None, change=None):
        self.run = copy.deepcopy(run or RUN)
        self.prs = copy.deepcopy(prs or {7: PR})
        self.calls, self.posts, self.reads, self.change = [], [], {}, change

    def __call__(self, path, method='GET'):
        self.calls.append((method, path))
        self.reads[path] = self.reads.get(path, 0) + 1
        if self.change:
            self.change(self, path, method, self.reads[path])
        if method == 'POST':
            self.posts.append(path)
            assert path == f'repos/{REPO}/actions/runs/{ID}/cancel'
            return None
        if path == f'repos/{REPO}/actions/runs/{ID}':
            return copy.deepcopy(self.run)
        if path.startswith(f'repos/{REPO}/pulls?'):
            assert 'state=open&head=' in path and 'per_page=100' in path
            return list(copy.deepcopy(self.prs).values())
        return copy.deepcopy(self.prs[int(path.rsplit('/', 1)[1])])


for name in m.WORKFLOWS:
    api = API({**RUN, 'name': name})
    result = m.cancel_draft(api, REPO, ID)
    assert result['decision'] == 'cancel-request-accepted' and len(api.posts) == 1
    assert 'not terminal' in result['closure']
print('passed: every registered PR workflow, including legacy stacked-branch runs, requests only its own cancellation')

for change, reason in [
    ({'event': 'merge_group'}, 'not-a-watched-pr-run'),
    ({'event': 'push'}, 'not-a-watched-pr-run'),
    ({'event': 'workflow_dispatch'}, 'not-a-watched-pr-run'),
    ({'name': 'Draft CI admission'}, 'not-a-watched-pr-run'),
    ({'status': 'completed'}, 'already-completed'),
]:
    api = API({**RUN, **change})
    assert m.cancel_draft(api, REPO, ID)['decision'] == reason and not api.posts
for pr in [{**PR, 'draft': False}, {**PR, 'state': 'closed'}]:
    api = API(prs={7: pr})
    assert m.cancel_draft(api, REPO, ID)['decision'] == 'no-open-draft-only-association' and not api.posts
print('passed: ready/closed PRs, merge groups, main/manual runs and the observer itself are preserved')

for value in [None, 'true', 1]:
    api = API(prs={7: {**PR, 'draft': value}})
    try:
        m.cancel_draft(api, REPO, ID)
        raise AssertionError('unqualified draft state was accepted')
    except ValueError:
        assert not api.posts
for field, value in [('id', ID + 1), ('repository', {'full_name': 'other/project'}), ('head_sha', ''), ('head_branch', ''), ('status', None)]:
    api = API({**RUN, field: value})
    try:
        m.cancel_draft(api, REPO, ID)
        raise AssertionError('wrong run/source identity was accepted')
    except ValueError:
        assert not api.posts
print('passed: malformed draft and wrong repository/run/source evidence never cancel')

def becomes_ready(api, path, method, count):
    if path.endswith('/pulls/7') and count == 2:
        api.prs[7]['draft'] = False
api = API(change=becomes_ready)
assert m.cancel_draft(api, REPO, ID)['decision'] == 'association-or-readiness-changed' and not api.posts

def completes(api, path, method, count):
    if path.endswith('/runs/123') and count == 2:
        api.run['status'] = 'completed'
api = API(change=completes)
assert m.cancel_draft(api, REPO, ID)['decision'] == 'completed-before-request' and not api.posts

def changes_association(api, path, method, count):
    if path.endswith('/runs/123') and count == 2:
        api.run['pull_requests'] = [{'number': 8}]
api = API(change=changes_association)
assert m.cancel_draft(api, REPO, ID)['decision'] == 'association-or-readiness-changed' and not api.posts
print('passed: current readiness, completed target and changed association races preserve the run')

# An omitted fork link must use both source repository and branch. Another PR on
# the same branch name cannot be used to cancel this run.
fork = {**RUN, 'pull_requests': [], 'head_repository': {'full_name': 'forker/project', 'owner': {'login': 'forker'}}}
fork_pr = copy.deepcopy(PR)
fork_pr['head']['repo']['full_name'] = 'forker/project'
api = API(fork, {7: fork_pr, 8: {**PR, 'number': 8, 'draft': False}})
assert m.cancel_draft(api, REPO, ID)['decision'] == 'cancel-request-accepted' and len(api.posts) == 1
assert any('head=forker%3Aold-stacked-branch' in path for _, path in api.calls)
api = API({**RUN, 'pull_requests': [{'number': 7}, {'number': 8}]},
          {7: PR, 8: {**PR, 'number': 8, 'draft': False}})
assert m.cancel_draft(api, REPO, ID)['decision'] == 'no-open-draft-only-association' and not api.posts
print('passed: omitted fork links resolve exact source, while any associated ready PR prevents cancellation')

# A direct link must also match the source repository, not just a branch name.
other_source = copy.deepcopy(PR)
other_source['head']['repo']['full_name'] = 'other/project'
for run, pr in [(RUN, other_source), ({**RUN, 'head_repository': None}, PR)]:
    api = API(run, {7: pr})
    try:
        m.cancel_draft(api, REPO, ID)
        raise AssertionError('unqualified source repository was accepted')
    except ValueError:
        assert not api.posts
api = API(prs={7: {**PR, 'head': {**PR['head'], 'sha': 'b' * 40}}})
assert m.cancel_draft(api, REPO, ID)['decision'] == 'cancel-request-accepted'
print('passed: direct links qualify the source repository; an older run of the same still-draft PR is cancelled')

def fails(api, path, method, count):
    if path.endswith('/pulls/7'):
        raise RuntimeError('metadata API failed')
api = API(change=fails)
try:
    m.cancel_draft(api, REPO, ID)
    raise AssertionError('failed metadata lookup was ignored')
except RuntimeError:
    assert not api.posts

workflow = (ROOT / '.github/workflows/draft-ci-admission.yml').read_text()
assert 'workflow_run:' in workflow and 'types: [requested]' in workflow
assert 'pull_request_target:' not in workflow and 'pull_request:' not in workflow
assert "github.event.workflow_run.event == 'pull_request'" in workflow
assert 'actions: write' in workflow and 'pull-requests: read' in workflow
assert 'actions/checkout' not in workflow and 'download-artifact' not in workflow
assert 'Draft CI admission' not in workflow.split('workflows:', 1)[1].split('types:', 1)[0]
for candidate in (ROOT / '.github/workflows').glob('*.yml'):
    text = candidate.read_text()
    if re.search(r'^  pull_request:', text.split('\njobs:', 1)[0], re.M):
        name = re.search(r'^name: (.+)$', text, re.M)[1].strip("\"'")
        if candidate.name == 'storybook-deploy.yml':
            # Draft transitions must not interrupt an Alchemy apply or destroy.
            assert name == 'Storybook deploy' and name not in m.WORKFLOWS
            assert '      - ' + name not in workflow
            assert '  cancel-in-progress: false\n' in text
            continue
        assert name in m.WORKFLOWS and '      - ' + name in workflow, (candidate, 'PR workflow not observed')
script = workflow.split("python3 - <<'DRAFT_ADMISSION_PY'\n", 1)[1].split('\n          DRAFT_ADMISSION_PY', 1)[0]
assert '\n'.join(line[10:] for line in script.splitlines()).rstrip('\n') == (ROOT / 'scripts/ci-draft-admission').read_text().rstrip('\n')
print('passed: lookup errors never cancel; generated main-only metadata observer matches the reviewed helper and cannot recurse')
