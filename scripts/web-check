#!/usr/bin/env python3
"""Reuse warm shell/type state; admit cold shell realization before building."""
import argparse
import fcntl
import hashlib
import os
from pathlib import Path
import shutil
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
CACHE = Path(os.environ.get("XDG_CACHE_HOME", str(Path.home() / ".cache"))) / "fractal-web-check/v1"
LOCAL = ROOT / ".devenv/web-check"
PROJECTS = ("apps/fractal-web", "packages/fractal-ui")


def digest(paths):
    value = hashlib.sha256()
    for path in sorted(paths):
        value.update(str(path.relative_to(ROOT)).encode() + b"\0" + path.read_bytes() + b"\0")
    return value.hexdigest()


def shell_dir():
    # Hash all tracked Nix definitions, not a worktree path or Git commit. Include
    # the lock so changed input graphs never reuse an old environment.
    tracked = subprocess.check_output(["git", "ls-files", "-z", "*.nix", "flake.lock"], cwd=ROOT).decode().split("\0")
    return CACHE / "shells" / digest([ROOT / name for name in tracked if name])


def seed_dir():
    return CACHE / "types" / digest([ROOT / "pnpm-lock.yaml", *(ROOT / project / "tsconfig.json" for project in PROJECTS)])


def call(argv, **kwargs):
    return subprocess.run(argv, cwd=ROOT, check=True, **kwargs)


def shell_command(directory, command):
    # A rooted store profile, never the flake: no evaluation/build/substitution
    # can escape the admitted job's memory cap on the hot path.
    return ["nix", "develop", str(directory / "profile"), "--offline", "--option", "substitute", "false", "--option", "max-jobs", "0", "--option", "builders", "", "-c", *command]


def atomic_copy(source, destination):
    destination.parent.mkdir(parents=True, exist_ok=True)
    temporary = destination.with_name(destination.name + f".{os.getpid()}.tmp")
    shutil.copyfile(source, temporary)
    temporary.replace(destination)


def realize():
    directory = shell_dir()
    directory.mkdir(parents=True, exist_ok=True)
    # Serialize all cache keys, not just callers preparing the same shell.
    with (CACHE / "realize.lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if not (directory / "profile").exists():
            call(["nix", "develop", ".#web", "--profile", str(directory / "profile"), "--option", "builders", "", "--option", "max-jobs", "1", "-c", "true"])


def prepare():
    directory = shell_dir()
    if not (directory / "profile").exists():
        raise RuntimeError("Shared shell is cold; use `python3 scripts/web-check check FILE...` to realize it inside a gate slot")
    # Ungated preparation only opens a rooted profile offline with local and
    # remote builds and substitution disabled (including an incomplete closure).
    gc = ROOT / ".devenv/gc"
    gc.mkdir(parents=True, exist_ok=True)
    link = gc / "devshell"
    if link.is_symlink():
        link.unlink()
    elif link.exists():
        raise RuntimeError(f"Refusing to replace non-symlink {link}")
    link.symlink_to(directory / "profile")
    if not (ROOT / "repos/effect-utils/package.json").exists():
        call(["mr", "apply", "--worktree-mode", "commit", "--only", "effect-utils"])
    call(shell_command(directory, ["pnpm", "install", "--frozen-lockfile"]))
    LOCAL.mkdir(parents=True, exist_ok=True)
    seeds = seed_dir()
    with (LOCAL / "lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        for index in range(len(PROJECTS)):
            name = f"{index}.tsbuildinfo"
            if not (LOCAL / name).exists() and (seeds / name).exists():
                atomic_copy(seeds / name, LOCAL / name)
                print(f"Seeded {PROJECTS[index]} incremental state", flush=True)
    print(f"Prepared shared shell {directory.name}", flush=True)


def run(files):
    directory = shell_dir()
    if not (directory / "profile").exists() or not (ROOT / "node_modules").exists():
        raise RuntimeError("Run `python3 scripts/web-check prepare` before requesting admission")
    LOCAL.mkdir(parents=True, exist_ok=True)
    with (LOCAL / "lock").open("w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        # Append compiler flags to the package scripts, retaining registry generation.
        commands = []
        for index, project in enumerate(PROJECTS):
            commands.append(["pnpm", "--dir", project, "typecheck", "--incremental", "--tsBuildInfoFile", str(LOCAL / f"{index}.tsbuildinfo")])
        commands.append(["pnpm", "--dir", "apps/fractal-web", "exec", "vitest", "run", *files])
        # All phases run even if one fails; a batch never conceals its failures.
        program = "import subprocess,sys; commands=" + repr(commands) + "; results=[subprocess.run(c).returncode for c in commands]; sys.exit(next((r for r in results if r),0))"
        result = subprocess.run(shell_command(directory, [sys.executable, "-c", program]), cwd=ROOT)
        if result.returncode == 0:
            seeds = seed_dir()
            seeds.mkdir(parents=True, exist_ok=True)
            with (seeds / "lock").open("w") as seed_lock:
                fcntl.flock(seed_lock, fcntl.LOCK_EX)
                for index in range(len(PROJECTS)):
                    name = f"{index}.tsbuildinfo"
                    atomic_copy(LOCAL / name, seeds / name)
        return result.returncode


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("prepare", "check", "run", "cold-run"))
    parser.add_argument("files", nargs="*", help="Explicit Vitest files relative to apps/fractal-web")
    args = parser.parse_args()
    if args.command != "prepare" and (not args.files or any(not name.endswith((".test.ts", ".test.tsx")) or name.startswith("-") for name in args.files)):
        parser.error("Name selected .test.ts/.test.tsx files; full suites are not supported")
    if args.command == "prepare":
        prepare()
    if args.command == "check":
        warm = (shell_dir() / "profile").exists()
        if warm:
            prepare()
        else:
            print("Shared shell is cold; requesting admission before realization", flush=True)
        return subprocess.run(["gate-slot", "--lane", "check", "--expect-short", "--max-wait", "300", "--", "nice", "-n", "19", "ionice", "-c3", "env", "CI=1", "NODE_OPTIONS=--max-old-space-size=3072", sys.executable, str(Path(__file__).resolve()), "run" if warm else "cold-run", *args.files], cwd=ROOT).returncode
    if args.command == "cold-run":
        realize()
        prepare()
    if args.command in ("run", "cold-run"):
        return run(args.files)
    return 0


if __name__ == "__main__":
    sys.exit(main())
