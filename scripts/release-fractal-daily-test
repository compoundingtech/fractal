#!/usr/bin/env python3
"""Exercise bounded release bodies, full-note assets and credential-safe command failures."""
import hashlib
import io
import json
import os
from pathlib import Path
import shutil
import subprocess
import sys
import tarfile
import tempfile

from release_notes import FIELDS

repo = Path(__file__).resolve().parent.parent
TARGETS = ('x86_64-unknown-linux-gnu', 'aarch64-apple-darwin')
TOKEN = 'ghs_' + 'A1b2C3d4' * 5

# A stand-in gh: just enough of the release flow to reach `release create`, which fails on request.
FAKE_GH = r'''#!/usr/bin/env python3
import json, os, pathlib, shutil, sys
args = sys.argv[1:]
if args[:2] == ['run', 'list']:
    print(json.dumps([{'databaseId': 7, 'headSha': os.environ['FAKE_SHA']}]))
elif args[0] == 'api' and '/actions/runs/' in args[1]:
    print(json.dumps([{'artifacts': [{'name': os.environ['FAKE_ARTIFACT'], 'expired': False}]}]))
elif args[0] == 'api' and args[-1] == 'repos/example/project/releases?per_page=100':
    print(json.dumps([[{'tag_name': 'v0.3.17', 'draft': False, 'prerelease': False,
                       'published_at': '2026-10-07T00:00:00Z', 'id': 17}]]))
elif args[:2] == ['run', 'download']:
    assert args[args.index('--name') + 1] == os.environ['FAKE_ARTIFACT'], args
    destination = pathlib.Path(args[args.index('--dir') + 1])
    for item in pathlib.Path(os.environ['FAKE_DIST']).iterdir():
        shutil.copy(item, destination / item.name)
elif args[:2] == ['release', 'create']:
    body_path = pathlib.Path(args[args.index('--notes-file') + 1])
    assets = args[args.index('--notes-file') + 2:]
    pathlib.Path(os.environ['FAKE_RECEIPT']).write_text(json.dumps({
        'body': body_path.read_text(),
        'assets': {pathlib.Path(asset).name: pathlib.Path(asset).read_text()
                   for asset in assets if asset.endswith('.md')},
    }))
    lines = os.environ['FAKE_FAILURE'].split('|')
    print('\n'.join(lines), file=sys.stderr)
    sys.exit(1)
else:
    print('unexpected gh call: %r' % args, file=sys.stderr); sys.exit(9)
'''

STUB_NOTES = '''class ImpactError(ValueError):
    pass

import os
import json
from pathlib import Path


def render(repo, previous, source, tag, repository='x/y', since=None):
    return (Path(os.environ['FAKE_NOTES']).read_text(),
            json.loads(Path(os.environ['FAKE_IMPACT']).read_text()))
'''
STUB_NOTES += '\nFIELDS = ' + repr(FIELDS) + '\n'


def sh(*cmd, cwd):
    print('fixture git stage: ' + json.dumps(cmd), file=sys.stderr, flush=True)
    try:
        return subprocess.run(cmd, cwd=cwd, check=True, text=True, capture_output=True).stdout.strip()
    except subprocess.CalledProcessError as error:
        error.add_note(f'fixture command stdout:\n{error.stdout}\nstderr:\n{error.stderr}')
        raise


def build_dist(dist, source):
    dist.mkdir()
    sums = []
    for target in TARGETS:
        for prefix in ('fractal', 'smalltalk'):
            package = f'{prefix}-{target}'
            with tarfile.open(dist / f'{package}.tar.gz', 'w:gz') as archive:
                def add(name, data=b'', mode=0o755, link=None):
                    info = tarfile.TarInfo(f'{package}/{name}')
                    info.mode = mode
                    if link:
                        info.type, info.linkname = tarfile.SYMTYPE, link
                        archive.addfile(info)
                    else:
                        info.size = len(data)
                        archive.addfile(info, io.BytesIO(data))
                add('BUILD.json', json.dumps({'source': source, 'target': target, 'pty_revision': 'pty', 'tag': ''}).encode(), 0o644)
                add('bin/fractal', b'fractal'); add('bin/pty', b'pty')
                add('share/fractal-web/index.html', b'web', 0o644)
                add('bin/st', link='fractal'); add('bin/st3', link='fractal')
                add('install.sh'); add('install-macos.py'); add('macos-installation.md', b'', 0o644)
            digest = hashlib.sha256((dist / f'{package}.tar.gz').read_bytes()).hexdigest()
            line = f'{digest}  {package}.tar.gz\n'
            (dist / f'{package}.tar.gz.sha256').write_text(line)
            sums.append(line)
    (dist / 'SHA256SUMS').write_text(''.join(sums))


with tempfile.TemporaryDirectory() as temporary:
    root = Path(temporary)
    checkout = root / 'checkout'
    (checkout / 'scripts').mkdir(parents=True)
    shutil.copy(repo / 'scripts/release-fractal-daily', checkout / 'scripts/release-fractal-daily')
    shutil.copy(repo / 'scripts/release-fractal-manifest.py', checkout / 'scripts/release-fractal-manifest.py')
    shutil.copy(repo / 'scripts/compat-baseline-release', checkout / 'scripts/compat-baseline-release')
    (checkout / '.github').mkdir()
    pin = {'commit': 'a' * 40, 'tag': 'v0.3.17', 'why': 'Previous stable release fixture',
           'exception_reason': None, 'bundles': {target: {
               'url': f'https://github.com/example/project/releases/download/v0.3.17/smalltalk-{target}.tar.gz',
               'sha256': 'b' * 64} for target in TARGETS}}
    for kind in ('fleet', 'messaging'):
        (checkout / f'.github/{kind}-compat-baseline.json').write_text(json.dumps(pin))
    (checkout / 'scripts/release_notes.py').write_text(STUB_NOTES)
    sh('git', 'init', '-q', '-b', 'main', cwd=checkout)
    # Fixture history must not depend on the account's interactive signing agent.
    sh('git', 'config', '--local', 'commit.gpgsign', 'false', cwd=checkout)
    sh('git', 'config', '--local', 'tag.gpgsign', 'false', cwd=checkout)
    sh('git', 'config', 'user.name', 'Fixture', cwd=checkout)
    sh('git', 'config', 'user.email', 'fixture@example.invalid', cwd=checkout)
    shas = []
    for index in range(2):
        (checkout / 'file').write_text(str(index))
        sh('git', 'add', '.', cwd=checkout)
        sh('git', 'commit', '-q', '-m', f'change {index}', cwd=checkout)
        shas.append(sh('git', 'rev-parse', 'HEAD', cwd=checkout))
        if index == 0:
            sh('git', 'tag', 'v0.3.17', cwd=checkout)
    tools = root / 'tools'
    tools.mkdir()
    (tools / 'gh').write_text(FAKE_GH)
    (tools / 'gh').chmod(0o755)
    build_dist(root / 'dist', shas[1])

    receipt = root / 'receipt.json'

    def daily(failure='', token=TOKEN, notes='notes\n', dry_run=False, impact=None, artifact='fractal-release'):
        receipt.unlink(missing_ok=True)
        (root / 'notes.md').write_text(notes)
        (root / 'impact.json').write_text(json.dumps(impact or {'fragments': [], 'change_links': {}}))
        env = dict(os.environ, PATH=f'{tools}:{os.environ["PATH"]}', GH_TOKEN=token, GH_REPO='example/project',
                   FAKE_SHA=shas[1], FAKE_DIST=str(root / 'dist'), FAKE_FAILURE=failure,
                   FAKE_NOTES=str(root / 'notes.md'), FAKE_RECEIPT=str(receipt),
                   FAKE_IMPACT=str(root / 'impact.json'), FAKE_ARTIFACT=artifact)
        args = ['python3', 'scripts/release-fractal-daily']
        return subprocess.run(args + (['--dry-run'] if dry_run else []), cwd=checkout, env=env,
                              text=True, capture_output=True, timeout=60)

    # Both current and pre-rename successful runs reach full checksum/source validation.
    for artifact in ('fractal-release', 'smalltalk-release'):
        done = daily(dry_run=True, artifact=artifact)
        assert done.returncode == 0 and 'Validated both release targets' in done.stdout, done
        assert 'would publish v0.3.18' in done.stdout, done

    # The Oct 10-11 shape: every earlier step passes, then gh release create fails with a cause.
    cause = 'HTTP 403: Resource not accessible by integration (https://api.example.invalid/releases)'
    done = daily(f'{cause}|Authorization: Bearer {TOKEN}|token {TOKEN} was used')
    output = done.stdout + done.stderr
    assert done.returncode == 1, done
    assert 'releasing v0.3.18' in output and 'Validated both release targets' in output, output
    assert 'gh release create exited 1' in output and 'Resource not accessible by integration' in output, output
    assert 'Traceback' not in output and 'CalledProcessError' not in output, output
    assert TOKEN not in output and 'Bearer ' + TOKEN not in output, 'the credential must not be printed'
    assert '--notes-file' not in output and str(root) not in output.split('gh release create exited')[1], output

    # A very long diagnostic is bounded and keeps its end, where the cause is printed.
    done = daily('x' * 9000 + '|final cause: quota exceeded')
    output = done.stdout + done.stderr
    failure_line = next(line for line in output.splitlines() if 'gh release create exited' in line)
    assert done.returncode == 1 and 'final cause: quota exceeded' in output, output
    assert len(output.split('gh release create exited 1:')[1]) < 2300, len(output)

    # A secret in a token-shaped value other than the standard prefixes is removed by value.
    odd = 'opaque-credential-value-123'
    done = daily(f'denied for {odd}', token=odd)
    assert odd not in done.stdout + done.stderr and 'denied for' in done.stdout + done.stderr, done

    # The body and uploaded asset use separate files, even when no shortening is needed.
    done = daily(notes='notes\n')
    published = json.loads(receipt.read_text())
    assert published == {'body': 'notes\n', 'assets': {'RELEASE-NOTES.md': 'notes\n'}}, published
    done = daily(dry_run=True)
    assert done.returncode == 0 and 'release body unchanged: 6 characters' in done.stdout, done
    assert 'including RELEASE-NOTES.md' in done.stdout, done

    # A realistic large interval has huge impact sections as well as a long PR list and guide.
    fragments = []
    for index in range(2000):
        fragment = {'path': f'release-notes/{index}.json', 'summary': f'Change {index} [literal link](url)'}
        fragment.update({field: {'status': 'none', 'detail': 'No impact.'} for field in FIELDS})
        fragment['compatibility'] = {'status': 'changed', 'detail': 'Client changes. ' * 50}
        fragments.append(fragment)
    fragments[-1]['manual'] = {'status': 'changed', 'detail': 'Back up before upgrading.'}
    fragments[-1]['summary'] = 'ACTION REQUIRED'
    fragments[-2]['schema'] = {'status': 'changed', 'detail': 'Breaking schema change.', 'transitions': [[1, 2]]}
    fragments[-2]['summary'] = 'BREAKING CHANGE'
    impact = {'fragments': fragments, 'change_links': {
        f['path']: f'https://example.invalid/pull/{index}' for index, f in enumerate(fragments)}}
    large = 'Fractal v0.3.18 headline\n\n## Upgrade impact\n\n'
    for field, label in FIELDS.items():
        large += f'### {label}\n\n'
        for fragment in fragments:
            if fragment[field]['status'] != 'none':
                large += f'- {fragment[field]["detail"]} [{fragment["summary"]}](https://example.invalid/fragment)\n'
    large += '\n## Changes since v0.3.17\n\n' + '- [PR](https://example.invalid/pull/1)\n' * 2000
    large += '\n---\n\n## Upgrade procedure\n' + 'Full guide instructions.\n' * 6000
    assert len(large) > 125000
    done = daily(notes=large, impact=impact)
    published = json.loads(receipt.read_text())
    body = published['body']
    assert len(body) <= 120000, len(body)
    assert body.startswith('Fractal v0.3.18 headline\n'), body
    assert body.index('ACTION REQUIRED') < body.index('BREAKING CHANGE') < body.index('Change 0')
    assert '2000 changed, 0 unknown, 0 none' in body, body
    assert 'more upgrade items' in body and 'UPGRADE-IMPACT.json' in body
    assert '([PR/source](https://example.invalid/pull/1999))' in body
    assert 'Full guide instructions.' not in body
    assert published['assets']['RELEASE-NOTES.md'] == large
    done = daily(notes=large, impact=impact, dry_run=True)
    assert done.returncode == 0 and 'release body shortened:' in done.stdout, done
    assert f'{len(body)} characters' in done.stdout, done
    assert f'full notes: {len(large)}' in done.stdout, done
    done = daily(notes='x' * 120001)
    assert done.returncode == 1 and 'cannot build bounded release body' in done.stdout, done
    assert not receipt.exists()
    done = daily(notes='x' * 120000 + '\n## Upgrade impact\n', impact=impact)
    assert done.returncode == 1 and 'headline and classification counts exceed limit' in done.stdout, done
    assert not receipt.exists()

# run() still returns a successful command's output unchanged.
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_file_location
loader = SourceFileLoader('daily', str(repo / 'scripts/release-fractal-daily'))
spec = spec_from_file_location(loader.name, loader.path, loader=loader)
module = module_from_spec(spec)
spec.loader.exec_module(module)
assert module.run('printf', 'ok\n') == 'ok'

# Pure sizing never cuts a generated Markdown link and leaves small bodies unchanged.
assert module.release_body('x' * module.RELEASE_BODY_LIMIT, {}) == 'x' * module.RELEASE_BODY_LIMIT
shortened = module.release_body(large, impact)
assert len(shortened) <= module.RELEASE_BODY_LIMIT
assert shortened.index('ACTION REQUIRED') < shortened.index('BREAKING CHANGE') < shortened.index('Change 0')
assert shortened.endswith(module.FULL_NOTES_POINTER + '\n')
assert module.release_body('notes\n', {}) == 'notes\n'
try:
    module.run('sh', '-c', 'echo reason >&2; exit 3')
except module.CommandFailed as error:
    assert str(error) == 'sh exited 3: reason', str(error)
else:
    raise AssertionError('a failing command must raise')
print('Daily release bodies are bounded, full notes are attached, and failures are credential-safe')
