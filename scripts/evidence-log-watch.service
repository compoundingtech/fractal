[Unit]
Description=Evidence log watch: alert when the published log head stops moving (scripts/evidence-log-watch)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/run/current-system/sw/bin:/usr/bin:/bin
# EVIDENCE_LOG_WATCH_NOTIFY: a JSON argv the alert line is appended to, for example a `fractal conversations send` to the owner.
EnvironmentFile=%h/.config/evidence-log-watch/env
ExecStart=/usr/bin/env python3 -I %h/.local/bin/evidence-log-watch --remote https://github.com/compoundingtech/fractal.git --state %h/.local/state/evidence-log-watch --notify ${EVIDENCE_LOG_WATCH_NOTIFY}
SuccessExitStatus=1
TimeoutStartSec=5min
Nice=5
