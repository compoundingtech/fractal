#!/usr/bin/env bash
# Real hosted Darwin lifecycle proof. No simulated launchctl, capability skips,
# production activation, full-node executable or permission grants.
set -euo pipefail
cd "$(dirname "$0")/.."
test "$(uname -s)" = Darwin
/bin/launchctl print "gui/$(id -u)" >/dev/null
# No optional dependency feature may silently introduce the full graph owner.
cargo tree --locked -p fractal-light-node-agent --edges normal --prefix none |
  python3 -c 'import sys
names = {line.split()[0] for line in sys.stdin if line.strip()}
forbidden = names.intersection({"fractal", "fractal-daemon", "fractal-store", "fractal-kernel", "fractal-reconcile", "smallclaims"})
if forbidden:
    raise SystemExit("minimal agent acquired graph dependencies: " + ", ".join(sorted(forbidden)))
print("minimal normal dependency boundary passed")'
cargo test --locked -p fractal-light-node-agent --lib
# This target uses the real binary, launchd GUI job, authenticated home, durable
# journal and pinned native PTY. Missing infrastructure is a failure, never a skip.
cargo test --locked -p fractal-light-node-agent --test binary_session \
  darwin_launchd_install_start_stop_restart_preserves_native_custody -- --exact --nocapture
case "$(uname -m)" in
  arm64) system=aarch64-darwin ;;
  x86_64) system=x86_64-darwin ;;
  *) echo "unsupported Darwin runner architecture" >&2; exit 1 ;;
esac
nix build --no-link --print-build-logs ".#packages.$system.fractal-light-node-agent" \
  ".#checks.$system.light-node-agent-packaging"
