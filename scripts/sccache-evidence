#!/usr/bin/env python3
"""Capture compiler-cache counters without resetting or exposing cache credentials."""
import argparse
from datetime import datetime, timezone
import json
import os
from pathlib import Path
import shutil
import subprocess


COUNTERS = (
    'compile_requests', 'requests_not_compile', 'requests_not_cacheable',
    'requests_unsupported_compiler', 'requests_executed', 'cache_timeouts',
    'cache_read_errors', 'cache_write_errors', 'compile_fails', 'forced_recaches',
)


def count(value):
    if type(value) is not int or value < 0:
        raise ValueError('cache counters must be nonnegative integers')
    return value


def snapshot(raw, runner, identity, job, source, storage):
    stats = raw['stats']
    counters = {key: count(stats[key]) for key in COUNTERS}
    for key in ('cache_hits', 'cache_misses', 'cache_errors'):
        counts = stats[key]['counts']
        counters[key] = sum(count(value) for value in counts.values())
        if key != 'cache_errors':
            counters[f'rust_{key}'] = count(counts.get('Rust', 0))
    # The full cache location can contain URLs, credentials, or private paths.
    location = raw.get('cache_location', '').lower()
    backend = ('webdav' if location.startswith('webdav') else
               'disk' if location.startswith('local disk') else 'other')
    expected = {'local-disk': 'disk', 'shared-webdav': 'webdav', 'remote-webdav': 'webdav'}
    if expected.get(storage) != backend:
        raise ValueError('observed backend does not match owner-qualified storage class')
    if not all((runner, identity, job, source)) or not identity.get('config'):
        raise ValueError('runner, server identity, job and source are required')
    if raw['version'] != '0.16.0':
        raise ValueError('only sccache 0.16.0 read-only stats behavior has been verified')
    return dict(schema=1, runner=runner, identity=identity, job=job, source=source, backend=backend, storage=storage,
                version=raw['version'], captured_at=datetime.now(timezone.utc).isoformat(),
                counters=counters)


def report(after, before=None):
    result = {key: after[key] for key in
              ('schema', 'runner', 'identity', 'job', 'source', 'backend', 'storage', 'version', 'captured_at')}
    result['scope'] = 'interval' if before else 'server_lifetime'
    result['started_at'] = before['captured_at'] if before else None
    result['hit_rate'] = result['rust_hit_rate'] = None
    counters = after['counters']
    for value in counters.values():
        count(value)
    if before:
        if any(before[key] != after[key] for key in
               ('schema', 'runner', 'identity', 'job', 'source', 'backend', 'storage', 'version')):
            return dict(result, status='incompatible_snapshots')
        if before['counters'].keys() != counters.keys():
            return dict(result, status='incompatible_snapshots')
        if any(count(before['counters'][key]) > value for key, value in counters.items()):
            return dict(result, status='counter_reset')
        counters = {key: value - before['counters'][key] for key, value in counters.items()}
    result['counters'] = counters
    for prefix in ('', 'rust_'):
        hits, misses = (counters[f'{prefix}cache_{kind}'] for kind in ('hits', 'misses'))
        result[f'{prefix}hit_rate'] = hits / (hits + misses) if hits + misses else None
    result['status'] = 'measured' if counters['cache_hits'] + counters['cache_misses'] else 'no_cache_lookups'
    return result


def live_identity(pid, start, port, executable, config_id):
    """Require an already-running Linux process owning the requested TCP listener."""
    proc = Path(f'/proc/{pid}')
    actual_start = proc.joinpath('stat').read_text().rsplit(')', 1)[1].split()[19]
    if actual_start != start or proc.joinpath('exe').resolve(strict=True) != executable:
        raise ValueError('server PID/start/executable identity does not match')
    sockets = set()
    for fd in proc.joinpath('fd').iterdir():
        try:
            target = str(fd.readlink())
        except FileNotFoundError:
            continue  # Live processes close descriptors while /proc is read.
        if target.startswith('socket:'):
            sockets.add(target)
    listening = set()
    for family in ('tcp', 'tcp6'):
        for line in proc.joinpath('net', family).read_text().splitlines()[1:]:
            fields = line.split()
            if fields[3] == '0A' and int(fields[1].rsplit(':', 1)[1], 16) == port:
                listening.add(f'socket:[{fields[9]}]')
    if not sockets.intersection(listening):
        raise ValueError('server PID does not own the requested listening port')
    return dict(pid=pid, start_ticks=start, port=port, config=config_id,
                boot_id=Path('/proc/sys/kernel/random/boot_id').read_text().strip())


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest='command', required=True)
    capture = commands.add_parser('capture', help='read counters; never start, stop or zero the server')
    capture.add_argument('--runner', required=True)
    capture.add_argument('--pid', required=True, type=int)
    capture.add_argument('--start-ticks', required=True)
    capture.add_argument('--port', required=True, type=int)
    capture.add_argument('--config-id', required=True, help='owner-qualified configuration revision or digest')
    capture.add_argument('--job', required=True)
    capture.add_argument('--source', required=True, help='tested source revision or tree')
    capture.add_argument('--storage', required=True, choices=['local-disk', 'shared-webdav', 'remote-webdav'])
    capture.add_argument('--sccache', default='sccache')
    capture.add_argument('--output', required=True, type=Path)
    compare = commands.add_parser('report', help='compute lifetime or interval hit rates')
    compare.add_argument('--before', type=Path)
    compare.add_argument('--after', required=True, type=Path)
    compare.add_argument('--output', required=True, type=Path)
    args = parser.parse_args()
    if args.command == 'capture':
        executable = Path(shutil.which(args.sccache) or args.sccache).resolve(strict=True)
        identity = live_identity(args.pid, args.start_ticks, args.port, executable, args.config_id)
        if subprocess.check_output([str(executable), '--version'], text=True, timeout=20,
                                   stderr=subprocess.PIPE).strip() != 'sccache 0.16.0':
            raise ValueError('client read-only stats behavior is verified only for sccache 0.16.0')
        env = {**os.environ, 'SCCACHE_SERVER_PORT': str(args.port)}
        env.pop('SCCACHE_SERVER_UDS', None)
        raw = subprocess.check_output([str(executable), '--show-stats', '--stats-format=json'],
                                      text=True, timeout=20, env=env, stderr=subprocess.PIPE)
        if live_identity(args.pid, args.start_ticks, args.port, executable, args.config_id) != identity:
            raise ValueError('server identity changed during capture')
        output = snapshot(json.loads(raw), args.runner, identity, args.job, args.source, args.storage)
        if output['counters']['compile_requests'] == 0:
            # ShowStats synthesizes empty stats when connection fails. It never starts a daemon.
            raise ValueError('zero requests: empty server or synthetic disconnected stats, no qualified measurement')
    else:
        output = report(json.loads(args.after.read_text()),
                        json.loads(args.before.read_text()) if args.before else None)
    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps(output, indent=2) + '\n')
    print(f"Saved sccache {args.command} to {args.output}")


if __name__ == '__main__':
    main()
