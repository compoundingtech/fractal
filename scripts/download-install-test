#!/usr/bin/env python3
"""Exercise download integrity, quiet installation, platform selection and launch."""
import hashlib
import json
import os
from pathlib import Path
import shutil
import subprocess
import tarfile
import tempfile

repo = Path(__file__).resolve().parent.parent
with tempfile.TemporaryDirectory() as d:
    root = Path(d)
    tools = root / 'tools'; tools.mkdir()
    payload = root / 'fractal-x86_64-unknown-linux-gnu'; (payload / 'bin').mkdir(parents=True)
    for name in ['st3', 'pty']:
        p = payload / 'bin' / name
        p.write_text('#!/bin/sh\nif [ "${1:-}" = --version ]; then [ "${FAIL_RECEIPT:-}" != version ] || exit 1; printf \'{"machine_version":"0.3.17+abcdef123"}\\n\'; else printf "' + name + '-fixture\\n"; fi\n'); p.chmod(0o755)
    (payload / 'bin/st').symlink_to('st3')
    (payload / 'bin/fractal').symlink_to('st3')
    (payload / 'share/fractal-web').mkdir(parents=True)
    (payload / 'share/fractal-web/index.html').write_text('<!doctype html><title>Fractal</title>')
    shutil.copy(repo / 'scripts/install-release', payload / 'install.sh')
    archive = root / (payload.name + '.tar.gz')
    with tarfile.open(archive, 'w:gz') as t: t.add(payload, arcname=payload.name)
    checksum = Path(str(archive) + '.sha256')
    correct = hashlib.sha256(archive.read_bytes()).hexdigest() + '  ' + archive.name + '\n'
    checksum.write_text(correct)
    curl = tools / 'curl'
    curl.write_text('''#!/bin/sh
set -eu
printf '%s\\n' "$*" >> "$RECEIPTS"
url= out= status=false effective=false
while [ "$#" -gt 0 ]; do
 case "$1" in --output) out=$2;shift 2;; --write-out) case "$2" in *url_effective*) effective=true;; *) status=true;; esac;shift 2;; https://*) url=$1;shift;; *) shift;; esac
done
if "$effective"; then printf '%s' "${url%/latest}/tag/v0.3.18"; exit 0; fi
if "$status"; then
    if [ "${DOWNLOAD_STATUS:-}" ]; then printf '%s' "$DOWNLOAD_STATUS"; exit 0; fi
    if [ ! -f "$FIXTURES/${url##*/}" ]; then printf '404'; exit 0; fi
    cp "$FIXTURES/${url##*/}" "$out"
    printf '200'
else
    cp "$FIXTURES/${url##*/}" "$out"
fi
'''); curl.chmod(0o755)
    uname = tools / 'uname'
    uname.write_text('#!/bin/sh\ncase "$1" in -s) echo "${PLATFORM:-Linux}";; -m) echo "${ARCH:-x86_64}";; esac\n'); uname.chmod(0o755)
    for command in ['mktemp', 'mv']:
        real = shutil.which(command)
        wrapper = tools / command
        wrapper.write_text(f'''#!/bin/sh
if [ "${{FAIL_RECEIPT:-}}" = {command} ]; then
    case "$*" in *RELEASE.json*) printf 'injected receipt failure\\n' >&2; exit 1 ;; esac
fi
exec "{real}" "$@"
''')
        wrapper.chmod(0o755)
    env = dict(os.environ, PATH=str(tools) + ':' + os.environ['PATH'], HOME=str(root / 'home'),
               FIXTURES=str(root), RECEIPTS=str(root / 'requests'))
    def install(*args, extra=None):
        return subprocess.run(['sh', str(repo / 'install.sh'), *args], env={**env, **(extra or {})},
                              input='', text=True, capture_output=True, timeout=20)
    result = install('--no-run')
    assert result.returncode == 0 and result.stdout == '' and result.stderr == '', result
    installed = root / 'home/.local/bin'
    assert (installed / 'st').readlink() == Path('st3')
    assert (installed / 'fractal').readlink() == Path('st3')
    assert sorted(p.name for p in installed.iterdir()) == ['RELEASE.json', 'fractal', 'pty', 'st', 'st3']
    receipt = json.loads((installed / 'RELEASE.json').read_text())
    assert receipt['tag'] == 'v0.3.18' and receipt['commit'] == 'abcdef123', receipt
    assert receipt['target'] == 'x86_64-unknown-linux-gnu' and receipt['installed_at'].endswith('Z'), receipt
    assert (installed.parent / 'share/fractal-web/index.html').read_text() == '<!doctype html><title>Fractal</title>'
    result = install('--tag', 'v0.3.18')
    assert result.returncode == 0 and result.stdout == 'st3-fixture\n' and result.stderr == '', result
    assert json.loads((installed / 'RELEASE.json').read_text())['tag'] == 'v0.3.18'
    # Optional metadata failures must not turn a committed installation into a
    # failure, skip launch, overwrite the previous receipt, or leave staging files.
    previous_receipt = (installed / 'RELEASE.json').read_bytes()
    for failure in ['version', 'mktemp', 'mv']:
        result = install('--tag', 'v0.3.19', extra={'FAIL_RECEIPT': failure})
        assert result.returncode == 0 and result.stdout == 'st3-fixture\n', (failure, result)
        assert result.stderr == 'install: warning: release receipt unavailable; continuing with the installed binary\n', (failure, result)
        assert (installed / 'RELEASE.json').read_bytes() == previous_receipt
        assert not list(installed.glob('RELEASE.json.*')), failure
    (installed / 'fractal').unlink()
    (installed / 'fractal').write_text('foreign command')
    result = install('--no-run')
    assert result.returncode == 0 and result.stdout == '', result
    assert 'leaving fractal unchanged:' in result.stderr, result
    assert (installed / 'fractal').read_text() == 'foreign command'
    assert (installed / 'st').readlink() == Path('st3')
    (installed / 'fractal').unlink()
    foreign_path = root / 'foreign-path'
    foreign_path.mkdir()
    (foreign_path / 'fractal').write_text('foreign PATH command')
    result = install('--no-run', extra={'PATH': str(foreign_path) + ':' + env['PATH']})
    assert result.returncode == 0 and 'PATH contains a foreign command' in result.stderr, result
    assert not (installed / 'fractal').exists() and not (installed / 'fractal').is_symlink()
    assert (foreign_path / 'fractal').read_text() == 'foreign PATH command'
    requests = (root / 'requests').read_text()
    assert '/latest' in requests and '/download/v0.3.18/' in requests
    assert '/download/v0.3.18/fractal-x86_64-unknown-linux-gnu.tar.gz' in requests
    assert 'smalltalk-x86_64-unknown-linux-gnu.tar.gz' not in requests
    result = install('--edge', '--no-run')
    assert result.returncode == 0 and result.stdout == '' and result.stderr == '', result
    assert (root / 'requests').read_text().count('/download/edge/') == 2
    assert json.loads((installed / 'RELEASE.json').read_text())['tag'] == 'edge'
    result = install('--edge', '--tag', 'v0.3.18', '--no-run')
    assert result.returncode == 2 and 'either --edge or --tag' in result.stderr, result
    original = (installed / 'st3').read_bytes()
    original_receipt = (installed / 'RELEASE.json').read_bytes()
    checksum.write_text('0' * 64 + '  ' + archive.name + '\n')
    result = install('--no-run')
    assert result.returncode != 0 and 'checksum mismatch' in result.stderr, result
    assert (installed / 'st3').read_bytes() == original
    assert (installed / 'RELEASE.json').read_bytes() == original_receipt
    checksum.write_text(correct.replace(archive.name, 'other.tar.gz'))
    result = install('--no-run')
    assert result.returncode != 0 and 'invalid archive checksum' in result.stderr, result
    # An HTTP failure must not select a potentially stale legacy asset.
    result = install('--no-run', extra={'DOWNLOAD_STATUS': '503'})
    assert result.returncode != 0 and 'HTTP 503' in result.stderr, result
    result = install('--no-run', extra={'ARCH': 'aarch64'})
    assert result.returncode != 0 and 'supported platforms' in result.stderr, result
    result = install('--tag', '../other')
    assert result.returncode != 0 and 'invalid release tag' in result.stderr, result
    # Exact published v0.3.17 installer from source f4cec96e414fee2a780910730b019fe6bdbddc1d.
    # It rejects --quiet and requires the historical four-command payload.
    payload_installer = payload / 'install.sh'
    published = repo / 'scripts/fixtures/install-release-v0.3.17'
    assert hashlib.sha256(published.read_bytes()).hexdigest() == 'd6912ca3612d73b9e8c6645312698b656c9fc8b241bd9185d4b0334086742dea'
    rejected = subprocess.run(['bash', str(published), '--quiet'], env=env,
                              text=True, capture_output=True, timeout=10)
    assert rejected.returncode == 2 and 'unknown option: --quiet' in rejected.stderr, rejected
    shutil.copy(published, payload_installer); payload_installer.chmod(0o755)
    # Retained releases use both the old asset name and the old package root.
    payload.rename(root / 'smalltalk-x86_64-unknown-linux-gnu')
    payload = root / 'smalltalk-x86_64-unknown-linux-gnu'
    payload_installer = payload / 'install.sh'
    archive.unlink()
    checksum.unlink()
    archive = root / (payload.name + '.tar.gz')
    checksum = Path(str(archive) + '.sha256')
    for name in ['stui', 'st3-migrate']: shutil.copy(payload / 'bin/st3', payload / 'bin' / name)
    with tarfile.open(archive, 'w:gz') as t: t.add(payload, arcname=payload.name)
    checksum.write_text(hashlib.sha256(archive.read_bytes()).hexdigest() + '  ' + archive.name + '\n')
    legacy_bin = root / 'legacy-bin'
    result = install('--tag', 'v0.3.17', '--bin-dir', str(legacy_bin), '--no-run')
    assert result.returncode == 0 and result.stdout == '' and result.stderr == '', result
    assert sorted(p.name for p in legacy_bin.iterdir()) == ['RELEASE.json', 'pty', 'st', 'st3', 'st3-migrate', 'stui']
    assert '/download/v0.3.17/smalltalk-x86_64-unknown-linux-gnu.tar.gz' in (root / 'requests').read_text()
print('Download installer integrity, quiet install, launch and platform controls passed')
