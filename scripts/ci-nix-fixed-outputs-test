#!/usr/bin/env python3
"""scripts/ci-nix-fixed-outputs fails a stale fixed-output hash, also when the store already holds the path, against real Nix."""
import base64
import hashlib
import json
from pathlib import Path
import subprocess
import tempfile
import unittest
import uuid

root = Path(__file__).resolve().parent.parent
SCRIPT = root / 'scripts/ci-nix-fixed-outputs'
SYSTEM = subprocess.run(['nix', 'eval', '--impure', '--raw', '--expr', 'builtins.currentSystem'],
                        capture_output=True, text=True, check=True).stdout


def nix(value):
    """`value` (strings, booleans, lists, attribute sets) as a Nix expression; JSON strings are valid Nix strings here."""
    if isinstance(value, dict):
        return '{ ' + ' '.join(f'{key} = {nix(item)};' for key, item in value.items()) + ' }'
    if isinstance(value, list):
        return '[ ' + ' '.join(nix(item) for item in value) + ' ]'
    if isinstance(value, bool):
        return 'true' if value else 'false'
    return json.dumps(value)


def sri(content):
    return 'sha256-' + base64.b64encode(hashlib.sha256(content).digest()).decode()


class FixedOutputs(unittest.TestCase):
    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.base = Path(self.tmp.name)
        # A unique name per test: a path from another run never answers for this one.
        self.name = f'ci-nix-fixed-outputs-fixture-{uuid.uuid4().hex}'

    def tearDown(self):
        self.tmp.cleanup()

    def flake(self, label, content, pinned):
        """A flake whose `fod` writes `content` (a /bin/sh builder, no nixpkgs) and pins `pinned`'s hash."""
        directory = self.base / label
        directory.mkdir()
        attributes = {
            'name': self.name, 'system': SYSTEM, 'builder': '/bin/sh', 'args': ['-c', 'printf %s "$content" > "$out"'],
            'content': content.decode(), 'outputHashMode': 'flat', 'outputHashAlgo': 'sha256', 'outputHash': sri(pinned),
        }
        (directory / 'flake.nix').write_text('{ outputs = { self }: { fod = derivation ' + nix(attributes) + '; }; }\n')
        return f'path:{directory}#fod'

    def check(self, installable):
        return subprocess.run(['bash', str(SCRIPT), installable], capture_output=True, text=True)

    def test_a_correct_pin_passes_and_is_then_trusted_without_building_again(self):
        installable = self.flake('good', b'one\n', b'one\n')
        first = self.check(installable)
        self.assertEqual(first.returncode, 0, first.stdout + first.stderr)
        self.assertIn('was built from this derivation', first.stdout)
        again = self.check(installable)
        self.assertEqual(again.returncode, 0, again.stdout + again.stderr)
        self.assertNotIn('building it again', again.stdout)

    def test_a_stale_pin_fails(self):
        done = self.check(self.flake('stale', b'two\n', b'what the pin was measured on\n'))
        self.assertNotEqual(done.returncode, 0, done.stdout + done.stderr)
        self.assertIn('hash mismatch', done.stderr)

    def test_a_stale_pin_fails_even_when_the_store_holds_the_path(self):
        # The release break: the inputs changed and the pin did not, and a store holding the old output served it.
        measured = self.flake('measured', b'old inputs\n', b'old inputs\n')
        self.assertEqual(self.check(measured).returncode, 0)
        changed = self.flake('changed', b'new inputs\n', b'old inputs\n')
        plain = subprocess.run(['nix', 'build', '--no-link', changed], capture_output=True, text=True)
        self.assertEqual(plain.returncode, 0, 'a plain build serves the old output: ' + plain.stderr)
        done = self.check(changed)
        self.assertNotEqual(done.returncode, 0, done.stdout + done.stderr)
        self.assertIn('building it again to check its hash', done.stdout)
        self.assertIn('hash mismatch', done.stderr)


class Wiring(unittest.TestCase):
    def test_the_typescript_client_lane_runs_it_outside_its_own_derivation(self):
        client = (root / 'scripts/ci-typescript-client').read_text()
        self.assertIn('scripts/ci-nix-fixed-outputs', client)
        self.assertIn('NIX_BUILD_TOP', client)

    def test_the_lane_definition_names_the_check_and_what_it_builds(self):
        # A definition path that differs from the base makes the tree a lane edit, so the lane runs for it.
        # arn:lmig:smalltalk:2026-10-27-dot-fractal-config — missing-only checkout bridge.
        path = root / '.fractal/required-lanes.json'
        try:
            path.lstat()
        except FileNotFoundError:
            path = root / '.st/required-lanes.json'
        lane = json.loads(path.read_text())['lanes']['typescript-client']
        for path in ('scripts/ci-nix-fixed-outputs', 'nix/typescript-client.nix', 'nix/typescript-client-deps.hash'):
            self.assertIn(path, lane['definition_paths'])


if __name__ == '__main__':
    unittest.main()
