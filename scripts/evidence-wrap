#!/usr/bin/env python3
"""Run one check once on this machine and ask the signer to record it as an evidence note.

  scripts/evidence-wrap --check linux-gate [--change-id github:OWNER/REPO#N] [--input NAME=VALUE]... [--input-file NAME=PATH]... [--push origin] -- COMMAND...

Run it from a clean checkout of the exact commit you are about to push. It runs COMMAND once
(output streams to your terminal), then sends the signer the facts it measured: the commit,
the command, its exit code, the sha256 of its exact output and an environment fingerprint
(flake.lock, the dev shell derivation, this script's own bytes, the system, the attempt). The
signer (scripts/evidence-sign, behind a sekrets grant; this script never sees the key)
recomputes the tree and flake.lock itself and signs. A failing command is recorded too: a
failure is a record, not a missing record. COMMAND keeps the caller's environment; the signer is
started without the loader and interpreter variables it refuses (LD_*, DYLD_*, PYTHON*,
GLIBC_TUNABLES, GCONV_PATH, NLSPATH) and with a fixed PATH.

The note is imported as refs/tags/evidence/<tree>/<record> in this checkout and, while gates on older bases
read only notes, as refs/notes/evidence/<tree>/<record> naming the same record. With --push REMOTE both are
also pushed, after scripts/evidence-verify accepts it. CI finds a note by its tree, so it only helps when the commit you push has the tree CI will test (a branch current with main).
A ref the remote answers with a bare `(failed)` is pushed again, up to 3 times; a refusal that gives a reason fails at once.

With --aggregate FILE nothing is run: FILE is JSON {"command": [...], "exit_code": N, "output": ANY,
"inputs": {name: string}} written by a job that summarizes other jobs (an aggregate gate). The
output digest is the sha256 of the canonical JSON of "output" (sorted keys, no spaces), and the
extra inputs are recorded next to the environment fingerprint. The note then says only what that
job knows, and the command names it as an aggregate.

With --out DIR the note is not imported or pushed: DIR/<record>.pack (the git objects) and
DIR/<record>.json (record, check, tree, commit, tier, exit code) are written for a later job to
publish. A job on a shallow checkout uses this, because the server refuses a push from one.
In --aggregate mode a dirty workspace does not stop the signature (the job has already run its
tests); it is recorded as the input workspace_clean instead.

--input-file NAME=PATH records an input the command itself reports, read after it ends: the sorted, distinct non-empty lines of
PATH joined by commas (a count and digest past 500 characters), or 'none' when PATH is missing or empty. fractal-test uses it for env_skips, the tests that skipped because this
host cannot run them (CI_TEST_ENV_SKIPS), so the note says which tests did not run here.

With EVIDENCE_PUSH_TOKEN set, --push uses it as an HTTP authorization header (never printed).

With --lanes-from BASE the check is held to its lane in .st/required-lanes.json at BASE (the accepted base): the command must be the
lane's argv, and the note records lane_definition_sha256, the digest of the lane as THIS tree defines it (the base's argv and paths, this
tree's bytes at those paths). For a tree that leaves the lane alone that is the digest the verifier recomputes from BASE; for a tree that
edits its lane it is the edited definition's, which only a level whose policy says by_level lane "tree" accepts (our hosts, since
2026-10-26: a lane edit is signed like any other change). It is the producer half of `evidence-verify --lanes-from`.

Take this script from the accepted base (main), not from the change under test.
"""
import argparse
import base64
import hashlib
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import time

sys.dont_write_bytecode = True

HERE = Path(__file__).resolve().parent
DEFAULT_SIGNER = ['st', 'sekrets', '--', 'evidence-sign']
# What would make the loader or the interpreter load code into the signer, which refuses to start with any of them
# set (scripts/evidence-sign REFUSED_ENVIRONMENT; the refusal stays, it is the signer's tripwire). Some hosts preload
# a library into every process (hetz2: jemalloc), so the signer is started without these, and with a fixed PATH: its
# program is resolved first, with the caller's.
LOADER_PREFIXES = ('LD_', 'DYLD_', 'PYTHON')
LOADER_VARIABLES = ('GLIBC_TUNABLES', 'GCONV_PATH', 'NLSPATH')
SIGNER_PATH = '/run/current-system/sw/bin:/usr/bin:/bin'


class Failure(Exception):
    pass


PUSH_TRIES, PUSH_BACKOFF = 3, 2.0


def push_refs(remote, refs, env_extra):
    """Push refs to remote. GitHub now and then answers a ref with a bare `(failed)` and takes the same ref on the next push
    (scripts/st-test's push_records retries it too): only those refs go again, up to PUSH_TRIES times, after 2 s and then 4 s.
    A refusal that gives a reason (a rule, a non-fast-forward, an update the ruleset forbids) or a transport error fails at once.
    The failure names every ref still refused, with its reason."""
    pending = list(refs)
    for attempt in range(1, PUSH_TRIES + 1):
        done = git('push', '--porcelain', remote, *(f'{name}:{name}' for name in pending), check=False, env_extra=env_extra, transport=True)
        if done.returncode == 0:
            return
        refused = {}
        for line in done.stdout.decode(errors='replace').splitlines():
            fields = line.split('\t')
            if line.startswith('!') and len(fields) >= 3:
                refused[fields[1].split(':')[0]] = fields[2].strip()
        if not refused:
            raise Failure(f'push failed: {done.stderr.decode(errors="replace").strip()[-500:]}')
        transient = [name for name, why in refused.items() if why == '[remote rejected] (failed)']
        if len(transient) < len(refused) or attempt == PUSH_TRIES:
            shown = '; '.join(f'{name} {why}' for name, why in refused.items())
            raise Failure(f'push failed (try {attempt} of {PUSH_TRIES}): {shown}')
        print(f'evidence-wrap: {remote} answered {len(transient)} ref(s) with a bare (failed); pushing them again ({attempt + 1} of {PUSH_TRIES})',
              file=sys.stderr, flush=True)
        time.sleep(PUSH_BACKOFF * attempt)
        pending = transient


def signer_launch(argv, environ=None):
    """(argv, env) that start the signer: the program as an absolute path, the caller's environment without any
    loader or interpreter variable, and SIGNER_PATH as PATH."""
    environ = os.environ if environ is None else environ
    if not argv or not all(isinstance(a, str) for a in argv):
        raise Failure('--signer must be a JSON array of strings')
    program = argv[0] if '/' in argv[0] else shutil.which(argv[0], path=environ.get('PATH', ''))
    if not program:
        raise Failure(f'the signer {argv[0]!r} is not on PATH')
    env = {k: v for k, v in environ.items() if not k.startswith(LOADER_PREFIXES) and k not in LOADER_VARIABLES}
    env['PATH'] = SIGNER_PATH
    return [os.path.abspath(program), *argv[1:]], env


def git(*args, stdin=None, check=True, env_extra=None, transport=False):
    # Measurement git calls ignore the job's GIT_* environment. Publication alone keeps
    # transport settings; neither path lets the checkout's fsmonitor, hooks or pager name a program.
    clean = {k: v for k, v in os.environ.items() if not k.startswith('GIT_')}
    if transport:
        # Only publication uses the caller's transport configuration. In particular, dropping
        # GIT_CONFIG_* here loses HTTPS remote/pushurl overrides and credential helpers.
        clean.update({k: v for k, v in os.environ.items()
                      if k.startswith('GIT_CONFIG_') or k in ('GIT_SSH', 'GIT_SSH_COMMAND', 'GIT_SSH_VARIANT', 'GIT_ASKPASS')})
    done = subprocess.run(['git', '-c', 'core.fsmonitor=false', '-c', 'core.hooksPath=/dev/null', '-c', 'core.pager=cat', *args],
                          input=stdin, capture_output=True, timeout=600,
                          env=dict(clean, GIT_NO_REPLACE_OBJECTS='1', GIT_TERMINAL_PROMPT='0', LC_ALL='C', **(env_extra or {})))
    if check and done.returncode != 0:
        raise Failure(f'git {args[0]} failed: {done.stderr.decode(errors="replace").strip()[-500:]}')
    return done


# arn:lmig:smalltalk:2026-10-27-dot-fractal-config — embedded for extracted signing tools.
def config_path(base, name):
    path = f'.fractal/{name}'
    return path if git('ls-tree', '--full-tree', '-z', base, '--', path).stdout else f'.st/{name}'


def dirty():
    return git('status', '--porcelain').stdout.decode().strip()


def tracked_dirty():
    """Tracked files that differ from the commit. Untracked and ignored files do not count (by design:
    build output lives there, so the note says 'tested' about a state that can differ from the tree it names
    only by files outside the tree).

    `git status` can be told to ignore a tracked file (assume-unchanged, skip-worktree), so the index flags
    are read too: every tracked file must be tagged `H`."""
    changed = git('status', '--porcelain', '--untracked-files=no').stdout.decode().strip()
    hidden = [line for line in git('ls-files', '-v').stdout.decode().splitlines() if line[:2] != 'H ']
    return changed or ('index flags hide changes: ' + ', '.join(hidden[:3]) if hidden else '')


# The inputs this script sets itself; --input may not name them.
WRAP_INPUTS = frozenset({'flake_lock_sha256', 'toolchain_sha256', 'wrapper_sha256', 'system', 'attempt', 'lane_definition_sha256',
                         'workspace_clean', 'untracked_files'})


def toolchain_digest(override):
    if override:
        return override
    system = subprocess.run(['nix', 'eval', '--impure', '--raw', '--expr', 'builtins.currentSystem'],
                            capture_output=True, text=True)
    drv = subprocess.run(['nix', 'eval', '--raw', '--no-update-lock-file',
                          f'.#devShells.{system.stdout.strip()}.default.drvPath'], capture_output=True, text=True)
    if system.returncode or drv.returncode or not drv.stdout.startswith('/'):
        raise Failure('could not name the dev shell derivation (pass --toolchain-sha256 to override): '
                      + (drv.stderr or system.stderr).strip()[-300:])
    return hashlib.sha256(drv.stdout.strip().encode()).hexdigest()


def run_command(command):
    digest = hashlib.sha256()
    process = subprocess.Popen(command, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
    # read1, not read: read(65536) waits for a full 64 KiB, so a caller reading this output as it comes (fractal-test's limit, which starts
    # when ci-local says it has, and stops a check silent too long) would see it only in late bursts. The digest is of the same bytes.
    for chunk in iter(lambda: process.stdout.read1(65536), b''):
        digest.update(chunk)
        sys.stdout.buffer.write(chunk)
        sys.stdout.buffer.flush()
    return process.wait(), digest.hexdigest()


# fractal-test reads this from the base's copy: a base whose wrapper signs a tree that edits its lane (it no longer reports such a check as "not signed").
SIGNS_LANE_EDITS = True


def lane_inputs(verifier_path, base, check, tree, command):
    """The digest of `check`'s lane as `tree` defines it, after refusing a command that is not the lane's argv."""
    loader = importlib.machinery.SourceFileLoader('evidence_verify_for_wrap', verifier_path)
    verifier = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(verifier)
    try:
        shown = git('show', f'{base}:{config_path(base, "required-lanes.json")}')
        rules = verifier.lane_rules(shown.stdout.decode(), check)
        base_tree = git('rev-parse', '--verify', '--end-of-options', base + '^{tree}').stdout.decode().strip()
        definition = verifier.lane_definition('.', base_tree, tree, rules)
    except verifier.Failure as failure:
        raise Failure(f'lane {check}: {failure.reason}: {failure.detail}; nothing was signed')
    if command != rules['argv']:
        raise Failure(f'the command is not the argv of lane {check} at {base}; nothing was signed')
    if definition['changed']:
        print(f'evidence-wrap: this tree edits lane {check} ({", ".join(definition["changed"][:5])}); the note carries the edited definition\'s digest',
              file=sys.stderr)
    return definition['tree_sha256']


def main(argv):
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument('--check', required=True, help='the required check this command stands for')
    parser.add_argument('--change-id')
    parser.add_argument('--attempt', default='1')
    parser.add_argument('--signer', default=os.environ.get('EVIDENCE_SIGNER') or json.dumps(DEFAULT_SIGNER),
                        help='JSON argument vector of the signer (default: $EVIDENCE_SIGNER, else sekrets)')
    parser.add_argument('--toolchain-sha256', help='skip the nix evaluation and record this digest')
    parser.add_argument('--keys', help='allowed-signers file for the local verification (default: .st/evidence-keys on --keys-from)')
    parser.add_argument('--keys-from', default='origin/main')
    parser.add_argument('--verifier', default=str(HERE / 'evidence-verify'))
    parser.add_argument('--push', metavar='REMOTE')
    parser.add_argument('--lanes-from', metavar='COMMIT',
                        help='hold the check to its lane in .st/required-lanes.json at this accepted base and record the lane definition digest')
    parser.add_argument('--aggregate', metavar='FILE', help='record the facts in FILE instead of running a command')
    parser.add_argument('--input', action='append', default=[], metavar='NAME=VALUE',
                        help='record one more input the command depends on (a name this script does not set itself; repeatable)')
    parser.add_argument('--input-file', action='append', default=[], metavar='NAME=PATH',
                        help='record one more input read from PATH after the command ends (its distinct lines, comma-joined; repeatable)')
    parser.add_argument('--out', metavar='DIR', help='write the pack and a summary here instead of importing and pushing')
    parser.add_argument('command', nargs=argparse.REMAINDER)
    args = parser.parse_args(argv)
    command = args.command[1:] if args.command[:1] == ['--'] else args.command
    if bool(command) == bool(args.aggregate):
        parser.error('give either the command after -- or --aggregate FILE')
    if args.lanes_from and args.aggregate:
        parser.error('--lanes-from is for a command this script runs, not --aggregate')

    try:
        top = git('rev-parse', '--show-toplevel').stdout.decode().strip()
        os.chdir(top)
        clean = not dirty()
        if not clean and not args.aggregate:
            raise Failure('the checkout is not clean: commit or remove changes first, the note is for the committed tree')
        commit = git('rev-parse', 'HEAD').stdout.decode().strip()
        tree = git('rev-parse', 'HEAD^{tree}').stdout.decode().strip()
        lock = git('show', 'HEAD:flake.lock').stdout
        system = subprocess.run(['uname', '-sm'], capture_output=True, text=True).stdout.split()
        inputs = {
            'flake_lock_sha256': hashlib.sha256(lock).hexdigest(),
            'toolchain_sha256': toolchain_digest(args.toolchain_sha256),
            'wrapper_sha256': hashlib.sha256(Path(__file__).read_bytes()).hexdigest(),
            'system': f'{system[1]}-{system[0]}'.lower() if len(system) == 2 else 'unknown',
            'attempt': args.attempt,
        }
        for item in args.input:
            name, sep, value = item.partition('=')
            if not sep or not re.fullmatch(r'[a-z][a-z0-9_]{0,63}', name) or not value or name in inputs or name in WRAP_INPUTS:
                raise Failure(f'--input {item!r}: NAME=VALUE with a lower-case name this script does not set itself, and a value')
            if name == 'source_inputs' and not re.fullmatch(r'[0-9a-f]{40}|[0-9a-f]{64}', value):
                raise Failure('--input source_inputs must be a git tree id')
            inputs[name] = value
        reported = {}
        for item in args.input_file:
            name, sep, path = item.partition('=')
            if not sep or not re.fullmatch(r'[a-z][a-z0-9_]{0,63}', name) or not path or name in inputs or name in WRAP_INPUTS or name in reported:
                raise Failure(f'--input-file {item!r}: NAME=PATH with a lower-case name this script does not set itself, and a path')
            reported[name] = Path(path)
        if args.aggregate and reported:
            raise Failure('--input-file is for a command this script runs, not --aggregate')
        if args.aggregate:
            facts = json.loads(Path(args.aggregate).read_text())
            known = {'command', 'exit_code', 'output', 'output_sha256', 'inputs', 'runner'}
            if set(facts) - known or not {'command', 'exit_code'} <= set(facts) or ('output' in facts) == ('output_sha256' in facts):
                raise Failure('--aggregate FILE must hold command, exit_code, exactly one of output or output_sha256, and optionally inputs')
            command, exit_code = facts['command'], facts['exit_code']
            output_sha256 = facts.get('output_sha256') or hashlib.sha256(
                json.dumps(facts['output'], sort_keys=True, separators=(',', ':')).encode()).hexdigest()
            inputs.update(facts.get('inputs', {}))
            # The job ran code under test in this checkout and the note names HEAD's tree. If that code
            # changed a tracked file, the tree that was tested is not the tree being signed.
            detail = tracked_dirty()
            if detail:
                raise Failure('tracked files differ from the commit, so the tree that was tested is not the one named; nothing was signed ('
                              + detail.splitlines()[0][:200] + ')')
            inputs['workspace_clean'] = 'true'  # tracked files are exactly the commit's
            inputs['untracked_files'] = 'false' if clean else 'true'
        else:
            if args.lanes_from:
                inputs['lane_definition_sha256'] = lane_inputs(args.verifier, args.lanes_from, args.check, tree, command)
            exit_code, output_sha256 = run_command(command)
            for name, path in reported.items():
                lines = path.read_text().splitlines() if path.exists() else []
                value = ','.join(sorted({line.strip() for line in lines if line.strip()})) or 'none'
                # The signer takes inputs of at most 500 characters: a longer list is recorded as its count and digest.
                inputs[name] = value if len(value) <= 500 else f'{value.count(",") + 1} entries, sha256 {hashlib.sha256(value.encode()).hexdigest()}'
        if git('rev-parse', 'HEAD').stdout.decode().strip() != commit or (tracked_dirty() if args.aggregate else dirty()):
            raise Failure('the checkout changed while the command ran; nothing was signed')
        request = {'commit': commit, 'check': args.check, 'command': command, 'exit_code': exit_code,
                   'output_sha256': output_sha256, 'change_id': args.change_id or f'local:{commit}', 'inputs': inputs}
        if args.aggregate and facts.get('runner'):
            request['runner'] = facts['runner']
        signer, signer_env = signer_launch(json.loads(args.signer))
        done = subprocess.run(signer, input=json.dumps(request).encode(), capture_output=True, timeout=300, env=signer_env)
        if done.returncode != 0:
            raise Failure('the signer refused: ' + done.stderr.decode(errors='replace').strip()[-500:])
        answer = json.loads(done.stdout)
        record = answer['record']
        if answer.get('commit') != commit or answer.get('tree') != tree or answer.get('tier') != 'full':
            raise Failure('the signer answered for a different commit, tree or tier')
        if args.out:
            out = Path(args.out)
            out.mkdir(parents=True, exist_ok=True)
            (out / f'{record}.pack').write_bytes(base64.b64decode(answer['object_pack_base64'], validate=True))
            summary = {'record': record, 'check': args.check, 'tree': tree, 'commit': commit, 'tier': answer['tier'], 'exit_code': exit_code}
            (out / f'{record}.json').write_text(json.dumps(summary))
            print(json.dumps(summary, indent=2), file=sys.stderr)
            return 0 if exit_code == 0 else exit_code
        git('index-pack', '--stdin', stdin=base64.b64decode(answer['object_pack_base64'], validate=True))
        ref, tag = f'refs/notes/evidence/{tree}/{record}', f'refs/tags/evidence/{tree}/{record}'
        indexes = []
        key = inputs.get('source_inputs')
        if key is not None:
            # A record that signs the input key it was measured for is also indexed under it, as the CI signer's records are
            # (docs/per-crate-test-signing.md): another tree with the same key finds it by one prefix.
            indexes = [f'refs/tags/evidence/input/{args.check}/{key}/{record}', f'refs/notes/evidence-input/{args.check}/{key}/{record}']
        for name in (tag, ref, *indexes):
            if not git('for-each-ref', '--format=%(objectname)', name).stdout.strip():
                git('update-ref', name, record, '0' * len(record))
        result = {'record': record, 'ref': ref, 'tag': tag, 'tree': tree, 'check': args.check, 'exit_code': exit_code,
                  'verified': False, 'pushed': False}
        if exit_code == 0 and Path(args.verifier).exists():
            keys = ['--keys', args.keys] if args.keys else None
            if keys is None:
                shown = git('show', f'{args.keys_from}:{config_path(args.keys_from, "evidence-keys")}')
                path = Path(os.environ.get('TMPDIR', '/tmp')) / f'evidence-keys-{os.getpid()}'
                path.write_bytes(shown.stdout)
                keys = ['--keys', str(path)]
            if keys:
                # A per-crate record (one crate, one input key) is checked as that crate's: the tree's newest record of the check may be
                # another crate's, and once one crate's failed record is on the tree it answered "not verified" for every crate signed after.
                crate = inputs.get('crate', '')
                per_crate = ['--crate-key', f'{crate}={key}'] if key is not None and re.fullmatch(r'[A-Za-z0-9_][A-Za-z0-9._-]*', crate) else []
                checked = subprocess.run([sys.executable, args.verifier, '--repo', '.', '--tree', tree,
                                          '--check', args.check, *keys, *per_crate], capture_output=True)
                result['verified'] = checked.returncode == 0
                if checked.returncode != 0:
                    result['verification'] = checked.stdout.decode(errors='replace')[-500:]
        if args.push:
            if exit_code == 0 and not result['verified']:
                raise Failure('not pushing: the note did not verify locally')
            token = os.environ.get('EVIDENCE_PUSH_TOKEN', '')
            # The token travels in the environment, not in an argument any process listing would show.
            extra = {}
            if token:
                header = base64.b64encode(f'x-access-token:{token}'.encode()).decode()
                count = int(os.environ.get('GIT_CONFIG_COUNT', '0'))
                extra = {'GIT_CONFIG_COUNT': str(count + 1), f'GIT_CONFIG_KEY_{count}': 'http.extraheader',
                         f'GIT_CONFIG_VALUE_{count}': f'Authorization: Basic {header}'}
            try:
                push_refs(args.push, [tag, ref, *indexes], extra)
            except Failure as failure:
                raise Failure(str(failure).replace(token, '***') if token else str(failure))
            result['pushed'] = True
        print(json.dumps(result, indent=2), file=sys.stderr)
        return 0 if exit_code == 0 else exit_code
    except (Failure, KeyError, ValueError, OSError, subprocess.SubprocessError) as error:
        print(f'evidence-wrap: {error}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
