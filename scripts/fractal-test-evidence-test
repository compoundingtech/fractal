#!/usr/bin/env python3
"""Prove evidence survives failed collection and a killed isolated test."""
from contextlib import closing
import json
from importlib.machinery import SourceFileLoader
from importlib.util import module_from_spec, spec_from_loader
import os
from pathlib import Path
import signal
import sqlite3
import subprocess
import sys
import tempfile
import unittest
from types import SimpleNamespace
from unittest.mock import patch

sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parent))
from fractal_test_evidence import capture, finish


class EvidenceTests(unittest.TestCase):
    def test_failed_guardian_retains_omp_exit_and_stderr_after_runtime_cleanup(self):
        with tempfile.TemporaryDirectory() as directory:
            directory = Path(directory)
            root, evidence = directory / 'runtime', directory / 'evidence'
            root.mkdir()
            stderr = b'invented channel startup error\n'
            status = b'ExitStatus(unix_wait_status(512))\nexit status: 2\n'
            (root / 'omp-channel-stderr.log').write_bytes(stderr)
            (root / 'omp-channel-exit.txt').write_bytes(status)
            manifest = directory / 'manifest.jsonl'
            manifest.write_text(json.dumps({'root': str(root), 'evidence': str(evidence)}) + '\n')
            finish(manifest, 101)
            self.assertFalse(root.exists(), 'guardian must clean up its stopped runtime')
            self.assertTrue((evidence / 'omp-channel-stderr.log').is_file(),
                            'failed cleanup discarded the actual OMP child stderr')
            self.assertTrue((evidence / 'omp-channel-exit.txt').is_file(),
                            'failed cleanup discarded the actual OMP child exit status')
            self.assertEqual((evidence / 'omp-channel-stderr.log').read_bytes(), stderr)
            self.assertEqual((evidence / 'omp-channel-exit.txt').read_bytes(), status)
            self.assertEqual(json.loads((evidence / 'guardian.json').read_text())['exit'], 101)

    def test_adopted_exit_is_reaped_while_the_guardian_waits_for_owners(self):
        with tempfile.TemporaryDirectory(prefix="guardian-child-event-") as directory:
            root = Path(directory)
            fixture = root / "fixture.py"
            fixture.write_text("""
import os, select, subprocess, sys, time
from pathlib import Path
child = subprocess.Popen([sys.executable, '-c',
    'import os,time; pid=os.fork(); '
    'os._exit(0) if pid else None; '
    'print(os.getpid(),flush=True); time.sleep(0.1)'],
    stdout=subprocess.PIPE, text=True)
pid = int(child.stdout.readline())
child.wait()
fd = os.pidfd_open(pid)
try:
    poller = select.poll()
    poller.register(fd, select.POLLIN)
    assert poller.poll(3000), 'owned orphan did not exit'
finally:
    os.close(fd)
deadline = time.monotonic() + 2
while Path(f'/proc/{pid}').exists() and time.monotonic() < deadline:
    time.sleep(0.005)
assert not Path(f'/proc/{pid}').exists(), 'guardian left an adopted zombie until its owner-watch timer'
""")
            launcher = root / "launcher.py"
            launcher.write_text("""
import sys
sys.path.insert(0, sys.argv[1])
import fractal_test_process as guardian
real_poll = guardian.select.poll
class LongOwnerWait:
    def __init__(self): self.inner = real_poll()
    def register(self, *args): return self.inner.register(*args)
    def poll(self, timeout): return self.inner.poll(5000)
guardian.select.poll = LongOwnerWait
raise SystemExit(guardian.run_supervised([sys.executable, sys.argv[2]]))
""")
            env = dict(os.environ)
            for key in ('ST_AGENT', 'ST3_SUBJECT', 'FRACTAL_TEST_SUPERVISOR'):
                env.pop(key, None)
            result = subprocess.run([sys.executable, str(launcher),
                str(Path(__file__).resolve().parent), str(fixture)],
                env=env, capture_output=True, text=True, timeout=10)
            self.assertEqual(result.returncode, 0, result.stdout + result.stderr)

    def test_bad_spool_keeps_logs_and_records_its_error(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory) / "root"
            root.mkdir()
            (root / "daemon.log").write_text("daemon diagnostic")
            (root / "driver.log").write_text("driver diagnostic")
            (root / "st-harness-events.sqlite").write_text("invalid database")
            evidence = Path(directory) / "evidence"
            errors = capture(root, evidence)
            self.assertEqual(len(errors), 1)
            self.assertEqual((evidence / "daemon.log").read_text(), "daemon diagnostic")
            self.assertEqual((evidence / "driver-0.log").read_text(), "driver diagnostic")
            self.assertIn("error", json.loads((evidence / "observation-outboxes.json").read_text())[0])
            self.assertTrue((evidence / "capture-errors.json").exists())

    def test_missing_logs_are_explicit(self):
        with tempfile.TemporaryDirectory() as directory:
            evidence = Path(directory) / "evidence"
            self.assertEqual(capture(Path(directory), evidence), [])
            self.assertIn("did not create", (evidence / "daemon.log").read_text())
            self.assertIn("No driver", (evidence / "driver-0.log").read_text())
            self.assertEqual(json.loads((evidence / "observation-outboxes.json").read_text()), [])

    def test_terminal_capture_error_keeps_core_files_and_failed_verdict(self):
        loader = SourceFileLoader("boot_evidence_canary", str(Path(__file__).resolve().parent / "fractal-boot-canaries/run"))
        canary = module_from_spec(spec_from_loader(loader.name, loader))
        loader.exec_module(canary)
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory) / "root"
            root.mkdir()
            evidence = Path(directory) / "evidence"
            (root / "daemon.log").write_text("startup error")
            (root / "driver.log").write_text("driver error")
            node = SimpleNamespace(root=root, daemon=None)
            node.start = lambda: canary.fail("startup failure")
            node.pty = lambda *args: (_ for _ in ()).throw(OSError("terminal capture failure"))
            node.stop = lambda: None
            argv = ["run", "/unused-fixture", str(evidence), "claude", "fresh"]
            with patch.object(canary, "Node", return_value=node), patch.object(canary, "register"), \
                 patch.object(canary, "private_root", return_value=root), \
                 patch.object(node, "stop") as stop, patch.object(sys, "argv", argv):
                self.assertEqual(canary.main(), 1)
                stop.assert_called_once()
            self.assertEqual((evidence / "daemon.log").read_text(), "startup error")
            self.assertEqual((evidence / "driver-0.log").read_text(), "driver error")
            self.assertTrue((evidence / "observation-outboxes.json").exists())
            result = json.loads((evidence / "result.json").read_text())
            self.assertIn("terminal capture failure", result["failure"])

    def test_rollout_capture_error_also_stops_node_and_keeps_logs(self):
        loader = SourceFileLoader("rollout_evidence_canary", str(Path(__file__).resolve().parent / "fractal-rollout-binding-canary/run"))
        canary = module_from_spec(spec_from_loader(loader.name, loader))
        loader.exec_module(canary)
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory) / "root"
            root.mkdir()
            (root / "daemon.log").write_text("rollout daemon")
            (root / "driver.log").write_text("rollout driver")
            evidence = Path(directory) / "evidence"
            node = SimpleNamespace(root=root, daemon=SimpleNamespace(poll=lambda: None))
            node.cli = lambda *args, **kwargs: (_ for _ in ()).throw(OSError("rollout trace failure"))
            node.stop = lambda: None
            args = SimpleNamespace(binary=Path("/unused-fixture"), omp="/unused-provider")
            with patch.object(canary, "Node", return_value=node), patch.object(canary, "register"), \
                 patch.object(node, "stop") as stop:
                with self.assertRaisesRegex(OSError, "rollout trace failure"):
                    canary.run(args, root, evidence)
                stop.assert_called_once()
            self.assertEqual((evidence / "daemon.log").read_text(), "rollout daemon")
            self.assertEqual((evidence / "driver-0.log").read_text(), "rollout driver")
            self.assertTrue((evidence / "observation-outboxes.json").exists())

    def test_final_snapshot_preserves_the_state_before_shutdown(self):
        with tempfile.TemporaryDirectory() as directory:
            root = Path(directory)
            database = root / "st-harness-events.sqlite"
            with closing(sqlite3.connect(database)) as db, db:
                db.executescript("CREATE TABLE events(sequence INTEGER,kind TEXT); CREATE TABLE metadata(key TEXT,value TEXT); CREATE TABLE snapshots(kind TEXT,body BLOB);")
                db.execute("INSERT INTO events VALUES (7,'harness-state')")
            evidence = root / "evidence"
            capture(root, evidence)
            with closing(sqlite3.connect(database)) as db, db:
                db.execute("DELETE FROM events")
            capture(root, evidence, final=True)
            before = json.loads((evidence / "observation-outboxes.json").read_text())
            after = json.loads((evidence / "observation-outboxes-after-stop.json").read_text())
            self.assertEqual(before[0]["pending"], [[7, "harness-state"]])
            self.assertEqual(after[0]["pending"], [])

    def guardian_fixture(self, interrupt):
        with tempfile.TemporaryDirectory(prefix="evidence-proof-") as directory:
            directory = Path(directory)
            evidence = directory / "evidence"
            script = directory / "fixture.py"
            script.write_text('''
import json, os, signal, sqlite3, sys, tempfile
from pathlib import Path
from fractal_test_evidence import register
root = Path(tempfile.mkdtemp(prefix="evidence-runtime-"))
evidence = Path(sys.argv[1])
register(root, evidence)
(root / "daemon.log").write_text("daemon before kill")
(root / "driver.log").write_text("driver before kill")
with sqlite3.connect(root / "st-harness-events.sqlite") as db:
    db.executescript("CREATE TABLE events(sequence INTEGER,kind TEXT); CREATE TABLE metadata(key TEXT,value TEXT); CREATE TABLE snapshots(kind TEXT,body BLOB);")
    db.execute("INSERT INTO events VALUES (7,'harness-state')")
    db.execute("INSERT INTO snapshots VALUES ('harness-state',?)", (json.dumps({"state":"idle","incarnation":"fixture"}),))
print(root, flush=True)
if sys.argv[2] == "kill":
    signal.pause()
''')
            env = dict(os.environ)
            env.pop("ST_AGENT", None)
            env.pop("ST3_SUBJECT", None)
            env.pop("FRACTAL_TEST_SUPERVISOR", None)
            env["PYTHONPATH"] = str(Path(__file__).resolve().parent)
            guardian = Path(__file__).resolve().parent / "fractal_test_process.py"
            process = subprocess.Popen([sys.executable, str(guardian), "--", sys.executable,
                                        str(script), str(evidence), "kill" if interrupt else "pass"],
                                       env=env, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
            try:
                # The fixture's first line is its readiness, and EOF means it exited first: wait
                # for either rather than a wall-clock bound a loaded runner can outlast.
                ready = process.stdout.readline().strip()
                if not ready:
                    process.wait(timeout=10)
                    self.fail(f"fixture exited before readiness: {process.stderr.read()}")
                root = Path(ready)
                if interrupt:
                    process.kill()  # guardian's pidfd observes controller death
                process.wait(timeout=10)
                if interrupt:
                    # EOF arrives only when the detached guardian also closes the inherited pipe.
                    process.stdout.read()
                    self.assertEqual((evidence / "daemon.log").read_text(), "daemon before kill")
                    self.assertEqual((evidence / "driver-0.log").read_text(), "driver before kill")
                    rows = json.loads((evidence / "observation-outboxes.json").read_text())
                    self.assertEqual(rows[0]["pending"], [[7, "harness-state"]])
                    self.assertEqual(rows[0]["states"][0]["state"], "idle")
                    self.assertEqual(json.loads((evidence / "result.json").read_text())["guardian_exit"], -9)
                else:
                    self.assertEqual(process.returncode, 0, process.stderr.read())
                    self.assertFalse((evidence / "result.json").exists())
                self.assertFalse(root.exists(), "guardian did not remove its registered runtime")
            finally:
                if process.poll() is None:
                    process.kill()
                    process.wait()
                process.stdout.close()
                process.stderr.close()

    def test_controller_sigkill_preserves_diagnostics_then_removes_runtime(self):
        self.guardian_fixture(True)

    def test_success_removes_runtime_without_inventing_a_failure(self):
        self.guardian_fixture(False)


if __name__ == "__main__":
    unittest.main()
