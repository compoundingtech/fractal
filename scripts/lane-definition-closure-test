#!/usr/bin/env python3
"""scripts/lane-definition-closure: what it finds for each reference form, which of it a lane executes, and that every committed
lane declares what it executes and its verdict data.

The repository test holds each lane of .st/required-lanes.json to its definition: a file the lane's commands execute, or a file its
VERDICT_DATA declares, that its definition_paths do not cover fails here (run `scripts/lane-definition-closure --write` and review the
diff). It runs in ci-script-tests' sparse copy, where only that check's declared inputs exist, so there it sees the part of each lane
that lies in them; scripts/ci-genie-freshness runs `scripts/lane-definition-closure --check` over the whole tree.
"""
import importlib.machinery
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile
import unittest

sys.dont_write_bytecode = True
ROOT = Path(__file__).resolve().parent.parent
TOOL = ROOT / 'scripts/lane-definition-closure'
GIT_ENV = {k: v for k, v in os.environ.items() if not k.startswith('GIT_')}
GIT_ENV.update(GIT_CONFIG_GLOBAL='/dev/null', GIT_CONFIG_SYSTEM='/dev/null')


def load():
    loader = importlib.machinery.SourceFileLoader('lane_definition_closure', str(TOOL))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


ldc = load()


class Fixture(unittest.TestCase):
    """A small tracked tree and one lane over it."""

    def setUp(self):
        self.tmp = tempfile.TemporaryDirectory()
        self.addCleanup(self.tmp.cleanup)
        self.root = Path(self.tmp.name) / 'repo'
        self.root.mkdir()
        subprocess.run(['git', '-C', str(self.root), 'init', '-q'], check=True, env=GIT_ENV)

    def tree(self, files):
        for name, content in files.items():
            path = self.root / name
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(content)
        subprocess.run(['git', '-C', str(self.root), 'add', '-A'], check=True, env=GIT_ENV)

    def closure(self, argv, files, lane='demo'):
        self.tree(files)
        return ldc.lane_closure(ldc.Repo(self.root), {'argv': argv}, lane)

    def harness(self, lanes):
        old = ldc.HARNESS, ldc.FOLLOWED, ldc.HARNESS_LANES
        ldc.HARNESS = ('tools/ci',)
        ldc.FOLLOWED = ('scripts', 'nix') + ldc.HARNESS
        ldc.HARNESS_LANES = set(lanes)
        self.addCleanup(lambda: (setattr(ldc, 'HARNESS', old[0]), setattr(ldc, 'FOLLOWED', old[1]),
                                 setattr(ldc, 'HARNESS_LANES', old[2])))

    def paths(self, argv, files, lane='demo'):
        """Everything the walk finds: what the lane executes and what it only reads."""
        closure = self.closure(argv, files, lane)
        return sorted(set(closure.paths()) | set(closure.read()))


SH = '#!/usr/bin/env bash\n'
PY = '#!/usr/bin/env python3\n'


class ShellForms(Fixture):
    def test_each_way_a_shell_script_runs_or_reads_another(self):
        paths = self.paths(['bash', 'scripts/entry'], {
            'scripts/entry': SH + 'set -e\n. "$(dirname "$0")/sourced"\nsource scripts/also-sourced\nbash scripts/by-bash\n'
                                  'scripts/direct --flag\npython3 "$root/scripts/by-python" x\njq . .github/baseline.json\n',
            'scripts/sourced': SH + 'helper() { :; }\n', 'scripts/also-sourced': SH, 'scripts/by-bash': SH, 'scripts/direct': SH,
            'scripts/by-python': PY, '.github/baseline.json': '{}', 'scripts/unrelated': SH})
        self.assertEqual(paths, ['.github/baseline.json', 'scripts/also-sourced', 'scripts/by-bash', 'scripts/by-python',
                                 'scripts/direct', 'scripts/entry', 'scripts/sourced'])

    def test_it_follows_transitively_and_not_through_comments_or_bare_arguments(self):
        paths = self.paths(['bash', 'scripts/a'], {
            'scripts/a': SH + '# bash scripts/commented\nbash scripts/b  # and not scripts/trailing\npnpm install --frozen-lockfile\n',
            'scripts/b': SH + 'bash scripts/c\n', 'scripts/c': SH, 'scripts/commented': SH, 'scripts/trailing': SH,
            'scripts/install': SH})
        self.assertEqual(paths, ['scripts/a', 'scripts/b', 'scripts/c'])  # `pnpm install` is not scripts/install

    def test_a_glob_picks_files_and_parallel_tests_names_scripts(self):
        paths = self.paths(['bash', 'scripts/a'], {
            'scripts/a': SH + 'for t in scripts/*-check; do bash "$t"; done\nparallel_tests \\\n  one-test two-test\n',
            'scripts/x-check': SH, 'scripts/y-check': SH, 'scripts/one-test': PY, 'scripts/two-test': PY, 'scripts/three-test': PY})
        self.assertEqual(paths, ['scripts/a', 'scripts/one-test', 'scripts/two-test', 'scripts/x-check', 'scripts/y-check'])

    def test_a_word_that_is_not_a_whole_path_names_nothing(self):
        paths = self.paths(['bash', 'scripts/a'], {
            'scripts/a': SH + 'cfg="fractal-test:$junit"\necho scripts/b.sh.bak\n', 'scripts/fractal-test': PY, 'scripts/b.sh': SH})
        self.assertEqual(paths, ['scripts/a'])

    def test_bash_c_argv_is_read_as_shell(self):
        paths = self.paths(['bash', '-c', 'pnpm install && bash scripts/run'], {'scripts/run': SH, 'package.json': '{}',
                                                                                 'pnpm-lock.yaml': '', 'pnpm-workspace.yaml': ''})
        self.assertEqual(paths, ['package.json', 'pnpm-lock.yaml', 'pnpm-workspace.yaml', 'scripts/run'])


class PythonForms(Fixture):
    def test_each_way_python_runs_or_reads_a_file(self):
        paths = self.paths(['python3', 'scripts/main'], {
            'scripts/main': PY + '"""Docstrings are prose: scripts/in-docstring is not read."""\n'
                                 'import subprocess, importlib.machinery\nfrom pathlib import Path\nimport helper_mod\n'
                                 'ROOT = Path(__file__).resolve().parent.parent\nHERE = ROOT / "scripts"\n'
                                 'subprocess.run(["python3", "scripts/by-argv", "--x"])\n'
                                 'importlib.machinery.SourceFileLoader("v", str(HERE / "by-loader"))\n'
                                 'open(".st/policy.json").read()\n(ROOT / ".github" / "splits.json").read_text()\n'
                                 'name = "fleet"\n(ROOT / f".github/{name}-baseline.json").read_text()\n'
                                 'subprocess.run(["bash", "-c", "x && bash scripts/in-a-shell-line"])\n',
            'scripts/helper_mod.py': 'X = 1\n', 'scripts/by-argv': PY, 'scripts/by-loader': PY, 'scripts/in-docstring': PY,
            'scripts/in-a-shell-line': SH, '.st/policy.json': '{}', '.github/splits.json': '{}',
            '.github/fleet-baseline.json': '{}', '.github/other-baseline.json': '{}', '.github/unrelated.json': '{}'})
        self.assertEqual(paths, ['.github/fleet-baseline.json', '.github/other-baseline.json', '.github/splits.json',
                                 '.st/policy.json', 'scripts/by-argv', 'scripts/by-loader', 'scripts/helper_mod.py',
                                 'scripts/in-a-shell-line', 'scripts/main'])

    def test_a_word_in_a_message_resolves_like_a_shell_argument(self):
        paths = self.paths(['python3', 'scripts/main'], {
            'scripts/main': PY + 'raise SystemExit("node_modules is missing; run pnpm install first, or scripts/setup")\n',
            'scripts/install': SH, 'scripts/setup': SH})
        self.assertEqual(paths, ['scripts/main', 'scripts/setup'])

    def test_a_listed_directory_counts_whole_in_the_lanes_code_and_is_the_subject_elsewhere(self):
        closure = self.closure(['python3', 'scripts/main'], {
            'scripts/main': PY + 'from pathlib import Path\nROOT = Path(__file__).parent.parent\n'
                                 'for p in (ROOT / "scripts" / "fixtures").iterdir(): p.read_text()\n'
                                 'for p in (ROOT / "crates").rglob("*.rs"): p.read_text()\n',
            'scripts/fixtures/a.json': '{}', 'scripts/fixtures/b.json': '{}', 'crates/c/src/lib.rs': ''})
        self.assertEqual(closure.paths(), ['scripts/fixtures', 'scripts/main'])
        self.assertEqual(sorted(closure.listings), ['crates'])

    def test_the_tree_under_test_ends_the_walk(self):
        closure = self.closure(['python3', 'scripts/lint'], {
            'scripts/lint': PY + 'open("crates/c/build.rs").read()\nopen("Cargo.toml").read()\nopen(".config/limits.toml").read()\n',
            'crates/c/build.rs': '', 'Cargo.toml': '', '.config/limits.toml': ''})
        self.assertEqual(closure.paths(), ['scripts/lint'])
        self.assertEqual(closure.read(), ['.config/limits.toml'])
        self.assertEqual(sorted(closure.subject), ['Cargo.toml', 'crates/c/build.rs'])


class OtherForms(Fixture):
    def test_javascript_imports_and_literals(self):
        self.harness({'demo'})
        paths = self.paths(['node', 'tools/ci/run.mjs'], {
            'tools/ci/run.mjs': "// import './commented.mjs'\nimport { x } from './helper';\nconst t = `${dir}/case-${n}.json`;\n"
                                "readFileSync('.github/budget.json');\n",
            'tools/ci/helper.mjs': "import data from './data/index';\n", 'tools/ci/data/index.ts': 'export {}\n',
            'tools/ci/commented.mjs': '', 'tools/ci/case-1.json': '', '.github/budget.json': '{}'})
        self.assertEqual(paths, ['.github/budget.json', 'tools/ci'])  # HARNESS code ran: its whole directory is the definition

    def test_flake_dev_shell_and_its_bindings_only(self):
        flake = ('{\n  outputs = { self }:\n    let\n      wrapper = mk {\n        text = builtins.readFile ./scripts/wrapper;\n      };\n'
                 '      unused = builtins.readFile ./scripts/unused;\n'
                 '      devShells.default = mkShell {\n        packages = [ wrapper ];\n'
                 "        shellHook = ''\n          source ${./scripts/env}\n        '';\n      };\n"
                 '      devShells.web = import ./nix/web.nix { };\n    in { };\n}\n')
        files = {'flake.nix': flake, 'flake.lock': '{}', 'scripts/wrapper': SH, 'scripts/unused': SH, 'scripts/env': SH,
                 'scripts/run': SH, 'nix/web.nix': "{ }: mkShell { shellHook = ''\n  node -e 'read(\"inputs.json\")'\n''; }\n",
                 'inputs.json': '{}'}
        self.assertEqual(self.paths(['nix', 'develop', '-c', 'bash', 'scripts/run'], files),
                         ['flake.lock', 'flake.nix', 'scripts/env', 'scripts/run', 'scripts/wrapper'])
        self.assertEqual(self.paths(['nix', 'develop', '.#web', '-c', 'bash', 'scripts/run'], files),
                         ['flake.lock', 'flake.nix', 'inputs.json', 'nix/web.nix', 'scripts/run'])

    def test_a_pnpm_call_names_the_package_manifest_and_the_tools_it_reads(self):
        old = ldc.SUBJECT
        ldc.SUBJECT = ('apps/app', 'packages/lib')  # the workspace packages: their tests are the subject, their manifests are not
        self.addCleanup(setattr, ldc, 'SUBJECT', old)
        paths = self.paths(['bash', 'scripts/web'], {
            'scripts/web': SH + 'pnpm --filter @demo/app test\npnpm -C packages/lib run check\n',
            'package.json': '{"name": "root"}', 'pnpm-lock.yaml': '', 'pnpm-workspace.yaml': '',
            'apps/app/package.json': json.dumps({'name': '@demo/app', 'scripts': {'test': 'node --test unit.test.mjs'}}),
            'apps/app/unit.test.mjs': '',
            'packages/lib/package.json': json.dumps({'name': 'lib', 'scripts': {'check': 'bash ../../scripts/lib-check'}}),
            'scripts/lib-check': SH})
        self.assertEqual(paths, ['apps/app/package.json', 'package.json', 'packages/lib/package.json', 'pnpm-lock.yaml',
                                 'pnpm-workspace.yaml', 'scripts/lib-check', 'scripts/web'])

    def test_a_data_file_is_read_not_followed(self):
        paths = self.paths(['bash', 'scripts/a'], {
            'scripts/a': SH + 'jq . docs/list.json\nnode .github/workflows/gen.ts\n', 'docs/list.json': '["scripts/b"]',
            '.github/workflows/gen.ts': "run('scripts/c')\n", 'scripts/b': SH, 'scripts/c': SH})
        self.assertEqual(paths, ['.github/workflows/gen.ts', 'docs/list.json', 'scripts/a'])

    def test_a_tool_the_lane_runs_brings_its_convention_files(self):
        paths = self.paths(['bash', 'scripts/t'], {'scripts/t': SH + 'cargo nextest run\n', '.config/nextest.toml': '',
                                                   '.cargo/config.toml': '', '.config/other.toml': ''})
        self.assertEqual(paths, ['.cargo/config.toml', '.config/nextest.toml', 'scripts/t'])

    def test_a_tool_runs_from_a_command_word_not_from_text_about_it(self):
        paths = self.paths(['python3', 'scripts/t'], {
            'scripts/t': PY + 'import subprocess\nsubprocess.run(["cargo", "test"])\n'
                              'assert "cargo nextest run" in open("scripts/t").read()\n',
            '.cargo/config.toml': '', '.config/nextest.toml': ''})
        self.assertEqual(paths, ['.cargo/config.toml', 'scripts/t'])

    def test_naming_the_lockfile_is_not_a_pnpm_call(self):
        paths = self.paths(['python3', 'scripts/t'], {'scripts/t': PY + 'open("pnpm-lock.yaml").read()\n',
                                                      'package.json': '{}', 'pnpm-lock.yaml': ''})
        self.assertEqual(paths, ['pnpm-lock.yaml', 'scripts/t'])


class Executed(Fixture):
    """What a lane executes is its definition; what it only reads is the tree under test unless declared as verdict data."""

    def test_code_is_executed_and_data_it_names_outside_the_code_directories_is_read(self):
        closure = self.closure(['nix', 'develop', '-c', 'bash', 'scripts/a'], {
            'flake.nix': "{ outputs = { self }: let\n  devShells.default = import ./nix/shell.nix { };\nin { }; }\n",
            'flake.lock': '{}', 'nix/shell.nix': '{ }: builtins.fromJSON (builtins.readFile ../pins.json)\n', 'pins.json': '{}',
            'nix/hash': 'sha256-x', 'scripts/a': SH + 'bash scripts/b\njq . .github/baseline.json docs/x.md scripts/b.json\n'
                                                     'cat nix/hash\n',
            'scripts/b': SH, 'scripts/b.json': '{}', '.github/baseline.json': '{}', 'docs/x.md': ''})
        self.assertEqual(closure.paths(), ['flake.lock', 'flake.nix', 'nix/shell.nix', 'pins.json', 'scripts/a', 'scripts/b',
                                           'scripts/b.json'])  # what Nix code reads is the shell; scripts/ data is the lane's own
        self.assertEqual(closure.read(), ['.github/baseline.json', 'docs/x.md', 'nix/hash'])  # a script that names nix/ reads it

    def test_a_harness_is_the_runner_of_its_lanes_and_the_subject_of_the_others(self):
        self.harness({'web'})
        old = ldc.SUBJECT
        ldc.SUBJECT = ('tools',)
        self.addCleanup(setattr, ldc, 'SUBJECT', old)
        files = {'scripts/a': SH + 'node tools/ci/run.mjs\n', 'tools/ci/run.mjs': "import './helper.mjs'\n",
                 'tools/ci/helper.mjs': ''}
        self.assertEqual(self.closure(['bash', 'scripts/a'], files, 'web').paths(), ['scripts/a', 'tools/ci'])
        other = self.closure(['bash', 'scripts/a'], files, 'other')
        self.assertEqual(other.paths(), ['scripts/a'])
        self.assertEqual(sorted(other.subject), ['tools/ci/run.mjs'])

    def test_a_file_read_as_environment_configuration_must_be_declared(self):
        closure = self.closure(['bash', 'scripts/shell'], {
            'scripts/shell': SH + 'spec=$(jq -cS --slurpfile spec nix/inputs.json -f scripts/build.jq flake.lock)\n'
                                  'python3 scripts/pins\njq . docs/notes.json\n',
            'scripts/pins': PY + 'import subprocess\nsubprocess.run(["jq", "--argfile", "pins", ".github/pins.json", "-n", "$pins"])\n',
            'scripts/build.jq': '.', 'nix/inputs.json': '{}', '.github/pins.json': '{}', 'docs/notes.json': '{}', 'flake.lock': '{}'})
        self.assertEqual(sorted(closure.config), ['.github/pins.json', 'nix/inputs.json', 'scripts/build.jq'])
        self.assertEqual(closure.undeclared({}), ['.github/pins.json', 'nix/inputs.json'])  # build.jq is executed
        self.assertEqual(closure.undeclared({'nix/inputs.json': '', '.github/pins.json': ''}), [])
        self.assertNotIn('docs/notes.json', closure.config)  # jq's input (or flake.lock's) is data, not the environment

    def test_a_sparse_lane_is_walked_inside_its_inputs(self):
        old = ldc.SPARSE
        ldc.SPARSE = {'demo'}
        self.addCleanup(setattr, ldc, 'SPARSE', old)
        closure = self.closure(['bash', 'scripts/a'], {
            '.st/evidence-skip-policy.json': json.dumps({'checks': {'demo': {'inputs': ['.st', 'scripts']}}}),
            'scripts/a': SH + 'bash scripts/b\nbash tools/c\n', 'scripts/b': SH, 'tools/c': SH})
        self.assertEqual(closure.paths(), ['scripts/a', 'scripts/b'])
        self.assertEqual(closure.read(), [])


class CommandLine(Fixture):
    def lanes(self, definition, kept=None):
        (self.root / '.st').mkdir(exist_ok=True)
        lanes = {'demo': {'argv': ['bash', 'scripts/a'], 'definition_paths': definition}}
        if kept is not None:
            lanes['kept'] = {'argv': ['bash', 'scripts/a'], 'definition_paths': kept}
        (self.root / '.st/required-lanes.json').write_text(json.dumps({'version': 1, 'lanes': lanes}, indent=2) + '\n')

    def definitions(self):
        lanes = json.loads((self.root / '.st/required-lanes.json').read_text())['lanes']
        return {name: entry['definition_paths'] for name, entry in lanes.items()}

    def run_tool(self, *args):
        return subprocess.run([sys.executable, str(TOOL), '--root', str(self.root), *args], capture_output=True, text=True, env=GIT_ENV)

    def test_check_fails_a_lane_that_reads_a_protected_file_its_ci_inputs_leave_out(self):
        gate = "PROTECTED = ('scripts/judge', '.st/keys', '.github/workflows/fleet.yml')\nBASE_READ = ('.st/keys',)\n"
        self.tree({'scripts/a': SH + 'bash scripts/judge\ncat .st/keys\n', 'scripts/judge': SH, '.st/keys': 'k',
                   'scripts/ci-evidence-gate': gate, '.github/workflows/fleet.yml': 'jobs:\n  demo:\n    runs-on: box\n',
                   '.st/policy.json': '{"checks": {"demo": {}}}'})
        (self.root / '.st').mkdir(exist_ok=True)

        def lane(ci_inputs):
            entry = {'argv': ['bash', 'scripts/a'], 'definition_paths': ['scripts/a', 'scripts/judge']}
            if ci_inputs is not None:
                entry['ci_inputs'] = ci_inputs
            (self.root / '.st/required-lanes.json').write_text(json.dumps({'version': 1, 'lanes': {'demo': entry}}))
            return self.run_tool('--check')

        self.assertEqual(lane(None).returncode, 0)  # no ci_inputs: the old rule, which any protected change on main voids
        done = lane(['.github/workflows/fleet.yml::jobs.demo'])
        self.assertEqual(done.returncode, 1, done.stdout)
        self.assertIn('demo: it executes or reads the protected file scripts/judge, which its ci_inputs do not declare', done.stdout)
        self.assertNotIn('.st/keys', done.stdout)  # read only at the base: main changing it decides nothing
        self.assertEqual(lane(['scripts', '!scripts/judge']).returncode, 1)  # an exclusion leaves it out
        self.assertEqual(lane(['.github/workflows/fleet.yml::jobs.demo', 'scripts/judge']).returncode, 0, lane(['scripts/judge']).stdout)
        for typo, why in (('.github/workflows/fleet.yml::jobs.dmeo', '.github/workflows/fleet.yml has no jobs.dmeo'),
                          ('.st/policy.json::checks.dmeo', '.st/policy.json has no checks.dmeo'),
                          ('scripts/jugde', 'scripts/jugde is not in the tree')):
            with self.subTest(typo):  # names nothing: the gate would always fall back, so --check says so
                done = lane(['.github/workflows/fleet.yml::jobs.demo', 'scripts/judge', typo])
                self.assertEqual(done.returncode, 1, done.stdout)
                self.assertIn(f'demo: its ci_inputs entry {typo} names nothing ({why})', done.stdout)

    def test_check_names_an_uncovered_file_and_write_fixes_it(self):
        self.tree({'scripts/a': SH + 'bash scripts/b\n', 'scripts/b': SH})
        self.lanes(['scripts/a'])
        done = self.run_tool('--check')
        self.assertEqual(done.returncode, 1, done.stdout + done.stderr)
        self.assertIn('scripts/b   (named by scripts/a)', done.stdout)
        self.lanes(['scripts'])  # a parent directory covers the files below it
        self.assertEqual(self.run_tool('--check').returncode, 0)
        self.lanes(['scripts/a'])
        self.assertEqual(self.run_tool('--write').returncode, 0)
        self.assertEqual(json.loads((self.root / '.st/required-lanes.json').read_text())['lanes']['demo']['definition_paths'],
                         ['scripts/a', 'scripts/b'])
        self.assertEqual(self.run_tool('--check').returncode, 0)
        self.assertEqual(self.run_tool('--lane', 'nope').returncode, 2)

    def test_verdict_data_is_declared_and_kept_lanes_are_left_alone(self):
        tool = TOOL.read_text()
        tool = tool.replace("KEPT = {'ci-script-tests', 'genie-freshness'}", "KEPT = {'kept'}")
        tool = tool.replace("VERDICT_DATA = {\n", "VERDICT_DATA = {\n    'demo': {'.github/baseline.json': 'the bar'},\n", 1)
        patched = Path(self.tmp.name) / 'lane-definition-closure'
        patched.write_text(tool)
        run = lambda *args: subprocess.run([sys.executable, str(patched), '--root', str(self.root), *args],
                                           capture_output=True, text=True, env=GIT_ENV)
        self.tree({'scripts/a': SH + 'jq . .github/baseline.json docs/x.json\n', '.github/baseline.json': '{}', 'docs/x.json': '{}'})
        self.lanes(['scripts/a'], kept=['scripts'])
        done = run('--check')
        self.assertEqual(done.returncode, 1, done.stdout + done.stderr)
        self.assertIn('.github/baseline.json   (the bar)', done.stdout)
        self.assertNotIn('docs/x.json', done.stdout)  # read, not executed: the tree under test
        self.assertEqual(run('--write').returncode, 0)
        self.assertEqual(self.definitions(), {'demo': ['.github/baseline.json', 'scripts/a'], 'kept': ['scripts']})
        self.assertEqual(run('--check').returncode, 0)
        self.lanes(['.github/baseline.json', 'scripts/a'], kept=['.github'])  # a kept lane is still held to what it executes
        done = run('--check')
        self.assertEqual(done.returncode, 1)
        self.assertIn('kept: 1 file(s) the lane executes are not in its definition_paths', done.stdout)
        self.tree({'scripts/a': SH + 'jq . .github/baseline.json docs/x.json\njq -n --slurpfile spec docs/spec.json .\n',
                   'docs/spec.json': '{}'})
        self.lanes(['.github/baseline.json', 'scripts/a'], kept=['scripts'])
        done = run('--check')
        self.assertEqual(done.returncode, 1)
        self.assertIn('demo: docs/spec.json is read as environment configuration by scripts/a', done.stdout)
        self.assertNotIn('kept: docs/spec.json', done.stdout)  # a KEPT lane is not held to it
        self.tree({'scripts/a': SH + 'jq . .github/baseline.json docs/x.json\n'})
        (self.root / '.github/baseline.json').unlink()
        subprocess.run(['git', '-C', str(self.root), 'add', '-A'], check=True, env=GIT_ENV)
        self.lanes(['.github/baseline.json', 'scripts/a'], kept=['scripts'])
        done = run('--check')
        self.assertEqual(done.returncode, 1)
        self.assertIn('demo: verdict data .github/baseline.json is not a tracked file', done.stdout)


class CommittedLanes(unittest.TestCase):
    def test_every_lane_executes_and_declares_only_what_its_definition_paths_cover(self):
        lanes = json.loads((ROOT / '.st/required-lanes.json').read_text())['lanes']
        repo = ldc.Repo(ROOT)
        for name, entry in sorted(lanes.items()):
            closure = ldc.lane_closure(repo, entry, name)
            missing = [path for path in closure.paths() if not ldc.covered(path, entry['definition_paths'])]
            self.assertEqual(missing, [], f'lane {name} executes files its definition_paths do not cover (named by '
                             f'{sorted({closure.why.get(p) or closure.why.get(p + "/") for p in missing})}); '
                             'run scripts/lane-definition-closure --write and review the diff')
            verdict = [path for path in ldc.VERDICT_DATA.get(name, {}) if not ldc.covered(path, entry['definition_paths'])]
            self.assertEqual(verdict, [], f'lane {name} declares verdict data its definition_paths do not cover')

    def test_the_tables_name_lanes_and_paths_that_exist(self):
        lanes = json.loads((ROOT / '.st/required-lanes.json').read_text())['lanes']
        self.assertLessEqual(set(ldc.EXTRA), set(lanes))
        self.assertLessEqual(set(ldc.VERDICT_DATA) | ldc.KEPT | ldc.SPARSE | ldc.HARNESS_LANES, set(lanes))
        repo = ldc.Repo(ROOT)
        for lane in sorted(ldc.SPARSE):
            inputs = ldc.sparse_inputs(repo, lane)
            runner = next(word for word in lanes[lane]['argv'] if word.startswith('scripts/'))
            self.assertIn(f'--check {lane}', (ROOT / runner).read_text(), f'{runner} no longer runs in a sparse copy')
            for path in sorted(ldc.VERDICT_DATA.get(lane, {})):
                self.assertTrue(ldc.covered(path, inputs), path)
        # This runs in ci-script-tests' sparse copy, which holds only that check's inputs: a verdict-data file outside them is absent
        # here, and the whole-tree `--check` in genie-freshness holds it to existing instead.
        inputs = ldc.sparse_inputs(repo, 'ci-script-tests')
        for lane, paths in sorted(ldc.VERDICT_DATA.items()):
            for path in sorted(p for p in paths if ldc.covered(p, inputs)):
                self.assertIn(path, repo.files, f'VERDICT_DATA {lane}: {path} is not a tracked file')
        for path in sorted(ldc.NOT_FOLLOWED | set(ldc.NOT_READ)):
            self.assertTrue(path.startswith('scripts/') and (ROOT / path).is_file(), path)  # scripts/ is in the sparse copy too
        for referrer, paths in sorted(ldc.NOT_READ.items()):
            text = (ROOT / referrer).read_text()
            for path in sorted(paths):
                self.assertIn(path, text, f'{referrer} no longer names {path}: drop it from NOT_READ')


if __name__ == '__main__':
    unittest.main()
