objective "person-read-fresh" {
  about "An agents list with legacy fresh=true or an explicit min_cut asks to wait for publication; ordinary st agents ls and tree do not. Explicit waits have their own target and count toward no other"
  indicator "latency" {
    path "GET /v1/client/agents (fresh)"
  }
  target "p99" within="300ms"
}
objective "projection-fresh" {
  about "From a commit to the published missions, agents or attention view that carries it, timed by each refresher; refreshers fold at most once a second"
