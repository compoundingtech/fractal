version 2

// compoundingtech/fractal's Workspace CI objectives, declared over the `github.workflow-run` claims
// the repository's poller writes, one per completed run (docs/st3/plugins.md). Every member
// evaluates them from the replicated claims. Publish with `fractal apply slo/fractal-ci.kdl`.
//
// Owners (each objective's `on-breach owner=`) follow the domain split of 2026-11-13.

objective "fractal/merge-latency" {
  about "A merge group's time in the merge queue, from the group entering it to its Workspace CI run going green"
  indicator "interval" {
    subject-prefix "github-workflow-run/compoundingtech/fractal/"
    start "github.workflow-run" at="created_at"
    stop "github.workflow-run" at="completed_at"
    only "workflow" "Workspace CI"
    only "event" "merge_group"
    only "conclusion" "success"
    only "attempt" "1"
  }
  window "1d"
  target "p50" within="10m"
  target "p95" within="10m"
  on-breach "fault" owner="agent/compoundingtech/mergemaster" backup="agent/dotfiles/ci-manager" condition="merge-latency-slo-missed"
}

objective "fractal/ci-critical-path" {
  about "Workspace CI's critical path on a pull request, from its run starting to all checks green"
  indicator "interval" {
    subject-prefix "github-workflow-run/compoundingtech/fractal/"
    start "github.workflow-run" at="started_at"
    stop "github.workflow-run" at="completed_at"
    only "workflow" "Workspace CI"
    only "event" "pull_request"
    only "conclusion" "success"
    only "attempt" "1"
  }
  window "1d"
  target "p95" within="13m"
  on-breach "fault" owner="agent/dotfiles/build-capacity" backup="agent/dotfiles/bottlenecks" condition="ci-critical-path-slo-missed"
}

objective "fractal/flakes" {
  about "Workspace CI runs with a flake: a test nextest passed only on a retry, or a merge group ejected from the queue"
  indicator "count" {
    subject-prefix "github-workflow-run/compoundingtech/fractal/"
    event "github.workflow-run" at="completed_at"
    only "workflow" "Workspace CI"
    exclude "flakes" "0"
  }
  window "1h"
  target "per-hour" max=0
  on-breach "fault" owner="agent/dotfiles/build-capacity" backup="agent/compoundingtech/mergemaster" condition="flakes-slo-missed"
}
