version 2

// Invented placement, paths and subjects. Adapt the Python and daemon socket paths
// before previewing and applying; argv entries do not expand shell variables.
// This is a Python program seat; no model harness or secret value is declared.
agent "example/discord-bridge" {
  name "Discord bridge"
  host "local"
  workspace "/srv/example/fractal"
  restart "always"
  tags st3.adapter.sources="external/discord/user/404,external/discord/user/606" st3.adapter.target="agent/example/discord-test"
  argv "/usr/bin/python3" "-I" "/srv/example/fractal/scripts/st3-discord-bridge" "run" "--agent" "agent/example/discord-test" "--socket" "/run/user/1000/st3.sock" "--route" "/srv/example/discord/trial.json" "--allow-user" "606" "--token-file" "/srv/example/discord/bot.env"
}
