version 2

// A durable coordinating seat that may reorder the worker seat's queue.
//
// In free mode an agent can move any seat's queue, as itself. This declaration does not
// restrict that authority; queue moves record the executing agent as their actor.
//
// Apply it as a person, after one of the worker seat files beside it:
//
//   st apply --no-gate-check examples/fractal/seats/chief.kdl --as person/operator
//
// The chief then moves a queued run with its own identity, and the move records it as the actor:
//
//   st agents queue move agent/example/worker mission-run/example/release-notes/2026-10-01 \
//     --top --reason "the release needs its notes first" --as agent/example/chief
//
// ../seat-queue.kdl walks through the complete queue.
agent "example/chief" {
  workspace "/srv/example/app"
  restart "always"
  harness "omp" {
    model "openai-codex/gpt-6-astra"
    effort "medium"
  }
}
