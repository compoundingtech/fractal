{
  "$defs": {
    "NoticeActor": {
      "pattern": "^(?:agent|person)/[^\\s]+$",
      "type": "string",
      "x-st-ref": [
        "agent",
        "person"
      ]
    },
    "NoticeAgent": {
      "pattern": "^(?:agent)/[^\\s]+$",
      "type": "string",
      "x-st-ref": "agent"
    },
    "NoticeClaimId": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string",
      "x-st-brand": "NoticeClaimId"
    },
    "NoticeCreated": {
      "additionalProperties": false,
      "description": "Immutable producer input. Lengths count Unicode characters. Admission additionally caps serialized claim fields at 65536 UTF-8 bytes; JSON Schema cannot express an encoded-object byte budget. Logical identity is (authenticated producer, dedupe_key). Informational even at confirm urgency; an answer requires a native ask.",
      "properties": {
        "body": {
          "maxLength": 20000,
          "type": "string"
        },
        "created_at": {
          "$ref": "#/$defs/NoticeTimestamp"
        },
        "dedupe_key": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        "expires_at": {
          "$ref": "#/$defs/NoticeTimestamp"
        },
        "intent": {
          "enum": [
            "done",
            "failed",
            "blocked",
            "fyi"
          ]
        },
        "links": {
          "items": {
            "$ref": "#/$defs/NoticeLink"
          },
          "maxItems": 10,
          "type": "array"
        },
        "recipient": {
          "$ref": "#/$defs/NoticePerson"
        },
        "requested": {
          "type": "boolean"
        },
        "resource": {
          "pattern": "^(?:resource)/[^\\s]+$",
          "type": "string",
          "x-st-ref": "resource"
        },
        "schema_version": {
          "const": 1
        },
        "source": {
          "$ref": "#/$defs/NoticeSource"
        },
        "speech": {
          "maxLength": 300,
          "minLength": 1,
          "type": "string"
        },
        "summary": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[^\\r\\n\\u0085\\u2028\\u2029]+$",
          "type": "string"
        },
        "urgency": {
          "enum": [
            "info",
            "attention",
            "confirm"
          ]
        }
      },
      "required": [
        "schema_version",
        "dedupe_key",
        "resource",
        "recipient",
        "intent",
        "urgency",
        "requested",
        "summary",
        "links",
        "source",
        "created_at"
      ],
      "type": "object"
    },
    "NoticeDelivery": {
      "description": "Per-adapter evidence, not physical audibility or person acknowledgement. Delivered requires an adapter outcome receipt.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "state": {
              "const": "pending"
            },
            "surface": {
              "enum": [
                "tray",
                "speech",
                "push",
                "log"
              ]
            }
          },
          "required": [
            "state",
            "surface"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "completed_at": {
              "$ref": "#/$defs/NoticeTimestamp"
            },
            "evidence": {
              "enum": [
                "spoken",
                "shown",
                "logged"
              ]
            },
            "outcome_claim": {
              "$ref": "#/$defs/NoticeClaimId"
            },
            "state": {
              "const": "delivered"
            },
            "surface": {
              "enum": [
                "tray",
                "speech",
                "push",
                "log"
              ]
            }
          },
          "required": [
            "state",
            "surface",
            "outcome_claim",
            "completed_at",
            "evidence"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "outcome_claim": {
              "$ref": "#/$defs/NoticeClaimId"
            },
            "reason": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "state": {
              "const": "failed"
            },
            "surface": {
              "enum": [
                "tray",
                "speech",
                "push",
                "log"
              ]
            }
          },
          "required": [
            "state",
            "surface",
            "outcome_claim",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "reason": {
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            "state": {
              "const": "suppressed"
            },
            "surface": {
              "enum": [
                "tray",
                "speech",
                "push",
                "log"
              ]
            }
          },
          "required": [
            "state",
            "surface",
            "reason"
          ],
          "type": "object"
        }
      ]
    },
    "NoticeDismissParameters": {
      "additionalProperties": false,
      "properties": {
        "notice_id": {
          "$ref": "#/$defs/NoticeId"
        }
      },
      "required": [
        "notice_id"
      ],
      "type": "object"
    },
    "NoticeFence": {
      "additionalProperties": false,
      "description": "Notice-domain fence; delivery-only changes do not invalidate person controls. Null means no control has been accepted.",
      "properties": {
        "control_revision": {
          "oneOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "notice_id": {
          "$ref": "#/$defs/NoticeId"
        },
        "source_revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "notice_id",
        "source_revision",
        "control_revision"
      ],
      "type": "object"
    },
    "NoticeId": {
      "pattern": "^custom/attention/snapshot/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string",
      "x-st-brand": "NoticeId"
    },
    "NoticeIntegrity": {
      "description": "Unavailable/conflicted is never an actionable empty-success substitute. Manifest projection state remains explicit.",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "manifest_claim": {
              "$ref": "#/$defs/NoticeClaimId"
            },
            "manifest_state": {
              "const": "ready"
            },
            "state": {
              "const": "ready"
            }
          },
          "required": [
            "state",
            "manifest_state",
            "manifest_claim"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "manifest_state": {
              "enum": [
                "ready",
                "missing",
                "invalid",
                "rebuilding",
                "stale"
              ]
            },
            "reason": {
              "enum": [
                "invalid-source",
                "missing-source",
                "missing-registration",
                "rebuilding",
                "stale"
              ]
            },
            "state": {
              "const": "unavailable"
            }
          },
          "required": [
            "state",
            "manifest_state",
            "reason"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "creation_claims": {
              "items": {
                "$ref": "#/$defs/NoticeClaimId"
              },
              "minItems": 2,
              "type": "array",
              "uniqueItems": true
            },
            "manifest_state": {
              "enum": [
                "ready",
                "conflicted"
              ]
            },
            "state": {
              "const": "conflicted"
            }
          },
          "required": [
            "state",
            "manifest_state",
            "creation_claims"
          ],
          "type": "object"
        }
      ]
    },
    "NoticeLink": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "url": {
          "format": "uri-reference",
          "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:",
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "type": "object"
    },
    "NoticePerson": {
      "pattern": "^(?:person)/[^\\s]+$",
      "type": "string",
      "x-st-ref": "person"
    },
    "NoticePolicy": {
      "additionalProperties": false,
      "properties": {
        "availability_basis": {
          "$ref": "#/$defs/NoticeClaimId"
        },
        "disposition": {
          "enum": [
            "deliver",
            "held",
            "suppressed"
          ]
        },
        "reason": {
          "minLength": 1,
          "pattern": "\\S",
          "type": "string"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        }
      },
      "required": [
        "disposition",
        "reason",
        "revision",
        "availability_basis"
      ],
      "type": "object"
    },
    "NoticeSeenParameters": {
      "additionalProperties": false,
      "properties": {
        "notice_id": {
          "$ref": "#/$defs/NoticeId"
        }
      },
      "required": [
        "notice_id"
      ],
      "type": "object"
    },
    "NoticeSnapshot": {
      "additionalProperties": false,
      "description": "Internal joined read model, not a registered Resource arm. Producer input and lineage are immutable; runtime owns policy/delivery, person owns controls. Null snooze is cleared/absent and never revives earlier values.",
      "properties": {
        "basis_claim": {
          "$ref": "#/$defs/NoticeClaimId"
        },
        "control_revision": {
          "oneOf": [
            {
              "$ref": "#/$defs/Revision"
            },
            {
              "type": "null"
            }
          ]
        },
        "creation_claims": {
          "items": {
            "$ref": "#/$defs/NoticeClaimId"
          },
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "delivery": {
          "items": {
            "$ref": "#/$defs/NoticeDelivery"
          },
          "maxItems": 4,
          "type": "array"
        },
        "dismissed_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/NoticeTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "id": {
          "$ref": "#/$defs/NoticeId"
        },
        "input": {
          "$ref": "#/$defs/NoticeCreated"
        },
        "integrity": {
          "$ref": "#/$defs/NoticeIntegrity"
        },
        "kind": {
          "const": "attention-notice"
        },
        "policy": {
          "$ref": "#/$defs/NoticePolicy"
        },
        "producer": {
          "$ref": "#/$defs/NoticeActor"
        },
        "revision": {
          "$ref": "#/$defs/Revision"
        },
        "runtime": {
          "pattern": "^(?:host)/[^\\s]+$",
          "type": "string",
          "x-st-ref": "host"
        },
        "schema_version": {
          "const": 1
        },
        "seen_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/NoticeTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "snoozed_until": {
          "oneOf": [
            {
              "$ref": "#/$defs/NoticeTimestamp"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_id": {
          "$ref": "#/$defs/NoticeSourceId"
        },
        "source_revision": {
          "$ref": "#/$defs/Revision"
        },
        "updated_at": {
          "$ref": "#/$defs/NoticeTimestamp"
        }
      },
      "required": [
        "id",
        "kind",
        "schema_version",
        "revision",
        "updated_at",
        "source_id",
        "creation_claims",
        "basis_claim",
        "source_revision",
        "producer",
        "runtime",
        "input",
        "policy",
        "delivery",
        "integrity",
        "seen_at",
        "dismissed_at",
        "snoozed_until",
        "control_revision"
      ],
      "type": "object"
    },
    "NoticeSnoozeParameters": {
      "additionalProperties": false,
      "properties": {
        "notice_id": {
          "$ref": "#/$defs/NoticeId"
        },
        "until": {
          "oneOf": [
            {
              "$ref": "#/$defs/NoticeTimestamp"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "notice_id",
        "until"
      ],
      "type": "object"
    },
    "NoticeSource": {
      "additionalProperties": false,
      "description": "Execution-context provenance; repository and cwd are informational, never authenticated sender evidence.",
      "properties": {
        "agent": {
          "$ref": "#/$defs/NoticeAgent"
        },
        "cwd": {
          "type": "string"
        },
        "host": {
          "pattern": "^(?:host)/[^\\s]+$",
          "type": "string",
          "x-st-ref": "host"
        },
        "pty": {
          "pattern": "^(?:pty)/[^\\s]+$",
          "type": "string",
          "x-st-ref": "pty"
        },
        "repo": {
          "type": "string"
        }
      },
      "required": [
        "host"
      ],
      "type": "object"
    },
    "NoticeSourceId": {
      "pattern": "^custom/attention/source/[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string",
      "x-st-brand": "NoticeSourceId"
    },
    "NoticeTimestamp": {
      "description": "RFC3339 UTC instant. A snooze action additionally requires a future deadline at admission.",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
      "type": "string",
      "x-st-codec": "lossless-timestamp"
    },
    "Revision": {
      "description": "Opaque per-subject revision; compare for equality, echo in fences.",
      "maxLength": 256,
      "minLength": 1,
      "type": "string",
      "x-st-brand": "Revision"
    }
  }
}
