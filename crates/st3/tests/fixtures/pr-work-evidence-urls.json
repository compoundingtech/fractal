      "why": "positive decimal number"
    },
    {
      "input": "  https://github.com/fixture/garden/pull/12  ",
      "expected": "https://github.com/fixture/garden/pull/12",
      "why": "outer whitespace only"
    },
    {
      "input": "https://github.com/fixture/orchard/pull/12",
      "expected": "https://github.com/fixture/orchard/pull/12",
      "why": "different repository stays different"
    },
    {
