  "cases": [
    {
      "input": "https://github.com/fixture/garden/pull/12",
      "expected": "https://github.com/fixture/garden/pull/12",
      "why": "canonical"
    },
    {
      "input": "http://github.com/fixture/garden/pull/12",
      "expected": "https://github.com/fixture/garden/pull/12",
      "why": "scheme alias"
    },
    {
      "input": "HTTPS://GITHUB.COM/Fixture/Garden/pull/12",
      "expected": "https://github.com/fixture/garden/pull/12",
      "why": "scheme/host/repository case"
    },
    {
      "input": "https://github.com/fixture/garden/pulls/12",
      "expected": "https://github.com/fixture/garden/pull/12",
      "why": "explicit pull/pulls alias"
    },
    {
      "input": "https://github.com/fixture/garden/pull/12/",
      "expected": "https://github.com/fixture/garden/pull/12",
      "why": "trailing slash"
    },
    {
      "input": "https://github.com/fixture/garden/pull/12/files",
