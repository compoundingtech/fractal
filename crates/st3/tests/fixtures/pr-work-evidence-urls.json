      "why": "subpage/trailing slash/fragment"
    },
    {
      "input": "https://github.com/fixture/garden/pull/12#issuecomment-123",
      "expected": "https://github.com/fixture/garden/pull/12",
      "why": "comment fragment is PR-level association, not creation evidence"
    },
    {
      "input": "https://github.com/fixture/garden/pull/12?w=1&tab=files",
