      "why": "known PR subpage"
    },
    {
      "input": "https://github.com/fixture/garden/pull/12/commits",
      "expected": "https://github.com/fixture/garden/pull/12",
      "why": "known PR subpage"
    },
    {
      "input": "https://github.com/fixture/garden/pull/12/checks",
      "expected": "https://github.com/fixture/garden/pull/12",
      "why": "known PR subpage"
    },
    {
      "input": "https://github.com/fixture/garden/pull/12/files/#diff-fixture",
