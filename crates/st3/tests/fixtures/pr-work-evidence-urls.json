    },
    {
      "input": "ssh://github.com/fixture/garden/pull/12",
      "expected": null,
      "why": "unsupported URL scheme"
    },
    {
      "input": "https://github.com/fixture/gar den/pull/12",
      "expected": null,
      "why": "embedded whitespace"
    },
    {
      "input": "https://github.com/fixture/garden/pull/12\n/files",
      "expected": null,
      "why": "embedded control character"
    },
    {
      "input": "https://github.com/fixture/../garden/pull/12",
      "expected": null,
      "why": "dot-segment path must not be normalized into another identity"
    },
    {
      "input": "https://github.com/fixture/garden/PULL/12",
      "expected": null,
      "why": "provider path token remains case-sensitive"
    },
    {
      "input": "https://www.github.com/fixture/garden/pull/12",
      "expected": null,
      "why": "no undocumented host alias or network redirect"
    }
  ],
  "invariants": [
    "No network call, branch-name lookup, repository-rename inference or substring match.",
    "Normalization is idempotent; equivalent accepted inputs produce the same key.",
    "Accepted distinct repository/owner/number values cannot collide.",
    "Keep original evidence in the original immutable claim; the index retains its claim ID and ordinal instead of duplicating a sensitive URL.",
    "Unsupported provider/path is explicit; a valid supported URL without indexed citations is a separate no-match state.",
    "The product function will be shared by evidence-index maintenance, Git PR-mapping index and work-find lookup; existing watch parsing retains its broader issue/reference contract."
  ]
}
