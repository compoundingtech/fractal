{
  "schema_version": 1,
  "host": "fixture-nvme",
  "platform": "linux-systemd",
  "mem_available_floor": {
    "coverage": "enforced",
    "value": "16G"
  },
  "slice_psi": {
    "memory": {
      "coverage": "enforced",
      "value": {
        "window": "avg60",
        "percent": 10,
        "target_slice": "app-capped.slice"
      }
    },
    "cpu": {
      "coverage": "enforced",
      "value": {
        "window": "avg300",
        "percent": 20,
        "target_slice": "app-capped.slice"
      }
    }
  },
  "slices": [
    {
      "name": "app-capped.slice",
      "memory": {
        "max": {
          "coverage": "enforced",
          "value": "16G"
        },
        "high": {
          "coverage": "enforced",
          "value": "16G"
        }
      },
      "cpu": {
        "coverage": "not-enforced",
        "reason": "CPU limits are not configured"
      },
      "swap": {
        "max": {
          "coverage": "enforced",
          "value": "0"
        }
      },
      "tasks": {
        "max": {
          "coverage": "not-enforced",
          "reason": "task admission is not enabled"
        }
      },
      "io": {
        "coverage": "not-enforced",
        "reason": "no IO admission input on NVMe with scheduler none"
      }
    },
    {
      "name": "app-capped-jobs.slice",
      "memory": {
        "max": {
          "coverage": "enforced",
          "value": "16G"
        },
        "high": {
          "coverage": "enforced",
          "value": "14G"
        }
      },
      "cpu": {
        "coverage": "not-enforced",
        "reason": "CPU limits are not configured"
      },
      "swap": {
        "max": {
          "coverage": "enforced",
          "value": "0"
        }
      },
      "tasks": {
        "max": {
          "coverage": "not-enforced",
          "reason": "task admission is not enabled"
        }
      }
    }
  ]
}
