version 2

agent "docs/editor" {
  workspace "."
  command "true"
}

agent "docs/writer" {
  workspace "."
  under "agent/docs/editor" reason="The editor reviews the writer's work."
  command "true"
}

mission "docs/daily-review" state="ready" report-to="agent/docs/editor" {
  goal "Review the documentation each day."
  completion { when "all-steps-exhausted" }
  step "review" {
    assigned-to "agent/docs/writer"
    goal "Review the documentation and report corrections."
  }
}

schedule "docs/daily-review" {
  host "local"
  every "1d"
  anchor "2026-01-01T09:00:00Z"
  catch-up "latest"
  work {
    mission "mission/docs/daily-review@41008d5f204b6853138a61dc4d3c1badf3deb110b2167dff3cbf6e8154d56370"
    workspace "."
  }
}
