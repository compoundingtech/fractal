{
  "name": "@fractal/sdk",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    "./admission": "./src/effect/admission.ts",
    "./effect": "./src/effect/mod.ts"
  },
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fractal/client": "workspace:^",
    "effect": "4.0.0"
  },
  "devDependencies": {
    "@effect/vitest": "4.0.0",
    "@types/node": "24.10.0",
    "typescript": "6.0.3",
