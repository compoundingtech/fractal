  step "program" timeout="2h" {
    program "/bundles/7c7167865e23d451ee406b6da51d7f4d6bb2c4b09e5cda7fae474c347cc2c403.mjs" sha256="7c7167865e23d451ee406b6da51d7f4d6bb2c4b09e5cda7fae474c347cc2c403" stalled-after="10m"
  }
}
