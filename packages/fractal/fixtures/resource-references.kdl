version 2
agent "fleet/observer" {
  resource "roll-authority" subject="resource/fleet/roll-completion" reason="Read the declared roll authority."
  resource "source" uri="git+ssh://example.org/fleet%2Frepo" reason="Track the exact source URI."
}
mission "fleet/review" state="ready" report-to="agent/fleet/observer" {
  resource "roll-authority" subject="resource/fleet/roll-completion" reason="Read the declared roll authority."
  resource "source" uri="git+ssh://example.org/fleet%2Frepo" reason="Track the exact source URI."
  goal "Review roll completion."
}
