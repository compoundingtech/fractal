version 2
agent "demo/release-driver" {
  resource "roll-authority" reason="Read the declared roll authority." subject="resource/demo/release-completion"
  resource "source" reason="Track the exact source URI." uri="git+ssh://example.org/demo%2Frepo"
}
mission "demo/review" report-to="agent/demo/release-driver" state="ready" {
  resource "roll-authority" reason="Read the declared roll authority." subject="resource/demo/release-completion"
  resource "source" reason="Track the exact source URI." uri="git+ssh://example.org/demo%2Frepo"
  goal "Review roll completion."
}
