version 2
agent "demo/release-driver" {
  resource "roll-authority" subject="resource/demo/release-completion" reason="Read the declared roll authority."
  resource "source" uri="git+ssh://example.org/demo%2Frepo" reason="Track the exact source URI."
}
mission "demo/review" state="ready" report-to="agent/demo/release-driver" {
  resource "roll-authority" subject="resource/demo/release-completion" reason="Read the declared roll authority."
  resource "source" uri="git+ssh://example.org/demo%2Frepo" reason="Track the exact source URI."
  goal "Review roll completion."
}
