version 2
mission "pr-landing" report-to="agent/team/worker" state="ready" {
  input "pr" kind="resource"
  input "commit" kind="text"
  input "locator" kind="text"
  goal "Review, verify and land one exact PR."
  gate "receipt" {
    field "text" "message/mission-run/${ST_MISSION_RUN}/land" "is" "The PR was landed."
  }
  step "review" {
    assigned-to "agent/team/worker"
    goal "Review the exact PR input and publish the review report."
    produces {
      resource "mission-run/${ST_MISSION_RUN}/review/report" {
        state "approved"
        kind "custom.garden.review"
      }
    }
    gate "open-pr" {
      field "state" "${input.pr}" "is" "open"
    }
    gate "review" mode="approve" type="human" {
      reviewer "person/reviewer"
      review "${input.pr}"
    }
  }
  step "ci" {
    assigned-to "agent/team/worker"
    depends-on {
      step "review" "completed"
    }
    goal "Verify CI for the supplied exact commit."
    gate "reviewed" {
      field "state" "resource/mission-run/${ST_MISSION_RUN}/review/report" "is" "approved"
    }
    gate "build" {
      ci-passed "build" commit="${input.commit}" repo="acme/garden"
    }
  }
  step "land" {
    assigned-to "agent/team/worker"
    depends-on {
      step "ci" "completed"
    }
    goal "Land the supplied PR and publish its landing receipt."
    produces {
      message "mission-run/${ST_MISSION_RUN}/land" {
        text "The PR was landed."
      }
    }
    gate "merged" {
      merged "${input.locator}"
    }
  }
}
