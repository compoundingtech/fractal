# Test groups that run only in the daily run (docs/ci.md, Daily long lanes). scripts/ci-nextest
# leaves them out of every other selection: pull requests, merge groups and local runs, unless
# CI_TEST_LANE=daily. A group moves here once its per-PR contract tests run on every pull
# request and the daily run has been green three days (doc/fleet/factory/test-speed/core-vs-daily).
# One nextest filterset per line; the lines are joined with `or`.

# Two real daemons, a TCP link proxy, the previous release and real 20-25 s waits: about 330 s
# per run. Per-PR contracts: smallclaims worker_tests (link outage) and fractal-api-core tests
# (refused handoff), #3456; mailbox restart recovery and delivery_presence, already per PR.
package(=fractal) and binary(=integration) and test(/^messaging_faults::/)
