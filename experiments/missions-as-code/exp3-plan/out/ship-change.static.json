{
  "mission": "orchard/ship-change",
  "plan": {
    "type": "wrap",
    "inner": {
      "type": "frame",
      "name": "Effect.gen",
      "body": {
        "type": "seq",
        "items": [
          {
            "type": "parallel",
            "items": [
              {
                "type": "wrap",
                "inner": {
                  "type": "wrap",
                  "inner": {
                    "type": "op",
                    "kind": "step",
                    "id": "build",
                    "idForm": "literal",
                    "title": "Build the change",
                    "assignedTo": "builder",
                    "uses": [],
                    "at": "ship-change.ts:24"
                  },
                  "annotations": [
                    {
                      "type": "retry",
                      "detail": "{ times: 2, schedule: Schedule.exponential(\"1 minute\") }"
                    }
                  ]
                },
                "annotations": [
                  {
                    "type": "timer-name",
                    "detail": "build-backoff"
                  }
                ]
              },
              {
                "type": "op",
                "kind": "step",
                "id": "docs",
                "idForm": "literal",
                "title": "Update the docs",
                "assignedTo": "builder",
                "uses": [],
                "at": "ship-change.ts:28"
              }
            ],
            "concurrency": "unbounded"
          },
          {
            "type": "wrap",
            "inner": {
              "type": "op",
              "kind": "step",
              "id": "review",
              "idForm": "literal",
              "title": "Review the change",
              "assignedTo": "reviewer",
              "uses": [
                "build",
                "docs"
              ],
              "at": "ship-change.ts:34"
            },
            "annotations": [
              {
                "type": "escalate",
                "detail": "review-deadline after 4 hours",
                "handler": {
                  "type": "seq",
                  "items": [
                    {
                      "type": "op",
                      "kind": "ask",
                      "id": "review-overdue",
                      "idForm": "literal",
                      "title": "The review is overdue",
                      "assignedTo": "person/wren",
                      "uses": [],
                      "at": "ship-change.ts:41"
                    },
                    {
                      "type": "branch",
                      "condition": "answer.id === \"reassign\"",
                      "uses": [
                        "review-overdue"
                      ],
                      "arms": [
                        {
                          "label": "yes",
                          "body": {
                            "type": "op",
                            "kind": "step",
                            "id": "review-reassigned",
                            "idForm": "literal",
                            "title": "Review the change",
                            "assignedTo": "fixer",
                            "uses": [],
                            "at": "ship-change.ts:52"
                          }
                        },
                        {
                          "label": "no",
                          "body": {
                            "type": "exit",
                            "outcome": "fail",
                            "text": "{ _tag: \"Stopped\", reason: \"a person stopped the change\" }"
                          }
                        }
                      ]
                    }
                  ]
                }
              }
            ]
          },
          {
            "type": "loop",
            "header": "for (let round = 1; round <= 3; round++)",
            "bound": 3,
            "uses": [],
            "body": {
              "type": "seq",
              "items": [
                {
                  "type": "wrap",
                  "inner": {
                    "type": "wrap",
                    "inner": {
                      "type": "op",
                      "kind": "gate",
                      "id": "round-${round}/ci",
                      "idForm": "template",
                      "uses": [],
                      "at": "ship-change.ts:61"
                    },
                    "annotations": [
                      {
                        "type": "result",
                        "detail": "failure becomes a value"
                      }
                    ]
                  },
                  "annotations": [
                    {
                      "type": "scope",
                      "detail": "round-${round}"
                    }
                  ]
                },
                {
                  "type": "branch",
                  "condition": "ci._tag === \"Success\"",
                  "uses": [
                    "round-${round}/ci"
                  ],
                  "arms": [
                    {
                      "label": "yes",
                      "body": {
                        "type": "exit",
                        "outcome": "return",
                        "text": "{ shipped: true, rounds: round, review: review.summary }"
                      }
                    },
                    {
                      "label": "no",
                      "body": {
                        "type": "seq",
                        "items": []
                      }
                    }
                  ]
                },
                {
                  "type": "wrap",
                  "inner": {
                    "type": "op",
                    "kind": "step",
                    "id": "round-${round}/fix",
                    "idForm": "template",
                    "title": "Fix CI, round ${round}",
                    "assignedTo": "fixer",
                    "uses": [],
                    "at": "ship-change.ts:66"
                  },
                  "annotations": [
                    {
                      "type": "scope",
                      "detail": "round-${round}"
                    }
                  ]
                }
              ]
            }
          },
          {
            "type": "exit",
            "outcome": "fail",
            "text": "{ _tag: \"CiNeverPassed\" as const, rounds: 3 }"
          }
        ]
      }
    },
    "annotations": [
      {
        "type": "on-failure",
        "detail": "then fail",
        "handler": {
          "type": "wrap",
          "inner": {
            "type": "op",
            "kind": "step",
            "id": "report-failure",
            "idForm": "literal",
            "title": "Report why the change stopped",
            "assignedTo": "builder",
            "uses": [],
            "at": "ship-change.ts:74"
          },
          "annotations": [
            {
              "type": "ignore",
              "detail": "failure ignored"
            }
          ]
        }
      }
    ]
  },
