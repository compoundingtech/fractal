    {"name": "wire-between-versions", "globs": ["crates/fractal-wire/**", "crates/fractal-resource-protocol/**", "crates/smallclaims/src/replication.rs", "crates/fractal-api-core/src/api/replication.rs", "crates/fractal-peer/src/peer.rs", "crates/fractal-peer/src/peer/**", "crates/fractal-api-client-v0/src/api/**", "docs/st3/client-v0/**", "wit/**"], "exclude": ["**/tests/**", "**/tests.rs", "**/*_tests.rs", "**/*_test.rs", "**/*-test"]}
