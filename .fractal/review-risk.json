    {"name": "concurrency", "globs": ["crates/fractal-drivers/src/*lock*.rs", "crates/fractal-drivers/src/flock.rs", "crates/fractal-drivers/src/watch.rs", "crates/fractal-drivers/src/resync/**", "crates/fractal-drivers/src/resync.rs", "crates/fractal-github/src/watches.rs", "crates/fractal-github-base/src/github_watch.rs", "crates/fractal-api-core/src/graph_watch_ivm.rs", "crates/fractal-api-core/src/api/github_watch.rs", "crates/smallclaims/src/ivm/**", "crates/smallclaims/src/ivm.rs", "crates/fractal-reconcile/src/reconcile.rs", "crates/smallclaims/src/sync/worker*", "crates/smallclaims/src/sync/worker*/**"], "exclude": ["**/tests/**", "**/tests.rs", "**/*_tests.rs", "**/*_test.rs", "**/*-test"], "content": [{"globs": ["crates/**"], "exclude": ["**/tests/**", "**/tests.rs", "**/*_tests.rs", "**/*_test.rs", "**/*-test"], "only": "added", "pattern": "\\b(thread::spawn|tokio::spawn|task::spawn|spawn_blocking|Condvar|flock)\\b|\\b(Mutex|RwLock)(<|::)|\\.(try_)?lock\\(\\)|\\bstd::sync::mpsc\\b"}]},
