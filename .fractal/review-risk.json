{
  "version": 1,
  "_config_dir_bridge": "arn:lmig:smalltalk:2026-10-27-dot-fractal-config",
  "rule": "The deterministic risk floor of a review (docs/review.md): the highest level of any rule that fires on git diff BASE...HEAD. A review's final risk is the higher of this floor and the reviewing model's own score; the model may raise the risk above the floor and never lower it. `classes` gives the level of each class in .st/risky-classes.json (a class may lower the level of some paths with `paths`); `rules` are checks of their own; `factory_read` names areas where a MEDIUM change needs a read by Factory before it is queued: it never changes the level, only says that a medium change in one of them does not queue by itself (an area may carry `globs`, `exclude` and `content` like a rule); `large` is the size at which a change is at least medium. Globs match changed paths (** crosses directories); a content pattern matches an added (`added`), removed (`removed`) or either diff line of a file under its globs and not under `exclude`.",
  "classes": {
    "schema": "high",
    "authorization": {"level": "high", "paths": [{"globs": [".st/**", ".fractal/**"], "level": "medium"}]},
    "claim-folding-and-replay": "high",
    "protocol": "medium",
    "generated-contracts": "medium",
    "config-and-build": "medium",
    "routing-and-delivery": "medium",
    "release-notes": "low"
  },
